  "Nci.SecurityProofs.full_positions": {
   "owner": "@compute-accounting",
   "signature": [
    "Nci.SecurityProofs.full_positions {D : Verity.Circuit} (c : Nci.Chain D) (R : Finset (Fin D.N)) (d : Nat)",
    "  (hd : ∀ (ℓ : Fin c.L), instLENat.le d (c.d ℓ)) :",
    "  And",
    "    (instLENat.le",
    "      (Finset.filter",
    "          (fun g =>",
    "            And (SetLike.instMembership.mem R (c.prod g.fst g.snd.fst g.snd.snd.fst g.snd.snd.snd))",
    "              (c.Full R g.snd.fst))",
    "          Finset.univ).card",
    "      (instHMul.hMul (c.weightsUsed R).card (Finset.filter (c.Full R) Finset.univ).card))",
    "    (instLENat.le (instHMul.hMul d (Finset.filter (c.Full R) Finset.univ).card)",
    "      (Finset.filter (fun x => And (c.Full R x.snd.fst) (Not (c.LinkedWhole R x.fst x.snd.fst x.snd.snd)))",
    "          (c.inputsUsed R)).card)"
   ],
   "assumptions": [],
   "type_hash": "0be1f142229f412b399a736e39e8d50f020462af3b5666531fafe52754deb854"
  },
  "Nci.SecurityProofs.iu_reads": {
   "owner": "@compute-accounting",
   "signature": [
    "Nci.SecurityProofs.iu_reads (D : Verity.Declaration) (c : Nci.Chain D.D) (Γ : Nat) (K b_w b_a : Real) (d : Nat)",
    "  (hd : ∀ (ℓ : Fin c.L), instLENat.le d (c.d ℓ)) (hb_a : Real.instLE.le 0 b_a)",
    "  (h : Nci.Assumptions.ActivationsIncompressible D c Γ K b_w b_a) (R : Finset (Fin D.D.N))",
    "  (hR : Finset.instPartialOrder.le R D.D.computed) (hΓ : instLENat.le (D.D.size R) Γ)",
    "  (hK : Real.instLE.le (Nci.novelReads D R).cast K) :",
    "  Real.instLE.le",
    "    (instHAdd.hAdd (instHMul.hMul b_w (c.weightsUsed R).card.cast)",
    "      (instHMul.hMul b_a",
    "        (instHAdd.hAdd (instHMul.hMul d.cast (Finset.filter (c.Full R) Finset.univ).card.cast)",
    "          (Finset.filter (fun x => Not (c.Full R x.snd.fst)) (c.inputsUsed R)).card.cast)))",
    "    (Nci.novelReads D R).cast"
   ],
   "assumptions": [],
   "type_hash": "d5d11e43644ce9e4ad964bfcda1cf765924fc720b505c56993f236f058d9d693"
  },
  "Nci.SecurityProofs.loomis_whitney": {
   "owner": "@compute-accounting",
   "signature": [
    "Nci.SecurityProofs.loomis_whitney.{u_1, u_2, u_3} {α : Type u_1} {β : Type u_2} {γ : Type u_3} [DecidableEq α]",
    "  [DecidableEq β] [DecidableEq γ] (T : Finset (Prod α (Prod β γ))) :",
    "  instLENat.le (instHPow.hPow T.card 2)",
    "    (instHMul.hMul",
    "      (instHMul.hMul (Finset.image (fun x => { fst := x.fst, snd := x.snd.fst }) T).card",
    "        (Finset.image (fun x => { fst := x.fst, snd := x.snd.snd }) T).card)",
    "      (Finset.image (fun x => { fst := x.snd.fst, snd := x.snd.snd }) T).card)"
   ],
   "assumptions": [],
   "type_hash": "699c0e8c25ebd5e02db7990880c2aab5edf63a3a632f092488b8826906380abe"
  },
  "Nci.SecurityProofs.other_positions": {
   "owner": "@compute-accounting",
   "signature": [
    "Nci.SecurityProofs.other_positions {D : Verity.Circuit} (c : Nci.Chain D) {n : Nat} (P : Verity.Partition D n)",
    "  (u : Fin n) :",
    "  And",
    "    (∀ (ℓ : Fin c.L) (t : Fin c.N) (j : Fin (c.d ℓ)),",
    "      SetLike.instMembership.mem (c.inputsUsed (P.gates u)) ⟨ℓ, { fst := t, snd := j }⟩ →",
    "        Not (c.Full (P.gates u) t) → Not (c.LinkedWhole (P.gates u) ℓ t j))",
    "    (∀ (ℓ : Fin c.L) (t : Fin c.N) (i : Fin (c.e ℓ)) (j : Fin (c.d ℓ)),",
    "      SetLike.instMembership.mem (P.gates u) (c.prod ℓ t i j) → Not (c.Full (P.gates u) t) → c.Split P ℓ t i)"
   ],
   "assumptions": [],
   "type_hash": "0693c86395598e912e46a3b378916fd19c2b49711826f9c16546ffecd8fea217"
  }
 },
