    "  (level : V → Fin ℓ) (drg : Fin ℓ → Fin n → Fin n → Prop) (green : V → V → Prop)",
    "  (hnode : ∀ (i : Fin ℓ), Function.Injective (node i)) (hlevel : ∀ (i : Fin ℓ) (a : Fin n), Eq (level (node i a)) i)",
