  "PousBridge.b5_stacked": {
   "signature": [
    "PousBridge.b5_stacked {ℓ n N : Nat} {V : Type} [Fintype V] [DecidableEq V] (α β ε : Real) (node : Fin ℓ → Fin n → V)",
    "  (level : V → Fin ℓ) (drg : Fin ℓ → Fin n → Fin n → Prop) (green : V → V → Prop)",
    "  (hnode : ∀ (i : Fin ℓ), Function.Injective (node i)) (hlevel : ∀ (i : Fin ℓ) (a : Fin n), Eq (level (node i a)) i)",
    "  (hdr : ∀ (i : Fin ℓ), Pous.DRG.DepthRobust n (drg i) α β)",
    "  (hsc : ∀ (i j : Fin ℓ), Eq j.val (instHAdd.hAdd i.val 1) → Pous.DRG.DisjointPaths node level green i j)",
    "  (hn : instLTNat.lt 0 n) (hε : Real.instLT.lt 0 ε) (hε1 : Real.instLE.le ε 1)",
    "  (hℓ : Real.instLE.le 1 (instHMul.hMul (instHSub.hSub 1 α) ℓ.cast)) (hβ : Real.instLE.le 1 (instHMul.hMul β n.cast))",
    "  (e : Equiv V (Fin N)) (G : Pous.Labelling.TopoDAG N)",
    "  (hG :",
    "    ∀ (u v : V),",
    "      Iff (SetLike.instMembership.mem (G.par (EquivLike.toFunLike.coe e v)) (EquivLike.toFunLike.coe e u))",
    "        (Pous.DRG.StackedEdge node drg green u v))",
    "  (t : Fin ℓ) (ht : Eq (instHAdd.hAdd t.val 1) ℓ) (w m Q : Nat) (d : Fin N → Pous.Bits w)",
    "  (A₁ : (Pous.Labelling.LabelQry N w → Pous.Bits w) → Pous.Bits m)",
    "  (A₂ :",
    "    Pous.Bits m →",
    "      Fin N → Pous.Prog (Pous.IdealModel.randomOracle (Pous.Labelling.LabelQry N w) (Pous.Bits w)) (Pous.Bits w))",
    "  (hA₂ :",
    "    ∀ (σ : Pous.Bits m) (c : Fin N),",
    "      Pous.Prog.Bounded (instHSub.hSub (Nat.floor (instHMul.hMul β n.cast)) 1) Q (A₂ σ c)) :",
    "  ENNReal.instLE.le",
    "    (Pous.pr fun H =>",
    "      instLENat.le (instHAdd.hAdd (instHSub.hSub n (Nat.ceil (instHMul.hMul (instHDiv.hDiv ε 2) n.cast))) 1)",
    "        (Finset.filter (fun c => Eq (Pous.Prog.run H (A₂ (A₁ H) c)) (Pous.Labelling.label G d H c))",
    "            (Finset.image (fun b => EquivLike.toFunLike.coe e (node t b)) Finset.univ)).card)",
    "    (instHMul.hMul (instHMul.hMul N.cast (instHPow.hPow 2 m))",
    "      (instHPow.hPow",
    "        (instHDiv.hDiv (instHPow.hPow (instHAdd.hAdd (instHMul.hMul n (instHAdd.hAdd Q 1)) N) 2).cast",
    "          (instHPow.hPow 2 w))",
    "        (instHAdd.hAdd (Nat.floor (instHMul.hMul (instHSub.hSub 1 ε) n.cast)) 1)))"
   ],
