    "  (hℓ : Real.instLE.le 1 (instHMul.hMul (instHSub.hSub 1 α) ℓ.cast)) (hβ : Real.instLE.le 1 (instHMul.hMul β n.cast))",
    "  (e : Equiv V (Fin N)) (G : Pous.Labelling.TopoDAG N)",
    "  (hG :",
    "    ∀ (u v : V),",
    "      Iff (SetLike.instMembership.mem (G.par (EquivLike.toFunLike.coe e v)) (EquivLike.toFunLike.coe e u))",
    "        (Pous.DRG.StackedEdge node drg green u v))",
    "  (t : Fin ℓ) (ht : Eq (instHAdd.hAdd t.val 1) ℓ) (w m Q : Nat) (d : Fin N → Pous.Bits w)",
    "  (A₁ : (Pous.Labelling.LabelQry N w → Pous.Bits w) → Pous.Bits m)",
    "  (A₂ :",
