+def test_chain_place_ranges():
+    """In a prefill of 129 ids the first layer's last token has a chain of three key blocks, unsplit: its two later blocks
+    are places of one template, `SparseMlaHeadBlock_v1{NVIS=64,FIRST=false}`, the second's lanes reading the first's. Each
+    place is a range of its own in the window's order (`interface.ordered`), else that range would wait on itself."""
+    circuit, w = NW.node_window(glm_request(129, 2).program.fn, families=FAMILIES)
+    block = _tid(circuit, r"SparseMlaHeadBlock_v1\{DR=64,DV=512,NVIS=64,FIRST=false,.*\}")
+    ranges = [n for t, _at, n in circuit.order if t == block]
+    assert ranges == [HEADS] * (circuit.units[block] // HEADS) and len(ranges) > 64
+
+
