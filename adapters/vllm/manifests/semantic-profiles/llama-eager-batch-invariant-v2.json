{
 "schema": "verity-vllm/semantic-profile/v1",
 "id": "llama-eager-batch-invariant-v2",
 "purpose": "The verifier's own statement of the computation an eager, batch-invariant vLLM profile of a LlamaForCausalLM checkpoint performs: which nodes exist per layer, how they are wired, their shapes as functions of config.json, which runtime kernel implements each and which relation checks it. verity_vllm_adapter.binding regenerates description.json and required.json from this file plus the pinned config.json and requires the prover's documents to equal the regeneration on every binding field. v2 (2026-09-08, lead): the same semantic execution profile under the current recorder \u2014 description.patches lists the five module-level patches capture.PATCHES installs since W9M (the two MoE reporting wrappers are installed for every model), and gpu.compute_capability is restricted to the measured Ampere/Ada classes (8.0, 8.9; the consts already pin FlashAttention-2). v1 is frozen for the archives that were captured under the three-patch recorder; it is selectable only by explicit path.",
 "architectures": [
  "LlamaForCausalLM"
 ],
 "requires": {
  "compilation.enforce_eager": true,
  "compilation.cudagraph_mode": "NONE",
  "engine_flags.VLLM_BATCH_INVARIANT": "1",
  "dtype": "bfloat16",
  "parallelism.tensor_parallel_size": 1,
  "quantization": null,
  "gpu.compute_capability": [
   "8.0",
   "8.9"
  ]
 },
 "symbols": {
  "H": "hidden_size",
  "I": "intermediate_size",
  "V": "vocab_size",
  "NH": "num_attention_heads",
  "NKV": "num_key_value_heads",
  "L": "num_hidden_layers",
  "EPS": "rms_norm_eps",
  "THETA": "rope_theta",
  "MAXPOS": "max_position_embeddings",
  "HD": "hidden_size // num_attention_heads",
  "KV": "num_key_value_heads * (hidden_size // num_attention_heads)",
  "QKV": "hidden_size + 2 * num_key_value_heads * (hidden_size // num_attention_heads)"
 },
 "description_symbols": [
  "H",
  "V"
 ],
 "interception": "dispatch-mode",
 "patches": [
  "vllm.model_executor.determinism.batch_invariant.mm_batch_invariant -> torch.ops.verity.bi_mm (wraps matmul_persistent)",
  "vllm.model_executor.layers.layernorm.rms_norm_batch_invariant -> torch.ops.verity.bi_rms_norm for residual=None (wraps _rms_norm_kernel); residual path untouched (_C.fused_add_rms_norm)",
  "GPUModelRunner instance: execute_model/sample wrapped (dispatch mode + RU bookkeeping)",
  "vllm.model_executor.layers.fused_moe.experts.triton_moe.invoke_fused_moe_triton_kernel -> reporting wrapper (original launch unchanged; arguments and the kernel's output buffer are read after the launch)",
  "torch.ops.vllm.moe_forward / moe_forward_shared: body re-entered under a nested TorchDispatchMode (eager path; the custom op is opaque only for torch.compile)"
 ],
 "runtime_impl": {
  "bi_mm": "triton:vllm.model_executor.determinism.batch_invariant.matmul_persistent (via linear_batch_invariant)",
  "bi_rms_norm": "triton:vllm.model_executor.determinism.batch_invariant._rms_norm_kernel",
  "fused_add_rms_norm": "cuda:torch.ops._C.fused_add_rms_norm",
  "rotary_embedding": "cuda:torch.ops._C.rotary_embedding",
  "silu_and_mul": "cuda:torch.ops._C.silu_and_mul",
  "embedding": "aten:embedding (CUDA)",
  "attention": "vllm.v1.attention.backends.flash_attn.FlashAttentionImpl backend=FlashAttentionBackend",
  "sampler": "vllm.v1.worker.gpu.sample.sampler (greedy argmax; trace replay overwrites the emitted token)"
 },
 "ignored_description_fields": [
  "instances_observed",
  "arg_violations"
 ],
 "binding_conditions": {
  "arg_violations": "must be empty on every node"
 },
 "phases": [
  "decode",
  "prefill"
 ],
