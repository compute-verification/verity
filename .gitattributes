# each side's guarantees, reads and dependencies, merged without a rebuild (tools/verity/lean/merge.py; `merge.py --install` once per clone)
lean-audit.json merge=lean-audit
# a conflict only in import lists merges as one list; any other stays git's (merge.py --lean)
*.lean merge=lean-imports
# a conflict only in `[[require]]` blocks or a string array (`roots`) merges as a set or list; any other stays git's (merge.py --lakefile)
lakefile.toml merge=lakefile-lists
# the fixture replica map key by key; a key set two ways refuses (tools/verity/check/merge_map.py)
fixtures/artifacts.json merge=fixture-map
# the vLLM lints' shrink-only lists entry by entry; an entry changed two ways refuses (integrations/vllm/tests/lint/merge_allowlist.py)
integrations/vllm/tests/lint/allowlists/*.json merge=vllm-allowlist
integrations/vllm/tests/dead_code_keep.json merge=vllm-allowlist
# the repository's lists (tests/lint/test_repo_*.py), entry by entry with the same driver
tests/lint/allowlists/*.json merge=vllm-allowlist
