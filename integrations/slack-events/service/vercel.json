{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "buildCommand": "python3 build.py",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{_vendor,slack_events}/**"
    },
    "api/consume.py": {
      "maxDuration": 100,
      "includeFiles": "{_vendor,slack_events}/**",
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "slack-events" }]
    }
  },
  "rewrites": [
    { "source": "/api/slack/(.*)", "destination": "/api/index" },
    { "source": "/api/cron/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/watchdog", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/reconcile", "schedule": "*/10 * * * *" }
  ]
}
