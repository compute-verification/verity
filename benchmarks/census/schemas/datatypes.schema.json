{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmarks/census/schemas/datatypes.schema.json",
  "title": "Census datatypes: operand formats, displayed as the common name first, then the precise format",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "display",
      "common",
      "format",
      "bits",
      "sources"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+$",
        "description": "as the instruction registry names operand dtypes"
      },
      "display": {
        "type": "string",
        "minLength": 1,
        "description": "'<common>' or '<common> (<format>)'"
      },
      "common": {
        "type": "string",
        "minLength": 1
      },
      "format": {
        "type": "string",
        "minLength": 1
      },
      "bits": {
        "type": "integer",
        "minimum": 1
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
