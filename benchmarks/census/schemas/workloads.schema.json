{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmarks/census/schemas/workloads.schema.json",
  "title": "Census workloads: served configurations and their template mix (verification units per subcircuit template and bound parameters)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "display",
      "model",
      "serving",
      "vus",
      "template_mix",
      "not_evaluable_vus",
      "source",
      "sources"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^vllm/[A-Za-z0-9._-]+$",
        "description": "vllm/<the regression row's serving-config slug>"
      },
      "display": {
        "type": "string",
        "minLength": 1
      },
      "model": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "serving": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine",
          "batch",
          "tp",
          "datatype",
          "hardware_class",
          "hardware",
          "input_len",
          "output_len",
          "arrivals",
          "sampling",
          "mode"
        ],
        "properties": {
          "engine": {
            "const": "vllm"
          },
          "batch": {
            "type": "integer",
            "minimum": 1
          },
          "tp": {
            "type": "integer",
            "minimum": 1
          },
          "datatype": {
            "type": "string",
            "description": "a benchmarks/census/datatypes.json id"
          },
          "hardware_class": {
            "type": "string",
            "description": "the GPU class that served (and would prove) it"
          },
          "hardware": {
            "type": [
              "string",
              "null"
            ],
            "description": "its benchmarks/census/hardware.json line, or null when the census has none (L40S)"
          },
          "input_len": {
            "type": "integer"
          },
          "output_len": {
            "type": "integer"
          },
          "arrivals": {
            "type": "string"
          },
          "sampling": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        }
      },
      "vus": {
        "type": "integer",
        "minimum": 1,
        "description": "verification units of the run (sampled proofs' replay partition)"
      },
      "template_mix": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vu_family",
            "parameters",
            "vus",
            "subcircuit_template",
            "subcircuit_parameters",
            "subcircuits_per_vu"
          ],
          "properties": {
            "vu_family": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "vus": {
              "type": "integer",
              "minimum": 1
            },
            "subcircuit_template": {
              "type": [
                "string",
                "null"
              ],
              "description": "its benchmarks/census/subcircuits.json template, or null when the census has none yet"
            },
            "subcircuit_parameters": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": [
                  "integer",
                  "string",
                  "number"
                ]
              }
            },
            "subcircuits_per_vu": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "subcircuits of the template one VU holds (a Gemm_v1 row: N coordinates)"
            },
            "variable_counts": {
              "type": "object",
              "description": "for a per-input work-model variable (attention's T), the VUs at each of its values within this entry: runs of consecutive values, each value holding vus_per_value VUs; the runs sum to vus",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["runs", "source"],
                "properties": {
                  "runs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["min", "max", "vus_per_value"],
                      "properties": {"min": {"type": "integer"}, "max": {"type": "integer"}, "vus_per_value": {"type": "integer", "minimum": 1}}
                    }
                  },
                  "source": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      },
      "not_evaluable_vus": {
        "type": "integer",
        "minimum": 0
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row",
          "class",
          "expected",
          "records",
          "programs",
          "program_digest",
          "reference",
          "read_at_commit"
        ],
        "properties": {
          "row": {
            "type": "integer"
          },
          "class": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected": {
            "type": "string"
          },
          "records": {
            "type": [
              "string",
              "null"
            ]
          },
          "programs": {
            "type": [
              "string",
              "null"
            ]
          },
          "program_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": [
              "object",
              "null"
            ]
          },
          "read_at_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
