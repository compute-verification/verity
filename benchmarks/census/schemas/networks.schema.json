{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmarks/census/schemas/networks.schema.json",
  "title": "Census network profiles for t = compute + rounds x RTT + bytes / bandwidth",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "label",
      "rtt_s",
      "bandwidth_bps",
      "role",
      "sources"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "rtt_s": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "bandwidth_bps": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "role": {
        "type": "string",
        "enum": [
          "reference",
          "sensitivity"
        ]
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
