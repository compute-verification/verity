/-- The verifier's drawn session record and its two repetition proof streams. -/
def transcript : Exec.Transcript where
  record := recordText
  proofs := #[bytes proof0Hex, bytes proof1Hex]

/-- The subset draw carried by the concrete record. -/
def draw : Lean.Json :=
  (Exec.recordDraw transcript.record).getD .null

/-- One closed check of the record's draw and all fields the honest witness reads from it. -/
def inspectionOk : Bool :=
  match Exec.recordDraw transcript.record with
  | none => false
  | some d =>
    match Flock.Draw.UnitDraw.ofJson d with
    | .error _ => false
    | .ok u =>
      match u.law with
      | .subset k => k == 16 && u.population == 32 && u.units.size == 16
      | _ => false

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- The concrete record has a valid 16-of-32 subset draw. -/
theorem inspection_ok : inspectionOk = true := by
  decide +kernel

theorem record_draw_some : (Exec.recordDraw transcript.record).isSome = true := by
  have hio := inspection_ok
  unfold inspectionOk at hio
  generalize h : Exec.recordDraw transcript.record = o at hio ⊢
  cases o <;> simp_all

/-- The subset draw's decoded value. -/
def unitDraw : Flock.Draw.UnitDraw :=
  (Flock.Draw.UnitDraw.ofJson draw).toOption.get
    (by
      have hio := inspection_ok
      unfold inspectionOk at hio
      generalize hr : Exec.recordDraw transcript.record = o at hio
      cases o with
      | none => simp at hio
      | some d =>
        have hd : draw = d := by simp [draw, hr]
        rw [hd]
        generalize hu : Flock.Draw.UnitDraw.ofJson d = u at hio
        cases u <;> simp_all)

/-- The concrete draw's units. -/
def units : Array ℕ := unitDraw.units

/-- **The concrete record carries its non-null subset draw**, checked by kernel reduction. -/
theorem record_draw : Exec.recordDraw transcript.record = some draw := by
