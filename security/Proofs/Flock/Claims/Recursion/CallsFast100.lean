/-! `fast100`'s Ligerito call counts, evaluated by the kernel in a module of their own: with core's loops imported in
full, `CallsTop`'s walks exceed their budget. -/

@[expose] public section

namespace FlockDeploy.KS

open Flock

theorem fast100_calls : ∀ m < 36, (fast100 m).all (fun s => decide ((1 + (s.levels.size - 1)) * qAll s ≤ 2 ^ 16)) = true := by
  decide +kernel

end FlockDeploy.KS
