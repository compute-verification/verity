{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibration/census/schemas/hardware.schema.json",
  "title": "Census hardware lines: a device running one operand dtype, with its dense tensor-core peak",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "dependentRequired": {
      "card": [
        "readings"
      ],
      "readings": [
        "card"
      ]
    },
    "required": [
      "id",
      "name",
      "device",
      "dtype",
      "rate",
      "flop_per_second",
      "accumulate",
      "memory_bytes",
      "sources",
      "methodology"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+$",
        "description": "<device slug>/<dtype>; a line derived from a card has the card's sku and its reading as its slug"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "short display name, e.g. 'H100 SXM5'"
      },
      "device": {
        "type": "string",
        "minLength": 1,
        "description": "the datasheet part"
      },
      "dtype": {
        "type": "string",
        "pattern": "^[a-z0-9]+$",
        "description": "a calibration/census/datatypes.json id (bf16, e4m3, e2m1)"
      },
      "rate": {
        "type": "string",
        "minLength": 1
      },
      "flop_per_second": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "dense peak; an FMA counts as two FLOP; where the line names a card, derived from it"
      },
      "accumulate": {
        "type": "string",
        "enum": [
          "fp32"
        ]
      },
      "memory_bytes": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "methodology": {
        "type": "string",
        "minLength": 1
      },
      "card": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "reading",
          "weight"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "the stem of the calibration/hardware/cards file this line's flop_per_second is derived from"
          },
          "reading": {
            "enum": [
              "tensor",
              "sm"
            ],
            "description": "the card's clock reading (verity.device.READINGS) the figure is taken at"
          },
          "weight": {
            "type": "string",
            "minLength": 1,
            "description": "the card's weight.<key> of this line's operand format"
          }
        }
      },
      "readings": {
        "type": "array",
        "minItems": 1,
        "description": "the other figures the line's peak is quoted at, each named, with its ratio to flop_per_second; present with card",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "flop_per_second",
            "ratio",
            "sources"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "flop_per_second": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "this reading's flop_per_second over the line's, to six places"
            },
            "sources": {
              "$ref": "#/items/properties/sources"
            },
            "methodology": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "memory_bytes_per_second": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "datasheet memory bandwidth (bytes per second), the denominator of a memory-bandwidth work model"
      },
      "memory_sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
