{
  "display_information": {
    "name": "Agents",
    "description": "Verity's coordinators post, read and route their asks, announcements and doorbells through it (research msg).",
    "background_color": "#2C2D30"
  },
  "features": {
    "bot_user": {
      "display_name": "Agents",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "bookmarks:write",
        "channels:history",
        "channels:join",
        "channels:manage",
        "channels:read",
        "chat:write",
        "chat:write.customize",
        "chat:write.public",
        "conversations.connect:write",
        "files:write",
        "groups:history",
        "groups:read",
        "groups:write",
        "im:write",
        "pins:write",
        "reactions:read",
        "reactions:write",
        "team:read",
        "usergroups:read",
        "usergroups:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://website-docs-sage.vercel.app/api/slack/interactivity"
    },
    "event_subscriptions": {
      "request_url": "https://website-docs-sage.vercel.app/api/slack/events",
      "bot_events": [
        "message.channels",
        "message.groups",
        "team_join"
      ]
    }
  }
}
