{
  "display_information": {
    "name": "Verity",
    "description": "Verity's coordinators post, read and route their asks, announcements and doorbells through it (research msg)."
  },
  "features": {
    "bot_user": {
      "display_name": "Verity",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "channels:join",
        "channels:manage",
        "channels:read",
        "chat:write",
        "chat:write.customize",
        "chat:write.public",
        "groups:history",
        "pins:write",
        "reactions:write",
        "usergroups:read",
        "usergroups:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
