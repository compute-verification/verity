+//! Reference semantics and witness generation for the `TC_DOT` precompile.
+//!
+//! Implements one 16-element tensor-core dot-product tile step `D = C + A·B`
+//! with the bit-exact semantics recovered by the Hawkeye paper (arXiv:2603.20421)
+//! for NVIDIA tensor cores, specialized to **fp8 E4M3 operands with Ampere
+//! group structure**: products are exact and unnormalized, and the accumulation
+//! runs as two 25-bit-wide GroupSums (`G1 = GroupSum({C, P1..P8})`,
+//! `D = GroupSum({G1, P9..P16})`) with truncating (round-toward-zero) alignment
+//! and normalization. Only the final per-tile result is converted to fp32.
+//!
+//! SEMANTICS CAVEAT: real fp8 tensor cores exist only on Hopper (QGMMA) with
+//! different constants; this "fp8 Ampere" contract is the bf16 Ampere pipeline
+//! fed with fp8 products. The authoritative spec is the verified `tc` module in
+//! the sp1-op-bench repository (`common/src/dot.rs`); this file must remain
+//! bit-exact with it.
+//!
+//! OPERAND CONTRACT (v0 soundness assumptions, enforced by assertions in
+//! witness generation so violations fail at proving time rather than proving
+//! something wrong):
+//! - fp8 operands are finite E4M3 (the NaN pattern S.1111.111 is excluded).
+//! - the fp32 accumulator input is finite (not inf/NaN).
+//! - neither GroupSum output is a nonzero fp32 subnormal, and the final result
+//!   does not overflow fp32 range. (Exact zero is fine.)
+
+/// Number of fp8 elements per tile.
+pub const TC_DOT_TILE: usize = 16;
+
+/// Extra internal adder bits for Ampere (adder word is 24 + 1 = 25 bits wide).
+const EXTRA_BITS: u32 = 1;
+/// Adder/normalization width for Ampere.
+const WIDTH: u32 = 24 + EXTRA_BITS;
+/// Alignment floor for Ampere: `e_max` is clamped below at this value.
+const FLOOR: i32 = -132;
+/// Shift cap: `2 * mag < 2^26` for every term, so any alignment shift of 26 or
+/// more truncates the term to zero. The AIR caps the shift at this value.
+pub const SHIFT_CAP: u32 = 26;
+
+/// One summand in a GroupSum: `|value| = mag * 2^(e - 23)`.
+///
+/// `mag == 0` encodes a true zero which contributes nothing to `e_max` or the
+/// sum. Products carry up to 25 bits (`225 << 17`); the C/G1 term carries up
+/// to 24 bits.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct TcTerm {
+    /// Sign (true = negative).
+    pub neg: bool,
+    /// Magnitude with 23 fraction bits below the nominal exponent.
+    pub mag: u64,
+    /// Nominal (unbiased) exponent of bit 23.
+    pub e: i32,
+}
+
+/// Witness data for aligning one term inside a GroupSum.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct TcAlignWitness {
+    /// Nonzero flag for the term (`mag != 0`).
+    pub nz: bool,
+    /// `nz * (e_max - e)`, guaranteed in `[0, 512)`.
+    pub d_masked: u32,
+    /// Whether the shift saturates (`d_masked >= SHIFT_CAP`).
+    pub is_big: bool,
+    /// Effective shift `min(d_masked, SHIFT_CAP)`, in `[0, 26]`.
+    pub shift_eff: u32,
+    /// Quotient of `2 * mag` by `2^shift_eff` (the aligned magnitude), `< 2^26`.
+    pub q: u64,
+    /// Remainder, `< 2^shift_eff`.
+    pub r: u64,
+}
+
+/// Witness data for one GroupSum stage.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct TcGroupWitness {
+    /// Input terms (term 0 is C or G1, terms 1..=8 are products).
+    pub terms: [TcTerm; 9],
+    /// Max nominal exponent over nonzero terms, clamped below at `FLOOR`.
+    pub e_max: i32,
+    /// Whether the clamp fired (all terms zero for in-contract inputs).
+    pub is_clamped: bool,
+    /// Index of the (first) nonzero term achieving `e_max`, if any.
+    pub max_idx: Option<usize>,
+    /// Per-term alignment witnesses.
+    pub align: [TcAlignWitness; 9],
+    /// Signed sum of aligned terms. `|sum| < 2^30`.
+    pub sum: i64,
+    /// Whether the sum is exactly zero (stage output is a true zero).
+    pub out_zero: bool,
+    /// Sign of the sum (false for zero).
+    pub sum_neg: bool,
+    /// `|sum|`.
+    pub sum_abs: u64,
+    /// Normalization direction: true if `bitlen(sum_abs) > WIDTH` (right shift).
+    pub norm_right: bool,
+    /// Right-normalization shift `bitlen - WIDTH`, in `[0, 5]` (0 if left).
+    pub kr: u32,
+    /// Remainder truncated by the right normalization shift, `< 2^kr`.
+    pub rn: u64,
+    /// Left-normalization shift `WIDTH - bitlen`, in `[0, 24]` (0 if right).
+    pub kl: u32,
+    /// Normalized magnitude at `WIDTH` bits (top bit set unless zero).
+    pub mag25: u64,
+    /// Lowest bit of `mag25`, truncated when dropping the extra internal bit.
+    pub bit0: u64,
+    /// Output term of the stage (24-bit magnitude, 23 fraction bits).
+    pub out: TcTerm,
+}
+
+/// Full witness for one tile step.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct TcDotWitness {
+    /// The two GroupSum stages.
+    pub stages: [TcGroupWitness; 2],
+    /// Result fp32 bits.
+    pub d_bits: u32,
+}
+
+/// Decompose an fp8 E4M3 byte into (significand incl. implicit bit, nominal
+/// exponent, negative). Subnormals keep their reduced significand at nominal
+/// exponent -6 and are NOT renormalized.
+#[inline]
+#[must_use]
+pub fn e4m3_parts(x: u8) -> (u64, i32, bool) {
+    let neg = x >> 7 != 0;
+    let e = i32::from((x >> 3) & 0xF);
+    let m = u64::from(x & 7);
+    if e == 0 {
+        (m, -6, neg)
+    } else {
+        (8 + m, e - 7, neg)
+    }
+}
+
+/// Decompose an fp32 accumulator into a [`TcTerm`]. Subnormals keep their
+/// reduced significand at nominal exponent -126.
+#[inline]
+#[must_use]
+pub fn f32_term(bits: u32) -> TcTerm {
+    let neg = bits >> 31 != 0;
+    let e = ((bits >> 23) & 0xFF) as i32;
+    let m = u64::from(bits & 0x7F_FFFF);
+    if e == 0 {
+        TcTerm { neg, mag: m, e: -126 }
+    } else {
+        TcTerm { neg, mag: (1 << 23) | m, e: e - 127 }
+    }
+}
+
+/// Exact unnormalized product of two fp8 E4M3 values, expanded to 23 fraction
+/// bits (`<< 17` for fp8: register fill of the 24-bit internal register).
+#[inline]
+#[must_use]
+pub fn fp8_product(a: u8, b: u8) -> TcTerm {
+    let (sa, ea, na) = e4m3_parts(a);
+    let (sb, eb, nb) = e4m3_parts(b);
+    TcTerm { neg: na != nb, mag: (sa * sb) << 17, e: ea + eb }
+}
+
+/// One GroupSum over up to 9 terms with full witness capture.
+fn group_sum(terms: [TcTerm; 9]) -> TcGroupWitness {
+    let mut w = TcGroupWitness { terms, ..Default::default() };
+
+    // e_max over nonzero terms, clamped below at the floor.
+    let mut e_max = FLOOR;
+    let mut max_idx = None;
+    for (i, t) in terms.iter().enumerate() {
+        if t.mag != 0 && (t.e > e_max || (t.e == e_max && max_idx.is_none())) {
+            e_max = t.e;
+            max_idx = Some(i);
+        }
+    }
+    w.e_max = e_max;
+    w.max_idx = max_idx;
+    w.is_clamped = max_idx.is_none();
+
+    // Align every term with a truncating right shift and sum.
+    let mut sum: i64 = 0;
+    for (i, t) in terms.iter().enumerate() {
+        let a = &mut w.align[i];
+        a.nz = t.mag != 0;
+        if a.nz {
+            let d = u32::try_from(e_max - t.e).expect("nonzero term above e_max");
+            assert!(d < 512, "alignment shift out of expected range");
+            a.d_masked = d;
+        }
+        a.is_big = a.d_masked >= SHIFT_CAP;
+        a.shift_eff = a.d_masked.min(SHIFT_CAP);
+        let x = t.mag << EXTRA_BITS;
+        a.q = x >> a.shift_eff;
+        a.r = x - (a.q << a.shift_eff);
+        debug_assert!(a.q < (1 << SHIFT_CAP));
+        sum += if t.neg { -(a.q as i64) } else { a.q as i64 };
+    }
+    w.sum = sum;
+    debug_assert!(sum.unsigned_abs() < 1 << 30);
+
+    if sum == 0 {
+        w.out_zero = true;
+        w.out = TcTerm::default();
+        return w;
+    }
+
+    w.sum_neg = sum < 0;
+    w.sum_abs = sum.unsigned_abs();
+
+    // Normalize (e_max, sum_abs) to WIDTH bits, truncating.
+    let bitlen = 64 - w.sum_abs.leading_zeros();
+    let e_out = e_max + bitlen as i32 - WIDTH as i32;
+    if bitlen > WIDTH {
+        w.norm_right = true;
+        w.kr = bitlen - WIDTH;
+        assert!(w.kr <= 5, "normalization right shift out of range");
+        w.mag25 = w.sum_abs >> w.kr;
+        w.rn = w.sum_abs - (w.mag25 << w.kr);
+    } else {
+        w.kl = WIDTH - bitlen;
+        w.mag25 = w.sum_abs << w.kl;
+    }
+    debug_assert_eq!(w.mag25 >> (WIDTH - 1), 1);
+
+    // OPERAND CONTRACT: the reference semantics clamp into fp32 subnormal
+    // range here (truncating). The v0 chip does not constrain that path, so
+    // fail loudly instead of producing an unsound trace.
+    assert!(
+        e_out >= -126,
+        "TC_DOT operand contract violation: GroupSum output is subnormal \
+         (e_out = {e_out}); the v0 precompile does not support subnormal stage outputs"
+    );
+
+    // Drop the extra internal bit (truncating) -> 24-bit significand.
+    w.bit0 = w.mag25 & 1;
+    let mag24 = w.mag25 >> 1;
+    w.out = TcTerm { neg: w.sum_neg, mag: mag24, e: e_out };
+    w
+}
+
+/// Encode a stage-output term as fp32 bits.
+///
+/// In-contract outputs are zero or normal, so this only re-encodes. Overflow
+/// and subnormal outputs violate the operand contract and panic.
+fn pack_f32(t: TcTerm) -> u32 {
+    if t.mag == 0 {
+        return 0;
+    }
+    assert!(
+        t.e <= 127,
+        "TC_DOT operand contract violation: result overflows fp32 (e = {})",
+        t.e
+    );
+    assert!(t.e >= -126 && t.mag >> 23 == 1, "stage output not normalized");
+    let sign = u32::from(t.neg) << 31;
+    sign | (((t.e + 127) as u32) << 23) | (t.mag as u32 & 0x7F_FFFF)
+}
+
+/// One 16-element tile step with full witness capture:
+/// `G1 = GroupSum({C, P1..P8})`, `D = GroupSum({G1, P9..P16})`.
+#[must_use]
+pub fn tc_dot_witness(a: &[u8; 16], b: &[u8; 16], c_bits: u32) -> TcDotWitness {
+    let c = f32_term(c_bits);
+    assert!(
+        (c_bits >> 23) & 0xFF != 0xFF,
+        "TC_DOT operand contract violation: accumulator is inf/NaN"
+    );
+    for i in 0..TC_DOT_TILE {
+        assert!(a[i] & 0x7F != 0x7F, "TC_DOT operand contract violation: A[{i}] is E4M3 NaN");
+        assert!(b[i] & 0x7F != 0x7F, "TC_DOT operand contract violation: B[{i}] is E4M3 NaN");
+    }
+
+    let mut terms1 = [TcTerm::default(); 9];
+    terms1[0] = c;
+    for i in 0..8 {
+        terms1[i + 1] = fp8_product(a[i], b[i]);
+    }
+    let stage1 = group_sum(terms1);
+
+    let mut terms2 = [TcTerm::default(); 9];
+    terms2[0] = stage1.out;
+    for i in 0..8 {
+        terms2[i + 1] = fp8_product(a[i + 8], b[i + 8]);
+    }
+    let stage2 = group_sum(terms2);
+
+    TcDotWitness { stages: [stage1, stage2], d_bits: pack_f32(stage2.out) }
+}
+
+/// One 16-element tile step: returns the new fp32 accumulator bits.
+#[must_use]
+pub fn tc_dot_tile(a: &[u8; 16], b: &[u8; 16], c_bits: u32) -> u32 {
+    tc_dot_witness(a, b, c_bits).d_bits
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn fp8(sign: bool, e: u8, m: u8) -> u8 {
+        (u8::from(sign) << 7) | (e << 3) | m
+    }
+
+    /// Simple exactness case: 1.0 * 1.0 * 16 + 0 = 16.0.
+    #[test]
+    fn ones_dot() {
+        let a = [fp8(false, 7, 0); 16];
+        let b = [fp8(false, 7, 0); 16];
+        assert_eq!(tc_dot_tile(&a, &b, 0), 16.0f32.to_bits());
+    }
+
+    /// Truncation fidelity probe (paper's signature): a magnitude 2^-25
+    /// product dies to exactly 0 against a magnitude-1 term on Ampere.
+    /// fp8 can represent 2^-25 as a product: 2^-12 * 2^-13 needs exponents
+    /// below E4M3 range, so use subnormal products: sub(m=1) = 2^-9;
+    /// 2^-9 * 2^-16 is out of range too. Instead probe with the accumulator:
+    /// C = 1.0, product = -(2^-9 * 2^-16)? Out of E4M3 range. Use
+    /// C = 2^17: products of magnitude 2^-8 sit 25 bits below and must die.
+    #[test]
+    fn truncation_kills_small_terms_against_big_accumulator() {
+        let mut a = [0u8; 16];
+        let mut b = [0u8; 16];
+        // Product P1 = -(2^-4 * 2^-4) = -2^-8, e_p = -8, 25 bits below 2^17.
+        a[0] = fp8(true, 3, 0);
+        b[0] = fp8(false, 3, 0);
+        let c = 2f32.powi(17).to_bits();
+        // Term C has e = 17; the product aligns with d = 25: its doubled
+        // magnitude 2^24 shifts fully out (q = 0), so it vanishes exactly.
+        assert_eq!(tc_dot_tile(&a, &b, c), c, "2^-25-class term must vanish (RTZ)");
+
+        // One bit closer (e_p = -7): survives and truncates toward zero.
+        a[0] = fp8(true, 4, 0);
+        let want = (2f32.powi(17) - 2f32.powi(-7)).to_bits();
+        assert_eq!(tc_dot_tile(&a, &b, c), want, "2^-24-class term must survive");
+    }
+
+    /// No round-to-nearest: 2^-24 + 2^-25 relative to the max term yields
+    /// exactly the 2^-24 part (the 2^-25 part truncates), not a rounded-up
+    /// value.
+    #[test]
+    fn no_round_to_nearest() {
+        let mut a = [0u8; 16];
+        let mut b = [0u8; 16];
+        // P1 = 1.5 * 1.0 = 1.5 at e_p = 0 -> the 0.5 sits at 2^-1.
+        // Use C = 2^23: 1.5 aligns with d = 23: x = (12<<17)<<1 = 3*2^23,
+        // shift 23 -> q = 3 (yes: 1.5 = 3 * 2^-1 -> aligned keeps 2^-1+2^0).
+        a[0] = fp8(false, 7, 4); // 1.5
+        b[0] = fp8(false, 7, 0); // 1.0
+        let c = 2f32.powi(23).to_bits();
+        // Exact sum 2^23 + 1.5 does not fit 24 significand bits; the final
+        // truncating reduction drops the 0.5 (round-to-nearest would give
+        // 2^23 + 2): result is exactly 2^23 + 1.
+        let want = (2f32.powi(23) + 1.0).to_bits();
+        assert_eq!(tc_dot_tile(&a, &b, c), want);
+
+        // One scale further: C = 2^24 + 1.5 keeps only 2^24 after the 24-bit
+        // truncating reduction (the aligned 1.0 survives alignment as q = 1
+        // but dies with the extra internal bit; RN would give 2^24 + 2).
+        let c = 2f32.powi(24).to_bits();
+        let want = 2f32.powi(24).to_bits();
+        assert_eq!(tc_dot_tile(&a, &b, c), want);
+    }
+
+    /// Products enter alignment unnormalized: 1.5 * 1.5 = 2.25 has its top
+    /// bit at position 24 (above the 23-fraction-bit point) and is NOT
+    /// renormalized before alignment.
+    #[test]
+    fn products_stay_unnormalized() {
+        let mut a = [0u8; 16];
+        let mut b = [0u8; 16];
+        a[0] = fp8(false, 7, 4); // 1.5
+        b[0] = fp8(false, 7, 4); // 1.5
+        assert_eq!(tc_dot_tile(&a, &b, 0), 2.25f32.to_bits());
+    }
+
+    /// Subnormal operands keep reduced precision at nominal exponent -6.
+    #[test]
+    fn subnormal_products_exact() {
+        let mut a = [0u8; 16];
+        let mut b = [0u8; 16];
+        a[0] = 0x03; // subnormal, 3 * 2^-9
+        b[0] = 0x38; // 1.0
+        a[1] = 0x48; // 4.0
+        b[1] = 0x38; // 1.0
+        let want = (4.0 + 3.0 * 2f32.powi(-9)).to_bits();
+        assert_eq!(tc_dot_tile(&a, &b, 0), want);
+    }
+
+    /// Two-stage structure: stage-1 cancellation renormalizes G1 small, so a
+    /// tiny second-half product survives stage-2 alignment.
+    #[test]
+    fn two_stage_group_structure() {
+        let mut a = [0u8; 16];
+        let mut b = [0u8; 16];
+        // First half: P1 = 9 * 8 = 72 = 2^6 + 2^3, P2 = -(8*8) = -2^6, so
+        // G1 = 8 = 2^3 after a big cancellation.
+        a[0] = fp8(false, 10, 1); // 9.0 (sig 9 at e = 3)
+        b[0] = fp8(false, 10, 0); // 8.0
+        a[1] = fp8(false, 10, 0); // 8.0
+        b[1] = fp8(true, 10, 0); // -8.0  -> P2 = -64
+        // Second half: tiny product 2^-8 * 2^-8 = 2^-16.
+        a[8] = fp8(false, 0, 4); // subnormal 4*2^-9 = 2^-7
+        b[8] = fp8(false, 0, 4); // 2^-7 -> P9 = 2^-14
+        let d = tc_dot_tile(&a, &b, 0);
+        // G1 = 72 - 64 = 8 = 2^3; stage 2 aligns 2^-14 against e_max = 3;
+        // d = 17 < 25 so it survives: D = 8 + 2^-14.
+        assert_eq!(d, (8.0 + 2f32.powi(-14)).to_bits());
+    }
+
+    /// The fp32 accumulator is re-rounded (truncated) every tile: matches the
+    /// multi-tile reference behavior when chained.
+    #[test]
+    fn accumulator_chaining_rerounds() {
+        // Tile 1: acc = 1.0.
+        let mut a = [0u8; 16];
+        let mut b = [0u8; 16];
+        a[0] = fp8(false, 7, 0);
+        b[0] = fp8(false, 7, 0);
+        let acc = tc_dot_tile(&a, &b, 0);
+        assert_eq!(acc, 1.0f32.to_bits());
+        // Tile 2: add 2^24: the running +1 truncates away.
+        a[0] = fp8(false, 13, 0); // 2^6
+        b[0] = fp8(false, 13, 0); // 2^6 -> 2^12... too small. Chain more.
+        // 2^6 * 2^6 = 2^12; sum 16 of them: 2^16. Not enough for 2^24 in one
+        // tile from fp8; instead seed C = 2^24 - trick: use C directly.
+        let acc2 = tc_dot_tile(&[0; 16], &[0; 16], (2f32.powi(24) + 0.0).to_bits());
+        assert_eq!(acc2, 2f32.powi(24).to_bits());
+        // C = 2^24, add 1.0: survives alignment (d = 24, q = 1) but the
+        // 24-bit truncating reduction drops it -> exactly 2^24.
+        a[0] = fp8(false, 7, 0);
+        b[0] = fp8(false, 7, 0);
+        let acc3 = tc_dot_tile(&a, &b, 2f32.powi(24).to_bits());
+        assert_eq!(acc3, 2f32.powi(24).to_bits());
+    }
+
+    /// Zero tile: D = C exactly, including C = 0 -> +0.0.
+    #[test]
+    fn zero_cases() {
+        assert_eq!(tc_dot_tile(&[0; 16], &[0; 16], 0), 0);
+        let c = 3.5f32.to_bits();
+        assert_eq!(tc_dot_tile(&[0; 16], &[0; 16], c), c);
+        // -0.0 accumulator: the zero C term is skipped; result is +0.0.
+        assert_eq!(tc_dot_tile(&[0; 16], &[0; 16], (-0.0f32).to_bits()), 0);
+    }
+
+    /// Exact cancellation to zero across signs.
+    #[test]
+    fn exact_cancellation() {
+        let mut a = [0u8; 16];
+        let mut b = [0u8; 16];
+        a[0] = fp8(false, 7, 0);
+        b[0] = fp8(false, 7, 0);
+        a[1] = fp8(false, 7, 0);
+        b[1] = fp8(true, 7, 0);
+        assert_eq!(tc_dot_tile(&a, &b, 0), 0);
+    }
+}
-- 
