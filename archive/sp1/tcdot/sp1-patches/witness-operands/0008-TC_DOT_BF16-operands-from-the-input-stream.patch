From e37563743b23c612a7ec447a57c214a845380b54 Mon Sep 17 00:00:00 2001
From: verity sp1-tcdot lane <lane@verity.local>
Date: Thu, 24 Sep 2026 08:10:00 +0000
Subject: [PATCH] TC_DOT_BF16: operands from the input stream

The minimal executor takes a TC_DOT_BF16 step's 64 operand bytes from the
next input-stream buffer instead of guest memory, and logs the 8 words with
trace_value for the tracing executor, whose mr_slice_unsafe(8) replays them
unchanged. The operands, free witness values of the chip since the previous
patch, therefore never enter memory: a guest no longer hint-reads them, so it
pays neither their memory init/finalize rows nor their global interactions.
The syscall's first argument stays an aligned address the chip range-checks
and nothing reads. The chip and its cost artifacts are unchanged.

The BF16 chip tests pass their four operand blocks as stdin.
---
 .../executor/src/events/precompiles/tc_dot.rs |  2 +-
 .../src/minimal/precompiles/tc_dot.rs         | 35 ++++++++++---------
 crates/core/executor/src/vm/syscall/tc_dot.rs |  5 +--
 .../src/syscall/precompiles/tc_dot/bf16.rs    | 10 +++---
 .../src/syscall/precompiles/tc_dot/mod.rs     | 34 ++++++++++--------
 5 files changed, 47 insertions(+), 39 deletions(-)

diff --git a/crates/core/executor/src/events/precompiles/tc_dot.rs b/crates/core/executor/src/events/precompiles/tc_dot.rs
index 9b0049c..4828b47 100644
--- a/crates/core/executor/src/events/precompiles/tc_dot.rs
+++ b/crates/core/executor/src/events/precompiles/tc_dot.rs
@@ -28,7 +28,7 @@ pub struct TcDotEvent {
     /// The memory read records for the 4 operand words (`TC_DOT` only).
     pub ab_memory_records: Vec<MemoryReadRecord>,
     /// The 8 operand words of a `TC_DOT_BF16` step: free witness values of its
-    /// chip, read without a memory access.
+    /// chip, from the input stream (never in memory).
     pub ab_words: Vec<u64>,
     /// The memory write record for the accumulator word (empty on trap).
     pub c_memory_records: Vec<MemoryWriteRecord>,
diff --git a/crates/core/executor/src/minimal/precompiles/tc_dot.rs b/crates/core/executor/src/minimal/precompiles/tc_dot.rs
index 4c408f9..6ffadf1 100644
--- a/crates/core/executor/src/minimal/precompiles/tc_dot.rs
+++ b/crates/core/executor/src/minimal/precompiles/tc_dot.rs
@@ -51,14 +51,15 @@ pub(crate) unsafe fn tc_dot(
 /// `m16n8k16` BF16 GroupSum semantics, one accumulator coordinate).
 ///
 /// Register layout:
-/// - arg1 (a0): pointer to the 64-byte operand buffer (16 BF16 A, 16 BF16 B,
-///   little-endian u16 each)
+/// - arg1 (a0): an 8-byte aligned address, the chip's first syscall argument
+///   (nothing is read there)
 /// - arg2 (a1): pointer to the accumulator word; fp32 bits in the low half are
 ///   read as C and overwritten with D (the high half is written to zero).
 ///
-/// The operand words are free witness values of the chip: they are read
-/// without a memory access or a page-prot check, so a proof binds each step's
-/// operands to its decode columns, not to memory.
+/// The operands are the next input-stream buffer: 64 bytes, 16 BF16 A then 16
+/// BF16 B (little-endian u16 each). They are free witness values of the chip
+/// and never enter memory, so a proof binds each step's operands to its decode
+/// columns only.
 pub(crate) unsafe fn tc_dot_bf16(
     ctx: &mut impl SyscallContext,
     arg1: u64,
@@ -74,19 +75,21 @@ pub(crate) unsafe fn tc_dot_bf16(
     ctx.prot_slice_check(c_ptr, 1, PROT_READ | PROT_WRITE)?;
     ctx.set_clk(clk);
 
+    let block = ctx.input_buffer().pop_front().expect("TC_DOT_BF16: input stream exhausted");
+    assert_eq!(block.len(), 64, "TC_DOT_BF16: an operand block is 64 bytes");
     let mut a = [0u16; 16];
     let mut b = [0u16; 16];
-    {
-        let words = ctx.mr_slice_unsafe(ab_ptr, 8);
-        for (w, word) in words.into_iter().enumerate() {
-            for l in 0..4 {
-                let x = (*word >> (16 * l)) as u16;
-                let k = 4 * w + l;
-                if k < 16 {
-                    a[k] = x;
-                } else {
-                    b[k - 16] = x;
-                }
+    for (w, bytes) in block.chunks_exact(8).enumerate() {
+        let word = u64::from_le_bytes(bytes.try_into().unwrap());
+        // Replayed by the tracing executor's `mr_slice_unsafe(8)`.
+        ctx.trace_value(word);
+        for l in 0..4 {
+            let x = (word >> (16 * l)) as u16;
+            let k = 4 * w + l;
+            if k < 16 {
+                a[k] = x;
+            } else {
+                b[k - 16] = x;
             }
         }
     }
diff --git a/crates/core/executor/src/vm/syscall/tc_dot.rs b/crates/core/executor/src/vm/syscall/tc_dot.rs
index c5e839f..3cc74d7 100644
--- a/crates/core/executor/src/vm/syscall/tc_dot.rs
+++ b/crates/core/executor/src/vm/syscall/tc_dot.rs
@@ -50,8 +50,9 @@ pub(crate) fn tc_dot<'a, M: ExecutionMode, RT: SyscallRuntime<'a, M>>(
     assert!(c_ptr.is_multiple_of(8), "c_ptr must be 8-byte aligned");
 
     // TC_DOT reads its 16 fp8 bytes each side from memory. TC_DOT_BF16's 16
-    // BF16 words each side are free witness values of its chip: read without a
-    // memory access or a page-prot check.
+    // BF16 words each side are free witness values of its chip, taken from the
+    // input stream by the minimal executor and replayed here: no memory access
+    // or page-prot check.
     let bf16 = syscall_code == SyscallCode::TC_DOT_BF16;
 
     let clk = rt.core().clk();
diff --git a/crates/core/machine/src/syscall/precompiles/tc_dot/bf16.rs b/crates/core/machine/src/syscall/precompiles/tc_dot/bf16.rs
index b6ed593..4243a2f 100644
--- a/crates/core/machine/src/syscall/precompiles/tc_dot/bf16.rs
+++ b/crates/core/machine/src/syscall/precompiles/tc_dot/bf16.rs
@@ -4,9 +4,10 @@
 //!
 //! Differences from the fp8 front end:
 //! - 8 operand words (16 BF16 A elements, then 16 BF16 B elements, one
-//!   little-endian u16 limb each), which are free witness values: the chip
-//!   reads no memory for them, so a row proves `D = C + A·B` for the operands
-//!   its decode columns hold (only the accumulator goes through memory);
+//!   little-endian u16 limb each), which are free witness values: the executor
+//!   takes each step's from the input stream and the chip reads no memory for
+//!   them, so a row proves `D = C + A·B` for the operands its decode columns
+//!   hold (only the accumulator goes through memory);
 //! - BF16 decode `x = 2^15 s + 2^7 ef + m`, with finiteness (`ef != 255`)
 //!   enforced in-circuit;
 //! - exact 16-bit significand products at nominal exponent
@@ -104,8 +105,7 @@ pub struct TcDotBf16Cols<T, M: TrustMode> {
     pub clk_high: T,
     /// Low 24 bits of the syscall clk.
     pub clk_low: T,
-    /// Pointer to the 64-byte operand buffer (the syscall's first argument; the
-    /// chip does not read it).
+    /// The syscall's first argument, an address the chip does not read.
     pub ab_ptr: SyscallAddrOperation<T>,
     /// Pointer to the accumulator word.
     pub c_ptr: SyscallAddrOperation<T>,
diff --git a/crates/core/machine/src/syscall/precompiles/tc_dot/mod.rs b/crates/core/machine/src/syscall/precompiles/tc_dot/mod.rs
index 5ecac5e..126f483 100644
--- a/crates/core/machine/src/syscall/precompiles/tc_dot/mod.rs
+++ b/crates/core/machine/src/syscall/precompiles/tc_dot/mod.rs
@@ -283,16 +283,17 @@ mod tests {
             assert!(failing_rows(t) > 0, "tampering '{name}' was not caught by the AIR");
         }
     }
-    /// Builds a raw-instruction program exercising `TC_DOT_BF16`:
+    /// Builds a raw-instruction program exercising `TC_DOT_BF16`, with its
+    /// input stream (one 64-byte operand block per call):
     /// 1. mixed signs, a subnormal operand and a nonzero accumulator
     ///    (`0.25 + 1.5 * 1.0 + 2.0 * -1.5 + 2^-133 * 2^127 = -1.234375`),
     /// 2. a second step on the same accumulator (`-2.71875`),
     /// 3. a stage-1 product below the exponent floor (`2^-80 * 2^-80`,
     ///    truncated away in a clamped stage) and `1.0 * 1.0` in stage 2 (`1.0`),
     /// 4. an all-zero tile with a zero accumulator.
-    fn tc_dot_bf16_program() -> Program {
+    fn tc_dot_bf16_program() -> (Program, SP1Stdin) {
         let tiles: [(u64, u64, [(u64, u64); 4], u64); 3] = [
-            // (ab_ptr, c_ptr, [(byte offset, u32 word)], C bits)
+            // (ab_ptr, c_ptr, [(operand block byte offset, u32 word)], C bits)
             (
                 0x2_0000,
                 0x2_0040,
@@ -308,17 +309,19 @@ mod tests {
             (0x4_0000, 0x4_0040, [(0, 0), (16, 0), (32, 0), (48, 0)], 0),
         ];
         let mut instructions = Vec::new();
-        for (ab, c, words, c_bits) in tiles {
-            for off in (0..64).step_by(4) {
-                let w = words.iter().find(|(o, _)| *o == off).map_or(0, |(_, w)| *w);
-                instructions.push(Instruction::new(Opcode::ADDI, 28, 0, w, false, true));
-                instructions.push(Instruction::new(Opcode::SW, 28, 0, ab + off, false, true));
-            }
+        for (_, c, _, c_bits) in tiles {
             instructions.push(Instruction::new(Opcode::ADDI, 26, 0, c_bits, false, true));
             instructions.push(Instruction::new(Opcode::SW, 26, 0, c, false, true));
             instructions.push(Instruction::new(Opcode::SW, 0, 0, c + 4, false, true));
         }
-        for (ab, c) in [(0x2_0000, 0x2_0040), (0x2_0000, 0x2_0040), (0x3_0000, 0x3_0040), (0x4_0000, 0x4_0040)] {
+        let mut stdin = SP1Stdin::new();
+        for tile in [0, 0, 1, 2] {
+            let (ab, c, words, _) = tiles[tile];
+            let mut block = vec![0u8; 64];
+            for (off, w) in words {
+                block[off as usize..off as usize + 4].copy_from_slice(&(w as u32).to_le_bytes());
+            }
+            stdin.write_vec(block);
             instructions.extend([
                 Instruction::new(Opcode::ADDI, 5, 0, SyscallCode::TC_DOT_BF16 as u64, false, true),
                 Instruction::new(Opcode::ADDI, 10, 0, ab, false, true),
@@ -327,7 +330,7 @@ mod tests {
             ]);
         }
         add_halt(&mut instructions);
-        Program::new(instructions, 0, 0)
+        (Program::new(instructions, 0, 0), stdin)
     }
 
     #[test]
@@ -366,16 +369,17 @@ mod tests {
     #[tokio::test]
     async fn test_tc_dot_bf16_prove_core() {
         utils::setup_logger();
-        run_test(Arc::new(tc_dot_bf16_program()), SP1Stdin::new()).await.unwrap();
+        let (program, stdin) = tc_dot_bf16_program();
+        run_test(Arc::new(program), stdin).await.unwrap();
     }
 
     #[test]
     fn test_tc_dot_bf16_negative_soundness() {
-        let program = Arc::new(tc_dot_bf16_program());
+        let (program, stdin) = tc_dot_bf16_program();
+        let program = Arc::new(program);
         let opts = SP1CoreOpts::default();
         let (records, _) =
-            generate_records::<SP1Field>(program.clone(), SP1Stdin::new(), opts.clone(), [0; 4])
-                .unwrap();
+            generate_records::<SP1Field>(program.clone(), stdin, opts.clone(), [0; 4]).unwrap();
         let record = records
             .iter()
             .find(|r| !r.get_precompile_events(SyscallCode::TC_DOT_BF16).is_empty())
