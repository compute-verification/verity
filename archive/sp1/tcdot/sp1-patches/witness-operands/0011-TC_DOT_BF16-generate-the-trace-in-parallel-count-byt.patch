From 6655716e5e4fe1fab4c238e5261d15f433b3b31c Mon Sep 17 00:00:00 2001
From: verity sp1-tcdot lane <lane@verity.local>
Date: Thu, 24 Sep 2026 09:40:00 +0000
Subject: [PATCH] TC_DOT_BF16: generate the trace in parallel, count byte
 lookups in generate_dependencies

The chip filled its rows sequentially and recorded its byte lookups while doing
so, and without a generate_dependencies override the default built the whole
trace (sequentially) once more just for the lookups. Both passes sat between a
precompile shard's events and its GPU proof. Now, as ShaExtend does, the trace
rows are populated with par_chunks_mut, and generate_dependencies counts the
lookups over par_chunks of the events into per-thread maps. Prover only: the
trace values and lookup multiplicities are unchanged, and so are the AIR and
the verifier.
---
 .../src/syscall/precompiles/tc_dot/bf16.rs    | 46 +++++++++++++++----
 1 file changed, 38 insertions(+), 8 deletions(-)

diff --git a/crates/core/machine/src/syscall/precompiles/tc_dot/bf16.rs b/crates/core/machine/src/syscall/precompiles/tc_dot/bf16.rs
index 0ea934e..f9492b1 100644
--- a/crates/core/machine/src/syscall/precompiles/tc_dot/bf16.rs
+++ b/crates/core/machine/src/syscall/precompiles/tc_dot/bf16.rs
@@ -29,12 +29,16 @@ use std::{
     mem::{size_of, MaybeUninit},
 };
 
+use hashbrown::HashMap;
 use itertools::Itertools;
 use slop_air::{Air, BaseAir};
 use slop_algebra::{AbstractField, PrimeField32};
 use slop_matrix::Matrix;
+use slop_maybe_rayon::prelude::{
+    IndexedParallelIterator, ParallelIterator, ParallelSlice, ParallelSliceMut,
+};
 use sp1_core_executor::{
-    events::{ByteRecord, MemoryRecordEnum, PrecompileEvent, TcDotEvent},
+    events::{ByteLookupEvent, ByteRecord, MemoryRecordEnum, PrecompileEvent, TcDotEvent},
     tc_dot::{tc_dot_bf16_witness, TcDotWitness},
     ExecutionRecord, Program, SyscallCode,
 };
@@ -352,7 +356,7 @@ impl<F: PrimeField32, M: TrustMode> MachineAir<F> for TcDotBf16Chip<M> {
     fn generate_trace_into(
         &self,
         input: &ExecutionRecord,
-        output: &mut ExecutionRecord,
+        _: &mut ExecutionRecord,
         buffer: &mut [MaybeUninit<F>],
     ) {
         if input.program.enable_untrusted_programs == M::IS_TRUSTED {
@@ -377,10 +381,9 @@ impl<F: PrimeField32, M: TrustMode> MachineAir<F> for TcDotBf16Chip<M> {
         let rows =
             unsafe { core::slice::from_raw_parts_mut(buffer_ptr, num_event_rows * width) };
 
-        let mut blu = Vec::new();
-
-        for (row, event) in rows.chunks_exact_mut(width).zip(events.iter()) {
-            let event = if let PrecompileEvent::TcDot(event) = &event.1 {
+        // The byte lookups are counted in `generate_dependencies`.
+        rows.par_chunks_mut(width).enumerate().for_each(|(idx, row)| {
+            let event = if let PrecompileEvent::TcDot(event) = &events[idx].1 {
                 event
             } else {
                 unreachable!()
@@ -388,10 +391,37 @@ impl<F: PrimeField32, M: TrustMode> MachineAir<F> for TcDotBf16Chip<M> {
             unsafe {
                 core::ptr::write_bytes(row.as_mut_ptr(), 0, width);
             }
-            self.populate_row(row, event, &mut blu);
+            self.populate_row(row, event, &mut Vec::<ByteLookupEvent>::new());
+        });
+    }
+
+    fn generate_dependencies(&self, input: &ExecutionRecord, output: &mut ExecutionRecord) {
+        if input.program.enable_untrusted_programs == M::IS_TRUSTED {
+            return;
         }
 
-        output.add_byte_lookup_events(blu);
+        let width = size_of::<TcDotBf16Cols<u8, M>>();
+        let events = input.get_precompile_events(SyscallCode::TC_DOT_BF16);
+        let chunk_size = std::cmp::max(events.len() / num_cpus::get(), 1);
+        let blu_batches = events
+            .par_chunks(chunk_size)
+            .map(|events| {
+                let mut blu: HashMap<ByteLookupEvent, usize> = HashMap::new();
+                let mut row = vec![F::zero(); width];
+                for (_, event) in events {
+                    let event = if let PrecompileEvent::TcDot(event) = event {
+                        event
+                    } else {
+                        unreachable!()
+                    };
+                    row.fill(F::zero());
+                    self.populate_row(&mut row, event, &mut blu);
+                }
+                blu
+            })
+            .collect::<Vec<_>>();
+
+        output.add_byte_lookup_events_from_maps(blu_batches.iter().collect_vec());
     }
 
     fn included(&self, shard: &Self::Record) -> bool {
-- 
