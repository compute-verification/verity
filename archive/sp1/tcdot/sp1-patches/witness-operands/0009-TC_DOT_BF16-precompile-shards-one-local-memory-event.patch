From 6096d886e433ca854504ac0c97abf19ed17a7997 Mon Sep 17 00:00:00 2001
From: verity sp1-tcdot lane <lane@verity.local>
Date: Thu, 24 Sep 2026 08:40:00 +0000
Subject: [PATCH] TC_DOT_BF16 precompile shards: one local memory event per run
 of calls

Every precompile call's event carries one MemoryLocalEvent per address it
touched (its first and last access there), and each becomes a MemoryLocal
row plus two Global rows. A VU's 96 TC_DOT_BF16 calls touch one accumulator
word one after another, so in a precompile shard each call's first access is
the previous call's last and the calls' own memory interactions already
chain inside the shard, as repeated accesses do within a CPU shard.

When the prover builds a TC_DOT_BF16 precompile shard's record, it now sorts
the calls' local accesses by address and initial timestamp and folds every
access whose initial record equals the previous access's final record into
that run: the run's head keeps its initial access and takes the last call's
final access, the folded entries are dropped. The MemoryLocal and Global
rows per accumulator word go from one and two per call to one and two per
run (per VU and shard).

Prover-side only: no chip, constraint, executor or verifier change; a merge
that did not chain would leave the memory bus unbalanced and the proof would
not verify.
---
 crates/prover/src/worker/prover/core.rs | 68 ++++++++++++++++++++++++-
 1 file changed, 66 insertions(+), 2 deletions(-)

diff --git a/crates/prover/src/worker/prover/core.rs b/crates/prover/src/worker/prover/core.rs
index 555d04b..4492e3b 100644
--- a/crates/prover/src/worker/prover/core.rs
+++ b/crates/prover/src/worker/prover/core.rs
@@ -10,8 +10,8 @@ use std::{
 use anyhow::anyhow;
 use slop_futures::pipeline::{AsyncEngine, AsyncWorker, Pipeline, SubmitError, SubmitHandle};
 use sp1_core_executor::{
-    events::{PrecompileEvent, SyscallEvent},
-    ExecutionRecord, Program, SP1CoreOpts, SplitOpts,
+    events::{MemoryLocalEvent, MemoryRecord, PrecompileEvent, SyscallEvent},
+    ExecutionRecord, Program, SP1CoreOpts, SplitOpts, SyscallCode,
 };
 use sp1_core_machine::executor::trace_chunk;
 use sp1_core_machine::riscv::RiscvAir;
@@ -42,6 +42,64 @@ use crate::{
     SP1CircuitWitness, SP1ProverComponents,
 };
 
+fn tc_dot_local_access(event: &PrecompileEvent) -> &[MemoryLocalEvent] {
+    match event {
+        PrecompileEvent::TcDot(e) => &e.local_mem_access,
+        _ => &[],
+    }
+}
+
+/// Merges a precompile shard's per-call local memory accesses into runs.
+///
+/// Each call's event carries one [`MemoryLocalEvent`] per address it touched (its first and last access there), and
+/// each becomes a `MemoryLocal` row plus two `Global` rows. When the shard's calls touch an address one after another
+/// with no other access in between (TC_DOT_BF16's accumulator: a VU's 96 calls on one word), every call's first access
+/// is the previous call's last, so the calls' own memory interactions already chain inside the shard, as repeated
+/// accesses do within a CPU shard; one local event per run (its first initial and last final access) balances them.
+fn merge_local_memory_runs(events: &mut [(SyscallEvent, PrecompileEvent)]) {
+    let mut accesses = Vec::new();
+    for (i, (_, event)) in events.iter().enumerate() {
+        for (k, access) in tc_dot_local_access(event).iter().enumerate() {
+            accesses.push((access.addr, access.initial_mem_access.timestamp, i, k));
+        }
+    }
+    accesses.sort_unstable();
+
+    // A run is (head event, head entry, final access of its last call); `absorbed` holds the entries folded into one.
+    let mut runs: Vec<(usize, usize, MemoryRecord)> = Vec::new();
+    let mut absorbed = vec![Vec::new(); events.len()];
+    let mut open: Option<(u64, usize, usize, MemoryRecord)> = None;
+    for &(addr, _, i, k) in &accesses {
+        let access = tc_dot_local_access(&events[i].1)[k];
+        match open {
+            Some((a, hi, hk, last)) if a == addr && last == access.initial_mem_access => {
+                open = Some((a, hi, hk, access.final_mem_access));
+                absorbed[i].push(k);
+            }
+            _ => {
+                runs.extend(open.map(|(_, hi, hk, last)| (hi, hk, last)));
+                open = Some((addr, i, k, access.final_mem_access));
+            }
+        }
+    }
+    runs.extend(open.map(|(_, hi, hk, last)| (hi, hk, last)));
+
+    for (hi, hk, last) in runs {
+        if let PrecompileEvent::TcDot(e) = &mut events[hi].1 {
+            e.local_mem_access[hk].final_mem_access = last;
+        }
+    }
+    for (i, ks) in absorbed.iter().enumerate().filter(|(_, ks)| !ks.is_empty()) {
+        if let PrecompileEvent::TcDot(e) = &mut events[i].1 {
+            let mut k = 0;
+            e.local_mem_access.retain(|_| {
+                k += 1;
+                !ks.contains(&(k - 1))
+            });
+        }
+    }
+}
+
 pub struct SetupTask {
     pub id: TaskId,
     pub elf: Artifact,
@@ -460,6 +518,12 @@ where
                                     );
                             }
 
+                            if code == SyscallCode::TC_DOT_BF16 {
+                                merge_local_memory_runs(
+                                    main_record.precompile_events.events.get_mut(&code).unwrap(),
+                                );
+                            }
+
                             // Set the precompile shard's public values to the initialized state.
                             main_record.public_values.update_initialized_state(
                                 program.pc_start_abs,
