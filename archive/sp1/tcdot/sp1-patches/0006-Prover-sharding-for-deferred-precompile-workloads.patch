From d14b4c6277536abd4121271eecd33e75bec83ff5 Mon Sep 17 00:00:00 2001
From: verity sp1-tcdot lane <lane@verity.local>
Date: Thu, 24 Sep 2026 07:08:00 +0000
Subject: [PATCH] Prover sharding for deferred-precompile workloads

ShapeChecker::handle_mem_event no longer charges a deferred precompile access
to the CPU shard: that access is a MemoryLocal row of the precompile shard.
Before, every fresh operand word a deferred precompile read cost the issuing
CPU shard an estimated MemoryLocal row plus two Global rows (~500 cells), so
TC_DOT_BF16 programs cut CPU shards at about a quarter of their real area.
The estimate stays an upper bound on the CPU shard.

local_gpu_opts honours ELEMENT_THRESHOLD (SP1CoreOpts::default() parses it)
instead of overwriting it; without the variable nothing changes.
---
 crates/core/executor/src/vm/shapes.rs           | 4 +++-
 sp1-gpu/crates/prover_components/src/builder.rs | 5 ++++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/crates/core/executor/src/vm/shapes.rs b/crates/core/executor/src/vm/shapes.rs
index 97f3e1c..f5112a9 100644
--- a/crates/core/executor/src/vm/shapes.rs
+++ b/crates/core/executor/src/vm/shapes.rs
@@ -103,8 +103,10 @@ impl<M: ExecutionMode> ShapeChecker<M> {
         let is_first_read_this_shard = self.shard_start_clk > clk;
         let is_last_read_external = self.is_last_read_external.insert(addr, is_external);
 
+        // A deferred precompile's access is a MemoryLocal row of its precompile shard, never of this one: only this
+        // shard's own accesses open a row here (its first touch of an address, or its first after a deferred one).
         self.local_mem_counts +=
-            (is_first_read_this_shard || (is_last_read_external && !is_external)) as u64;
+            (!is_external && (is_first_read_this_shard || is_last_read_external)) as u64;
     }
 
     #[inline]
diff --git a/sp1-gpu/crates/prover_components/src/builder.rs b/sp1-gpu/crates/prover_components/src/builder.rs
index 5dccd9d..34b8f13 100644
--- a/sp1-gpu/crates/prover_components/src/builder.rs
+++ b/sp1-gpu/crates/prover_components/src/builder.rs
@@ -38,7 +38,10 @@ pub fn local_gpu_opts() -> SP1CoreOpts {
         panic!("Unsupported GPU memory: {gpu_memory_gb}, must be at least 24GB");
     }
 
-    let shard_threshold = if !opts.full_size_shards && gpu_memory_gb <= 30 {
+    let shard_threshold = if std::env::var("ELEMENT_THRESHOLD").is_ok() {
+        // `SP1CoreOpts::default()` parsed it; the core prover's trace buffers are sized from this value.
+        opts.sharding_threshold.element_threshold
+    } else if !opts.full_size_shards && gpu_memory_gb <= 30 {
         ELEMENT_THRESHOLD - (1 << 26) - (1 << 25) - (1 << 24)
     } else {
         ELEMENT_THRESHOLD
-- 
