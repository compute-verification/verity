diff --git a/crates/core/executor/src/minimal/precompiles/tc_dot.rs b/crates/core/executor/src/minimal/precompiles/tc_dot.rs
new file mode 100644
index 000000000..bebccec49
--- /dev/null
+++ b/crates/core/executor/src/minimal/precompiles/tc_dot.rs
@@ -0,0 +1,48 @@
+use sp1_jit::{Interrupt, SyscallContext};
+use sp1_primitives::consts::{PROT_READ, PROT_WRITE};
+
+use crate::tc_dot::tc_dot_tile;
+
+/// Executes one tensor-core dot-product tile step `D = C + A·B` (fp8 E4M3,
+/// Ampere GroupSum semantics).
+///
+/// Register layout:
+/// - arg1 (a0): pointer to the 32-byte operand buffer (16 bytes A, 16 bytes B)
+/// - arg2 (a1): pointer to the accumulator word; fp32 bits in the low half are
+///   read as C and overwritten with D (the high half is written to zero).
+pub(crate) unsafe fn tc_dot(
+    ctx: &mut impl SyscallContext,
+    arg1: u64,
+    arg2: u64,
+) -> Result<Option<u64>, Interrupt> {
+    let ab_ptr = arg1;
+    let c_ptr = arg2;
+    assert!(ab_ptr.is_multiple_of(8), "ab_ptr must be 8-byte aligned");
+    assert!(c_ptr.is_multiple_of(8), "c_ptr must be 8-byte aligned");
+
+    let clk = ctx.get_current_clk();
+    ctx.prot_slice_check(ab_ptr, 4, PROT_READ)?;
+    ctx.bump_memory_clk();
+    ctx.prot_slice_check(c_ptr, 1, PROT_READ | PROT_WRITE)?;
+    ctx.set_clk(clk);
+
+    // Read the 32 operand bytes (traced reads at the base clk).
+    let mut ab = [0u8; 32];
+    {
+        let words = ctx.mr_slice_without_prot(ab_ptr, 4);
+        for (i, w) in words.into_iter().enumerate() {
+            ab[i * 8..(i + 1) * 8].copy_from_slice(&w.to_le_bytes());
+        }
+    }
+    ctx.bump_memory_clk();
+
+    // Read the accumulator without a separate traced access (the write record
+    // below carries the previous value), then write the result in place.
+    let c_bits = ctx.mr_slice_unsafe(c_ptr, 1).into_iter().next().copied().unwrap() as u32;
+    let a: &[u8; 16] = ab[..16].try_into().unwrap();
+    let b: &[u8; 16] = ab[16..].try_into().unwrap();
+    let d_bits = tc_dot_tile(a, b, c_bits);
+    ctx.mw_without_prot(c_ptr, u64::from(d_bits));
+
+    Ok(None)
+}
