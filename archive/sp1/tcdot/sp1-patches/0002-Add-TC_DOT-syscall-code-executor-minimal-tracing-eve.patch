diff --git a/crates/zkvm/entrypoint/src/syscalls/tc_dot.rs b/crates/zkvm/entrypoint/src/syscalls/tc_dot.rs
new file mode 100644
index 000000000..9cfc9839c
--- /dev/null
+++ b/crates/zkvm/entrypoint/src/syscalls/tc_dot.rs
@@ -0,0 +1,33 @@
+#[cfg(target_os = "zkvm")]
+use core::arch::asm;
+
+/// Tensor-core dot-product tile syscall for the SP1 RISC-V zkVM.
+///
+/// Executes one 16-element tile step `D = C + A·B` with fp8 E4M3 operands and
+/// Ampere tensor-core (Hawkeye) GroupSum semantics.
+///
+/// - `ab`: pointer to a 32-byte, 8-byte-aligned buffer holding 16 bytes of A
+///   followed by 16 bytes of B.
+/// - `c`: pointer to an 8-byte-aligned u64 word whose low 32 bits hold the
+///   fp32 accumulator bits C; on return the word holds the fp32 result bits D
+///   (zero-extended to 64 bits).
+///
+/// The operands must be finite E4M3 values (no NaN encoding) and the tile
+/// result must not overflow or underflow fp32 normal range (plus exact zero);
+/// violating inputs cause proving to fail.
+#[allow(unused_variables)]
+#[no_mangle]
+pub extern "C" fn syscall_tc_dot(ab: *const u8, c: *mut u64) {
+    #[cfg(target_os = "zkvm")]
+    unsafe {
+        asm!(
+            "ecall",
+            in("t0") crate::syscalls::TC_DOT,
+            in("a0") ab,
+            in("a1") c,
+        );
+    }
+
+    #[cfg(not(target_os = "zkvm"))]
+    unreachable!()
+}
