@@ -0,0 +1,38 @@
+use deepsize2::DeepSizeOf;
+use serde::{Deserialize, Serialize};
+
+use crate::events::memory::{
+    MemoryLocalEvent, MemoryReadRecord, MemoryWriteRecord, PageProtLocalEvent, PageProtRecord,
+};
+
+/// Page protection records for the `TC_DOT` precompile.
+#[derive(Default, Debug, Clone, Serialize, Deserialize, DeepSizeOf)]
+pub struct TcDotPageProtRecords {
+    /// Page prot records for reading the 32-byte A||B operand buffer.
+    pub read_ab_page_prot_records: Vec<PageProtRecord>,
+    /// Page prot records for reading+writing the accumulator word.
+    pub write_c_page_prot_records: Vec<PageProtRecord>,
+}
+
+/// `TC_DOT` precompile event: one 16-element tensor-core dot-product tile
+/// step `D = C + A·B` (fp8 E4M3 operands, Ampere GroupSum semantics).
+#[derive(Default, Debug, Clone, Serialize, Deserialize, DeepSizeOf)]
+pub struct TcDotEvent {
+    /// The clock cycle.
+    pub clk: u64,
+    /// Pointer to the 32-byte operand buffer (16 bytes A, then 16 bytes B).
+    pub ab_ptr: u64,
+    /// Pointer to the accumulator word (fp32 bits in the low half, read and
+    /// written in place).
+    pub c_ptr: u64,
+    /// The memory read records for the 4 operand words.
+    pub ab_memory_records: Vec<MemoryReadRecord>,
+    /// The memory write record for the accumulator word (empty on trap).
+    pub c_memory_records: Vec<MemoryWriteRecord>,
+    /// The page prot records.
+    pub page_prot_records: TcDotPageProtRecords,
+    /// The local memory access events.
+    pub local_mem_access: Vec<MemoryLocalEvent>,
+    /// The local page prot access events.
+    pub local_page_prot_access: Vec<PageProtLocalEvent>,
+}
