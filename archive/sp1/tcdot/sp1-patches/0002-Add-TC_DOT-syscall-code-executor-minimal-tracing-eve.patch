diff --git a/crates/core/executor/src/vm/syscall/tc_dot.rs b/crates/core/executor/src/vm/syscall/tc_dot.rs
new file mode 100644
index 000000000..d1893b6b4
--- /dev/null
+++ b/crates/core/executor/src/vm/syscall/tc_dot.rs
@@ -0,0 +1,101 @@
+use crate::{
+    events::{
+        MemoryReadRecord, MemoryWriteRecord, PrecompileEvent, TcDotEvent, TcDotPageProtRecords,
+    },
+    vm::syscall::SyscallRuntime,
+    ExecutionMode, SyscallCode, TrapError,
+};
+
+/// Check page permissions for `TC_DOT`. Returns early if a check fails.
+fn trap_tc_dot<'a, M: ExecutionMode, RT: SyscallRuntime<'a, M>>(
+    rt: &mut RT,
+    ab_ptr: u64,
+    c_ptr: u64,
+) -> (TcDotPageProtRecords, Option<TrapError>) {
+    let mut ret = TcDotPageProtRecords {
+        read_ab_page_prot_records: Vec::new(),
+        write_c_page_prot_records: Vec::new(),
+    };
+
+    let (ab_records, ab_error) = rt.read_slice_check(ab_ptr, 4);
+    ret.read_ab_page_prot_records = ab_records;
+    if ab_error.is_some() {
+        return (ret, ab_error);
+    }
+
+    rt.increment_clk();
+
+    let (c_records, c_error) = rt.read_write_slice_check(c_ptr, 1);
+    ret.write_c_page_prot_records = c_records;
+    if c_error.is_some() {
+        return (ret, c_error);
+    }
+
+    (ret, None)
+}
+
+pub(crate) fn tc_dot<'a, M: ExecutionMode, RT: SyscallRuntime<'a, M>>(
+    rt: &mut RT,
+    syscall_code: SyscallCode,
+    arg1: u64,
+    arg2: u64,
+) -> Result<Option<u64>, TrapError> {
+    let ab_ptr = arg1;
+    let c_ptr = arg2;
+    assert!(ab_ptr.is_multiple_of(8), "ab_ptr must be 8-byte aligned");
+    assert!(c_ptr.is_multiple_of(8), "c_ptr must be 8-byte aligned");
+
+    let clk = rt.core().clk();
+
+    let (page_prot_records, is_trap) = trap_tc_dot(rt, ab_ptr, c_ptr);
+
+    // Default values if a trap occurs.
+    let mut ab_memory_records: Vec<MemoryReadRecord> = Vec::new();
+    let mut c_memory_records: Vec<MemoryWriteRecord> = Vec::new();
+
+    rt.reset_clk(clk);
+    if is_trap.is_none() {
+        // Read the 32 operand bytes at the base clk.
+        ab_memory_records = rt.mr_slice_without_prot(ab_ptr, 4);
+        rt.increment_clk();
+        // Skip the oracled untraced accumulator read (the write record below
+        // carries the previous value), then replay the result write.
+        let _ = rt.mr_slice_unsafe(1);
+        c_memory_records = vec![rt.mw_without_prot(c_ptr)];
+    }
+
+    if RT::TRACING {
+        let (local_mem_access, local_page_prot_access) = rt.postprocess_precompile();
+
+        let event = PrecompileEvent::TcDot(TcDotEvent {
+            clk,
+            ab_ptr,
+            c_ptr,
+            ab_memory_records,
+            c_memory_records,
+            page_prot_records,
+            local_mem_access,
+            local_page_prot_access,
+        });
+
+        let syscall_event = rt.syscall_event(
+            clk,
+            syscall_code,
+            arg1,
+            arg2,
+            rt.core().next_pc(),
+            rt.core().exit_code(),
+            None,
+            None,
+            is_trap,
+        );
+
+        rt.add_precompile_event(syscall_code, syscall_event, event);
+    }
+
+    if let Some(err) = is_trap {
+        return Err(err);
+    }
+
+    Ok(None)
+}
