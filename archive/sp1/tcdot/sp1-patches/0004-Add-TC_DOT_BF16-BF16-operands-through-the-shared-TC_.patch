+        }
+        c.nz = F::from_bool(align.nz);
+        c.ismax = F::from_bool(stage.max_idx == Some(0));
+        populate_align(&mut c.align, &align, blu);
+
+        blu.add_bit_range_check(ef, 8);
+        let sub_check = i32::from(ef) - 1 + 256 * i32::from(ef == 0);
+        blu.add_bit_range_check(sub_check as u16, 8);
+        blu.add_bit_range_check(254 - ef, 8);
+        let cnt = i32::from(ef != 0) + man.count_ones() as i32;
+        let nz_check = cnt - 1 + 32 * i32::from(!align.nz);
+        blu.add_bit_range_check(nz_check as u16, 5);
