+/// is subnormal (outside the operand contract).
+fn try_group_sum(terms: [TcTerm; 9]) -> Result<TcGroupWitness, i32> {
     let mut w = TcGroupWitness { terms, ..Default::default() };
 
     // e_max over nonzero terms, clamped below at the floor.
@@ -195,7 +206,7 @@ fn group_sum(terms: [TcTerm; 9]) -> TcGroupWitness {
     if sum == 0 {
         w.out_zero = true;
         w.out = TcTerm::default();
-        return w;
+        return Ok(w);
