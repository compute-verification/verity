-    w
+    Ok(w)
 }
 
 /// Encode a stage-output term as fp32 bits.
@@ -287,6 +296,91 @@ pub fn tc_dot_tile(a: &[u8; 16], b: &[u8; 16], c_bits: u32) -> u32 {
     tc_dot_witness(a, b, c_bits).d_bits
 }
 
+// ---------------------------------------------------------------------------
+// TC_DOT_BF16: BF16 operands through the same Ampere pipeline
+// (`mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32`, one accumulator
+// coordinate: groups [8, 8], width 25, zero exponent -132, truncation).
+// ---------------------------------------------------------------------------
+
+/// Decompose a BF16 word into (significand incl. implicit bit, unbiased
+/// exponent, negative). Subnormals use exponent -126 with no implicit bit.
+#[must_use]
+pub fn bf16_parts(x: u16) -> (u64, i32, bool) {
+    let neg = x >> 15 == 1;
+    let ef = i32::from((x >> 7) & 0xFF);
+    let m = u64::from(x & 0x7F);
+    if ef == 0 {
+        (m, -126, neg)
+    } else {
+        (0x80 | m, ef - 127, neg)
+    }
+}
+
+/// Exact BF16 x BF16 product: the 8x8-bit significand product (at most 16
+/// bits) at the fp32 term scale, exponent = sum of operand exponents.
+#[must_use]
+pub fn bf16_product(a: u16, b: u16) -> TcTerm {
+    let (sa, ea, na) = bf16_parts(a);
+    let (sb, eb, nb) = bf16_parts(b);
+    TcTerm { neg: na != nb, mag: (sa * sb) << 9, e: ea + eb }
+}
+
+/// Why a BF16 tile step lies outside `TC_DOT_BF16`'s operand contract.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TcBf16Violation {
+    /// An operand or the accumulator is inf/NaN.
+    NonFinite,
+    /// A GroupSum output (0 = G1, 1 = D) is nonzero but below the fp32
+    /// normal range.
+    Subnormal(usize),
+    /// A GroupSum output (0 = G1, 1 = D) is above the fp32 range.
+    Overflow(usize),
+}
+
+/// One BF16 16-element tile step with full witness capture, or the reason the
+/// step is outside the chip's operand contract (finite operands and
+/// accumulator; both stage outputs zero or fp32-normal).
+pub fn try_tc_dot_bf16_witness(
+    a: &[u16; 16],
+    b: &[u16; 16],
+    c_bits: u32,
+) -> Result<TcDotWitness, TcBf16Violation> {
+    let finite = |x: u16| (x >> 7) & 0xFF != 0xFF;
+    if (c_bits >> 23) & 0xFF == 0xFF || !a.iter().chain(b.iter()).all(|&x| finite(x)) {
+        return Err(TcBf16Violation::NonFinite);
+    }
+
+    let mut stages = [TcGroupWitness::default(), TcGroupWitness::default()];
+    let mut acc = f32_term(c_bits);
+    for (s, stage) in stages.iter_mut().enumerate() {
+        let mut terms = [TcTerm::default(); 9];
+        terms[0] = acc;
+        for i in 0..8 {
+            terms[i + 1] = bf16_product(a[8 * s + i], b[8 * s + i]);
+        }
+        *stage = try_group_sum(terms).map_err(|_| TcBf16Violation::Subnormal(s))?;
+        if !stage.out_zero && stage.out.e > 127 {
+            return Err(TcBf16Violation::Overflow(s));
+        }
+        acc = stage.out;
+    }
+    let d_bits = pack_f32(acc);
+    Ok(TcDotWitness { stages, d_bits })
+}
+
+/// [`try_tc_dot_bf16_witness`], panicking outside the operand contract.
+#[must_use]
+pub fn tc_dot_bf16_witness(a: &[u16; 16], b: &[u16; 16], c_bits: u32) -> TcDotWitness {
+    try_tc_dot_bf16_witness(a, b, c_bits)
+        .unwrap_or_else(|v| panic!("TC_DOT_BF16 operand contract violation: {v:?}"))
+}
+
+/// One BF16 16-element tile step: returns the new fp32 accumulator bits.
+#[must_use]
+pub fn tc_dot_bf16_tile(a: &[u16; 16], b: &[u16; 16], c_bits: u32) -> u32 {
+    tc_dot_bf16_witness(a, b, c_bits).d_bits
+}
