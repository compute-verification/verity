+/// The operand-independent columns of a `TC_DOT` row: the C accumulator
+/// term, the G1 term's shift gadget, both GroupSum stages and the result's
+/// exponent field.
+pub(super) struct TcBackCols<'a, T> {
+    pub(super) c_term: &'a TcCTermCols<T>,
+    /// The accumulator word's previous value (C in its low half).
+    pub(super) c_prev: &'a Word<T>,
+    pub(super) g1_ismax: T,
+    pub(super) g1_align: &'a TcAlignCols<T>,
+    pub(super) stage: &'a [TcStageCols<T>; 2],
+    pub(super) ef_d: T,
+}
+
+/// Constrains the GroupSum back end shared by the `TC_DOT` variants,
+/// `G1 = GroupSum({C, P1..P8})`, `D = GroupSum({G1, P9..P16})`, and the fp32
+/// pack of D, given the 16 product terms. Returns the result word.
+pub(super) fn eval_pipeline<AB: SP1CoreAirBuilder>(
+    builder: &mut AB,
+    back: TcBackCols<'_, AB::Var>,
+    prod_terms: Vec<TcTermInput<AB>>,
+    prod_aligns: &[&TcAlignCols<AB::Var>],
+    prod_ismaxs: &[AB::Var],
+    is_real: AB::Var,
+    pipeline: TcPipeline,
+) -> Word<AB::Expr> {
+    debug_assert_eq!(prod_terms.len(), TILE);
+    // The C accumulator term (fp32 decode, linked to the write's
+    // prev_value). The high half of the u64 word is ignored.
+    let c = back.c_term;
+    builder.assert_bool(c.s);
+    builder.assert_bool(c.is_sub);
+    builder.assert_bool(c.nz);
+    for bit in c.man_bits {
+        builder.assert_bool(bit);
+    }
+    send_range(builder, c.ef.into(), 8, is_real.into());
+    send_range(
+        builder,
+        c.ef - AB::Expr::one() + c.is_sub * AB::Expr::from_canonical_u32(256),
+        8,
+        is_real.into(),
+    );
+    // Operand contract: C is finite (ef != 255).
+    send_range(
+        builder,
+        AB::Expr::from_canonical_u32(254) - c.ef,
+        8,
+        is_real.into(),
+    );
+    let man_lo = c
+        .man_bits
+        .iter()
+        .take(16)
+        .enumerate()
+        .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << j))
+        .sum::<AB::Expr>();
+    let man_hi = c
+        .man_bits
+        .iter()
+        .enumerate()
+        .skip(16)
+        .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << (j - 16)))
+        .sum::<AB::Expr>();
+    builder.assert_eq(back.c_prev[0], man_lo);
+    builder.assert_eq(
+        back.c_prev[1],
+        c.s * AB::Expr::from_canonical_u32(1 << 15)
+            + c.ef * AB::Expr::from_canonical_u32(1 << 7)
+            + man_hi,
+    );
+
+    // nz == (magnitude != 0), via the bit-count of implicit + mantissa
+    // bits: `cnt - 1 + 32 * (1 - nz)` fits 5 bits iff consistent.
+    let c_implicit = is_real - c.is_sub;
+    let c_cnt =
+        c_implicit.clone() + c.man_bits.iter().map(|b| (*b).into()).sum::<AB::Expr>();
+    send_range(
+        builder,
+        c_cnt - AB::Expr::one()
+            + (is_real - c.nz) * AB::Expr::from_canonical_u32(32),
+        5,
+        is_real.into(),
+    );
+
+    // shifted[d] = (mag_c << 1) >> d, mag_c = implicit * 2^23 + mantissa.
+    let c_shifted = (0..SHIFT_SEL)
+        .map(|d| {
+            let mut acc = AB::Expr::zero();
+            if 24 >= d {
+                acc = acc + c_implicit.clone() * AB::Expr::from_canonical_u32(1 << (24 - d));
+            }
+            for (j, b) in c.man_bits.iter().enumerate() {
+                if j + 1 >= d {
+                    acc = acc + (*b).into() * AB::Expr::from_canonical_u32(1 << (j + 1 - d));
+                }
+            }
+            acc
+        })
+        .collect_vec();
+    let c_term_input = TcTermInput::<AB> {
+        neg: c.s.into(),
+        nz: c.nz.into(),
+        e: c.ef - AB::Expr::from_canonical_u32(127) + c.is_sub,
+        shifted: c_shifted,
+    };
+
+    // Stage 1: G1 = GroupSum({C, P1..P8}).
+    let mut prod_iter = prod_terms.into_iter();
+    let stage1_terms: Vec<TcTermInput<AB>> =
+        std::iter::once(c_term_input).chain(prod_iter.by_ref().take(8)).collect_vec();
+    let stage1_aligns: Vec<&TcAlignCols<AB::Var>> = std::iter::once(&c.align)
+        .chain(prod_aligns[..8].iter().copied())
+        .collect_vec();
+    let stage1_ismaxs: Vec<AB::Var> = std::iter::once(c.ismax)
+        .chain(prod_ismaxs[..8].iter().copied())
+        .collect_vec();
+    let e_out1 = eval_stage(
+        builder,
+        &back.stage[0],
+        &stage1_aligns,
+        &stage1_ismaxs,
+        &stage1_terms,
+        is_real,
+        pipeline,
+    );
+    let g1_nz = is_real - back.stage[0].out_zero;
+
+    // Operand contract: a nonzero G1 is not subnormal (e_out1 >= -126);
+    // e_out1 <= 132 structurally for fp8 operands, so 9 bits suffice.
+    send_range(
+        builder,
+        e_out1.clone() + AB::Expr::from_canonical_u32(126),
+        9,
+        g1_nz.clone(),
+    );
+    if pipeline.g1_overflow_check {
+        // Operand contract: a nonzero G1 does not overflow fp32
+        // (e_out1 <= 127).
+        send_range(
+            builder,
+            AB::Expr::from_canonical_u32(127) - e_out1.clone(),
+            9,
+            g1_nz.clone(),
+        );
+    }
+
+    // Stage 2: D = GroupSum({G1, P9..P16}). G1's doubled magnitude is
+    // `2 * out1 < 2^25`.
+    let g1_shifted = (0..SHIFT_SEL)
+        .map(|d| {
+            back.stage[0]
+                .out_bits
+                .iter()
+                .enumerate()
+                .filter(|(j, _)| j + 1 >= d)
+                .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << (j + 1 - d)))
+                .sum::<AB::Expr>()
+        })
+        .collect_vec();
+    let g1_term = TcTermInput::<AB> {
+        neg: back.stage[0].sign.into(),
+        nz: g1_nz,
+        e: e_out1,
+        shifted: g1_shifted,
+    };
+    let stage2_terms: Vec<TcTermInput<AB>> =
+        std::iter::once(g1_term).chain(prod_iter).collect_vec();
+    let stage2_aligns: Vec<&TcAlignCols<AB::Var>> = std::iter::once(back.g1_align)
+        .chain(prod_aligns[8..].iter().copied())
+        .collect_vec();
+    let stage2_ismaxs: Vec<AB::Var> = std::iter::once(back.g1_ismax)
+        .chain(prod_ismaxs[8..].iter().copied())
+        .collect_vec();
+    let e_out2 = eval_stage(
+        builder,
+        &back.stage[1],
+        &stage2_aligns,
+        &stage2_ismaxs,
+        &stage2_terms,
+        is_real,
+        pipeline,
+    );
+    let d_nz = is_real - back.stage[1].out_zero;
+
+    // fp32 pack: biased exponent (0 for a zero result), with the operand
+    // contract `1 <= ef_d <= 254` (no subnormal, no overflow) enforced by
+    // range checks on nonzero results.
+    builder.assert_eq(
+        back.ef_d,
+        (e_out2 + AB::Expr::from_canonical_u32(127)) * d_nz.clone(),
+    );
+    send_range(builder, back.ef_d - AB::Expr::one(), 8, d_nz.clone());
+    send_range(
+        builder,
+        AB::Expr::from_canonical_u32(254) - back.ef_d,
+        8,
+        d_nz,
+    );
+
+    // Result word: fp32 bits in the low half, zero high half. A zero
+    // result packs to +0.0 (sign is constrained to 0 when out_zero).
+    let d_man_lo = back.stage[1]
+        .out_bits
+        .iter()
+        .take(16)
+        .enumerate()
+        .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << j))
+        .sum::<AB::Expr>();
+    let d_man_hi = back.stage[1]
+        .out_bits
+        .iter()
+        .enumerate()
+        .skip(16)
+        .take(7)
+        .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << (j - 16)))
+        .sum::<AB::Expr>();
+    Word([
+        d_man_lo,
+        back.stage[1].sign * AB::Expr::from_canonical_u32(1 << 15)
+            + back.ef_d * AB::Expr::from_canonical_u32(1 << 7)
+            + d_man_hi,
+        AB::Expr::zero(),
+        AB::Expr::zero(),
+    ])
+}
