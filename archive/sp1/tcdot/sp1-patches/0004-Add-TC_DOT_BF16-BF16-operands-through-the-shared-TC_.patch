+
+/// Executes one BF16 tensor-core dot-product tile step `D = C + A·B` (Ampere
+/// `m16n8k16` BF16 GroupSum semantics, one accumulator coordinate).
+///
+/// Register layout:
+/// - arg1 (a0): pointer to the 64-byte operand buffer (16 BF16 A, 16 BF16 B,
+///   little-endian u16 each)
+/// - arg2 (a1): pointer to the accumulator word; fp32 bits in the low half are
+///   read as C and overwritten with D (the high half is written to zero).
+pub(crate) unsafe fn tc_dot_bf16(
+    ctx: &mut impl SyscallContext,
+    arg1: u64,
+    arg2: u64,
+) -> Result<Option<u64>, Interrupt> {
+    let ab_ptr = arg1;
+    let c_ptr = arg2;
+    assert!(ab_ptr.is_multiple_of(8), "ab_ptr must be 8-byte aligned");
+    assert!(c_ptr.is_multiple_of(8), "c_ptr must be 8-byte aligned");
+
+    let clk = ctx.get_current_clk();
+    ctx.prot_slice_check(ab_ptr, 8, PROT_READ)?;
+    ctx.bump_memory_clk();
+    ctx.prot_slice_check(c_ptr, 1, PROT_READ | PROT_WRITE)?;
+    ctx.set_clk(clk);
+
+    let mut a = [0u16; 16];
+    let mut b = [0u16; 16];
+    {
+        let words = ctx.mr_slice_without_prot(ab_ptr, 8);
+        for (w, word) in words.into_iter().enumerate() {
+            for l in 0..4 {
+                let x = (*word >> (16 * l)) as u16;
+                let k = 4 * w + l;
+                if k < 16 {
+                    a[k] = x;
+                } else {
+                    b[k - 16] = x;
+                }
+            }
+        }
+    }
+    ctx.bump_memory_clk();
+
+    let c_bits = ctx.mr_slice_unsafe(c_ptr, 1).into_iter().next().copied().unwrap() as u32;
+    let d_bits = tc_dot_bf16_tile(&a, &b, c_bits);
+    ctx.mw_without_prot(c_ptr, u64::from(d_bits));
+
+    Ok(None)
+}
