+                Instruction::new(Opcode::ADDI, 5, 0, SyscallCode::TC_DOT_BF16 as u64, false, true),
+                Instruction::new(Opcode::ADDI, 10, 0, ab, false, true),
+                Instruction::new(Opcode::ADDI, 11, 0, c, false, true),
+                Instruction::new(Opcode::ECALL, 5, 10, 11, false, false),
+            ]);
+        }
+        add_halt(&mut instructions);
+        Program::new(instructions, 0, 0)
+    }
