+/// Ampere `mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32` semantics
+/// (one accumulator coordinate).
+///
+/// - `ab`: pointer to a 64-byte, 8-byte-aligned buffer holding 16 BF16 words
+///   of A followed by 16 BF16 words of B (little-endian u16 each).
+/// - `c`: pointer to an 8-byte-aligned u64 word whose low 32 bits hold the
+///   fp32 accumulator bits C; on return the word holds the fp32 result bits D
+///   (zero-extended to 64 bits).
+///
+/// The operands and C must be finite and neither GroupSum stage may produce a
+/// subnormal or overflowing result; violating inputs cause proving to fail.
+#[allow(unused_variables)]
+#[no_mangle]
+pub extern "C" fn syscall_tc_dot_bf16(ab: *const u16, c: *mut u64) {
+    #[cfg(target_os = "zkvm")]
+    unsafe {
+        asm!(
+            "ecall",
+            in("t0") crate::syscalls::TC_DOT_BF16,
+            in("a0") ab,
+            in("a1") c,
+        );
+    }
+
+    #[cfg(not(target_os = "zkvm"))]
+    unreachable!()
+}
