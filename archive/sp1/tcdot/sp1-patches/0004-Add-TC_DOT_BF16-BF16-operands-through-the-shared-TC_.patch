+//! The `TC_DOT_BF16` chip: the `TC_DOT` GroupSum back end fed by BF16
+//! operands, i.e. one accumulator coordinate of Ampere
+//! `mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32` per row.
+//!
+//! Differences from the fp8 front end:
+//! - 8 operand words (16 BF16 A elements, then 16 BF16 B elements, one
+//!   little-endian u16 limb each);
+//! - BF16 decode `x = 2^15 s + 2^7 ef + m`, with finiteness (`ef != 255`)
+//!   enforced in-circuit;
+//! - exact 16-bit significand products at nominal exponent
+//!   `e_a + e_b` (subnormals at -126, unnormalized);
+//! - products can lie below the exponent floor, so a clamped stage may hold
+//!   nonzero terms (`TcPipeline::floor_clamp`), and G1 is range-checked
+//!   against fp32 overflow (`TcPipeline::g1_overflow_check`).
+//!
+//! Operand contract: every operand and the accumulator finite, and both
+//! GroupSum outputs zero or fp32-normal. Steps outside it (a subnormal or
+//! saturating stage) have no satisfying row; the guest computes them in
+//! software.
+
+use std::{
+    borrow::{Borrow, BorrowMut},
+    mem::{size_of, MaybeUninit},
+};
+
+use itertools::Itertools;
+use slop_air::{Air, BaseAir};
+use slop_algebra::{AbstractField, PrimeField32};
+use slop_matrix::Matrix;
+use sp1_core_executor::{
+    events::{ByteRecord, MemoryRecordEnum, PrecompileEvent, TcDotEvent},
+    tc_dot::{tc_dot_bf16_witness, TcDotWitness},
+    ExecutionRecord, Program, SyscallCode,
+};
+use sp1_derive::AlignedBorrow;
+use sp1_hypercube::{
+    air::{InteractionScope, MachineAir},
+    Word,
+};
+use sp1_primitives::consts::{PROT_READ, PROT_WRITE};
+
+use crate::{
+    air::SP1CoreAirBuilder,
+    memory::MemoryAccessCols,
+    operations::{AddrAddOperation, AddressSlicePageProtOperation, SyscallAddrOperation},
+    utils::next_multiple_of_32,
+    SupervisorMode, TrustMode, UserMode,
+};
+
+use super::{
+    air::{eval_pipeline, send_range, TcBackCols, TcTermInput},
+    columns::{TcAlignCols, TcCTermCols, TcStageCols, SHIFT_SEL, TILE},
+    trace::{populate_align, populate_pipeline, TcBackColsMut},
+    TcDotBf16Chip, BF16_PIPELINE,
+};
+
+/// Operand words per row (16 + 16 BF16 elements, four per word).
+pub const BF16_AB_WORDS: usize = 8;
+
+pub const fn num_tc_dot_bf16_cols_supervisor() -> usize {
+    size_of::<TcDotBf16Cols<u8, SupervisorMode>>()
+}
+
+pub const fn num_tc_dot_bf16_cols_user() -> usize {
+    size_of::<TcDotBf16Cols<u8, UserMode>>()
+}
+
+/// Decode of one BF16 word: `x = 2^15 s + 2^7 ef + m`.
+#[derive(AlignedBorrow, Default, Debug, Clone, Copy)]
+#[repr(C)]
+pub struct TcBf16DecodeCols<T> {
+    /// Sign bit.
+    pub s: T,
+    /// Exponent field, in `[0, 255)` (finite).
+    pub ef: T,
+    /// Mantissa field, in `[0, 128)`.
+    pub m: T,
+    /// Whether the exponent field is zero (subnormal), via the range trick
+    /// `ef - 1 + 256*is_sub in [0, 256)`.
+    pub is_sub: T,
+}
+
+/// One BF16 product term inside a GroupSum stage.
+#[derive(AlignedBorrow, Default, Debug, Clone, Copy)]
+#[repr(C)]
+pub struct TcBf16ProdCols<T> {
+    /// Sign of the product (`s_a XOR s_b`).
+    pub neg: T,
+    /// Nonzero flag for the significand product, via the range trick on the
+    /// bit-count sum.
+    pub nz: T,
+    /// Bit decomposition of the significand product `sig_a * sig_b <= 255^2`.
+    pub bits: [T; 16],
+    /// Whether this term achieves the stage's `e_max`.
+    pub ismax: T,
+    /// Alignment shift columns.
+    pub align: TcAlignCols<T>,
+}
+
+/// Columns for the `TC_DOT_BF16` chip (one row per tile syscall).
+#[derive(AlignedBorrow)]
+#[repr(C)]
+pub struct TcDotBf16Cols<T, M: TrustMode> {
+    /// High bits of the syscall clk.
+    pub clk_high: T,
+    /// Low 24 bits of the syscall clk.
+    pub clk_low: T,
+    /// Pointer to the 64-byte operand buffer.
+    pub ab_ptr: SyscallAddrOperation<T>,
+    /// Pointer to the accumulator word.
+    pub c_ptr: SyscallAddrOperation<T>,
+    /// Addresses of the 8 operand words.
+    pub ab_addrs: [AddrAddOperation<T>; BF16_AB_WORDS],
+    /// Memory read columns for the 8 operand words.
+    pub ab_memory: [MemoryAccessCols<T>; BF16_AB_WORDS],
+    /// Memory write columns for the accumulator word.
+    pub c_memory: MemoryAccessCols<T>,
+    /// Decodes of the 32 operand words (A elements 0..16, then B).
+    pub decode: [TcBf16DecodeCols<T>; 32],
+    /// Product terms (0..8 belong to stage 1, 8..16 to stage 2).
+    pub prods: [TcBf16ProdCols<T>; TILE],
+    /// The C accumulator term (stage-1 term 0).
+    pub c_term: TcCTermCols<T>,
+    /// Whether G1 achieves stage 2's `e_max`.
+    pub g1_ismax: T,
+    /// Alignment shift columns for G1 (stage-2 term 0).
+    pub g1_align: TcAlignCols<T>,
+    /// Per-stage GroupSum columns.
+    pub stage: [TcStageCols<T>; 2],
+    /// fp32 exponent field of the result (0 when the result is zero).
+    pub ef_d: T,
+    /// Page prot access for the operand buffer (user mode only).
+    pub ab_page_prot_access: M::SliceProtCols<T>,
+    /// Page prot access for the accumulator word (user mode only).
+    pub c_page_prot_access: M::SliceProtCols<T>,
+    /// Whether this row is real.
+    pub is_real: T,
+}
+
+impl<F, M: TrustMode> BaseAir<F> for TcDotBf16Chip<M> {
+    fn width(&self) -> usize {
+        if M::IS_TRUSTED {
+            num_tc_dot_bf16_cols_supervisor()
+        } else {
+            num_tc_dot_bf16_cols_user()
+        }
+    }
+}
+
+impl<AB, M: TrustMode> Air<AB> for TcDotBf16Chip<M>
+where
+    AB: SP1CoreAirBuilder,
+{
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let local = main.row_slice(0);
+        let local: &TcDotBf16Cols<AB::Var, M> = (*local).borrow();
+
+        builder.assert_bool(local.is_real);
+
+        // Pointers and word addresses.
+        let ab_ptr = SyscallAddrOperation::<AB::F>::eval(
+            builder,
+            8 * BF16_AB_WORDS as u32,
+            local.ab_ptr,
+            local.is_real.into(),
+        );
+        let c_ptr =
+            SyscallAddrOperation::<AB::F>::eval(builder, 8, local.c_ptr, local.is_real.into());
+        for i in 0..BF16_AB_WORDS {
+            AddrAddOperation::<AB::F>::eval(
+                builder,
+                Word([ab_ptr[0].into(), ab_ptr[1].into(), ab_ptr[2].into(), AB::Expr::zero()]),
+                Word::from(8 * i as u64),
+                local.ab_addrs[i],
+                local.is_real.into(),
+            );
+        }
+
+        // Page protection (user mode only): operand reads at clk, then the
+        // accumulator read/write at clk + 1, mirroring the executor.
+        let mut is_not_trap = local.is_real.into();
+        let mut trap_code = AB::Expr::zero();
+        if !M::IS_TRUSTED {
+            let local = main.row_slice(0);
+            let local: &TcDotBf16Cols<AB::Var, UserMode> = (*local).borrow();
+
+            #[cfg(not(feature = "mprotect"))]
+            builder.assert_zero(local.is_real);
+
+            AddressSlicePageProtOperation::<AB::F>::eval(
+                builder,
+                local.clk_high.into(),
+                local.clk_low.into(),
+                &local.ab_ptr.addr.map(Into::into),
+                &local.ab_addrs[BF16_AB_WORDS - 1].value.map(Into::into),
+                PROT_READ,
+                &local.ab_page_prot_access,
+                &mut is_not_trap,
+                &mut trap_code,
+            );
+            AddressSlicePageProtOperation::<AB::F>::eval(
+                builder,
+                local.clk_high.into(),
+                local.clk_low.into() + AB::Expr::one(),
+                &local.c_ptr.addr.map(Into::into),
+                &local.c_ptr.addr.map(Into::into),
+                PROT_READ | PROT_WRITE,
+                &local.c_page_prot_access,
+                &mut is_not_trap,
+                &mut trap_code,
+            );
+        }
+
+        // Memory: read the 8 operand words at clk, write the accumulator word
+        // at clk + 1.
+        builder.eval_memory_access_slice_read(
+            local.clk_high,
+            local.clk_low.into(),
+            &local.ab_addrs.map(|addr| addr.value.map(Into::into)),
+            &local.ab_memory,
+            is_not_trap.clone(),
+        );
+
+        // BF16 decode of the 32 operand limbs, linked to the read words.
+        for k in 0..32 {
+            let d = &local.decode[k];
+            builder.assert_bool(d.s);
+            builder.assert_bool(d.is_sub);
+            send_range(builder, d.ef.into(), 8, local.is_real.into());
+            send_range(builder, d.m.into(), 7, local.is_real.into());
+            // is_sub == (ef == 0): `ef - 1 + 256 * is_sub` fits 8 bits iff
+            // (is_sub = 0 and ef >= 1) or (is_sub = 1 and ef = 0).
+            send_range(
+                builder,
+                d.ef - AB::Expr::one() + d.is_sub * AB::Expr::from_canonical_u32(256),
+                8,
+                local.is_real.into(),
+            );
+            // Operand contract: finite (ef != 255).
+            send_range(
+                builder,
+                AB::Expr::from_canonical_u32(254) - d.ef,
+                8,
+                local.is_real.into(),
+            );
+            builder.assert_eq(
+                local.ab_memory[k / 4].prev_value[k % 4],
+                d.s * AB::Expr::from_canonical_u32(1 << 15)
+                    + d.ef * AB::Expr::from_canonical_u32(1 << 7)
+                    + d.m,
+            );
+        }
+
+        // Product terms: exact 16-bit significand products at 7 + 7 fraction
+        // bits, expanded by 2^9 to 23; the doubled magnitude is
+        // `sigp * 2^10 < 2^26`.
+        let mut prod_terms: Vec<TcTermInput<AB>> = Vec::with_capacity(TILE);
+        for i in 0..TILE {
+            let p = &local.prods[i];
+            let da = &local.decode[i];
+            let db = &local.decode[16 + i];
+
+            builder.assert_bool(p.neg);
+            builder.assert_bool(p.nz);
+            builder.assert_eq(p.neg, da.s + db.s - da.s * db.s * AB::Expr::two());
+
+            for bit in p.bits {
+                builder.assert_bool(bit);
+            }
+            // sig = m + 128 * implicit, with the implicit bit present only for
+            // normals (and vanishing on padding rows via is_real).
+            let sig_a =
+                da.m + (local.is_real - da.is_sub) * AB::Expr::from_canonical_u32(128);
+            let sig_b =
+                db.m + (local.is_real - db.is_sub) * AB::Expr::from_canonical_u32(128);
+            let sigp = p
+                .bits
+                .iter()
+                .enumerate()
+                .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << j))
+                .sum::<AB::Expr>();
+            builder.assert_eq(sigp, sig_a * sig_b);
+
+            // nz == (sigp != 0), via the bit-count: `cnt - 1 + 32 * (1 - nz)`
+            // fits 5 bits iff (nz = 1 and cnt >= 1) or (nz = 0 and cnt = 0).
+            let cnt = p.bits.iter().map(|b| (*b).into()).sum::<AB::Expr>();
+            send_range(
+                builder,
+                cnt - AB::Expr::one()
+                    + (local.is_real - p.nz) * AB::Expr::from_canonical_u32(32),
+                5,
+                local.is_real.into(),
+            );
+
+            // Nominal exponent: e_a + e_b with e = ef - 127 + is_sub.
+            let e =
+                da.ef + db.ef - AB::Expr::from_canonical_u32(254) + da.is_sub + db.is_sub;
+
+            // shifted[d] = (sigp << 10) >> d.
+            let shifted = (0..SHIFT_SEL)
+                .map(|d| {
+                    p.bits
+                        .iter()
+                        .enumerate()
+                        .filter(|(j, _)| j + 10 >= d)
+                        .map(|(j, b)| {
+                            (*b).into() * AB::Expr::from_canonical_u32(1 << (j + 10 - d))
+                        })
+                        .sum::<AB::Expr>()
+                })
+                .collect_vec();
+
+            prod_terms.push(TcTermInput { neg: p.neg.into(), nz: p.nz.into(), e, shifted });
+        }
+
+        let prod_aligns = local.prods.iter().map(|p| &p.align).collect_vec();
+        let prod_ismaxs = local.prods.iter().map(|p| p.ismax).collect_vec();
+        let d_word = eval_pipeline(
+            builder,
+            TcBackCols {
+                c_term: &local.c_term,
+                c_prev: &local.c_memory.prev_value,
+                g1_ismax: local.g1_ismax,
+                g1_align: &local.g1_align,
+                stage: &local.stage,
+                ef_d: local.ef_d,
+            },
+            prod_terms,
+            &prod_aligns,
+            &prod_ismaxs,
+            local.is_real,
+            BF16_PIPELINE,
+        );
+        builder.eval_memory_access_write(
+            local.clk_high,
+            local.clk_low + AB::Expr::one(),
+            &c_ptr.map(Into::into),
+            local.c_memory,
+            d_word,
+            is_not_trap,
+        );
+
+        #[cfg(feature = "mprotect")]
+        builder.assert_eq(
+            builder.extract_public_values().is_untrusted_programs_enabled,
+            AB::Expr::from_bool(!M::IS_TRUSTED),
+        );
+
+        builder.receive_syscall(
+            local.clk_high,
+            local.clk_low.into(),
+            AB::F::from_canonical_u32(SyscallCode::TC_DOT_BF16.syscall_id()),
+            trap_code,
+            ab_ptr.map(Into::into),
+            c_ptr.map(Into::into),
+            local.is_real,
+            InteractionScope::Local,
+        );
+    }
+}
+
+impl<F: PrimeField32, M: TrustMode> MachineAir<F> for TcDotBf16Chip<M> {
+    type Record = ExecutionRecord;
+    type Program = Program;
+
+    fn name(&self) -> &'static str {
+        if M::IS_TRUSTED {
+            "TcDotBf16"
+        } else {
+            "TcDotBf16User"
+        }
+    }
+
+    fn num_rows(&self, input: &Self::Record) -> Option<usize> {
+        if input.program.enable_untrusted_programs == M::IS_TRUSTED {
+            return Some(0);
+        }
+        let nb_rows = input.get_precompile_events(SyscallCode::TC_DOT_BF16).len();
+        let size_log2 = input.fixed_log2_rows::<F, _>(self);
+        Some(next_multiple_of_32(nb_rows, size_log2))
+    }
+
+    fn generate_trace_into(
+        &self,
+        input: &ExecutionRecord,
+        output: &mut ExecutionRecord,
+        buffer: &mut [MaybeUninit<F>],
+    ) {
+        if input.program.enable_untrusted_programs == M::IS_TRUSTED {
+            return;
+        }
+
+        let width = size_of::<TcDotBf16Cols<u8, M>>();
+        let padded_nb_rows = <Self as MachineAir<F>>::num_rows(self, input).unwrap();
+        let events = input.get_precompile_events(SyscallCode::TC_DOT_BF16);
+        let num_event_rows = events.len();
+
+        // Zero the padding rows (all constraints hold on all-zero rows).
+        unsafe {
+            let padding_start = num_event_rows * width;
+            let padding_size = (padded_nb_rows - num_event_rows) * width;
+            if padding_size > 0 {
+                core::ptr::write_bytes(buffer[padding_start..].as_mut_ptr(), 0, padding_size);
+            }
+        }
+
+        let buffer_ptr = buffer.as_mut_ptr() as *mut F;
+        let rows =
+            unsafe { core::slice::from_raw_parts_mut(buffer_ptr, num_event_rows * width) };
+
+        let mut blu = Vec::new();
+
+        for (row, event) in rows.chunks_exact_mut(width).zip(events.iter()) {
+            let event = if let PrecompileEvent::TcDot(event) = &event.1 {
+                event
+            } else {
+                unreachable!()
+            };
+            unsafe {
+                core::ptr::write_bytes(row.as_mut_ptr(), 0, width);
+            }
+            self.populate_row(row, event, &mut blu);
+        }
+
+        output.add_byte_lookup_events(blu);
+    }
+
+    fn included(&self, shard: &Self::Record) -> bool {
+        if M::IS_TRUSTED == shard.program.enable_untrusted_programs {
+            return false;
+        }
+        if let Some(shape) = shard.shape.as_ref() {
+            shape.included::<F, _>(self)
+        } else {
+            !shard.get_precompile_events(SyscallCode::TC_DOT_BF16).is_empty()
+        }
+    }
+}
+
+impl<M: TrustMode> TcDotBf16Chip<M> {
+    fn populate_row<F: PrimeField32>(
+        &self,
+        row: &mut [F],
+        event: &TcDotEvent,
+        blu: &mut impl ByteRecord,
+    ) {
+        let cols: &mut TcDotBf16Cols<F, M> = row.borrow_mut();
+
+        cols.is_real = F::one();
+        cols.clk_high = F::from_canonical_u32((event.clk >> 24) as u32);
+        cols.clk_low = F::from_canonical_u32((event.clk & 0xFF_FFFF) as u32);
+        cols.ab_ptr.populate(blu, event.ab_ptr, 8 * BF16_AB_WORDS as u64);
+        cols.c_ptr.populate(blu, event.c_ptr, 8);
+
+        let mut is_not_trap = true;
+        let mut trap_code = 0u8;
+        if !M::IS_TRUSTED {
+            let cols: &mut TcDotBf16Cols<F, UserMode> = row.borrow_mut();
+            cols.ab_page_prot_access.populate(
+                blu,
+                event.ab_ptr,
+                event.ab_ptr + 8 * (BF16_AB_WORDS as u64 - 1),
+                event.clk,
+                PROT_READ,
+                &event.page_prot_records.read_ab_page_prot_records,
+                &mut is_not_trap,
+                &mut trap_code,
+            );
+            cols.c_page_prot_access.populate(
+                blu,
+                event.c_ptr,
+                event.c_ptr,
+                event.clk + 1,
+                PROT_READ | PROT_WRITE,
+                &event.page_prot_records.write_c_page_prot_records,
+                &mut is_not_trap,
+                &mut trap_code,
+            );
+        }
+
+        let cols: &mut TcDotBf16Cols<F, M> = row.borrow_mut();
+        for i in 0..BF16_AB_WORDS {
+            cols.ab_addrs[i].populate(blu, event.ab_ptr, 8 * i as u64);
+        }
+
+        // Operand limbs and accumulator: zero when trapped (the memory
+        // accesses are then gated off, and the zero tile satisfies every
+        // arithmetic constraint).
+        let mut limbs = [0u16; 32];
+        let mut c_bits = 0u32;
+        if is_not_trap {
+            for w in 0..BF16_AB_WORDS {
+                let record = event.ab_memory_records[w];
+                for l in 0..4 {
+                    limbs[4 * w + l] = (record.value >> (16 * l)) as u16;
+                }
+                cols.ab_memory[w].populate(MemoryRecordEnum::Read(record), blu);
+            }
+            let c_record = event.c_memory_records[0];
+            c_bits = c_record.prev_value as u32;
+            cols.c_memory.populate(MemoryRecordEnum::Write(c_record), blu);
+        } else {
+            for w in 0..BF16_AB_WORDS {
+                cols.ab_memory[w] = MemoryAccessCols::default();
+            }
+            cols.c_memory = MemoryAccessCols::default();
+        }
+
+        // BF16 decode of the operand limbs.
+        for (k, &x) in limbs.iter().enumerate() {
+            let d = &mut cols.decode[k];
+            let s = x >> 15;
+            let ef = (x >> 7) & 0xFF;
+            let m = x & 0x7F;
+            d.s = F::from_canonical_u16(s);
+            d.ef = F::from_canonical_u16(ef);
+            d.m = F::from_canonical_u16(m);
+            d.is_sub = F::from_bool(ef == 0);
+            blu.add_bit_range_check(ef, 8);
+            blu.add_bit_range_check(m, 7);
+            let sub_check = i32::from(ef) - 1 + 256 * i32::from(ef == 0);
+            blu.add_bit_range_check(sub_check as u16, 8);
+            blu.add_bit_range_check(254u16.wrapping_sub(ef), 8);
+        }
+
+        // The reference witness (asserts the operand contract).
+        let a: &[u16; 16] = limbs[..16].try_into().unwrap();
+        let b: &[u16; 16] = limbs[16..].try_into().unwrap();
+        let witness: TcDotWitness = tc_dot_bf16_witness(a, b, c_bits);
+
+        // Product terms. Product i sits at stage i/8, term index i%8 + 1.
+        for i in 0..TILE {
+            let stage = &witness.stages[i / 8];
+            let term_idx = i % 8 + 1;
+            let term = stage.terms[term_idx];
+            let align = stage.align[term_idx];
+            let p = &mut cols.prods[i];
+
+            let sigp = (term.mag >> 9) as u32;
+            p.neg = F::from_bool(term.neg);
+            p.nz = F::from_bool(align.nz);
+            for j in 0..16 {
+                p.bits[j] = F::from_canonical_u32((sigp >> j) & 1);
