{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "verity/drawn-unit-bundle/v2",
 "title": "The drawn-unit replay bundle (verity_e2e_demo.replay_bundle)",
 "description": "Public structure, hiding commitments and paths for each drawn unit of one window; every private byte (rows, salts) is named by [offset, length] in the payload beside it (<name>.bin, mode 0600). Hex strings are lowercase; every path is frame-v3-sha512 siblings, leaf level first. The step commitment is CMP-95 interface 3 (verity/commit-slots/v1).",
 "type": "object",
 "required": ["format", "payload", "window", "target", "draw", "weights", "commitment", "members", "units"],
 "additionalProperties": false,
 "$defs": {
  "h64": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
  "hex": {"type": "string", "pattern": "^([0-9a-f]{2})*$"},
  "path": {"type": "array", "items": {"$ref": "#/$defs/h64"}},
  "span": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "items": false, "minItems": 2},
  "nat": {"type": "integer", "minimum": 0},
  "root": {
   "type": "object",
   "required": ["root", "leaves", "domain", "schema"],
   "additionalProperties": false,
   "properties": {"root": {"$ref": "#/$defs/h64"}, "leaves": {"$ref": "#/$defs/nat"}, "domain": {"$ref": "#/$defs/h64"}, "schema": {"type": "string"}}
  },
  "opening": {
   "description": "verity.ml.commitments.row_table.RootOpening as JSON: one index of a tree over roots, the root there and its multiproof",
   "type": "object", "required": ["indices", "roots", "proof"], "additionalProperties": false,
   "properties": {"indices": {"type": "array", "items": {"$ref": "#/$defs/nat"}, "minItems": 1, "maxItems": 1},
                  "roots": {"type": "array", "items": {"$ref": "#/$defs/h64"}, "minItems": 1, "maxItems": 1},
                  "proof": {"$ref": "#/$defs/path"}}
  },
  "producer": {
   "type": "object", "required": ["block", "step", "slot", "layer", "op", "unit"], "additionalProperties": false,
   "properties": {"block": {"$ref": "#/$defs/nat"}, "step": {"$ref": "#/$defs/nat"}, "slot": {"$ref": "#/$defs/nat"},
                  "layer": {"$ref": "#/$defs/nat"}, "op": {"type": "string"}, "unit": {"$ref": "#/$defs/nat"}}
  },
  "row": {
   "type": "object",
   "required": ["port", "kind", "schema", "words", "row", "salt", "string", "window", "slot", "registered"],
   "additionalProperties": false,
   "properties": {
    "port": {"type": "string"},
    "kind": {"enum": ["in", "out"]},
    "schema": {"type": "string"},
    "words": {"$ref": "#/$defs/nat"},
    "row": {"$ref": "#/$defs/span"},
    "salt": {"$ref": "#/$defs/span"},
    "string": {"type": "string", "pattern": "^[0-9a-f]{256}$"},
    "window": {
     "type": "object", "required": ["port", "leaf", "path"], "additionalProperties": false,
     "properties": {"port": {"type": "string"}, "leaf": {"$ref": "#/$defs/nat"}, "path": {"$ref": "#/$defs/path"}}
    },
    "slot": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/committed"}]},
    "registered": {
     "oneOf": [
      {"type": "null"},
      {"type": "object", "required": ["value", "position", "path"], "additionalProperties": false,
       "properties": {"value": {"type": "string"}, "position": {"$ref": "#/$defs/nat"}, "path": {"$ref": "#/$defs/hex"}}}
     ]
    },
    "reads": {
     "description": "an input row made of committed rows (replay_bundle.Read: at the unit's step or an earlier one, its own slot, e.g. attention's K and V rows), pieces of registered rows (replay_bundle.RegisteredRead: a norm's gain) and position words (replay_bundle.Position); every word no read covers is zero, every word of a row of no reads (a V row past n); slot and registered are then null",
     "type": "array", "items": {"oneOf": [
      {"type": "object", "required": ["kind", "at", "words", "start", "row", "salt", "string", "slot"], "additionalProperties": false,
       "properties": {"kind": {"const": "step"}, "at": {"$ref": "#/$defs/nat"}, "words": {"type": "integer", "minimum": 1},
                      "start": {"$ref": "#/$defs/nat"}, "row": {"$ref": "#/$defs/span"}, "salt": {"$ref": "#/$defs/span"},
                      "string": {"type": "string", "pattern": "^[0-9a-f]{256}$"}, "slot": {"$ref": "#/$defs/committed"}}},
      {"type": "object", "required": ["kind", "at", "words", "start", "value", "position", "row", "salt", "string", "path"],
       "additionalProperties": false,
       "properties": {"kind": {"const": "registered"}, "at": {"$ref": "#/$defs/nat"}, "words": {"type": "integer", "minimum": 1},
                      "start": {"$ref": "#/$defs/nat"}, "value": {"type": "string"}, "position": {"$ref": "#/$defs/nat"},
                      "row": {"$ref": "#/$defs/span"}, "salt": {"$ref": "#/$defs/span"},
                      "string": {"type": "string", "pattern": "^[0-9a-f]{256}$"}, "path": {"$ref": "#/$defs/hex"}}},
      {"type": "object", "required": ["kind", "at", "offset"], "additionalProperties": false,
       "properties": {"kind": {"const": "position"}, "at": {"$ref": "#/$defs/nat"}, "offset": {"enum": [0, 1]}}}
     ]}
    }
   }
  },
  "committed": {
   "description": "a committed row's opening: rank in its layout unit (path), the unit root in its slot tree (slot_path), the slot root in its step tree (step_path); producer null for the unit's own output",
   "type": "object", "required": ["block", "step", "slot", "unit", "rank", "path", "slot_path", "step_path", "producer"],
   "additionalProperties": false,
   "properties": {"block": {"$ref": "#/$defs/nat"}, "step": {"$ref": "#/$defs/nat"}, "slot": {"$ref": "#/$defs/nat"},
                  "unit": {"$ref": "#/$defs/nat"}, "rank": {"$ref": "#/$defs/nat"}, "path": {"$ref": "#/$defs/path"},
                  "slot_path": {"$ref": "#/$defs/opening"}, "step_path": {"$ref": "#/$defs/opening"},
                  "producer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/producer"}]}}
  }
 },
 "properties": {
  "format": {"const": "verity/drawn-unit-bundle/v2"},
  "payload": {
   "type": "object", "required": ["bytes", "sha512", "layout"], "additionalProperties": false,
   "properties": {"bytes": {"$ref": "#/$defs/nat"}, "sha512": {"$ref": "#/$defs/h64"}, "layout": {"type": "string"}}
  },
  "window": {
   "type": "object",
   "required": ["run", "registration", "circuit", "partition", "program", "scheme", "population", "leaf_layer", "roots"],
   "additionalProperties": false,
   "properties": {
    "run": {"type": "string"},
    "registration": {"$ref": "#/$defs/h64"},
    "circuit": {"type": ["object", "string", "null"]},
    "partition": {"$ref": "#/$defs/h64"},
    "program": {"type": "string"},
    "scheme": {"type": "string"},
    "population": {"$ref": "#/$defs/nat"},
    "leaf_layer": {"type": "string"},
    "roots": {"type": "object", "additionalProperties": {"$ref": "#/$defs/root"}}
   }
  },
  "target": {
   "type": "object", "required": ["binding", "card", "dot"], "additionalProperties": false,
   "properties": {"binding": {"enum": ["GEMM_SM120_S8", "GEMM_SM90_S8", "GEMM_HOPPER"]}, "card": {"enum": ["sm_120", "sm_90"]},
                  "dot": {"type": "string"}}
  },
  "draw": {
   "type": "object", "required": ["source", "units"],
   "properties": {"source": {"enum": ["live", "fixture"]}, "law": {"type": "object"}, "receipt": {}, "units": {"type": "array", "items": {"$ref": "#/$defs/nat"}, "uniqueItems": true}},
   "if": {"properties": {"source": {"const": "live"}}},
   "then": {"required": ["receipt"], "properties": {"receipt": {"not": {"enum": [null, "", {}, []]}}}}
  },
  "weights": {
   "type": "object", "required": ["program", "values"], "additionalProperties": false,
   "properties": {
    "program": {"type": ["string", "null"]},
    "values": {"type": "array", "items": {
     "type": "object", "required": ["value", "root", "leaves", "words", "domain", "row_schema"],
     "properties": {"value": {"type": "string"}, "root": {"$ref": "#/$defs/h64"}, "leaves": {"$ref": "#/$defs/nat"}, "words": {"$ref": "#/$defs/nat"},
                    "word_bits": {"enum": [16, 32]}, "domain": {"$ref": "#/$defs/h64"}, "row_schema": {"type": "string"}}
    }}
   }
  },
  "commitment": {
   "type": "object", "required": ["format", "reference", "context", "layout", "layout_digest", "slots", "blocks"], "additionalProperties": false,
   "properties": {
    "format": {"const": "verity/commit-slots/v1"},
    "reference": {"type": "object", "required": ["path", "commit"], "properties": {"path": {"type": "string"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "context": {"$ref": "#/$defs/h64"},
    "layout": {"type": "object", "required": ["name", "groups"], "additionalProperties": false,
               "properties": {"name": {"type": "string"},
                              "groups": {"type": "array", "items": {"oneOf": [
                               {"description": "a group the layout repeats: the index of its first place", "$ref": "#/$defs/nat"},
                               {"type": "object", "required": ["sources", "units"], "additionalProperties": false,
                                "properties": {"sources": {"type": "array", "items": {"$ref": "#/$defs/nat"}},
                                               "units": {"type": "array", "items": {"type": "array", "items": {"type": "array", "items": {
                                                "type": "array", "items": {"$ref": "#/$defs/nat"}, "minItems": 3, "maxItems": 3}}}}}}]}}}},
    "layout_digest": {"$ref": "#/$defs/h64"},
    "slots": {"type": "integer", "minimum": 1},
    "blocks": {"type": "array", "items": {
     "type": "object", "required": ["block", "root", "domain", "steps"], "additionalProperties": false,
     "properties": {
      "block": {"$ref": "#/$defs/nat"}, "root": {"$ref": "#/$defs/h64"}, "domain": {"$ref": "#/$defs/h64"},
      "steps": {"type": "array", "items": {
       "type": "object", "required": ["step", "root", "domain"], "additionalProperties": false,
       "properties": {"step": {"$ref": "#/$defs/nat"}, "root": {"$ref": "#/$defs/h64"}, "domain": {"$ref": "#/$defs/h64"}}
      }}
     }
    }}
   }
  },
  "members": {"type": "array", "items": {
   "type": "object", "required": ["k", "name", "template", "base", "n", "local", "draw", "frame_v3", "public_sha512"],
   "properties": {
    "k": {"$ref": "#/$defs/nat"}, "name": {"type": "string"}, "template": {"type": "string"}, "base": {"$ref": "#/$defs/nat"},
    "n": {"$ref": "#/$defs/nat"}, "local": {"type": "array", "items": {"$ref": "#/$defs/nat"}},
    "draw": {"type": "object", "required": ["law", "population", "k", "units"],
             "properties": {"law": {"const": "subset"}, "population": {"$ref": "#/$defs/nat"}, "k": {"$ref": "#/$defs/nat"},
                            "units": {"type": "array", "items": {"$ref": "#/$defs/nat"}}}},
    "frame_v3": {"type": "object"}, "public_sha512": {"$ref": "#/$defs/h64"}, "row_schemas": {}
   }
  }},
  "units": {"type": "array", "items": {
   "type": "object", "required": ["unit", "coords", "template", "member", "rows"], "additionalProperties": false,
   "properties": {
    "unit": {"$ref": "#/$defs/nat"},
    "coords": {"type": "object", "required": ["block", "step", "slot", "layer", "op", "unit"],
               "properties": {"block": {"$ref": "#/$defs/nat"}, "step": {"$ref": "#/$defs/nat"}, "slot": {"$ref": "#/$defs/nat"},
                              "layer": {"$ref": "#/$defs/nat"}, "op": {"type": "string"}, "unit": {"$ref": "#/$defs/nat"}}},
    "template": {"type": "object", "required": ["id", "definition", "binding", "rows", "outs"],
                 "properties": {"id": {"type": "string"}, "definition": {"type": "string"}, "binding": {"type": "object"},
                                "rows": {"type": "array"}, "outs": {"type": "array"}}},
    "member": {"type": "object", "required": ["k", "local"], "additionalProperties": false,
               "properties": {"k": {"$ref": "#/$defs/nat"}, "local": {"$ref": "#/$defs/nat"}}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
   }
  }}
 }
}
