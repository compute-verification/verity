# /etc/vy/peers: each node's research user reaches the other nodes over the private network with the vy-cluster key. One line a
# machine: its name, then ssh's options and destination. slot.py --twin claims a pair on its HOME machine through this.
vy-nebius-1 -i /home/research/.ssh/vy-cluster -o IdentitiesOnly=yes research@10.80.0.18
vy-nebius-2 -i /home/research/.ssh/vy-cluster -o IdentitiesOnly=yes research@10.80.0.42
