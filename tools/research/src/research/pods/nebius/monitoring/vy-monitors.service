[Unit]
Description=node 1's monitors: one pass, each incident written once when it opens and once when it clears (research/monitors.py)
After=network-online.target

[Service]
Type=oneshot
User=research
Group=research
Nice=10
IOSchedulingClass=idle
# a pass ends by its own deadline (monitors.PASS_S), well inside this
TimeoutStartSec=240
# 3 is another runner holding the state's lock; 1 (the alert dir takes no writes, or a crash) fails the unit
SuccessExitStatus=3
Environment=PYTHONPATH=/usr/local/lib/vy-monitoring
Environment=PYTHONDONTWRITEBYTECODE=1
# VY_MONITORS_SLACK_WEBHOOK, when Slack's incoming webhook is chosen (root-only file; its value is never logged)
EnvironmentFile=-/etc/vy/monitors.env
ExecStartPre=+/usr/bin/install -d -o research -g research /workspace/monitoring/alerts /workspace/monitoring/monitors
ExecStart=/usr/bin/python3 -m research.monitors run --by vy-monitors@vy-nebius-1 --where node --alerts /workspace/monitoring/alerts --state /workspace/monitoring/monitors/state.json
