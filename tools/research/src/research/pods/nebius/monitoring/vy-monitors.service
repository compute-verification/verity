[Unit]
Description=node 1's monitors: one pass, each incident written once when it opens and once when it clears (research/monitors.py)
After=network-online.target

[Service]
Type=oneshot
User=research
Group=research
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=240
# exit 1 is "incidents open", a pass that worked; 3 is another runner holding the state's lock
SuccessExitStatus=1 3
Environment=PYTHONPATH=/usr/local/lib/vy-monitoring
Environment=PYTHONDONTWRITEBYTECODE=1
# VY_MONITORS_SLACK_WEBHOOK, when Slack's incoming webhook is chosen (root-only file; its value is never logged)
EnvironmentFile=-/etc/vy/monitors.env
ExecStartPre=+/usr/bin/install -d -o research -g research /workspace/monitoring/alerts-shadow /workspace/monitoring/monitors
ExecStart=/usr/bin/python3 -m research.monitors run --by vy-monitors@vy-nebius-1 --where node --alerts /workspace/monitoring/alerts-shadow --state /workspace/monitoring/monitors/state-shadow.json
