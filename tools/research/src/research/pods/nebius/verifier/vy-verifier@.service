[Unit]
Description=the verifier's run %i, as auditor from the pinned tree (benchmarks/live_verifier/host.py run)

[Service]
Type=exec
User=auditor
Group=auditor
UMask=0022
WorkingDirectory=/opt/vy-verifier/current
Environment=PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/vy-verifier PATH=/opt/vy-verifier/current/.lean-bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -I /opt/vy-verifier/current/benchmarks/live_verifier/host.py run %i
# the store's copy, whatever the run's end (the credential is only that unit's)
ExecStopPost=+/usr/bin/systemctl --no-block start vy-verifier-publish@%i.service
# a stop's SIGTERM goes to host.py alone, which stops the verifier and still gzips its transcripts and writes its end
KillMode=mixed
TimeoutStopSec=30min
# past the longest run the whitelist allows, so only a run whose prover never came meets it
RuntimeMaxSec=12h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vy-verifier /opt/vy-verifier
