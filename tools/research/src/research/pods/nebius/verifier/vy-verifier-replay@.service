[Unit]
Description=the verifier's run %i replayed through both verifiers, as auditor from the pinned tree (benchmarks/live_verifier/host.py replay)

[Service]
Type=exec
User=auditor
Group=auditor
UMask=0022
WorkingDirectory=/opt/vy-verifier/current
Environment=PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/vy-verifier PATH=/opt/vy-verifier/current/.lean-bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -I /opt/vy-verifier/current/benchmarks/live_verifier/host.py replay %i
ExecStopPost=+/usr/bin/systemctl --no-block start vy-verifier-publish@%i.service
RuntimeMaxSec=12h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vy-verifier /opt/vy-verifier
