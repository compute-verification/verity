# /etc/systemd/system/vy-store-evict.service on vy-nebius-1 and vy-nebius-2 (`research deploy` and cluster_up.sh install it): the job
# pods' store eviction, as ubuntu, the job store's owner. It runs main's copy of `research`, which only `research deploy install`
# places (deploy.toml's whole tree at VY_RESEARCH_TOOL), never a snapshot a `research run` shipped: without the copy a pass refuses.
[Unit]
Description=store eviction: drop local copies the remote store holds

[Service]
Type=oneshot
User=ubuntu
Nice=19
IOSchedulingClass=idle
Environment=VY_RESEARCH_TOOL=/usr/local/lib/vy-monitoring/clean-up
ExecStart=/usr/local/bin/vy-store-evict
