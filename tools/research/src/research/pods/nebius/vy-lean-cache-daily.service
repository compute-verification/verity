[Unit]
Description=Lean build cache: main's Lean packages built in vy-lean-sandbox, then published (lean's publisher, run-daily)
Wants=network-online.target
After=network-online.target

# As root, outside the sandbox: the publisher alone reads /etc/verity/lean-cache.env, and only to upload a build that passed
# `vy-lean-sandbox run` and `clean`. No EnvironmentFile: the key is never in the environment its builds inherit.
[Service]
Type=oneshot
ExecStart=/usr/local/lib/vy-lean-cache/run-daily
TimeoutStartSec=3h
Nice=15
IOSchedulingClass=idle
