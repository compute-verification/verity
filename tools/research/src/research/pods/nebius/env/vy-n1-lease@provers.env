# vy-n1-lease@provers: the provers queue's pool in /run/gpu-lease (n1_lease.py's settings; any not set here is its default).
GPU_LEASE_DIR=/run/gpu-lease
# The temporary raise: while every waiter is preemptible, 4 GPUs past the queue's quota until 10:30Z on 4 Oct, when the borrow
# lapses by itself (n1_lease.py reads VY_POOL_BORROW_UNTIL each tick) and the quota revert timer runs. Then the pool holds what
# the quota allows (VY_POOL_MAX caps it).
VY_POOL_MAX=8
VY_POOL_BORROW=4
VY_POOL_BORROW_UNTIL=2026-10-04T10:30:00Z
