# vy-n1-lease@provers: the provers queue's pool in /run/gpu-lease (n1_lease.py's settings; any not set here is its default).
GPU_LEASE_DIR=/run/gpu-lease
# Past the queue's quota while every waiter is preemptible: 4 GPUs more, to node 1's deadline (a Commit that reclaims one evicts
# its holder). 17 Oct 18:30Z: the 4 Oct borrow had lapsed, so a 1-GPU waiter waited with six GPUs idle (idle-while-waiting-n1).
VY_POOL_MAX=8
VY_POOL_BORROW=4
VY_POOL_BORROW_UNTIL=2026-10-19T15:00:00Z
