GPU_LEASE_DIR=/run/gpu-lease-circuits
VY_POOL_QUEUE=deployments-gpu
VY_POOL_LOCAL_QUEUE=deployments-gpu-pool
VY_POOL_PRIORITY=circuits-gpu
VY_POOL_NAME=circuits
VY_POOL_MAX=6
VY_POOL_IDLE_S=30
