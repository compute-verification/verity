# What a login shell of research's puts before /etc/environment's PATH, for research's loops as units: ~/.local/bin first, so
# kubectl, sky and uv resolve as they did in the loops' tmux panes. A unit reads /etc/environment, this, then its own file.
PATH=/home/research/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
