# its private address; the others are the serving nodes a session's --peer opens `ssh -R PORT` to (benchmarks/live_challenger/
# auditor.py), over their public addresses with the auditor's tunnel key, which research@ each of them authorizes under the
# comment `auditor@vy-challenger-1 tunnel` (vy-challenger-setup made it on this host; its private half never leaves it).
vy-challenger-1 research@10.104.0.21
vy-nebius-1 -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@81.85.2.165
