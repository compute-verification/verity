# /etc/vy/peers on vy-challenger-1, the auditor host (us-north1, outside the nodes' private network). Its own line names it by
# its private address, the one its interface has; the others are the serving nodes a session's --peer opens `ssh -R PORT` to
# (verity/protocols/compose/device/live_challenger/auditor.py), over their public addresses with the auditor's tunnel key, which
# research@ each of them authorizes under the comment `auditor@vy-challenger-1 tunnel` (vy-challenger-setup made it on this
# host; its private half never leaves it). `research deploy` writes this file from the register of machines: a line names its
# machine and the register gives the address. A serving node joins by a line here, and one that is released leaves by its line.
{{vy-challenger-1}} research@{{vy-challenger-1:private_host}}
{{vy-nebius-2}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-nebius-2:host}}
{{vy-auditor-1}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes challenger@{{vy-auditor-1:host}}
{{vy-dc-h200}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-dc-h200:host}}
{{vy-dc-h200-2}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-dc-h200-2:host}}
{{vy-nebius-cpu-4}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-nebius-cpu-4:host}}
{{vy-nebius-cpu-5}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-nebius-cpu-5:host}}
{{vy-nebius-cpu-2}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-nebius-cpu-2:host}}
{{vy-dc-h200-3}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-dc-h200-3:host}}
{{vy-nebius-cpu-6}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-nebius-cpu-6:host}}
{{vy-nebius-cpu-11}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-nebius-cpu-11:host}}
{{vy-nebius-cpu-12}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-nebius-cpu-12:host}}
{{vy-nebius-cpu-3}} -i /var/lib/vy-challenger/.ssh/vy-challenger-tunnel -o IdentitiesOnly=yes research@{{vy-nebius-cpu-3:host}}
