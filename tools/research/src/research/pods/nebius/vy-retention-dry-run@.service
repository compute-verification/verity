# The daily dry run on the node the instance names: `research retention report` (every recorded path, every unowned area, and
# for each big one the owner to ask: its `asks`) to report.json, then `research retention gc` without --apply (what the
# rules and the records would delete, and why each kept path stays) to dry-run.json, both under /workspace/research/retention/.
# A monitor alerts each owner in report.json's `asks`; `now` in each says when it ran. Deletes nothing, takes no lock.
# Report's exit 1 (an owner to ask) is a success here. On vy-nebius-2 it starts only when the fill runner wrote its
# status.txt in the last minute and the first line says `timed False, window waiting False`; report and gc also refuse
# near a booking in fill/windows (exit 3, retried in 20 min).
[Unit]
Description=research retention report and gc dry run on %i (vy-retention-dry-run@%i.timer, daily)
StartLimitIntervalSec=0

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
TimeoutStartSec=3h
Environment=PYTHONPATH=/usr/local/lib/vy-research PYTHONDONTWRITEBYTECODE=1
ExecCondition=/bin/sh -c 'test %i != vy-nebius-2 || { find /workspace/pouw/fill/status.txt -mmin -1 | grep -q . && head -n 1 /workspace/pouw/fill/status.txt | grep -q "timed False, window waiting False"; }'
ExecStart=/usr/bin/python3 -m research retention report --node %i --out /workspace/research/retention/report.json
ExecStart=/usr/bin/python3 -m research retention gc --node %i --out /workspace/research/retention/dry-run.json
SuccessExitStatus=1
Restart=on-failure
RestartSec=20min
RestartPreventExitStatus=2
