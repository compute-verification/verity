# /etc/sudoers.d/50-vy-research: what research (every lane and infra loop) may run as root after the lock-out.
# Generated by `vy-lockout render` from ALLOW in tools/research/src/research/pods/nebius/lockout/lockout.py, which
# gives each line's evidence; edit there. vy-sudo and vy-seal-runs check the arguments sudoers can't.

Cmnd_Alias VY_RESEARCH = \
    /usr/local/sbin/vy-sudo renice *, \
    /usr/local/sbin/vy-sudo taskset *, \
    /usr/local/sbin/vy-sudo systemd-run *, \
    /usr/local/sbin/vy-sudo env *, \
    /usr/local/sbin/vy-sudo systemctl *, \
    /usr/local/sbin/vy-sudo hf-ns *, \
    /usr/local/sbin/vy-seal-runs delete *, \
    /usr/local/sbin/vy-seal-runs evict *, \
    /usr/local/bin/vy-lean-sandbox *, \
    /usr/bin/systemctl start vy-steward-watch.service, \
    /usr/bin/true "", \
    /usr/local/sbin/vy-sudo du-bundles

Cmnd_Alias VY_UBUNTU = \
    /usr/local/sbin/vy-seal-runs evict *, \
    /usr/local/sbin/vy-seal-runs delete *

research ALL=(root) NOPASSWD: VY_RESEARCH
research ALL=(ubuntu, research) NOPASSWD: ALL
ubuntu ALL=(root) NOPASSWD: VY_UBUNTU
