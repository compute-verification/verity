# /etc/sudoers.d/50-vy-research on a CPU node (vy-nebius-cpu-N): what research (every lane and infra loop) may run as root after the lock-out.
# Generated by `vy-lockout render` from CPU_ALLOW in tools/research/src/research/pods/nebius/lockout/lockout.py, which
# gives each line's evidence; edit there. vy-sudo and vy-seal-runs check the arguments sudoers can't.

Cmnd_Alias VY_RESEARCH = \
    /usr/local/sbin/vy-sudo systemd-run *, \
    /usr/local/sbin/vy-sudo systemctl *, \
    /usr/local/sbin/vy-sudo job-reclaim *, \
    /usr/local/sbin/vy-seal-runs delete *, \
    /usr/local/sbin/vy-seal-runs evict *, \
    /usr/bin/systemctl start --no-block vy-lean-cache-daily.service, \
    /usr/bin/true ""

research ALL=(root) NOPASSWD: VY_RESEARCH
research ALL=(research) NOPASSWD: ALL
