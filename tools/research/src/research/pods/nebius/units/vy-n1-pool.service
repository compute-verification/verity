[Unit]
Description=node 1's lease pool and usage for the console (pool_n1.py --loop)
After=network-online.target k3s.service
Wants=network-online.target
RequiresMountsFor=/workspace
StartLimitIntervalSec=1h
StartLimitBurst=10

[Service]
User=research
Group=research
WorkingDirectory=/workspace/verity-guest/bin
EnvironmentFile=/etc/environment
EnvironmentFile=/etc/vy/env/research.env
EnvironmentFile=/etc/vy/env/%N.env
ExecStart=/usr/bin/python3 /workspace/verity-guest/bin/pool_n1.py --loop --every 300
Restart=on-failure
RestartSec=15
Nice=10
IOSchedulingClass=idle
StandardOutput=append:/workspace/verity-guest/pool_n1.out
StandardError=inherit

[Install]
WantedBy=multi-user.target
