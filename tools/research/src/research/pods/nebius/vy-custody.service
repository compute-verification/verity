[Unit]
Description=node 1's ended runs to R2, a Job per run (n1_custody.sh)

[Service]
Type=oneshot
User=research
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
# the CPUs node 1 gives work that names no pool (infra/cluster/descriptions/nebius.toml); its Jobs are pinned there too
CPUAffinity=96-127
# a round starts no Job after 20 min (VY_CUSTODY_PASS_S), and its last Job ends within 30 (activeDeadlineSeconds)
TimeoutStartSec=80min
ExecStart=/bin/bash /usr/local/bin/vy-custody
