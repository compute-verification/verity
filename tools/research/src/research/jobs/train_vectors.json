{
  "schema": "verity/job-service-train-vectors/v1",
  "about": "Stage 1.5 of the Job queue (trains the service builds, checks and lands) as request/response cases. research.jobs.trains runs them (tools/research/tests/test_jobs_vectors.py); the site's TypeScript runs the same file. Everything in vectors.json's `about` holds here too, and each case also starts from `setup.github` in a fake GitHub and an empty fake store. The fake GitHub: `commits` by id, each with `parents` and `files` (the paths it sets against its first parent; null deletes one); a commit's tree is its first-parent chain's files applied in order. `merge(ref, head)` (the Merges API): 204 when head is already an ancestor of the ref's tip; 409 when a path changed on both sides since their merge base has different contents; else 201 and a new commit named `{tip}+{head}` with parents [tip, head], and the ref moves to it. `update_ref(ref, sha)` with force false: 422 unless the old tip is an ancestor of sha; on success every open PR based on that ref whose head is now an ancestor becomes `merged`. The fake store holds `attempts` by run id and `manifests` by art id. Further step forms: `store` adds attempts and manifests (replacing one of the same id, which the real store never does, to keep the cases short); `github_push` puts someone else's commit on a ref (moving it without the fast-forward rule); `github_label` adds a label to a PR; `reconcile: true` runs the reconcile cron, whose `expect.moved` lists the train ids it moved; `expect_github` compares refs (null: the ref must be absent), PRs (a subset of each) and the comments posted, in order.",
  "epoch": "2026-09-29T00:00:00Z",
  "setup": {
    "tokens": [
      {"secret": "tok-coordinator", "name": "coordinator", "scopes": ["jobs:enqueue", "events:read", "trains:write"]},
      {"secret": "tok-lane", "name": "lane-x", "scopes": ["jobs:enqueue"]},
      {"secret": "tok-reader", "name": "root", "scopes": ["events:read"]},
      {"secret": "tok-dispatch", "name": "dispatch-rc", "scopes": ["jobs:work"]}
    ],
    "workers": [
      {"id": "dispatch:rc", "kind": "dispatcher", "token": "dispatch-rc", "kinds": ["merge-check", "lean-regen", "audit-main"]}
    ],
    "github": {
      "commits": {
        "m0": {"parents": [], "files": {"README.md": "verity", "tools/check/tool.py": "CHECK = Tool(name=\"check\", version=\"1\",\n             merge_requires={\"lean-agreement\": [\"backends/flock/\", \"!README.md\", \"!PROTOCOL.md\"]})\n"}},
        "a1": {"parents": ["m0"], "files": {"a.txt": "a"}},
        "b1": {"parents": ["m0"], "files": {"b.txt": "b"}},
        "c1": {"parents": ["a1"], "files": {"c.txt": "c"}},
        "d1": {"parents": ["a1"], "files": {"d.txt": "d"}},
        "x1": {"parents": ["m0"], "files": {"a.txt": "x"}},
        "f1": {"parents": ["m0"], "files": {"backends/flock/src.rs": "fn main() {}"}},
        "r1": {"parents": ["m0"], "files": {"backends/flock/README.md": "flock"}},
        "h1": {"parents": ["m0"], "files": {"h.txt": "h"}},
        "k1": {"parents": ["m0"], "files": {"k.txt": "k"}}
      },
      "refs": {"main": "m0", "pr-a": "a1", "pr-b": "b1", "pr-c": "c1", "pr-d": "d1", "pr-x": "x1", "pr-f": "f1", "pr-r": "r1", "pr-h": "h1", "pr-k": "k1"},
      "prs": [
        {"number": 1, "head": "a1", "head_ref": "pr-a", "base": "main", "labels": [], "state": "open"},
        {"number": 2, "head": "b1", "head_ref": "pr-b", "base": "main", "labels": [], "state": "open"},
        {"number": 3, "head": "c1", "head_ref": "pr-c", "base": "pr-a", "labels": [], "state": "open"},
        {"number": 4, "head": "d1", "head_ref": "pr-d", "base": "pr-a", "labels": [], "state": "open"},
        {"number": 5, "head": "x1", "head_ref": "pr-x", "base": "main", "labels": [], "state": "open"},
        {"number": 6, "head": "f1", "head_ref": "pr-f", "base": "main", "labels": [], "state": "open"},
        {"number": 7, "head": "r1", "head_ref": "pr-r", "base": "main", "labels": [], "state": "open"},
        {"number": 8, "head": "h1", "head_ref": "pr-h", "base": "main", "labels": ["hold"], "state": "open"},
        {"number": 9, "head": "k1", "head_ref": "pr-k", "base": "main", "labels": [], "state": "closed"}
      ]
    }
  },
  "cases": [
    {
