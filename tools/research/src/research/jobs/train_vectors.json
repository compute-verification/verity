         "expect": {"status": 201, "body": {"id": 1, "state": "checking", "prs": [{"number": 1, "head": "a1"}, {"number": 2, "head": "b1"}], "base": "m0",
                                            "tip": "m0+a1+b1", "job": 1, "branch": "train/1", "land": true, "by": "coordinator", "why": null}}},
        {"at": 0, "expect_github": {"refs": {"main": "m0", "train/1": "m0+a1+b1"}}},
        {"at": 1, "req": ["GET", "/api/jobs/1"], "token": "tok-reader",
         "expect": {"status": 200, "body": {"kind": "merge-check", "state": "queued", "dedupe_key": "merge-check:m0+a1+b1", "enqueued_by": "coordinator",
