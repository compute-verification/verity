        {"at": 4, "req": ["GET", "/api/jobs/2"], "token": "tok-reader", "expect": {"status": 200, "body": {"requirements": {"min_lease_s": 8100, "avx512": true}}}},
        {"at": 5, "req": ["GET", "/api/trains"], "token": "tok-lane", "expect": {"status": 200, "body": {"trains": [{"id": 2}, {"id": 1}]}}}
      ]
    },
