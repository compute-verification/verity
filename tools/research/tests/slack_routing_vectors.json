    {
      "name": "a user-group mention without a label routes by the registry's id",
      "msg": {
        "ts": "1700000033.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "<!subteam^SPROOFS> a question"
      },
      "root": null,
      "targets": [
        "proofs"
      ]
    },
