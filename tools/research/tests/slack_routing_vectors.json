      "msg": {
        "ts": "1700000031.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "@circuits keep node 2 quiet tonight"
      },
      "root": null,
      "targets": [
        "circuits"
      ]
    },
    {
      "name": "a user-group mention routes by its label, even with an id the registry lacks",
      "msg": {
        "ts": "1700000032.000001",
