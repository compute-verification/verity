      "root": {
        "ts": "1700000950.000100",
        "bot_id": "B1",
        "username": "comms",
        "text": "Inbox for @comms. This thread holds one-line pointers"
      },
      "targets": []
    },
    {
      "name": "an inbox's own root routes nothing",
      "msg": {
        "ts": "1700000960.000100",
        "bot_id": "B1",
        "username": "comms",
        "text": "Inbox for @comms. This thread holds one-line pointers"
      },
      "root": null,
      "targets": []
    },
    {
