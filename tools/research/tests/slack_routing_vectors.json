{
  "schema": "verity/slack-routing-vectors/v1",
  "about": "The routing rule (research.slack.route_targets): which names a post in #agent-coordination wakes. `msg` is the post, `root` its thread's root (null for a top-level post), `inboxes` every inbox thread's ts, `targets` the names in order. The console site's events route passes the same file.",
  "registry": {
    "handles": [
      {
        "handle": "infra",
        "usergroup": "SINFRA"
      },
      {
        "handle": "proofs",
        "usergroup": "SPROOFS"
      },
      {
        "handle": "circuits",
        "usergroup": "SCIRC"
      },
      {
        "handle": "console",
        "usergroup": null
      }
    ],
    "humans": [
      {
        "name": "Daniel Reuter",
        "slack_user": "UDANIEL"
      }
    ]
  },
  "inboxes": [
    "1700000900.000100"
  ],
  "vectors": [
    {
      "name": "an ask tags its owner's user group",
      "msg": {
        "ts": "1700000001.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "<!subteam^SCIRC|@circuits> can node 2 take a job?"
      },
      "root": null,
      "targets": [
        "circuits"
      ]
    },
    {
      "name": "several plain names at the start, with commas and a colon",
      "msg": {
        "ts": "1700000002.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "@proofs, @circuits: please read this"
      },
      "root": null,
      "targets": [
        "proofs",
        "circuits"
      ]
    },
    {
      "name": "a name later in the text does not route",
      "msg": {
        "ts": "1700000003.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "please ask @circuits about it"
      },
      "root": null,
      "targets": []
    },
    {
      "name": "a worker's name routes like a handle's",
      "msg": {
        "ts": "1700000004.000001",
        "bot_id": "B1",
        "username": "circuits",
        "text": "@vllm-epoch-run stop using node 2"
      },
      "root": null,
      "targets": [
        "vllm-epoch-run"
      ]
    },
    {
      "name": "trailing punctuation is not part of the name",
      "msg": {
        "ts": "1700000005.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "@circuits. one question"
      },
      "root": null,
      "targets": [
        "circuits"
      ]
    },
    {
      "name": "leading whitespace is fine",
      "msg": {
        "ts": "1700000006.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "  \n@circuits hi"
      },
      "root": null,
      "targets": [
        "circuits"
      ]
    },
    {
      "name": "the author is never a target",
      "msg": {
        "ts": "1700000007.000001",
        "bot_id": "B1",
        "username": "circuits",
        "text": "@circuits @infra a note to both of us"
      },
      "root": null,
      "targets": [
        "infra"
      ]
    },
    {
      "name": "names are lower case; an address-like word is not a name",
      "msg": {
        "ts": "1700000008.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "foo@circuits and @Circuits"
      },
      "root": null,
      "targets": []
    },
    {
      "name": "an announcement to every handle wakes every registry handle but its author",
      "msg": {
        "ts": "1700000009.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "📣 *Announcement* from @infra to every handle\nnode 2 reboots"
      },
      "root": null,
      "targets": [
        "proofs",
        "circuits",
        "console"
      ]
    },
    {
      "name": "an announcement as Slack stores it (shortcode) to some names, a worker among them",
      "msg": {
        "ts": "1700000010.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": ":mega: *Announcement* from @infra to <!subteam^SCIRC|@circuits> @vllm-epoch-run\nnode 2 reboots"
      },
      "root": null,
      "targets": [
        "circuits",
        "vllm-epoch-run"
      ]
    },
    {
      "name": "a reply wakes the root's poster",
      "msg": {
        "ts": "1700000011.000002",
        "thread_ts": "1700000011.000001",
        "bot_id": "B1",
        "username": "circuits",
        "text": "yes, from 3 PM"
      },
      "root": {
        "ts": "1700000011.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "<!subteam^SCIRC|@circuits> can node 2 take a job?"
      },
      "targets": [
        "infra"
      ]
    },
    {
      "name": "the poster's own reply wakes the names its root addressed",
      "msg": {
        "ts": "1700000012.000002",
        "thread_ts": "1700000012.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "and by when?"
      },
      "root": {
        "ts": "1700000012.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "@circuits @proofs which of you owns this?"
      },
      "targets": [
        "circuits",
        "proofs"
      ]
    },
    {
      "name": "a reply that names someone wakes them and the root's poster",
      "msg": {
        "ts": "1700000013.000002",
        "thread_ts": "1700000013.000001",
        "bot_id": "B1",
        "username": "circuits",
        "text": "@console can you check the panel?"
      },
      "root": {
        "ts": "1700000013.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "@circuits the panel is stale"
      },
      "targets": [
        "console",
        "infra"
      ]
    },
    {
      "name": "a status line wakes only the root's poster",
      "msg": {
        "ts": "1700000014.000002",
        "thread_ts": "1700000014.000001",
        "bot_id": "B1",
        "username": "circuits",
        "text": "✅ done — https://github.com/danielreuter/verity/pull/1 @proofs"
      },
      "root": {
        "ts": "1700000014.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "@circuits @proofs please"
      },
      "targets": [
        "infra"
      ]
    },
    {
      "name": "a status line as Slack stores it (shortcode)",
      "msg": {
        "ts": "1700000015.000002",
        "thread_ts": "1700000015.000001",
        "bot_id": "B1",
        "username": "circuits",
        "text": ":x: declined — node changes need Daniel"
      },
      "root": {
        "ts": "1700000015.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "@circuits reboot node 2?"
      },
      "targets": [
        "infra"
      ]
    },
    {
      "name": "a status line on your own post wakes no one",
      "msg": {
        "ts": "1700000016.000002",
        "thread_ts": "1700000016.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "✅ done — closed"
      },
      "root": {
        "ts": "1700000016.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "@circuits FYI"
      },
      "targets": []
    },
    {
      "name": "the poster's follow-up on an announcement to every handle wakes no one",
      "msg": {
        "ts": "1700000017.000002",
        "thread_ts": "1700000017.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "correction: 4 PM"
      },
      "root": {
        "ts": "1700000017.000001",
        "bot_id": "B1",
        "username": "infra",
        "text": "📣 *Announcement* from @infra to every handle\nnode 2 reboots at 3 PM"
      },
      "targets": []
    },
    {
      "name": "nothing in an inbox thread routes (by the table)",
      "msg": {
        "ts": "1700000900.000200",
        "thread_ts": "1700000900.000100",
        "bot_id": "B1",
        "username": "router",
        "text": "from infra: https://x/p1700000001000001 @circuits can node 2"
      },
      "root": null,
      "targets": []
    },
    {
      "name": "nothing in an inbox thread routes (by its root, without the table)",
      "msg": {
        "ts": "1700000950.000200",
        "thread_ts": "1700000950.000100",
