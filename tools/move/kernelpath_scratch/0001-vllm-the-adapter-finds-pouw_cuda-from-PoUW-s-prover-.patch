From 35e36a07de1fee763fd7e6a6a5b78acfe751f04a Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 13 Nov 2026 07:54:30 +0000
Subject: [PATCH] vllm: the adapter finds pouw_cuda from PoUW's prover package,
 at both computed paths

pouw_cuda moved from the adapter to verity/protocols/pouw/prover/kernels/pouw_cuda/.
Two paths to it are computed, and the move leaves neither right:

- protocols/pouw/device.py: HERE was Path(__file__).with_name("pouw_cuda"), which the
  mover does not read, so the ncp-v2 builds found no sources.
- commit/row_tables_device.py: the mover re-anchored CUDA_DIR to the checkout's root
  (Path(__file__).resolve().parents[4] / "verity" / ...), which names the files in a
  checkout and nothing where the adapter is installed outside one. The row tables',
  the registered rows', the Z/Y commit's and the receipts' noise kernel's builds all
  go through it.

Both now take the directory from the package that holds it:
Path(prover.__file__).resolve().parent / "kernels" / "pouw_cuda", with
from verity.protocols.pouw import prover. A later move of PoUW rewrites the import and
the path follows. kernels/ needs no __init__.py: the sources are found by path.

Co-authored-by: danielreuter <danielreuter@users.noreply.github.com>
---
 adapters/vllm/verity_vllm/commit/row_tables_device.py | 3 ++-
 adapters/vllm/verity_vllm/protocols/pouw/device.py    | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/adapters/vllm/verity_vllm/commit/row_tables_device.py b/adapters/vllm/verity_vllm/commit/row_tables_device.py
index 74a0b0761d..7785f0eaa4 100644
--- a/adapters/vllm/verity_vllm/commit/row_tables_device.py
+++ b/adapters/vllm/verity_vllm/commit/row_tables_device.py
@@ -39,13 +39,14 @@ from verity.commitments.identity import tagged_sha512
 from verity.commitments.indexed import RangeIndexedDomain
 from verity.commitments.merkle import domain_message
 from verity.definitions.kernels import ROW_COMMIT, SHA512
+from verity.protocols.pouw import prover
 
 from . import row_tables as RTB
 
 __all__ = ["DeviceLibrary", "Pending", "Plan", "device_lib", "host_lib", "host_step", "plan", "record_ready", "side_stream", "step_roots",
            "table_domain_id"]
 
-CUDA_DIR = Path(__file__).resolve().parents[4] / "verity" / "protocols" / "pouw" / "prover" / "kernels" / "pouw_cuda"
+CUDA_DIR = Path(prover.__file__).resolve().parent / "kernels" / "pouw_cuda"
 DEVICE_SOURCES = ("ncp2.cuh", "row_table.cuh", "row_table.cu")
 HOST_SOURCES = ("ncp2.cuh", "row_table.cuh", "row_table_host.cpp")
 #: the headers `ncp2.cuh` and `row_table.cuh` include by name from outside CUDA_DIR (the GPU's one SHA-512 and row commitment):
diff --git a/adapters/vllm/verity_vllm/protocols/pouw/device.py b/adapters/vllm/verity_vllm/protocols/pouw/device.py
index f13a675a34..bd539d764d 100644
--- a/adapters/vllm/verity_vllm/protocols/pouw/device.py
+++ b/adapters/vllm/verity_vllm/protocols/pouw/device.py
@@ -24,13 +24,14 @@ from functools import cache
 from pathlib import Path
 
 import numpy as np
+from verity.protocols.pouw import prover
 from verity.protocols.pouw.prover.circuit import ncp2
 from verity.definitions.kernels import SHA512
 
 from verity_vllm.protocols.pouw import circuit as PC
 from verity_vllm.protocols.pouw import native as PN
 
-HERE = Path(__file__).with_name("pouw_cuda")
+HERE = Path(prover.__file__).resolve().parent / "kernels" / "pouw_cuda"
 #: the GPU's one SHA-512 (`verity.definitions.kernels.SHA512`), which ncp2.cuh includes: a source of every build, by its absolute path
 #: (``HERE / s`` is then the path itself, so its bytes are in `source_digest`), and its directory on every build's include path
 SHA512_SOURCE, SHA512_INCLUDE = str(SHA512.resolve()), f"-I{SHA512.resolve().parent}"
-- 
