+    // The reference semantics clamp into fp32 subnormal range here: the WIDTH-bit magnitude shifts right by
+    // `-126 - e_out` and then drops the extra internal bit, both truncating, which is one truncating shift of the
+    // sum by `e_max + 125` (in [-7, 22], as e_max >= FLOOR and bitlen >= 1). The fp8 chip does not constrain that
+    // path, so it fails loudly instead of producing an unsound trace.
     if e_out < -126 {
-        return Err(e_out);
+        if !subnormal {
+            return Err(e_out);
+        }
+        let k = e_max + 125;
+        let mag = if k >= 0 { w.sum_abs << k } else { w.sum_abs >> -k };
+        debug_assert_eq!(mag, w.mag25 >> (-125 - e_out));
+        w.is_sub = true;
+        w.out = TcTerm { neg: w.sum_neg, mag, e: -126 };
+        return Ok(w);
     }
 
