+/// returned as `Err(e_out)` (outside the operand contract) otherwise.
+fn try_group_sum(terms: [TcTerm; 9], subnormal: bool) -> Result<TcGroupWitness, i32> {
     let mut w = TcGroupWitness { terms, ..Default::default() };
 
     // e_max over nonzero terms, clamped below at the floor.
@@ -227,11 +231,20 @@ fn try_group_sum(terms: [TcTerm; 9]) -> Result<TcGroupWitness, i32> {
     }
