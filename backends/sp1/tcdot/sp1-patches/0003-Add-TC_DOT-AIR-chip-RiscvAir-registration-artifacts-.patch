index 000000000..619e0e767
--- /dev/null
+++ b/crates/core/machine/src/syscall/precompiles/tc_dot/mod.rs
@@ -0,0 +1,238 @@
+//! The `TC_DOT` precompile chip: one 16-element tensor-core dot-product tile
+//! step `D = C + A·B` per row, with fp8 E4M3 operands and Ampere (Hawkeye)
+//! GroupSum semantics.
+//!
+//! # Semantics
+//!
+//! The row constrains, bit-exactly against the reference kernel in
+//! `sp1_core_executor::tc_dot`:
+//! 1. fp8 E4M3 decode of the 32 operand bytes (sign / exponent field /
+//!    mantissa, subnormals unnormalized at nominal exponent -6).
+//! 2. Exact unnormalized products `P_i` expanded to 23 fraction bits.
+//! 3. Two GroupSum stages (`G1 = GroupSum({C, P1..P8})`,
+//!    `D = GroupSum({G1, P9..P16})`), each with:
+//!    - max-exponent selection over nonzero terms (clamped at -132),
+//!    - per-term truncating alignment shifts into a 25-bit adder word,
+//!    - a signed integer sum,
+//!    - truncating normalization back to a 24-bit significand.
+//! 4. fp32 packing of the final term (sign, biased exponent, mantissa).
+//!
+//! # Design
+//!
+//! All shift/truncation logic is expressed via boolean bit decompositions and
+//! one-hot shift selectors, so every arithmetic constraint is a linear
+//! combination of boolean-constrained columns (no witnessed quotients or
+//! remainders, hence no field-wraparound hazards). Variable-width range
+//! checks use the `Range` byte-lookup (`a < 2^b`).
+//!
+//! # Operand contract (v0)
+//!
+//! - fp8 operands are finite (the E4M3 NaN pattern is excluded in-circuit via
+//!   the significand product decomposition; NaN significands are decodable so
+//!   NaN is *not* rejected in-circuit — the executor asserts it instead, and
+//!   the semantics of a hypothetical NaN input follow the reference kernel's
+//!   field-arithmetic reading).
+//! - the fp32 accumulator input must be finite (enforced in-circuit for
+//!   nonzero C via an exponent-field range check).
+//! - neither GroupSum output may be a nonzero fp32 subnormal and the final
+//!   result may not overflow (enforced in-circuit by exponent range checks;
+//!   the executor also asserts, so violations fail at witness generation).
+
+mod air;
+mod columns;
+mod trace;
+
+pub use columns::*;
+
+use std::marker::PhantomData;
+
+use crate::TrustMode;
+
+/// The `TC_DOT` precompile chip.
+pub struct TcDotChip<M: TrustMode> {
+    _marker: PhantomData<M>,
+}
+
+impl<M: TrustMode> Default for TcDotChip<M> {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl<M: TrustMode> TcDotChip<M> {
+    pub const fn new() -> Self {
+        Self { _marker: PhantomData }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::{borrow::BorrowMut, sync::Arc};
+
+    use slop_algebra::AbstractField;
+    use slop_matrix::{dense::RowMajorMatrix, Matrix};
+    use slop_multilinear::Mle;
+    use sp1_core_executor::{
+        add_halt, ExecutionRecord, Instruction, Opcode, Program, SP1CoreOpts, SyscallCode,
+    };
+    use sp1_hypercube::{air::MachineAir, debug_constraints, Chip, MachineRecord};
+    use sp1_primitives::{SP1Field, SP1GlobalContext};
+
+    use super::{columns::TcDotCols, TcDotChip};
+    use crate::{
+        io::SP1Stdin,
+        riscv::RiscvAir,
+        utils::{self, generate_records, run_test},
+        SupervisorMode,
+    };
+
+    /// Builds a raw-instruction program exercising the `TC_DOT` syscall:
+    /// 1. a tile with mixed-sign products and a nonzero accumulator
+    ///    (`0.25 + 1.5 * 1.0 + 2.0 * -1.5 = -1.25`),
+    /// 2. a second step on the same accumulator (`-1.25 - 1.5 = -2.75`),
+    /// 3. an all-zero tile with a zero accumulator (zero-output path).
+    fn tc_dot_program() -> Program {
+        let ab_ptr: u64 = 0x2_0000;
+        let c_ptr: u64 = 0x2_0020;
+        let zero_ab_ptr: u64 = 0x3_0000;
+        let zero_c_ptr: u64 = 0x3_0020;
+
+        let mut instructions = vec![
+            // A[0] = 1.5 (0x3C), A[1] = 2.0 (0x40), A[2..16] = 0.
+            Instruction::new(Opcode::ADDI, 28, 0, 0x403C, false, true),
+            Instruction::new(Opcode::SW, 28, 0, ab_ptr, false, true),
+            Instruction::new(Opcode::SW, 0, 0, ab_ptr + 4, false, true),
+            Instruction::new(Opcode::SW, 0, 0, ab_ptr + 8, false, true),
+            Instruction::new(Opcode::SW, 0, 0, ab_ptr + 12, false, true),
+            // B[0] = 1.0 (0x38), B[1] = -1.5 (0xBC), B[2..16] = 0.
+            Instruction::new(Opcode::ADDI, 27, 0, 0xBC38, false, true),
+            Instruction::new(Opcode::SW, 27, 0, ab_ptr + 16, false, true),
+            Instruction::new(Opcode::SW, 0, 0, ab_ptr + 20, false, true),
+            Instruction::new(Opcode::SW, 0, 0, ab_ptr + 24, false, true),
+            Instruction::new(Opcode::SW, 0, 0, ab_ptr + 28, false, true),
+            // C = 0.25f32 (0x3E80_0000).
+            Instruction::new(Opcode::ADDI, 26, 0, 0x3E80_0000, false, true),
+            Instruction::new(Opcode::SW, 26, 0, c_ptr, false, true),
+            Instruction::new(Opcode::SW, 0, 0, c_ptr + 4, false, true),
+            // Zero tile operands and accumulator.
+            Instruction::new(Opcode::SW, 0, 0, zero_ab_ptr, false, true),
+            Instruction::new(Opcode::SW, 0, 0, zero_ab_ptr + 4, false, true),
+            Instruction::new(Opcode::SW, 0, 0, zero_ab_ptr + 8, false, true),
+            Instruction::new(Opcode::SW, 0, 0, zero_ab_ptr + 12, false, true),
+            Instruction::new(Opcode::SW, 0, 0, zero_ab_ptr + 16, false, true),
+            Instruction::new(Opcode::SW, 0, 0, zero_ab_ptr + 20, false, true),
+            Instruction::new(Opcode::SW, 0, 0, zero_ab_ptr + 24, false, true),
+            Instruction::new(Opcode::SW, 0, 0, zero_ab_ptr + 28, false, true),
+            Instruction::new(Opcode::SW, 0, 0, zero_c_ptr, false, true),
+            Instruction::new(Opcode::SW, 0, 0, zero_c_ptr + 4, false, true),
+        ];
+
+        for (ab, c) in [(ab_ptr, c_ptr), (ab_ptr, c_ptr), (zero_ab_ptr, zero_c_ptr)] {
+            instructions.extend([
+                Instruction::new(
+                    Opcode::ADDI,
+                    5,
+                    0,
+                    SyscallCode::TC_DOT as u64,
+                    false,
+                    true,
+                ),
+                Instruction::new(Opcode::ADDI, 10, 0, ab, false, true),
+                Instruction::new(Opcode::ADDI, 11, 0, c, false, true),
+                Instruction::new(Opcode::ECALL, 5, 10, 11, false, false),
+            ]);
+        }
+
+        add_halt(&mut instructions);
+        Program::new(instructions, 0, 0)
+    }
+
+    #[tokio::test]
+    async fn test_tc_dot_prove_core() {
+        utils::setup_logger();
+        run_test(Arc::new(tc_dot_program()), SP1Stdin::new()).await.unwrap();
+    }
+
+    /// Negative soundness tests: tampering with witnessed columns of a valid
+    /// trace must violate at least one AIR constraint. (Interaction-based
+    /// checks like range lookups are exercised separately by the full proof
+    /// test above; these cover the arithmetic constraint system.)
+    #[test]
+    fn test_tc_dot_negative_soundness() {
+        let program = Arc::new(tc_dot_program());
+        let opts = SP1CoreOpts::default();
+        let (records, _) =
+            generate_records::<SP1Field>(program.clone(), SP1Stdin::new(), opts.clone(), [0; 4])
+                .unwrap();
+        let record = records
+            .iter()
+            .find(|r| !r.get_precompile_events(SyscallCode::TC_DOT).is_empty())
+            .expect("no record with TC_DOT events");
+        assert_eq!(record.get_precompile_events(SyscallCode::TC_DOT).len(), 3);
+
+        let air = TcDotChip::<SupervisorMode>::new();
+        let mut output = ExecutionRecord::new(program, [0; 4], opts.global_dependencies_opt);
+        let trace: RowMajorMatrix<SP1Field> =
+            MachineAir::<SP1Field>::generate_trace(&air, record, &mut output);
+        let width = trace.width();
+
+        let chip = Chip::new(RiscvAir::<SP1Field>::TcDot(TcDotChip::new()));
+        let public_values = MachineRecord::public_values::<SP1Field>(record);
+        let failing_rows = |t: RowMajorMatrix<SP1Field>| {
+            debug_constraints::<SP1GlobalContext, RiscvAir<SP1Field>>(
+                &chip,
+                None,
+                &Mle::from(t),
+                &public_values,
+            )
+            .len()
+        };
+
+        // Control: the honest trace satisfies every constraint.
+        assert_eq!(failing_rows(trace.clone()), 0, "honest trace must satisfy the AIR");
+
+        // Each tampering of row 0 (the mixed-sign nonzero tile) must be
+        // caught by at least one constraint.
+        let tampered: Vec<(&str, Box<dyn Fn(&mut TcDotCols<SP1Field, SupervisorMode>)>)> = vec![
+            (
+                "flip result sign",
+                Box::new(|c| c.stage[1].sign = SP1Field::one() - c.stage[1].sign),
+            ),
+            (
+                "flip result mantissa bit",
+                Box::new(|c| c.stage[1].out_bits[0] = SP1Field::one() - c.stage[1].out_bits[0]),
+            ),
+            (
+                "forge stage-1 max exponent",
+                Box::new(|c| c.stage[0].e_max += SP1Field::one()),
+            ),
+            (
+                "claim nonzero result is zero",
+                Box::new(|c| c.stage[1].out_zero = SP1Field::one()),
+            ),
+            (
+                "corrupt product significand",
+                Box::new(|c| c.prods[0].bits[0] = SP1Field::one() - c.prods[0].bits[0]),
+            ),
+            (
+                "forge accumulator alignment shift",
+                Box::new(|c| {
+                    let d = c.c_term.align.sel.iter().position(|s| *s == SP1Field::one()).unwrap();
+                    c.c_term.align.sel[d] = SP1Field::zero();
+                    c.c_term.align.sel[d ^ 1] = SP1Field::one();
+                }),
+            ),
+            (
+                "forge packed result exponent",
+                Box::new(|c| c.ef_d += SP1Field::one()),
+            ),
+        ];
+        for (name, tamper) in tampered {
+            let mut t = trace.clone();
+            let row = &mut t.values[..width];
+            let cols: &mut TcDotCols<SP1Field, SupervisorMode> = row.borrow_mut();
+            tamper(cols);
+            assert!(failing_rows(t) > 0, "tampering '{name}' was not caught by the AIR");
+        }
+    }
+}
