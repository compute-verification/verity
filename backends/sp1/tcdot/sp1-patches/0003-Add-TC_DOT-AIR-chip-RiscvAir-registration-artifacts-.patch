@@ -0,0 +1,314 @@
+use std::{
+    borrow::BorrowMut,
+    mem::{size_of, MaybeUninit},
+};
+
+use slop_algebra::PrimeField32;
+use sp1_core_executor::{
+    events::{ByteRecord, MemoryRecordEnum, PrecompileEvent, TcDotEvent},
+    tc_dot::{tc_dot_witness, TcAlignWitness, TcDotWitness, TcGroupWitness, SHIFT_CAP},
+    ExecutionRecord, Program, SyscallCode,
+};
+use sp1_hypercube::air::MachineAir;
+use sp1_primitives::consts::{PROT_READ, PROT_WRITE};
+
+use crate::{memory::MemoryAccessCols, utils::next_multiple_of_32, TrustMode, UserMode};
+
+use super::{
+    columns::{TcAlignCols, TcCTermCols, TcDotCols, TcStageCols, SUM_BITS},
+    TcDotChip,
+};
+
+/// Converts a (possibly negative) exponent to a field element.
+fn f_i32<F: PrimeField32>(x: i32) -> F {
+    if x >= 0 {
+        F::from_canonical_u32(x as u32)
+    } else {
+        -F::from_canonical_u32((-x) as u32)
+    }
+}
+
+/// Populates one alignment gadget and its byte lookups.
+fn populate_align<F: PrimeField32>(
+    cols: &mut TcAlignCols<F>,
+    a: &TcAlignWitness,
+    blu: &mut impl ByteRecord,
+) {
+    if a.d_masked < SHIFT_CAP {
+        cols.sel[a.d_masked as usize] = F::one();
+    } else {
+        cols.sel_big = F::one();
+        cols.d_ex = F::from_canonical_u32(a.d_masked - SHIFT_CAP);
+        blu.add_bit_range_check((a.d_masked - SHIFT_CAP) as u16, 9);
+        return;
+    }
+    blu.add_bit_range_check(0, 9);
+}
+
+/// Populates one GroupSum stage's shared columns and byte lookups. Returns
+/// nothing; per-term columns (decode, products, C, G1) are populated by the
+/// caller.
+fn populate_stage<F: PrimeField32>(cols: &mut TcStageCols<F>, w: &TcGroupWitness) {
+    cols.e_max = f_i32(w.e_max);
+    cols.is_clamped = F::from_bool(w.is_clamped);
+    cols.sign = F::from_bool(w.sum_neg);
+    cols.out_zero = F::from_bool(w.out_zero);
+    for j in 0..SUM_BITS {
+        cols.m_bits[j] = F::from_canonical_u64((w.sum_abs >> j) & 1);
+    }
+    if !w.out_zero {
+        let bitlen = (64 - w.sum_abs.leading_zeros()) as usize;
+        cols.len_sel[bitlen - 1] = F::one();
+    }
+    for j in 0..24 {
+        cols.out_bits[j] = F::from_canonical_u64((w.out.mag >> j) & 1);
+    }
+}
+
+impl<F: PrimeField32, M: TrustMode> MachineAir<F> for TcDotChip<M> {
+    type Record = ExecutionRecord;
+    type Program = Program;
+
+    fn name(&self) -> &'static str {
+        if M::IS_TRUSTED {
+            "TcDot"
+        } else {
+            "TcDotUser"
+        }
+    }
+
+    fn num_rows(&self, input: &Self::Record) -> Option<usize> {
+        if input.program.enable_untrusted_programs == M::IS_TRUSTED {
+            return Some(0);
+        }
+        let nb_rows = input.get_precompile_events(SyscallCode::TC_DOT).len();
+        let size_log2 = input.fixed_log2_rows::<F, _>(self);
+        Some(next_multiple_of_32(nb_rows, size_log2))
+    }
+
+    fn generate_trace_into(
+        &self,
+        input: &ExecutionRecord,
+        output: &mut ExecutionRecord,
+        buffer: &mut [MaybeUninit<F>],
+    ) {
+        if input.program.enable_untrusted_programs == M::IS_TRUSTED {
+            return;
+        }
+
+        let width = size_of::<TcDotCols<u8, M>>();
+        let padded_nb_rows = <Self as MachineAir<F>>::num_rows(self, input).unwrap();
+        let events = input.get_precompile_events(SyscallCode::TC_DOT);
+        let num_event_rows = events.len();
+
+        // Zero the padding rows (all constraints hold on all-zero rows).
+        unsafe {
+            let padding_start = num_event_rows * width;
+            let padding_size = (padded_nb_rows - num_event_rows) * width;
+            if padding_size > 0 {
+                core::ptr::write_bytes(buffer[padding_start..].as_mut_ptr(), 0, padding_size);
+            }
+        }
+
+        let buffer_ptr = buffer.as_mut_ptr() as *mut F;
+        let rows =
+            unsafe { core::slice::from_raw_parts_mut(buffer_ptr, num_event_rows * width) };
+
+        let mut blu = Vec::new();
+
+        for (row, event) in rows.chunks_exact_mut(width).zip(events.iter()) {
+            let event = if let PrecompileEvent::TcDot(event) = &event.1 {
+                event
+            } else {
+                unreachable!()
+            };
+            unsafe {
+                core::ptr::write_bytes(row.as_mut_ptr(), 0, width);
+            }
+            self.populate_row(row, event, &mut blu);
+        }
+
+        output.add_byte_lookup_events(blu);
+    }
+
+    fn included(&self, shard: &Self::Record) -> bool {
+        if M::IS_TRUSTED == shard.program.enable_untrusted_programs {
+            return false;
+        }
+        if let Some(shape) = shard.shape.as_ref() {
+            shape.included::<F, _>(self)
+        } else {
+            !shard.get_precompile_events(SyscallCode::TC_DOT).is_empty()
+        }
+    }
+}
+
+impl<M: TrustMode> TcDotChip<M> {
+    fn populate_row<F: PrimeField32>(
+        &self,
+        row: &mut [F],
+        event: &TcDotEvent,
+        blu: &mut impl ByteRecord,
+    ) {
+        let cols: &mut TcDotCols<F, M> = row.borrow_mut();
+
+        cols.is_real = F::one();
+        cols.clk_high = F::from_canonical_u32((event.clk >> 24) as u32);
+        cols.clk_low = F::from_canonical_u32((event.clk & 0xFF_FFFF) as u32);
+        cols.ab_ptr.populate(blu, event.ab_ptr, 32);
+        cols.c_ptr.populate(blu, event.c_ptr, 8);
+
+        let mut is_not_trap = true;
+        let mut trap_code = 0u8;
+        if !M::IS_TRUSTED {
+            let cols: &mut TcDotCols<F, UserMode> = row.borrow_mut();
+            cols.ab_page_prot_access.populate(
+                blu,
+                event.ab_ptr,
+                event.ab_ptr + 24,
+                event.clk,
+                PROT_READ,
+                &event.page_prot_records.read_ab_page_prot_records,
+                &mut is_not_trap,
+                &mut trap_code,
+            );
+            cols.c_page_prot_access.populate(
+                blu,
+                event.c_ptr,
+                event.c_ptr,
+                event.clk + 1,
+                PROT_READ | PROT_WRITE,
+                &event.page_prot_records.write_c_page_prot_records,
+                &mut is_not_trap,
+                &mut trap_code,
+            );
+        }
+
+        let cols: &mut TcDotCols<F, M> = row.borrow_mut();
+        for i in 0..4 {
+            cols.ab_addrs[i].populate(blu, event.ab_ptr, 8 * i as u64);
+        }
+
+        // Operand bytes and accumulator: zero when trapped (the memory
+        // accesses are then gated off, and the zero tile satisfies every
+        // arithmetic constraint).
+        let mut ab = [0u8; 32];
+        let mut c_bits = 0u32;
+        if is_not_trap {
+            for w in 0..4 {
+                let record = event.ab_memory_records[w];
+                ab[w * 8..(w + 1) * 8].copy_from_slice(&record.value.to_le_bytes());
+                cols.ab_memory[w].populate(MemoryRecordEnum::Read(record), blu);
+            }
+            let c_record = event.c_memory_records[0];
+            c_bits = c_record.prev_value as u32;
+            cols.c_memory.populate(MemoryRecordEnum::Write(c_record), blu);
+        } else {
+            for w in 0..4 {
+                cols.ab_memory[w] = MemoryAccessCols::default();
+            }
+            cols.c_memory = MemoryAccessCols::default();
+        }
+
+        // fp8 decode of the operand bytes.
+        for k in 0..32 {
+            let byte = ab[k];
+            let d = &mut cols.decode[k];
+            let s = byte >> 7;
+            let ef = (byte >> 3) & 0xF;
+            let m = byte & 7;
+            d.s = F::from_canonical_u8(s);
+            d.ef = F::from_canonical_u8(ef);
+            d.m = F::from_canonical_u8(m);
+            d.is_sub = F::from_bool(ef == 0);
+            blu.add_bit_range_check(u16::from(ef), 4);
+            blu.add_bit_range_check(u16::from(m), 3);
+            let sub_check = i32::from(ef) - 1 + 16 * i32::from(ef == 0);
+            blu.add_bit_range_check(sub_check as u16, 4);
+        }
+
+        // The reference witness (asserts the operand contract).
+        let a: &[u8; 16] = ab[..16].try_into().unwrap();
+        let b: &[u8; 16] = ab[16..].try_into().unwrap();
+        let witness: TcDotWitness = tc_dot_witness(a, b, c_bits);
+
+        // Product terms. Product i sits at stage i/8, term index i%8 + 1.
+        for i in 0..16 {
+            let stage = &witness.stages[i / 8];
+            let term_idx = i % 8 + 1;
+            let term = stage.terms[term_idx];
+            let align = stage.align[term_idx];
+            let p = &mut cols.prods[i];
+
+            let sigp = (term.mag >> 17) as u16;
+            p.neg = F::from_bool(term.neg);
+            p.nz = F::from_bool(align.nz);
+            for j in 0..8 {
+                p.bits[j] = F::from_canonical_u16((sigp >> j) & 1);
+            }
+            p.ismax = F::from_bool(stage.max_idx == Some(term_idx));
+            populate_align(&mut p.align, &align, blu);
+
+            let cnt = sigp.count_ones() as i32;
+            let nz_check = cnt - 1 + 16 * i32::from(!align.nz);
+            blu.add_bit_range_check(nz_check as u16, 4);
+        }
+
+        // The C accumulator term (stage-1 term 0).
+        {
+            let stage = &witness.stages[0];
+            let align = stage.align[0];
+            let c: &mut TcCTermCols<F> = &mut cols.c_term;
+            let s = (c_bits >> 31) as u16;
+            let ef = ((c_bits >> 23) & 0xFF) as u16;
+            let man = c_bits & 0x7F_FFFF;
+            c.s = F::from_canonical_u16(s);
+            c.ef = F::from_canonical_u16(ef);
+            c.is_sub = F::from_bool(ef == 0);
+            for j in 0..23 {
+                c.man_bits[j] = F::from_canonical_u32((man >> j) & 1);
+            }
+            c.nz = F::from_bool(align.nz);
+            c.ismax = F::from_bool(stage.max_idx == Some(0));
+            populate_align(&mut c.align, &align, blu);
+
+            blu.add_bit_range_check(ef, 8);
+            let sub_check = i32::from(ef) - 1 + 256 * i32::from(ef == 0);
+            blu.add_bit_range_check(sub_check as u16, 8);
+            blu.add_bit_range_check(254 - ef, 8);
+            let cnt = i32::from(ef != 0) + man.count_ones() as i32;
+            let nz_check = cnt - 1 + 32 * i32::from(!align.nz);
+            blu.add_bit_range_check(nz_check as u16, 5);
+        }
+
+        // The G1 term (stage-2 term 0).
+        {
+            let stage = &witness.stages[1];
+            cols.g1_ismax = F::from_bool(stage.max_idx == Some(0));
+            populate_align(&mut cols.g1_align, &stage.align[0], blu);
+        }
+
+        // Stage columns.
+        populate_stage(&mut cols.stage[0], &witness.stages[0]);
+        populate_stage(&mut cols.stage[1], &witness.stages[1]);
+
+        // Stage-1 output exponent contract check (nonzero G1 only).
+        if !witness.stages[0].out_zero {
+            let e_out1 = witness.stages[0].out.e;
+            blu.add_bit_range_check((e_out1 + 126) as u16, 9);
+        }
+
+        // fp32 pack of the final result.
+        if !witness.stages[1].out_zero {
+            let ef_d = witness.stages[1].out.e + 127;
+            cols.ef_d = F::from_canonical_u32(ef_d as u32);
+            blu.add_bit_range_check((ef_d - 1) as u16, 8);
+            blu.add_bit_range_check((254 - ef_d) as u16, 8);
+        }
+
+        // Cross-check the packed result against the memory write.
+        if is_not_trap {
+            debug_assert_eq!(u64::from(witness.d_bits), event.c_memory_records[0].value);
+        }
+    }
+}
