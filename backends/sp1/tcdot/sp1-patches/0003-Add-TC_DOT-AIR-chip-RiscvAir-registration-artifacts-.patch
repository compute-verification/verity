+use std::borrow::Borrow;
+
+use itertools::Itertools;
+use slop_air::{Air, BaseAir};
+use slop_algebra::AbstractField;
+use slop_matrix::Matrix;
+use sp1_core_executor::{ByteOpcode, SyscallCode};
+use sp1_hypercube::{air::InteractionScope, Word};
+use sp1_primitives::consts::{PROT_READ, PROT_WRITE};
+
+use crate::{
+    air::SP1CoreAirBuilder,
+    operations::{AddrAddOperation, AddressSlicePageProtOperation, SyscallAddrOperation},
+    TrustMode, UserMode,
+};
+
+use super::{
+    columns::{
+        num_tc_dot_cols_supervisor, num_tc_dot_cols_user, TcAlignCols, TcDotCols, TcStageCols,
+        OUT_BITS, SHIFT_SEL, TILE,
+    },
+    TcDotChip,
+};
+
+/// The alignment floor for `e_max` (all-zero stages clamp here).
+const FLOOR: u32 = 132;
+/// The adder/normalization width (24 significand bits + 1 extra internal bit).
+const WIDTH: u32 = 25;
+
+impl<F, M: TrustMode> BaseAir<F> for TcDotChip<M> {
+    fn width(&self) -> usize {
+        if M::IS_TRUSTED {
+            num_tc_dot_cols_supervisor()
+        } else {
+            num_tc_dot_cols_user()
+        }
+    }
+}
+
+/// One GroupSum input term, described by expressions over the row.
+struct TcTermInput<AB: SP1CoreAirBuilder> {
+    /// Sign of the term (boolean-valued expression).
+    neg: AB::Expr,
+    /// Nonzero flag (boolean-valued; ties the term's magnitude to zero).
+    nz: AB::Expr,
+    /// Nominal exponent of bit 23 of the magnitude.
+    e: AB::Expr,
+    /// `shifted[d] = floor((2 * mag) / 2^d)` as a linear expression over
+    /// boolean-constrained columns, for `d in 0..SHIFT_SEL`.
+    shifted: Vec<AB::Expr>,
+}
+
+/// Range-check helper: sends `value < 2^bits` with the given multiplicity.
+fn send_range<AB: SP1CoreAirBuilder>(
+    builder: &mut AB,
+    value: AB::Expr,
+    bits: u32,
+    mult: AB::Expr,
+) {
+    builder.send_byte(
+        AB::Expr::from_canonical_u32(ByteOpcode::Range as u32),
+        value,
+        AB::Expr::from_canonical_u32(bits),
+        AB::Expr::zero(),
+        mult,
+    );
+}
+
+/// Constrains the truncating alignment shift of one term and returns the
+/// aligned magnitude `sum_d sel[d] * shifted[d]` (degree 2).
+///
+/// Enforces: selectors boolean and exactly-one on real rows, the selected
+/// shift equals `d_masked = nz * (e_max - e)` (with the `sel_big` bucket
+/// covering `d in [26, 512)` where the term truncates to zero), and `d_ex`
+/// range-checked to 9 bits.
+fn eval_align<AB: SP1CoreAirBuilder>(
+    builder: &mut AB,
+    align: &TcAlignCols<AB::Var>,
+    d_masked: AB::Expr,
+    shifted: &[AB::Expr],
+    is_real: AB::Var,
+) -> AB::Expr {
+    for d in 0..SHIFT_SEL {
+        builder.assert_bool(align.sel[d]);
+    }
+    builder.assert_bool(align.sel_big);
+
+    // Exactly one selector fires on real rows (and none on padding rows).
+    let sel_sum =
+        align.sel.iter().map(|s| (*s).into()).sum::<AB::Expr>() + align.sel_big;
+    builder.assert_eq(sel_sum, is_real.into());
+
+    // The selected shift equals the masked shift distance. `d_ex` covers the
+    // excess over the cap; its 9-bit range check bounds `d_masked < 512`,
+    // which in particular forces `e_max >= e` for nonzero terms.
+    let d_sel = align
+        .sel
+        .iter()
+        .enumerate()
+        .map(|(d, s)| (*s).into() * AB::Expr::from_canonical_usize(d))
+        .sum::<AB::Expr>()
+        + align.sel_big * AB::Expr::from_canonical_u32(SHIFT_SEL as u32)
+        + align.sel_big * align.d_ex;
+    builder.assert_eq(d_sel, d_masked);
+
+    // `d_ex` is zero unless the big bucket fires.
+    builder.assert_zero((AB::Expr::one() - align.sel_big) * align.d_ex);
+    send_range(builder, align.d_ex.into(), 9, is_real.into());
+
+    align
+        .sel
+        .iter()
+        .zip(shifted.iter())
+        .map(|(s, x)| (*s).into() * x.clone())
+        .sum::<AB::Expr>()
+}
+
+/// Constrains one GroupSum stage and returns the output nominal exponent
+/// `e_out = e_max + bitlen - WIDTH` (a degree-1 expression; only meaningful
+/// on real rows with a nonzero output).
+///
+/// The stage's 24-bit output significand lives in `stage.out_bits`, its sign
+/// in `stage.sign`, and its zero flag in `stage.out_zero`.
+fn eval_stage<AB: SP1CoreAirBuilder>(
+    builder: &mut AB,
+    stage: &TcStageCols<AB::Var>,
+    aligns: &[&TcAlignCols<AB::Var>],
+    ismaxs: &[AB::Var],
+    terms: &[TcTermInput<AB>],
+    is_real: AB::Var,
+) -> AB::Expr {
+    debug_assert_eq!(terms.len(), 9);
+
+    // e_max selection. `is_clamped` fires exactly when every term is zero,
+    // pinning `e_max = -FLOOR`; otherwise exactly one nonzero term achieves
+    // `e_max` (witnessed by `ismax`), and the per-term alignment range checks
+    // force `e_max >= e` for every other nonzero term.
+    builder.assert_bool(stage.is_clamped);
+    builder
+        .assert_zero(stage.is_clamped * (stage.e_max + AB::Expr::from_canonical_u32(FLOOR)));
+    for t in terms {
+        builder.assert_zero(stage.is_clamped * t.nz.clone());
+    }
+    let ismax_sum = ismaxs.iter().map(|v| (*v).into()).sum::<AB::Expr>();
+    builder.assert_eq(ismax_sum, is_real - stage.is_clamped);
+    for (ismax, t) in ismaxs.iter().zip(terms.iter()) {
+        builder.assert_bool(*ismax);
+        // ismax implies the term is nonzero...
+        builder.assert_zero((*ismax).into() * (AB::Expr::one() - t.nz.clone()));
+        // ...and that the term sits exactly at e_max.
+        builder.assert_zero((*ismax).into() * (stage.e_max - t.e.clone()));
+    }
+
+    // Align every term and form the signed sum.
+    let mut sum = AB::Expr::zero();
+    for (align, t) in aligns.iter().zip(terms.iter()) {
+        let d_masked = t.nz.clone() * (stage.e_max - t.e.clone());
+        let aligned = eval_align(builder, align, d_masked, &t.shifted, is_real);
+        sum = sum + (AB::Expr::one() - t.neg.clone().double()) * aligned;
+    }
+
+    // The signed sum matches the witnessed sign/magnitude decomposition.
+    // `|sum| < 9 * 2^26 < 2^30` and `m_abs < 2^30`, both well below the field
+    // half-size, so the field equality is an integer equality.
+    builder.assert_bool(stage.sign);
+    builder.assert_bool(stage.out_zero);
+    for bit in stage.m_bits {
+        builder.assert_bool(bit);
+    }
+    let m_abs = stage
+        .m_bits
+        .iter()
+        .enumerate()
+        .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << j))
+        .sum::<AB::Expr>();
+    builder.assert_eq(sum, (AB::Expr::one() - stage.sign.into().double()) * m_abs.clone());
+    builder.assert_zero(stage.out_zero * m_abs);
+    builder.assert_zero(stage.out_zero * stage.sign);
+
+    // Bit-length selection: exactly one `len_sel[L-1]` fires on real rows
+    // with a nonzero sum, the selected top bit is set, and every bit above
+    // it is zero. This pins `L = bitlen(|sum|)` uniquely.
+    for sel in stage.len_sel {
+        builder.assert_bool(sel);
+    }
+    let len_sum = stage.len_sel.iter().map(|s| (*s).into()).sum::<AB::Expr>();
+    let nz_out = is_real - stage.out_zero;
+    builder.assert_eq(len_sum, nz_out.clone());
+    let top_bit = stage
+        .len_sel
+        .iter()
+        .enumerate()
+        .map(|(l, s)| (*s).into() * stage.m_bits[l])
+        .sum::<AB::Expr>();
+    builder.assert_eq(top_bit, nz_out.clone());
+    let above = stage
+        .len_sel
+        .iter()
+        .enumerate()
+        .map(|(l, s)| {
+            // Bits at positions >= L = l + 1 must be zero.
+            (*s).into()
+                * stage.m_bits[l + 1..].iter().map(|b| (*b).into()).sum::<AB::Expr>()
+        })
+        .sum::<AB::Expr>();
+    builder.assert_zero(above);
+
+    // Truncating normalization to WIDTH bits: `mag25 = |sum| >> (L - 25)` for
+    // L > 25 (dropping the low bits) or `|sum| << (25 - L)` for L <= 25.
+    let mag25 = stage
+        .len_sel
+        .iter()
+        .enumerate()
+        .map(|(l, s)| {
+            let len = l + 1;
+            let norm = if len <= WIDTH as usize {
+                // Left shift by 25 - len: bit j -> position j + 25 - len.
+                (0..len)
+                    .map(|j| {
+                        stage.m_bits[j].into()
+                            * AB::Expr::from_canonical_u32(1 << (j + WIDTH as usize - len))
+                    })
+                    .sum::<AB::Expr>()
+            } else {
+                // Right shift by len - 25: bit j -> position j - (len - 25).
+                (len - WIDTH as usize..len)
+                    .map(|j| {
+                        stage.m_bits[j].into()
+                            * AB::Expr::from_canonical_u32(1 << (j - (len - WIDTH as usize)))
+                    })
+                    .sum::<AB::Expr>()
+            };
+            (*s).into() * norm
+        })
+        .sum::<AB::Expr>();
+
+    // The dropped extra internal bit (bit 0 of mag25) when L >= 25.
+    let bit0 = stage
+        .len_sel
+        .iter()
+        .enumerate()
+        .filter(|(l, _)| l + 1 >= WIDTH as usize)
+        .map(|(l, s)| (*s).into() * stage.m_bits[l + 1 - WIDTH as usize])
+        .sum::<AB::Expr>();
+
+    // 24-bit output significand: `2 * out + bit0 = mag25`, top bit set on
+    // real nonzero rows. Both sides are < 2^25, so this is exact.
+    for bit in stage.out_bits {
+        builder.assert_bool(bit);
+    }
+    let out = stage
+        .out_bits
+        .iter()
+        .enumerate()
+        .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << j))
+        .sum::<AB::Expr>();
+    builder.assert_eq(out.double() + bit0, mag25);
+    builder.assert_eq(stage.out_bits[OUT_BITS - 1], nz_out);
+
+    // e_out = e_max + L - 25.
+    stage.e_max
+        + stage
+            .len_sel
+            .iter()
+            .enumerate()
+            .map(|(l, s)| (*s).into() * AB::Expr::from_canonical_usize(l + 1))
+            .sum::<AB::Expr>()
+        - AB::Expr::from_canonical_u32(WIDTH)
+}
+
+impl<AB, M: TrustMode> Air<AB> for TcDotChip<M>
+where
+    AB: SP1CoreAirBuilder,
+{
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let local = main.row_slice(0);
+        let local: &TcDotCols<AB::Var, M> = (*local).borrow();
+
+        builder.assert_bool(local.is_real);
+
+        // Pointers and word addresses.
+        let ab_ptr =
+            SyscallAddrOperation::<AB::F>::eval(builder, 32, local.ab_ptr, local.is_real.into());
+        let c_ptr =
+            SyscallAddrOperation::<AB::F>::eval(builder, 8, local.c_ptr, local.is_real.into());
+        for i in 0..4 {
+            AddrAddOperation::<AB::F>::eval(
+                builder,
+                Word([ab_ptr[0].into(), ab_ptr[1].into(), ab_ptr[2].into(), AB::Expr::zero()]),
+                Word::from(8 * i as u64),
+                local.ab_addrs[i],
+                local.is_real.into(),
+            );
+        }
+
+        // Page protection (user mode only): operand reads at clk, then the
+        // accumulator read/write at clk + 1, mirroring the executor.
+        let mut is_not_trap = local.is_real.into();
+        let mut trap_code = AB::Expr::zero();
+        if !M::IS_TRUSTED {
+            let local = main.row_slice(0);
+            let local: &TcDotCols<AB::Var, UserMode> = (*local).borrow();
+
+            #[cfg(not(feature = "mprotect"))]
+            builder.assert_zero(local.is_real);
+
+            AddressSlicePageProtOperation::<AB::F>::eval(
+                builder,
+                local.clk_high.into(),
+                local.clk_low.into(),
+                &local.ab_ptr.addr.map(Into::into),
+                &local.ab_addrs[3].value.map(Into::into),
+                PROT_READ,
+                &local.ab_page_prot_access,
+                &mut is_not_trap,
+                &mut trap_code,
+            );
+            AddressSlicePageProtOperation::<AB::F>::eval(
+                builder,
+                local.clk_high.into(),
+                local.clk_low.into() + AB::Expr::one(),
+                &local.c_ptr.addr.map(Into::into),
+                &local.c_ptr.addr.map(Into::into),
+                PROT_READ | PROT_WRITE,
+                &local.c_page_prot_access,
+                &mut is_not_trap,
+                &mut trap_code,
+            );
+        }
+
+        // Memory: read the 4 operand words at clk, write the accumulator word
+        // at clk + 1.
+        builder.eval_memory_access_slice_read(
+            local.clk_high,
+            local.clk_low.into(),
+            &local.ab_addrs.map(|addr| addr.value.map(Into::into)),
+            &local.ab_memory,
+            is_not_trap.clone(),
+        );
+
+        // fp8 decode of the 32 operand bytes, linked to the read words.
+        for k in 0..32 {
+            let d = &local.decode[k];
+            builder.assert_bool(d.s);
+            builder.assert_bool(d.is_sub);
+            send_range(builder, d.ef.into(), 4, local.is_real.into());
+            send_range(builder, d.m.into(), 3, local.is_real.into());
+            // is_sub == (ef == 0): `ef - 1 + 16 * is_sub` fits 4 bits iff
+            // (is_sub = 0 and ef >= 1) or (is_sub = 1 and ef = 0).
+            send_range(
+                builder,
+                d.ef - AB::Expr::one() + d.is_sub * AB::Expr::from_canonical_u32(16),
+                4,
+                local.is_real.into(),
+            );
+        }
+        for w in 0..4 {
+            for l in 0..4 {
+                let b0 = &local.decode[8 * w + 2 * l];
+                let b1 = &local.decode[8 * w + 2 * l + 1];
+                let enc0 = b0.s * AB::Expr::from_canonical_u32(128)
+                    + b0.ef * AB::Expr::from_canonical_u32(8)
+                    + b0.m;
+                let enc1 = b1.s * AB::Expr::from_canonical_u32(128)
+                    + b1.ef * AB::Expr::from_canonical_u32(8)
+                    + b1.m;
+                builder.assert_eq(
+                    local.ab_memory[w].prev_value[l],
+                    enc0 + enc1 * AB::Expr::from_canonical_u32(256),
+                );
+            }
+        }
+
+        // Product terms: exact significand products, expanded by 2^17 to 23
+        // fraction bits; the doubled magnitude is `sigp * 2^18 < 2^26`.
+        let mut prod_terms: Vec<TcTermInput<AB>> = Vec::with_capacity(TILE);
+        for i in 0..TILE {
+            let p = &local.prods[i];
+            let da = &local.decode[i];
+            let db = &local.decode[16 + i];
+
+            builder.assert_bool(p.neg);
+            builder.assert_bool(p.nz);
+            builder.assert_eq(p.neg, da.s + db.s - da.s * db.s * AB::Expr::two());
+
+            for bit in p.bits {
+                builder.assert_bool(bit);
+            }
+            // sig = m + 8 * implicit, with the implicit bit present only for
+            // normals (and vanishing on padding rows via is_real).
+            let sig_a =
+                da.m + (local.is_real - da.is_sub) * AB::Expr::from_canonical_u32(8);
+            let sig_b =
+                db.m + (local.is_real - db.is_sub) * AB::Expr::from_canonical_u32(8);
+            let sigp = p
+                .bits
+                .iter()
+                .enumerate()
+                .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << j))
+                .sum::<AB::Expr>();
+            builder.assert_eq(sigp, sig_a * sig_b);
+
+            // nz == (sigp != 0), via the bit-count: `cnt - 1 + 16 * (1 - nz)`
+            // fits 4 bits iff (nz = 1 and cnt >= 1) or (nz = 0 and cnt = 0).
+            let cnt = p.bits.iter().map(|b| (*b).into()).sum::<AB::Expr>();
+            send_range(
+                builder,
+                cnt - AB::Expr::one()
+                    + (local.is_real - p.nz) * AB::Expr::from_canonical_u32(16),
+                4,
+                local.is_real.into(),
+            );
+
+            // Nominal exponent: e_a + e_b with e = ef - 7 + is_sub.
+            let e = da.ef + db.ef - AB::Expr::from_canonical_u32(14) + da.is_sub + db.is_sub;
+
+            // shifted[d] = (sigp << 18) >> d.
+            let shifted = (0..SHIFT_SEL)
+                .map(|d| {
+                    p.bits
+                        .iter()
+                        .enumerate()
+                        .filter(|(j, _)| j + 18 >= d)
+                        .map(|(j, b)| {
+                            (*b).into() * AB::Expr::from_canonical_u32(1 << (j + 18 - d))
+                        })
+                        .sum::<AB::Expr>()
+                })
+                .collect_vec();
+
+            prod_terms.push(TcTermInput {
+                neg: p.neg.into(),
+                nz: p.nz.into(),
+                e,
+                shifted,
+            });
+        }
+
+        // The C accumulator term (fp32 decode, linked to the write's
+        // prev_value). The high half of the u64 word is ignored.
+        let c = &local.c_term;
+        builder.assert_bool(c.s);
+        builder.assert_bool(c.is_sub);
+        builder.assert_bool(c.nz);
+        for bit in c.man_bits {
+            builder.assert_bool(bit);
+        }
+        send_range(builder, c.ef.into(), 8, local.is_real.into());
+        send_range(
+            builder,
+            c.ef - AB::Expr::one() + c.is_sub * AB::Expr::from_canonical_u32(256),
+            8,
+            local.is_real.into(),
+        );
+        // Operand contract: C is finite (ef != 255).
+        send_range(
+            builder,
+            AB::Expr::from_canonical_u32(254) - c.ef,
+            8,
+            local.is_real.into(),
+        );
+        let man_lo = c
+            .man_bits
+            .iter()
+            .take(16)
+            .enumerate()
+            .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << j))
+            .sum::<AB::Expr>();
+        let man_hi = c
+            .man_bits
+            .iter()
+            .enumerate()
+            .skip(16)
+            .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << (j - 16)))
+            .sum::<AB::Expr>();
+        builder.assert_eq(local.c_memory.prev_value[0], man_lo);
+        builder.assert_eq(
+            local.c_memory.prev_value[1],
+            c.s * AB::Expr::from_canonical_u32(1 << 15)
+                + c.ef * AB::Expr::from_canonical_u32(1 << 7)
+                + man_hi,
+        );
+
+        // nz == (magnitude != 0), via the bit-count of implicit + mantissa
+        // bits: `cnt - 1 + 32 * (1 - nz)` fits 5 bits iff consistent.
+        let c_implicit = local.is_real - c.is_sub;
+        let c_cnt =
+            c_implicit.clone() + c.man_bits.iter().map(|b| (*b).into()).sum::<AB::Expr>();
+        send_range(
+            builder,
+            c_cnt - AB::Expr::one()
+                + (local.is_real - c.nz) * AB::Expr::from_canonical_u32(32),
+            5,
+            local.is_real.into(),
+        );
+
+        // shifted[d] = (mag_c << 1) >> d, mag_c = implicit * 2^23 + mantissa.
+        let c_shifted = (0..SHIFT_SEL)
+            .map(|d| {
+                let mut acc = AB::Expr::zero();
+                if 24 >= d {
+                    acc = acc + c_implicit.clone() * AB::Expr::from_canonical_u32(1 << (24 - d));
+                }
+                for (j, b) in c.man_bits.iter().enumerate() {
+                    if j + 1 >= d {
+                        acc = acc + (*b).into() * AB::Expr::from_canonical_u32(1 << (j + 1 - d));
+                    }
+                }
+                acc
+            })
+            .collect_vec();
+        let c_term_input = TcTermInput::<AB> {
+            neg: c.s.into(),
+            nz: c.nz.into(),
+            e: c.ef - AB::Expr::from_canonical_u32(127) + c.is_sub,
+            shifted: c_shifted,
+        };
+
+        // Stage 1: G1 = GroupSum({C, P1..P8}).
+        let mut prod_iter = prod_terms.into_iter();
+        let stage1_terms: Vec<TcTermInput<AB>> =
+            std::iter::once(c_term_input).chain(prod_iter.by_ref().take(8)).collect_vec();
+        let stage1_aligns: Vec<&TcAlignCols<AB::Var>> = std::iter::once(&c.align)
+            .chain(local.prods[..8].iter().map(|p| &p.align))
+            .collect_vec();
+        let stage1_ismaxs: Vec<AB::Var> = std::iter::once(c.ismax)
+            .chain(local.prods[..8].iter().map(|p| p.ismax))
+            .collect_vec();
+        let e_out1 = eval_stage(
+            builder,
+            &local.stage[0],
+            &stage1_aligns,
+            &stage1_ismaxs,
+            &stage1_terms,
+            local.is_real,
+        );
+        let g1_nz = local.is_real - local.stage[0].out_zero;
+
+        // Operand contract: a nonzero G1 is not subnormal (e_out1 >= -126);
+        // e_out1 <= 132 structurally, so 9 bits suffice.
+        send_range(
+            builder,
+            e_out1.clone() + AB::Expr::from_canonical_u32(126),
+            9,
+            g1_nz.clone(),
+        );
+
+        // Stage 2: D = GroupSum({G1, P9..P16}). G1's doubled magnitude is
+        // `2 * out1 < 2^25`.
+        let g1_shifted = (0..SHIFT_SEL)
+            .map(|d| {
+                local.stage[0]
+                    .out_bits
+                    .iter()
+                    .enumerate()
+                    .filter(|(j, _)| j + 1 >= d)
+                    .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << (j + 1 - d)))
+                    .sum::<AB::Expr>()
+            })
+            .collect_vec();
+        let g1_term = TcTermInput::<AB> {
+            neg: local.stage[0].sign.into(),
+            nz: g1_nz,
+            e: e_out1,
+            shifted: g1_shifted,
+        };
+        let stage2_terms: Vec<TcTermInput<AB>> =
+            std::iter::once(g1_term).chain(prod_iter).collect_vec();
+        let stage2_aligns: Vec<&TcAlignCols<AB::Var>> = std::iter::once(&local.g1_align)
+            .chain(local.prods[8..].iter().map(|p| &p.align))
+            .collect_vec();
+        let stage2_ismaxs: Vec<AB::Var> = std::iter::once(local.g1_ismax)
+            .chain(local.prods[8..].iter().map(|p| p.ismax))
+            .collect_vec();
+        let e_out2 = eval_stage(
+            builder,
+            &local.stage[1],
+            &stage2_aligns,
+            &stage2_ismaxs,
+            &stage2_terms,
+            local.is_real,
+        );
+        let d_nz = local.is_real - local.stage[1].out_zero;
+
+        // fp32 pack: biased exponent (0 for a zero result), with the operand
+        // contract `1 <= ef_d <= 254` (no subnormal, no overflow) enforced by
+        // range checks on nonzero results.
+        builder.assert_eq(
+            local.ef_d,
+            (e_out2 + AB::Expr::from_canonical_u32(127)) * d_nz.clone(),
+        );
+        send_range(builder, local.ef_d - AB::Expr::one(), 8, d_nz.clone());
+        send_range(
+            builder,
+            AB::Expr::from_canonical_u32(254) - local.ef_d,
+            8,
+            d_nz,
+        );
+
+        // Result word: fp32 bits in the low half, zero high half. A zero
+        // result packs to +0.0 (sign is constrained to 0 when out_zero).
+        let d_man_lo = local.stage[1]
+            .out_bits
+            .iter()
+            .take(16)
+            .enumerate()
+            .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << j))
+            .sum::<AB::Expr>();
+        let d_man_hi = local.stage[1]
+            .out_bits
+            .iter()
+            .enumerate()
+            .skip(16)
+            .take(7)
+            .map(|(j, b)| (*b).into() * AB::Expr::from_canonical_u32(1 << (j - 16)))
+            .sum::<AB::Expr>();
+        let d_word = Word([
+            d_man_lo,
+            local.stage[1].sign * AB::Expr::from_canonical_u32(1 << 15)
+                + local.ef_d * AB::Expr::from_canonical_u32(1 << 7)
+                + d_man_hi,
+            AB::Expr::zero(),
+            AB::Expr::zero(),
+        ]);
+        builder.eval_memory_access_write(
+            local.clk_high,
+            local.clk_low + AB::Expr::one(),
+            &c_ptr.map(Into::into),
+            local.c_memory,
+            d_word,
+            is_not_trap,
+        );
+
+        #[cfg(feature = "mprotect")]
+        builder.assert_eq(
+            builder.extract_public_values().is_untrusted_programs_enabled,
+            AB::Expr::from_bool(!M::IS_TRUSTED),
+        );
+
+        // Receive the syscall.
+        builder.receive_syscall(
+            local.clk_high,
+            local.clk_low.into(),
+            AB::F::from_canonical_u32(SyscallCode::TC_DOT.syscall_id()),
+            trap_code,
+            ab_ptr.map(Into::into),
+            c_ptr.map(Into::into),
+            local.is_real,
+            InteractionScope::Local,
+        );
+    }
+}
diff --git a/crates/core/machine/src/syscall/precompiles/tc_dot/columns.rs b/crates/core/machine/src/syscall/precompiles/tc_dot/columns.rs
new file mode 100644
index 000000000..3abd56d3d
--- /dev/null
+++ b/crates/core/machine/src/syscall/precompiles/tc_dot/columns.rs
@@ -0,0 +1,156 @@
+use sp1_derive::AlignedBorrow;
+
+use crate::{
+    memory::MemoryAccessCols,
+    operations::{AddrAddOperation, SyscallAddrOperation},
+    SupervisorMode, TrustMode, UserMode,
+};
+
+/// Number of fp8 elements in a tile.
+pub const TILE: usize = 16;
+/// Number of terms per GroupSum stage (C/G1 plus 8 products).
+pub const STAGE_TERMS: usize = 9;
+/// One-hot alignment shift range: shifts `0..=25`; larger shifts truncate the
+/// term to zero (every doubled magnitude is `< 2^26`) and use the `sel_big`
+/// bucket.
+pub const SHIFT_SEL: usize = 26;
+/// Bits in a signed GroupSum (25-bit adder word, up to 9 terms: `|sum| < 2^29`).
+pub const SUM_BITS: usize = 30;
+/// Bits in a stage-output significand (fp32 precision).
+pub const OUT_BITS: usize = 24;
+
+pub const fn num_tc_dot_cols_supervisor() -> usize {
+    std::mem::size_of::<TcDotCols<u8, SupervisorMode>>()
+}
+
+pub const fn num_tc_dot_cols_user() -> usize {
+    std::mem::size_of::<TcDotCols<u8, UserMode>>()
+}
+
+/// Decode of one fp8 E4M3 byte: `byte = 128*s + 8*ef + m`.
+#[derive(AlignedBorrow, Default, Debug, Clone, Copy)]
+#[repr(C)]
+pub struct TcFp8DecodeCols<T> {
+    /// Sign bit.
+    pub s: T,
+    /// Exponent field, in `[0, 16)`.
+    pub ef: T,
+    /// Mantissa field, in `[0, 8)`.
+    pub m: T,
+    /// Whether the exponent field is zero (subnormal), via the range trick
+    /// `ef - 1 + 16*is_sub in [0, 16)`.
+    pub is_sub: T,
+}
+
+/// One-hot truncating alignment shift of a doubled term magnitude `x < 2^26`
+/// by `d = e_max - e` positions.
+#[derive(AlignedBorrow, Default, Debug, Clone, Copy)]
+#[repr(C)]
+pub struct TcAlignCols<T> {
+    /// One-hot selectors for `d in [0, 25]`.
+    pub sel: [T; SHIFT_SEL],
+    /// Selector for `d >= 26` (the term truncates to zero).
+    pub sel_big: T,
+    /// Excess `d - 26` when `sel_big` is set (range-checked to 9 bits), else 0.
+    pub d_ex: T,
+}
+
+/// One fp8 product term inside a GroupSum stage.
+#[derive(AlignedBorrow, Default, Debug, Clone, Copy)]
+#[repr(C)]
+pub struct TcProdCols<T> {
+    /// Sign of the product (`s_a XOR s_b`).
+    pub neg: T,
+    /// Nonzero flag for the significand product, via the range trick on the
+    /// bit-count sum.
+    pub nz: T,
+    /// Bit decomposition of the significand product `sig_a * sig_b <= 225`.
+    pub bits: [T; 8],
+    /// Whether this term achieves the stage's `e_max`.
+    pub ismax: T,
+    /// Alignment shift columns.
+    pub align: TcAlignCols<T>,
+}
+
+/// The fp32 accumulator term C (stage-1 term 0).
+#[derive(AlignedBorrow, Default, Debug, Clone, Copy)]
+#[repr(C)]
+pub struct TcCTermCols<T> {
+    /// Sign bit of C.
+    pub s: T,
+    /// fp32 exponent field of C, in `[0, 256)`.
+    pub ef: T,
+    /// Whether the exponent field is zero (subnormal C).
+    pub is_sub: T,
+    /// Bit decomposition of the 23-bit mantissa field.
+    pub man_bits: [T; 23],
+    /// Nonzero flag for the full magnitude (incl. implicit bit), via the range
+    /// trick on the bit-count sum.
+    pub nz: T,
+    /// Whether C achieves stage 1's `e_max`.
+    pub ismax: T,
+    /// Alignment shift columns.
+    pub align: TcAlignCols<T>,
+}
+
+/// Shared per-stage GroupSum columns.
+#[derive(AlignedBorrow, Default, Debug, Clone, Copy)]
+#[repr(C)]
+pub struct TcStageCols<T> {
+    /// Max nominal exponent over nonzero terms (clamped below at -132).
+    /// Stored as a (possibly negative) field element.
+    pub e_max: T,
+    /// Whether the clamp fired (all terms zero).
+    pub is_clamped: T,
+    /// Sign of the aligned signed sum (0 when the sum is zero).
+    pub sign: T,
+    /// Whether the aligned signed sum is exactly zero.
+    pub out_zero: T,
+    /// Bit decomposition of `|sum|`.
+    pub m_bits: [T; SUM_BITS],
+    /// One-hot selector of `bitlen(|sum|) in [1, 30]` (all zero when
+    /// `out_zero`).
+    pub len_sel: [T; SUM_BITS],
+    /// Bit decomposition of the stage-output 24-bit significand.
+    pub out_bits: [T; OUT_BITS],
+}
+
+/// Columns for the `TC_DOT` chip (one row per tile syscall).
+#[derive(AlignedBorrow)]
+#[repr(C)]
+pub struct TcDotCols<T, M: TrustMode> {
+    /// High bits of the syscall clk.
+    pub clk_high: T,
+    /// Low 24 bits of the syscall clk.
+    pub clk_low: T,
+    /// Pointer to the 32-byte operand buffer.
+    pub ab_ptr: SyscallAddrOperation<T>,
+    /// Pointer to the accumulator word.
+    pub c_ptr: SyscallAddrOperation<T>,
+    /// Addresses of the 4 operand words.
+    pub ab_addrs: [AddrAddOperation<T>; 4],
+    /// Memory read columns for the 4 operand words.
+    pub ab_memory: [MemoryAccessCols<T>; 4],
+    /// Memory write columns for the accumulator word.
+    pub c_memory: MemoryAccessCols<T>,
+    /// Decodes of the 32 operand bytes (A elements 0..16, then B).
+    pub decode: [TcFp8DecodeCols<T>; 32],
+    /// Product terms (0..8 belong to stage 1, 8..16 to stage 2).
+    pub prods: [TcProdCols<T>; TILE],
+    /// The C accumulator term (stage-1 term 0).
+    pub c_term: TcCTermCols<T>,
+    /// Whether G1 achieves stage 2's `e_max`.
+    pub g1_ismax: T,
+    /// Alignment shift columns for G1 (stage-2 term 0).
+    pub g1_align: TcAlignCols<T>,
+    /// Per-stage GroupSum columns.
+    pub stage: [TcStageCols<T>; 2],
+    /// fp32 exponent field of the result (0 when the result is zero).
+    pub ef_d: T,
+    /// Page prot access for the operand buffer (user mode only).
+    pub ab_page_prot_access: M::SliceProtCols<T>,
+    /// Page prot access for the accumulator word (user mode only).
+    pub c_page_prot_access: M::SliceProtCols<T>,
+    /// Whether this row is real.
+    pub is_real: T,
+}
diff --git a/crates/core/machine/src/syscall/precompiles/tc_dot/mod.rs b/crates/core/machine/src/syscall/precompiles/tc_dot/mod.rs
