/-
PROTOCOL.md §16.10: the `sha512x3` and `hm96` slot circuits, generated by the verifier. The circuit file comes from the
prover, so the verifier builds both nets itself, as `verity_flock.sha512_circuit` builds them and `ir_lower.layout` lays them
out, and refuses a file whose sections differ (`check`).

A circuit is built over GF(2) linear forms of committed bits (`forms.py`): XOR and NOT are free, and every AND of two forms
that are neither constant nor of one support commits a new bit, the row `z_out = (A·z)(B·z)`. Words are 64 bits, least
significant first.
-/
import Flock.Circuit
import Flock.Hm96

namespace Flock
namespace HmNets

/-- A linear form (`forms.L`): the XOR of the committed bits `s` (ascending, distinct) and the constant `c`. -/
structure Lin where
  s : List Nat
  c : Bool
  deriving Inhabited, BEq, DecidableEq, Repr

/-- The symmetric difference of two ascending lists, ascending: the support of a sum of two forms. -/
def symm : List Nat → List Nat → List Nat
  | [], ys => ys
  | x :: xs, [] => x :: xs
  | x :: xs, y :: ys =>
    if x < y then x :: symm xs (y :: ys)
    else if y < x then y :: symm (x :: xs) ys
    else symm xs ys

def Lin.xor (a b : Lin) : Lin := ⟨symm a.s b.s, a.c ^^ b.c⟩

instance : XorOp Lin := ⟨Lin.xor⟩

def zero : Lin := ⟨[], false⟩
def one : Lin := ⟨[], true⟩
def var (i : Nat) : Lin := ⟨[i], false⟩
def Lin.isConst (a : Lin) : Bool := a.s.isEmpty

/-- Committed bit `out`'s row: `z_out = (a·z)(b·z)`. -/
structure Row where
  out : Nat
  a : Lin
  b : Lin
  deriving Inhabited

/-- The circuit so far: the next committed bit, and every AND's row in creation order. -/
structure St where
  next : Nat := 0
  rows : Array Row := #[]
  deriving Inhabited

abbrev M := StateM St

/-- A new committed bit with its row. -/
def fresh (a b : Lin) : M Lin :=
  modifyGet fun s => (var s.next, { next := s.next + 1, rows := s.rows.push ⟨s.next, a, b⟩ })

/-- `n` input bits (committed, no row). -/
def input (n : Nat) : M (List Lin) :=
  modifyGet fun s => ((List.range n).map (var <| s.next + ·), { s with next := s.next + n })

/-- `forms.Circuit.AND` without common-subexpression reuse: a constant or a form of the other's support costs no row. -/
def and (a b : Lin) : M Lin :=
  if a.isConst then pure (if a.c then b else zero)
  else if b.isConst then pure (if b.c then a else zero)
  else if a.s == b.s then pure (if a.c == b.c then a else zero)
  else fresh a b

private def bitOf (w : Lin) : Nat := if w.c then 1 else 0

/-- `forms.maj`: majority with one AND, `z + (x + z)(y + z)`; two or more constants simplify. -/
def maj (x y z : Lin) : M Lin :=
  let ws := [x, y, z]
  let consts := ws.filter (·.isConst)
  if consts.length ≥ 2 then
    let s := (consts.map bitOf).foldl (· + ·) 0
    if s == 0 then pure zero
    else if s == 2 then pure one
    else match ws.filter (!·.isConst) with
      | v :: _ => pure v
      | [] => pure (if (ws.map bitOf).foldl (· + ·) 0 ≥ 2 then one else zero)
  else do
    let t ← and (x ^^^ z) (y ^^^ z)
    pure (z ^^^ t)

/-- `sha512_circuit.commit` of one bit: a committed bit or a constant stays, any other form gets the row `form · 1`. -/
def commitBit (w : Lin) : M Lin :=
  if (w.s.length == 1 && !w.c) || w.isConst then pure w else fresh w one

def commitW (w : List Lin) : M (List Lin) := w.mapM commitBit

/-- `sha512_circuit.CARRY_EVERY`: the ripple carry is committed after every fifth bit. -/
def CARRY_EVERY : Nat := 5

/-- Bits `i, i + 1, …` of a 64-bit sum with carry `c` in (`_add2`'s loop). -/
def add2Go : Nat → List Lin → List Lin → Lin → M (List Lin)
  | i, a :: as, b :: bs, c => do
    let o := a ^^^ b ^^^ c
    if i < 63 then
      let c ← maj a b c
      let c ← if i % CARRY_EVERY == CARRY_EVERY - 1 then commitBit c else pure c
      return o :: (← add2Go (i + 1) as bs c)
    else return o :: (← add2Go (i + 1) as bs c)
  | _, _, _, _ => pure []

/-- `_add2`: `a + b mod 2^64`, ripple carry. -/
def add2 (a b : List Lin) : M (List Lin) := add2Go 0 a b zero

/-- `_add`: the words summed left to right. -/
def addN : List (List Lin) → M (List Lin)
  | [] => pure []
  | x :: xs => xs.foldlM add2 x

def rot (x : List Lin) (n : Nat) : List Lin := x.drop n ++ x.take n
def shr (x : List Lin) (n : Nat) : List Lin := x.drop n ++ List.replicate n zero
def xor3 (a b c : List Lin) : List Lin := List.zipWith (· ^^^ ·) (List.zipWith (· ^^^ ·) a b) c
def constW (v : UInt64) : List Lin := (List.range 64).map fun i => if (v >>> i.toUInt64) &&& 1 == 1 then one else zero

/-- `Ch(e, f, g) = g + e(f + g)`, bit by bit. -/
def chW (e f g : List Lin) : M (List Lin) :=
  (List.zip e (List.zip f g)).mapM fun (ee, ff, gg) => do pure (gg ^^^ (← and ee (ff ^^^ gg)))

def majW (a b c : List Lin) : M (List Lin) :=
  (List.zip a (List.zip b c)).mapM fun (x, y, z) => maj x y z

/-- The message schedule's next `n` words, each committed. -/
def schedule : Nat → Array (List Lin) → M (Array (List Lin))
  | 0, w => pure w
  | n + 1, w => do
    let t := w.size
    let x := w[t - 15]!
    let y := w[t - 2]!
    let s0 := xor3 (rot x 1) (rot x 8) (shr x 7)
    let s1 := xor3 (rot y 19) (rot y 61) (shr y 6)
    let nw ← commitW (← addN [w[t - 16]!, s0, w[t - 7]!, s1])
    schedule n (w.push nw)

/-- The working variables `a, …, h`. -/
abbrev Regs := List Lin × List Lin × List Lin × List Lin × List Lin × List Lin × List Lin × List Lin

/-- One round with schedule word `w` and constant `k`: the new `e` and `a` are committed, `e` first. -/
def round (w : List Lin) (k : UInt64) (r : Regs) : M Regs := do
  let (a, b, c, d, e, f, g, h) := r
  let s1 := xor3 (rot e 14) (rot e 18) (rot e 41)
  let ch ← chW e f g
  let t1 ← addN [h, s1, ch, constW k, w]
  let s0 := xor3 (rot a 28) (rot a 34) (rot a 39)
  let mj ← majW a b c
  let t2 ← addN [s0, mj]
  let e' ← commitW (← add2 d t1)
  let a' ← commitW (← add2 t1 t2)
  pure (a', a, b, c, e', e, f, g)

/-- `compress_gadget`: one SHA-512 compression with the feed-forward, over words of forms. -/
def compress (cv msg : List (List Lin)) : M (List (List Lin)) := do
  let w ← schedule 64 msg.toArray
  let r0 : Regs := (cv[0]!, cv[1]!, cv[2]!, cv[3]!, cv[4]!, cv[5]!, cv[6]!, cv[7]!)
  let (a, b, c, d, e, f, g, h) ← (List.range 80).foldlM (fun r t => round w[t]! Sha512.k[t]! r) r0
  (List.zip cv [a, b, c, d, e, f, g, h]).mapM fun (x, y) => add2 x y

/-- `_words`: `n` words of 64 bits. -/
def words (bits : List Lin) (n : Nat) : List (List Lin) := (List.range n).map fun i => (bits.drop (64 * i)).take 64

/-- `compression(3)`: inputs `cv0, msg0, cv1, msg1, cv2, msg2`, outputs `out0 ‖ out1 ‖ out2`. -/
def compression3 : M (List Lin) := do
  let ins ← (List.range 3).mapM fun _ => do
    let cv ← input 512
    let msg ← input 1024
    pure (cv, msg)
  let outs ← ins.mapM fun (cv, msg) => do pure (← compress (words cv 8) (words msg 16)).flatten
  pure outs.flatten

/-- `word_bit`: the word-order position of byte-string bit `t` (bit `t % 8` of byte `t / 8`; words big-endian). -/
def wordBit (t : Nat) : Nat := 64 * (t / 8 / 8) + 56 - 8 * (t / 8 % 8) + t % 8

/-- Adjacent forms summed: half as many. -/
def pairs : List Lin → List Lin
  | a :: b :: rest => (a ^^^ b) :: pairs rest
  | rest => rest

theorem pairs_length_le : ∀ l : List Lin, (pairs l).length ≤ l.length
  | a :: b :: rest => by simp only [pairs, List.length_cons]; have := pairs_length_le rest; omega
  | [] | [_] => by simp [pairs]

/-- A sum of forms, pairwise (`n log n` where a left fold is quadratic). -/
def xorAll (ls : List Lin) : Lin :=
  match ls with
  | [] => zero
  | [a] => a
  | a :: b :: rest => xorAll (pairs (a :: b :: rest))
termination_by ls.length
decreasing_by simp only [pairs, List.length_cons]; have := pairs_length_le rest; omega

/-- SHA-512 padding after `total` bytes: `0x80`, zeros, the 128-bit bit length (`pad_tail`). -/
def padTail (total : Nat) : ByteArray := Id.run do
  let z := (128 - (total + 17) % 128) % 128
  let mut b := (ByteArray.mk #[0x80]) ++ ByteArray.mk (Array.replicate z 0)
  for i in [0:16] do b := b.push (((8 * total) >>> (8 * (15 - i))) % 256).toUInt8
  return b

def wordsBE (b : ByteArray) : List UInt64 :=
  (List.range (b.size / 8)).map fun i => (List.range 8).foldl (fun x j => (x <<< 8) ||| (b.get! (8 * i + j)).toUInt64) 0

/-- `hm96_row`: inputs `cv` (the chaining value after the row's last block), `pad` (the padding block) and `y` (the salt,
1536 bits in byte-string order); output `bc = b ‖ c` in byte-string order: `x` the padding block's compression, `c` the
salt's digest (two compressions from the salt prefix's midstate), `b = x ⊕ M·y` with `M[i][j]` bit `i + j` of the default
key. -/
def hm96Row : M (List Lin) := do
  let cv ← input 512
  let pad ← input 1024
  let y := (← input 1536).toArray
  let x := (← compress (words cv 8) (words pad 16)).flatten.toArray
  let yw := (List.range 1536).foldl (fun (acc : Array Lin) t => acc.set! (wordBit t) y[t]!) (Array.replicate 1536 zero)
  let mid := (Sha512.compress Sha512.iv Hm96.Default512.saltPrefix 0).toList
  let st ← compress (mid.map constW) (words yw.toList 16)
  let tail := (wordsBE (ByteArray.mk (Array.replicate 64 0) ++ (padTail (128 + 192)).extract 0 64)).drop 8
  let st ← compress st (words (yw.toList.drop 1024) 8 ++ tail.map constW)
  let cbits := st.flatten.toArray
  let key := Hm96.Default512.key
  let b := (List.range 512).map fun i =>
    x[wordBit i]! ^^^ xorAll ((List.range 1536).filterMap fun j => if Hm96.bit key (i + j) then some y[j]! else none)
  pure (b ++ (List.range 512).map fun t => cbits[wordBit t]!)

/-! ## The layout (`ir_lower.layout`) -/

/-- A port group's words: `ceil_pow2(max(1, ⌈bits / 128⌉))`. -/
def groupWords (bits : Nat) : Nat := nextPow2 (max 1 ((bits + WORD - 1) / WORD))

/-- A built circuit laid out as one slot type: the input ports in one group from column 0 (their rows self rows, the
group's padding empty), then every AND's row in creation order, then the outputs in one group aligned to its words (each a
copy row `form · 1`), the constant last. A form's row is its bits' columns, ascending, and the constant's if its constant is
set. Every AND is live in both circuits here (each feeds an output), so none is dropped. -/
structure Laid where
  useful : Nat
  constPos : Nat
  inGroups : Array Group
  outGroups : Array Group
  ra : Array (Array Nat)
  rb : Array (Array Nat)
  deriving Inhabited

/-- Committed bit `i`'s column: an input bit (`i < nIn`) its own row, the AND committed `k`-th the `k`-th row after the
input group. -/
def col (nIn inRows i : Nat) : Nat := if i < nIn then i else inRows + (i - nIn)

/-- A form's row: its bits' columns, then the constant's when its constant is set. -/
def cols (nIn inRows constPos : Nat) (l : Lin) : Array Nat :=
  (l.s.map (col nIn inRows)).toArray ++ (if l.c then #[constPos] else #[])

def layout (st : St) (inBits outBits : Array Nat) (outs : Array Lin) : Laid :=
  let nIn := inBits.foldl (· + ·) 0
  let inW := groupWords nIn
  let inRows := inW * WORD
  let outW := groupWords (outBits.foldl (· + ·) 0)
  let span := outW * WORD
  let start := (inRows + st.rows.size + span - 1) / span * span
  let constPos := start + span
  let cs := cols nIn inRows constPos
  let empty := fun (n : Nat) => (Array.replicate n (#[] : Array Nat))
  let ins := (Array.range nIn).map fun i => #[i]
  let gap := empty (inRows - nIn)
  let gap2 := empty (start - inRows - st.rows.size)
  let gap3 := empty (span - outs.size)
  { useful := constPos + 1, constPos,
    inGroups := #[⟨0, inW, inBits⟩], outGroups := #[⟨start / WORD, outW, outBits⟩],
    ra := ins ++ gap ++ st.rows.map (cs ·.a) ++ gap2 ++ outs.map cs ++ gap3 ++ #[#[constPos]],
    rb := ins ++ gap ++ st.rows.map (cs ·.b) ++ gap2 ++ outs.map (fun _ => #[constPos]) ++ gap3 ++ #[#[constPos]] }

def SHA_IN : Array Nat := #[512, 1024, 512, 1024, 512, 1024]
def SHA_OUT : Array Nat := #[512, 512, 512]
def HM_IN : Array Nat := #[512, 1024, 1536]
def HM_OUT : Array Nat := #[1024]

/- The two layouts are functions of `Unit`, built when a statement needs them: a closed term would be evaluated at every
start of the program. -/
set_option compiler.extract_closed false in
def shaLaid (_ : Unit) : Laid := let (outs, st) := compression3.run {}; layout st SHA_IN SHA_OUT outs.toArray
set_option compiler.extract_closed false in
def hmLaid (_ : Unit) : Laid := let (outs, st) := hm96Row.run {}; layout st HM_IN HM_OUT outs.toArray

def netOf (name : String) (l : Laid) : V Net := Net.ofRows name l.useful l.constPos l.inGroups l.outGroups l.ra l.rb

deriving instance DecidableEq for Group
deriving instance DecidableEq for Sparse
deriving instance DecidableEq for LookupTable
deriving instance DecidableEq for Net

/-- Where a file's net first differs from the generated one, for the refusal. -/
def firstDiff (p g : Net) : String :=
  if p.name != g.name then s!"its name is {p.name}"
  else if p.useful != g.useful || p.constPos != g.constPos then
    s!"it has {p.useful} rows and the constant at {p.constPos}, not {g.useful} and {g.constPos}"
  else if !decide (p.inGroups = g.inGroups) || !decide (p.outGroups = g.outGroups) then "its port groups differ"
  else match (List.range g.useful).find? (fun i => p.a.row i != g.a.row i || p.b.row i != g.b.row i) with
    | some i => s!"row {i} differs"
    | none => "its matrices differ"

/-- One of the file's row nets is the verifier's: built here, equal in every field. -/
def checkNet (c : Circuit) (n : Nat) (name what : String) (l : Laid) : V Unit := do
  let g ← netOf name l
  let p := (c.nets.getD n default).2
  if !decide (p = g) then throw s!"circuit {name}: not the verifier's {what} ({firstDiff p g})"

set_option compiler.extract_closed false in
/-- The file's `sha512x3` and `hm96` nets are the verifier's. -/
def check (c : Circuit) : V Unit := do
  checkNet c c.shaNet "sha512x3" "three SHA-512 compressions" (shaLaid ())
  checkNet c c.hmNet "hm96" "hm96-sha512/row/v1 commit" (hmLaid ())

end HmNets
end Flock
