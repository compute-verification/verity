  "FlockLevel3.slot_factor": {
   "signature": [
    "FlockLevel3.slot_factor (lw rho : Array Flock.F128) (hlw : Eq lw.size 64) (sl : Nat) (hsl : instLENat.le 6 sl)",
    "  (hslr : instLENat.le (instHSub.hSub sl 6) rho.size) (q c : Nat)",
    "  (hq : instLTNat.lt q (instHPow.hPow 2 (instHSub.hSub rho.size (instHSub.hSub sl 6))))",
    "  (hc : instLTNat.lt c (instHPow.hPow 2 sl)) :",
    "  Eq",
    "    (FlockLevel3.GF128.of",
    "      (instHMul.hMul",
    "        (Array.instGetElem?NatLtSize.getElem! lw",
    "          (instHMod.hMod (instHAdd.hAdd (instHMul.hMul q (instHPow.hPow 2 sl)) c) 64))",
    "        (Array.instGetElem?NatLtSize.getElem! (Flock.eqTable rho)",
    "          (instHDiv.hDiv (instHAdd.hAdd (instHMul.hMul q (instHPow.hPow 2 sl)) c) 64))))",
    "    (instHMul.hMul",
    "      (FlockLevel3.GF128.of",
    "        (Array.instGetElem?NatLtSize.getElem! (Flock.Stmt.tensor lw (rho.extract 0 (instHSub.hSub sl 6))) c))",
    "      (FlockLevel3.GF128.of",
    "        (Array.instGetElem?NatLtSize.getElem! (Flock.eqTable (rho.extract (instHSub.hSub sl 6))) q)))"
   ],
   "assumptions": [],
   "type_hash": "54ec5c0d17f2c5daeb6e6a5619ad41e45fe6521eab3e2dc74c0ccfb996ba15a6"
  },
  "FlockLevel3.slot_term": {
   "signature": [
    "FlockLevel3.slot_term (st : Flock.Stmt) (alpha : Flock.F128) (lw rho : Array Flock.F128) (r : Flock.Range)",
    "  (a b : Flock.Sparse) (lk : Option Flock.LookupTable)",
    "  (hbase :",
    "    Eq (FlockLevel3.baseFor st alpha lw rho r)",
    "      (Flock.Stmt.baseOf alpha (Flock.Stmt.tensor lw (rho.extract 0 (instHSub.hSub r.slotLog 6))) a b lk r.slotLog))",
    "  (c : Nat)",
    "  (hc :",
    "    And (instLTNat.lt (instHMod.hMod c (instHPow.hPow 2 r.slotLog)) a.width)",
    "      (instLTNat.lt (instHMod.hMod c (instHPow.hPow 2 r.slotLog)) b.width)) :",
    "  Eq",
    "    (FlockLevel3.GF128.of",
    "      (instHMul.hMul",
    "        (Array.instGetElem?NatLtSize.getElem! (FlockLevel3.eHiFor rho r) (instHDiv.hDiv c (instHPow.hPow 2 r.slotLog)))",
    "        (Array.instGetElem?NatLtSize.getElem! (FlockLevel3.baseFor st alpha lw rho r)",
    "          (instHMod.hMod c (instHPow.hPow 2 r.slotLog)))))",
    "    (instHMul.hMul",
    "      (FlockLevel3.GF128.of",
    "        (Array.instGetElem?NatLtSize.getElem! (FlockLevel3.eHiFor rho r) (instHDiv.hDiv c (instHPow.hPow 2 r.slotLog))))",
    "      (instHAdd.hAdd",
    "        (instHAdd.hAdd",
    "          (instHMul.hMul (FlockLevel3.GF128.of alpha)",
    "            (FlockLevel3.sparseT a (Flock.Stmt.tensor lw (rho.extract 0 (instHSub.hSub r.slotLog 6)))",
    "              (instHMod.hMod c (instHPow.hPow 2 r.slotLog))))",
    "          (FlockLevel3.sparseT b (Flock.Stmt.tensor lw (rho.extract 0 (instHSub.hSub r.slotLog 6)))",
    "            (instHMod.hMod c (instHPow.hPow 2 r.slotLog))))",
    "        (FlockLevel3.lookupTerm (Flock.Stmt.tensor lw (rho.extract 0 (instHSub.hSub r.slotLog 6))) lk",
    "          (instHMod.hMod c (instHPow.hPow 2 r.slotLog)))))"
   ],
   "assumptions": [],
   "type_hash": "f128d6a45015cd6b72e14363e1a4927ff8c5dd9050abdc263298ae83b5345e0e"
  },
  "FlockLevel3.sparseT_scale": {
   "signature": [
    "FlockLevel3.sparseT_scale (lw rho : Array Flock.F128) (hlw : Eq lw.size 64) (sl : Nat) (hsl : instLENat.le 6 sl)",
    "  (hslr : instLENat.le (instHSub.hSub sl 6) rho.size) (q : Nat)",
    "  (hq : instLTNat.lt q (instHPow.hPow 2 (instHSub.hSub rho.size (instHSub.hSub sl 6)))) (m : Flock.Sparse) (i' : Nat) :",
    "  Eq",
    "    (instHMul.hMul",
    "      (FlockLevel3.GF128.of (Array.instGetElem?NatLtSize.getElem! (Flock.eqTable (rho.extract (instHSub.hSub sl 6))) q))",
    "      (FlockLevel3.sparseT m (Flock.Stmt.tensor lw (rho.extract 0 (instHSub.hSub sl 6))) i'))",
    "    ((Finset.range (instMinNat.min m.rows (instHPow.hPow 2 sl))).sum fun i =>",
    "      (Finset.range (Array.instGetElem?NatLtSize.getElem! m.len i)).sum fun t =>",
    "        ite (Eq (m.col i t) i')",
    "          (FlockLevel3.GF128.of (FlockLevel3.eIn lw rho (instHAdd.hAdd (instHMul.hMul q (instHPow.hPow 2 sl)) i))) 0)"
   ],
   "assumptions": [],
   "type_hash": "8340d525f52e07806c7d9efec647486cb56a986a9a5b3aa4ab75bf2088d32e4f"
  },
