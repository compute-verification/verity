  "FlockLevel3.placeRange_get": {
   "signature": [
    "FlockLevel3.placeRange_get (r : Flock.Range) (eHi base : Array Flock.F128) (fuel k : Nat) (out : Array Flock.F128)",
    "  (c : Nat) :",
    "  instLTNat.lt c out.size →",
    "    Eq (Array.instGetElem?NatLtSize.getElem! (Flock.Stmt.placeRange r eHi base fuel k out) c)",
    "      (ite",
    "        (And (instLENat.le (instHAdd.hAdd r.pos0 k) (instHDiv.hDiv c (instHPow.hPow 2 r.slotLog)))",
    "          (instLTNat.lt (instHDiv.hDiv c (instHPow.hPow 2 r.slotLog)) (instHAdd.hAdd (instHAdd.hAdd r.pos0 k) fuel)))",
    "        (instHMul.hMul (Array.instGetElem?NatLtSize.getElem! eHi (instHDiv.hDiv c (instHPow.hPow 2 r.slotLog)))",
    "          (Array.instGetElem?NatLtSize.getElem! base (instHMod.hMod c (instHPow.hPow 2 r.slotLog))))",
    "        (Array.instGetElem?NatLtSize.getElem! out c))"
   ],
   "assumptions": [],
   "type_hash": "af3b4736e0f287472429f769c6b66f0df43b8107457eb71e4af093694143ec41"
  },
  "FlockLevel3.placeSlot_get": {
   "signature": [
    "FlockLevel3.placeSlot_get (s : Flock.F128) (base : Array Flock.F128) (at_ fuel i : Nat) (out : Array Flock.F128)",
    "  (c : Nat) :",
    "  instLTNat.lt c out.size →",
    "    Eq (Array.instGetElem?NatLtSize.getElem! (Flock.Stmt.placeSlot s base at_ fuel i out) c)",
    "      (ite (And (instLENat.le (instHAdd.hAdd at_ i) c) (instLTNat.lt c (instHAdd.hAdd (instHAdd.hAdd at_ i) fuel)))",
    "        (instHMul.hMul s (Array.instGetElem?NatLtSize.getElem! base (instHSub.hSub c at_)))",
    "        (Array.instGetElem?NatLtSize.getElem! out c))"
   ],
   "assumptions": [],
   "type_hash": "1def2999dcef9f02efb673f6d8ed542dded4903c8cc3077f5ce59d90c4380071"
  },
  "FlockLevel3.reduce_spec": {
   "signature": [
    "FlockLevel3.reduce_spec (r0 r1 r2 r3 : UInt64) :",
    "  Eq (FlockLevel3.F128.poly (Flock.F128.reduce r0 r1 r2 r3))",
    "    ((instHAdd.hAdd",
