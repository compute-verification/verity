    "            (instHMod.hMod c (instHPow.hPow 2 r.slotLog))))",
    "        (FlockLevel3.lookupTerm (Flock.Stmt.tensor lw (rho.extract 0 (instHSub.hSub r.slotLog 6))) lk",
