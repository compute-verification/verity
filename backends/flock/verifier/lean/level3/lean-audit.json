   "signature": [
    "FlockLevel3.build_computes.{u_1} {K : Type u_1} [Field K] [CharP K 2] [DecidableEq K] {name : String}",
    "  {table : ByteArray} {n lo bits : Nat} {net : Flock.Net}",
    "  (hb : Eq (Flock.Lookup.build name table n lo bits) (Except.ok net))",
    "  (hK : instLENat.le net.useful Flock.Lookup.KONST) :",
    "  Exists fun RA =>",
    "    Exists fun RB =>",
    "      Exists fun lk =>",
    "        Exists fun col =>",
    "          And (Eq (Flock.Sparse.ofRows RA (instHPow.hPow 2 net.unitLog)) (Except.ok net.a))",
    "            (And (Eq (Flock.Sparse.ofRows RB (instHPow.hPow 2 net.unitLog)) (Except.ok net.b))",
    "              (And (Eq RA.size net.useful)",
    "                (And (Eq RB.size net.useful)",
    "                  (And (Eq net.lookup (Option.some lk))",
    "                    (And (Eq lk.table table)",
    "                      (And (Eq lk.n n)",
    "                        (And (Eq lk.lo lo)",
    "                          (And (Eq lk.bits bits)",
    "                            (And",
    "                              (Eq net.outGroups",
    "                                (List.cons { col := col, words := 1, bits := (List.cons bits List.nil).toArray }",
    "                                    List.nil).toArray)",
    "                              (∀ (z : Nat → K),",
    "                                (∀ (r : Nat),",
    "                                    instLTNat.lt r net.useful →",
    "                                      Eq (z r)",
    "                                        (instHMul.hMul (FlockLevel3.rowSum z (RA.getD r List.nil.toArray))",
    "                                          (instHAdd.hAdd (FlockLevel3.rowSum z (RB.getD r List.nil.toArray))",
    "                                            (FlockLevel3.tableB lk z r)))) →",
    "                                  Eq (z net.constPos) 1 →",
    "                                    And (∀ (i : Nat), instLTNat.lt i n → Or (Eq (z i) 0) (Eq (z i) 1))",
    "                                      (∀ (j : Nat),",
    "                                        instLTNat.lt j bits →",
    "                                          Eq (z (instHAdd.hAdd (instHMul.hMul 128 col) j))",
    "                                            (ite",
    "                                              (Eq",
    "                                                ((Flock.rd32 table",
    "                                                      (instHMul.hMul 4 (FlockLevel3.bitsVal z (List.range n)))).testBit",
    "                                                  j)",
    "                                                Bool.true)",
    "                                              1 0))))))))))))"
   ],
