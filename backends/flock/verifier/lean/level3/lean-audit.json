  "FlockLevel3.sparseT_scale": {
   "signature": [
    "FlockLevel3.sparseT_scale (lw rho : Array Flock.F128) (hlw : lw.size = 64) (sl : ℕ) (hsl : 6 ≤ sl)",
    "  (hslr : sl - 6 ≤ rho.size) (q : ℕ) (hq : q < 2 ^ (rho.size - (sl - 6))) (m : Flock.Sparse) (i' : ℕ) :",
    "  FlockLevel3.GF128.of (Flock.eqTable (rho.extract (sl - 6)))[q]! *",
    "      FlockLevel3.sparseT m (Flock.Stmt.tensor lw (rho.extract 0 (sl - 6))) i' =",
    "    ∑ i ∈ Finset.range (min m.rows (2 ^ sl)),",
    "      ∑ t ∈ Finset.range m.len[i]!,",
    "        if m.col i t = i' then FlockLevel3.GF128.of (FlockLevel3.eIn lw rho (q * 2 ^ sl + i)) else 0"
   ],
   "assumptions": [],
   "type_hash": "0000000013267073"
  },
