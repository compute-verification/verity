   "signature": [
    "Flock.HmNets.layout_rows (st : Flock.HmNets.St) (inBits outBits : Array Nat) (outs : Array Flock.HmNets.Lin) :",
    "  have l := Flock.HmNets.layout st inBits outBits outs;",
    "  have nIn := Array.foldl (fun x1 x2 => instHAdd.hAdd x1 x2) 0 inBits;",
    "  have inRows := instHMul.hMul (Flock.HmNets.groupWords nIn) Flock.WORD;",
    "  have span :=",
    "    instHMul.hMul (Flock.HmNets.groupWords (Array.foldl (fun x1 x2 => instHAdd.hAdd x1 x2) 0 outBits)) Flock.WORD;",
    "  have start :=",
    "    instHMul.hMul (instHDiv.hDiv (instHSub.hSub (instHAdd.hAdd (instHAdd.hAdd inRows st.rows.length) span) 1) span)",
    "      span;",
    "  And (Eq l.constPos (instHAdd.hAdd start span))",
    "    (And",
    "      (∀ (i : Nat),",
    "        instLTNat.lt i nIn →",
    "          And (Eq (l.ra.getD i List.nil.toArray) (List.cons i List.nil).toArray)",
    "            (Eq (l.rb.getD i List.nil.toArray) (List.cons i List.nil).toArray))",
    "      (And",
    "        (∀ (k : Nat) (hk : instLTNat.lt k st.rows.reverse.length),",
    "          And",
    "            (Eq (l.ra.getD (instHAdd.hAdd inRows k) List.nil.toArray)",
    "              (Flock.HmNets.cols nIn inRows l.constPos (List.instGetElemNatLtLength.getElem st.rows.reverse k hk).a))",
    "            (Eq (l.rb.getD (instHAdd.hAdd inRows k) List.nil.toArray)",
    "              (Flock.HmNets.cols nIn inRows l.constPos (List.instGetElemNatLtLength.getElem st.rows.reverse k hk).b)))",
    "        (∀ (j : Nat) (hj : instLTNat.lt j outs.size),",
    "          And",
    "            (Eq (l.ra.getD (instHAdd.hAdd start j) List.nil.toArray)",
    "              (Flock.HmNets.cols nIn inRows l.constPos (Array.instGetElemNatLtSize.getElem outs j hj)))",
    "            (Eq (l.rb.getD (instHAdd.hAdd start j) List.nil.toArray) (List.cons l.constPos List.nil).toArray))))"
   ],
