+/// `forgeries --instances INST --pub PUB --circuit FILE [--forged FILE] [--tables DIR] [--only CASE] --out DIR`: every selftest forgery that
+/// runs a session, recorded by the verifier's own server as a replayable set: `session.json`, `circuit.rep0.bin`,
+/// `circuit.rep1.bin`, `case.json` (the expected verdict, the live and offline verdicts, which public file the verifier
+/// read), and `pub.bin` when it is not the stage's.
+fn forgeries(st: &Arc<Stmt>, inst: &Arc<Instances>, pubi: &Arc<Instances>) {
+    let out = std::path::PathBuf::from(arg("--out", "forgeries"));
+    const GENERIC: &[&str] = &["mask_cells_random", "output_claim_false", "digest_claim_false", "message_byte_differs_from_the_committed_row",
+        "unit_input_differs_from_its_message_bits", "unit_internal_bit_flipped", "chaining_value_forged", "parent_message_forged",
+        "key_substituted", "flags_forged", "coins_before_y", "fast_profile_proofs", "cross_session_replay_both_reps",
+        "prover_file_differs_from_verifier_file", "relabelled_circuit", "private_cut_word_tampered", "tail_swapped",
+        "tail_swapped_circuit_refused"];
+    let only = arg("--only", "");
+    for &(name, accept, _) in CASES {
+        if !GENERIC.contains(&name) || skipped(st, name) || (!only.is_empty() && only != name) {
+            continue;
+        }
+        let d = out.join(name);
+        std::fs::create_dir_all(&d).unwrap();
+        let mut plan = plan_of(name, false);
+        if name == "cross_session_replay_both_reps" {
+            let s0 = Arc::new(Mutex::new(server(st, pubi)));
+            plan.substitute = Some(session(st, inst, shared(InProc(s0)), &Plan::default(), ProverSeed::from_os()).1);
+        }
+        let mut public = "stage";
+        let (pst, pinst, vinst): (Arc<Stmt>, Arc<Instances>, Arc<Instances>) = match name {
+            "output_claim_false" | "digest_claim_false" => {
+                let path = d.join("pub.bin");
+                write_false_public(st, &arg("--pub", ""), if name.starts_with("output") { "output" } else { "digest" }, &path);
+                let v = Arc::new(Instances::load(path.to_str().unwrap(), &st.c).unwrap());
+                let mut p = Instances::load(&arg("--instances", ""), &st.c).unwrap();
+                p.public_sha256 = v.public_sha256;
+                public = "pub.bin";
+                (st.clone(), Arc::new(p), v)
+            }
+            "prover_file_differs_from_verifier_file" => {
+                let mut p = Instances::load(&arg("--instances", ""), &st.c).unwrap();
+                p.public_sha256[0] ^= 1;
+                (st.clone(), Arc::new(p), pubi.clone())
+            }
+            "tail_swapped_circuit_refused" => {
+                let text = std::fs::read_to_string(arg("--forged", "circuit-forged.txt")).unwrap();
+                let c2 = Composite::parse(&text, Some(&arg("--tables", "tables"))).unwrap_or_else(|e| refuse(e));
+                (Arc::new(Stmt::new(c2, st.n, st.identity.clone()).unwrap_or_else(|e| refuse(e))), inst.clone(), pubi.clone())
+            }
+            "relabelled_circuit" => {
+                let text = std::fs::read_to_string(arg("--circuit", "")).unwrap();
+                let c2 = Composite::parse(&relabel(&text), Some(&arg("--tables", "tables"))).unwrap_or_else(|e| refuse(e));
+                (Arc::new(Stmt::new(c2, st.n, st.identity.clone()).unwrap_or_else(|e| refuse(e))), inst.clone(), pubi.clone())
+            }
+            _ => (st.clone(), inst.clone(), pubi.clone()),
+        };
+        let s = Arc::new(Mutex::new(Server::new(config(st, sigma(st, &vinst)), Box::new(CircuitVerifier { st: st.clone(), inst: vinst.clone() }))));
+        // a prover the server refuses may panic mid-session; the server's record up to the refusal is still the forgery
+        let t = shared(InProc(s.clone()));
+        let v = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| session(&pst, &pinst, t, &plan, ProverSeed::from_os()).0))
+            .unwrap_or_else(|_| json!({"accepted": false, "why": "the prover stopped (the server refused the session)"}));
+        let (rec, proofs) = {
+            let s = s.lock().unwrap_or_else(|e| e.into_inner());
+            (s.record_json(), (0..2).map(|r| s.proofs().get(&(TABLE.to_string(), r)).cloned().unwrap_or_default()).collect::<Vec<_>>())
+        };
+        std::fs::write(d.join("session.json"), serde_json::to_string_pretty(&rec).unwrap()).unwrap();
+        for (r, p) in proofs.iter().enumerate() {
+            std::fs::write(d.join(format!("{TABLE}.rep{r}.bin")), p).unwrap();
+        }
+        let off = upstream_offline(st, &vinst, &rec, &proofs);
+        let case = json!({"case": name, "expect": if accept {"accept"} else {"reject"}, "live": {"accepted": v["accepted"], "why": v["why"]},
+                          "offline": off, "public": public});
+        std::fs::write(d.join("case.json"), serde_json::to_string_pretty(&case).unwrap()).unwrap();
+        println!("FORGERY\t{case}");
+    }
+}
