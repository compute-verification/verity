+/// The verifier's public file with one public word changed and its frame-v3 roots recomputed, written as a file: a
+/// self-consistent, false statement whose public hash is the file's own (so an offline verifier derives the same Σ).
+fn write_false_public(st: &Stmt, pub_path: &str, what: &str, out: &std::path::Path) {
+    let mut v = Instances::load(pub_path, &st.c).unwrap();
+    match what {
+        "output" => v.outputs[5] ^= 1,
+        _ => v.digests[1][0] ^= 1,
+    }
+    let text = std::fs::read(pub_path).unwrap();
+    let nl = text.iter().position(|&x| x == b'\n').unwrap();
+    let mut head: Value = serde_json::from_slice(&text[..nl]).unwrap();
+    let fv = head["frame_v3"].clone();
+    let np = st.c.ports.len();
+    for (p, port) in st.c.ports.iter().enumerate() {
+        let dom = hexb(fv["domain_ids"][&port.name].as_str().unwrap()).unwrap();
+        let leaves: Vec<[u8; 32]> = (0..v.n).map(|i| fv3_leaf(&dom, i, b"blake3-keyed/row/v2", &v.digest(i, p, np))).collect();
+        head["frame_v3"]["roots"][&port.name] = json!(hex(&fv3_root(&dom, leaves)));
+    }
+    let n_out: usize = st.c.out_words.iter().sum();
+    let mut at = 0;
+    for x in st.c.meta["out_ports"].as_array().unwrap() {
+        let (name, w) = (x[0].as_str().unwrap(), x[1].as_u64().unwrap() as usize);
+        let dom = hexb(fv["domain_ids"][name].as_str().unwrap()).unwrap();
+        let words: Vec<u16> = (0..v.n).flat_map(|i| v.outputs[i * n_out + at..i * n_out + at + w].to_vec()).collect();
+        let leaves = words.iter().enumerate().map(|(r, x)| fv3_leaf(&dom, r, b"u16", &x.to_be_bytes())).collect();
+        head["frame_v3"]["roots"][name] = json!(hex(&fv3_root(&dom, leaves)));
+        at += w;
+    }
+    let mut b = serde_json::to_vec(&head).unwrap();
+    b.push(b'\n');
+    for d in &v.digests {
+        b.extend_from_slice(d);
+    }
+    for o in &v.outputs {
+        b.extend_from_slice(&o.to_le_bytes());
+    }
+    std::fs::write(out, b).unwrap();
+}
