+/// `vectors --instances INST --pub PUB --circuit FILE --out DIR`: an honest session against the verifier's own server, and
+/// R-BREAK: rep 1 an honest proof of another witness (random mask cells, so another root) at the same link points and public
+/// data, spliced into the honest record. Writes each vector's record and proofs, and upstream's verdicts.
+fn vectors(st: &Arc<Stmt>, inst: &Arc<Instances>, pubi: &Arc<Instances>) {
+    let out = std::path::PathBuf::from(arg("--out", "vectors"));
+    let write = |dir: &str, rec: &Value, proofs: &[Vec<u8>], verdicts: &Value| {
+        let d = out.join(dir);
+        std::fs::create_dir_all(&d).unwrap();
+        std::fs::write(d.join("session.json"), serde_json::to_string_pretty(rec).unwrap()).unwrap();
+        for (r, p) in proofs.iter().enumerate() {
+            std::fs::write(d.join(format!("{TABLE}.rep{r}.bin")), p).unwrap();
+        }
+        std::fs::write(d.join("upstream.json"), serde_json::to_string_pretty(verdicts).unwrap()).unwrap();
+        println!("VECTOR\t{}", json!({"vector": dir, "upstream": verdicts}));
+    };
+    let srv = Arc::new(Mutex::new(server(st, pubi)));
+    let (live, _) = session(st, inst, shared(InProc(srv.clone())), &Plan::default(), ProverSeed::from_os());
+    let (rec, proofs) = {
+        let s = srv.lock().unwrap();
+        (s.record_json(), (0..2).map(|r| s.proofs()[&(TABLE.to_string(), r)].clone()).collect::<Vec<_>>())
+    };
+    let pts: Vec<Vec<F128>> = rec["link"]["points"].as_array().unwrap().iter()
+        .map(|p| p.as_array().unwrap().iter().map(|c| f128_of_hex_(c.as_str().unwrap())).collect()).collect();
+    let off = upstream_offline(st, pubi, &rec, &proofs);
+    write("honest", &rec, &proofs, &json!({"live": live["accepted"], "offline": off}));
+
+    let lax = Arc::new(Mutex::new(Lax { points: pts.concat(), streams: BTreeMap::new(), msgs: BTreeMap::new(),
+                                        urandom: std::fs::File::open("/dev/urandom").unwrap() }));
+    struct L(Arc<Mutex<Lax>>);
+    impl Transport for L {
+        fn call(&mut self, req: Req) -> Result<Resp, String> {
+            self.0.lock().unwrap().call(req)
+        }
+    }
+    let (_, proofs_b) = session(st, inst, shared(L(lax.clone())), &Plan { mask_random: true, ..Plan::default() }, ProverSeed::from_os());
+    let rounds_b1 = lax.lock().unwrap().streams[&rep_stream(TABLE, 1)].clone();
+    let msgs_b1 = lax.lock().unwrap().msgs[&rep_stream(TABLE, 1)].clone();
+    let retained = config(st, sigma(st, pubi)).retain_rounds;
+    let (cm_b, _): (Commitment, R1csProofLigerito) = bincode::deserialize(&proofs_b[1]).unwrap();
+    let cap_b = merkle_digest_bytes(&cm_b.cap).to_vec();
+    let mut forged = rec.clone();
+    for s in forged["streams"].as_array_mut().unwrap() {
+        if s["stream"] == rep_stream(TABLE, 1) {
+            s["rounds"] = rounds_json(&rounds_b1, retained.then_some(&msgs_b1));
+            s["root_sha256"] = json!(hex(&sha256(&cap_b)));
+        }
+    }
+    for p in forged["proof_sha256"].as_array_mut().unwrap() {
+        if p["stream"] == rep_stream(TABLE, 1) {
+            p["sha256"] = json!(hex(&sha256(&proofs_b[1])));
+            p["bytes"] = json!(proofs_b[1].len());
+        }
+    }
+    let forged_proofs = vec![proofs[0].clone(), proofs_b[1].clone()];
+    let mut streams: BTreeMap<String, StreamRec> = BTreeMap::new();
+    for rep in 0..2 {
+        let rs: Vec<RoundRec> = if rep == 0 {
+            rec["streams"].as_array().unwrap().iter().find(|s| s["stream"] == rep_stream(TABLE, 0)).unwrap()["rounds"].as_array().unwrap().iter()
+                .map(|r| RoundRec { sha: flock_live::circuit::hexb(r["msg_sha256"].as_str().unwrap()).unwrap().try_into().unwrap(),
+                                    len: r["msg_len"].as_u64().unwrap() as usize, n: r["n"].as_u64().unwrap() as u32,
+                                    coins: r["coins"].as_array().unwrap().iter().map(|c| f128_of_hex_(c.as_str().unwrap())).collect() }).collect()
+        } else {
+            rounds_b1.clone()
+        };
+        streams.insert(rep_stream(TABLE, rep), StreamRec { parent: String::new(), label: domain(rep), at: 0, rounds: rs, cap: None });
+    }
+    let verdicts = json!({
+        "offline": upstream_offline(st, pubi, &forged, &forged_proofs),
+        "rep0_alone": upstream_rep_alone(st, pubi, &streams, 0, &forged_proofs[0], &pts),
+        "rep1_alone": upstream_rep_alone(st, pubi, &streams, 1, &forged_proofs[1], &pts),
+        "root_b_sha256": rec["link"]["root_b_sha256"][TABLE],
+        "rep1_root_sha256": hex(&sha256(&cap_b)),
+    });
+    write("r-break", &forged, &forged_proofs, &verdicts);
+}
