+thread_local! {
+    static VERIFY_NS: std::cell::Cell<[u64; 3]> = const { std::cell::Cell::new([0; 3]) };
+}
+
+/// Nanoseconds this thread has spent in the opening verifier's phases, for verity's session verifier's phase timers (they
+/// change no check): `[VERIFY_LEVEL_OPENS]` in [`verify_level_opens`] (the opened rows' leaves and their Merkle paths),
+/// `[VERIFY_RING_SWITCH]` in the claims' ring-switch checks, `[VERIFY_RESIDUAL]` in the residual's basis evaluation.
+pub fn verify_phase_ns() -> [u64; 3] {
+    VERIFY_NS.with(|c| c.get())
+}
+
+pub const VERIFY_LEVEL_OPENS: usize = 0;
+pub const VERIFY_RING_SWITCH: usize = 1;
+pub const VERIFY_RESIDUAL: usize = 2;
+
+pub(crate) fn add_verify_ns(phase: usize, since: std::time::Instant) {
+    let ns = since.elapsed().as_nanos() as u64;
+    VERIFY_NS.with(|c| {
+        let mut v = c.get();
+        v[phase] += ns;
+        c.set(v);
+    });
+}
