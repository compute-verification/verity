    (rowA sm120Nvf4 p64n i).2 (onesScales sm120Nvf4 p64n.k)).mapM id = some (p64n.af.getD i []))
    (hbf : ∀ j : Fin 4, (List.ofFn fun q => ch4 sm120Nvf4 (rowB sm120Nvf4 p64n j).1 (colF (basis p64n.k p64n.fa) q)
    (rowB sm120Nvf4 p64n j).2 (onesScales sm120Nvf4 p64n.k)).mapM id = some (p64n.bf.getD j []))
    (hg : (List.ofFn fun q => (List.ofFn fun q' => ch4 sm120Nvf4 (colF (basis p64n.k p64n.fb) q) (colF (basis p64n.k p64n.fa) q')
    (onesScales sm120Nvf4 p64n.k) (onesScales sm120Nvf4 p64n.k)).mapM id).mapM id = some p64n.g) :
    ∀ i j : Fin 4, peelFp4 sm120Nvf4 (opA sm120Nvf4 p64n) (opB sm120Nvf4 p64n) (basis p64n.k p64n.fa) (basis p64n.k p64n.fb)
    (beA p64n) (beB p64n) i j = some (cell p64n.u i j) := by
  intro i j
  fin_cases i <;> fin_cases j
  · exact (peelFp4_of_parts (a := rowA sm120Nvf4 p64n 0) (b := rowB sm120Nvf4 p64n 0) rfl rfl p64n_c_0_0 (haf 0)
      (hbf 0) hg p64n_pa_0 p64n_pb_0).trans p64n_u_0_0
