/-!
# The band scheme at every segment count from 1 to 2^64 (statement and proof)

`band_meets_14` fixes `N = 448` segments. Here `N` is any count with `1 ≤ N ≤ 2^64`, at the same point: segments of
`2^9` blocks of 64 KiB (`ℓ = 524288`), capacity 512, in-degree `d ≥ 5`, sequential reveal, `D = 5`, `Q = 2^20`,
`k = 111`, `ε = 2^-128`, under the per-segment tags `segDom salt (2^9)` and under one global salt. `2^64` is where
`tag_s = salt ‖ u64 s` stops being injective. Conditional on `ChainExPostFactoG`, by its statement;
`BandMultiFamilyFinal.lean` discharges it.

**The certificate.** `theorem1_ii_seq` at `S = ⌊ρ·N·2^28⌋ ≤ (18/19)·N·2^28` and loss `s = N·2^9 − 5N − 1 = 507N − 1`:
- `N ≥ 2`, `β = 265616286·N − 532588 = 507N·(524288 − 390) − 524288 − 8300`. With `nPos ≤ 2^30·N²` and `N ≤ 2^64`,
  `nPos²·N·2^9·2 ≤ 2^70·N^5 ≤ 2^390` and `nPos² ≤ 2^316`, so both terms of `chainPiSeg` are at most `2^-8299`, and
  `Σ_{j<111} (N·2^9)^j ≤ 2^(73·111) = 2^8103` leaves `|Hist|·π ≤ 2^-195`. `p₀ ≤ 959/1000` (it needs `N ≥ 2`), and
  `(959/1000)^111 ≈ 0.00959`.
- `N = 1`, `β = 265253616`: `nPos²·2^9·2 ≤ 2^69`, the freshness term is at most `2^-1128`, `Σ_{j<111} 512^j ≤ 2^999`,
  so `|Hist|·π ≤ 2^-128` with no slack; `p₀ ≤ 9593/10000`, and `(9593/10000)^111 ≈ 0.00993`.
-/

namespace Pous.BandMulti

open Pous Pous.Labelling Pous.Sponge PousSpongeChain Pous.BandChain
open scoped ENNReal

/-! ## Statements -/

/-- **The band store of `N` segments under the implementation's per-segment tags**: `N` segments of `2^9` blocks of
64 KiB, in-degree `d`, capacity 512, any 192-bit salt, sequential reveal, `D = 5`, `Q = 2^20`, `k = 111`,
`ε = 2^-128`. At `N = 448` it is `ChainBandMeets14`. -/
def ChainBandMeetsSeg (N : ℕ) [NeZero N] (d : ℕ) : Prop :=
  ∀ salt : Bits 192,
    Pous.Meets (chainBandSeg N (2 ^ 9) d 524288 512 (segDom salt (2 ^ 9))) .sequential 5 (2 ^ 20) 111
      ((2⁻¹ : ℝ≥0∞) ^ 128)

/-- **The same with one global salt and global indices** (`dom salt v`, `v < N·2^9`). -/
def ChainBandMeetsSegGlobal (N : ℕ) [NeZero N] (d : ℕ) : Prop :=
  ∀ salt : Bits 256,
    Pous.Meets (chainBandSeg N (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)) .sequential 5 (2 ^ 20) 111
      ((2⁻¹ : ℝ≥0∞) ^ 128)

/-- **Target: every segment count from 1 to 2^64, given `ChainExPostFactoG`**, for every in-degree `d ≥ D = 5`, both
domain layouts. -/
def BandMeetsFamily : Prop :=
  ChainExPostFactoG → ∀ (N : ℕ) [NeZero N], N ≤ 2 ^ 64 → ∀ d : ℕ, 5 ≤ d →
    ChainBandMeetsSeg N d ∧ ChainBandMeetsSegGlobal N d

/-! ## The union term -/

theorem nPos_fam_le (N : ℕ) (hN1 : 1 ≤ N) : nPos (N * 2 ^ 9) (2 ^ 20) ≤ 2 ^ 30 * N ^ 2 := by
  unfold nPos
  have h := Nat.div_le_self (N * 2 ^ 9 * (N * 2 ^ 9 + 1)) 2
  have hN2 : N ≤ N ^ 2 := by nlinarith
  nlinarith [h, hN2]

theorem base_fam_le (N : ℕ) (hN1 : 1 ≤ N) (hN : N ≤ 2 ^ 64) :
    (nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 * (N * 2 ^ 9) * 2 ≤ 2 ^ 390 :=
  calc (nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 * (N * 2 ^ 9) * 2 ≤ (2 ^ 30 * N ^ 2) ^ 2 * (N * 2 ^ 9) * 2 := by
        gcongr; exact nPos_fam_le N hN1
    _ = 2 ^ 70 * N ^ 5 := by ring
    _ ≤ 2 ^ 70 * (2 ^ 64) ^ 5 := by gcongr
    _ = 2 ^ 390 := by rw [← pow_mul, ← pow_add]

theorem nPos_sq_fam_le (N : ℕ) (hN1 : 1 ≤ N) (hN : N ≤ 2 ^ 64) : (nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 ≤ 2 ^ 316 :=
  calc (nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 ≤ (2 ^ 30 * N ^ 2) ^ 2 := by gcongr; exact nPos_fam_le N hN1
    _ = 2 ^ 60 * N ^ 4 := by ring
    _ ≤ 2 ^ 60 * (2 ^ 64) ^ 4 := by gcongr
    _ = 2 ^ 316 := by rw [← pow_mul, ← pow_add]

/-- **The union `π` of `N` segments is at most `2^-e` twice**, from `nPos²·N·2^9·2 ≤ 2^a` and `nPos² ≤ 2^b`, for any
exponent `e` with `β + 1 + a·507N + e ≤ 524288·(507N − 1)` and `e + b ≤ 524800`. -/
theorem chainPiSeg_fam_le (N β a b e : ℕ) (hN1 : 1 ≤ N)
    (hbase : (nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 * (N * 2 ^ 9) * 2 ≤ 2 ^ a)
    (hnp : (nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 ≤ 2 ^ b)
    (hβ : β + 1 + a * (507 * N) + e ≤ 524288 * (507 * N - 1)) (he : e + b ≤ 524800) :
    chainPiSeg N (2 ^ 9) 524288 512 5 (2 ^ 20) β ≤ (2⁻¹ : ℝ≥0∞) ^ e + (2⁻¹ : ℝ≥0∞) ^ e := by
  have h9 : N * 2 ^ 9 = 512 * N := by ring
  have hs1 : N * 2 ^ 9 - N * 5 - 1 + 1 = 507 * N := by rw [h9]; omega
  have hE1 : 524288 * (N * 2 ^ 9 - N * 5 - 1) = 524288 * (507 * N - 1) := by rw [h9]; omega
  have hβ1 : β + 1 + a * (507 * N) ≤ 524288 * (507 * N - 1) := by omega
  unfold chainPiSeg
  refine add_le_add ?_ ?_
  · rw [hs1, hE1]
    have hb : ((((nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 * (N * 2 ^ 9) * 2) ^ (507 * N) : ℕ) : ℝ≥0∞) ≤
        (2 : ℝ≥0∞) ^ (a * (507 * N)) := by
      have h := (Nat.cast_le (α := ℝ≥0∞)).2 (Nat.pow_le_pow_left hbase (507 * N))
      rwa [← pow_mul, Nat.cast_pow (2 : ℕ), Nat.cast_ofNat] at h
    calc (2 : ℝ≥0∞) ^ β * 2 *
            ((((nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 * (N * 2 ^ 9) * 2) ^ (507 * N) : ℕ) : ℝ≥0∞) /
            2 ^ (524288 * (507 * N - 1))
        ≤ (2 : ℝ≥0∞) ^ β * 2 * 2 ^ (a * (507 * N)) / 2 ^ (524288 * (507 * N - 1)) := by gcongr
      _ = (2⁻¹ : ℝ≥0∞) ^ (524288 * (507 * N - 1) - (β + 1 + a * (507 * N))) := by
          rw [div_eq_mul_inv, ENNReal.inv_pow, ← pow_succ, ← pow_add]
          exact PousDenseChain.two_pow_mul_inv_pow _ _ hβ1
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ e := pow_le_pow_right_of_le_one' (by norm_num) (by omega)
  · have hE2 : 524288 + 512 = 524800 := by norm_num
    rw [hE2]
    have hb : (((nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ b := by
      have h := (Nat.cast_le (α := ℝ≥0∞)).2 hnp
      rwa [Nat.cast_pow (2 : ℕ) b, Nat.cast_ofNat] at h
    calc (((nPos (N * 2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ 524800
        ≤ (2 : ℝ≥0∞) ^ b / 2 ^ 524800 := by gcongr
      _ = (2⁻¹ : ℝ≥0∞) ^ (524800 - b) := by
          rw [div_eq_mul_inv, ENNReal.inv_pow]; exact PousDenseChain.two_pow_mul_inv_pow _ _ (by omega)
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ e := pow_le_pow_right_of_le_one' (by norm_num) (by omega)

/-- `Σ_{j<t} (N·2^9)^j ≤ 2^(a·t)` when `N·2^9 ≤ 2^a`. -/
theorem sum_pow_fam (N a t : ℕ) (hN1 : 1 ≤ N) (ha : N * 2 ^ 9 ≤ 2 ^ a) :
    (∑ j ∈ Finset.range t, ((N * 2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) ≤ (2 : ℝ≥0∞) ^ (a * t) := by
  refine (PousDenseChain.sum_pow_le _ _ (le_trans (by norm_num) (Nat.mul_le_mul_right (2 ^ 9) hN1))).trans ?_
  have h : ((N * 2 ^ 9 : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ a := by
    have h := (Nat.cast_le (α := ℝ≥0∞)).2 ha
    rwa [Nat.cast_pow (2 : ℕ) a, Nat.cast_ofNat] at h
  calc ((N * 2 ^ 9 : ℕ) : ℝ≥0∞) ^ t ≤ ((2 : ℝ≥0∞) ^ a) ^ t := pow_le_pow_left' h t
    _ = (2 : ℝ≥0∞) ^ (a * t) := by rw [← pow_mul]

/-- **The union term for `2 ≤ N ≤ 2^64`**: `|Hist|·π ≤ 2^-128` at `β = 265616286·N − 532588` (in fact `≤ 2^-195`). -/
theorem seg_union_term_fam (N : ℕ) (hN2 : 2 ≤ N) (hN : N ≤ 2 ^ 64) :
    (∑ j ∈ Finset.range 111, ((N * 2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) *
      chainPiSeg N (2 ^ 9) 524288 512 5 (2 ^ 20) (265616286 * N - 532588) ≤ (2⁻¹ : ℝ≥0∞) ^ 128 := by
  have hN1 : 1 ≤ N := by omega
  have ha : N * 2 ^ 9 ≤ 2 ^ 73 :=
    calc N * 2 ^ 9 ≤ 2 ^ 64 * 2 ^ 9 := Nat.mul_le_mul_right _ hN
      _ = 2 ^ 73 := by rw [← pow_add]
  calc _ ≤ (2 : ℝ≥0∞) ^ (73 * 111) * ((2⁻¹ : ℝ≥0∞) ^ 8299 + (2⁻¹ : ℝ≥0∞) ^ 8299) :=
        mul_le_mul' (sum_pow_fam N 73 111 hN1 ha)
          (chainPiSeg_fam_le N _ 390 316 8299 hN1 (base_fam_le N hN1 hN) (nPos_sq_fam_le N hN1 hN)
            (by omega) (by norm_num))
    _ = (2⁻¹ : ℝ≥0∞) ^ 195 := two_pow_mul_two_inv _ _ _ (by norm_num)
    _ ≤ (2⁻¹ : ℝ≥0∞) ^ 128 := pow_le_pow_right_of_le_one' (by norm_num) (by norm_num)

/-- **The union term for one segment**: `|Hist|·π ≤ 2^-128` at `β = 265253616`, exactly (`1128 = 9·111 + 1 + 128`). -/
theorem seg_union_term_one :
    (∑ j ∈ Finset.range 111, ((1 * 2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) *
      chainPiSeg 1 (2 ^ 9) 524288 512 5 (2 ^ 20) 265253616 ≤ (2⁻¹ : ℝ≥0∞) ^ 128 :=
  calc _ ≤ (2 : ℝ≥0∞) ^ (9 * 111) * ((2⁻¹ : ℝ≥0∞) ^ 1128 + (2⁻¹ : ℝ≥0∞) ^ 1128) :=
        mul_le_mul' (sum_pow_fam 1 9 111 le_rfl (by norm_num))
          (chainPiSeg_fam_le 1 _ 69 59 1128 le_rfl (by norm_num [nPos]) (by norm_num [nPos]) (by norm_num)
            (by norm_num))
    _ = (2⁻¹ : ℝ≥0∞) ^ 128 := two_pow_mul_two_inv _ _ _ (by norm_num)

/-! ## The sampling term -/

/-- `ofReal p₀^111 ≤ 1%` whenever `p₀ ≤ r` and `r^111 ≤ 1/100`. -/
theorem sampling_of_le {p r : ℝ} (hp : p ≤ r) (hr0 : 0 ≤ r) (hr : r ^ 111 ≤ 1 / 100) :
    ENNReal.ofReal p ^ 111 ≤ ENNReal.ofReal (Params.δ : ℝ) :=
  calc ENNReal.ofReal p ^ 111 ≤ ENNReal.ofReal r ^ 111 := pow_le_pow_left' (ENNReal.ofReal_le_ofReal hp) _
    _ = ENNReal.ofReal (r ^ 111) := (ENNReal.ofReal_pow hr0 _).symm
    _ ≤ ENNReal.ofReal (Params.δ : ℝ) := ENNReal.ofReal_le_ofReal (by norm_num [Params.δ]; linarith)

/-- **The sampling term for `N ≥ 2`**: `p₀ ≤ 959/1000` at `β = 265616286·N − 532588` and any `S ≤ (18/19)·N·2^28`. -/
theorem seg_sampling_term_fam (N S : ℕ) (hN2 : 2 ≤ N) (hS : (S : ℝ) ≤ 18 / 19 * ((N : ℝ) * 2 ^ 28)) :
    ENNReal.ofReal (p₀ (265616286 * N - 532588) S (N * 2 ^ 9) 524288) ^ 111 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  refine sampling_of_le (r := 959 / 1000) ?_ (by norm_num) (by norm_num)
  have hNr : (2 : ℝ) ≤ N := by exact_mod_cast hN2
  unfold p₀
  rw [Nat.cast_sub (by omega)]
  push_cast
  rw [sub_le_comm, le_div_iff₀ (by positivity)]
  nlinarith

/-- **The sampling term for one segment**: `p₀ ≤ 9593/10000` at `β = 265253616` and any `S ≤ (18/19)·2^28`. -/
theorem seg_sampling_term_one (S : ℕ) (hS : (S : ℝ) ≤ 18 / 19 * (((1 : ℕ) : ℝ) * 2 ^ 28)) :
    ENNReal.ofReal (p₀ 265253616 S (1 * 2 ^ 9) 524288) ^ 111 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  refine sampling_of_le (r := 9593 / 10000) ?_ (by norm_num) (by norm_num)
  unfold p₀
  push_cast at hS ⊢
  rw [sub_le_comm, le_div_iff₀ (by positivity)]
  linarith

/-! ## The certificate -/

/-- The state bound of `N` segments is at most `(18/19)·N·2^28`. -/
theorem stateBound_fam_le (N d : ℕ) [NeZero N] (dom : ℕ → Bits 512) :
    ((chainBandSeg N (2 ^ 9) d 524288 512 dom).stateBound Params.ρ : ℝ) ≤ 18 / 19 * ((N : ℝ) * 2 ^ 28) := by
  have h : ((chainBandSeg N (2 ^ 9) d 524288 512 dom).stateBound Params.ρ : ℚ) ≤
      18 / 19 * ((N : ℚ) * 2 ^ 28) := by
    show ((⌊Params.ρ * (((N * 2 ^ 9) * 524288 : ℕ) : ℚ)⌋₊ : ℕ) : ℚ) ≤ _
    refine (Nat.floor_le (by unfold Params.ρ; positivity)).trans (le_of_eq ?_)
    unfold Params.ρ
    push_cast
    ring
  have h' := (Rat.cast_le (K := ℝ)).2 h
  push_cast at h'
  exact h'

/-- **The band store of `N` segments meets the requirement for every domain injective on its `N·2^9` blocks**, given
`ChainExPostFactoG`, for `1 ≤ N ≤ 2^64`, at `k = 111`. -/
theorem band_meets_fam_dom (hepf : ChainExPostFactoG) (N : ℕ) [NeZero N] (hN : N ≤ 2 ^ 64) (d : ℕ) (hd : 5 ≤ d)
    (dom : ℕ → Bits 512) (hdom : Function.Injective (fun i : Fin (N * 2 ^ 9) => dom i)) :
    Pous.Meets (chainBandSeg N (2 ^ 9) d 524288 512 dom) .sequential 5 (2 ^ 20) 111 ((2⁻¹ : ℝ≥0∞) ^ 128) := by
  have hN1 : 1 ≤ N := Nat.one_le_iff_ne_zero.2 (NeZero.ne N)
  refine ⟨le_rfl, chainScheme_correct _ _ _ _, le_rfl, ?_, ?_⟩
  · show ((((N * 2 ^ 9) * 524288 + 0 : ℕ)) : ℚ) ≤ Pous.Params.expansion * (((N * 2 ^ 9) * 524288 : ℕ) : ℚ)
    rw [Nat.add_zero]
    exact le_mul_of_one_le_left (Nat.cast_nonneg _) (by norm_num [Pous.Params.expansion])
  · intro W A₁ A₂
    have hS := stateBound_fam_le N d dom
    rcases Nat.lt_or_ge N 2 with h1 | h2
    · obtain rfl : N = 1 := by omega
      have hINC := band_seg_timedINC hepf 1 (2 ^ 9) d 524288 512 5 (2 ^ 20) 265253616 dom (by norm_num) hd
        (by norm_num) hdom
      refine (PousTargetsDense.theorem1_ii_seq (chainBandSeg 1 (2 ^ 9) d 524288 512 dom) 5 (2 ^ 20) 265253616
        ((chainBandSeg 1 (2 ^ 9) d 524288 512 dom).stateBound Pous.Params.ρ) 111 _ hINC W A₁ A₂).trans ?_
      exact (add_comm _ _).le.trans (add_le_add (seg_sampling_term_one _ hS) seg_union_term_one)
    · have hINC := band_seg_timedINC hepf N (2 ^ 9) d 524288 512 5 (2 ^ 20) (265616286 * N - 532588) dom
        (by omega) hd (by norm_num) hdom
      refine (PousTargetsDense.theorem1_ii_seq (chainBandSeg N (2 ^ 9) d 524288 512 dom) 5 (2 ^ 20)
        (265616286 * N - 532588) ((chainBandSeg N (2 ^ 9) d 524288 512 dom).stateBound Pous.Params.ρ) 111 _
        hINC W A₁ A₂).trans ?_
      exact (add_comm _ _).le.trans (add_le_add (seg_sampling_term_fam N _ h2 hS) (seg_union_term_fam N h2 hN))

/-- **`BandMeetsFamily`, proved** (conditional on `ChainExPostFactoG`, by its statement). -/
theorem band_meets_family : BandMeetsFamily := fun hepf N _ hN d hd =>
  ⟨fun salt => band_meets_fam_dom hepf N hN d hd _ (segDom_inj salt hN (by norm_num)),
    fun salt => band_meets_fam_dom hepf N hN d hd _
      (dom_inj salt (le_trans (Nat.mul_le_mul_right _ hN) (by norm_num)))⟩

/-- At `N = 448` the family is `BandMeets14`'s statement. -/
theorem band_meets_family_14 (hepf : ChainExPostFactoG) (d : ℕ) (hd : 5 ≤ d) :
    ChainBandMeets14 d ∧ ChainBandMeets14Global d :=
  band_meets_family hepf 448 (by norm_num) d hd

/-! ## Injective domains are necessary at every `N ≥ 2`; `N = 1` is the one-segment band

`shared_breaks_S` and `shared_domain_breaks_fam` generalize `shared_domain_breaks` from `N = 448` to every `N ≥ 2`
(`internal/p3-instantiation/band-family-pin-redteam-verdict.md` §2). -/

/-- With the shared domain, storing segment 0's labels answers every challenge with no query, so the audit of `N`
segments accepts with probability 1 at every state bound of at least one segment's `2^28` bits. -/
theorem shared_breaks_S (N : ℕ) [NeZero (N * 2 ^ 9)] (d : ℕ) (salt : Bits 256) (D Q k S : ℕ) (δ ε : ℝ≥0∞)
    (hN : 0 < N) (hLS : 2 ^ 9 * 524288 ≤ S) (hlt : δ + ε < 1) :
    ¬ AuditSecure (chainBandSeg N (2 ^ 9) d 524288 512 (sharedDom salt (2 ^ 9))) .sequential S D Q k δ ε := by
  intro hsec
  let enc0 : (Fin (2 ^ 9) → Bits 524288) → Bits S := fun y t =>
    if h : t.val < 2 ^ 9 * 524288 then codeEquiv (2 ^ 9) 524288 y ⟨t.val, h⟩ else false
  let dec0 : Bits S → Fin (2 ^ 9) → Bits 524288 := fun σ =>
    (codeEquiv (2 ^ 9) 524288).symm (fun t => σ ⟨t.val, lt_of_lt_of_le t.isLt hLS⟩)
  have hdec : ∀ y, dec0 (enc0 y) = y := by
    intro y
    have : (fun t : Fin (2 ^ 9 * 524288) => enc0 y ⟨t.val, lt_of_lt_of_le t.isLt hLS⟩) =
        codeEquiv (2 ^ 9) 524288 y := by
      funext t
      simp only [enc0, t.isLt, ↓reduceDIte]
    show (codeEquiv (2 ^ 9) 524288).symm _ = y
    rw [this, Equiv.symm_apply_apply]
  let s0 : Fin N := ⟨0, hN⟩
  let sch := chainBandSeg N (2 ^ 9) d 524288 512 (sharedDom salt (2 ^ 9))
  let A₁ : Preprocessor sch S := fun _ _ C _ => enc0 fun i => C (gIdx s0 i)
  let A₂ : SeqResponder sch S D Q :=
    { step := fun _ _ _ σ i => Prog.ret (dec0 σ (locOf (N := N) (B := 2 ^ 9) i), σ)
      bounded := fun _ _ _ _ _ _ => ⟨Nat.zero_le _, Nat.zero_le _⟩ }
  have hacc : ∀ x, seqAccepts sch k (fun _ => false) A₁ A₂ x := by
    intro x
    let f : Bits (524288 + (524288 + 512)) → Bits (524288 + (524288 + 512)) := fun y =>
      (idealPerm (524288 + (524288 + 512))).answer x.1 (.inl y)
    let C := labelG (bandSegDAG N (2 ^ 9) d) f (sharedDom salt (2 ^ 9))
      (Dense.blocks (N * 2 ^ 9) 524288 (fun _ => false))
    show seqAnswers ((idealPerm (524288 + (524288 + 512))).answer x.1)
        (fun _ σ i => Prog.ret (dec0 σ (locOf (N := N) (B := 2 ^ 9) i), σ)) 0 (List.ofFn x.2.2)
        (enc0 fun i => C (gIdx s0 i)) = List.ofFn fun j => C (x.2.2 j)
    refine (seqAnswers_ret_ofFn _ _ _ x.2.2).trans ?_
    congr 1
    funext j
    show dec0 (enc0 fun i => C (gIdx s0 i)) (locOf (x.2.2 j)) = C (x.2.2 j)
    rw [hdec]
    show C (gIdx s0 (locOf (x.2.2 j))) = C (x.2.2 j)
    exact (sharedDom_label (N := N) (B := 2 ^ 9) (d := d) f salt (gIdx s0 (locOf (x.2.2 j)))).trans
      ((congrArg _ (locOf_gIdx s0 _)).trans (sharedDom_label (N := N) (B := 2 ^ 9) (d := d) f salt _).symm)
  have h2 := hsec (fun _ => false) A₁ A₂
  rw [pr_eq_one hacc] at h2
  exact absurd h2 (not_le.2 hlt)

/-- **A shared domain breaks the store at every segment count `N ≥ 2`**, for every in-degree, round budget, `k` and
`ε` (`SharedDomainBreaks` at `N = 448`). At `N = 1` the shared domain is `dom`, which is injective. -/
theorem shared_domain_breaks_fam (N : ℕ) [NeZero N] (hN : 2 ≤ N) (d : ℕ) (salt : Bits 256) (D Q k : ℕ)
    (ε : ℝ≥0∞) :
    ¬ Pous.Meets (chainBandSeg N (2 ^ 9) d 524288 512 (sharedDom salt (2 ^ 9))) .sequential D Q k ε := by
  intro hM
  obtain ⟨hε, -, -, -, hsec⟩ := hM
  refine shared_breaks_S N d salt D Q k _ _ _ (by omega) ?_ (delta_add_lt_one hε) hsec
  show 2 ^ 9 * 524288 ≤ ⌊Params.ρ * (((N * 2 ^ 9) * 524288 : ℕ) : ℚ)⌋₊
  apply Nat.le_floor
  unfold Params.ρ
  push_cast
  have : (2 : ℚ) ≤ N := by exact_mod_cast hN
  nlinarith

theorem topoDAG_eq_of_par {n : ℕ} {G H : TopoDAG n} (h : G.par = H.par) : G = H := by
  cases G; cases H; cases h; rfl

theorem bandSegDAG_one (d : ℕ) : (bandSegDAG 1 (2 ^ 9) d : TopoDAG (2 ^ 9)) = bandDAG (2 ^ 9) d := by
  apply topoDAG_eq_of_par
  unfold bandSegDAG bandDAG
  funext v
  apply Finset.ext
  intro u
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  have hu : u.val < 2 ^ 9 := u.isLt
  have hv : v.val < 2 ^ 9 := v.isLt
  constructor
  · rintro ⟨-, h⟩; exact h
  · intro h; exact ⟨by rw [Nat.div_eq_of_lt hu, Nat.div_eq_of_lt hv], h⟩

/-- One segment of the multi-segment layout is the one-segment band. -/
theorem chainBandSeg_one (d ℓ c : ℕ) (dom : ℕ → Bits c) :
    chainBandSeg 1 (2 ^ 9) d ℓ c dom = chainBand (2 ^ 9) d ℓ c dom := by
  show chainScheme (B := 2 ^ 9) (bandSegDAG 1 (2 ^ 9) d) ℓ c dom = chainScheme (bandDAG (2 ^ 9) d) ℓ c dom
  rw [bandSegDAG_one]

/-- At `N = 1` the family's global layout is the one-segment band statement `ChainBandMeets64`. -/
theorem band_meets_family_one (hepf : ChainExPostFactoG) (d : ℕ) (hd : 5 ≤ d) : ChainBandMeets64 d := by
  intro salt
  have h := (band_meets_family hepf 1 (by norm_num) d hd).2 salt
  rwa [chainBandSeg_one] at h

end Pous.BandMulti

end


/-! ════ BandMultiFamilyFinal ════ -/
section


/-! # The band store at every segment count from 1 to 2^64: unconditional final

`band_meets_family` with `ChainExPostFactoG` discharged by `chainExPostFactoG_v6`. -/

namespace Pous.BandMulti

open Pous Pous.Sponge PousSpongeChain Pous.BandChain

theorem band_meets_family_final : ∀ (N : ℕ) [NeZero N], N ≤ 2 ^ 64 → ∀ d : ℕ, 5 ≤ d →
    ChainBandMeetsSeg N d ∧ ChainBandMeetsSegGlobal N d :=
  band_meets_family chainExPostFactoG_v6

end Pous.BandMulti

end

