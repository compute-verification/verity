section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The count lemma over GF(2) (`credit-resolved.md` §11.5)

Events carry vectors (formal XOR-forms over a group's atoms) and keys (their place in chain order). An event
**raises** if its vector is not in the span of the earlier events' vectors.

- `linearIndependent_raising`: the raising events' vectors are linearly independent, since each lies outside the
  span of everything before it.
- `card_raising_le`: so there are at most `finrank` of them.
- `pinned_count`: for a group with atoms `A`, sampled atoms `S ⊆ A` and relations `ρ`,
  `#(sampled atoms in the span when sampled) + |A| ≥ |S| + #(raising relations)`. Atoms outside `S` (virtual or
  absent) cost one each, and each raising relation pays one.
-/

namespace PousRank

open Submodule

section Abstract

variable {K : Type*} [Field K] {V : Type*} [AddCommGroup V] [Module K V]
variable {E : Type*} [Fintype E]

/-- Event `e` **raises**: its vector is not in the span of the vectors of the events with smaller keys. -/
def Raises (vec : E → V) (key : E → ℕ ×ₗ ℕ) (e : E) : Prop :=
  vec e ∉ span K (vec '' {e' | key e' < key e})

omit [Fintype E] in
theorem mem_span_of_lt {vec : E → V} {key : E → ℕ ×ₗ ℕ} {e e' : E} (h : key e' < key e) :
    vec e' ∈ span K (vec '' {e'' | key e'' < key e}) :=
  subset_span ⟨e', h, rfl⟩

/-- **The raising events are linearly independent.** -/
theorem linearIndependent_raising (vec : E → V) (key : E → ℕ ×ₗ ℕ) (hkey : Function.Injective key) :
    LinearIndependent K (fun e : {e // Raises (K := K) vec key e} => vec e.1) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg
  by_contra hne
  obtain ⟨i0, hi0⟩ := not_forall.1 hne
  set T := Finset.univ.filter fun i : {e // Raises (K := K) vec key e} => g i ≠ 0 with hTdef
  have hT : T.Nonempty := ⟨i0, Finset.mem_filter.2 ⟨Finset.mem_univ _, hi0⟩⟩
  obtain ⟨i, hiT, hmax⟩ := T.exists_max_image (fun i => key i.1) hT
  have hgi : g i ≠ 0 := (Finset.mem_filter.1 hiT).2
  have hsplit : g i • vec i.1 = -∑ j ∈ Finset.univ.erase i, g j • vec j.1 := by
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i)] at hg
    exact eq_neg_of_add_eq_zero_left hg
  have hrest : ∑ j ∈ Finset.univ.erase i, g j • vec j.1 ∈ span K (vec '' {e' | key e' < key i.1}) := by
    refine Submodule.sum_mem _ fun j hj => ?_
    by_cases hgj : g j = 0
    · rw [hgj, zero_smul]; exact Submodule.zero_mem _
    · refine Submodule.smul_mem _ _ (mem_span_of_lt ?_)
      have hjT : j ∈ T := Finset.mem_filter.2 ⟨Finset.mem_univ _, hgj⟩
      have hle := hmax j hjT
      have hne' : j.1 ≠ i.1 := fun h => (Finset.mem_erase.1 hj).1 (Subtype.ext h)
      exact lt_of_le_of_ne hle fun h => hne' (hkey h)
  have hmem : vec i.1 ∈ span K (vec '' {e' | key e' < key i.1}) := by
    have : vec i.1 = (g i)⁻¹ • (g i • vec i.1) := by rw [smul_smul, inv_mul_cancel₀ hgi, one_smul]
    rw [this, hsplit]
    exact Submodule.smul_mem _ _ (Submodule.neg_mem _ hrest)
  exact i.2 hmem

/-- **At most `finrank` events raise.** -/
theorem card_raising_le [FiniteDimensional K V] (vec : E → V) (key : E → ℕ ×ₗ ℕ)
    (hkey : Function.Injective key) [DecidablePred (Raises (K := K) vec key)] :
    (Finset.univ.filter (Raises (K := K) vec key)).card ≤ Module.finrank K V := by
  have h := (linearIndependent_raising (K := K) vec key hkey).fintype_card_le_finrank
  rwa [Fintype.card_subtype] at h

end Abstract

section Groups

variable {A : Type} [Fintype A] [DecidableEq A] {ρ : Type} [Fintype ρ]

/-- The events of a group: its sampled atoms, then its relations. -/
abbrev Ev (S : Finset A) (ρ : Type) : Type := S ⊕ ρ

/-- An event's vector: the atom's coordinate, or the relation's form. -/
def evVec (S : Finset A) (form : ρ → A → ZMod 2) : Ev S ρ → (A → ZMod 2)
  | Sum.inl a => Pi.single a.1 1
  | Sum.inr r => form r

/-- An event's key: an atom at `(its index, N)`, a relation at `(its index, its priority)`, priorities `< N`. -/
def evKey (S : Finset A) (N : ℕ) (ka : A → ℕ) (kr : ρ → ℕ ×ₗ ℕ) : Ev S ρ → ℕ ×ₗ ℕ
  | Sum.inl a => toLex (ka a.1, N)
  | Sum.inr r => kr r

omit [Fintype A] [DecidableEq A] [Fintype ρ] in
theorem evKey_injective {S : Finset A} {N : ℕ} {ka : A → ℕ} {kr : ρ → ℕ ×ₗ ℕ}
    (hka : Set.InjOn ka S) (hkr : Function.Injective kr) (hN : ∀ r, (ofLex (kr r)).2 < N) :
    Function.Injective (evKey S N ka kr) := by
  rintro (a | r) (a' | r') h
  · simp only [evKey, toLex_inj, Prod.mk.injEq] at h
    exact congrArg Sum.inl (Subtype.ext (hka a.2 a'.2 h.1))
  · exfalso
    have h2 := congrArg (fun x => (ofLex x).2) h
    simp only [evKey, ofLex_toLex] at h2
    exact absurd (hN r') (by omega)
  · exfalso
    have h2 := congrArg (fun x => (ofLex x).2) h
    simp only [evKey, ofLex_toLex] at h2
    exact absurd (hN r) (by omega)
  · exact congrArg Sum.inr (hkr h)

/-- A sampled atom is **in the span when sampled**: its coordinate is in the span of the earlier events. -/
def InSpan (S : Finset A) (N : ℕ) (ka : A → ℕ) (form : ρ → A → ZMod 2) (kr : ρ → ℕ ×ₗ ℕ) (a : S) : Prop :=
  Pi.single a.1 (1 : ZMod 2) ∈ span (ZMod 2) (evVec S form '' {e' | evKey S N ka kr e' < evKey S N ka kr (Sum.inl a)})

/-- A relation **raises** in the group. -/
def RelRaises (S : Finset A) (N : ℕ) (ka : A → ℕ) (form : ρ → A → ZMod 2) (kr : ρ → ℕ ×ₗ ℕ) (r : ρ) : Prop :=
  Raises (K := ZMod 2) (evVec S form) (evKey S N ka kr) (Sum.inr r)

open Classical in
/-- **The count lemma.** `#(sampled atoms in the span when sampled) + |A| ≥ |S| + #(raising relations)`. -/
theorem pinned_count (S : Finset A) (N : ℕ) (ka : A → ℕ) (form : ρ → A → ZMod 2) (kr : ρ → ℕ ×ₗ ℕ)
    (hka : Set.InjOn ka S) (hkr : Function.Injective kr) (hN : ∀ r, (ofLex (kr r)).2 < N) :
    S.card + (Finset.univ.filter (RelRaises S N ka form kr)).card ≤
      (Finset.univ.filter (InSpan S N ka form kr)).card + Fintype.card A := by
  have hinj := evKey_injective hka hkr hN
  have hle := card_raising_le (K := ZMod 2) (evVec S form) (evKey S N ka kr) hinj
  rw [Module.finrank_fintype_fun_eq_card] at hle
  -- the raising events split into raising atoms and raising relations
  have hsplit : (Finset.univ.filter (Raises (K := ZMod 2) (evVec S form) (evKey S N ka kr))).card =
      (Finset.univ.filter fun a : S => ¬ InSpan S N ka form kr a).card +
        (Finset.univ.filter (RelRaises S N ka form kr)).card := by
    simp only [Finset.card_filter]
    rw [Fintype.sum_sum_type]
    congr 1
    exact Finset.sum_congr rfl fun a _ => by
      simp only [Raises, InSpan, evVec]
      congr
  have hatoms : (Finset.univ.filter fun a : S => ¬ InSpan S N ka form kr a).card +
      (Finset.univ.filter (InSpan S N ka form kr)).card = S.card := by
    rw [add_comm, Finset.card_filter_add_card_filter_not, Finset.card_univ, Fintype.card_coe]
  omega

end Groups

section Semantic

/-! ### Fixedness per class: the span is class-fixed

`Cls ℓ` is the set of class members sharing `ω`'s prefix below `ℓ`; it shrinks as `ℓ` grows. A function is
**class-fixed at `ℓ`** if every member of `Cls ℓ` agrees with `ω` on it. Formal forms are evaluated as XORs of the
atoms' values, so the forms whose value is class-fixed form a submodule, and a span of class-fixed forms is
class-fixed. With `pinned_count`, the atoms in the span when sampled are pinned.
-/

variable {Ω : Type*} {M : Type*} [AddCommGroup M] [Module (ZMod 2) M]
variable {A : Type} [Fintype A] [DecidableEq A] {ρ : Type} [Fintype ρ]

/-- Class-fixed at `ℓ`. -/
def CF (Cls : ℕ → Set Ω) (ω : Ω) (ℓ : ℕ) (f : Ω → M) : Prop := ∀ ω' ∈ Cls ℓ, f ω' = f ω

/-- The value of a form: the XOR of its atoms' values. -/
def eval (val : A → Ω → M) (x : A → ZMod 2) (ω' : Ω) : M := ∑ a, x a • val a ω'

theorem eval_single (val : A → Ω → M) (a : A) (ω' : Ω) : eval val (Pi.single a 1) ω' = val a ω' := by
  unfold eval
  rw [Finset.sum_eq_single a]
  · simp
  · intro b _ hb; simp [hb]
  · intro h; exact absurd (Finset.mem_univ a) h

/-- The forms whose value is class-fixed at `ℓ`. -/
def cfForms (Cls : ℕ → Set Ω) (ω : Ω) (ℓ : ℕ) (val : A → Ω → M) : Submodule (ZMod 2) (A → ZMod 2) where
  carrier := {x | CF Cls ω ℓ (eval val x)}
  add_mem' {x y} hx hy ω' hω' := by
    simp only [Set.mem_ofPred_eq, CF, eval, Pi.add_apply, add_smul, Finset.sum_add_distrib] at hx hy ⊢
    rw [hx ω' hω', hy ω' hω']
  zero_mem' ω' _ := by simp [eval]
  smul_mem' c x hx ω' hω' := by
    simp only [Set.mem_ofPred_eq, CF, eval, Pi.smul_apply, smul_eq_mul, mul_smul] at hx ⊢
    rw [← Finset.smul_sum, ← Finset.smul_sum, hx ω' hω']

omit [DecidableEq A] in
theorem cf_of_mem_span {Cls : ℕ → Set Ω} {ω : Ω} {ℓ : ℕ} {val : A → Ω → M} {G : Set (A → ZMod 2)}
    (hG : ∀ v ∈ G, CF Cls ω ℓ (eval val v)) {x : A → ZMod 2} (hx : x ∈ Submodule.span (ZMod 2) G) :
    CF Cls ω ℓ (eval val x) :=
  (Submodule.span_le (p := cfForms Cls ω ℓ val)).2 hG hx

omit [Fintype ρ] in
/-- **An atom in the span when sampled is class-fixed at its index**, given that earlier atoms are class-fixed after
their index and each relation is class-fixed from its effective index (`Cls` antitone). -/
theorem cf_of_inSpan {Cls : ℕ → Set Ω} (hanti : Antitone Cls) {ω : Ω} {val : A → Ω → M}
    (S : Finset A) (N : ℕ) (ka : A → ℕ) (form : ρ → A → ZMod 2) (kr : ρ → ℕ ×ₗ ℕ)
    (hat : ∀ a ∈ S, ∀ ℓ, ka a < ℓ → CF Cls ω ℓ (val a))
    (hrel : ∀ r, CF Cls ω (ofLex (kr r)).1 (eval val (form r)))
    {a : S} (ha : InSpan S N ka form kr a) : CF Cls ω (ka a.1) (val a.1) := by
  have h := cf_of_mem_span (Cls := Cls) (ω := ω) (ℓ := ka a.1) (val := val) ?_ ha
  · intro ω' hω'
    have := h ω' hω'
    rwa [eval_single, eval_single] at this
  · rintro v ⟨e, he, rfl⟩
    simp only [Set.mem_ofPred_eq] at he
    rcases e with b | r
    · simp only [evKey] at he
      have hlt : ka b.1 < ka a.1 := by
        rcases Prod.Lex.lt_iff.1 he with h | ⟨-, h⟩
        · simpa using h
        · simp at h
      intro ω' hω'
      simp only [evVec, eval_single]
      exact hat b.1 b.2 _ hlt ω' hω'
    · simp only [evKey] at he
      have hle : (ofLex (kr r)).1 ≤ ka a.1 := by
        rcases Prod.Lex.lt_iff.1 he with h | ⟨h, -⟩
        · simpa using h.le
        · simpa using h.le
      intro ω' hω'
      exact hrel r ω' (hanti hle hω')

end Semantic

end PousRank

end


