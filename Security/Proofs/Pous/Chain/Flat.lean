set_option relaxedAutoImplicit true


/-!
# Scratch: the chain game with the key rule

Scratch file of `bc-a359729a`, for the red team's judgement of the v6 statement change
(`internal/p3-instantiation/chain-epf-interface.md`, 07:22Z). It edits no existing file. `ChainKnow`'s `read` and
`round` are restated with one more rule, **the key rule**: a known label gives its pad call's `r` (the key,
`label ⊕ Wb`).
- `read'`, `round'`, `reach'`, `ChainHard'`: the chain game with the key rule.
- `reach_le_reach'` and `ChainHard'.toChainHard`: the key rule only adds knowledge, so `ChainHard'` is the stronger
  hardness. Every attack (`¬ ChainHard`) transfers.
- `clock_invariant'` and `chain_clock'`: the chain clock survives. Its second clause is weakened to allow the pad `r`
  of a seed row, and a fourth clause replaces `chain_invariant`'s block clause.
- The band results are restated against `ChainHard'`, with the same parameters: `band_chain_hard'`,
  `chainDense_hard'`, `band_d12_margin'`, the cliffs `band_cliff_d5'`, `band_cliff_d12'`, `band_gap_attack'`,
  `band_gap_attack_512'`, `band_needs_room'`, and `band_meets_64'` (conditional on `ChainExPostFactoG'`).
- `chainExPostFactoG'_of_chainExPostFactoG`: the old target implies the new one. So the change weakens
  `ChainExPostFactoG`.
-/

namespace Pous.BandChain

namespace KeyRule

open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal

variable {N : ℕ}

/-! ### The chain game with the key rule -/

open Classical in
/-- `read` with the key rule: keys give labels, and labels give keys (the pad call's `r`). -/
noncomputable def read' (G : TopoDAG N) (K : ChainKnow N) : ChainKnow N where
  labs := K.labs ∪ Finset.univ.filter fun v => (v, ovCalls G v) ∈ K.rs
  hs := K.hs
  rs := K.rs ∪ K.labs.image fun v => (v, ovCalls G v)

open Classical in
/-- `round` with the key rule in its `read`. -/
noncomputable def round' (G : TopoDAG N) (K : ChainKnow N) : ChainKnow N :=
  read' G
    { labs := K.labs ∪ Finset.univ.filter fun u => ∃ p ∈ K.hs, p ∈ K.rs ∧ ovBlock G p.1 p.2 = some u
      hs := K.hs ∪ (ovPos N).filter fun p => K.canCall G p.1 p.2 ∨
          (1 ≤ p.2 ∧ (p.1, p.2 + 1) ∈ K.hs ∧ (p.1, p.2 + 1) ∈ K.rs)
      rs := K.rs ∪ (ovPos N).filter fun p => K.canCall G p.1 p.2 }

/-- The knowledge after `t` rounds, with the key rule. -/
noncomputable def reach' (G : TopoDAG N) (P₀ : ChainKnow N) : ℕ → ChainKnow N
  | 0 => read' G P₀
  | t + 1 => round' G (reach' G P₀ t)

/-- Hardness in the chain game with the key rule. -/
def ChainHard' (G : TopoDAG N) (VC : Finset (Fin N)) (c ℓ : ℕ) (s : ℚ) (D k : ℕ) : Prop :=
  ∀ P₀ : ChainKnow N, P₀.size c ℓ ≤ s → (VC.filter fun v => v ∈ (reach' G P₀ D).labs).card < k

theorem mem_read'_labs (G : TopoDAG N) (K : ChainKnow N) (v : Fin N) :
    v ∈ (read' G K).labs ↔ v ∈ K.labs ∨ (v, ovCalls G v) ∈ K.rs := by
  simp [read']

theorem mem_read'_hs (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) : p ∈ (read' G K).hs ↔ p ∈ K.hs := Iff.rfl

theorem mem_read'_rs (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) :
    p ∈ (read' G K).rs ↔ p ∈ K.rs ∨ ∃ v ∈ K.labs, p = (v, ovCalls G v) := by
  simp only [read', Finset.mem_union, Finset.mem_image]
  constructor
  · rintro (h | ⟨v, hv, rfl⟩)
    · exact Or.inl h
    · exact Or.inr ⟨v, hv, rfl⟩
  · rintro (h | ⟨v, hv, rfl⟩)
    · exact Or.inl h
    · exact Or.inr ⟨v, hv, rfl⟩

/-! ### The key rule only adds knowledge -/

/-- Componentwise inclusion of knowledge. -/
def Le (K K' : ChainKnow N) : Prop := K.labs ⊆ K'.labs ∧ K.hs ⊆ K'.hs ∧ K.rs ⊆ K'.rs

theorem canCall_mono {G : TopoDAG N} {K K' : ChainKnow N} (h : Le K K') {v : Fin N} {j : ℕ}
    (hc : K.canCall G v j) : K'.canCall G v j := by
  obtain ⟨h1, h2, h3, h4⟩ := hc
  refine ⟨h1, h2, fun u hu => h.1 (h3 u hu), ?_⟩
  rcases h4 with h4 | h4
  · exact Or.inl h4
  · exact Or.inr (h.2.1 h4)

theorem mem_round'_labs (G : TopoDAG N) (K : ChainKnow N) (u : Fin N) :
    u ∈ (round' G K).labs ↔ (u ∈ K.labs ∨ ∃ p ∈ K.hs, p ∈ K.rs ∧ ovBlock G p.1 p.2 = some u) ∨
      ((u, ovCalls G u) ∈ K.rs ∨ ((u, ovCalls G u) ∈ ovPos N ∧ K.canCall G u (ovCalls G u))) := by
  simp [round', read', or_assoc]

theorem mem_round'_hs (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) :
    p ∈ (round' G K).hs ↔ p ∈ K.hs ∨ (p ∈ ovPos N ∧ (K.canCall G p.1 p.2 ∨
      (1 ≤ p.2 ∧ (p.1, p.2 + 1) ∈ K.hs ∧ (p.1, p.2 + 1) ∈ K.rs))) := by
  simp [round', read']

theorem mem_round'_rs (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) :
    p ∈ (round' G K).rs ↔ (p ∈ K.rs ∨ (p ∈ ovPos N ∧ K.canCall G p.1 p.2)) ∨
      ∃ v, (v ∈ K.labs ∨ ∃ q ∈ K.hs, q ∈ K.rs ∧ ovBlock G q.1 q.2 = some v) ∧ p = (v, ovCalls G v) := by
  simp only [round', mem_read'_rs, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem round_le_round' (G : TopoDAG N) {K K' : ChainKnow N} (h : Le K K') : Le (K.round G) (round' G K') := by
  classical
  obtain ⟨hl, hh, hr⟩ := h
  have hc : ∀ v j, K.canCall G v j → K'.canCall G v j := fun v j hc => canCall_mono ⟨hl, hh, hr⟩ hc
  refine ⟨fun u hu => ?_, fun p hp => ?_, fun p hp => ?_⟩
  · rw [mem_round'_labs]
    simp only [ChainKnow.round, ChainKnow.read, Finset.mem_union, Finset.mem_filter, Finset.mem_univ,
      true_and] at hu
    rcases hu with (hu | ⟨p, hph, hpr, hb⟩) | (hu | ⟨hpos, hcc⟩)
    · exact Or.inl (Or.inl (hl hu))
    · exact Or.inl (Or.inr ⟨p, hh hph, hr hpr, hb⟩)
    · exact Or.inr (Or.inl (hr hu))
    · exact Or.inr (Or.inr ⟨hpos, hc _ _ hcc⟩)
  · rw [mem_round'_hs]
    simp only [ChainKnow.round, ChainKnow.read, Finset.mem_union, Finset.mem_filter] at hp
    rcases hp with hp | ⟨hpos, hcc | ⟨h1, h2, h3⟩⟩
    · exact Or.inl (hh hp)
    · exact Or.inr ⟨hpos, Or.inl (hc _ _ hcc)⟩
    · exact Or.inr ⟨hpos, Or.inr ⟨h1, hh h2, hr h3⟩⟩
  · rw [mem_round'_rs]
    simp only [ChainKnow.round, ChainKnow.read, Finset.mem_union, Finset.mem_filter] at hp
    rcases hp with hp | ⟨hpos, hcc⟩
    · exact Or.inl (Or.inl (hr hp))
    · exact Or.inl (Or.inr ⟨hpos, hc _ _ hcc⟩)

theorem reach_le_reach' (G : TopoDAG N) (P₀ : ChainKnow N) : ∀ t, Le (ChainKnow.reach G P₀ t) (reach' G P₀ t)
  | 0 => by
    refine ⟨fun v hv => ?_, fun p hp => hp, fun p hp => (mem_read'_rs G P₀ p).2 (Or.inl hp)⟩
    rw [ChainKnow.reach, mem_read_labs] at hv
    exact (mem_read'_labs G P₀ v).2 hv
  | t + 1 => round_le_round' G (reach_le_reach' G P₀ t)

/-- **`ChainHard'` is the stronger hardness**: the key rule only adds knowledge. -/
theorem ChainHard'.toChainHard {G : TopoDAG N} {VC : Finset (Fin N)} {c ℓ : ℕ} {s : ℚ} {D k : ℕ}
    (h : ChainHard' G VC c ℓ s D k) : ChainHard G VC c ℓ s D k := fun P₀ hs =>
  lt_of_le_of_lt (Finset.card_le_card fun v hv => by
    rw [Finset.mem_filter] at hv ⊢; exact ⟨hv.1, (reach_le_reach' G P₀ D).1 hv.2⟩) (h P₀ hs)

/-! ### The chain clock survives the key rule -/

section Seeds

variable (G : TopoDAG N) (P₀ : ChainKnow N)

theorem seed_of_lab {v : Fin N} (hv : v ∈ P₀.labs) : v ∈ P₀.seeds G := by
  unfold ChainKnow.seeds; exact Finset.mem_union_left _ (Finset.mem_union_left _ hv)

theorem seed_of_heldH {v : Fin N} (hv : v ∈ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst) : v ∈ P₀.seeds G := by
  unfold ChainKnow.seeds; exact Finset.mem_union_left _ (Finset.mem_union_right _ hv)

theorem seed_of_padR {v : Fin N} (hv : (v, ovCalls G v) ∈ P₀.rs) : v ∈ P₀.seeds G := by
  unfold ChainKnow.seeds; exact Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨_, hv, by simp⟩)

theorem seed_of_blockR {p : Fin N × ℕ} {u : Fin N} (hp : p ∈ P₀.rs) (hb : ovBlock G p.1 p.2 = some u) :
    u ∈ P₀.seeds G := by
  unfold ChainKnow.seeds
  refine Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨p, hp, ?_⟩)
  have hne : p.2 ≠ ovCalls G p.1 := fun h => by rw [h, ovBlock_pad] at hb; simp at hb
  simp [hne, hb]

end Seeds

/-- **The clock invariant with the key rule.** After `t` rounds from `P₀`, on a row with no held chaining value:
1. a known `h_{v,j}` has `j ≤ t`;
2. a known `r_{v,j}` that was not held has `j ≤ t`, **or is the pad `r` of a seed row** (the key rule's addition);
3. every known label is a seed of `P₀` or its row has at most `t` calls;
4. a known `r` that was not held has its call's block known. -/
theorem clock_invariant' (G : TopoDAG N) (P₀ : ChainKnow N) : ∀ t,
    (∀ p ∈ (reach' G P₀ t).hs, p.2 ≠ 0 →
        p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst → p.2 ≤ t) ∧
    (∀ p ∈ (reach' G P₀ t).rs, p ∉ P₀.rs → p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst →
        p.2 ≤ t ∨ (p.2 = ovCalls G p.1 ∧ p.1 ∈ P₀.seeds G)) ∧
    (∀ v ∈ (reach' G P₀ t).labs, v ∈ P₀.seeds G ∨ ovCalls G v ≤ t) ∧
    (∀ p ∈ (reach' G P₀ t).rs, p ∉ P₀.rs → ∀ u, ovBlock G p.1 p.2 = some u → u ∈ (reach' G P₀ t).labs) := by
  intro t
  induction t with
  | zero =>
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro p hp h0 hH
      exact absurd (Finset.mem_image.2 ⟨p, Finset.mem_filter.2 ⟨hp, h0⟩, rfl⟩) hH
    · intro p hp hn _
      rcases (mem_read'_rs G P₀ p).1 hp with hp | ⟨v, hv, rfl⟩
      · exact absurd hp hn
      · exact Or.inr ⟨rfl, seed_of_lab G P₀ hv⟩
    · intro v hv
      rcases (mem_read'_labs G P₀ v).1 hv with hv | hv
      · exact Or.inl (seed_of_lab G P₀ hv)
      · exact Or.inl (seed_of_padR G P₀ hv)
    · intro p hp hn u hb
      rcases (mem_read'_rs G P₀ p).1 hp with hp | ⟨v, -, rfl⟩
      · exact absurd hp hn
      · rw [ovBlock_pad] at hb; exact absurd hb (by simp)
  | succ t ih =>
    obtain ⟨ih1, ih2, ih3, ih4⟩ := ih
    set K := reach' G P₀ t with hK
    have hKs : reach' G P₀ (t + 1) = round' G K := rfl
    set H := (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst
    have hcall : ∀ p : Fin N × ℕ, K.canCall G p.1 p.2 → p.1 ∉ H → p.2 ≤ t + 1 := by
      rintro p ⟨hj1, -, -, hprev⟩ hH
      rcases hprev with h1 | hprev
      · omega
      · by_cases h0 : p.2 - 1 = 0
        · omega
        · have := ih1 _ hprev h0 hH
          simp only at this
          omega
    -- labels of the round before its read: seeds or short rows
    have hlab1 : ∀ u, (u ∈ K.labs ∨ ∃ p ∈ K.hs, p ∈ K.rs ∧ ovBlock G p.1 p.2 = some u) →
        u ∈ P₀.seeds G ∨ ovCalls G u ≤ t + 1 := by
      rintro u (hu | ⟨p, -, hpr, hb⟩)
      · rcases ih3 u hu with h | h
        · exact Or.inl h
        · exact Or.inr (by omega)
      · by_cases hn : p ∈ P₀.rs
        · exact Or.inl (seed_of_blockR G P₀ hn hb)
        · rcases ih3 u (ih4 p hpr hn u hb) with h | h
          · exact Or.inl h
          · exact Or.inr (by omega)
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro p hp h0 hH
      rw [hKs, mem_round'_hs] at hp
      rcases hp with hp | ⟨-, hc | ⟨-, hnext, -⟩⟩
      · have := ih1 p hp h0 hH; omega
      · exact hcall p hc hH
      · have := ih1 _ hnext (by simp) hH
        simp only at this
        omega
    · intro p hp hn hH
      rw [hKs, mem_round'_rs] at hp
      rcases hp with (hp | ⟨-, hc⟩) | ⟨v, hv, rfl⟩
      · rcases ih2 p hp hn hH with h | h
        · exact Or.inl (by omega)
        · exact Or.inr h
      · exact Or.inl (hcall p hc hH)
      · rcases hlab1 v hv with h | h
        · exact Or.inr ⟨rfl, h⟩
        · exact Or.inl h
    · intro v hv
      rw [hKs, mem_round'_labs] at hv
      rcases hv with hv | (hv | ⟨-, hc⟩)
      · exact hlab1 v hv
      · by_cases hn : (v, ovCalls G v) ∈ P₀.rs
        · exact Or.inl (seed_of_padR G P₀ hn)
        · by_cases hH : v ∈ H
          · exact Or.inl (seed_of_heldH G P₀ hH)
          · rcases ih2 _ hv hn hH with h | h
            · exact Or.inr (by simp only at h; omega)
            · exact Or.inl h.2
      · by_cases hH : v ∈ H
        · exact Or.inl (seed_of_heldH G P₀ hH)
        · exact Or.inr (hcall (v, ovCalls G v) hc hH)
    · intro p hp hn u hb
      rw [hKs]
      rw [hKs, mem_round'_rs] at hp
      rcases hp with (hp | ⟨-, hc⟩) | ⟨v, -, rfl⟩
      · exact (mem_round'_labs G K u).2 (Or.inl (Or.inl (ih4 p hp hn u hb)))
      · exact (mem_round'_labs G K u).2 (Or.inl (Or.inl (hc.2.2.1 u hb)))
      · rw [ovBlock_pad] at hb; exact absurd hb (by simp)

/-- **The chain clock with the key rule.** -/
theorem chain_clock' (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) (v : Fin N) (hv : v ∈ (reach' G P₀ t).labs) :
    v ∈ P₀.seeds G ∨ ovCalls G v ≤ t :=
  (clock_invariant' G P₀ t).2.2.1 v hv

/-- **The weighted chain certificate with the key rule.** -/
theorem weighted_chain_cert' (G : TopoDAG N) (VC : Finset (Fin N)) (c ℓ : ℕ) (s : ℚ) (D k : ℕ)
    (hk : s + (shortRows G VC D).card < k) : ChainHard' G VC c ℓ s D k := by
  intro P₀ hsize
  have hsub : VC.filter (fun v => v ∈ (reach' G P₀ D).labs) ⊆ P₀.seeds G ∪ shortRows G VC D := by
    intro v hv
    rw [Finset.mem_filter] at hv
    rcases chain_clock' G P₀ D v hv.2 with h | h
    · exact Finset.mem_union_left _ h
    · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hv.1, h⟩)
  have h1 := (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
  have h2 := (card_seeds_le_size G c ℓ P₀).trans hsize
  have h3 : ((VC.filter fun v => v ∈ (reach' G P₀ D).labs).card : ℚ) < k :=
    calc ((VC.filter fun v => v ∈ (reach' G P₀ D).labs).card : ℚ)
        ≤ ((P₀.seeds G).card : ℚ) + (shortRows G VC D).card := by exact_mod_cast h1
      _ ≤ s + (shortRows G VC D).card := by linarith
      _ < k := hk
  exact_mod_cast h3

end KeyRule

open KeyRule
open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal

/-! ### The band results against `ChainHard'` -/

/-- **`BandChainHard` with the key rule**, at the same parameters. -/
theorem band_chain_hard' (B d D c ℓ : ℕ) (hd : D ≤ d) (hB : D + 1 ≤ B) :
    ChainHard' (bandDAG B d) Finset.univ c ℓ ((B - D - 1 : ℕ) : ℚ) D B := by
  refine weighted_chain_cert' (bandDAG B d) Finset.univ c ℓ _ D B ?_
  have hc := card_shortRows_band B d D hd (by omega)
  have h : B - D - 1 + (shortRows (bandDAG B d) Finset.univ D).card < B := by omega
  exact_mod_cast h

/-- **Dense hardness with the key rule**, at the same parameters. -/
theorem chainDense_hard' (B D c ℓ : ℕ) (hD : D + 1 ≤ B) :
    ChainHard' (Dense.completeDAG B) Finset.univ c ℓ ((B - D - 1 : ℕ) : ℚ) D B := by
  refine weighted_chain_cert' (Dense.completeDAG B) Finset.univ c ℓ _ D B ?_
  have hc := card_shortRows_le (Dense.completeDAG B) D
    (fun _ _ _ huv _ => Finset.mem_filter.2 ⟨Finset.mem_univ _, huv⟩)
  have h : B - D - 1 + (shortRows (Dense.completeDAG B) Finset.univ D).card < B := by omega
  exact_mod_cast h

/-- **The gap attack still works**: with `d + 1 ≤ D`, the band is not hard with the key rule either. -/
theorem band_gap_attack' (B d D c ℓ : ℕ) (hdD : d + 1 ≤ D) :
    ¬ ChainHard' (bandDAG B d) Finset.univ c ℓ ((B - (B - 1) / (d + 1) : ℕ) : ℚ) D B :=
  fun h => band_gap_attack B d D c ℓ hdD h.toChainHard

theorem band_gap_attack_512' (c ℓ : ℕ) :
    ¬ ChainHard' (bandDAG 512 4) Finset.univ c ℓ ((512 - 5 - 1 : ℕ) : ℚ) 5 512 :=
  fun h => band_gap_attack_512 c ℓ h.toChainHard

theorem band_needs_room' (c ℓ : ℕ) : ¬ ChainHard' (bandDAG 1 1) Finset.univ c ℓ ((1 - 1 - 1 : ℕ) : ℚ) 1 1 :=
  fun h => band_needs_room c ℓ h.toChainHard

/-- The deployment point: `d = D = 5`, `B = 512`. -/
theorem band_hard_512' (c ℓ : ℕ) :
    ChainHard' (bandDAG 512 5) Finset.univ c ℓ ((512 - 5 - 1 : ℕ) : ℚ) 5 512 :=
  band_chain_hard' 512 5 5 c ℓ le_rfl (by norm_num)

/-- **The `d = 12` margin with the key rule**: hardness for every `D ≤ 12`. -/
theorem band_d12_margin' (c ℓ D : ℕ) (hD : D ≤ 12) :
    ChainHard' (bandDAG 512 12) Finset.univ c ℓ ((512 - D - 1 : ℕ) : ℚ) D 512 :=
  band_chain_hard' 512 12 D c ℓ hD (by omega)

/-- **The cliffs do not move**: at `D = d + 1` hardness fails, as without the key rule. -/
theorem band_cliff_d5' (c ℓ : ℕ) :
    ¬ ChainHard' (bandDAG 512 5) Finset.univ c ℓ ((512 - 6 - 1 : ℕ) : ℚ) 6 512 :=
  fun h => band_cliff_d5 c ℓ h.toChainHard

theorem band_cliff_d12' (c ℓ : ℕ) :
    ¬ ChainHard' (bandDAG 512 12) Finset.univ c ℓ ((512 - 13 - 1 : ℕ) : ℚ) 13 512 :=
  fun h => band_cliff_d12 c ℓ h.toChainHard

/-! ### The target with the key rule, and the deployment -/

/-- `ChainExPostFactoG` with `ChainHard'` as its hardness hypothesis. -/
def ChainExPostFactoG' : Prop :=
  ∀ (B ℓ c m s D Q k : ℕ) (G : TopoDAG B) (dom : ℕ → Bits c) (Wb : Fin B → Bits ℓ),
    Function.Injective (fun i : Fin B => dom i) → ChainHard' G Finset.univ c ℓ s D k →
    ∀ (A₁ : Equiv.Perm (Bits (ℓ + (ℓ + c))) → Bits m)
      (A₂ : Bits m → Fin B → Pous.Prog (idealPerm (ℓ + (ℓ + c))) (Bits ℓ)),
      (∀ σ i, (A₂ σ i).Bounded D Q) →
      pr (fun π : Equiv.Perm (Bits (ℓ + (ℓ + c))) =>
          k ≤ (Finset.univ.filter fun i =>
            (A₂ (A₁ π) i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG G π dom Wb i).card)
        ≤ 2 ^ m * 2 * ((((nPos B Q) ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * s) +
          (((nPos B Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c)

/-- **The change weakens the target**: the old `ChainExPostFactoG` implies the new one. -/
theorem chainExPostFactoG'_of_chainExPostFactoG (h : ChainExPostFactoG) : ChainExPostFactoG' :=
  fun B ℓ c m s D Q k G dom Wb hdom hhard A₁ A₂ hA => h B ℓ c m s D Q k G dom Wb hdom hhard.toChainHard A₁ A₂ hA

/-- `band_timedINC`, from `ChainExPostFactoG'` and `band_chain_hard'`. -/
theorem band_timedINC' (hepf : ChainExPostFactoG') (B d ℓ c D Q β : ℕ) [NeZero B] (dom : ℕ → Bits c)
    (hd : D ≤ d) (hD : D + 1 ≤ B) (hdom : Function.Injective (fun i : Fin B => dom i)) :
    TimedINC (chainBand B d ℓ c dom) D Q β (chainPi B ℓ c D Q β) := by
  classical
  intro W cmp exp hexp
  have hE := hepf B ℓ c β (B - D - 1) D Q B (bandDAG B d) dom (Dense.blocks B ℓ W) hdom
    (band_chain_hard' B d D c ℓ hd hD)
    (fun π => cmp W (fun i => i.elim0)
      (fun i => labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom
        (Dense.blocks B ℓ W) i) π)
    (fun σ i => exp W (fun i => i.elim0) σ i) (fun σ i => hexp W _ σ i)
  refine le_trans (le_of_eq_of_le (PousThm1Dense.pr_fst (β := Unit)
    (fun π : Equiv.Perm (Bits (ℓ + (ℓ + c))) =>
      ∀ i, (exp W (fun i => i.elim0)
        (cmp W (fun i => i.elim0)
          (fun i => labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom
            (Dense.blocks B ℓ W) i) π)
        i).run ((idealPerm (ℓ + (ℓ + c))).answer π) =
        labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom (Dense.blocks B ℓ W) i))
    (pr_mono fun π hH => ?_)) hE
  refine le_trans (le_of_eq (by rw [Finset.card_univ, Fintype.card_fin]))
    (Finset.card_le_card (s := Finset.univ) fun c _ => Finset.mem_filter.2 ⟨Finset.mem_univ _, hH c⟩)

/-- **`BandMeets64` with the key rule**, at the same numbers (`k = 111`, `β = 265253616`, `D = 5`, every `d ≥ 5`). -/
theorem band_meets_64' (hepf : ChainExPostFactoG') (d : ℕ) (hd : 5 ≤ d) : ChainBandMeets64 d := by
  intro salt
  refine ⟨le_rfl, chainScheme_correct _ _ _ _, le_rfl, ?_, ?_⟩
  · show ((((2 ^ 9) * 524288 + 0 : ℕ)) : ℚ) ≤ Pous.Params.expansion * (((2 ^ 9) * 524288 : ℕ) : ℚ)
    norm_num [Pous.Params.expansion]
  · intro W A₁ A₂
    have hINC := band_timedINC' hepf (2 ^ 9) d 524288 512 5 (2 ^ 20) 265253616 (Pous.Sponge.dom salt) hd
      (by norm_num) (dom_inj salt (by norm_num))
    refine (PousTargetsDense.theorem1_ii_seq (chainBand (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)) 5 (2 ^ 20)
      265253616 ((chainBand (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)).stateBound Pous.Params.ρ) 111 _
      hINC W A₁ A₂).trans ?_
    rw [stateBound_band_64, add_comm]
    exact add_le_add chain_sampling_term_64 chain_union_term_64

theorem band_meets_64_d12' (hepf : ChainExPostFactoG') : ChainBandMeets64 12 := band_meets_64' hepf 12 (by norm_num)


