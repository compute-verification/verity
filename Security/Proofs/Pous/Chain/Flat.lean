/-! ## Satisfiability witnesses -/

/-- **`P3ChainHard` is satisfiable with `X + 1 ≤ k`**: at `D = 0` nothing is computed, so `k` known tops are `k` held
tops, `k·n` columns. -/
theorem p3ChainHard_zero {n : ℕ} (G : TopoDAG n) (c wc k : ℕ) : P3ChainHard G c wc 0 k 0 := by
  intro K₀ hk
  simp only [P3ChainKnow.reach] at hk
  have hk' : (k : ℚ) ≤ K₀.tops.card := by exact_mod_cast hk
  have hn : (0 : ℚ) ≤ n := by positivity
  have h1 : (0 : ℚ) ≤ ((n : ℚ) + (c : ℚ) / wc) * (K₀.hs.filter fun p => p.2.2 ≠ 0).card := by positivity
  have h2 : (0 : ℚ) ≤ (n : ℚ) * K₀.rs.card := by positivity
  have h3 : (0 : ℚ) ≤ K₀.cols.card := by positivity
  unfold P3ChainKnow.size
  rw [Nat.sub_zero]
  nlinarith [mul_le_mul_of_nonneg_left hk' hn]

/-- **The side conditions of `P3ChainEPF` at the deployment point**: `n = 220 > 0`, `wc = 2384 > 0`, `X + 1 ≤ k`
at `X = 1`, `k = 220`. Its remaining hypothesis there is `P3ChainCert` (target). -/
theorem p3ChainEPF_hyps_64 : 0 < 220 ∧ 0 < 2384 ∧ 220 ≤ 2 ^ 255 ∧ 2 * nPosC 220 (2 ^ 20) ≤ 2 ^ 2384 ∧
    (2 * nPosC 220 (2 ^ 20)) ^ 40 ≤ 2 ^ 2384 ∧ 1 + 1 ≤ 220 :=
  ⟨by norm_num, by norm_num, by norm_num, c1_64, c2_64, by norm_num⟩

/-- **The side conditions of `P3ChainEPFMulti` at the deployment point**, including injective tags. -/
theorem p3ChainEPFMulti_hyps_64 (salt : Bits 192) :
    0 < 220 ∧ 0 < 2384 ∧ 220 ≤ 2 ^ 255 ∧ 2 * (971 * nPosC 220 (2 ^ 20)) ≤ 2 ^ 2384 ∧
      (2 * (971 * nPosC 220 (2 ^ 20))) ^ 40 ≤ 2 ^ 2384 ∧ 1 ≤ 971 ∧ 1 + 1 ≤ 220 ∧
      Function.Injective fun s : Fin 971 => tagR salt s.val :=
  ⟨by norm_num, by norm_num, by norm_num, c1_multi_64 (by norm_num), c2_64_multi (by norm_num), by norm_num, by norm_num,
    tagR_injective 971 (by norm_num) salt⟩

/-- **Both targets' hypotheses are jointly satisfiable with a non-trivial `X + 1 ≤ k`** (`D = 0`). -/
theorem p3ChainEPF_hyps_sat : ∃ (n wc D Q k X : ℕ) (G : TopoDAG n), 0 < n ∧ 0 < wc ∧ n ≤ 2 ^ 255 ∧
    2 * nPosC n Q ≤ 2 ^ wc ∧ (2 * nPosC n Q) ^ 40 ≤ 2 ^ wc ∧ X + 1 ≤ k ∧ k ≤ n ∧ P3ChainHard G 512 wc D k X :=
  ⟨220, 2384, 0, 2 ^ 20, 220, 0, Pous.P3Column.bandGraph 220 12, by norm_num, by norm_num, by norm_num, c1_64, c2_64,
    by norm_num, le_rfl, p3ChainHard_zero _ _ _ _⟩

/-! ## The side condition `n ≤ 2^255` is needed -/

/-- **Rows `v` and `v + 2^255` share their domain**: `domP3` keeps the low 256 bits of `2v + L`. -/
theorem domP3_shift (tag : Bits 256) (L : Fin 2) (v : ℕ) : domP3 tag L (v + 2 ^ 255) = domP3 tag L v := by
  unfold domP3
  congr 1
  funext j
  have hj : j.val < 256 := j.isLt
  have key : ∀ x : ℕ, x.testBit j = (x % 2 ^ 256).testBit j := by
    intro x
    rw [Nat.testBit_mod_two_pow]
    simp [hj]
  rw [key (2 * (v + 2 ^ 255) + L.val), key (2 * v + L.val)]
  congr 1
  rw [show 2 * (v + 2 ^ 255) + L.val = 2 * v + L.val + 2 ^ 256 by ring, Nat.add_mod_right]

/-- **Above `2^255`, the domain encoding is not injective**: rows `0` and `2^255` collide. -/
theorem not_injective_domP3 (tag : Bits 256) (L : Fin 2) {n : ℕ} (hn : 2 ^ 255 < n) :
    ¬ Function.Injective fun v : Fin n => domP3 tag L v.val := by
  intro h
  have := @h ⟨0, by positivity⟩ ⟨2 ^ 255, hn⟩ (by simpa using (domP3_shift tag L 0).symm)
  simp [Fin.ext_iff] at this

/-- **At or below `2^255`, the domain encoding is injective** (on `(L, v)`, since `2v + L < 2^256`). -/
theorem injective_domP3 (tag : Bits 256) {n : ℕ} (hn : n ≤ 2 ^ 255) :
    Function.Injective fun p : Fin 2 × Fin n => domP3 tag p.1 p.2.val := by
  intro p q h
  have h' : domP3 tag p.1 p.2.val = domP3 tag q.1 q.2.val := h
  have hb : ∀ j : Fin 256, (2 * p.2.val + p.1.val).testBit j = (2 * q.2.val + q.1.val).testBit j := by
    intro j
    have := congrFun h' (Fin.natAdd 256 j)
    unfold domP3 at this
    rwa [Fin.append_right, Fin.append_right] at this
  have hlt : ∀ x : Fin 2 × Fin n, 2 * x.2.val + x.1.val < 2 ^ 256 := by
    intro x
    have := x.2.isLt
    have := x.1.isLt
    have : (2 : ℕ) ^ 256 = 2 * 2 ^ 255 := by norm_num
    omega
  have heq : 2 * p.2.val + p.1.val = 2 * q.2.val + q.1.val := by
    refine Nat.eq_of_testBit_eq fun j => ?_
    by_cases hj : j < 256
    · exact hb ⟨j, hj⟩
    · rw [Nat.testBit_lt_two_pow ((hlt p).trans_le (Nat.pow_le_pow_right (by norm_num) (by omega))),
        Nat.testBit_lt_two_pow ((hlt q).trans_le (Nat.pow_le_pow_right (by norm_num) (by omega)))]
  have h1 : p.1.val = q.1.val := by have := p.1.isLt; have := q.1.isLt; omega
  have h2 : p.2.val = q.2.val := by have := p.1.isLt; have := q.1.isLt; omega
  exact Prod.ext (Fin.ext h1) (Fin.ext h2)

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3Trace ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Transcripts of a program (copied from `dense/DenseMeets.lean`, `PousB5Chain` §Trace)

Byte-for-byte copy of the generic trace section (`trace`, `AgreeBefore`, `trace_stable`, `run_stable`, …), under
the namespace `Pous.P3Concrete.Tr`: `DenseMeets` cannot be imported beside `Thm1.Theorem1iiSeq` (both define
`PousThm1Chain.progMap`).
-/

namespace Pous.P3Concrete.Tr

open Pous Pous.Labelling
open scoped ENNReal

section Trace

variable {M : IdealModel} {α : Type}

/-- The queries on the path taken when queries are answered by `f`, in order, each with its round (from 0). -/
def trace (f : M.Qry → M.Ans) : Prog M α → List (ℕ × M.Qry)
  | .ret _ => []
  | .round qs k => qs.map (fun x => (0, x)) ++ (trace f (k (qs.map f))).map fun e => (e.1 + 1, e.2)

theorem length_trace (f : M.Qry → M.Ans) (P : Prog M α) : (trace f P).length = P.work f := by
  induction P with
  | ret a => rfl
  | round qs k ih => simp [trace, Prog.work, ih]

theorem round_lt_depth (f : M.Qry → M.Ans) (P : Prog M α) : ∀ e ∈ trace f P, e.1 < P.depth f := by
  induction P with
  | ret a => simp [trace]
  | round qs k ih =>
    intro e he
    simp only [trace, List.mem_append, List.mem_map] at he
    simp only [Prog.depth]
    rcases he with ⟨x, _, rfl⟩ | ⟨e', he', rfl⟩
    · simp
    · have := ih _ e' he'
      simp only
      omega

/-- `f` and `g` agree on every point that `P` asks, under `f`, before round `r`. -/
def AgreeBefore (f g : M.Qry → M.Ans) (P : Prog M α) (r : ℕ) : Prop :=
  ∀ e ∈ trace f P, e.1 < r → f e.2 = g e.2

theorem mem_trace_round (f : M.Qry → M.Ans) (qs : List M.Qry) (k : List M.Ans → Prog M α) (x : M.Qry)
    (hx : x ∈ qs) : (0, x) ∈ trace f (.round qs k) := by
  simp only [trace, List.mem_append, List.mem_map]
  exact Or.inl ⟨x, hx, rfl⟩

theorem mem_trace_round_succ (f : M.Qry → M.Ans) (qs : List M.Qry) (k : List M.Ans → Prog M α)
    (e : ℕ × M.Qry) (he : e ∈ trace f (k (qs.map f))) : (e.1 + 1, e.2) ∈ trace f (.round qs k) := by
  simp only [trace, List.mem_append, List.mem_map]
  exact Or.inr ⟨e, he, rfl⟩

theorem agree_round {f g : M.Qry → M.Ans} {qs : List M.Qry} {k : List M.Ans → Prog M α} {r : ℕ}
    (h : AgreeBefore f g (.round qs k) (r + 1)) :
    qs.map f = qs.map g ∧ AgreeBefore f g (k (qs.map f)) r :=
  ⟨List.map_congr_left fun x hx => h (0, x) (mem_trace_round f qs k x hx) (Nat.succ_pos r),
    fun e he hlt => h (e.1 + 1, e.2) (mem_trace_round_succ f qs k e he) (by omega)⟩

/-- **Transcript locality.** If `f` and `g` agree on the points asked before round `r`, then the transcripts agree,
entry by entry, up to round `r`; and every entry of `g`'s transcript up to round `r` is one of `f`'s. -/
theorem trace_stable (f g : M.Qry → M.Ans) (P : Prog M α) : ∀ r : ℕ, AgreeBefore f g P r →
    (∀ (n : ℕ) (e : ℕ × M.Qry), (trace f P)[n]? = some e → e.1 ≤ r → (trace g P)[n]? = some e) ∧
    (∀ e ∈ trace g P, e.1 ≤ r → e ∈ trace f P) := by
  induction P with
  | ret a => intro r _; simp [trace]
  | round qs k ih =>
    intro r hag
    cases r with
    | zero =>
      constructor
      · intro n e hn he
        simp only [trace] at hn ⊢
        by_cases hlt : n < qs.length
        · rw [List.getElem?_append_left (by simpa using hlt)] at hn ⊢
          exact hn
        · rw [List.getElem?_append_right (by simpa using not_lt.1 hlt), List.getElem?_map,
            List.length_map] at hn
          cases hk : (trace f (k (qs.map f)))[n - qs.length]? with
          | none => rw [hk] at hn; simp at hn
          | some e' =>
            simp only [hk, Option.map_some, Option.some.injEq] at hn
            subst hn
            simp at he
      · intro e he he0
        simp only [trace, List.mem_append, List.mem_map] at he ⊢
        rcases he with ⟨x, hx, rfl⟩ | ⟨e', _, rfl⟩
        · exact Or.inl ⟨x, hx, rfl⟩
        · simp at he0
    | succ r =>
      obtain ⟨hqs, hag'⟩ := agree_round hag
      obtain ⟨ih1, ih2⟩ := ih (qs.map f) r hag'
      constructor
      · intro n e hn he
        simp only [trace] at hn ⊢
        rw [← hqs]
        by_cases hlt : n < qs.length
        · rw [List.getElem?_append_left (by simpa using hlt)] at hn ⊢
          exact hn
        · rw [List.getElem?_append_right (by simpa using not_lt.1 hlt), List.getElem?_map,
            List.length_map] at hn ⊢
          cases hk : (trace f (k (qs.map f)))[n - qs.length]? with
          | none => rw [hk] at hn; simp at hn
          | some e' =>
            simp only [hk, Option.map_some, Option.some.injEq] at hn
            subst hn
            rw [ih1 _ e' hk (by simp only at he; omega)]
            rfl
      · intro e he her
        simp only [trace, List.mem_append, List.mem_map] at he ⊢
        rw [← hqs] at he
        rcases he with ⟨x, hx, rfl⟩ | ⟨e', he', rfl⟩
        · exact Or.inl ⟨x, hx, rfl⟩
        · exact Or.inr ⟨e', ih2 e' he' (by simp only at her; omega), rfl⟩

/-- **Output locality.** A program that stops by round `r` returns the same output, at the same depth, under any
oracle that agrees with `f` on the points asked before round `r`. -/
theorem run_stable (f g : M.Qry → M.Ans) (P : Prog M α) : ∀ r : ℕ, AgreeBefore f g P r → P.depth f ≤ r →
    P.run g = P.run f ∧ P.depth g = P.depth f := by
  induction P with
  | ret a => intro _ _ _; exact ⟨rfl, rfl⟩
  | round qs k ih =>
    intro r hag hd
    cases r with
    | zero => simp [Prog.depth] at hd
    | succ r =>
      obtain ⟨hqs, hag'⟩ := agree_round hag
      have hd' : (k (qs.map f)).depth f ≤ r := by simp only [Prog.depth] at hd; omega
      obtain ⟨h1, h2⟩ := ih (qs.map f) r hag' hd'
      simp only [Prog.run, Prog.depth, ← hqs]
      exact ⟨h1, by rw [h2]⟩

theorem work_le_depth_mul_width (f : M.Qry → M.Ans) (P : Prog M α) : P.work f ≤ P.depth f * P.width f := by
  induction P with
  | ret a => simp [Prog.work]
  | round qs k ih =>
    simp only [Prog.work, Prog.depth, Prog.width]
    have h1 := ih (qs.map f)
    have h2 : (k (qs.map f)).depth f * (k (qs.map f)).width f ≤
        (k (qs.map f)).depth f * max qs.length ((k (qs.map f)).width f) :=
      Nat.mul_le_mul_left _ (le_max_right _ _)
    have h3 : qs.length ≤ max qs.length ((k (qs.map f)).width f) := le_max_left _ _
    rw [Nat.succ_mul]
    omega

end Trace

end Pous.P3Concrete.Tr

end


/-! ════ P3Concrete.P3ChainReplay ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# P3 over the chain: the honest chain points, and the replay of an adversary

The honest computation of one segment, written point by point.
- **Rows.** Row `(L, v)` absorbs its parents' labels (newest first) and then the pad. Its call `p` has input
  `xin L v p = block_p ‖ h_{p−1}`. The chaining value after it is `hval L v p = ovH (Π₂ (xin L v p))`, and its dropped
  part is `rval L v p`. The key is `rval` of the pad call.
- **Labels.** `c¹_w = P_{(tag,0,w)}(pin1 w)` with `pin1 w = W_w ⊕ key¹_w`, and `c²_u = P_{(tag,1,u)}(pin2 u)` with
  `pin2 u = transpose(c¹)_u ⊕ key²_u` (`c1_eq`, `c2_eq`).
- **The replay.** It is the programs of one segment and their transcripts. A query reveals a `Π₂` point (forward `x`,
  inverse `Π₂⁻¹ y`) or a `P` point (`(T, a)`, or `(T, P_T⁻¹ z)`). It shows in the clear its payload: a block and a
  chaining value (`Π₂` forward), a dropped part and a chaining value (`Π₂⁻¹`), a `P` input (`P_T`), or a label
  (`P_T⁻¹`). A program's output shows a label.
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge

/-! ## The overwrite chain, point by point -/

section ChainPts

variable {r c : ℕ}

/-- The chain state after the first `j` blocks. -/
def stAfter (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r)) (j : ℕ) :
    Bits r × Bits (r + c) :=
  (blks.take j).foldl (ovStep f) (fun _ => false, h₀)

/-- The input of call `p` (from 1): block `p` next to the chaining value after `p − 1` calls. -/
def xinAt (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r)) (p : ℕ) :
    Bits (r + (r + c)) :=
  Fin.append (blks.getD (p - 1) padBlk) (stAfter f h₀ blks (p - 1)).2

theorem getD_of_lt {α : Type} (l : List α) (d : α) {i : ℕ} (h : i < l.length) : l.getD i d = l[i] := by
  simp [List.getD, List.getElem?_eq_getElem h]

theorem ovR_append (b : Bits r) (h : Bits (r + c)) : ovR (Fin.append b h) = b := by
  funext j
  simp [ovR, Fin.append_left]

theorem ovH_append (b : Bits r) (h : Bits (r + c)) : ovH (Fin.append b h) = h := by
  funext j
  simp [ovH, Fin.append_right]

theorem stAfter_succ (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r))
    {j : ℕ} (hj : j < blks.length) :
    stAfter f h₀ blks (j + 1) = ovStep f (stAfter f h₀ blks j) blks[j] := by
  unfold stAfter
  rw [List.take_add_one, List.getElem?_eq_getElem hj, Option.toList_some, List.foldl_append]
  rfl

theorem xinAt_ovR (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r)) (p : ℕ) :
    ovR (xinAt f h₀ blks p) = blks.getD (p - 1) padBlk :=
  ovR_append _ _

/-- The chaining value shown in call `p + 1`'s input is the output of call `p`. -/
theorem xinAt_ovH_succ (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r))
    {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ blks.length) :
    ovH (xinAt f h₀ blks (p + 1)) = ovH (f (xinAt f h₀ blks p)) := by
  unfold xinAt
  rw [ovH_append, Nat.add_sub_cancel, show p = (p - 1) + 1 by omega, stAfter_succ f h₀ blks (by omega)]
  simp only [ovStep, Nat.add_sub_cancel]
  rw [getD_of_lt _ _ (by omega)]

/-- **The key is the dropped part of the last call.** -/
theorem ovKey_eq_xinAt (f : Bits (r + (r + c)) → Bits (r + (r + c))) (dom : Bits c) (blks : List (Bits r))
    (hne : blks ≠ []) : ovKey f dom blks = ovR (f (xinAt f (iv dom) blks blks.length)) := by
  have hl : 0 < blks.length := List.length_pos_iff.2 hne
  have h1 : ovKey f dom blks = (stAfter f (iv dom) blks ((blks.length - 1) + 1)).1 := by
    unfold ovKey ovAbsorb stAfter
    rw [Nat.sub_add_cancel hl, List.take_length]
  rw [h1, stAfter_succ f (iv dom) blks (by omega)]
  unfold xinAt
  rw [getD_of_lt _ _ (by omega)]
  rfl

end ChainPts

/-! ## P3's rows -/

section Rows

variable {n wc : ℕ}

/-- Row `v`'s blocks under the labels `lab`: its parents' labels newest first, then the pad. -/
def rowBlocks (lab : Fin n → Lab n wc) (G : TopoDAG n) (v : Fin n) : List (Bits (n * wc)) :=
  (parentsDesc G v).map (fun u => codeEquiv n wc (lab u)) ++ [padBlk]

theorem rowBlocks_length (lab : Fin n → Lab n wc) (G : TopoDAG n) (v : Fin n) :
    (rowBlocks lab G v).length = ovCalls G v := by
  simp [rowBlocks, ovCalls]

theorem rowBlocks_getD (lab : Fin n → Lab n wc) (G : TopoDAG n) (v : Fin n) {p : ℕ} {u : Fin n}
    (hb : ovBlock G v p = some u) : (rowBlocks lab G v).getD (p - 1) padBlk = codeEquiv n wc (lab u) := by
  unfold ovBlock at hb
  have hlt : p - 1 < (parentsDesc G v).length := by
    by_contra h
    rw [List.getElem?_eq_none (by omega)] at hb
    exact absurd hb (by simp)
  rw [List.getElem?_eq_getElem hlt, Option.some_inj] at hb
  unfold rowBlocks
  rw [getD_of_lt _ _ (by simp; omega), List.getElem_append_left (by simpa using hlt), List.getElem_map, hb]

theorem ovCalls_le (G : TopoDAG n) (v : Fin n) : ovCalls G v ≤ n := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]
  have : (G.par v).card ≤ v.val := by
    calc (G.par v).card ≤ ((Finset.range v.val).attachFin (fun m hm => by
          have := (Finset.mem_range.1 hm); omega)).card := Finset.card_le_card fun u hu => by
            simp only [Finset.mem_attachFin, Finset.mem_range]
            exact G.par_lt v u hu
      _ = v.val := by simp
  omega

end Rows

/-! ## The replay -/

/-- **One segment's replay**: tag, graph and data, the round and query budget, and the online programs over any index. -/
structure P3Replay (n wc : ℕ) (ι : Type) where
  tag : Bits 256
  G : TopoDAG n
  W : Fin n → Lab n wc
  D : ℕ
  Q : ℕ
  /-- The online programs, over any program index (one segment: `Fin n`; all segments in lock-step: `Fin N × Fin n`). -/
  A : ι → Prog (p3ChainModel n wc) (Lab n wc)

namespace P3Replay

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) (ω : P3COmega n wc)

/-- The lower labels. -/
def c1 : Fin n → Lab n wc := c1c R.tag R.G ω.2 ω.1 R.W

/-- The top labels. -/
def c2 : Fin n → Lab n wc := c2c R.tag R.G ω.2 ω.1 R.W

/-- The labels of layer `L`. -/
def lab (L : Fin 2) : Fin n → Lab n wc := if L = 0 then R.c1 ω else R.c2 ω

/-- The input of call `p` of row `(L, v)`. -/
def xin (L : Fin 2) (v : Fin n) (p : ℕ) : Bits (n * wc + (n * wc + 512)) :=
  xinAt ω.2 (iv (domP3 R.tag L v)) (rowBlocks (R.lab ω L) R.G v) p

/-- The chaining value after call `p` of row `(L, v)`. -/
def hval (L : Fin 2) (v : Fin n) (p : ℕ) : Bits (n * wc + 512) := ovH (ω.2 (R.xin ω L v p))

/-- The dropped part of call `p` of row `(L, v)`. -/
def rval (L : Fin 2) (v : Fin n) (p : ℕ) : Bits (n * wc) := ovR (ω.2 (R.xin ω L v p))

/-- Row `(L, v)`'s key: the dropped part of its pad call. -/
def key (L : Fin 2) (v : Fin n) : Lab n wc := (codeEquiv n wc).symm (R.rval ω L v (ovCalls R.G v))

/-- Lower `P` input: `W_w ⊕ key¹_w`. -/
def pin1 (w : Fin n) : Lab n wc := labXor (R.W w) (R.key ω 0 w)

/-- Top `P` input: `transpose(c¹)_u ⊕ key²_u`. -/
def pin2 (u : Fin n) : Lab n wc := labXor (transpose (R.c1 ω) u) (R.key ω 1 u)

theorem key_eq (L : Fin 2) (v : Fin n) :
    R.key ω L v = keyP3c ω.2 R.tag L v ((parentsDesc R.G v).map (R.lab ω L)) := by
  unfold key keyP3c rval xin
  congr 1
  rw [show ((parentsDesc R.G v).map (R.lab ω L)).map (codeEquiv n wc) ++ [padBlk] =
      rowBlocks (R.lab ω L) R.G v by simp [rowBlocks, List.map_map, Function.comp_def],
    ovKey_eq_xinAt _ _ _ (by simp [rowBlocks]), rowBlocks_length]

theorem c1_eq (w : Fin n) : R.c1 ω w = ω.1 (R.tag, 0, w) (R.pin1 ω w) := by
  unfold pin1
  rw [key_eq]
  exact c1c_eq R.tag R.G ω R.W w

theorem c2_eq (u : Fin n) : R.c2 ω u = ω.1 (R.tag, 1, u) (R.pin2 ω u) := by
  unfold pin2
  rw [key_eq]
  exact c2c_eq R.tag R.G ω R.W u

theorem lab_zero : R.lab ω 0 = R.c1 ω := rfl
theorem lab_one : R.lab ω 1 = R.c2 ω := rfl

/-- A call's block is its parent's label. -/
theorem xin_ovR {L : Fin 2} {v u : Fin n} {p : ℕ} (hb : ovBlock R.G v p = some u) :
    ovR (R.xin ω L v p) = codeEquiv n wc (R.lab ω L u) := by
  unfold xin
  rw [xinAt_ovR, rowBlocks_getD _ _ _ hb]

/-- A call's chaining value is the previous call's output. -/
theorem xin_ovH {L : Fin 2} {v : Fin n} {p : ℕ} (hp1 : 1 ≤ p) (hp : p < ovCalls R.G v) :
    ovH (R.xin ω L v (p + 1)) = R.hval ω L v p := by
  unfold xin hval
  rw [xinAt_ovH_succ _ _ _ hp1 (by rw [rowBlocks_length]; omega)]
  rfl

/-! ### Transcripts, reveals and what a query shows -/

/-- Program `v`'s transcript against `ω`. -/
noncomputable def tr (v : ι) : List (ℕ × (p3ChainModel n wc).Qry) := Tr.trace ((p3ChainModel n wc).answer ω) (R.A v)

/-- The `Π₂` point a query reveals: `x` for `Π₂ x`, `Π₂⁻¹ y` for `Π₂⁻¹ y`. -/
def revS : (p3ChainModel n wc).Qry → Option (Bits (n * wc + (n * wc + 512)))
  | .inl (.inl x) => some x
  | .inl (.inr y) => some (ω.2.symm y)
  | .inr _ => none

/-- The `P` point a query reveals: `(T, a)` for `P_T a`, `(T, P_T⁻¹ z)` for `P_T⁻¹ z`. -/
def revP : (p3ChainModel n wc).Qry → Option (Tweak n × Lab n wc)
  | .inl _ => none
  | .inr (T, .inl a) => some (T, a)
  | .inr (T, .inr z) => some (T, (ω.1 T).symm z)

/-- Some program reveals `Π₂` point `z` at round `ρ`. -/
def askedS (z : Bits (n * wc + (n * wc + 512))) (ρ : ℕ) : Prop :=
  ∃ v, ∃ e ∈ R.tr ω v, e.1 = ρ ∧ revS ω e.2 = some z

/-- Some program reveals `P` point `(T, a)` at round `ρ`. -/
def askedP (T : Tweak n) (a : Lab n wc) (ρ : ℕ) : Prop :=
  ∃ v, ∃ e ∈ R.tr ω v, e.1 = ρ ∧ revP ω e.2 = some (T, a)

/-- The label a query shows in the clear: a `Π₂` block, or a `P⁻¹` input. -/
def showLab : (p3ChainModel n wc).Qry → Option (Lab n wc)
  | .inl (.inl x) => some ((codeEquiv n wc).symm (ovR x))
  | .inl (.inr _) => none
  | .inr (_, .inl _) => none
  | .inr (_, .inr z) => some z

/-- The chaining value a query shows: the input's (`Π₂`) or the chosen output's (`Π₂⁻¹`) chained part. -/
def showH : (p3ChainModel n wc).Qry → Option (Bits (n * wc + 512))
  | .inl (.inl x) => some (ovH x)
  | .inl (.inr y) => some (ovH y)
  | .inr _ => none

/-- The dropped part a query shows: the chosen output's (`Π₂⁻¹`). -/
def showR : (p3ChainModel n wc).Qry → Option (Bits (n * wc))
  | .inl (.inr y) => some (ovR y)
  | _ => none

/-- The `P` input a query shows: `(T, a)` for `P_T a`. -/
def showPin : (p3ChainModel n wc).Qry → Option (Tweak n × Lab n wc)
  | .inr (T, .inl a) => some (T, a)
  | _ => none

/-- Label `x` is shown at round `τ`: in some query, or as some program's output (at its depth). -/
def showsLab (x : Lab n wc) (τ : ℕ) : Prop :=
  ∃ v, (∃ e ∈ R.tr ω v, e.1 = τ ∧ showLab e.2 = some x) ∨
    ((R.A v).run ((p3ChainModel n wc).answer ω) = x ∧ (R.A v).depth ((p3ChainModel n wc).answer ω) = τ)

def showsH (h : Bits (n * wc + 512)) (τ : ℕ) : Prop := ∃ v, ∃ e ∈ R.tr ω v, e.1 = τ ∧ showH e.2 = some h

def showsR (x : Bits (n * wc)) (τ : ℕ) : Prop := ∃ v, ∃ e ∈ R.tr ω v, e.1 = τ ∧ showR e.2 = some x

def showsPin (T : Tweak n) (a : Lab n wc) (τ : ℕ) : Prop :=
  ∃ v, ∃ e ∈ R.tr ω v, e.1 = τ ∧ showPin e.2 = some (T, a)

end P3Replay

end Pous.P3Concrete

end


/-! ════ P3ConcreteMulti.Honest ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The honest computation of the store: domains, locality, and the joint bad event

Everything here depends only on the honest computation (bc-58ec406e's `P3ChainReplay`: tags, graph, data and the
chain points), so the one-segment proof can import it for its collision term at `N = 1`.

- **Domains.** `domP3_inj` (for `v < 2^255`) and `iv_inj`. A row's first call shows its IV (`ovH_xin_one`), so
  first calls of distinct rows are distinct points, for any two replays and any primitives (`xin_one_ne`).
- **Locality.** An overwrite chain reads its permutation only at its own call inputs (`stAfter_congr`,
  `ovKey_congr`). A segment's labels read `Π₂` only at its own honest inputs and `P` only at its own tweaks
  (`Loc.c1_congr`, `Loc.c2_congr`, `Loc.labels_local`, `topLabelC_local`), the chain analogue of `partB_congr_tag`.
- **The joint bad event** `JBad`: two distinct honest `Π₂` positions of the store with the same input, or two distinct
  labels that coincide. `baseReplay` is a segment's honest computation (no programs); any replay's chain points and
  labels are its (`xin_eq_base`, `lab_eq_base`). `JointBirthday` is its bound, proved in `Birthday.lean`.
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

/-! ## Domains and IVs -/

theorem domP3_def (a : Bits 256) (L : Fin 2) (v : ℕ) :
    domP3 a L v = Fin.append a fun j : Fin 256 => (2 * v + L.val).testBit j := rfl

/-- **`domP3` is injective** on nodes below `2^255`: the tag is its first half, and `2v + L` its second. -/
theorem domP3_inj {a a' : Bits 256} {L L' : Fin 2} {v v' : ℕ} (hv : v < 2 ^ 255) (hv' : v' < 2 ^ 255)
    (h : domP3 a L v = domP3 a' L' v') : a = a' ∧ L = L' ∧ v = v' := by
  have ha : a = a' := funext fun j => by
    have hh := congrFun h (Fin.castAdd 256 j)
    rw [domP3_def, domP3_def] at hh
    rwa [Fin.append_left, Fin.append_left] at hh
  have hx : 2 * v + L.val = 2 * v' + L'.val := by
    refine Nat.eq_of_testBit_eq fun i => ?_
    by_cases hi : i < 256
    · have hh := congrFun h (Fin.natAdd 256 (⟨i, hi⟩ : Fin 256))
      rw [domP3_def, domP3_def] at hh
      rw [Fin.append_right, Fin.append_right] at hh
      simpa using hh
    · push Not at hi
      have hL := L.isLt
      have hL' := L'.isLt
      have h256 : (2 : ℕ) ^ 256 ≤ 2 ^ i := Nat.pow_le_pow_right (by norm_num) hi
      rw [Nat.testBit_eq_false_of_lt (by omega), Nat.testBit_eq_false_of_lt (by omega)]
  have hL := L.isLt
  have hL' := L'.isLt
  refine ⟨ha, Fin.ext (by omega), by omega⟩

section IV

variable {r c : ℕ}

theorem iv_def (d : Bits c) : (iv d : Bits (r + c)) = Fin.append (fun _ => false) d := rfl

/-- The IV determines the domain. -/
theorem iv_inj {d d' : Bits c} (h : (iv d : Bits (r + c)) = iv d') : d = d' := funext fun j => by
  have hh := congrFun h (Fin.natAdd r j)
  rw [iv_def, iv_def] at hh
  rwa [Fin.append_right, Fin.append_right] at hh

end IV

/-! ## First calls -/

section Rows

variable {n wc : ℕ} {ι ι' : Type}

/-- **Row `(L, v)`'s first call shows its IV** in the chained part of its input. -/
theorem ovH_xin_one (R : P3Replay n wc ι) (ω : P3COmega n wc) (L : Fin 2) (v : Fin n) :
    ovH (R.xin ω L v 1) = iv (domP3 R.tag L v) := by
  unfold P3Replay.xin xinAt stAfter
  rw [ovH_append]
  rfl

/-- **First calls of distinct rows are distinct points**, for any two replays and any primitives: the chained parts
are distinct IVs. -/
theorem xin_one_ne (R : P3Replay n wc ι) (R' : P3Replay n wc ι') (ω ω' : P3COmega n wc) {L L' : Fin 2}
    {v v' : Fin n} (hn : n ≤ 2 ^ 255) (hne : (R.tag, L, v) ≠ (R'.tag, L', v')) :
    R.xin ω L v 1 ≠ R'.xin ω' L' v' 1 := by
  intro h
  have hh := congrArg ovH h
  rw [ovH_xin_one, ovH_xin_one] at hh
  obtain ⟨h1, h2, h3⟩ := domP3_inj (by omega) (by omega) (iv_inj hh)
  exact hne (by rw [h1, h2, Fin.ext h3])

end Rows

/-! ## Locality -/

section Chain

variable {r c : ℕ}

/-- **An overwrite chain reads its permutation only at its own call inputs.** -/
theorem stAfter_congr (f g : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r)) :
    ∀ j, j ≤ blks.length → (∀ p, 1 ≤ p → p ≤ j → f (xinAt f h₀ blks p) = g (xinAt f h₀ blks p)) →
      stAfter f h₀ blks j = stAfter g h₀ blks j
  | 0, _, _ => rfl
  | j + 1, hj, hfg => by
    have ih := stAfter_congr f g h₀ blks j (by omega) fun p hp hpj => hfg p hp (by omega)
    rw [stAfter_succ f h₀ blks (by omega), stAfter_succ g h₀ blks (by omega), ← ih]
    have hx : xinAt f h₀ blks (j + 1) = Fin.append blks[j] (stAfter f h₀ blks j).2 := by
      unfold xinAt
      rw [Nat.add_sub_cancel, getD_of_lt _ _ (by omega)]
    have h := hfg (j + 1) (by omega) le_rfl
    rw [hx] at h
    simp only [ovStep, h]

theorem xinAt_congr (f g : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r))
    (hfg : ∀ p, 1 ≤ p → p ≤ blks.length → f (xinAt f h₀ blks p) = g (xinAt f h₀ blks p)) {p : ℕ}
    (hp : p ≤ blks.length) : xinAt f h₀ blks p = xinAt g h₀ blks p := by
  unfold xinAt
  rw [stAfter_congr f g h₀ blks (p - 1) (by omega) fun q hq hqp => hfg q hq (by omega)]

/-- **The key reads the permutation only at the chain's call inputs.** -/
theorem ovKey_congr (f g : Bits (r + (r + c)) → Bits (r + (r + c))) (dom : Bits c) (blks : List (Bits r))
    (hne : blks ≠ []) (hfg : ∀ p, 1 ≤ p → p ≤ blks.length → f (xinAt f (iv dom) blks p) = g (xinAt f (iv dom) blks p)) :
    ovKey f dom blks = ovKey g dom blks := by
  have hl : 1 ≤ blks.length := List.length_pos_iff.2 hne
  rw [ovKey_eq_xinAt f dom blks hne, ovKey_eq_xinAt g dom blks hne, hfg _ hl le_rfl,
    xinAt_congr f g (iv dom) blks hfg le_rfl]

end Chain

namespace Loc

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι)

/-- Row `(L, v)`'s key through the chain, with its blocks as `rowBlocks`. -/
theorem key_eq_ovKey (ω : P3COmega n wc) (L : Fin 2) (v : Fin n) :
    R.key ω L v = (codeEquiv n wc).symm (ovKey ω.2 (domP3 R.tag L v) (rowBlocks (R.lab ω L) R.G v)) := by
  rw [P3Replay.key_eq]
  unfold keyP3c
  congr 2
  simp [rowBlocks, List.map_map, Function.comp_def]

theorem rowBlocks_ne_nil (lab : Fin n → Lab n wc) (G : TopoDAG n) (v : Fin n) : rowBlocks lab G v ≠ [] := by
  simp [rowBlocks]

theorem rowBlocks_congr {lab lab' : Fin n → Lab n wc} (G : TopoDAG n) (v : Fin n)
    (h : ∀ u ∈ G.par v, lab u = lab' u) : rowBlocks lab G v = rowBlocks lab' G v := by
  unfold rowBlocks
  congr 1
  exact List.map_congr_left fun u hu => by rw [h u ((Finset.mem_sort _).1 hu)]

/-- A row's key agrees under two primitives if its parents' labels agree and `Π₂` agrees at its honest inputs. -/
theorem key_congr {ω ω' : P3COmega n wc} (L : Fin 2) (v : Fin n)
    (hpar : ∀ u ∈ R.G.par v, R.lab ω' L u = R.lab ω L u)
    (hS : ∀ p, 1 ≤ p → p ≤ ovCalls R.G v → ω.2 (R.xin ω L v p) = ω'.2 (R.xin ω L v p)) :
    R.key ω' L v = R.key ω L v := by
  rw [key_eq_ovKey, key_eq_ovKey, rowBlocks_congr R.G v hpar]
  congr 1
  refine (ovKey_congr ω.2 ω'.2 _ _ (rowBlocks_ne_nil _ _ _) fun p hp hpl => ?_).symm
  rw [rowBlocks_length] at hpl
  exact hS p hp hpl

variable {ω ω' : P3COmega n wc}

/-- **Lower labels are local**: they agree if `P` agrees at the segment's tweaks and `Π₂` at its lower rows' honest
inputs. -/
theorem c1_congr (hP : ∀ (L : Fin 2) (v : Fin n), ω'.1 (R.tag, L, v) = ω.1 (R.tag, L, v))
    (hS : ∀ v p, 1 ≤ p → p ≤ ovCalls R.G v → ω.2 (R.xin ω 0 v p) = ω'.2 (R.xin ω 0 v p)) :
    R.c1 ω' = R.c1 ω := by
  funext u
  induction u using WellFoundedLT.induction with
  | _ u ih =>
    rw [R.c1_eq ω', R.c1_eq ω, hP 0 u]
    unfold P3Replay.pin1
    rw [key_congr R 0 u (fun w hw => ih w (R.G.par_lt u w hw)) (hS u)]

/-- **Top labels are local**: they agree if `P` agrees at the segment's tweaks and `Π₂` at its honest inputs. -/
theorem c2_congr (hP : ∀ (L : Fin 2) (v : Fin n), ω'.1 (R.tag, L, v) = ω.1 (R.tag, L, v))
    (hS : ∀ L v p, 1 ≤ p → p ≤ ovCalls R.G v → ω.2 (R.xin ω L v p) = ω'.2 (R.xin ω L v p)) :
    R.c2 ω' = R.c2 ω := by
  have h1 := c1_congr R hP (hS 0)
  funext u
  induction u using WellFoundedLT.induction with
  | _ u ih =>
    rw [R.c2_eq ω', R.c2_eq ω, hP 1 u]
    unfold P3Replay.pin2
    rw [h1, key_congr R 1 u (fun w hw => ih w (R.G.par_lt u w hw)) (hS 1 u)]

/-- **A segment's labels are local**: both layers, under the same conditions. -/
theorem labels_local (hP : ∀ (L : Fin 2) (v : Fin n), ω'.1 (R.tag, L, v) = ω.1 (R.tag, L, v))
    (hS : ∀ L v p, 1 ≤ p → p ≤ ovCalls R.G v → ω.2 (R.xin ω L v p) = ω'.2 (R.xin ω L v p)) (L : Fin 2) :
    R.lab ω' L = R.lab ω L := by
  unfold P3Replay.lab
  split_ifs
  · exact c1_congr R hP (hS 0)
  · exact c2_congr R hP hS

end Loc

/-! ## The honest computation of the store, and the joint bad event -/

section Bad

variable {N n wc : ℕ}

/-- Segment `s`'s honest computation: a replay with no programs. -/
def baseReplay (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (s : Fin N) :
    P3Replay n wc Empty :=
  ⟨tags s, G, W s, 0, 0, Empty.elim⟩

/-- **Any replay's chain points are its honest computation's**: they depend on the tag, graph and data only. -/
theorem xin_eq_base {ι : Type} (R : P3Replay n wc ι) :
    R.xin = (baseReplay (fun _ : Fin 1 => R.tag) R.G (fun _ => R.W) 0).xin := rfl

/-- **Any replay's labels are its honest computation's.** -/
theorem lab_eq_base {ι : Type} (R : P3Replay n wc ι) :
    R.lab = (baseReplay (fun _ : Fin 1 => R.tag) R.G (fun _ => R.W) 0).lab := rfl

/-- **Segment `s`'s top labels in the store are local**: they are unchanged by any change of `Π₂` away from segment
`s`'s honest inputs and of `P` away from segment `s`'s tweaks. -/
theorem topLabelC_local (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (s : Fin N) {ω ω' : P3COmega n wc}
    (hP : ∀ (L : Fin 2) (v : Fin n), ω'.1 (tags s, L, v) = ω.1 (tags s, L, v))
    (hS : ∀ L v p, 1 ≤ p → p ≤ ovCalls G v →
      ω.2 ((baseReplay tags G W s).xin ω L v p) = ω'.2 ((baseReplay tags G W s).xin ω L v p)) :
    topLabelC (tags s) G (W s) ω' = topLabelC (tags s) G (W s) ω :=
  Loc.c2_congr (baseReplay tags G W s) hP hS

/-- Two distinct honest `Π₂` positions of the store share an input. -/
def HonestCollJ (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (ω : P3COmega n wc) :
    Prop :=
  ∃ (s s' : Fin N) (L L' : Fin 2) (v v' : Fin n) (p p' : ℕ), 1 ≤ p ∧ p ≤ ovCalls G v ∧ 1 ≤ p' ∧
    p' ≤ ovCalls G v' ∧ (s, L, v, p) ≠ (s', L', v', p') ∧
    (baseReplay tags G W s).xin ω L v p = (baseReplay tags G W s').xin ω L' v' p'

/-- Two distinct labels of the store coincide. -/
def LabCollJ (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (ω : P3COmega n wc) : Prop :=
  ∃ (s s' : Fin N) (L L' : Fin 2) (v v' : Fin n), (s, L, v) ≠ (s', L', v') ∧
    (baseReplay tags G W s).lab ω L v = (baseReplay tags G W s').lab ω L' v'

/-- **The joint bad event.** -/
def JBad (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (ω : P3COmega n wc) : Prop :=
  HonestCollJ tags G W ω ∨ LabCollJ tags G W ω

/-- **Off the bad event, distinct honest positions are distinct points.** -/
theorem xin_ne_of_not_JBad {tags : Fin N → Bits 256} {G : TopoDAG n} {W : Fin N → Fin n → Lab n wc}
    {ω : P3COmega n wc} (h : ¬ JBad tags G W ω) {s s' : Fin N} {L L' : Fin 2} {v v' : Fin n} {p p' : ℕ}
    (hp : 1 ≤ p) (hpv : p ≤ ovCalls G v) (hp' : 1 ≤ p') (hpv' : p' ≤ ovCalls G v')
    (hne : (s, L, v, p) ≠ (s', L', v', p')) :
    (baseReplay tags G W s).xin ω L v p ≠ (baseReplay tags G W s').xin ω L' v' p' :=
  fun heq => h (Or.inl ⟨s, s', L, L', v, v', p, p', hp, hpv, hp', hpv', hne, heq⟩)

/-- **The joint birthday** (proved in `Birthday.lean`, `jointBirthday`). With injective tags and `n ≤ 2^255`, the
joint bad event has probability at most the target's collision term. -/
def JointBirthday : Prop :=
  ∀ (N n wc Q : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    Function.Injective tags → n ≤ 2 ^ 255 →
    pr (JBad tags G W) ≤ (((N * nPosC n Q) ^ 2 + (2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

end Bad

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.BirthdayPin ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Pins for the joint birthday: one `Π₂` output, and one tweak of `P`

- **The `Π₂` pin** (`card_pin_le`, `pr_pin_le`) is `sponge-dense/ChainEPFBirthday.lean`'s adaptive pin (bc-a359729a),
  copied with its proof: `ChainEPFBirthday` imports `DenseMeets`, which cannot sit beside `Thm1.Theorem1iiSeq`
  (both define `PousThm1Chain.progMap`). If `z π` and `T π` are fixed by `π` on a set `S π` of at most `n` points, then
  `ovH (π (z π)) = T π` with `z π ∉ S π` has probability at most `1/(2^(r+c) − n)`.
- **The `P` pin** (`card_ppin_le`, `pr_ppin_le`) is new: in a tweakable family, if `x` and `y` do not read tweak `T`,
  then `P_T (x) = y` has probability at most `1/|α|`. Resetting `P_T` by a swap injects the event times `α`.
- **Averaging** over the first coordinate of a product (`pr_le_of_forall_fst`), and `pr` does not depend on the
  `Fintype` instance (`pr_congr_inst`).
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

namespace Bday

/-! ## Generic helpers -/

theorem pr_congr_inst {α : Type} (i1 i2 : Fintype α) (P : α → Prop) : @pr α i1 P = @pr α i2 P := by
  rw [Subsingleton.elim i1 i2]

theorem pr_or_le {α : Type} [Fintype α] (P Q : α → Prop) : pr (fun x => P x ∨ Q x) ≤ pr P + pr Q := by
  classical
  simp only [pr_def]
  rw [← ENNReal.add_div]
  gcongr
  rw [Finset.filter_or]
  exact_mod_cast Finset.card_union_le _ _

/-- **Averaging over the first coordinate.** -/
theorem pr_le_of_forall_fst {α β : Type} [Fintype α] [Fintype β] [Nonempty α] [Nonempty β] (R : α × β → Prop)
    (c : ℝ≥0∞) (h : ∀ a, pr (fun b => R (a, b)) ≤ c) : pr R ≤ c := by
  classical
  have hα0 : (Fintype.card α : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hβ0 : (Fintype.card β : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hαt : (Fintype.card α : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hβt : (Fintype.card β : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hcount : ((Finset.univ.filter R).card : ℝ≥0∞) = ∑ a, ((Finset.univ.filter fun b => R (a, b)).card : ℝ≥0∞) := by
    rw [Finset.natCast_card_filter, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.natCast_card_filter]
  have hfib : ∀ a, ((Finset.univ.filter fun b => R (a, b)).card : ℝ≥0∞) ≤ c * Fintype.card β := by
    intro a
    have := h a
    rwa [pr_def, ENNReal.div_le_iff hβ0 hβt] at this
  rw [pr_def, hcount, Fintype.card_prod, Nat.cast_mul,
    ENNReal.div_le_iff (mul_ne_zero hα0 hβ0) (ENNReal.mul_ne_top hαt hβt)]
  calc ∑ a, ((Finset.univ.filter fun b => R (a, b)).card : ℝ≥0∞) ≤ ∑ _a : α, c * Fintype.card β :=
        Finset.sum_le_sum fun a _ => hfib a
    _ = c * (Fintype.card α * Fintype.card β) := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; ring

theorem inv_two_pow_sub_le {ℓ n : ℕ} (h : 2 * n ≤ 2 ^ ℓ) :
    (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹ ≤ 2 * ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := by
  have hnat : (2 : ℕ) ^ ℓ ≤ 2 * (2 ^ ℓ - n) := by omega
  have hcast : ((2 : ℝ≥0∞) ^ ℓ) ≤ 2 * (((2 ^ ℓ - n : ℕ) : ℝ≥0∞)) := by
    have := (Nat.cast_le (α := ℝ≥0∞)).2 hnat
    rw [Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] at this
    simpa using this
  have ha : ((2 ^ ℓ - n : ℕ) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : (2 : ℝ≥0∞) ≠ 0 := two_ne_zero
  have h2t : (2 : ℝ≥0∞) ≠ ⊤ := ENNReal.ofNat_ne_top
  calc (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹ = 2 * (2 * (((2 ^ ℓ - n : ℕ) : ℝ≥0∞)))⁻¹ := by
        rw [ENNReal.mul_inv (Or.inl h2) (Or.inl h2t), ← mul_assoc, ENNReal.mul_inv_cancel h2 h2t, one_mul]
    _ ≤ 2 * ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := by gcongr

theorem append_ovR_ovH {r c : ℕ} (o : Bits (r + (r + c))) : Fin.append (ovR o) (ovH o) = o := by
  funext i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp only [Fin.append_left, Fin.append_right, ovR, ovH]

theorem card_bits (n : ℕ) : Fintype.card (Bits n) = 2 ^ n := by simp [Bits]

/-! ## The `Π₂` pin (copied from `ChainEPFBirthday`, bc-a359729a) -/

section Pin

variable {r c : ℕ}

/-- Set `π z` to `t`, swapping with the point that `π` sent to `t`. -/
def swapTo (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) : Equiv.Perm (Bits (r + (r + c))) :=
  Equiv.swap (π z) t * π

theorem swapTo_self (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) : swapTo π z t z = t := by
  simp only [swapTo, Equiv.Perm.mul_apply, Equiv.swap_apply_left]

theorem swapTo_apply_ne (π : Equiv.Perm (Bits (r + (r + c)))) (z t x : Bits (r + (r + c))) (hx : x ≠ z)
    (hy : π x ≠ t) : swapTo π z t x = π x := by
  simp only [swapTo, Equiv.Perm.mul_apply]
  exact Equiv.swap_apply_of_ne_of_ne (fun h => hx (π.injective h)) hy

theorem swapTo_recover (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) :
    Equiv.swap (π z) (swapTo π z t z) * swapTo π z t = π := by
  rw [swapTo_self]
  show Equiv.swap (π z) t * (Equiv.swap (π z) t * π) = π
  rw [← mul_assoc, Equiv.swap_mul_self, one_mul]

open Classical in
/-- **Adaptive pin.** Let `z π` be a point, `T π` an `h`-value and `S π` a set of at most `n` points, where `z` and `T`
depend on `π` only through `S π`. The permutations with `ovH (π (z π)) = T π` and `z π ∉ S π`, times `2^(r+c) − n`,
number at most all permutations. -/
theorem card_pin_le (z : Equiv.Perm (Bits (r + (r + c))) → Bits (r + (r + c)))
    (T : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c))
    (S : Equiv.Perm (Bits (r + (r + c))) → Finset (Bits (r + (r + c)))) (n : ℕ)
    (hS : ∀ π, (S π).card ≤ n)
    (hstab : ∀ π π' : Equiv.Perm (Bits (r + (r + c))), (∀ x ∈ S π, π' x = π x) → z π' = z π ∧ T π' = T π)
    (E : Equiv.Perm (Bits (r + (r + c))) → Prop)
    (hE : ∀ π, E π → ovH (π (z π)) = T π ∧ z π ∉ S π) :
    (Finset.univ.filter E).card * (2 ^ (r + c) - n) ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := by
  let good : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c) → Prop :=
    fun π h' => ∀ x ∈ S π, π x ≠ Fin.append (ovR (π (z π))) h'
  have hgood_card : ∀ π, 2 ^ (r + c) - n ≤ (Finset.univ.filter (good π)).card := by
    intro π
    have hbad : (Finset.univ.filter fun h' => ¬ good π h') ⊆ (S π).image (fun x => ovH (π x)) := by
      intro h' hh
      simp only [good, Finset.mem_filter, Finset.mem_univ, true_and, not_forall, not_not] at hh
      obtain ⟨x, hx, hxe⟩ := hh
      exact Finset.mem_image.2 ⟨x, hx, by rw [hxe, ovH_append]⟩
    have hsplit := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset (Bits (r + c)))) (good π)
    rw [Finset.card_univ, card_bits] at hsplit
    have := (Finset.card_le_card hbad).trans (Finset.card_image_le.trans (hS π))
    omega
  have hpairs : (Finset.univ.filter E).card * (2 ^ (r + c) - n) ≤
      ((Finset.univ.filter E ×ˢ (Finset.univ : Finset (Bits (r + c)))).filter (fun p => good p.1 p.2)).card := by
    have hsum : ((Finset.univ.filter E ×ˢ (Finset.univ : Finset (Bits (r + c)))).filter
        (fun p => good p.1 p.2)).card = ∑ π ∈ Finset.univ.filter E, (Finset.univ.filter (good π)).card := by
      rw [Finset.card_filter, Finset.sum_product]
      exact Finset.sum_congr rfl (fun π _ => (Finset.card_filter _ _).symm)
    rw [hsum, ← smul_eq_mul]
    exact Finset.card_nsmul_le_sum _ _ _ (fun π _ => hgood_card π)
  refine hpairs.trans ((Finset.card_le_card_of_injOn
    (fun p => swapTo p.1 (z p.1) (Fin.append (ovR (p.1 (z p.1))) p.2))
    (fun _ _ => Finset.mem_coe.2 (Finset.mem_univ _)) ?_).trans Finset.card_univ.le)
  intro p₁ hp₁ p₂ hp₂ heq
  simp only [Finset.coe_filter, Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and,
    Set.mem_ofPred_eq] at hp₁ hp₂
  obtain ⟨⟨hE₁, -⟩, hg₁⟩ := hp₁
  obtain ⟨⟨hE₂, -⟩, hg₂⟩ := hp₂
  dsimp only at heq
  set π' := swapTo p₁.1 (z p₁.1) (Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2) with hπ'
  have hag₁ : ∀ x ∈ S p₁.1, π' x = p₁.1 x := fun x hx =>
    swapTo_apply_ne _ _ _ x (fun h => (hE p₁.1 hE₁).2 (h ▸ hx)) (hg₁ x hx)
  have hag₂ : ∀ x ∈ S p₂.1, π' x = p₂.1 x := fun x hx => by
    rw [heq]; exact swapTo_apply_ne _ _ _ x (fun h => (hE p₂.1 hE₂).2 (h ▸ hx)) (hg₂ x hx)
  obtain ⟨hz₁, hT₁⟩ := hstab p₁.1 π' hag₁
  obtain ⟨hz₂, hT₂⟩ := hstab p₂.1 π' hag₂
  have hzz : z p₂.1 = z p₁.1 := hz₂.symm.trans hz₁
  have hself₁ : π' (z p₁.1) = Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2 := swapTo_self _ _ _
  have hself₂ : π' (z p₁.1) = Fin.append (ovR (p₂.1 (z p₁.1))) p₂.2 := by
    rw [heq, ← hzz]; exact swapTo_self _ _ _
  have hh : p₁.2 = p₂.2 := by
    have := congrArg ovH (hself₁.symm.trans hself₂)
    simpa only [ovH_append] using this
  have hr : ovR (p₁.1 (z p₁.1)) = ovR (p₂.1 (z p₁.1)) := by
    have := congrArg ovR (hself₁.symm.trans hself₂)
    simpa only [ovR_append] using this
  have hv : p₁.1 (z p₁.1) = p₂.1 (z p₁.1) := by
    rw [← append_ovR_ovH (p₁.1 (z p₁.1)), ← append_ovR_ovH (p₂.1 (z p₁.1)), hr]
    congr 1
    rw [(hE p₁.1 hE₁).1, ← hzz, (hE p₂.1 hE₂).1, ← hT₁, hT₂]
  have hrec₁ := swapTo_recover p₁.1 (z p₁.1) (Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2)
  have hrec₂ := swapTo_recover p₂.1 (z p₂.1) (Fin.append (ovR (p₂.1 (z p₂.1))) p₂.2)
  rw [← hπ'] at hrec₁
  rw [← heq, hzz] at hrec₂
  refine Prod.ext ?_ hh
  rw [← hrec₁, ← hrec₂, hv]

open Classical in
/-- **Adaptive pin, as a probability**: the event has probability at most `1/(2^(r+c) − n)`. -/
theorem pr_pin_le (z : Equiv.Perm (Bits (r + (r + c))) → Bits (r + (r + c)))
    (T : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c))
    (S : Equiv.Perm (Bits (r + (r + c))) → Finset (Bits (r + (r + c)))) (n : ℕ)
    (hS : ∀ π, (S π).card ≤ n)
    (hstab : ∀ π π' : Equiv.Perm (Bits (r + (r + c))), (∀ x ∈ S π, π' x = π x) → z π' = z π ∧ T π' = T π)
    (E : Equiv.Perm (Bits (r + (r + c))) → Prop)
    (hE : ∀ π, E π → ovH (π (z π)) = T π ∧ z π ∉ S π) :
    pr E ≤ (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by
  have hnat := card_pin_le z T S n hS hstab E hE
  rcases Nat.eq_zero_or_pos (2 ^ (r + c) - n) with h0 | hpos
  · rw [h0, Nat.cast_zero, ENNReal.inv_zero]; exact le_top
  have hΩ0 : (Fintype.card (Equiv.Perm (Bits (r + (r + c)))) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (Equiv.Perm (Bits (r + (r + c)))) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) ≠ 0 := by exact_mod_cast hpos.ne'
  have h2t : (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) ≠ ⊤ := ENNReal.natCast_ne_top _
  rw [pr_def, ENNReal.div_le_iff hΩ0 hΩt]
  have hc : ((Finset.univ.filter E).card : ℝ≥0∞) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))
      ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := by exact_mod_cast hnat
  calc ((Finset.univ.filter E).card : ℝ≥0∞)
      = (Finset.univ.filter E).card * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by
        rw [mul_assoc, ENNReal.mul_inv_cancel h2 h2t, mul_one]
    _ ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by gcongr
    _ = (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ * Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := mul_comm _ _

end Pin

/-! ## The `P` pin: one tweak of a tweakable family -/

section PPin

variable {τ α β : Type} [Fintype τ] [DecidableEq τ] [Fintype α] [DecidableEq α] [Fintype β]

/-- Reset tweak `T` of `ω.1` to `σ`. -/
def upd (T : τ) (ω : (τ → Equiv.Perm α) × β) (σ : Equiv.Perm α) : (τ → Equiv.Perm α) × β :=
  (Function.update ω.1 T σ, ω.2)

omit [Fintype τ] [Fintype β] in
open Classical in
/-- **The `P` pin.** If `x` and `y` do not read tweak `T`, the primitives with `ω.1 T (x ω) = y ω`, times `|α|`,
number at most all primitives. -/
theorem card_ppin_le [inst : Fintype ((τ → Equiv.Perm α) × β)] (T : τ) (x y : (τ → Equiv.Perm α) × β → α)
    (hx : ∀ ω σ, x (upd T ω σ) = x ω) (hy : ∀ ω σ, y (upd T ω σ) = y ω) :
    (Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω).card * Fintype.card α ≤
      Fintype.card ((τ → Equiv.Perm α) × β) := by
  set E := Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω
  let F : ((τ → Equiv.Perm α) × β) × α → (τ → Equiv.Perm α) × β :=
    fun p => upd T p.1 (Equiv.swap (y p.1) p.2 * p.1.1 T)
  have hF1 : ∀ p : ((τ → Equiv.Perm α) × β) × α, p.1 ∈ E → (F p).1 T (x (F p)) = p.2 := by
    intro p hp
    have hp' : p.1.1 T (x p.1) = y p.1 := (Finset.mem_filter.1 hp).2
    have e1 : x (F p) = x p.1 := hx p.1 _
    rw [e1]
    simp only [F, upd, Function.update_self, Equiv.Perm.mul_apply, hp', Equiv.swap_apply_left]
  rw [← Finset.card_univ (α := α), ← Finset.card_product]
  refine (Finset.card_le_card_of_injOn F (fun _ _ => Finset.mem_coe.2 (Finset.mem_univ _)) ?_).trans
    Finset.card_univ.le
  intro p₁ hp₁ p₂ hp₂ heq
  simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe] at hp₁ hp₂
  have ht : p₁.2 = p₂.2 := by rw [← hF1 p₁ hp₁.1, ← hF1 p₂ hp₂.1, heq]
  have hy12 : y p₁.1 = y p₂.1 := by rw [← hy p₁.1 (Equiv.swap (y p₁.1) p₁.2 * p₁.1.1 T),
    ← hy p₂.1 (Equiv.swap (y p₂.1) p₂.2 * p₂.1.1 T)]; exact congrArg y heq
  have h2 : p₁.1.2 = p₂.1.2 := by
    have e := congrArg Prod.snd heq
    simpa [F, upd] using e
  have hT : p₁.1.1 T = p₂.1.1 T := by
    have e := congrArg (fun ω : (τ → Equiv.Perm α) × β => ω.1 T) heq
    simp only [F, upd, Function.update_self] at e
    rw [hy12, ht] at e
    exact mul_left_cancel e
  have hrest : ∀ T', p₁.1.1 T' = p₂.1.1 T' := by
    intro T'
    by_cases hT' : T' = T
    · rw [hT', hT]
    · have e := congrArg (fun ω : (τ → Equiv.Perm α) × β => ω.1 T') heq
      simpa [F, upd, Function.update_of_ne hT'] using e
  exact Prod.ext (Prod.ext (funext hrest) h2) ht

omit [Fintype τ] [Fintype β] in
open Classical in
/-- **The `P` pin, as a probability**: at most `1/|α|`. -/
theorem pr_ppin_le [inst : Fintype ((τ → Equiv.Perm α) × β)] [Nonempty α] [Nonempty β] (T : τ)
    (x y : (τ → Equiv.Perm α) × β → α) (hx : ∀ ω σ, x (upd T ω σ) = x ω) (hy : ∀ ω σ, y (upd T ω σ) = y ω) :
    pr (fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω) ≤ ((Fintype.card α : ℝ≥0∞))⁻¹ := by
  have hnat := card_ppin_le T x y hx hy
  have hΩ0 : (Fintype.card ((τ → Equiv.Perm α) × β) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast (Fintype.card_pos_iff.2 ⟨(fun _ => 1, Classical.arbitrary β)⟩).ne'
  have hΩt : (Fintype.card ((τ → Equiv.Perm α) × β) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hα0 : (Fintype.card α : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hαt : (Fintype.card α : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  rw [pr_def, ENNReal.div_le_iff hΩ0 hΩt]
  have hc : ((Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω).card : ℝ≥0∞) *
      Fintype.card α ≤ Fintype.card ((τ → Equiv.Perm α) × β) := by exact_mod_cast hnat
  calc ((Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω).card : ℝ≥0∞)
      = (Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω).card * Fintype.card α *
          ((Fintype.card α : ℝ≥0∞))⁻¹ := by rw [mul_assoc, ENNReal.mul_inv_cancel hα0 hαt, mul_one]
    _ ≤ Fintype.card ((τ → Equiv.Perm α) × β) * ((Fintype.card α : ℝ≥0∞))⁻¹ := by gcongr
    _ = ((Fintype.card α : ℝ≥0∞))⁻¹ * Fintype.card ((τ → Equiv.Perm α) × β) := mul_comm _ _

end PPin

end Bday

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.Birthday ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `JointBirthday`: the joint collision event at the target's collision term

**Statement** (`jointBirthday : JointBirthday`). With injective tags and `n ≤ 2^255`,
`pr[JBad] ≤ ((N·nPosC)² + (2Nn)²)/2^{n·wc}`. It depends on the primitives alone, with no `2^m` factor.

**Honest `Π₂` coincidences** (at most `(N·nPosC)²/2^{n·wc}`, in fact `M²·2/2^{n·wc+512}` with `M ≤ N·n(n+1)` honest
positions), for each fixed `P`, over `Π₂`:
1. **Order.** Store positions `((s, L, v), p)` are ordered by segment, layer, row, then call (`posKey`). With `P`
   fixed, every honest input depends on `Π₂` only at the inputs of earlier positions (`xin_stable`, from the prefix
   locality `c1_congr_le`, `c2_congr_le` and `stAfter_congr`).
2. **First collision** (`exists_firstColl`), and **one pinned output** (`firstColl_pin`). Its predecessor's output
   is pinned to a value fixed by earlier positions. Two first calls never collide: their IVs carry distinct domains
   (`domP3_inj`, injective tags).
3. **The `Π₂` pin** (`pr_pin_le`) at `1/(2^{n·wc+512} − M)`, summed over the pairs.

**Label coincidences** (at most `(2Nn)²/2^{n·wc}`). Of two distinct labels take the later one in (segment, layer,
row) order. It is `P_T(x)` with `T` its own tweak, and neither `x` nor the earlier label reads `P_T`
(`pin1_congr`, `pin2_congr`, `c1_congr_le`, `c2_congr_le`, `tweak_ne`). So the `P` pin gives `1/2^{n·wc}` per pair.
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

set_option maxRecDepth 8000

namespace Bday

/-! ## Prefix locality of labels -/

section Prefix

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) {ω ω' : P3COmega n wc}

/-- **Lower labels up to `u` are local** to `P` at lower tweaks `≤ u` and `Π₂` at lower rows `≤ u`. -/
theorem c1_congr_le (u : Fin n) (hP : ∀ u' : Fin n, u' ≤ u → ω'.1 (R.tag, 0, u') = ω.1 (R.tag, 0, u'))
    (hS : ∀ u' : Fin n, u' ≤ u → ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 0 u' p) = ω'.2 (R.xin ω 0 u' p)) :
    ∀ u' : Fin n, u' ≤ u → R.c1 ω' u' = R.c1 ω u' := by
  intro u'
  induction u' using WellFoundedLT.induction with
  | _ u' ih =>
    intro hu'
    rw [R.c1_eq ω', R.c1_eq ω, hP u' hu']
    unfold P3Replay.pin1
    rw [Loc.key_congr R 0 u' (fun w hw => ih w (R.G.par_lt u' w hw) ((R.G.par_lt u' w hw).le.trans hu'))
      (hS u' hu')]

/-- **Top labels up to `u` are local**, given all lower labels. -/
theorem c2_congr_le (hc1 : R.c1 ω' = R.c1 ω) (u : Fin n)
    (hP : ∀ u' : Fin n, u' ≤ u → ω'.1 (R.tag, 1, u') = ω.1 (R.tag, 1, u'))
    (hS : ∀ u' : Fin n, u' ≤ u → ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 1 u' p) = ω'.2 (R.xin ω 1 u' p)) :
    ∀ u' : Fin n, u' ≤ u → R.c2 ω' u' = R.c2 ω u' := by
  intro u'
  induction u' using WellFoundedLT.induction with
  | _ u' ih =>
    intro hu'
    rw [R.c2_eq ω', R.c2_eq ω, hP u' hu']
    unfold P3Replay.pin2
    rw [hc1, Loc.key_congr R 1 u' (fun w hw => ih w (R.G.par_lt u' w hw) ((R.G.par_lt u' w hw).le.trans hu'))
      (hS u' hu')]

/-- All lower labels, from `P` at all lower tweaks and `Π₂` at all lower rows. -/
theorem c1_congr_all (hP : ∀ u' : Fin n, ω'.1 (R.tag, 0, u') = ω.1 (R.tag, 0, u'))
    (hS : ∀ u' : Fin n, ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 0 u' p) = ω'.2 (R.xin ω 0 u' p)) :
    R.c1 ω' = R.c1 ω :=
  funext fun u => c1_congr_le R u (fun u' _ => hP u') (fun u' _ => hS u') u le_rfl

/-- **The lower `P` input of `w` reads `P` only at lower tweaks `< w`.** -/
theorem pin1_congr (w : Fin n) (hP : ∀ u' : Fin n, u' < w → ω'.1 (R.tag, 0, u') = ω.1 (R.tag, 0, u'))
    (hS : ∀ u' : Fin n, u' ≤ w → ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 0 u' p) = ω'.2 (R.xin ω 0 u' p)) :
    R.pin1 ω' w = R.pin1 ω w := by
  unfold P3Replay.pin1
  rw [Loc.key_congr R 0 w (fun u hu => ?_) (hS w le_rfl)]
  have huw := R.G.par_lt w u hu
  exact c1_congr_le R u (fun u' hu' => hP u' (lt_of_le_of_lt hu' huw)) (fun u' hu' => hS u' (hu'.trans huw.le)) u le_rfl

/-- **The top `P` input of `u` reads `P` only at lower tweaks and top tweaks `< u`.** -/
theorem pin2_congr (hc1 : R.c1 ω' = R.c1 ω) (u : Fin n)
    (hP : ∀ u' : Fin n, u' < u → ω'.1 (R.tag, 1, u') = ω.1 (R.tag, 1, u'))
    (hS : ∀ u' : Fin n, u' ≤ u → ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 1 u' p) = ω'.2 (R.xin ω 1 u' p)) :
    R.pin2 ω' u = R.pin2 ω u := by
  unfold P3Replay.pin2
  rw [hc1, Loc.key_congr R 1 u (fun w hw => ?_) (hS u le_rfl)]
  have hwu := R.G.par_lt u w hw
  exact c2_congr_le R hc1 w (fun u' hu' => hP u' (lt_of_le_of_lt hu' hwu)) (fun u' hu' => hS u' (hu'.trans hwu.le))
    w le_rfl

end Prefix

/-! ## Store positions and their order -/

theorem seg_div {s i B : ℕ} (hi : i < B) : (s * B + i) / B = s := by
  rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega : 0 < B), Nat.div_eq_of_lt hi, Nat.zero_add]

/-- Quotient and remainder determine the number. -/
theorem divmod_inj {D a a' x x' : ℕ} (hx : x < D) (hx' : x' < D) (h : a * D + x = a' * D + x') :
    a = a' ∧ x = x' := by
  have h1 := seg_div (s := a) hx
  have h2 := seg_div (s := a') hx'
  rw [h] at h1
  have ha : a = a' := h1.symm.trans h2
  subst ha
  exact ⟨rfl, by omega⟩

section Pos

variable {N n : ℕ}

/-- A store row `(s, L, v)`: its key orders by segment, layer, then row. -/
def rowKey (n : ℕ) (ρ : Fin N × Fin 2 × Fin n) : ℕ := (ρ.1.val * 2 + ρ.2.1.val) * n + ρ.2.2.val

/-- A store position `(row, call)`. -/
def posKey (n : ℕ) (q : (Fin N × Fin 2 × Fin n) × ℕ) : ℕ := rowKey n q.1 * (n + 2) + q.2

theorem rowKey_inj {ρ ρ' : Fin N × Fin 2 × Fin n} (h : rowKey n ρ = rowKey n ρ') : ρ = ρ' := by
  obtain ⟨h1, h2⟩ := divmod_inj ρ.2.2.isLt ρ'.2.2.isLt h
  obtain ⟨h3, h4⟩ := divmod_inj ρ.2.1.isLt ρ'.2.1.isLt h1
  exact Prod.ext (Fin.ext h3) (Prod.ext (Fin.ext h4) (Fin.ext h2))

theorem rowKey_lt (ρ : Fin N × Fin 2 × Fin n) : rowKey n ρ < N * 2 * n := by
  have h1 := ρ.1.isLt
  have h2 := ρ.2.1.isLt
  have h3 := ρ.2.2.isLt
  unfold rowKey
  have e1 : (ρ.1.val * 2 + ρ.2.1.val) + 1 ≤ N * 2 := by omega
  have e2 : ((ρ.1.val * 2 + ρ.2.1.val) + 1) * n ≤ N * 2 * n := Nat.mul_le_mul_right _ e1
  rw [Nat.add_mul, one_mul] at e2
  omega

variable (G : TopoDAG n)

/-- The honest chain positions of the store: call `p` of row `(s, L, v)`, `1 ≤ p ≤ ovCalls v`. -/
def posSetJ (N : ℕ) : Finset ((Fin N × Fin 2 × Fin n) × ℕ) :=
  (Finset.univ ×ˢ Finset.range (n + 2)).filter fun q => 1 ≤ q.2 ∧ q.2 ≤ ovCalls G q.1.2.2

theorem mem_posSetJ {q : (Fin N × Fin 2 × Fin n) × ℕ} : q ∈ posSetJ G N ↔ 1 ≤ q.2 ∧ q.2 ≤ ovCalls G q.1.2.2 := by
  unfold posSetJ
  rw [Finset.mem_filter]
  refine ⟨fun h => h.2, fun h => ⟨Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 ?_⟩, h⟩⟩
  have := ovCalls_le G q.1.2.2
  omega

theorem posKey_inj {q q' : (Fin N × Fin 2 × Fin n) × ℕ} (hq : q ∈ posSetJ G N) (hq' : q' ∈ posSetJ G N)
    (h : posKey n q = posKey n q') : q = q' := by
  have h1 := ovCalls_le G q.1.2.2
  have h2 := ovCalls_le G q'.1.2.2
  have hq2 := ((mem_posSetJ G).1 hq).2
  have hq2' := ((mem_posSetJ G).1 hq').2
  obtain ⟨e1, e2⟩ := divmod_inj (D := n + 2) (by omega) (by omega) h
  exact Prod.ext (rowKey_inj e1) e2

/-- A position of an earlier row comes before every position of a later row. -/
theorem posKey_lt_of_rowKey {q q' : (Fin N × Fin 2 × Fin n) × ℕ} (hq : q ∈ posSetJ G N)
    (h : rowKey n q.1 < rowKey n q'.1) : posKey n q < posKey n q' := by
  have h1 := ovCalls_le G q.1.2.2
  have hq2 := ((mem_posSetJ G).1 hq).2
  have e : (rowKey n q.1 + 1) * (n + 2) ≤ rowKey n q'.1 * (n + 2) := Nat.mul_le_mul_right _ h
  unfold posKey
  rw [Nat.add_mul, one_mul] at e
  omega

theorem rowKey_lt_same_layer {s : Fin N} {L : Fin 2} {u v : Fin n} (h : u < v) :
    rowKey n (s, L, u) < rowKey n (s, L, v) := by
  unfold rowKey; simp only; rw [Fin.lt_def] at h; omega

theorem rowKey_lt_lower_top (s : Fin N) (u v : Fin n) : rowKey n (s, (0 : Fin 2), u) < rowKey n (s, (1 : Fin 2), v) := by
  have hu := u.isLt
  unfold rowKey
  simp only [Fin.val_zero, Fin.val_one, add_zero]
  rw [Nat.add_mul, one_mul]
  omega

/-- **At most `N·n(n+1)` honest positions**: row `v` has at most `v + 1` calls. -/
theorem card_posSetJ_le : (posSetJ G N).card ≤ N * (n * (n + 1)) := by
  have hcall : ∀ v : Fin n, ovCalls G v ≤ v.val + 1 := by
    intro v
    unfold ovCalls parentsDesc
    rw [Finset.length_sort]
    have : (G.par v).card ≤ v.val :=
      calc (G.par v).card ≤ (Finset.range v.val).card :=
            Finset.card_le_card_of_injOn (fun u => u.val)
              (fun u hu => Finset.mem_range.2 (Fin.lt_def.1 (G.par_lt v u hu))) (fun a _ b _ h => Fin.ext h)
        _ = v.val := Finset.card_range _
    omega
  have hsub : posSetJ G N ⊆ Finset.univ.biUnion
      (fun ρ : Fin N × Fin 2 × Fin n => (Finset.Icc 1 (ovCalls G ρ.2.2)).image (fun p => (ρ, p))) := by
    intro q hq
    obtain ⟨h1, h2⟩ := (mem_posSetJ G).1 hq
    exact Finset.mem_biUnion.2 ⟨q.1, Finset.mem_univ _, Finset.mem_image.2 ⟨q.2, Finset.mem_Icc.2 ⟨h1, h2⟩, rfl⟩⟩
  refine (Finset.card_le_card hsub).trans (Finset.card_biUnion_le.trans ?_)
  have htri : ∑ v : Fin n, (v.val + 1) * 2 = n * (n + 1) := by
    rw [← Finset.sum_mul, Fin.sum_univ_eq_sum_range (fun i => i + 1) n, Finset.sum_add_distrib, Finset.sum_const,
      Finset.card_range, smul_eq_mul, mul_one, add_mul, Finset.sum_range_id_mul_two]
    cases n with
    | zero => rfl
    | succ k => simp only [Nat.succ_sub_one]; ring
  calc ∑ ρ : Fin N × Fin 2 × Fin n, ((Finset.Icc 1 (ovCalls G ρ.2.2)).image (fun p => (ρ, p))).card
      ≤ ∑ ρ : Fin N × Fin 2 × Fin n, (ρ.2.2.val + 1) := Finset.sum_le_sum fun ρ _ => by
        refine Finset.card_image_le.trans ?_
        rw [Nat.card_Icc]
        have := hcall ρ.2.2
        omega
    _ = N * (2 * ∑ v : Fin n, (v.val + 1)) := by
        simp only [Fintype.sum_prod_type, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
    _ = N * (n * (n + 1)) := by rw [← htri, ← Finset.sum_mul]; ring

end Pos

/-! ## Honest inputs of the store, and their prefix stability -/

section Stable

variable {N n wc : ℕ} (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)

/-- The honest input of store position `q`. -/
noncomputable def xinJ (ω : P3COmega n wc) (q : (Fin N × Fin 2 × Fin n) × ℕ) : Bits (n * wc + (n * wc + 512)) :=
  (baseReplay tags G W q.1.1).xin ω q.1.2.1 q.1.2.2 q.2

/-- **Prefix stability.** With `P` fixed, if `π'` agrees with `π` at the honest inputs of every position before key
`k`, the honest inputs of every position up to key `k` agree. -/
theorem xin_stable (P : Tweak n → Equiv.Perm (Lab n wc)) {π π' : Equiv.Perm (Bits (n * wc + (n * wc + 512)))}
    (k : ℕ) (hag : ∀ q ∈ posSetJ G N, posKey n q < k → π' (xinJ tags G W (P, π) q) = π (xinJ tags G W (P, π) q)) :
    ∀ q ∈ posSetJ G N, posKey n q ≤ k → xinJ tags G W (P, π') q = xinJ tags G W (P, π) q := by
  rintro ⟨⟨s, L, v⟩, p⟩ hq hk
  obtain ⟨hp1, hpv⟩ := (mem_posSetJ G).1 hq
  simp only at hp1 hpv
  set R := baseReplay tags G W s
  -- agreement at every call of an earlier row of this segment
  have hrow : ∀ (L' : Fin 2) (u : Fin n), rowKey n (s, L', u) < rowKey n (s, L, v) →
      ∀ p', 1 ≤ p' → p' ≤ ovCalls R.G u → (P, π).2 (R.xin (P, π) L' u p') = (P, π').2 (R.xin (P, π) L' u p') := by
    intro L' u hlt p' hp1' hp'
    have hmem : ((s, L', u), p') ∈ posSetJ G N := (mem_posSetJ G).2 ⟨hp1', hp'⟩
    exact (hag _ hmem ((posKey_lt_of_rowKey G hmem hlt).trans_le hk)).symm
  have hc1 : ∀ u : Fin n, (L = 1 ∨ u < v) → R.c1 (P, π') u = R.c1 (P, π) u := by
    intro u hu
    refine c1_congr_le (ω := (P, π)) (ω' := (P, π')) R u (fun _ _ => rfl) (fun u' hu' p' hp1' hp' => ?_) u le_rfl
    refine hrow 0 u' ?_ p' hp1' hp'
    rcases hu with hL | huv
    · subst hL; exact rowKey_lt_lower_top s u' v
    · have : L = 0 ∨ L = 1 := by fin_cases L <;> simp
      rcases this with rfl | rfl
      · exact rowKey_lt_same_layer (lt_of_le_of_lt hu' huv)
      · exact rowKey_lt_lower_top s u' v
  have hblk : rowBlocks (R.lab (P, π') L) R.G v = rowBlocks (R.lab (P, π) L) R.G v := by
    refine Loc.rowBlocks_congr R.G v fun u hu => ?_
    have huv := R.G.par_lt v u hu
    have hL : L = 0 ∨ L = 1 := by fin_cases L <;> simp
    rcases hL with rfl | rfl
    · exact hc1 u (Or.inr huv)
    · have hall : R.c1 (P, π') = R.c1 (P, π) := funext fun u' => hc1 u' (Or.inl rfl)
      refine c2_congr_le (ω := (P, π)) (ω' := (P, π')) R hall u (fun _ _ => rfl) (fun u' hu' p' hp1' hp' => ?_) u
        le_rfl
      exact hrow 1 u' (rowKey_lt_same_layer (lt_of_le_of_lt hu' huv)) p' hp1' hp'
  show R.xin (P, π') L v p = R.xin (P, π) L v p
  unfold P3Replay.xin xinAt
  rw [hblk]
  congr 2
  refine (stAfter_congr π π' _ _ (p - 1) (by rw [rowBlocks_length]; show p - 1 ≤ ovCalls G v; omega)
    fun p' hp1' hp' => ?_).symm
  have hmem : ((s, L, v), p') ∈ posSetJ G N := (mem_posSetJ G).2 ⟨hp1', by show p' ≤ ovCalls G v; omega⟩
  have hlt : posKey n ((s, L, v), p') < posKey n ((s, L, v), p) := by unfold posKey; simp only; omega
  have := hag _ hmem (hlt.trans_le hk)
  exact this.symm

end Stable

/-! ## Honest `Π₂` coincidences, for a fixed `P` -/

section Honest

variable {N n wc : ℕ} (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)

/-- `a` and `b` share their honest input, and no two positions before `b` do. -/
def FirstCollJ (ω : P3COmega n wc) (a b : (Fin N × Fin 2 × Fin n) × ℕ) : Prop :=
  xinJ tags G W ω a = xinJ tags G W ω b ∧
    ∀ q ∈ posSetJ G N, ∀ q' ∈ posSetJ G N, posKey n q < posKey n q' → posKey n q' < posKey n b →
      xinJ tags G W ω q ≠ xinJ tags G W ω q'

/-- **A coincidence has a first one.** -/
theorem exists_firstColl {ω : P3COmega n wc} (h : HonestCollJ tags G W ω) :
    ∃ a ∈ posSetJ G N, ∃ b ∈ posSetJ G N, posKey n a < posKey n b ∧ FirstCollJ tags G W ω a b := by
  classical
  obtain ⟨s, s', L, L', v, v', p, p', hp1, hp, hp1', hp', hne, heq⟩ := h
  have hm : ((s, L, v), p) ∈ posSetJ G N := (mem_posSetJ G).2 ⟨hp1, hp⟩
  have hm' : ((s', L', v'), p') ∈ posSetJ G N := (mem_posSetJ G).2 ⟨hp1', hp'⟩
  have hkne : posKey n ((s, L, v), p) ≠ posKey n ((s', L', v'), p') := by
    intro hk
    have := posKey_inj G hm hm' hk
    simp only [Prod.mk.injEq] at this
    exact hne (by rw [this.1.1, this.1.2.1, this.1.2.2, this.2])
  have hP : ∃ k, ∃ a ∈ posSetJ G N, ∃ b ∈ posSetJ G N, posKey n a < posKey n b ∧ posKey n b = k ∧
      xinJ tags G W ω a = xinJ tags G W ω b := by
    rcases lt_or_gt_of_ne hkne with hlt | hlt
    · exact ⟨_, _, hm, _, hm', hlt, rfl, heq⟩
    · exact ⟨_, _, hm', _, hm, hlt, rfl, heq.symm⟩
  obtain ⟨a, ha, b, hb, hab, hbn, hxe⟩ := Nat.find_spec hP
  refine ⟨a, ha, b, hb, hab, hxe, fun q hq q' hq' hqq' hq'b hcoll => ?_⟩
  exact Nat.find_min hP (hbn ▸ hq'b) ⟨q, hq, q', hq', hqq', rfl, hcoll⟩

/-- The position whose output a first coincidence pins: `b`'s predecessor, or `a`'s if `b` is a first call. -/
def pinPos (a b : (Fin N × Fin 2 × Fin n) × ℕ) : (Fin N × Fin 2 × Fin n) × ℕ :=
  if 2 ≤ b.2 then (b.1, b.2 - 1) else (a.1, a.2 - 1)

/-- The value it is pinned to: `a`'s chained part, or `b`'s IV. -/
noncomputable def pinVal (ω : P3COmega n wc) (a b : (Fin N × Fin 2 × Fin n) × ℕ) : Bits (n * wc + 512) :=
  if 2 ≤ b.2 then ovH (xinJ tags G W ω a) else iv (domP3 (tags b.1.1) b.1.2.1 b.1.2.2)

/-- The honest inputs of the positions before key `k`. -/
noncomputable def earlierPts (ω : P3COmega n wc) (k : ℕ) : Finset (Bits (n * wc + (n * wc + 512))) :=
  ((posSetJ G N).filter (fun q => posKey n q < k)).image (xinJ tags G W ω)

theorem card_earlierPts_le (ω : P3COmega n wc) (k : ℕ) :
    (earlierPts tags G W ω k).card ≤ (posSetJ G N).card :=
  Finset.card_image_le.trans (Finset.card_filter_le _ _)

/-- A later call's chained part is its predecessor's output. -/
theorem ovH_xinJ_pred (ω : P3COmega n wc) {q : (Fin N × Fin 2 × Fin n) × ℕ} (hq : q ∈ posSetJ G N)
    (h2 : 2 ≤ q.2) : ovH (xinJ tags G W ω q) = ovH (ω.2 (xinJ tags G W ω (q.1, q.2 - 1))) := by
  obtain ⟨-, hq2⟩ := (mem_posSetJ G).1 hq
  obtain ⟨p, hp⟩ : ∃ p, q.2 = p + 1 := ⟨q.2 - 1, by omega⟩
  unfold xinJ
  rw [hp, (baseReplay tags G W q.1.1).xin_ovH ω (by omega) (by show p < ovCalls G q.1.2.2; omega)]
  show ovH (ω.2 _) = _
  simp only [Nat.add_sub_cancel]

/-- A first call's chained part is its IV. -/
theorem ovH_xinJ_one (ω : P3COmega n wc) {q : (Fin N × Fin 2 × Fin n) × ℕ} (h1 : q.2 = 1) :
    ovH (xinJ tags G W ω q) = iv (domP3 (tags q.1.1) q.1.2.1 q.1.2.2) := by
  unfold xinJ
  rw [h1, ovH_xin_one]
  rfl

variable {tags G W}

/-- **A first coincidence pins one output**, and the pinned input is new. -/
theorem firstColl_pin (htags : Function.Injective tags) (hn : n ≤ 2 ^ 255) {ω : P3COmega n wc}
    {a b : (Fin N × Fin 2 × Fin n) × ℕ} (ha : a ∈ posSetJ G N) (hb : b ∈ posSetJ G N)
    (hab : posKey n a < posKey n b) (hF : FirstCollJ tags G W ω a b) :
    (2 ≤ b.2 ∨ 2 ≤ a.2) ∧ ovH (ω.2 (xinJ tags G W ω (pinPos a b))) = pinVal tags G W ω a b ∧
      xinJ tags G W ω (pinPos a b) ∉ earlierPts tags G W ω (posKey n (pinPos a b)) := by
  obtain ⟨hxe, hfirst⟩ := hF
  obtain ⟨ha1, ha2⟩ := (mem_posSetJ G).1 ha
  obtain ⟨hb1, hb2⟩ := (mem_posSetJ G).1 hb
  have hcase : 2 ≤ b.2 ∨ 2 ≤ a.2 := by
    by_contra hno
    push Not at hno
    have hb1' : b.2 = 1 := by omega
    have ha1' : a.2 = 1 := by omega
    have hh := congrArg ovH hxe
    rw [ovH_xinJ_one tags G W ω ha1', ovH_xinJ_one tags G W ω hb1'] at hh
    have hlt := a.1.2.2.isLt
    have hlt' := b.1.2.2.isLt
    obtain ⟨h1, h2, h3⟩ := domP3_inj (by omega) (by omega) (iv_inj hh)
    have hrow : a.1 = b.1 := Prod.ext (htags h1) (Prod.ext h2 (Fin.ext h3))
    have : a = b := Prod.ext hrow (by omega)
    rw [this] at hab
    exact lt_irrefl _ hab
  have hpin_mem : pinPos a b ∈ posSetJ G N := by
    unfold pinPos
    split_ifs with h2
    · exact (mem_posSetJ G).2 ⟨by simp only; omega, by simp only; omega⟩
    · exact (mem_posSetJ G).2 ⟨by simp only; omega, by simp only; omega⟩
  have hpin_key : posKey n (pinPos a b) < posKey n b := by
    unfold pinPos posKey
    split_ifs with h2
    · simp only; omega
    · simp only; unfold posKey at hab; omega
  refine ⟨hcase, ?_, ?_⟩
  · unfold pinPos pinVal
    split_ifs with h2
    · rw [← ovH_xinJ_pred tags G W ω hb h2, hxe]
    · have hb1' : b.2 = 1 := by omega
      have ha2' : 2 ≤ a.2 := by omega
      rw [← ovH_xinJ_pred tags G W ω ha ha2', hxe, ovH_xinJ_one tags G W ω hb1']
  · intro hmem
    obtain ⟨q, hq, hqx⟩ := Finset.mem_image.1 hmem
    obtain ⟨hqs, hqk⟩ := Finset.mem_filter.1 hq
    exact hfirst q hqs _ hpin_mem hqk hpin_key hqx

/-- **With `P` fixed, one pair coincides first with probability at most `1/(2^{m+512} − M)`.** -/
theorem pr_firstColl_le (htags : Function.Injective tags) (hn : n ≤ 2 ^ 255) (P : Tweak n → Equiv.Perm (Lab n wc))
    {a b : (Fin N × Fin 2 × Fin n) × ℕ} (ha : a ∈ posSetJ G N) (hb : b ∈ posSetJ G N)
    (hab : posKey n a < posKey n b) :
    pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => FirstCollJ tags G W (P, π) a b) ≤
      (((2 ^ (n * wc + 512) - (posSetJ G N).card : ℕ) : ℝ≥0∞))⁻¹ := by
  by_cases hcase : 2 ≤ b.2 ∨ 2 ≤ a.2
  · have hpin_mem : pinPos a b ∈ posSetJ G N := by
      obtain ⟨ha1, ha2⟩ := (mem_posSetJ G).1 ha
      obtain ⟨hb1, hb2⟩ := (mem_posSetJ G).1 hb
      unfold pinPos
      split_ifs with h2
      · exact (mem_posSetJ G).2 ⟨by simp only; omega, by simp only; omega⟩
      · exact (mem_posSetJ G).2 ⟨by simp only; omega, by simp only; omega⟩
    refine pr_pin_le (r := n * wc) (c := 512) (fun π => xinJ tags G W (P, π) (pinPos a b))
      (fun π => pinVal tags G W (P, π) a b) (fun π => earlierPts tags G W (P, π) (posKey n (pinPos a b)))
      (posSetJ G N).card (fun π => card_earlierPts_le tags G W _ _) ?_ _
      (fun π hF => (firstColl_pin htags hn ha hb hab hF).2)
    intro π π' hag
    have hag' : ∀ q ∈ posSetJ G N, posKey n q < posKey n (pinPos a b) →
        π' (xinJ tags G W (P, π) q) = π (xinJ tags G W (P, π) q) := fun q hq hk =>
      hag _ (Finset.mem_image.2 ⟨q, Finset.mem_filter.2 ⟨hq, hk⟩, rfl⟩)
    refine ⟨xin_stable tags G W P _ hag' _ hpin_mem le_rfl, ?_⟩
    show pinVal tags G W (P, π') a b = pinVal tags G W (P, π) a b
    unfold pinVal
    split_ifs with h2
    · have hkey : posKey n a ≤ posKey n (pinPos a b) := by
        unfold pinPos posKey
        simp only [h2, ↓reduceIte]
        unfold posKey at hab
        omega
      rw [xin_stable tags G W P _ hag' _ ha hkey]
    · rfl
  · classical
    push Not at hcase
    have h0 : pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => FirstCollJ tags G W (P, π) a b) = 0 := by
      rw [pr_def, ENNReal.div_eq_zero_iff]
      left
      norm_cast
      rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      intro π _ hF
      have := (firstColl_pin htags hn ha hb hab hF).1
      omega
    rw [h0]
    exact bot_le

/-- **With `P` fixed, the honest coincidences have probability at most `(N·nPosC)²/2^{n·wc}`.** -/
theorem pr_honest_fixed_le (htags : Function.Injective tags) (hn : n ≤ 2 ^ 255) (Q : ℕ)
    (P : Tweak n → Equiv.Perm (Lab n wc)) :
    pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => HonestCollJ tags G W (P, π)) ≤
      (((N * nPosC n Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
  classical
  set M := (posSetJ G N).card with hM
  set pairs := (posSetJ G N ×ˢ posSetJ G N).filter (fun x => posKey n x.1 < posKey n x.2) with hpairs
  have hunion : pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => HonestCollJ tags G W (P, π)) ≤
      ∑ x ∈ pairs, pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => FirstCollJ tags G W (P, π) x.1 x.2) := by
    refine le_trans (pr_mono fun π hπ => ?_) (PousThm1Chain.pr_exists_le pairs (fun x π => FirstCollJ tags G W (P, π) x.1 x.2))
    obtain ⟨a, ha, b, hb, hab, hF⟩ := exists_firstColl tags G W hπ
    exact ⟨(a, b), Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨ha, hb⟩, hab⟩, hF⟩
  have hsum : ∑ x ∈ pairs, pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) =>
      FirstCollJ tags G W (P, π) x.1 x.2) ≤ pairs.card * (((2 ^ (n * wc + 512) - M : ℕ) : ℝ≥0∞))⁻¹ := by
    rw [← nsmul_eq_mul]
    refine Finset.sum_le_card_nsmul _ _ _ fun x hx => ?_
    obtain ⟨hx1, hx2⟩ := Finset.mem_filter.1 hx
    obtain ⟨ha, hb⟩ := Finset.mem_product.1 hx1
    exact pr_firstColl_le htags hn P ha hb hx2
  have hpairsM : pairs.card ≤ M ^ 2 := by
    rw [sq, hM, ← Finset.card_product]
    exact Finset.card_filter_le _ _
  have hMn : M ≤ N * nPosC n Q := by
    refine (card_posSetJ_le G).trans (Nat.mul_le_mul_left _ ?_)
    unfold nPosC
    omega
  by_cases h2M : 2 * M ≤ 2 ^ (n * wc + 512)
  · have hinv := inv_two_pow_sub_le h2M
    have hstep : 2 * ((2 : ℝ≥0∞) ^ (n * wc + 512))⁻¹ ≤ ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ := by
      rw [pow_add, ENNReal.mul_inv (Or.inl (pow_ne_zero _ two_ne_zero)) (Or.inl (ENNReal.pow_ne_top ENNReal.ofNat_ne_top)),
        mul_left_comm]
      refine mul_le_of_le_one_right bot_le ?_
      have h2 : (2 : ℝ≥0∞) ≤ 2 ^ 512 := le_self_pow₀ (by norm_num) (by norm_num)
      calc 2 * ((2 : ℝ≥0∞) ^ 512)⁻¹ ≤ 2 ^ 512 * ((2 : ℝ≥0∞) ^ 512)⁻¹ := by gcongr
        _ = 1 := ENNReal.mul_inv_cancel (pow_ne_zero _ two_ne_zero) (ENNReal.pow_ne_top ENNReal.ofNat_ne_top)
    calc pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => HonestCollJ tags G W (P, π))
        ≤ pairs.card * (((2 ^ (n * wc + 512) - M : ℕ) : ℝ≥0∞))⁻¹ := hunion.trans hsum
      _ ≤ (M ^ 2 : ℕ) * ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ :=
          mul_le_mul' (by exact_mod_cast hpairsM) (hinv.trans hstep)
      _ ≤ (((N * nPosC n Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
          rw [div_eq_mul_inv]
          exact mul_le_mul' (by exact_mod_cast Nat.pow_le_pow_left hMn 2) le_rfl
  · push Not at h2M
    refine (PousThm1Chain.pr_le_one _).trans ?_
    have hbig : 2 ^ (n * wc) ≤ (N * nPosC n Q) ^ 2 := by
      have h1 : 2 ^ (n * wc) ≤ 2 ^ (n * wc + 512) := Nat.pow_le_pow_right (by norm_num) (by omega)
      have h2 : 2 ^ (n * wc + 512) ≤ 2 * M := h2M.le
      have hM1 : 1 ≤ M := by
        rcases Nat.eq_zero_or_pos M with h | h
        · rw [h] at h2M; simp at h2M
        · exact h
      have h3 : 2 * M ≤ M ^ 2 ∨ M = 1 := by
        rcases Nat.lt_or_ge M 2 with h | h
        · right; omega
        · left; rw [sq]; exact Nat.mul_le_mul_right _ h
      rcases h3 with h3 | h3
      · calc 2 ^ (n * wc) ≤ M ^ 2 := h1.trans (h2.trans h3)
          _ ≤ (N * nPosC n Q) ^ 2 := Nat.pow_le_pow_left hMn 2
      · rw [h3] at h2
        have : 2 ^ (n * wc + 512) ≤ 2 := h2
        have h5 : n * wc + 512 ≤ 1 :=
          (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).1 (by rw [pow_one]; exact this)
        omega
    rw [ENNReal.le_div_iff_mul_le (Or.inl (pow_ne_zero _ two_ne_zero)) (Or.inl (ENNReal.pow_ne_top ENNReal.ofNat_ne_top)),
      one_mul]
    exact_mod_cast hbig

end Honest

/-! ## Label coincidences -/

/-- Lexicographic order from a quotient–remainder form. -/
theorem lex_of_lt {n A A' v v' : ℕ} (_hv : v < n) (hv' : v' < n) (h : A * n + v < A' * n + v') :
    A < A' ∨ (A = A' ∧ v < v') := by
  rcases lt_trichotomy A A' with h1 | h1 | h1
  · exact Or.inl h1
  · subst h1; right; exact ⟨rfl, by omega⟩
  · exfalso
    have : (A' + 1) * n ≤ A * n := Nat.mul_le_mul_right _ h1
    rw [Nat.add_mul, one_mul] at this
    omega

theorem card_lab (n wc : ℕ) : Fintype.card (Lab n wc) = 2 ^ (n * wc) := by
  simp only [Lab, Bits, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
  rw [← pow_mul, mul_comm]

section Labels

variable {N n wc : ℕ} (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)

/-- The label of store row `ρ`. -/
noncomputable def labJ (ω : P3COmega n wc) (ρ : Fin N × Fin 2 × Fin n) : Lab n wc :=
  (baseReplay tags G W ρ.1).lab ω ρ.2.1 ρ.2.2

/-- The `P` input of store row `ρ`. -/
noncomputable def pinJ (ω : P3COmega n wc) (ρ : Fin N × Fin 2 × Fin n) : Lab n wc :=
  if ρ.2.1 = 0 then (baseReplay tags G W ρ.1).pin1 ω ρ.2.2 else (baseReplay tags G W ρ.1).pin2 ω ρ.2.2

/-- The tweak of store row `ρ`. -/
def twJ (ρ : Fin N × Fin 2 × Fin n) : Tweak n := (tags ρ.1, ρ.2.1, ρ.2.2)

/-- **A label is its own tweak's permutation at its `P` input.** -/
theorem labJ_eq (ω : P3COmega n wc) (ρ : Fin N × Fin 2 × Fin n) :
    labJ tags G W ω ρ = ω.1 (twJ tags ρ) (pinJ tags G W ω ρ) := by
  obtain ⟨s, L, v⟩ := ρ
  unfold labJ pinJ twJ P3Replay.lab
  fin_cases L
  · exact (baseReplay tags G W s).c1_eq ω v
  · exact (baseReplay tags G W s).c2_eq ω v

variable {tags}

/-- **An earlier row's label does not read a later row's tweak.** -/
theorem labJ_upd (htags : Function.Injective tags) {a b : Fin N × Fin 2 × Fin n} (h : rowKey n a < rowKey n b)
    (ω : P3COmega n wc) (σ : Equiv.Perm (Lab n wc)) :
    labJ tags G W (upd (twJ tags b) ω σ) a = labJ tags G W ω a := by
  obtain ⟨sa, La, va⟩ := a
  obtain ⟨sb, Lb, vb⟩ := b
  have hva := va.isLt
  have hvb := vb.isLt
  have hlex := lex_of_lt hva hvb h
  have hLa := La.isLt
  have hLb := Lb.isLt
  -- a tweak of row `a`'s dependencies equals `b`'s only in the same segment
  have hseg : ∀ (L' : Fin 2) (u' : Fin n), ((tags sa, L', u') : Tweak n) = twJ tags (sb, Lb, vb) →
      sa = sb ∧ L' = Lb ∧ u' = vb := by
    intro L' u' he
    simp only [twJ, Prod.mk.injEq] at he
    exact ⟨htags he.1, he.2.1, he.2.2⟩
  set R := baseReplay tags G W sa
  unfold labJ P3Replay.lab
  fin_cases La
  · simp only
    refine c1_congr_le (ω := ω) (ω' := upd (twJ tags (sb, Lb, vb)) ω σ) R va (fun u' hu' => ?_)
      (fun _ _ _ _ _ => rfl) va le_rfl
    refine Function.update_of_ne (fun he => ?_) _ _
    obtain ⟨rfl, hL, hu⟩ := hseg 0 u' he
    subst hu
    rw [Fin.le_def] at hu'
    simp only at hlex
    rcases hlex with h1 | ⟨h1, h2⟩
    · omega
    · rw [← hL] at h1; simp at h1; omega
  · simp only [Fin.mk_one, one_ne_zero, ↓reduceIte]
    have hc1 : R.c1 (upd (twJ tags (sb, Lb, vb)) ω σ) = R.c1 ω := by
      refine c1_congr_all R (fun u' => Function.update_of_ne (fun he => ?_) _ _) (fun _ _ _ _ => rfl)
      obtain ⟨rfl, hL, -⟩ := hseg 0 u' he
      simp only at hlex
      rw [← hL] at hlex
      simp only [Fin.val_zero] at hlex
      omega
    refine c2_congr_le (ω := ω) (ω' := upd (twJ tags (sb, Lb, vb)) ω σ) R hc1 va (fun u' hu' => ?_)
      (fun _ _ _ _ _ => rfl) va le_rfl
    refine Function.update_of_ne (fun he => ?_) _ _
    obtain ⟨rfl, hL, hu⟩ := hseg 1 u' he
    subst hu
    rw [Fin.le_def] at hu'
    simp only at hlex
    rw [← hL] at hlex
    simp only [Fin.val_one] at hlex
    omega

/-- **A row's `P` input does not read its own tweak.** -/
theorem pinJ_upd (b : Fin N × Fin 2 × Fin n) (ω : P3COmega n wc) (σ : Equiv.Perm (Lab n wc)) :
    pinJ tags G W (upd (twJ tags b) ω σ) b = pinJ tags G W ω b := by
  obtain ⟨sb, Lb, vb⟩ := b
  set R := baseReplay tags G W sb
  unfold pinJ
  fin_cases Lb
  · simp only
    refine pin1_congr (ω := ω) (ω' := upd (twJ tags (sb, 0, vb)) ω σ) R vb (fun u' hu' => ?_) (fun _ _ _ _ _ => rfl)
    refine Function.update_of_ne (fun he => ?_) _ _
    simp only [twJ, Prod.mk.injEq] at he
    exact (ne_of_lt hu') he.2.2
  · simp only [Fin.mk_one, one_ne_zero, ↓reduceIte]
    have hc1 : R.c1 (upd (twJ tags (sb, 1, vb)) ω σ) = R.c1 ω := by
      refine c1_congr_all R (fun u' => Function.update_of_ne (fun he => ?_) _ _) (fun _ _ _ _ => rfl)
      simp only [twJ, Prod.mk.injEq] at he
      exact absurd he.2.1 (by decide)
    refine pin2_congr (ω := ω) (ω' := upd (twJ tags (sb, 1, vb)) ω σ) R hc1 vb (fun u' hu' => ?_)
      (fun _ _ _ _ _ => rfl)
    refine Function.update_of_ne (fun he => ?_) _ _
    simp only [twJ, Prod.mk.injEq] at he
    exact (ne_of_lt hu') he.2.2

/-- **Two rows' labels coincide with probability at most `1/2^{n·wc}`.** -/
theorem pr_labPair_le (htags : Function.Injective tags) {a b : Fin N × Fin 2 × Fin n} (h : rowKey n a < rowKey n b) :
    pr (fun ω : P3COmega n wc => labJ tags G W ω a = labJ tags G W ω b) ≤ ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ := by
  have hev : (fun ω : P3COmega n wc => labJ tags G W ω a = labJ tags G W ω b) =
      fun ω => ω.1 (twJ tags b) (pinJ tags G W ω b) = labJ tags G W ω a := by
    funext ω
    rw [labJ_eq tags G W ω b]
    exact propext eq_comm
  rw [hev]
  refine ((pr_congr_inst _ _ _).trans_le (pr_ppin_le (twJ tags b) (fun ω => pinJ tags G W ω b)
    (fun ω => labJ tags G W ω a) (fun ω σ => pinJ_upd G W b ω σ) (fun ω σ => labJ_upd G W htags h ω σ))).trans ?_
  rw [card_lab]
  push_cast
  exact le_rfl

open Classical in
/-- **The label coincidences have probability at most `(2Nn)²/2^{n·wc}`.** -/
theorem pr_lab_le (htags : Function.Injective tags) :
    pr (LabCollJ tags G W) ≤ (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
  set rows := (Finset.univ : Finset (Fin N × Fin 2 × Fin n))
  set pairs := (rows ×ˢ rows).filter (fun x => rowKey n x.1 < rowKey n x.2)
  have hunion : pr (LabCollJ tags G W) ≤
      ∑ x ∈ pairs, pr (fun ω : P3COmega n wc => labJ tags G W ω x.1 = labJ tags G W ω x.2) := by
    refine le_trans (pr_mono fun ω hω => ?_)
      (PousThm1Chain.pr_exists_le pairs (fun x (ω : P3COmega n wc) => labJ tags G W ω x.1 = labJ tags G W ω x.2))
    obtain ⟨s, s', L, L', v, v', hne, heq⟩ := hω
    have hk : rowKey n (s, L, v) ≠ rowKey n (s', L', v') := fun hk => hne (rowKey_inj hk)
    rcases lt_or_gt_of_ne hk with hlt | hlt
    · exact ⟨((s, L, v), (s', L', v')), Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨Finset.mem_univ _,
        Finset.mem_univ _⟩, hlt⟩, heq⟩
    · exact ⟨((s', L', v'), (s, L, v)), Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨Finset.mem_univ _,
        Finset.mem_univ _⟩, hlt⟩, heq.symm⟩
  have hsum : ∑ x ∈ pairs, pr (fun ω : P3COmega n wc => labJ tags G W ω x.1 = labJ tags G W ω x.2) ≤
      pairs.card * ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ := by
    rw [← nsmul_eq_mul]
    exact Finset.sum_le_card_nsmul _ _ _ fun x hx => pr_labPair_le G W htags (Finset.mem_filter.1 hx).2
  have hcard : pairs.card ≤ (2 * N * n) ^ 2 := by
    refine (Finset.card_filter_le _ _).trans (le_of_eq ?_)
    rw [Finset.card_product, Finset.card_univ, Fintype.card_prod, Fintype.card_prod, Fintype.card_fin,
      Fintype.card_fin, Fintype.card_fin]
    ring
  calc pr (LabCollJ tags G W) ≤ pairs.card * ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ := hunion.trans hsum
    _ ≤ (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
        rw [div_eq_mul_inv]
        exact mul_le_mul' (by exact_mod_cast hcard) le_rfl

end Labels

/-! ## The joint birthday -/

/-- **The honest coincidences, over both primitives**: average over `P`. -/
theorem pr_honest_le {N n wc : ℕ} {tags : Fin N → Bits 256} (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (htags : Function.Injective tags) (hn : n ≤ 2 ^ 255) (Q : ℕ) :
    pr (HonestCollJ tags G W) ≤ (((N * nPosC n Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) :=
  (pr_congr_inst _ (instFintypeProd _ _) _).trans_le
    (pr_le_of_forall_fst (fun x => HonestCollJ tags G W x) _ fun P => pr_honest_fixed_le htags hn Q P)

end Bday

/-- **`JointBirthday`, proved.** The joint collision event has probability at most the target's collision term,
with no `2^m` factor: it depends on the primitives alone. -/
theorem jointBirthday : JointBirthday := by
  intro N n wc Q tags G W htags hn
  show pr (fun ω => HonestCollJ tags G W ω ∨ LabCollJ tags G W ω) ≤ _
  refine (Bday.pr_or_le _ _).trans ((add_le_add (Bday.pr_honest_le G W htags hn Q) (Bday.pr_lab_le G W htags)).trans
    (le_of_eq ?_))
  rw [Nat.cast_add, ENNReal.add_div]

end PousP3ConcreteMulti

namespace PousP3ConcreteMulti

open Pous Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

/-- **The joint birthday at 14 GB**: `N = 971` segments of `B(220, 12)`, 64 KB labels, the implementation's tags
`tagR salt s`, `Q = 2^20`. -/
theorem jointBirthday_14GB (salt : Bits 192) (W : Fin 971 → Fin 220 → Lab 220 2384) :
    pr (JBad (fun s : Fin 971 => Pous.P3Meets.tagR salt s.val) (Pous.P3Column.bandGraph 220 12) W) ≤
      (((971 * nPosC 220 (2 ^ 20)) ^ 2 + (2 * 971 * 220) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (220 * 2384) :=
  jointBirthday 971 220 2384 (2 ^ 20) _ _ W (Pous.P3Meets.tagR_injective 971 (by norm_num) salt) (by norm_num)

end PousP3ConcreteMulti

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

/-- **The one-segment collision term** (`P3ChainEPF`'s `(nPosC² + (2n)²)/2^{n·wc}`): `jointBirthday` at `N = 1`. A
one-segment replay `R` has `R.xin = (baseReplay (fun _ => R.tag) R.G (fun _ => R.W) 0).xin` and likewise for its
labels (`xin_eq_base`, `lab_eq_base`, both `rfl`). -/
theorem jointBirthday_one {n wc : ℕ} (Q : ℕ) (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc)
    (hn : n ≤ 2 ^ 255) :
    pr (JBad (fun _ : Fin 1 => tag) G (fun _ => W)) ≤ (((nPosC n Q) ^ 2 + (2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
  have h := jointBirthday 1 n wc Q (fun _ : Fin 1 => tag) G (fun _ => W) (fun a b _ => Subsingleton.elim a b) hn
  simpa only [Nat.one_mul, Nat.mul_one] using h

end PousP3ConcreteMulti

end


/-! ════ P3Concrete.P3ChainCert ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The chain-column certificate: `P3ChainCert` (`X = 1` on `B(220, 12)` at `D = 10`)

**The clock invariant** (`inv_reach`), for any DAG and any holding `K₀`, after `t` rounds:
1. **Chaining values.** One on a row with no held `h` or pad `r` sits at call index `≤ t`.
2. **Reveals.** A known `r` whose call absorbs a block is held, or its block is already known.
3. **Keys.** A known key is seeded (a held `h` on its row, or its held pad `r`), or its row has `≤ t` calls, or its
   own label is known.
4. **Tops.** A known top is covered, or was computed at some `t' < t` from a clocked key and a known column.
   Covered means held, seeded, or the block of a held `r`.
5. **Lower columns.** A known entry `(w, u)` is held, or its lower row is covered, or row `w` has `≤ t − 1` calls, or
   top `u` was known with its key at some `t' < t`.

**The count** (`p3ChainHard_of_clock`).
- **Free tops.** A top that is not covered has a first time `t_u < D` at which its key is clocked and its column is
  known. At `t_u` its column's unheld entries are on covered lower rows or clocked lower rows. Minimality of `t_u`
  rules out the reversal case.
- **The attribution.** Each held item covers at most one top or lower row. So with `a` possible free tops and `b`
  clocked lower rows, every holding that knows all `n` tops costs at least `n² − a·b` columns.
- **At the deployment point.** `B(220, 12)`, `D = 10`: `a = 9` (rows `u ≤ 8`) and `b = 8` (rows `w ≤ 7`). So the
  cost is `220² − 72 ≥ 219·220`, which is `X = 1` (`p3ChainCert`).
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Sponge

namespace P3ChainKnow

variable {n : ℕ} (G : TopoDAG n)

/-! ### One round (moves, then the instantaneous closure), and monotonicity -/

theorem mem_step_tops (K : P3ChainKnow n) (u : Fin n) :
    u ∈ (K.step G).tops ↔ u ∈ K.tops ∨ ((K.keyKnown G 1 u ∧ K.colKnown u) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 1 ∧ ovBlock G p.2.1 p.2.2 = some u) ∨ ∀ w, (u, w) ∈ K.pc) := by
  simp only [step, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_step_cols (K : P3ChainKnow n) (w u : Fin n) :
    (w, u) ∈ (K.step G).cols ↔ (w, u) ∈ K.cols ∨ (K.keyKnown G 0 w ∨ (u ∈ K.tops ∧ K.keyKnown G 1 u) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 0 ∧ ovBlock G p.2.1 p.2.2 = some w) ∨ (u ∈ K.tops ∧ (u, w) ∈ K.kc)) := by
  simp only [step, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_step_hs (K : P3ChainKnow n) (L : Fin 2) (v : Fin n) (j : ℕ) :
    (L, v, j) ∈ (K.step G).hs ↔ (L, v, j) ∈ K.hs ∨ ((L, v, j) ∈ pos n ∧ (K.canCall G L v j ∨
      (1 ≤ j ∧ (L, v, j + 1) ∈ K.hs ∧ (L, v, j + 1) ∈ K.rs))) := by
  simp only [step, Finset.mem_union, Finset.mem_filter]

theorem mem_step_rs (K : P3ChainKnow n) (L : Fin 2) (v : Fin n) (j : ℕ) :
    (L, v, j) ∈ (K.step G).rs ↔ (L, v, j) ∈ K.rs ∨ ((L, v, j) ∈ pos n ∧ (K.canCall G L v j ∨
      (j = ovCalls G v ∧ ((L = 0 ∧ K.lowKnown v) ∨ (L = 1 ∧ v ∈ K.tops ∧ K.colKnown v))))) := by
  simp only [step, Finset.mem_union, Finset.mem_filter]

theorem mem_step_kc (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ (K.step G).kc ↔ (u, w) ∈ K.kc ∨ (u ∈ K.tops ∧ (w, u) ∈ K.cols) := by
  simp only [step, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_step_pc (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ (K.step G).pc ↔ (u, w) ∈ K.pc ∨ u ∈ K.tops := by
  simp only [step, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_kc1 (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ K.kc1 G ↔ (u, w) ∈ K.kc ∨ ((1 : Fin 2), u, ovCalls G u) ∈ K.rs := by
  simp only [kc1, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_asm_cols (K : P3ChainKnow n) (w u : Fin n) :
    (w, u) ∈ (K.assemble G).cols ↔ (w, u) ∈ K.cols ∨ ((u, w) ∈ K.pc ∧ (u, w) ∈ K.kc1 G) := by
  simp only [assemble, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_asm_kc (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ (K.assemble G).kc ↔ (u, w) ∈ K.kc1 G ∨ ((u, w) ∈ K.pc ∧ (w, u) ∈ K.cols) := by
  simp only [assemble, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_asm_pc (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ (K.assemble G).pc ↔ (u, w) ∈ K.pc ∨ ((w, u) ∈ K.cols ∧ (u, w) ∈ K.kc1 G) := by
  simp only [assemble, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_asm_rs (K : P3ChainKnow n) (L : Fin 2) (v : Fin n) (j : ℕ) :
    (L, v, j) ∈ (K.assemble G).rs ↔ (L, v, j) ∈ K.rs ∨
      (L = 1 ∧ j = ovCalls G v ∧ ∀ w, (v, w) ∈ K.kc1 G ∨ ((v, w) ∈ K.pc ∧ (w, v) ∈ K.cols)) := by
  classical
  simp only [assemble, Finset.mem_union, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro (h | ⟨v', hv', he⟩)
    · exact Or.inl h
    · simp only [Prod.mk.injEq] at he
      obtain ⟨rfl, rfl, rfl⟩ := he
      exact Or.inr ⟨rfl, rfl, hv'⟩
  · rintro (h | ⟨rfl, rfl, hv⟩)
    · exact Or.inl h
    · exact Or.inr ⟨v, hv, rfl⟩

theorem mem_round_tops (K : P3ChainKnow n) (u : Fin n) : u ∈ (K.round G).tops ↔ u ∈ (K.step G).tops := Iff.rfl

theorem mem_round_hs (K : P3ChainKnow n) (L : Fin 2) (v : Fin n) (j : ℕ) :
    (L, v, j) ∈ (K.round G).hs ↔ (L, v, j) ∈ (K.step G).hs := Iff.rfl

/-- `K ≤ K'`: every part of `K` is in `K'`. -/
def Le (K K' : P3ChainKnow n) : Prop :=
  K.tops ⊆ K'.tops ∧ K.cols ⊆ K'.cols ∧ K.hs ⊆ K'.hs ∧ K.rs ⊆ K'.rs ∧ K.kc ⊆ K'.kc ∧ K.pc ⊆ K'.pc

theorem le_step (K : P3ChainKnow n) : Le K (K.step G) :=
  ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left,
    Finset.subset_union_left, Finset.subset_union_left⟩

theorem le_assemble (K : P3ChainKnow n) : Le K (K.assemble G) :=
  ⟨subset_rfl, Finset.subset_union_left, subset_rfl, Finset.subset_union_left,
    Finset.subset_union_left.trans Finset.subset_union_left, Finset.subset_union_left⟩

theorem Le.trans {K K' K'' : P3ChainKnow n} (h : Le K K') (h' : Le K' K'') : Le K K'' :=
  ⟨h.1.trans h'.1, h.2.1.trans h'.2.1, h.2.2.1.trans h'.2.2.1, h.2.2.2.1.trans h'.2.2.2.1,
    h.2.2.2.2.1.trans h'.2.2.2.2.1, h.2.2.2.2.2.trans h'.2.2.2.2.2⟩

theorem le_round (K : P3ChainKnow n) : Le K (K.round G) := (le_step G K).trans (le_assemble G _)

theorem Le.labKnown {K K' : P3ChainKnow n} (h : Le K K') {L : Fin 2} {u : Fin n} (hu : K.labKnown L u) :
    K'.labKnown L u := by
  unfold P3ChainKnow.labKnown at hu ⊢
  split_ifs at hu ⊢ with hL
  · exact fun x => h.2.1 (hu x)
  · exact h.1 hu

theorem le_reach (K₀ : P3ChainKnow n) {t t' : ℕ} (htt : t ≤ t') : Le (reach G K₀ t) (reach G K₀ t') := by
  induction t', htt using Nat.le_induction with
  | base => exact ⟨subset_rfl, subset_rfl, subset_rfl, subset_rfl, subset_rfl, subset_rfl⟩
  | succ t' _ ih => exact ih.trans (le_round G _)

/-- A column entry made by the moves is in the round's knowledge. -/
theorem round_cols_of_step {K : P3ChainKnow n} {w u : Fin n} (h : (w, u) ∈ (K.step G).cols) :
    (w, u) ∈ (K.round G).cols := (le_assemble G _).2.1 h

/-- A dropped part made by the moves is in the round's knowledge. -/
theorem round_rs_of_step {K : P3ChainKnow n} {L : Fin 2} {v : Fin n} {j : ℕ} (h : (L, v, j) ∈ (K.step G).rs) :
    (L, v, j) ∈ (K.round G).rs := (le_assemble G _).2.2.2.1 h

theorem ovBlock_pad (v : Fin n) : ovBlock G v (ovCalls G v) = none := by
  unfold ovBlock ovCalls
  simp

/-! ### Seeds, coverage, and the invariant -/

variable (K₀ : P3ChainKnow n)

/-- Row `(L, v)` is seeded by `K₀`: a held chaining value on it, its held pad `r` (its key), or, for a top row, every
coordinate of its key held as a key component or a top-input component. -/
def RowSeed (L : Fin 2) (v : Fin n) : Prop :=
  (∃ j, 1 ≤ j ∧ (L, v, j) ∈ K₀.hs) ∨ (L, v, ovCalls G v) ∈ K₀.rs ∨
    (L = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc)

/-- Label `u` of layer `L` is the block of a call whose dropped `r` is held. -/
def Reveal (L : Fin 2) (u : Fin n) : Prop := ∃ v j, (L, v, j) ∈ K₀.rs ∧ ovBlock G v j = some u

/-- Top `u` is covered: held, seeded, or revealed. -/
def TopCov (u : Fin n) : Prop := u ∈ K₀.tops ∨ RowSeed G K₀ 1 u ∨ Reveal G K₀ 1 u

/-- Lower row `w` is covered: seeded or revealed. -/
def LowCov (w : Fin n) : Prop := RowSeed G K₀ 0 w ∨ Reveal G K₀ 0 w

/-- **The clock invariant** after `t` rounds. -/
def Inv (t : ℕ) : Prop :=
  (∀ L v j, (L, v, j) ∈ (reach G K₀ t).hs → 1 ≤ j → RowSeed G K₀ L v ∨ j ≤ t) ∧
  (∀ L v j u, (L, v, j) ∈ (reach G K₀ t).rs → ovBlock G v j = some u →
    (L, v, j) ∈ K₀.rs ∨ (reach G K₀ t).labKnown L u) ∧
  (∀ L v, (reach G K₀ t).keyKnown G L v → RowSeed G K₀ L v ∨ ovCalls G v ≤ t ∨ (reach G K₀ t).labKnown L v) ∧
  (∀ u, u ∈ (reach G K₀ t).tops → TopCov G K₀ u ∨ ∃ t' < t,
    (ovCalls G u ≤ t' ∧ (reach G K₀ t').colKnown u) ∨ ∀ w, (u, w) ∈ (reach G K₀ t').pc) ∧
  (∀ w u, (w, u) ∈ (reach G K₀ t).cols → (w, u) ∈ K₀.cols ∨ (u, w) ∈ K₀.pc ∨ LowCov G K₀ w ∨
    ovCalls G w + 1 ≤ t ∨ ∃ t' < t, u ∈ (reach G K₀ t').tops) ∧
  (∀ u w, (u, w) ∈ (reach G K₀ t).kc → (u, w) ∈ K₀.kc ∨ (u, w) ∈ K₀.pc ∨ (reach G K₀ t).keyKnown G 1 u ∨
    ∃ t' < t, u ∈ (reach G K₀ t').tops) ∧
  (∀ u w, (u, w) ∈ (reach G K₀ t).pc → (u, w) ∈ K₀.pc ∨
    ((w, u) ∈ (reach G K₀ t).cols ∧ (u, w) ∈ (reach G K₀ t).kc) ∨ ∃ t' < t, u ∈ (reach G K₀ t').tops)

theorem labKnown_one' (K : P3ChainKnow n) (u : Fin n) : K.labKnown 1 u ↔ u ∈ K.tops := by
  simp [P3ChainKnow.labKnown]

theorem labKnown_zero' (K : P3ChainKnow n) (u : Fin n) : K.labKnown 0 u ↔ K.lowKnown u := by
  simp [P3ChainKnow.labKnown]

theorem inv_zero : Inv G K₀ 0 := by
  have hR : reach G K₀ 0 = K₀.assemble G := rfl
  refine ⟨fun L v j h hj => Or.inl (Or.inl ⟨j, hj, h⟩), fun L v j u h hb => ?_, fun L v h => ?_,
    fun u h => Or.inl (Or.inl h), fun w u h => ?_, fun u w h => ?_, fun u w h => ?_⟩
  · rw [hR, mem_asm_rs] at h
    rcases h with h | ⟨_, hj, _⟩
    · exact Or.inl h
    · rw [hj, ovBlock_pad] at hb
      exact absurd hb (by simp)
  · unfold P3ChainKnow.keyKnown at h
    rw [hR, mem_asm_rs] at h
    rcases h with h | ⟨hL, _, hall⟩
    · exact Or.inl (Or.inr (Or.inl h))
    · subst hL
      by_cases hk : ((1 : Fin 2), v, ovCalls G v) ∈ K₀.rs
      · exact Or.inl (Or.inr (Or.inl hk))
      · refine Or.inl (Or.inr (Or.inr ⟨rfl, fun w => ?_⟩))
        rcases hall w with h1 | ⟨h1, _⟩
        · rcases (mem_kc1 G K₀ v w).1 h1 with h1 | h1
          · exact Or.inl h1
          · exact absurd h1 hk
        · exact Or.inr h1
  · rw [hR, mem_asm_cols] at h
    rcases h with h | ⟨h, _⟩
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
  · rw [hR, mem_asm_kc] at h
    rcases h with h | ⟨h, _⟩
    · rcases (mem_kc1 G K₀ u w).1 h with h | h
      · exact Or.inl h
      · exact Or.inr (Or.inr (Or.inl ((le_assemble G K₀).2.2.2.1 h)))
    · exact Or.inr (Or.inl h)
  · rw [hR, mem_asm_pc] at h
    rcases h with h | ⟨h1, h2⟩
    · exact Or.inl h
    · exact Or.inr (Or.inl ⟨(le_assemble G K₀).2.1 h1, (mem_asm_kc G K₀ u w).2 (Or.inl h2)⟩)

theorem inv_succ (t : ℕ) (hI : Inv G K₀ t) : Inv G K₀ (t + 1) := by
  obtain ⟨i1, i2a, i2b, i3, i4, i5, i6⟩ := hI
  set R := reach G K₀ t with hR
  set S := R.step G with hS
  have hRR : reach G K₀ (t + 1) = S.assemble G := rfl
  have hRS : Le R S := le_step G R
  have hSA : Le S (S.assemble G) := le_assemble G S
  have hle : Le R (S.assemble G) := hRS.trans hSA
  -- the earlier-top disjunct, lifted
  have lift : ∀ u, (∃ t' < t, u ∈ (reach G K₀ t').tops) → ∃ t' < t + 1, u ∈ (reach G K₀ t').tops :=
    fun u ⟨t', ht', h⟩ => ⟨t', by omega, h⟩
  have now : ∀ u, u ∈ R.tops → ∃ t' < t + 1, u ∈ (reach G K₀ t').tops := fun u h => ⟨t, by omega, h⟩
  -- a key known at the start of the round
  have keyR : ∀ v, R.keyKnown G 1 v → RowSeed G K₀ 1 v ∨ ovCalls G v ≤ t + 1 ∨ v ∈ R.tops := by
    intro v h
    rcases i2b 1 v h with h' | h' | h'
    · exact Or.inl h'
    · exact Or.inr (Or.inl (by omega))
    · exact Or.inr (Or.inr ((labKnown_one' R v).1 h'))
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- chaining values
    intro L v j h hj
    rw [hRR] at h
    change (L, v, j) ∈ S.hs at h
    rw [hS, mem_step_hs] at h
    rcases h with h | ⟨_, ⟨_, _, _, h1 | h1⟩ | ⟨_, h2, _⟩⟩
    · rcases i1 L v j h hj with h' | h'
      · exact Or.inl h'
      · exact Or.inr (by omega)
    · exact Or.inr (by omega)
    · rcases Nat.lt_or_ge (j - 1) 1 with hj1 | hj1
      · exact Or.inr (by omega)
      · rcases i1 L v (j - 1) h1 hj1 with h' | h'
        · exact Or.inl h'
        · exact Or.inr (by omega)
    · rcases i1 L v (j + 1) h2 (by omega) with h' | h'
      · exact Or.inl h'
      · exact Or.inr (by omega)
  · -- reveals
    intro L v j u h hb
    rw [hRR, mem_asm_rs, hS, mem_step_rs] at h
    rcases h with (h | ⟨_, ⟨_, _, hblk, _⟩ | ⟨hj, _⟩⟩) | ⟨_, hj, _⟩
    · rcases i2a L v j u h hb with h' | h'
      · exact Or.inl h'
      · exact Or.inr (hle.labKnown h')
    · exact Or.inr (hle.labKnown (hblk u hb))
    · rw [hj, ovBlock_pad] at hb
      exact absurd hb (by simp)
    · rw [hj, ovBlock_pad] at hb
      exact absurd hb (by simp)
  · -- keys
    have stepKey : ∀ L v, (L, v, ovCalls G v) ∈ S.rs →
        RowSeed G K₀ L v ∨ ovCalls G v ≤ t + 1 ∨ (S.assemble G).labKnown L v := by
      intro L v h
      rw [hS, mem_step_rs] at h
      rcases h with h | ⟨_, ⟨hj1, _, _, h1 | h1⟩ | ⟨_, h2 | h2⟩⟩
      · rcases i2b L v h with h' | h' | h'
        · exact Or.inl h'
        · exact Or.inr (Or.inl (by omega))
        · exact Or.inr (Or.inr (hle.labKnown h'))
      · exact Or.inr (Or.inl (by omega))
      · rcases Nat.lt_or_ge (ovCalls G v - 1) 1 with hj2 | hj2
        · exact Or.inr (Or.inl (by omega))
        · rcases i1 L v (ovCalls G v - 1) h1 hj2 with h' | h'
          · exact Or.inl h'
          · exact Or.inr (Or.inl (by omega))
      · obtain ⟨rfl, hk⟩ := h2
        exact Or.inr (Or.inr (hle.labKnown ((labKnown_zero' R v).2 hk)))
      · obtain ⟨rfl, hk, _⟩ := h2
        exact Or.inr (Or.inr (hle.labKnown ((labKnown_one' R v).2 hk)))
    intro L v h
    unfold P3ChainKnow.keyKnown at h
    rw [hRR, mem_asm_rs] at h
    rcases h with h | ⟨hL, _, hall⟩
    · exact stepKey L v h
    · subst hL
      by_cases hsk : ((1 : Fin 2), v, ovCalls G v) ∈ S.rs
      · exact stepKey 1 v hsk
      by_cases htop : v ∈ S.tops
      · exact Or.inr (Or.inr ((labKnown_one' _ v).2 htop))
      by_cases hclk : ovCalls G v ≤ t + 1
      · exact Or.inr (Or.inl hclk)
      by_cases hseed : RowSeed G K₀ 1 v
      · exact Or.inl hseed
      exfalso
      -- every coordinate is held as a key or input component
      have hRkc : ∀ w, (v, w) ∈ R.kc → (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc := by
        intro w hw
        rcases i5 v w hw with h' | h' | h' | h'
        · exact Or.inl h'
        · exact Or.inr h'
        · rcases keyR v h' with h'' | h'' | h''
          · exact absurd h'' hseed
          · exact absurd h'' hclk
          · exact absurd (hRS.1 h'') htop
        · obtain ⟨t', ht', h''⟩ := h'
          exact absurd ((le_reach G K₀ (show t' ≤ t by omega)).1 h'' |> hRS.1) htop
      have hall' : ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc := by
        intro w
        rcases hall w with h1 | ⟨h1, _⟩
        · rcases (mem_kc1 G S v w).1 h1 with h1 | h1
          · rcases (mem_step_kc G R v w).1 h1 with h1 | ⟨h1, _⟩
            · exact hRkc w h1
            · exact absurd (hRS.1 h1) htop
          · exact absurd h1 hsk
        · rcases (mem_step_pc G R v w).1 h1 with h1 | h1
          · rcases i6 v w h1 with h' | ⟨_, h'⟩ | ⟨t', ht', h'⟩
            · exact Or.inr h'
            · exact hRkc w h'
            · exact absurd ((le_reach G K₀ (show t' ≤ t by omega)).1 h' |> hRS.1) htop
          · exact absurd (hRS.1 h1) htop
      exact hseed (Or.inr (Or.inr ⟨rfl, hall'⟩))
  · -- tops
    intro u h
    rw [hRR] at h
    change u ∈ S.tops at h
    rw [hS, mem_step_tops] at h
    rcases h with h | ⟨hk, hc⟩ | ⟨p, hp, hpr, hp1, hb⟩ | hpc
    · rcases i3 u h with h' | ⟨t', ht', h''⟩
      · exact Or.inl h'
      · exact Or.inr ⟨t', by omega, h''⟩
    · rcases i2b 1 u hk with h' | h' | h'
      · exact Or.inl (Or.inr (Or.inl h'))
      · exact Or.inr ⟨t, by omega, Or.inl ⟨h', hc⟩⟩
      · rcases i3 u ((labKnown_one' R u).1 h') with h'' | ⟨t', ht', h3⟩
        · exact Or.inl h''
        · exact Or.inr ⟨t', by omega, h3⟩
    · obtain ⟨L, v, j⟩ := p
      simp only at hp1 hb
      subst hp1
      rcases i2a 1 v j u hpr hb with h' | h'
      · exact Or.inl (Or.inr (Or.inr ⟨v, j, h', hb⟩))
      · rcases i3 u ((labKnown_one' R u).1 h') with h'' | ⟨t', ht', h3⟩
        · exact Or.inl h''
        · exact Or.inr ⟨t', by omega, h3⟩
    · exact Or.inr ⟨t, by omega, Or.inr hpc⟩
  · -- lower columns
    have fromR : ∀ w u, (w, u) ∈ R.cols → (w, u) ∈ K₀.cols ∨ (u, w) ∈ K₀.pc ∨ LowCov G K₀ w ∨
        ovCalls G w + 1 ≤ t + 1 ∨ ∃ t' < t + 1, u ∈ (reach G K₀ t').tops := by
      intro w u hw
      rcases i4 w u hw with h' | h' | h' | h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inl h')
      · exact Or.inr (Or.inr (Or.inl h'))
      · exact Or.inr (Or.inr (Or.inr (Or.inl (by omega))))
      · exact Or.inr (Or.inr (Or.inr (Or.inr (lift u h'))))
    intro w u h
    rw [hRR, mem_asm_cols] at h
    rcases h with h | ⟨hp, _⟩
    · rw [hS, mem_step_cols] at h
      rcases h with h | hk | ⟨hu, _⟩ | ⟨p, hp, hpr, hp1, hb⟩ | ⟨hu, _⟩
      · exact fromR w u h
      · rcases i2b 0 w hk with h' | h' | h'
        · exact Or.inr (Or.inr (Or.inl (Or.inl h')))
        · exact Or.inr (Or.inr (Or.inr (Or.inl (by omega))))
        · exact fromR w u ((labKnown_zero' R w).1 h' u)
      · exact Or.inr (Or.inr (Or.inr (Or.inr (now u hu))))
      · obtain ⟨L, v, j⟩ := p
        simp only at hp1 hb
        subst hp1
        rcases i2a 0 v j w hpr hb with h' | h'
        · exact Or.inr (Or.inr (Or.inl (Or.inr ⟨v, j, h', hb⟩)))
        · exact fromR w u ((labKnown_zero' R w).1 h' u)
      · exact Or.inr (Or.inr (Or.inr (Or.inr (now u hu))))
    · rcases (mem_step_pc G R u w).1 hp with hp | hp
      · rcases i6 u w hp with h' | ⟨h', _⟩ | h'
        · exact Or.inr (Or.inl h')
        · exact fromR w u h'
        · exact Or.inr (Or.inr (Or.inr (Or.inr (lift u h'))))
      · exact Or.inr (Or.inr (Or.inr (Or.inr (now u hp))))
  · -- key components
    have fromRkc : ∀ u w, (u, w) ∈ R.kc → (u, w) ∈ K₀.kc ∨ (u, w) ∈ K₀.pc ∨
        (S.assemble G).keyKnown G 1 u ∨ ∃ t' < t + 1, u ∈ (reach G K₀ t').tops := by
      intro u w hw
      rcases i5 u w hw with h' | h' | h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inl h')
      · exact Or.inr (Or.inr (Or.inl (hle.2.2.2.1 h')))
      · exact Or.inr (Or.inr (Or.inr (lift u h')))
    intro u w h
    rw [hRR, mem_asm_kc] at h
    rcases h with h | ⟨hp, _⟩
    · rcases (mem_kc1 G S u w).1 h with h | h
      · rcases (mem_step_kc G R u w).1 h with h | ⟨hu, _⟩
        · exact fromRkc u w h
        · exact Or.inr (Or.inr (Or.inr (now u hu)))
      · exact Or.inr (Or.inr (Or.inl (hSA.2.2.2.1 h)))
    · rcases (mem_step_pc G R u w).1 hp with hp | hp
      · rcases i6 u w hp with h' | ⟨_, h'⟩ | h'
        · exact Or.inr (Or.inl h')
        · exact fromRkc u w h'
        · exact Or.inr (Or.inr (Or.inr (lift u h')))
      · exact Or.inr (Or.inr (Or.inr (now u hp)))
  · -- input components
    intro u w h
    rw [hRR, mem_asm_pc] at h
    rcases h with h | ⟨hc, hk⟩
    · rcases (mem_step_pc G R u w).1 h with h | h
      · rcases i6 u w h with h' | ⟨h1, h2⟩ | h'
        · exact Or.inl h'
        · exact Or.inr (Or.inl ⟨hle.2.1 h1, hle.2.2.2.2.1 h2⟩)
        · exact Or.inr (Or.inr (lift u h'))
      · exact Or.inr (Or.inr (now u h))
    · exact Or.inr (Or.inl ⟨hSA.2.1 hc, (mem_asm_kc G S u w).2 (Or.inl hk)⟩)

theorem inv_reach (t : ℕ) : Inv G K₀ t := by
  induction t with
  | zero => exact inv_zero G K₀
  | succ t ih => exact inv_succ G K₀ t ih

/-! ### Free tops -/

/-- **A known top that is not covered is free**: it is a row of at most `D − 1` calls, and each coordinate of its
column is held (as a column entry or a top-input component), on a covered lower row, or on a lower row of at most `D − 2`
calls. -/
theorem free_top (D : ℕ) (u : Fin n) (hu : u ∈ (reach G K₀ D).tops) (hc : ¬ TopCov G K₀ u) :
    ovCalls G u + 1 ≤ D ∧
      ∀ w, (w, u) ∈ K₀.cols ∨ (u, w) ∈ K₀.pc ∨ LowCov G K₀ w ∨ ovCalls G w + 2 ≤ D := by
  classical
  have hex : ∃ t', t' < D ∧ ((ovCalls G u ≤ t' ∧ (reach G K₀ t').colKnown u) ∨
      ∀ w, (u, w) ∈ (reach G K₀ t').pc) := by
    rcases (inv_reach G K₀ D).2.2.2.1 u hu with h | ⟨t', ht', h⟩
    · exact absurd h hc
    · exact ⟨t', ht', h⟩
  set t₀ := Nat.find hex with ht₀
  obtain ⟨hlt, hspec⟩ := Nat.find_spec hex
  have notop : ∀ t'' ≤ t₀, u ∉ (reach G K₀ t'').tops := by
    intro t'' ht'' h
    rcases (inv_reach G K₀ t'').2.2.2.1 u h with h' | ⟨t3, ht3, h3⟩
    · exact hc h'
    · exact Nat.find_min hex (show t3 < t₀ by omega) ⟨by omega, h3⟩
  have entry : ∀ w, (w, u) ∈ (reach G K₀ t₀).cols →
      (w, u) ∈ K₀.cols ∨ (u, w) ∈ K₀.pc ∨ LowCov G K₀ w ∨ ovCalls G w + 2 ≤ D := by
    intro w hw
    rcases (inv_reach G K₀ t₀).2.2.2.2.1 w u hw with h | h | h | h | ⟨t', ht', h⟩
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr (by omega)))
    · exact absurd h (notop t' (by omega))
  rcases hspec with ⟨hcl, hcol⟩ | hpc
  · exact ⟨by omega, fun w => entry w (hcol w)⟩
  · have hcoord : ∀ w, ((u, w) ∈ K₀.pc) ∨ ((w, u) ∈ (reach G K₀ t₀).cols ∧ (u, w) ∈ (reach G K₀ t₀).kc) := by
      intro w
      rcases (inv_reach G K₀ t₀).2.2.2.2.2.2 u w (hpc w) with h | h | ⟨t', ht', h⟩
      · exact Or.inl h
      · exact Or.inr h
      · exact absurd h (notop t' (by omega))
    refine ⟨?_, fun w => ?_⟩
    · by_contra hcl
      apply hc
      refine Or.inr (Or.inl (Or.inr (Or.inr ⟨rfl, fun w => ?_⟩)))
      rcases hcoord w with h | ⟨_, hk⟩
      · exact Or.inr h
      · rcases (inv_reach G K₀ t₀).2.2.2.2.2.1 u w hk with h' | h' | h' | ⟨t', ht', h'⟩
        · exact Or.inl h'
        · exact Or.inr h'
        · rcases (inv_reach G K₀ t₀).2.2.1 1 u h' with h'' | h'' | h''
          · exact absurd (Or.inr (Or.inl h'')) hc
          · exact absurd (show ovCalls G u + 1 ≤ D by omega) hcl
          · exact absurd ((labKnown_one' _ u).1 h'') (notop t₀ le_rfl)
        · exact absurd h' (notop t' (by omega))
    · rcases hcoord w with h | ⟨hw, _⟩
      · exact Or.inr (Or.inl h)
      · exact entry w hw

/-! ### The count -/

/-- The item a held `r` at call `j` of row `v` covers: its block, or the row itself for the pad call. -/
def rTarget (p : Fin 2 × Fin n × ℕ) : Fin n :=
  match ovBlock G p.2.1 p.2.2 with
  | some u => u
  | none => p.2.1

theorem card_filter_lt_le (a : ℕ) : (Finset.univ.filter fun u : Fin n => u.val < a).card ≤ a := by
  calc (Finset.univ.filter fun u : Fin n => u.val < a).card
      = ((Finset.univ.filter fun u : Fin n => u.val < a).image Fin.val).card :=
        (Finset.card_image_of_injective _ Fin.val_injective).symm
    _ ≤ (Finset.range a).card := Finset.card_le_card (fun x hx => by
        obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hx
        exact Finset.mem_range.2 (Finset.mem_filter.1 hy).2)
    _ = a := Finset.card_range a

open Classical in
/-- Covered rows of layer `L` lie in the image of that layer's held items, or have every key coordinate held. -/
theorem cov_subset (L : Fin 2) :
    (Finset.univ.filter fun v => RowSeed G K₀ L v ∨ Reveal G K₀ L v) ⊆
      ((K₀.hs.filter fun p => p.1 = L ∧ p.2.2 ≠ 0).image fun p => p.2.1) ∪
        ((K₀.rs.filter fun p => p.1 = L).image (rTarget G)) ∪
        (Finset.univ.filter fun v => L = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc) := by
  intro v hv
  rcases (Finset.mem_filter.1 hv).2 with (⟨j, hj, h⟩ | h | h) | ⟨v', j, h, hb⟩
  · exact Finset.mem_union_left _ (Finset.mem_union_left _
      (Finset.mem_image.2 ⟨(L, v, j), Finset.mem_filter.2 ⟨h, rfl, Nat.pos_iff_ne_zero.mp hj⟩, rfl⟩))
  · refine Finset.mem_union_left _ (Finset.mem_union_right _
      (Finset.mem_image.2 ⟨(L, v, ovCalls G v), Finset.mem_filter.2 ⟨h, rfl⟩, ?_⟩))
    simp only [rTarget, ovBlock_pad]
  · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩)
  · refine Finset.mem_union_left _ (Finset.mem_union_right _
      (Finset.mem_image.2 ⟨(L, v', j), Finset.mem_filter.2 ⟨h, rfl⟩, ?_⟩))
    simp only [rTarget, hb]

open Classical in
theorem card_cov_le (L : Fin 2) :
    (Finset.univ.filter fun v => RowSeed G K₀ L v ∨ Reveal G K₀ L v).card ≤
      (K₀.hs.filter fun p => p.1 = L ∧ p.2.2 ≠ 0).card + (K₀.rs.filter fun p => p.1 = L).card +
        (Finset.univ.filter fun v => L = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card :=
  (Finset.card_le_card (cov_subset G K₀ L)).trans ((Finset.card_union_le _ _).trans
    (add_le_add ((Finset.card_union_le _ _).trans (add_le_add Finset.card_image_le Finset.card_image_le)) le_rfl))

open Classical in
theorem card_comp_zero :
    (Finset.univ.filter fun v : Fin n => (0 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card = 0 := by
  rw [Finset.card_eq_zero]
  exact Finset.filter_false_of_mem fun v _ h => absurd h.1 (by decide)

open Classical in
/-- **The tops covered by components, and the free tops' held input components, are disjoint held items.** -/
theorem card_comp_le (F : Finset (Fin n)) (hF : ∀ u ∈ F, ¬ ∀ w, (u, w) ∈ K₀.kc ∨ (u, w) ∈ K₀.pc) :
    n * (Finset.univ.filter fun v : Fin n => (1 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card +
      (K₀.pc.filter fun q => q.1 ∈ F).card ≤ K₀.kc.card + K₀.pc.card := by
  set S3 := Finset.univ.filter fun v : Fin n => (1 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc
  have hAsub : S3 ×ˢ (Finset.univ : Finset (Fin n)) ⊆ K₀.kc ∪ K₀.pc := fun q hq => by
    obtain ⟨h1, _⟩ := Finset.mem_product.1 hq
    rcases (Finset.mem_filter.1 h1).2.2 q.2 with h | h
    · exact Finset.mem_union_left _ h
    · exact Finset.mem_union_right _ h
  have hBsub : (K₀.pc.filter fun q => q.1 ∈ F) ⊆ K₀.kc ∪ K₀.pc :=
    fun q hq => Finset.mem_union_right _ (Finset.mem_filter.1 hq).1
  have hdisj : Disjoint (S3 ×ˢ (Finset.univ : Finset (Fin n))) (K₀.pc.filter fun q => q.1 ∈ F) :=
    Finset.disjoint_left.2 fun q h1 h2 => by
      obtain ⟨h1, _⟩ := Finset.mem_product.1 h1
      exact hF q.1 (Finset.mem_filter.1 h2).2 (Finset.mem_filter.1 h1).2.2
  have h := Finset.card_le_card (Finset.union_subset hAsub hBsub)
  rw [Finset.card_union_of_disjoint hdisj, Finset.card_product, Finset.card_univ, Fintype.card_fin] at h
  have hu := Finset.card_union_le K₀.kc K₀.pc
  linarith [Nat.mul_comm n S3.card]

theorem card_layers_le {α : Type} [DecidableEq α] (s : Finset (Fin 2 × α)) (P : Fin 2 × α → Prop) [DecidablePred P] :
    (s.filter fun p => p.1 = 0 ∧ P p).card + (s.filter fun p => p.1 = 1 ∧ P p).card ≤ (s.filter P).card := by
  rw [← Finset.card_union_of_disjoint]
  · refine Finset.card_le_card fun p hp => ?_
    rcases Finset.mem_union.1 hp with h | h <;> exact Finset.mem_filter.2 ⟨(Finset.mem_filter.1 h).1, (Finset.mem_filter.1 h).2.2⟩
  · refine Finset.disjoint_left.2 fun p h1 h2 => ?_
    have := (Finset.mem_filter.1 h1).2.1
    have := (Finset.mem_filter.1 h2).2.1
    simp_all

/-- The free tops' held column entries are held entries. -/
theorem sum_cols_le (F : Finset (Fin n)) :
    ∑ u ∈ F, (Finset.univ.filter fun w => (w, u) ∈ K₀.cols).card ≤ K₀.cols.card := by
  classical
  have hbi : (F.biUnion fun u => (Finset.univ.filter fun w => (w, u) ∈ K₀.cols).image fun w => (w, u)) ⊆
      K₀.cols := by
    intro q hq
    obtain ⟨u, _, hq⟩ := Finset.mem_biUnion.1 hq
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.1 hq
    exact (Finset.mem_filter.1 hw).2
  refine le_trans (le_of_eq ?_) (Finset.card_le_card hbi)
  rw [Finset.card_biUnion]
  · exact Finset.sum_congr rfl fun u _ =>
      (Finset.card_image_of_injective _ fun w w' h => (Prod.mk.inj h).1).symm
  · intro u _ u' _ huu
    refine Finset.disjoint_left.2 fun q h1 h2 => huu ?_
    obtain ⟨w, _, rfl⟩ := Finset.mem_image.1 h1
    obtain ⟨w', _, h⟩ := Finset.mem_image.1 h2
    exact ((Prod.mk.inj h).2).symm

/-- The free tops' held input components are the held input components on free rows. -/
theorem sum_pc_le (F : Finset (Fin n)) :
    ∑ u ∈ F, (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).card ≤ (K₀.pc.filter fun q => q.1 ∈ F).card := by
  classical
  have hbi : (F.biUnion fun u => (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).image fun w => (u, w)) ⊆
      K₀.pc.filter fun q => q.1 ∈ F := by
    intro q hq
    obtain ⟨u, hu, hq⟩ := Finset.mem_biUnion.1 hq
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.1 hq
    exact Finset.mem_filter.2 ⟨(Finset.mem_filter.1 hw).2, hu⟩
  refine le_trans (le_of_eq ?_) (Finset.card_le_card hbi)
  rw [Finset.card_biUnion]
  · exact Finset.sum_congr rfl fun u _ =>
      (Finset.card_image_of_injective _ fun w w' h => (Prod.mk.inj h).2).symm
  · intro u _ u' _ huu
    refine Finset.disjoint_left.2 fun q h1 h2 => huu ?_
    obtain ⟨w, _, rfl⟩ := Finset.mem_image.1 h1
    obtain ⟨w', _, h⟩ := Finset.mem_image.1 h2
    exact ((Prod.mk.inj h).1).symm

/-- **The generic chain-column certificate.** If a top row of at most `D − 1` calls has index `< a`, and a lower row
of at most `D − 2` calls has index `< b`, then every holding that knows all `n` tops after `D` rounds costs at least
`n² − a·b` columns. So `P3ChainHard G c wc D n X` whenever `a·b ≤ X·n`. -/
theorem p3ChainHard_of_clock (c wc D a b X : ℕ) (ha : ∀ u : Fin n, ovCalls G u + 1 ≤ D → u.val < a)
    (hb : ∀ w : Fin n, ovCalls G w + 2 ≤ D → w.val < b) (hab : a * b ≤ X * n) :
    P3ChainHard G c wc D n X := by
  classical
  intro K₀ hk
  have hall : ∀ u : Fin n, u ∈ (reach G K₀ D).tops := by
    intro u
    by_contra hu
    have : ((reach G K₀ D).tops).card < n := by
      calc ((reach G K₀ D).tops).card < (Finset.univ : Finset (Fin n)).card :=
            Finset.card_lt_card (Finset.ssubset_iff_subset_ne.2 ⟨Finset.subset_univ _,
              fun he => hu (he ▸ Finset.mem_univ u)⟩)
        _ = n := by simp
    omega
  set F := Finset.univ.filter fun u => ¬ TopCov G K₀ u with hF
  set Lc := Finset.univ.filter fun w => RowSeed G K₀ 0 w ∨ Reveal G K₀ 0 w with hLc
  have hFa : F.card ≤ a := (Finset.card_le_card fun u hu =>
    Finset.mem_filter.2 ⟨Finset.mem_univ _, ha u (free_top G K₀ D u (hall u) (Finset.mem_filter.1 hu).2).1⟩).trans
      (card_filter_lt_le a)
  have hFn : F.card ≤ n := (Finset.card_le_univ F).trans (by simp)
  have hTop : n ≤ K₀.tops.card + ((K₀.hs.filter fun p => p.1 = 1 ∧ p.2.2 ≠ 0).card +
      (K₀.rs.filter fun p => p.1 = 1).card +
      (Finset.univ.filter fun v : Fin n => (1 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card) +
      F.card := by
    have hsplit : (Finset.univ : Finset (Fin n)) ⊆ K₀.tops ∪
        (Finset.univ.filter fun v => RowSeed G K₀ 1 v ∨ Reveal G K₀ 1 v) ∪ F := by
      intro u _
      by_cases hu : TopCov G K₀ u
      · rcases hu with h | h | h
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ h)
        · exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inl h⟩))
        · exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inr h⟩))
      · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hu⟩)
    have := Finset.card_le_card hsplit
    simp only [Finset.card_univ, Fintype.card_fin] at this
    have h2 := Finset.card_union_le (K₀.tops ∪ Finset.univ.filter fun v => RowSeed G K₀ 1 v ∨ Reveal G K₀ 1 v) F
    have h3 := Finset.card_union_le K₀.tops (Finset.univ.filter fun v => RowSeed G K₀ 1 v ∨ Reveal G K₀ 1 v)
    have h4 := card_cov_le G K₀ 1
    omega
  set PF := (K₀.pc.filter fun q => q.1 ∈ F).card with hPF
  have hCols : F.card * n ≤ K₀.cols.card + PF + F.card * (Lc.card + b) := by
    have hper : ∀ u ∈ F, n ≤ (Finset.univ.filter fun w => (w, u) ∈ K₀.cols).card +
        (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).card + (Lc.card + b) := by
      intro u hu
      have hfree := (free_top G K₀ D u (hall u) (Finset.mem_filter.1 hu).2).2
      have hsub : (Finset.univ : Finset (Fin n)) ⊆
          (Finset.univ.filter fun w => (w, u) ∈ K₀.cols) ∪
          (Finset.univ.filter fun w => (u, w) ∈ K₀.pc) ∪ Lc ∪
          (Finset.univ.filter fun w : Fin n => w.val < b) := by
        intro w _
        rcases hfree w with h | h | h | h
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
            (Finset.mem_filter.2 ⟨Finset.mem_univ _, by simpa using h⟩)))
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
            (Finset.mem_filter.2 ⟨Finset.mem_univ _, by simpa using h⟩)))
        · exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩))
        · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hb w h⟩)
      have := Finset.card_le_card hsub
      simp only [Finset.card_univ, Fintype.card_fin] at this
      have h1 := Finset.card_union_le ((Finset.univ.filter fun w => (w, u) ∈ K₀.cols) ∪
          (Finset.univ.filter fun w => (u, w) ∈ K₀.pc) ∪ Lc)
        (Finset.univ.filter fun w : Fin n => w.val < b)
      have h2 := Finset.card_union_le ((Finset.univ.filter fun w => (w, u) ∈ K₀.cols) ∪
          (Finset.univ.filter fun w => (u, w) ∈ K₀.pc)) Lc
      have h3 := Finset.card_union_le (Finset.univ.filter fun w => (w, u) ∈ K₀.cols)
          (Finset.univ.filter fun w => (u, w) ∈ K₀.pc)
      have h4 := card_filter_lt_le (n := n) b
      omega
    have hsC := sum_cols_le K₀ F
    have hsP := sum_pc_le K₀ F
    calc F.card * n = ∑ _u ∈ F, n := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ ∑ u ∈ F, ((Finset.univ.filter fun w => (w, u) ∈ K₀.cols).card +
            (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).card + (Lc.card + b)) :=
          Finset.sum_le_sum hper
      _ = ∑ u ∈ F, (Finset.univ.filter fun w => (w, u) ∈ K₀.cols).card +
            ∑ u ∈ F, (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).card +
            F.card * (Lc.card + b) := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_const, smul_eq_mul]
      _ ≤ K₀.cols.card + PF + F.card * (Lc.card + b) := add_le_add (add_le_add hsC hsP) le_rfl
  have hLow := card_cov_le G K₀ 0
  rw [card_comp_zero, Nat.add_zero] at hLow
  have hKP := card_comp_le K₀ F fun u hu hcov =>
    (Finset.mem_filter.1 hu).2 (Or.inr (Or.inl (Or.inr (Or.inr ⟨rfl, hcov⟩))))
  have hHs := card_layers_le K₀.hs fun p => p.2.2 ≠ 0
  have hRs : (K₀.rs.filter fun p => p.1 = 0).card + (K₀.rs.filter fun p => p.1 = 1).card ≤ K₀.rs.card := by
    have := card_layers_le K₀.rs fun _ => True
    simp only [and_true] at this
    rwa [Finset.filter_true_of_mem (fun _ _ => trivial)] at this
  have hsize : ((n : ℚ) * K₀.tops.card + K₀.cols.card + (n : ℚ) * (K₀.hs.filter fun p => p.2.2 ≠ 0).card +
      (n : ℚ) * K₀.rs.card + K₀.kc.card + K₀.pc.card) ≤ K₀.size c wc := by
    unfold P3ChainKnow.size
    have : (n : ℚ) * (K₀.hs.filter fun p => p.2.2 ≠ 0).card ≤
        ((n : ℚ) + (c : ℚ) / wc) * (K₀.hs.filter fun p => p.2.2 ≠ 0).card := by
      have : (0 : ℚ) ≤ (c : ℚ) / wc := by positivity
      nlinarith [(Nat.cast_nonneg (K₀.hs.filter fun p => p.2.2 ≠ 0).card : (0 : ℚ) ≤ _)]
    linarith
  refine le_trans ?_ hsize
  set T := K₀.tops.card
  set C := K₀.cols.card
  set f := F.card
  set il := Lc.card
  set Ht := (K₀.hs.filter fun p => p.1 = 1 ∧ p.2.2 ≠ 0).card
  set Hl := (K₀.hs.filter fun p => p.1 = 0 ∧ p.2.2 ≠ 0).card
  set Rt := (K₀.rs.filter fun p => p.1 = 1).card
  set Rl := (K₀.rs.filter fun p => p.1 = 0).card
  set Kt := (Finset.univ.filter fun v : Fin n => (1 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card
  have e1 : (n : ℚ) ≤ T + (Ht + Rt + Kt) + f := by exact_mod_cast hTop
  have e2 : (f : ℚ) * n ≤ C + PF + f * (il + b) := by exact_mod_cast hCols
  have e3 : (il : ℚ) ≤ Hl + Rl := by exact_mod_cast hLow
  have e4 : (Hl : ℚ) + Ht ≤ (K₀.hs.filter fun p => p.2.2 ≠ 0).card := by exact_mod_cast hHs
  have e5 : (Rl : ℚ) + Rt ≤ K₀.rs.card := by exact_mod_cast hRs
  have e6 : (f : ℚ) ≤ a := by exact_mod_cast hFa
  have e7 : (f : ℚ) ≤ n := by exact_mod_cast hFn
  have e8 : (a : ℚ) * b ≤ X * n := by exact_mod_cast hab
  have e9 : (n : ℚ) * Kt + PF ≤ K₀.kc.card + K₀.pc.card := by exact_mod_cast hKP
  have hb0 : (0 : ℚ) ≤ b := by positivity
  have hil0 : (0 : ℚ) ≤ il := by positivity
  rcases Nat.le_total X n with hXle | hXle
  · rw [Nat.cast_sub hXle]
    nlinarith [mul_le_mul_of_nonneg_right e6 hb0, mul_nonneg hil0 (sub_nonneg.2 e7),
      mul_le_mul_of_nonneg_left e4 (Nat.cast_nonneg n), mul_le_mul_of_nonneg_left e5 (Nat.cast_nonneg n),
      mul_le_mul_of_nonneg_left e3 (Nat.cast_nonneg n), mul_le_mul_of_nonneg_left e1 (Nat.cast_nonneg n)]
  · rw [Nat.sub_eq_zero_of_le hXle, Nat.cast_zero, zero_mul]
    positivity

end P3ChainKnow

/-! ### The deployment point -/

/-- On `B(220, k)`, a node at index `≥ m` with `m ≤ k` has at least `m` parents. -/
theorem card_par_band_ge {k : ℕ} (hk : 1 ≤ k) (v : Fin 220) (m : ℕ) (hm : m ≤ k) (hv : m ≤ v.val) :
    m ≤ ((Pous.P3Column.bandGraph 220 k).par v).card := by
  classical
  let f : Fin m → Fin 220 := fun i => ⟨v.val - 1 - i.val, by omega⟩
  have hf : Function.Injective f := fun i i' h => by
    have := congrArg Fin.val h
    simp only [f] at this
    exact Fin.ext (by omega)
  calc m = (Finset.univ.image f).card := by rw [Finset.card_image_of_injective _ hf]; simp
    _ ≤ _ := Finset.card_le_card fun u hu => by
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.1 hu
      rw [Pous.P3Column.mem_par_band hk]
      unfold Pous.P3Column.Band
      simp only [f]
      omega

theorem ovCalls_band_ge (v : Fin 220) (m : ℕ) (hm : m ≤ 12) (hv : m ≤ v.val) :
    m + 1 ≤ ovCalls (Pous.P3Column.bandGraph 220 12) v := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]
  have := card_par_band_ge (k := 12) (by norm_num) v m hm hv
  omega

/-- **The deployment certificate: `X = 1` on `B(220, 12)` at `D = 10`.** A free top is a row of at most 9 calls,
`u ≤ 8`, and a clocked lower row has at most 8, `w ≤ 7`, so `a·b = 9·8 = 72 ≤ 220`. -/
theorem p3ChainCert : P3ChainCert := by
  refine P3ChainKnow.p3ChainHard_of_clock _ 512 2384 10 9 8 1 (fun u hu => ?_) (fun w hw => ?_) (by norm_num)
  · by_contra h
    have := ovCalls_band_ge u 9 (by norm_num) (by omega)
    omega
  · by_contra h
    have := ovCalls_band_ge w 8 (by norm_num) (by omega)
    omega

/-- **The generic certificate at the fallback `B(220, 16)`, `D = 12`**: `a = 11` (rows of at most 11 calls), `b = 10`,
`a·b = 110 ≤ 220`, so `X = 1` there too. -/
theorem card_par_band16_ge (v : Fin 220) (m : ℕ) (hm : m ≤ 16) (hv : m ≤ v.val) :
    m + 1 ≤ ovCalls (Pous.P3Column.bandGraph 220 16) v := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]
  have := card_par_band_ge (k := 16) (by norm_num) v m hm hv
  omega

theorem p3ChainCert_band16 : P3ChainHard (Pous.P3Column.bandGraph 220 16) 512 2384 12 220 1 := by
  refine P3ChainKnow.p3ChainHard_of_clock _ 512 2384 12 11 10 1 (fun u hu => ?_) (fun w hw => ?_) (by norm_num)
  · by_contra h
    have := card_par_band16_ge u 11 (by norm_num) (by omega)
    omega
  · by_contra h
    have := card_par_band16_ge w 10 (by norm_num) (by omega)
    omega

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainSim ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The knowledge simulation over the chain (observation-round freshness)

The transcript-to-game simulation for P3 over the chain, in the observation-round form of `sponge-dense`'s
`ChainEPFReach` (`mem_reach_of_asked_obs`).
- **Freshness.** An item is fresh if some query or output shows it no later than the first round that reveals its point.
- **No collision hypothesis.** The simulation starts from an asked honest point. That fixes the chain position, so
  point coincidences need no case.

**The fresh items**, and where each goes in `P3ChainKnow`:
- `freshTop u`: `c²_u` is shown (a `Π₂` block, a `P⁻¹` input, or an output) by the first reveal of the top pair
  `(tag,1,u)`. It goes to top `u`.
- `freshLow w`: the same for `c¹_w` and the lower pair. It goes to all of lower label `w`'s columns.
- `freshH L v p` and `freshR L v p`: `h` or `r` of call `(L,v,p)` is shown (`Π₂` input or `Π₂⁻¹` payload) by the first
  reveal of `xin L v p`. They go to `hs` and `rs`.
- `freshKeyLow w`: the lower `P` input `W_w ⊕ key¹_w` is asked before the lower row's pad point is. So it shows the
  key; it goes to the pad `r`.
- **The top `P` input `transpose(c¹)_u ⊕ key²_u` is credited by the pad reveal** (the per-column reconciliation).
  - `freshPinTop u`: shown before the top row's pad point is revealed. The key is unknown, so the prediction is of
    `ℓ` bits; it goes to top `u`.
  - `freshCol w u`: shown after the pad reveal and before the lower pair `(tag,0,w)`'s. The key is known, so it
    predicts the `wc`-bit column entry `(w, u)`; it goes to column `(w, u)`.

**The theorems.**
- `sim`: an asked point is known in the game one round later, by strong induction on the round.
- `mem_reach_of_correct`: a correct output is a top known after `D` rounds.
- `win_price`: with `P3ChainHard`, a win of `k` tops forces a fresh holding priced at least `(k − X)·n` columns.
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge

namespace P3Replay

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) (ω : P3COmega n wc)

/-! ## Fresh items and the fresh holding -/

def freshTop (u : Fin n) : Prop :=
  ∃ τ, R.showsLab ω (R.c2 ω u) τ ∧ ∀ ρ < τ, ¬ R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ

def freshLow (w : Fin n) : Prop :=
  ∃ τ, R.showsLab ω (R.c1 ω w) τ ∧ ∀ ρ < τ, ¬ R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ

def freshH (L : Fin 2) (v : Fin n) (p : ℕ) : Prop :=
  ∃ τ, R.showsH ω (R.hval ω L v p) τ ∧ ∀ ρ < τ, ¬ R.askedS ω (R.xin ω L v p) ρ

def freshR (L : Fin 2) (v : Fin n) (p : ℕ) : Prop :=
  ∃ τ, R.showsR ω (R.rval ω L v p) τ ∧ ∀ ρ < τ, ¬ R.askedS ω (R.xin ω L v p) ρ

def freshKeyLow (w : Fin n) : Prop :=
  ∃ τ, R.showsPin ω (R.tag, 0, w) (R.pin1 ω w) τ ∧ (∀ ρ < τ, ¬ R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ) ∧
    ∀ ρ < τ, ¬ R.askedS ω (R.xin ω 0 w (ovCalls R.G w)) ρ

def freshPinTop (u : Fin n) : Prop :=
  ∃ τ, R.showsPin ω (R.tag, 1, u) (R.pin2 ω u) τ ∧ (∀ ρ < τ, ¬ R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ) ∧
    ∀ ρ < τ, ¬ R.askedS ω (R.xin ω 1 u (ovCalls R.G u)) ρ

def freshCol (w u : Fin n) : Prop :=
  ∃ τ, R.showsPin ω (R.tag, 1, u) (R.pin2 ω u) τ ∧ (∀ ρ < τ, ¬ R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ) ∧
    (∃ ρ < τ, R.askedS ω (R.xin ω 1 u (ovCalls R.G u)) ρ) ∧ ∀ ρ < τ, ¬ R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ

open Classical in
/-- **The fresh holding** in P3's chain game. -/
noncomputable def freshHolding : P3ChainKnow n where
  tops := Finset.univ.filter fun u => R.freshTop ω u ∨ R.freshPinTop ω u
  cols := Finset.univ.filter fun q => R.freshLow ω q.1 ∨ R.freshCol ω q.1 q.2
  hs := (P3ChainKnow.pos n).filter fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧ R.freshH ω p.1 p.2.1 p.2.2
  rs := (P3ChainKnow.pos n).filter fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
    (R.freshR ω p.1 p.2.1 p.2.2 ∨ (p.1 = 0 ∧ p.2.2 = ovCalls R.G p.2.1 ∧ R.freshKeyLow ω p.2.1))
  kc := ∅
  pc := ∅

/-- The game knowledge after `t` rounds from the fresh holding. -/
noncomputable abbrev K (t : ℕ) : P3ChainKnow n := P3ChainKnow.reach R.G (R.freshHolding ω) t

theorem mem_pos {L : Fin 2} {v : Fin n} {p : ℕ} (hp : p ≤ ovCalls R.G v) : (L, v, p) ∈ P3ChainKnow.pos n := by
  have := ovCalls_le R.G v
  simp only [P3ChainKnow.pos, Finset.mem_product, Finset.mem_univ, Finset.mem_range, true_and]
  omega

theorem holding_le (t : ℕ) : P3ChainKnow.Le (R.freshHolding ω) (R.K ω t) :=
  (P3ChainKnow.le_assemble R.G _).trans (P3ChainKnow.le_reach R.G (R.freshHolding ω) (Nat.zero_le t))

theorem K_le {t t' : ℕ} (h : t ≤ t') : P3ChainKnow.Le (R.K ω t) (R.K ω t') := P3ChainKnow.le_reach R.G _ h

theorem K_succ (t : ℕ) : R.K ω (t + 1) = (R.K ω t).round R.G := rfl

theorem labKnown_zero (K : P3ChainKnow n) (u : Fin n) : K.labKnown 0 u ↔ K.lowKnown u := by
  simp [P3ChainKnow.labKnown]

theorem labKnown_one (K : P3ChainKnow n) (u : Fin n) : K.labKnown 1 u ↔ u ∈ K.tops := by
  simp [P3ChainKnow.labKnown]

/-! ## The simulation -/

/-- **The simulation at round `ρ`**: a point first revealed at `ρ` is known in the game after `ρ + 1` rounds. -/
def SimAt (ρ : ℕ) : Prop :=
  (∀ (L : Fin 2) (v : Fin n) (p : ℕ), 1 ≤ p → p ≤ ovCalls R.G v → R.askedS ω (R.xin ω L v p) ρ →
      (L, v, p) ∈ (R.K ω (ρ + 1)).hs ∧ (L, v, p) ∈ (R.K ω (ρ + 1)).rs) ∧
  (∀ w, R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ → (R.K ω (ρ + 1)).lowKnown w) ∧
  (∀ u, R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ → u ∈ (R.K ω (ρ + 1)).tops)

section Step

variable {R ω} {ρ : ℕ} (ih : ∀ ρ' < ρ, R.SimAt ω ρ')
include ih

theorem known_lab (L : Fin 2) (u : Fin n) (hs : R.showsLab ω (R.lab ω L u) ρ) : (R.K ω ρ).labKnown L u := by
  classical
  by_cases hL : L = 0
  · subst hL
    rw [labKnown_zero]
    by_cases ha : ∃ ρ' < ρ, R.askedP ω (R.tag, 0, u) (R.pin1 ω u) ρ'
    · obtain ⟨ρ', hρ', ha⟩ := ha
      exact fun x => (R.K_le ω (show ρ' + 1 ≤ ρ by omega)).2.1 ((ih ρ' hρ').2.1 u ha x)
    · push Not at ha
      have hf : R.freshLow ω u := ⟨ρ, hs, fun ρ' h => ha ρ' h⟩
      exact fun x => (R.holding_le ω ρ).2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inl hf⟩)
  · have hL1 : L = 1 := by fin_cases L <;> simp_all
    subst hL1
    rw [labKnown_one]
    by_cases ha : ∃ ρ' < ρ, R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ'
    · obtain ⟨ρ', hρ', ha⟩ := ha
      exact (R.K_le ω (show ρ' + 1 ≤ ρ by omega)).1 ((ih ρ' hρ').2.2 u ha)
    · push Not at ha
      have hf : R.freshTop ω u := ⟨ρ, hs, fun ρ' h => ha ρ' h⟩
      exact (R.holding_le ω ρ).1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inl hf⟩)

theorem known_h (L : Fin 2) (v : Fin n) (p : ℕ) (hp1 : 1 ≤ p) (hp : p ≤ ovCalls R.G v)
    (hs : R.showsH ω (R.hval ω L v p) ρ) : (L, v, p) ∈ (R.K ω ρ).hs := by
  classical
  by_cases ha : ∃ ρ' < ρ, R.askedS ω (R.xin ω L v p) ρ'
  · obtain ⟨ρ', hρ', ha⟩ := ha
    exact (R.K_le ω (show ρ' + 1 ≤ ρ by omega)).2.2.1 ((ih ρ' hρ').1 L v p hp1 hp ha).1
  · push Not at ha
    exact (R.holding_le ω ρ).2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, ρ, hs, fun ρ' h => ha ρ' h⟩)

theorem known_key (L : Fin 2) (v : Fin n) (ha : ∃ ρ' < ρ, R.askedS ω (R.xin ω L v (ovCalls R.G v)) ρ') :
    (R.K ω ρ).keyKnown R.G L v := by
  obtain ⟨ρ', hρ', ha⟩ := ha
  have h1 : 1 ≤ ovCalls R.G v := by unfold ovCalls; omega
  exact (R.K_le ω (show ρ' + 1 ≤ ρ by omega)).2.2.2.1 ((ih ρ' hρ').1 L v _ h1 le_rfl ha).2

end Step

theorem sim_step (ρ : ℕ) (ih : ∀ ρ' < ρ, R.SimAt ω ρ') : R.SimAt ω ρ := by
  classical
  refine ⟨?_, ?_, ?_⟩
  · -- a `Π₂` point
    intro L v p hp1 hp ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst hρ
    rcases q with (x | y) | ⟨T, a | z⟩
    · -- forward: the call is made in round `ρ + 1`
      simp only [revS, Option.some_inj] at hrev
      subst hrev
      have hcall : (R.K ω ρe).canCall R.G L v p := by
        refine ⟨hp1, hp, fun u hb => known_lab ih L u ⟨v', Or.inl ⟨_, he, rfl, ?_⟩⟩, ?_⟩
        · simp only [showLab, R.xin_ovR ω hb, Equiv.symm_apply_apply]
        · rcases Nat.lt_or_ge p 2 with h2 | h2
          · exact Or.inl (by omega)
          · refine Or.inr (known_h ih L v (p - 1) (by omega) (by omega) ⟨v', _, he, rfl, ?_⟩)
            have := R.xin_ovH ω (L := L) (v := v) (p := p - 1) (by omega) (by omega)
            rw [Nat.sub_add_cancel (by omega)] at this
            simp only [showH, this]
      rw [R.K_succ]
      exact ⟨(P3ChainKnow.mem_step_hs _ _ _ _ _).2 (Or.inr ⟨R.mem_pos hp, Or.inl hcall⟩),
        P3ChainKnow.round_rs_of_step _ ((P3ChainKnow.mem_step_rs _ _ _ _ _).2 (Or.inr ⟨R.mem_pos hp, Or.inl hcall⟩))⟩
    · -- inverse: it shows the call's `r` and `h`
      simp only [revS, Option.some_inj] at hrev
      have hy : y = ω.2 (R.xin ω L v p) := by rw [← hrev, Equiv.apply_symm_apply]
      subst hy
      by_cases ha : ∃ ρ' < ρe, R.askedS ω (R.xin ω L v p) ρ'
      · obtain ⟨ρ', hρ', ha⟩ := ha
        have h := (ih ρ' hρ').1 L v p hp1 hp ha
        exact ⟨(R.K_le ω (show ρ' + 1 ≤ ρe + 1 by omega)).2.2.1 h.1,
          (R.K_le ω (show ρ' + 1 ≤ ρe + 1 by omega)).2.2.2.1 h.2⟩
      · push Not at ha
        have hH : R.freshH ω L v p := ⟨ρe, ⟨v', _, he, rfl, by simp only [showH]; rfl⟩, fun ρ' h => ha ρ' h⟩
        have hR : R.freshR ω L v p := ⟨ρe, ⟨v', _, he, rfl, by simp only [showR]; rfl⟩, fun ρ' h => ha ρ' h⟩
        exact ⟨(R.holding_le ω _).2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, hH⟩),
          (R.holding_le ω _).2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, Or.inl hR⟩)⟩
    · simp [revS] at hrev
    · simp [revS] at hrev
  · -- the lower pair
    intro w ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst hρ
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · -- forward: it needs the key; it shows `W ⊕ key` otherwise
      simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      by_cases hfirst : ∃ ρ' < ρe, R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ'
      · obtain ⟨ρ', hρ', hfa⟩ := hfirst
        exact fun x => (R.K_le ω (show ρ' + 1 ≤ ρe + 1 by omega)).2.1 ((ih ρ' hρ').2.1 w hfa x)
      push Not at hfirst
      have hkey : (R.K ω ρe).keyKnown R.G 0 w := by
        by_cases ha : ∃ ρ' < ρe, R.askedS ω (R.xin ω 0 w (ovCalls R.G w)) ρ'
        · exact known_key ih 0 w ha
        · push Not at ha
          have hf : R.freshKeyLow ω w := ⟨ρe, ⟨v', _, he, rfl, rfl⟩, fun ρ' h => hfirst ρ' h, fun ρ' h => ha ρ' h⟩
          have h1 : 1 ≤ ovCalls R.G w := by unfold ovCalls; omega
          exact (R.holding_le ω _).2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos le_rfl, h1, le_rfl,
            Or.inr ⟨rfl, rfl, hf⟩⟩)
      intro x
      rw [R.K_succ]
      exact P3ChainKnow.round_cols_of_step _ ((P3ChainKnow.mem_step_cols _ _ _ _).2 (Or.inr (Or.inl hkey)))
    · -- inverse: it shows `c¹_w`
      simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c1 ω w := by rw [R.c1_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      have := (labKnown_zero _ _).1 (known_lab ih 0 w ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩)
      exact fun x => (R.K_le ω (Nat.le_succ ρe)).2.1 (this x)
  · -- the top pair
    intro u ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst hρ
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · -- forward: the pad reveal decides the credit
      simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      by_cases hfirst : ∃ ρ' < ρe, R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ'
      · obtain ⟨ρ', hρ', hfa⟩ := hfirst
        exact (R.K_le ω (show ρ' + 1 ≤ ρe + 1 by omega)).1 ((ih ρ' hρ').2.2 u hfa)
      push Not at hfirst
      by_cases ha : ∃ ρ' < ρe, R.askedS ω (R.xin ω 1 u (ovCalls R.G u)) ρ'
      · have hkey := known_key ih 1 u ha
        have hcol : (R.K ω ρe).colKnown u := by
          intro w
          by_cases hb : ∃ ρ' < ρe, R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ'
          · obtain ⟨ρ', hρ', hb⟩ := hb
            exact (R.K_le ω (show ρ' + 1 ≤ ρe by omega)).2.1 ((ih ρ' hρ').2.1 w hb u)
          · push Not at hb
            have hf : R.freshCol ω w u := ⟨ρe, ⟨v', _, he, rfl, rfl⟩, fun ρ' h => hfirst ρ' h, ha, fun ρ' h => hb ρ' h⟩
            exact (R.holding_le ω _).2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inr hf⟩)
        rw [R.K_succ]
        exact (P3ChainKnow.mem_step_tops _ _ _).2 (Or.inr (Or.inl ⟨hkey, hcol⟩))
      · push Not at ha
        have hf : R.freshPinTop ω u := ⟨ρe, ⟨v', _, he, rfl, rfl⟩, fun ρ' h => hfirst ρ' h, fun ρ' h => ha ρ' h⟩
        exact (R.holding_le ω _).1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inr hf⟩)
    · -- inverse: it shows `c²_u`
      simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c2 ω u := by rw [R.c2_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      have := (labKnown_one _ _).1 (known_lab ih 1 u ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩)
      exact (R.K_le ω (Nat.le_succ ρe)).1 this

/-- **The knowledge simulation**: at every round, a revealed point is known in the game one round later. -/
theorem sim (ρ : ℕ) : R.SimAt ω ρ := by
  induction ρ using Nat.strong_induction_on with
  | _ ρ ih => exact R.sim_step ω ρ ih

/-- **A correct output is known after `D` rounds**: it is fresh, or its top pair was revealed earlier. -/
theorem mem_reach_of_correct (hA : ∀ i, (R.A i).Bounded R.D R.Q) (i : ι) (v : Fin n)
    (hv : (R.A i).run ((p3ChainModel n wc).answer ω) = R.c2 ω v) : v ∈ (R.K ω R.D).tops := by
  classical
  have hd := (hA i ω).1
  set τ := (R.A i).depth ((p3ChainModel n wc).answer ω)
  by_cases ha : ∃ ρ < τ, R.askedP ω (R.tag, 1, v) (R.pin2 ω v) ρ
  · obtain ⟨ρ, hρ, ha⟩ := ha
    exact (R.K_le ω (show ρ + 1 ≤ R.D by omega)).1 ((R.sim ω ρ).2.2 v ha)
  · push Not at ha
    have hf : R.freshTop ω v := ⟨τ, ⟨i, Or.inr ⟨hv, rfl⟩⟩, fun ρ h => ha ρ h⟩
    exact (R.holding_le ω _).1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inl hf⟩)

/-- **A win forces a costly fresh holding**: with `P3ChainHard`, `k` correct tops give a fresh holding priced at
least `(k − X)·n` columns. -/
theorem win_price (hA : ∀ i, (R.A i).Bounded R.D R.Q) (out : Fin n → ι) {c k X : ℕ}
    (hard : P3ChainHard R.G c wc R.D k X)
    (hk : k ≤ (Finset.univ.filter fun v => (R.A (out v)).run ((p3ChainModel n wc).answer ω) = R.c2 ω v).card) :
    (((k - X : ℕ) : ℚ) * n) ≤ (R.freshHolding ω).size c wc := by
  classical
  refine hard _ (hk.trans (Finset.card_le_card fun v hv => ?_))
  exact R.mem_reach_of_correct ω hA (out v) v (Finset.mem_filter.1 hv).2

end P3Replay

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainOnline ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Online, game-closed freshness, and the simulation by construction

The freshness of `proof-technique-decision.md` (online, closed under the game). The holding is built round by round.
- **What a round shows.** `shownAt τ` is round `τ`'s shows, as game items, one coordinate or one whole permutation value
  each:
  - a shown label: a top, or a lower label's entries;
  - a shown chaining value or dropped part;
  - a lower input `W ⊕ key¹`: the lower row's key;
  - a top input `pin2 u`: its components `pc (u, ·)`;
  - a top row's pad `r` (a `Π₂⁻¹` payload): its key components `kc (u, ·)`.
  Derivability is left to the difference with `Kon τ`, over the (A′) closure.
- **The holding.** `onlineH (τ + 1)` adds to `onlineH τ` what round `τ` shows and `Kon τ = reach (onlineH τ) τ` does
  not already know. So an item joins only when it is not derivable, by the game, from the items that joined before.

**The simulation holds by construction** (`simOn`).
- Every value shown at `ρ` is in `reach (onlineH (ρ + 1)) ρ` (`shown_le`).
- So every point revealed at `ρ` is in the game one round later. Its inputs are shown values; an inverse query's payload
  is a shown `(r, h)`.
- `mem_reach_of_correct_on`: a correct output lies in `reach (onlineH (D + 1)) D`.
- `win_price_on`: with `P3ChainHard`, a win of `k` tops forces an online holding priced at least `(k − X)·n`.
- `mem_onlineH`: an item of the holding joined at some round `τ ≤ D`, shown at `τ` and not in `Kon τ`. This is what the
  attribution needs.
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge

namespace P3ChainKnow

variable {n : ℕ} (G : TopoDAG n)

def empty : P3ChainKnow n := ⟨∅, ∅, ∅, ∅, ∅, ∅⟩

def union (A B : P3ChainKnow n) : P3ChainKnow n :=
  ⟨A.tops ∪ B.tops, A.cols ∪ B.cols, A.hs ∪ B.hs, A.rs ∪ B.rs, A.kc ∪ B.kc, A.pc ∪ B.pc⟩

open Classical in
/-- **What a round adds**: the shows `S` that `K` does not know, closed against each other under the instantaneous
XOR. Columns join first. A top-key component is dropped when this round's column and a known `pin2` component give it;
a `pin2` component is dropped when its column and key component are known or shown. So no triple
`(entry, kc, pc)` gains two items from one guess. -/
noncomputable def fresh (S K : P3ChainKnow n) : P3ChainKnow n where
  tops := S.tops \ K.tops
  cols := S.cols \ K.cols
  hs := S.hs \ K.hs
  rs := S.rs \ K.rs
  kc := (S.kc \ K.kc).filter fun q => ¬ ((q.2, q.1) ∈ S.cols ∧ q ∈ K.pc)
  pc := (S.pc \ K.pc).filter fun q => ¬ ((q.2, q.1) ∈ K.cols ∪ S.cols ∧ q ∈ K.kc ∪ S.kc)

theorem fresh_sub (S K : P3ChainKnow n) :
    (∀ x ∈ (fresh S K).tops, x ∈ S.tops ∧ x ∉ K.tops) ∧ (∀ x ∈ (fresh S K).cols, x ∈ S.cols ∧ x ∉ K.cols) ∧
    (∀ x ∈ (fresh S K).hs, x ∈ S.hs ∧ x ∉ K.hs) ∧ (∀ x ∈ (fresh S K).rs, x ∈ S.rs ∧ x ∉ K.rs) ∧
    (∀ x ∈ (fresh S K).kc, x ∈ S.kc ∧ x ∉ K.kc) ∧ (∀ x ∈ (fresh S K).pc, x ∈ S.pc ∧ x ∉ K.pc) := by
  refine ⟨fun x hx => Finset.mem_sdiff.1 hx, fun x hx => Finset.mem_sdiff.1 hx, fun x hx => Finset.mem_sdiff.1 hx,
    fun x hx => Finset.mem_sdiff.1 hx, fun x hx => Finset.mem_sdiff.1 (Finset.mem_filter.1 hx).1,
    fun x hx => Finset.mem_sdiff.1 (Finset.mem_filter.1 hx).1⟩

/-- **An assembled holding is XOR-closed** (column and `pin2` give the key component). -/
theorem asm_closed_kc (X : P3ChainKnow n) {u w : Fin n} (hc : (w, u) ∈ (X.assemble G).cols)
    (hp : (u, w) ∈ (X.assemble G).pc) : (u, w) ∈ (X.assemble G).kc := by
  rw [mem_asm_cols] at hc
  rw [mem_asm_pc] at hp
  rw [mem_asm_kc]
  rcases hc with hc | ⟨_, hk⟩
  · rcases hp with hp | ⟨_, hk⟩
    · exact Or.inr ⟨hp, hc⟩
    · exact Or.inl hk
  · exact Or.inl hk

/-- **An assembled holding is XOR-closed** (column and key component give the `pin2` component). -/
theorem asm_closed_pc (X : P3ChainKnow n) {u w : Fin n} (hc : (w, u) ∈ (X.assemble G).cols)
    (hk : (u, w) ∈ (X.assemble G).kc) : (u, w) ∈ (X.assemble G).pc := by
  rw [mem_asm_cols] at hc
  rw [mem_asm_kc] at hk
  rw [mem_asm_pc]
  rcases hc with hc | ⟨hp, _⟩
  · rcases hk with hk | ⟨hp, _⟩
    · exact Or.inr ⟨hc, hk⟩
    · exact Or.inl hp
  · exact Or.inl hp

/-- Every reach is an assembled holding. -/
theorem reach_asm (K₀ : P3ChainKnow n) (t : ℕ) : ∃ X : P3ChainKnow n, reach G K₀ t = X.assemble G := by
  cases t with
  | zero => exact ⟨K₀, rfl⟩
  | succ t => exact ⟨(reach G K₀ t).step G, rfl⟩

theorem reach_closed_kc (K₀ : P3ChainKnow n) (t : ℕ) {u w : Fin n} (hc : (w, u) ∈ (reach G K₀ t).cols)
    (hp : (u, w) ∈ (reach G K₀ t).pc) : (u, w) ∈ (reach G K₀ t).kc := by
  obtain ⟨X, hX⟩ := reach_asm G K₀ t
  rw [hX] at hc hp ⊢
  exact asm_closed_kc G X hc hp

theorem reach_closed_pc (K₀ : P3ChainKnow n) (t : ℕ) {u w : Fin n} (hc : (w, u) ∈ (reach G K₀ t).cols)
    (hk : (u, w) ∈ (reach G K₀ t).kc) : (u, w) ∈ (reach G K₀ t).pc := by
  obtain ⟨X, hX⟩ := reach_asm G K₀ t
  rw [hX] at hc hk ⊢
  exact asm_closed_pc G X hc hk

/-- In an assembled holding, a whole top key gives each of its components. -/
theorem asm_kc_of_key (X : P3ChainKnow n) {u w : Fin n} (hr : ((1 : Fin 2), u, ovCalls G u) ∈ (X.assemble G).rs) :
    (u, w) ∈ (X.assemble G).kc := by
  rw [mem_asm_rs] at hr
  rw [mem_asm_kc]
  rcases hr with hr | ⟨_, _, hall⟩
  · exact Or.inl ((mem_kc1 G _ u w).2 (Or.inr hr))
  · rcases hall w with h | h
    · exact Or.inl h
    · exact Or.inr h

/-- In an assembled holding, a top key whose components are all known is itself known. -/
theorem asm_key_of_kc (X : P3ChainKnow n) {u : Fin n} (hk : ∀ w, (u, w) ∈ (X.assemble G).kc) :
    ((1 : Fin 2), u, ovCalls G u) ∈ (X.assemble G).rs := by
  rw [mem_asm_rs]
  refine Or.inr ⟨rfl, rfl, fun w => ?_⟩
  have := hk w
  rw [mem_asm_kc] at this
  exact this

/-- **The closure is idempotent**: assembling an assembled holding adds nothing. -/
theorem asm_idem (X : P3ChainKnow n) : Le ((X.assemble G).assemble G) (X.assemble G) := by
  set A := X.assemble G
  have hkc1 : ∀ {u w : Fin n}, (u, w) ∈ A.kc1 G → (u, w) ∈ A.kc := fun {u w} h => by
    rcases (mem_kc1 G A u w).1 h with h | h
    · exact h
    · exact asm_kc_of_key G X h
  refine ⟨fun x hx => hx, fun q hq => ?_, fun p hp => hp, fun p hp => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · obtain ⟨w, u⟩ := q
    rcases (mem_asm_cols G A w u).1 hq with h | ⟨hp, hk⟩
    · exact h
    · have hk' := hkc1 hk
      rw [mem_asm_pc] at hp
      rw [mem_asm_kc] at hk'
      rw [mem_asm_cols]
      rcases hp with hp | ⟨hc, _⟩
      · rcases hk' with hk' | ⟨_, hc⟩
        · exact Or.inr ⟨hp, hk'⟩
        · exact Or.inl hc
      · exact Or.inl hc
  · obtain ⟨L, v, j⟩ := p
    rcases (mem_asm_rs G A L v j).1 hp with h | ⟨hL, hj, hall⟩
    · exact h
    · subst hL; subst hj
      refine asm_key_of_kc G X fun w => ?_
      rcases hall w with h | ⟨hp, hc⟩
      · exact hkc1 h
      · exact asm_closed_kc G X hc hp
  · obtain ⟨u, w⟩ := q
    rcases (mem_asm_kc G A u w).1 hq with h | ⟨hp, hc⟩
    · exact hkc1 h
    · exact asm_closed_kc G X hc hp
  · obtain ⟨u, w⟩ := q
    rcases (mem_asm_pc G A u w).1 hq with h | ⟨hc, hk⟩
    · exact h
    · exact asm_closed_pc G X hc (hkc1 hk)

/-- **Every reach is closed under the instantaneous closure.** -/
theorem reach_asm_le (K₀ : P3ChainKnow n) (t : ℕ) : Le ((reach G K₀ t).assemble G) (reach G K₀ t) := by
  obtain ⟨X, hX⟩ := reach_asm G K₀ t
  rw [hX]
  exact asm_idem G X

theorem Le.rfl' (K : P3ChainKnow n) : Le K K :=
  ⟨subset_rfl, subset_rfl, subset_rfl, subset_rfl, subset_rfl, subset_rfl⟩

theorem le_union_left (A B : P3ChainKnow n) : Le A (A.union B) :=
  ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left,
    Finset.subset_union_left, Finset.subset_union_left⟩

theorem le_union_right (A B : P3ChainKnow n) : Le B (A.union B) :=
  ⟨Finset.subset_union_right, Finset.subset_union_right, Finset.subset_union_right, Finset.subset_union_right,
    Finset.subset_union_right, Finset.subset_union_right⟩

theorem canCall_mono {K K' : P3ChainKnow n} (h : Le K K') {L : Fin 2} {v : Fin n} {j : ℕ}
    (hc : K.canCall G L v j) : K'.canCall G L v j :=
  ⟨hc.1, hc.2.1, fun u hb => h.labKnown (hc.2.2.1 u hb), hc.2.2.2.imp_right fun hh => h.2.2.1 hh⟩

/-- **The moves are monotone in the knowledge.** -/
theorem step_mono {K K' : P3ChainKnow n} (h : Le K K') : Le (K.step G) (K'.step G) := by
  refine ⟨fun u hu => ?_, fun q hq => ?_, fun p hp => ?_, fun p hp => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · rw [mem_step_tops] at hu ⊢
    rcases hu with hu | ⟨hk, hc⟩ | ⟨p, hp, hpr, hp1, hb⟩ | hpc
    · exact Or.inl (h.1 hu)
    · exact Or.inr (Or.inl ⟨h.2.2.2.1 hk, fun w => h.2.1 (hc w)⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨p, h.2.2.1 hp, h.2.2.2.1 hpr, hp1, hb⟩))
    · exact Or.inr (Or.inr (Or.inr fun w => h.2.2.2.2.2 (hpc w)))
  · obtain ⟨w, u⟩ := q
    rw [mem_step_cols] at hq ⊢
    rcases hq with hq | hk | ⟨hu, hk⟩ | ⟨p, hp, hpr, hp1, hb⟩ | ⟨hu, hk⟩
    · exact Or.inl (h.2.1 hq)
    · exact Or.inr (Or.inl (h.2.2.2.1 hk))
    · exact Or.inr (Or.inr (Or.inl ⟨h.1 hu, h.2.2.2.1 hk⟩))
    · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨p, h.2.2.1 hp, h.2.2.2.1 hpr, hp1, hb⟩)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨h.1 hu, h.2.2.2.2.1 hk⟩)))
  · obtain ⟨L, v, j⟩ := p
    rw [mem_step_hs] at hp ⊢
    rcases hp with hp | ⟨hpos, hc | ⟨hj, h1, h2⟩⟩
    · exact Or.inl (h.2.2.1 hp)
    · exact Or.inr ⟨hpos, Or.inl (canCall_mono G h hc)⟩
    · exact Or.inr ⟨hpos, Or.inr ⟨hj, h.2.2.1 h1, h.2.2.2.1 h2⟩⟩
  · obtain ⟨L, v, j⟩ := p
    rw [mem_step_rs] at hp ⊢
    rcases hp with hp | ⟨hpos, hc | ⟨hj, (⟨hL, hl⟩ | ⟨hL, ht, hcol⟩)⟩⟩
    · exact Or.inl (h.2.2.2.1 hp)
    · exact Or.inr ⟨hpos, Or.inl (canCall_mono G h hc)⟩
    · exact Or.inr ⟨hpos, Or.inr ⟨hj, Or.inl ⟨hL, fun x => h.2.1 (hl x)⟩⟩⟩
    · exact Or.inr ⟨hpos, Or.inr ⟨hj, Or.inr ⟨hL, h.1 ht, fun x => h.2.1 (hcol x)⟩⟩⟩
  · obtain ⟨u, w⟩ := q
    rw [mem_step_kc] at hq ⊢
    rcases hq with hq | ⟨hu, hc⟩
    · exact Or.inl (h.2.2.2.2.1 hq)
    · exact Or.inr ⟨h.1 hu, h.2.1 hc⟩
  · obtain ⟨u, w⟩ := q
    rw [mem_step_pc] at hq ⊢
    rcases hq with hq | hu
    · exact Or.inl (h.2.2.2.2.2 hq)
    · exact Or.inr (h.1 hu)

theorem kc1_mono {K K' : P3ChainKnow n} (h : Le K K') {u w : Fin n} (hk : (u, w) ∈ K.kc1 G) : (u, w) ∈ K'.kc1 G := by
  rw [mem_kc1] at hk ⊢
  rcases hk with hk | hk
  · exact Or.inl (h.2.2.2.2.1 hk)
  · exact Or.inr (h.2.2.2.1 hk)

/-- **The instantaneous closure is monotone.** -/
theorem assemble_mono {K K' : P3ChainKnow n} (h : Le K K') : Le (K.assemble G) (K'.assemble G) := by
  refine ⟨h.1, fun q hq => ?_, h.2.2.1, fun p hp => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · obtain ⟨w, u⟩ := q
    rw [mem_asm_cols] at hq ⊢
    rcases hq with hq | ⟨hp, hk⟩
    · exact Or.inl (h.2.1 hq)
    · exact Or.inr ⟨h.2.2.2.2.2 hp, kc1_mono G h hk⟩
  · obtain ⟨L, v, j⟩ := p
    rw [mem_asm_rs] at hp ⊢
    rcases hp with hp | ⟨hL, hj, hall⟩
    · exact Or.inl (h.2.2.2.1 hp)
    · refine Or.inr ⟨hL, hj, fun w => ?_⟩
      rcases hall w with hw | ⟨hp, hc⟩
      · exact Or.inl (kc1_mono G h hw)
      · exact Or.inr ⟨h.2.2.2.2.2 hp, h.2.1 hc⟩
  · obtain ⟨u, w⟩ := q
    rw [mem_asm_kc] at hq ⊢
    rcases hq with hq | ⟨hp, hc⟩
    · exact Or.inl (kc1_mono G h hq)
    · exact Or.inr ⟨h.2.2.2.2.2 hp, h.2.1 hc⟩
  · obtain ⟨u, w⟩ := q
    rw [mem_asm_pc] at hq ⊢
    rcases hq with hq | ⟨hc, hk⟩
    · exact Or.inl (h.2.2.2.2.2 hq)
    · exact Or.inr ⟨h.2.1 hc, kc1_mono G h hk⟩

/-- **A round is monotone in the knowledge.** -/
theorem round_mono {K K' : P3ChainKnow n} (h : Le K K') : Le (K.round G) (K'.round G) :=
  assemble_mono G (step_mono G h)

/-- **The reach is monotone in the holding.** -/
theorem reach_mono {K₀ K₀' : P3ChainKnow n} (h : Le K₀ K₀') (t : ℕ) : Le (reach G K₀ t) (reach G K₀' t) := by
  induction t with
  | zero => exact assemble_mono G h
  | succ t ih => exact round_mono G ih

/-- **A top key whose components are all known is assembled by the next round.** -/
theorem key_of_kc {K : P3ChainKnow n} {u : Fin n} (h : ∀ w, (u, w) ∈ K.kc) :
    ((1 : Fin 2), u, ovCalls G u) ∈ (K.round G).rs :=
  (mem_asm_rs G _ _ _ _).2 (Or.inr ⟨rfl, rfl, fun w =>
    Or.inl ((mem_kc1 G _ u w).2 (Or.inl ((le_step G K).2.2.2.2.1 (h w))))⟩)

end P3ChainKnow

namespace P3Replay

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) (ω : P3COmega n wc)

open Classical in
/-- **What round `τ` shows, as game items** (one coordinate or one whole permutation value each). -/
noncomputable def shownAt (τ : ℕ) : P3ChainKnow n where
  tops := Finset.univ.filter fun u => R.showsLab ω (R.c2 ω u) τ
  cols := Finset.univ.filter fun q => R.showsLab ω (R.c1 ω q.1) τ
  hs := (P3ChainKnow.pos n).filter fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
    R.showsH ω (R.hval ω p.1 p.2.1 p.2.2) τ
  rs := (P3ChainKnow.pos n).filter fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
    ((R.showsR ω (R.rval ω p.1 p.2.1 p.2.2) τ ∧ ¬ (p.1 = 1 ∧ p.2.2 = ovCalls R.G p.2.1)) ∨
      (p.1 = 0 ∧ p.2.2 = ovCalls R.G p.2.1 ∧ R.showsPin ω (R.tag, 0, p.2.1) (R.pin1 ω p.2.1) τ))
  kc := Finset.univ.filter fun q => R.showsR ω (R.rval ω 1 q.1 (ovCalls R.G q.1)) τ
  pc := Finset.univ.filter fun q => R.showsPin ω (R.tag, 1, q.1) (R.pin2 ω q.1) τ

open Classical in
/-- **One pass of the value closure's pair rule.** Every honest pair that a program revealed before round `τ` gives
either whole side from the other:
- `Π₂` at `xin L v p`: the input (the block's label and `h_{p−1}`) gives `h_p` and `r_p`, and the output gives the
  input;
- `P_(tag,0,w)`: `key¹_w` (that is, `pin1 = W ⊕ key¹`) gives all columns of `c¹_w`, and back;
- `P_(tag,1,u)`: all of `pin2 u` gives the top, and back.

Only revealed pairs fire, unlike `step`, which fires every callable move. -/
noncomputable def vcStep (τ : ℕ) (K : P3ChainKnow n) : P3ChainKnow n where
  tops := K.tops ∪ Finset.univ.filter (fun u =>
      ((∃ ρ < τ, R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ) ∧ ∀ w, (u, w) ∈ K.pc) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 1 ∧ 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
        (∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 p.2.2) ρ) ∧ ovBlock R.G p.2.1 p.2.2 = some u))
  cols := K.cols ∪ Finset.univ.filter (fun q : Fin n × Fin n =>
      ((∃ ρ < τ, R.askedP ω (R.tag, 0, q.1) (R.pin1 ω q.1) ρ) ∧ K.keyKnown R.G 0 q.1) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 0 ∧ 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
        (∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 p.2.2) ρ) ∧ ovBlock R.G p.2.1 p.2.2 = some q.1))
  hs := K.hs ∪ (P3ChainKnow.pos n).filter (fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
      (((∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 p.2.2) ρ) ∧ K.canCall R.G p.1 p.2.1 p.2.2) ∨
       (p.2.2 + 1 ≤ ovCalls R.G p.2.1 ∧ (∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 (p.2.2 + 1)) ρ) ∧
         (p.1, p.2.1, p.2.2 + 1) ∈ K.hs ∧ (p.1, p.2.1, p.2.2 + 1) ∈ K.rs)))
  rs := K.rs ∪ (P3ChainKnow.pos n).filter (fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
      (((∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 p.2.2) ρ) ∧ K.canCall R.G p.1 p.2.1 p.2.2) ∨
       (p.1 = 0 ∧ p.2.2 = ovCalls R.G p.2.1 ∧ (∃ ρ < τ, R.askedP ω (R.tag, 0, p.2.1) (R.pin1 ω p.2.1) ρ) ∧
         K.lowKnown p.2.1)))
  kc := K.kc
  pc := K.pc ∪ Finset.univ.filter (fun q : Fin n × Fin n =>
      (∃ ρ < τ, R.askedP ω (R.tag, 1, q.1) (R.pin2 ω q.1) ρ) ∧ q.1 ∈ K.tops)

/-- Enough passes to close: the number of items is at most `8 (n + 2)³`. -/
def vcIters (n : ℕ) : ℕ := 8 * (n + 2) ^ 3

/-- **The value closure `VC_τ` of a holding `H`**: `H` closed under the pair rule of the pairs revealed before `τ`,
the identities (a label is all its columns, a top key is all its components) and the `pin2` triples (`assemble`).
It is what the history of rounds `< τ` and the credits in `H` determine. -/
noncomputable def vc (τ : ℕ) (H : P3ChainKnow n) : P3ChainKnow n :=
  (fun K => (R.vcStep ω τ K).assemble R.G)^[vcIters n] (H.assemble R.G)

/-- **The online holding**: what each round shows and the history plus earlier credits do not determine (`VC`). -/
noncomputable def onlineH : ℕ → P3ChainKnow n
  | 0 => P3ChainKnow.empty
  | τ + 1 => (onlineH τ).union (P3ChainKnow.fresh (R.shownAt ω τ) (R.vc ω τ (onlineH τ)))

/-- The game knowledge at round `τ`, from the items that joined before `τ`. -/
noncomputable abbrev Kon (τ : ℕ) : P3ChainKnow n := P3ChainKnow.reach R.G (R.onlineH ω τ) τ

/-- The game knowledge at round `ρ`, including what round `ρ` shows. -/
noncomputable abbrev Ks (ρ : ℕ) : P3ChainKnow n := P3ChainKnow.reach R.G (R.onlineH ω (ρ + 1)) ρ

/-- What the history of rounds `< τ` and the credits so far determine. -/
noncomputable abbrev Vc (τ : ℕ) : P3ChainKnow n := R.vc ω τ (R.onlineH ω τ)

theorem onlineH_le_succ (τ : ℕ) : P3ChainKnow.Le (R.onlineH ω τ) (R.onlineH ω (τ + 1)) :=
  P3ChainKnow.le_union_left _ _

theorem onlineH_mono {τ τ' : ℕ} (h : τ ≤ τ') : P3ChainKnow.Le (R.onlineH ω τ) (R.onlineH ω τ') := by
  induction τ', h using Nat.le_induction with
  | base => exact P3ChainKnow.Le.rfl' _
  | succ τ' _ ih => exact ih.trans (R.onlineH_le_succ ω τ')

/-- Knowledge grows with the holding's round and the game's round. -/
theorem reach_le {τ τ' t t' : ℕ} (hτ : τ ≤ τ') (ht : t ≤ t') :
    P3ChainKnow.Le (P3ChainKnow.reach R.G (R.onlineH ω τ) t) (P3ChainKnow.reach R.G (R.onlineH ω τ') t') :=
  (P3ChainKnow.reach_mono R.G (R.onlineH_mono ω hτ) t).trans (P3ChainKnow.le_reach R.G _ ht)

/-- **Everything round `τ` shows is known at `τ`, once round `τ`'s fresh items have joined.** -/
theorem shown_le_of {τ : ℕ} (hK : P3ChainKnow.Le (R.Vc ω τ) (R.Ks ω τ)) :
    P3ChainKnow.Le (R.shownAt ω τ) (R.Ks ω τ) := by
  classical
  have hH : P3ChainKnow.Le (R.onlineH ω (τ + 1)) (R.Ks ω τ) :=
    (P3ChainKnow.le_assemble R.G _).trans (P3ChainKnow.le_reach R.G _ (Nat.zero_le τ))
  have hF : P3ChainKnow.Le (P3ChainKnow.fresh (R.shownAt ω τ) (R.Vc ω τ)) (R.Ks ω τ) :=
    (P3ChainKnow.le_union_right _ _).trans hH
  have hcols : (R.shownAt ω τ).cols ⊆ (R.Ks ω τ).cols := fun x hx => by
    by_cases hk : x ∈ (R.Vc ω τ).cols
    · exact hK.2.1 hk
    · exact hF.2.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  have hkc : (R.shownAt ω τ).kc ⊆ (R.Ks ω τ).kc := fun x hx => by
    by_cases hk : x ∈ (R.Vc ω τ).kc
    · exact hK.2.2.2.2.1 hk
    · by_cases hd : (x.2, x.1) ∈ (R.shownAt ω τ).cols ∧ x ∈ (R.Vc ω τ).pc
      · exact P3ChainKnow.reach_closed_kc R.G _ _ (hcols hd.1) (hK.2.2.2.2.2 hd.2)
      · exact hF.2.2.2.2.1 (Finset.mem_filter.2 ⟨Finset.mem_sdiff.2 ⟨hx, hk⟩, hd⟩)
  refine ⟨fun x hx => ?_, hcols, fun x hx => ?_, fun x hx => ?_, hkc, fun x hx => ?_⟩
  · by_cases hk : x ∈ (R.Vc ω τ).tops
    · exact hK.1 hk
    · exact hF.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  · by_cases hk : x ∈ (R.Vc ω τ).hs
    · exact hK.2.2.1 hk
    · exact hF.2.2.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  · by_cases hk : x ∈ (R.Vc ω τ).rs
    · exact hK.2.2.2.1 hk
    · exact hF.2.2.2.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  · by_cases hk : x ∈ (R.Vc ω τ).pc
    · exact hK.2.2.2.2.2 hk
    · by_cases hd : (x.2, x.1) ∈ (R.Vc ω τ).cols ∪ (R.shownAt ω τ).cols ∧ x ∈ (R.Vc ω τ).kc ∪ (R.shownAt ω τ).kc
      · have hc : (x.2, x.1) ∈ (R.Ks ω τ).cols := by
          rcases Finset.mem_union.1 hd.1 with h | h
          · exact hK.2.1 h
          · exact hcols h
        have hk' : x ∈ (R.Ks ω τ).kc := by
          rcases Finset.mem_union.1 hd.2 with h | h
          · exact hK.2.2.2.2.1 h
          · exact hkc h
        exact P3ChainKnow.reach_closed_pc R.G _ _ hc hk'
      · exact hF.2.2.2.2.2 (Finset.mem_filter.2 ⟨Finset.mem_sdiff.2 ⟨hx, hk⟩, hd⟩)

/-! ### Shown values are known -/

section Known

variable {R ω}

theorem ks_lab {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {L : Fin 2} {u : Fin n} (hs : R.showsLab ω (R.lab ω L u) ρ) : (R.Ks ω ρ).labKnown L u := by
  classical
  by_cases hL : L = 0
  · subst hL
    rw [labKnown_zero]
    exact fun x => hsl.2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hs⟩)
  · have hL1 : L = 1 := by fin_cases L <;> simp_all
    subst hL1
    rw [labKnown_one]
    exact hsl.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hs⟩)

theorem ks_h {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {L : Fin 2} {v : Fin n} {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ ovCalls R.G v)
    (hs : R.showsH ω (R.hval ω L v p) ρ) : (L, v, p) ∈ (R.Ks ω ρ).hs := by
  classical
  exact hsl.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, hs⟩)

/-- A shown dropped part is known one round later (a top row's pad `r` through its key components). -/
theorem ks_r {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {L : Fin 2} {v : Fin n} {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ ovCalls R.G v)
    (hs : R.showsR ω (R.rval ω L v p) ρ) : (L, v, p) ∈ ((R.Ks ω ρ).round R.G).rs := by
  classical
  by_cases htp : L = 1 ∧ p = ovCalls R.G v
  · obtain ⟨rfl, rfl⟩ := htp
    exact P3ChainKnow.key_of_kc R.G fun w =>
      hsl.2.2.2.2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hs⟩)
  · exact (P3ChainKnow.le_round R.G _).2.2.2.1
      (hsl.2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, Or.inl ⟨hs, htp⟩⟩))

theorem ks_keyLow {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {w : Fin n} (hs : R.showsPin ω (R.tag, 0, w) (R.pin1 ω w) ρ) :
    (R.Ks ω ρ).keyKnown R.G 0 w := by
  classical
  have h1 : 1 ≤ ovCalls R.G w := by unfold ovCalls; omega
  exact hsl.2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos le_rfl, h1, le_rfl, Or.inr ⟨rfl, rfl, hs⟩⟩)

theorem ks_pin2 {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {u : Fin n} (hs : R.showsPin ω (R.tag, 1, u) (R.pin2 ω u) ρ) :
    ∀ w, (u, w) ∈ (R.Ks ω ρ).pc := by
  classical
  exact fun w => hsl.2.2.2.2.2 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hs⟩)

end Known

/-! ### The simulation -/

/-- **The online simulation at round `ρ`**: a point revealed at `ρ` is known one round later. -/
def SimOn (ρ : ℕ) : Prop :=
  (∀ (L : Fin 2) (v : Fin n) (p : ℕ), 1 ≤ p → p ≤ ovCalls R.G v → R.askedS ω (R.xin ω L v p) ρ →
      (L, v, p) ∈ ((R.Ks ω ρ).round R.G).hs ∧ (L, v, p) ∈ ((R.Ks ω ρ).round R.G).rs) ∧
  (∀ w, R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ → ((R.Ks ω ρ).round R.G).lowKnown w) ∧
  (∀ u, R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ → u ∈ ((R.Ks ω ρ).round R.G).tops)

/-- **The simulation holds by construction**, with no induction: each reveal's inputs are shown in its own round. -/
theorem simOn_of {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ)) : R.SimOn ω ρ := by
  classical
  have hle := P3ChainKnow.le_round R.G (R.Ks ω ρ)
  refine ⟨?_, ?_, ?_⟩
  · intro L v p hp1 hp ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst hρ
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp only [revS, Option.some_inj] at hrev
      subst hrev
      have hcall : (R.Ks ω ρe).canCall R.G L v p := by
        refine ⟨hp1, hp, fun u hb => ks_lab hsl ⟨v', Or.inl ⟨_, he, rfl, ?_⟩⟩, ?_⟩
        · simp only [showLab, R.xin_ovR ω hb, Equiv.symm_apply_apply]
        · rcases Nat.lt_or_ge p 2 with h2 | h2
          · exact Or.inl (by omega)
          · refine Or.inr (ks_h hsl (p := p - 1) (by omega) (by omega) ⟨v', _, he, rfl, ?_⟩)
            have := R.xin_ovH ω (L := L) (v := v) (p := p - 1) (by omega) (by omega)
            rw [Nat.sub_add_cancel (by omega)] at this
            simp only [showH, this]
      exact ⟨(P3ChainKnow.mem_step_hs _ _ _ _ _).2 (Or.inr ⟨R.mem_pos hp, Or.inl hcall⟩),
        P3ChainKnow.round_rs_of_step _ ((P3ChainKnow.mem_step_rs _ _ _ _ _).2 (Or.inr ⟨R.mem_pos hp, Or.inl hcall⟩))⟩
    · simp only [revS, Option.some_inj] at hrev
      have hy : y = ω.2 (R.xin ω L v p) := by rw [← hrev, Equiv.apply_symm_apply]
      subst hy
      exact ⟨hle.2.2.1 (ks_h hsl hp1 hp ⟨v', _, he, rfl, by simp only [showH]; rfl⟩),
        ks_r hsl hp1 hp ⟨v', _, he, rfl, by simp only [showR]; rfl⟩⟩
    · simp [revS] at hrev
    · simp [revS] at hrev
  · intro w ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst hρ
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      exact fun x => P3ChainKnow.round_cols_of_step _
        ((P3ChainKnow.mem_step_cols _ _ _ _).2 (Or.inr (Or.inl (ks_keyLow hsl ⟨v', _, he, rfl, rfl⟩))))
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c1 ω w := by rw [R.c1_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      have := (labKnown_zero _ _).1 (ks_lab hsl (L := 0) ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩)
      exact fun x => hle.2.1 (this x)
  · intro u ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst hρ
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      exact (P3ChainKnow.mem_step_tops _ _ _).2 (Or.inr (Or.inr (Or.inr (ks_pin2 hsl ⟨v', _, he, rfl, rfl⟩))))
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c2 ω u := by rw [R.c2_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      exact hle.1 ((labKnown_one _ _).1 (ks_lab hsl (L := 1) ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩))

/-- **Both sides of a revealed pair are known one round later**: the input sides, next to `SimOn`'s outputs. -/
def SimBoth (ρ : ℕ) : Prop :=
  (∀ (L : Fin 2) (v : Fin n) (p : ℕ), 1 ≤ p → p ≤ ovCalls R.G v → R.askedS ω (R.xin ω L v p) ρ →
      (∀ u, ovBlock R.G v p = some u → ((R.Ks ω ρ).round R.G).labKnown L u) ∧
      (2 ≤ p → (L, v, p - 1) ∈ ((R.Ks ω ρ).round R.G).hs)) ∧
  (∀ w, R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ → ((R.Ks ω ρ).round R.G).keyKnown R.G 0 w) ∧
  (∀ u, R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ → ∀ w, (u, w) ∈ ((R.Ks ω ρ).round R.G).pc)

theorem simBoth_of {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ)) : R.SimBoth ω ρ := by
  classical
  have hle := P3ChainKnow.le_round R.G (R.Ks ω ρ)
  refine ⟨?_, ?_, ?_⟩
  · intro L v p hp1 hp ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst ρe
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp only [revS, Option.some_inj] at hrev
      subst hrev
      refine ⟨fun u hb => hle.labKnown (ks_lab hsl ⟨v', Or.inl ⟨_, he, rfl, ?_⟩⟩), fun h2 => hle.2.2.1 ?_⟩
      · simp only [showLab, R.xin_ovR ω hb, Equiv.symm_apply_apply]
      · refine ks_h hsl (p := p - 1) (by omega) (by omega) ⟨v', _, he, rfl, ?_⟩
        have := R.xin_ovH ω (L := L) (v := v) (p := p - 1) (by omega) (by omega)
        rw [Nat.sub_add_cancel (by omega)] at this
        simp only [showH, this]
    · simp only [revS, Option.some_inj] at hrev
      have hy : y = ω.2 (R.xin ω L v p) := by rw [← hrev, Equiv.apply_symm_apply]
      subst hy
      have hh : (L, v, p) ∈ (R.Ks ω ρ).hs := ks_h hsl hp1 hp ⟨v', _, he, rfl, by simp only [showH]; rfl⟩
      have hr : (L, v, p) ∈ (R.Ks ω ρ).rs := by
        by_cases htp : L = 1 ∧ p = ovCalls R.G v
        · obtain ⟨rfl, rfl⟩ := htp
          obtain ⟨X, hX⟩ := P3ChainKnow.reach_asm R.G (R.onlineH ω (ρ + 1)) ρ
          have hk : ∀ w, (v, w) ∈ (X.assemble R.G).kc := fun w => by
            rw [← hX]
            exact hsl.2.2.2.2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, ⟨v', _, he, rfl, by simp only [showR]; rfl⟩⟩)
          have := P3ChainKnow.asm_key_of_kc R.G X hk
          rwa [← hX] at this
        · exact hsl.2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, Or.inl ⟨⟨v', _, he, rfl, by simp only [showR]; rfl⟩, htp⟩⟩)
      refine ⟨fun u hb => ?_, fun h2 => ?_⟩
      · have hst : ((R.Ks ω ρ).step R.G).labKnown L u := by
          by_cases hL : L = 0
          · subst hL
            rw [labKnown_zero]
            exact fun x => (P3ChainKnow.mem_step_cols _ _ _ _).2
              (Or.inr (Or.inr (Or.inr (Or.inl ⟨(0, v, p), hh, hr, rfl, hb⟩))))
          · have hL1 : L = 1 := by fin_cases L <;> simp_all
            subst hL1
            rw [labKnown_one]
            exact (P3ChainKnow.mem_step_tops _ _ _).2 (Or.inr (Or.inr (Or.inl ⟨(1, v, p), hh, hr, rfl, hb⟩)))
        exact (P3ChainKnow.le_assemble R.G _).labKnown hst
      · have hmem : (L, v, p - 1) ∈ ((R.Ks ω ρ).step R.G).hs := by
          refine (P3ChainKnow.mem_step_hs _ _ _ _ _).2 (Or.inr ⟨R.mem_pos (by omega), Or.inr ⟨by omega, ?_, ?_⟩⟩)
          · rwa [Nat.sub_add_cancel (by omega)]
          · rwa [Nat.sub_add_cancel (by omega)]
        exact (P3ChainKnow.le_assemble R.G _).2.2.1 hmem
    · simp [revS] at hrev
    · simp [revS] at hrev
  · intro w ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst ρe
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      exact hle.2.2.2.1 (ks_keyLow hsl ⟨v', _, he, rfl, rfl⟩)
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c1 ω w := by rw [R.c1_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      have hlow := (labKnown_zero _ _).1 (ks_lab hsl (L := 0) ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩)
      have h1 : 1 ≤ ovCalls R.G w := by unfold ovCalls; omega
      exact P3ChainKnow.round_rs_of_step _ ((P3ChainKnow.mem_step_rs _ _ _ _ _).2
        (Or.inr ⟨R.mem_pos le_rfl, Or.inr ⟨rfl, Or.inl ⟨rfl, hlow⟩⟩⟩))
  · intro u ⟨v', e, he, hρ, hrev⟩ w
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst ρe
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      exact hle.2.2.2.2.2 (ks_pin2 hsl ⟨v', _, he, rfl, rfl⟩ w)
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c2 ω u := by rw [R.c2_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      have htop := (labKnown_one _ _).1 (ks_lab hsl (L := 1) ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩)
      exact (P3ChainKnow.le_assemble R.G _).2.2.2.2.2 ((P3ChainKnow.mem_step_pc _ _ _ _).2 (Or.inr htop))

/-- **The value closure is inside the game.** Each pair it uses was revealed at some `ρ < τ`, and both its sides
are in the game at `ρ + 1 ≤ τ`; the closure is instantaneous in both. -/
theorem vc_le (τ : ℕ) (hsim : ∀ ρ < τ, R.SimOn ω ρ ∧ R.SimBoth ω ρ) : P3ChainKnow.Le (R.Vc ω τ) (R.Kon ω τ) := by
  classical
  have hup : ∀ {ρ : ℕ}, ρ < τ → P3ChainKnow.Le ((R.Ks ω ρ).round R.G) (R.Kon ω τ) := fun {ρ} hρ =>
    R.reach_le ω (τ := ρ + 1) (τ' := τ) (t := ρ + 1) (t' := τ) (by omega) (by omega)
  have hstep : ∀ K : P3ChainKnow n, P3ChainKnow.Le K (R.Kon ω τ) →
      P3ChainKnow.Le (R.vcStep ω τ K) (R.Kon ω τ) := by
    intro K hK
    refine ⟨fun u hu => ?_, fun q hq => ?_, fun p hp => ?_, fun p hp => ?_, fun q hq => hK.2.2.2.2.1 hq,
      fun q hq => ?_⟩
    · rcases Finset.mem_union.1 hu with hu | hu
      · exact hK.1 hu
      rcases (Finset.mem_filter.1 hu).2 with ⟨⟨ρ, hρ, ha⟩, _⟩ | ⟨p, _, _, hp1, hj1, hj, ⟨ρ, hρ, ha⟩, hb⟩
      · exact (hup hρ).1 ((hsim ρ hρ).1.2.2 u ha)
      · have := ((hsim ρ hρ).2.1 p.1 p.2.1 p.2.2 hj1 hj ha).1 u hb
        rw [hp1] at this
        exact (hup hρ).1 ((labKnown_one _ _).1 this)
    · obtain ⟨w, x⟩ := q
      rcases Finset.mem_union.1 hq with hq | hq
      · exact hK.2.1 hq
      rcases (Finset.mem_filter.1 hq).2 with ⟨⟨ρ, hρ, ha⟩, _⟩ | ⟨p, _, _, hp0, hj1, hj, ⟨ρ, hρ, ha⟩, hb⟩
      · exact (hup hρ).2.1 ((hsim ρ hρ).1.2.1 w ha x)
      · have := ((hsim ρ hρ).2.1 p.1 p.2.1 p.2.2 hj1 hj ha).1 w hb
        rw [hp0] at this
        exact (hup hρ).2.1 ((labKnown_zero _ _).1 this x)
    · obtain ⟨L, v, j⟩ := p
      rcases Finset.mem_union.1 hp with hp | hp
      · exact hK.2.2.1 hp
      obtain ⟨hj1, hj, h⟩ := (Finset.mem_filter.1 hp).2
      simp only at hj1 hj h
      rcases h with ⟨⟨ρ, hρ, ha⟩, _⟩ | ⟨hj2, ⟨ρ, hρ, ha⟩, _, _⟩
      · exact (hup hρ).2.2.1 ((hsim ρ hρ).1.1 L v j hj1 hj ha).1
      · have := ((hsim ρ hρ).2.1 L v (j + 1) (by omega) hj2 ha).2 (by omega)
        simp only [Nat.add_sub_cancel] at this
        exact (hup hρ).2.2.1 this
    · obtain ⟨L, v, j⟩ := p
      rcases Finset.mem_union.1 hp with hp | hp
      · exact hK.2.2.2.1 hp
      obtain ⟨hj1, hj, h⟩ := (Finset.mem_filter.1 hp).2
      rcases h with ⟨⟨ρ, hρ, ha⟩, _⟩ | ⟨hL, hjp, ⟨ρ, hρ, ha⟩, _⟩
      · exact (hup hρ).2.2.2.1 ((hsim ρ hρ).1.1 L v j hj1 hj ha).2
      · simp only at hL hjp
        subst hL; subst hjp
        exact (hup hρ).2.2.2.1 ((hsim ρ hρ).2.2.1 v ha)
    · obtain ⟨u, w⟩ := q
      rcases Finset.mem_union.1 hq with hq | hq
      · exact hK.2.2.2.2.2 hq
      obtain ⟨⟨ρ, hρ, ha⟩, _⟩ := (Finset.mem_filter.1 hq).2
      exact (hup hρ).2.2.2.2.2 ((hsim ρ hρ).2.2.2 u ha w)
  have hiter : ∀ k, P3ChainKnow.Le ((fun K => (R.vcStep ω τ K).assemble R.G)^[k]
      ((R.onlineH ω τ).assemble R.G)) (R.Kon ω τ) := by
    intro k
    induction k with
    | zero => exact P3ChainKnow.le_reach R.G _ (Nat.zero_le τ)
    | succ k ih =>
      rw [Function.iterate_succ_apply']
      exact (P3ChainKnow.assemble_mono R.G (hstep _ ih)).trans (P3ChainKnow.reach_asm_le R.G _ τ)
  exact hiter _

/-- **Everything round `τ` shows is known at `τ`, once round `τ`'s credits have joined** (strong induction on the
round, through `vc_le`). -/
theorem shown_le (τ : ℕ) : P3ChainKnow.Le (R.shownAt ω τ) (R.Ks ω τ) := by
  induction τ using Nat.strong_induction_on with
  | _ τ ih =>
    exact R.shown_le_of ω ((R.vc_le ω τ fun ρ hρ => ⟨R.simOn_of ω (ih ρ hρ), R.simBoth_of ω (ih ρ hρ)⟩).trans
      (R.reach_le ω (Nat.le_succ τ) le_rfl))

/-- **The online simulation holds at every round.** -/
theorem simOn (ρ : ℕ) : R.SimOn ω ρ := R.simOn_of ω (R.shown_le ω ρ)

/-- **A correct output lies in the online reach at `D`.** -/
theorem mem_reach_of_correct_on (hA : ∀ i, (R.A i).Bounded R.D R.Q) (i : ι) (v : Fin n)
    (hv : (R.A i).run ((p3ChainModel n wc).answer ω) = R.c2 ω v) :
    v ∈ (P3ChainKnow.reach R.G (R.onlineH ω (R.D + 1)) R.D).tops := by
  have hd := (hA i ω).1
  have hs : R.showsLab ω (R.lab ω 1 v) ((R.A i).depth ((p3ChainModel n wc).answer ω)) := ⟨i, Or.inr ⟨hv, rfl⟩⟩
  exact (R.reach_le ω (by omega) hd).1 ((labKnown_one _ _).1 (ks_lab (R.shown_le ω _) hs))

/-- **A win forces an expensive online holding.** `out v` is the program answering challenge `v`. -/
theorem win_price_on (hA : ∀ i, (R.A i).Bounded R.D R.Q) (out : Fin n → ι) {c k X : ℕ}
    (hard : P3ChainHard R.G c wc R.D k X)
    (hk : k ≤ (Finset.univ.filter fun v => (R.A (out v)).run ((p3ChainModel n wc).answer ω) = R.c2 ω v).card) :
    (((k - X : ℕ) : ℚ) * n) ≤ (R.onlineH ω (R.D + 1)).size c wc := by
  classical
  refine hard _ (hk.trans (Finset.card_le_card fun v hv => ?_))
  exact R.mem_reach_of_correct_on ω hA (out v) v (Finset.mem_filter.1 hv).2

/-! ### Which round an item joined -/

/-- **An item of the online holding joined at some round `τ`**: shown at `τ`, and not derivable at `τ`. -/
theorem mem_onlineH (τ' : ℕ) :
    (∀ u ∈ (R.onlineH ω τ').tops, ∃ τ < τ', u ∈ (R.shownAt ω τ).tops ∧ u ∉ (R.Vc ω τ).tops) ∧
    (∀ q ∈ (R.onlineH ω τ').cols, ∃ τ < τ', q ∈ (R.shownAt ω τ).cols ∧ q ∉ (R.Vc ω τ).cols) ∧
    (∀ p ∈ (R.onlineH ω τ').hs, ∃ τ < τ', p ∈ (R.shownAt ω τ).hs ∧ p ∉ (R.Vc ω τ).hs) ∧
    (∀ p ∈ (R.onlineH ω τ').rs, ∃ τ < τ', p ∈ (R.shownAt ω τ).rs ∧ p ∉ (R.Vc ω τ).rs) ∧
    (∀ q ∈ (R.onlineH ω τ').kc, ∃ τ < τ', q ∈ (R.shownAt ω τ).kc ∧ q ∉ (R.Vc ω τ).kc) ∧
    (∀ q ∈ (R.onlineH ω τ').pc, ∃ τ < τ', q ∈ (R.shownAt ω τ).pc ∧ q ∉ (R.Vc ω τ).pc) := by
  induction τ' with
  | zero =>
    simp only [onlineH, P3ChainKnow.empty, Finset.notMem_empty, false_imp_iff, implies_true,
      and_self]
  | succ τ ih =>
    have step : ∀ {α : Type} [DecidableEq α] (A F B C : Finset α) (P : α → Prop), (∀ x ∈ F, x ∈ B ∧ x ∉ C) →
        (∀ x ∈ A, P x) → (∀ x ∈ B, x ∉ C → P x) → ∀ x ∈ A ∪ F, P x := by
      intro α _ A F B C P hF hA hB x hx
      rcases Finset.mem_union.1 hx with h | h
      · exact hA x h
      · exact hB x (hF x h).1 (hF x h).2
    have hF := P3ChainKnow.fresh_sub (R.shownAt ω τ) (R.vc ω τ (R.onlineH ω τ))
    refine ⟨step _ _ _ _ _ hF.1 (fun x h => ?_) (fun x h1 h2 => ⟨τ, by omega, h1, h2⟩),
      step _ _ _ _ _ hF.2.1 (fun x h => ?_) (fun x h1 h2 => ⟨τ, by omega, h1, h2⟩),
      step _ _ _ _ _ hF.2.2.1 (fun x h => ?_) (fun x h1 h2 => ⟨τ, by omega, h1, h2⟩),
      step _ _ _ _ _ hF.2.2.2.1 (fun x h => ?_) (fun x h1 h2 => ⟨τ, by omega, h1, h2⟩),
      step _ _ _ _ _ hF.2.2.2.2.1 (fun x h => ?_) (fun x h1 h2 => ⟨τ, by omega, h1, h2⟩),
      step _ _ _ _ _ hF.2.2.2.2.2 (fun x h => ?_) (fun x h1 h2 => ⟨τ, by omega, h1, h2⟩)⟩
    · obtain ⟨τ₀, h0, h1⟩ := ih.1 x h; exact ⟨τ₀, by omega, h1⟩
    · obtain ⟨τ₀, h0, h1⟩ := ih.2.1 x h; exact ⟨τ₀, by omega, h1⟩
    · obtain ⟨τ₀, h0, h1⟩ := ih.2.2.1 x h; exact ⟨τ₀, by omega, h1⟩
    · obtain ⟨τ₀, h0, h1⟩ := ih.2.2.2.1 x h; exact ⟨τ₀, by omega, h1⟩
    · obtain ⟨τ₀, h0, h1⟩ := ih.2.2.2.2.1 x h; exact ⟨τ₀, by omega, h1⟩
    · obtain ⟨τ₀, h0, h1⟩ := ih.2.2.2.2.2 x h; exact ⟨τ₀, by omega, h1⟩

end P3Replay

end Pous.P3Concrete

end


/-! ════ Freshness.Timed ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The column game at real oracle costs: `timedReach G c0 D ⊆ colReach G c0 D`

`timedReach G c0 t` is what a holding `c0` yields after `t` oracle rounds, when every move is charged its real cost
in the tweaked model:

* **forward-lower**, 2 rounds: `H(τ,0,w, c¹ parents)`, then `P_{(τ,0,w)}(W_w ⊕ k¹_w)`;
* **promotion**, 0 rounds: a lower label whose `n` columns are all known is known;
* **reverse**, 1 round: `P_{(τ,1,u)}⁻¹(c²_u)` and `H(τ,1,u, c² parents)` together give column `u` of every lower label,
  once top `u` and its parents are known;
* **forward-top**, 1 round after the last column, 2 after the last parent: `H(τ,1,u, c² parents)`, then
  `P_{(τ,1,u)}(x²_u ⊕ k²_u)`.

`timedReach_sub` proves that everything timed at round `t` is in `colReach` at game round `t`, except that a promoted
lower label may arrive one game round later. That lag never reaches a top: a forward-top needs only the promoted label's
columns, which are already there, and the label's only other consumer is a forward-lower, which costs 2 oracle rounds.
So the conversion is `g(D) = D` (`topWhole_timedReach_sub`, `columnHard_timed`).

`timedReach_not_half` is the red team's §22 point in this abstraction: on a 2-node path, a top timed at round `4`
is not in `colReach` at `(4+1)/2 = 2`.
-/

namespace PousTimedGame

open Pous Pous.ColumnAware

variable {n : ℕ}

/-- Promotion (0 rounds): every lower label whose columns are all held becomes whole. -/
def promote (c : ColState n) : ColState n :=
  { c with lowerWhole := c.lowerWhole ∪ Finset.univ.filter fun w => ∀ u, (w, u) ∈ c.lowerCol }

/-- Reverse (1 round): column `u` of every lower label, for each known top `u` with known top parents. -/
def revCols (G : Labelling.TopoDAG n) (c : ColState n) : Finset (Fin n × Fin n) :=
  Finset.univ ×ˢ c.topWhole.filter fun u => G.par u ⊆ c.topWhole

/-- Round `1` before promotion: only the 1-round reverse, from round `0` (`b`). -/
def stepOne (G : Labelling.TopoDAG n) (b : ColState n) : ColState n where
  lowerWhole := b.lowerWhole
  lowerCol := b.lowerCol ∪ revCols G b
  topWhole := b.topWhole

/-- Round `t + 2` before promotion, from rounds `t` (`a`) and `t + 1` (`b`): reverse from `b` (1 round);
forward-lower from `a` (2 rounds: `H`, then `P`); forward-top with its columns from `b` (the `P` query) and its top
parents from `a` (the key `H` query, one round earlier). -/
def stepTwo (G : Labelling.TopoDAG n) (a b : ColState n) : ColState n where
  lowerWhole := b.lowerWhole ∪ Finset.univ.filter fun w => G.par w ⊆ a.lowerWhole
  lowerCol := b.lowerCol ∪ revCols G b
  topWhole := b.topWhole ∪ Finset.univ.filter fun u =>
    (∀ w, w ∈ b.lowerWhole ∨ (w, u) ∈ b.lowerCol) ∧ G.par u ⊆ a.topWhole

/-- The holding known after `t` oracle rounds from `c0`, every move at its real cost. -/
def timedReach (G : Labelling.TopoDAG n) (c0 : ColState n) : ℕ → ColState n
  | 0 => promote c0
  | 1 => promote (stepOne G (timedReach G c0 0))
  | t + 2 => promote (stepTwo G (timedReach G c0 t) (timedReach G c0 (t + 1)))

theorem mem_promote_lowerWhole {c : ColState n} {w : Fin n} :
    w ∈ (promote c).lowerWhole ↔ w ∈ c.lowerWhole ∨ ∀ u, (w, u) ∈ c.lowerCol := by
  simp [promote]

theorem mem_revCols {G : Labelling.TopoDAG n} {c : ColState n} {p : Fin n × Fin n} :
    p ∈ revCols G c ↔ p.2 ∈ c.topWhole ∧ G.par p.2 ⊆ c.topWhole := by
  simp [revCols]

/-! ### `colReach` only grows -/

theorem colRound_mono (G : Labelling.TopoDAG n) (c : ColState n) :
    c.lowerWhole ⊆ (colRound G c).lowerWhole ∧ c.lowerCol ⊆ (colRound G c).lowerCol ∧
      c.topWhole ⊆ (colRound G c).topWhole :=
  ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left⟩

theorem colReach_mono (G : Labelling.TopoDAG n) (c0 : ColState n) {r s : ℕ} (h : r ≤ s) :
    (colReach G c0 r).lowerWhole ⊆ (colReach G c0 s).lowerWhole ∧
      (colReach G c0 r).lowerCol ⊆ (colReach G c0 s).lowerCol ∧
      (colReach G c0 r).topWhole ⊆ (colReach G c0 s).topWhole := by
  induction h with
  | refl => exact ⟨subset_rfl, subset_rfl, subset_rfl⟩
  | step _ ih =>
    obtain ⟨h1, h2, h3⟩ := colRound_mono G (colReach G c0 _)
    exact ⟨ih.1.trans h1, ih.2.1.trans h2, ih.2.2.trans h3⟩

theorem mem_colRound_lowerWhole_of_cols (G : Labelling.TopoDAG n) {c : ColState n} {w : Fin n}
    (h : ∀ u, (w, u) ∈ c.lowerCol) : w ∈ (colRound G c).lowerWhole := by
  simp only [colRound, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]
  exact Or.inr (Or.inr h)

theorem mem_colRound_lowerWhole_of_par (G : Labelling.TopoDAG n) {c : ColState n} {w : Fin n}
    (h : G.par w ⊆ c.lowerWhole) : w ∈ (colRound G c).lowerWhole := by
  simp only [colRound, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]
  exact Or.inr (Or.inl h)

theorem revCols_sub (G : Labelling.TopoDAG n) {s c : ColState n} (h : s.topWhole ⊆ c.topWhole) :
    revCols G s ⊆ (colRound G c).lowerCol := by
  intro p hp
  rw [mem_revCols] at hp
  simp only [colRound, Finset.mem_union, Finset.mem_product, Finset.mem_univ, true_and, Finset.mem_filter]
  exact Or.inr ⟨h hp.1, hp.2.trans h⟩

/-! ### The simulation -/

/-- The invariant at round `t`: tops and columns on time, whole lower labels on time unless promoted (then all their
columns are on time), and every whole lower label at most one game round late. -/
def Sim (G : Labelling.TopoDAG n) (c0 : ColState n) (t : ℕ) : Prop :=
  (timedReach G c0 t).topWhole ⊆ (colReach G c0 t).topWhole ∧
  (timedReach G c0 t).lowerCol ⊆ (colReach G c0 t).lowerCol ∧
  (∀ w ∈ (timedReach G c0 t).lowerWhole,
    w ∈ (colReach G c0 t).lowerWhole ∨ ∀ u, (w, u) ∈ (timedReach G c0 t).lowerCol) ∧
  (timedReach G c0 t).lowerWhole ⊆ (colReach G c0 (t + 1)).lowerWhole

section

variable (G : Labelling.TopoDAG n) (c0 : ColState n)

theorem sim_zero : Sim G c0 0 := by
  refine ⟨subset_rfl, subset_rfl, fun w hw => ?_, fun w hw => ?_⟩ <;>
    rcases mem_promote_lowerWhole.1 hw with hw | hw
  · exact Or.inl hw
  · exact Or.inr hw
  · exact (colRound_mono G c0).1 hw
  · exact mem_colRound_lowerWhole_of_cols G hw

theorem sim_one (h0 : Sim G c0 0) : Sim G c0 1 := by
  obtain ⟨hT0, hC0, hL0, hW0⟩ := h0
  have hR := colReach_mono G c0 (Nat.le_succ 0)
  have hR1 := colReach_mono G c0 (Nat.le_succ 1)
  have hC1 : (timedReach G c0 1).lowerCol ⊆ (colReach G c0 1).lowerCol := by
    intro p hp
    rcases Finset.mem_union.1 hp with hp | hp
    · exact hR.2.1 (hC0 hp)
    · exact revCols_sub G hT0 hp
  refine ⟨fun u hu => hR.2.2 (hT0 hu), hC1, fun w hw => ?_, fun w hw => ?_⟩ <;>
    rcases mem_promote_lowerWhole.1 hw with hw | hw
  · rcases hL0 w hw with h | h
    · exact Or.inl (hR.1 h)
    · exact Or.inr fun u => Finset.mem_union_left _ (h u)
  · exact Or.inr hw
  · exact hR1.1 (hW0 hw)
  · exact mem_colRound_lowerWhole_of_cols G fun u => hC1 (hw u)

theorem sim_succ_succ (t : ℕ) (ht : Sim G c0 t) (ht1 : Sim G c0 (t + 1)) : Sim G c0 (t + 2) := by
  obtain ⟨hT0, -, -, hW0⟩ := ht
  obtain ⟨hT1, hC1, hL1, hW1⟩ := ht1
  have hR := colReach_mono G c0 (Nat.le_succ (t + 1))
  have hR0 := colReach_mono G c0 (Nat.le_succ t)
  have hR2 := colReach_mono G c0 (Nat.le_succ (t + 2))
  have hC2 : (timedReach G c0 (t + 2)).lowerCol ⊆ (colReach G c0 (t + 2)).lowerCol := by
    intro p hp
    rcases Finset.mem_union.1 hp with hp | hp
    · exact hR.2.1 (hC1 hp)
    · exact revCols_sub G hT1 hp
  refine ⟨fun u hu => ?_, hC2, fun w hw => ?_, fun w hw => ?_⟩
  · rcases Finset.mem_union.1 hu with hu | hu
    · exact hR.2.2 (hT1 hu)
    · obtain ⟨hcols, hpar⟩ := (Finset.mem_filter.1 hu).2
      show u ∈ (colRound G (colReach G c0 (t + 1))).topWhole
      simp only [colRound, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]
      refine Or.inr ⟨fun w => ?_, hpar.trans (hT0.trans hR0.2.2)⟩
      rcases hcols w with h | h
      · rcases hL1 w h with h' | h'
        · exact Or.inl h'
        · exact Or.inr (hC1 (h' u))
      · exact Or.inr (hC1 h)
  · rcases mem_promote_lowerWhole.1 hw with hw | hw
    · rcases Finset.mem_union.1 hw with hw | hw
      · rcases hL1 w hw with h | h
        · exact Or.inl (hR.1 h)
        · exact Or.inr fun u => Finset.mem_union_left _ (h u)
      · exact Or.inl (mem_colRound_lowerWhole_of_par G ((Finset.mem_filter.1 hw).2.trans hW0))
    · exact Or.inr hw
  · rcases mem_promote_lowerWhole.1 hw with hw | hw
    · rcases Finset.mem_union.1 hw with hw | hw
      · exact hR2.1 (hW1 hw)
      · exact hR2.1 (mem_colRound_lowerWhole_of_par G ((Finset.mem_filter.1 hw).2.trans hW0))
    · exact mem_colRound_lowerWhole_of_cols G fun u => hC2 (hw u)

theorem sim_pair (t : ℕ) : Sim G c0 t ∧ Sim G c0 (t + 1) := by
  induction t with
  | zero => exact ⟨sim_zero G c0, sim_one G c0 (sim_zero G c0)⟩
  | succ t ih => exact ⟨ih.2, sim_succ_succ G c0 t ih.1 ih.2⟩

/-- **The simulation**: after `t` oracle rounds at real costs, tops and columns are within `colReach` at `t`, whole
lower labels within `t + 1` (on time unless promoted). -/
theorem timedReach_sub (t : ℕ) : Sim G c0 t :=
  (sim_pair G c0 t).1

/-- **`g(D) = D`**: every top known after `D` oracle rounds is in `colReach` at depth `D`. -/
theorem topWhole_timedReach_sub (D : ℕ) :
    (timedReach G c0 D).topWhole ⊆ (colReach G c0 D).topWhole :=
  (timedReach_sub G c0 D).1

/-- `ColumnHard` at game depth `D` prices a `D`-oracle-round timed run. -/
theorem columnHard_timed {D k X : ℕ} (hard : ColumnHard G D k X)
    (hk : k ≤ (timedReach G c0 D).topWhole.card) : (k - X) * n ≤ c0.size :=
  hard c0 (hk.trans (Finset.card_le_card (topWhole_timedReach_sub G c0 D)))

end

/-! ### `(D+1)/2` is too small (red-team §22, in this abstraction) -/

/-- The path `0 → 1`. -/
def path2 : Labelling.TopoDAG 2 where
  par v := Finset.univ.filter fun u : Fin 2 => (u : ℕ) + 1 = v
  par_lt v u h := by
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at h
    exact Fin.lt_def.2 (by omega)

/-- Hold top `0` and column `(0, 1)`. Round 1: reverse at top `0` (columns `(·, 0)`), promotion of lower `0`;
rounds 2–3: forward-lower `1`; round 4: forward-top `1`. -/
def c0w : ColState 2 := { lowerWhole := ∅, lowerCol := {(0, 1)}, topWhole := {0} }

theorem timedReach_not_half :
    (1 : Fin 2) ∈ (timedReach path2 c0w 4).topWhole ∧ (1 : Fin 2) ∉ (colReach path2 c0w ((4 + 1) / 2)).topWhole := by
  decide

end PousTimedGame

end


/-! ════ Freshness.Keyed ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Held keys are dominated: a keyed holding reaches no more than an equal-size holding without keys

A holding may also store keys: `k¹_w` (lower) and `k²_u` (top), each priced at `n` column units (a whole label; under
the overwrite-chain `H` a held key costs a chaining value, `1 + 512/m` labels). In the timed game (`timedReachK`):

* a held `k¹_w` gives `c¹_w` after 1 round (`P_{(τ,0,w)}(W_w ⊕ k¹_w)`, no parents);
* a held `k²_u` gives `c²_u` 1 round after its columns (no parent tops), and column `u` of every lower label 1 round
  after `c²_u` (a reverse without the key gate).

`dropKeys c` replaces each held key by what it buys, at no greater cost (`size_dropKeys_le`):
* a lower key `k¹_w` by the lower label `w`;
* a top key `k²_u` by top `u` when `u` is not held;
* a top key `k²_u` by the columns `(·, u)` when `u` is held.
A key-free reverse at a top `u` that is not held is worthless: `u` was computed forward, so its columns were already
available (`timedReachK_top`).

`timedReachK_dom` shows the keyed game stays inside the unkeyed game from `dropKeys c`, round by round. So
`topWhole_timedReachK_sub` holds: keyed tops at `D` are in `colReach (dropKeys c) D`. `columnHard_timedK` follows:
`ColumnHard G D k X` prices keyed holdings at their full size.
-/

namespace PousTimedGame

open Pous Pous.ColumnAware

variable {n : ℕ}

/-- Column `(w, u)` is available: `w` is whole, or the column is held. -/
abbrev avail (c : ColState n) (w u : Fin n) : Prop := w ∈ c.lowerWhole ∨ (w, u) ∈ c.lowerCol

/-- Componentwise inclusion. -/
def Le (c d : ColState n) : Prop :=
  c.lowerWhole ⊆ d.lowerWhole ∧ c.lowerCol ⊆ d.lowerCol ∧ c.topWhole ⊆ d.topWhole

theorem Le.trans {c d e : ColState n} (h₁ : Le c d) (h₂ : Le d e) : Le c e :=
  ⟨h₁.1.trans h₂.1, h₁.2.1.trans h₂.2.1, h₁.2.2.trans h₂.2.2⟩

theorem avail_mono {c d : ColState n} (h : Le c d) {w u : Fin n} (hc : avail c w u) : avail d w u :=
  hc.imp (fun h' => h.1 h') (fun h' => h.2.1 h')

theorem mem_promote_of_avail {c : ColState n} {w : Fin n} (h : ∀ u, avail (promote c) w u) :
    w ∈ (promote c).lowerWhole := by
  by_cases hw : w ∈ (promote c).lowerWhole
  · exact hw
  · exact mem_promote_lowerWhole.2 (Or.inr fun u => (h u).resolve_left hw)

/-! ### The unkeyed timed game grows, and promotes -/

section Unkeyed

variable (G : Labelling.TopoDAG n) (c0 : ColState n)

theorem timedReach_le_succ : ∀ t, Le (timedReach G c0 t) (timedReach G c0 (t + 1))
  | 0 => ⟨Finset.subset_union_left, Finset.subset_union_left, subset_rfl⟩
  | _ + 1 => ⟨Finset.subset_union_left.trans Finset.subset_union_left, Finset.subset_union_left,
      Finset.subset_union_left⟩

theorem timedReach_mono {s t : ℕ} (h : s ≤ t) : Le (timedReach G c0 s) (timedReach G c0 t) := by
  induction h with
  | refl => exact ⟨subset_rfl, subset_rfl, subset_rfl⟩
  | step _ ih => exact ih.trans (timedReach_le_succ G c0 _)

theorem timedReach_whole_of_avail {w : Fin n} :
    ∀ t, (∀ u, avail (timedReach G c0 t) w u) → w ∈ (timedReach G c0 t).lowerWhole
  | 0, h => mem_promote_of_avail h
  | 1, h => mem_promote_of_avail h
  | _ + 2, h => mem_promote_of_avail h

end Unkeyed

/-! ### The keyed timed game -/

/-- A holding with keys: `lowerKey` holds `k¹_w`, `topKey` holds `k²_u`. -/
structure KState (n : ℕ) where
  hold : ColState n
  lowerKey : Finset (Fin n)
  topKey : Finset (Fin n)

/-- Size in column units: each held key costs `n` (a whole label). -/
def KState.size (c : KState n) : ℕ := c.hold.size + n * c.lowerKey.card + n * c.topKey.card

/-- Reverse (1 round) at a known top whose top parents are known, or whose key is held. -/
def revColsK (G : Labelling.TopoDAG n) (K : Finset (Fin n)) (b : ColState n) : Finset (Fin n × Fin n) :=
  Finset.univ ×ˢ b.topWhole.filter fun u => G.par u ⊆ b.topWhole ∨ u ∈ K

/-- Round `1` before promotion: held lower keys give their labels, held top keys a forward-top from round-0
columns; reverse from round `0`. -/
def stepOneK (G : Labelling.TopoDAG n) (c : KState n) (b : ColState n) : ColState n where
  lowerWhole := b.lowerWhole ∪ c.lowerKey
  lowerCol := b.lowerCol ∪ revColsK G c.topKey b
  topWhole := b.topWhole ∪ c.topKey.filter fun u => ∀ w, avail b w u

/-- Round `t + 2` before promotion, from rounds `t` (`a`) and `t + 1` (`b`). -/
def stepTwoK (G : Labelling.TopoDAG n) (c : KState n) (a b : ColState n) : ColState n where
  lowerWhole := b.lowerWhole ∪ (Finset.univ.filter fun w => G.par w ⊆ a.lowerWhole) ∪ c.lowerKey
  lowerCol := b.lowerCol ∪ revColsK G c.topKey b
  topWhole := b.topWhole ∪ Finset.univ.filter fun u =>
    (∀ w, avail b w u) ∧ (G.par u ⊆ a.topWhole ∨ u ∈ c.topKey)

/-- The holding known after `t` oracle rounds from a keyed holding `c`, every move at its real cost. -/
def timedReachK (G : Labelling.TopoDAG n) (c : KState n) : ℕ → ColState n
  | 0 => promote c.hold
  | 1 => promote (stepOneK G c (timedReachK G c 0))
  | t + 2 => promote (stepTwoK G c (timedReachK G c t) (timedReachK G c (t + 1)))

/-- Each held key replaced by what it buys. -/
def dropKeys (c : KState n) : ColState n where
  lowerWhole := c.hold.lowerWhole ∪ c.lowerKey
  lowerCol := c.hold.lowerCol ∪ Finset.univ ×ˢ (c.topKey ∩ c.hold.topWhole)
  topWhole := c.hold.topWhole ∪ c.topKey

theorem size_dropKeys_le (c : KState n) : (dropKeys c).size ≤ c.size := by
  simp only [dropKeys, ColState.size, KState.size]
  have h1 := Finset.card_union_le c.hold.lowerWhole c.lowerKey
  have h2 := Finset.card_union_le c.hold.lowerCol (Finset.univ ×ˢ (c.topKey ∩ c.hold.topWhole))
  have h3 : (c.hold.topWhole ∪ c.topKey).card = c.hold.topWhole.card + (c.topKey \ c.hold.topWhole).card := by
    rw [← Finset.union_sdiff_self_eq_union, Finset.card_union_of_disjoint Finset.disjoint_sdiff]
  have h4 := Finset.card_sdiff_add_card_inter c.topKey c.hold.topWhole
  rw [Finset.card_product, Finset.card_univ, Fintype.card_fin] at h2
  have := Nat.mul_le_mul_left n h1
  rw [h3]
  nlinarith

/-- With no keys, the keyed game is the timed game. -/
theorem timedReachK_noKeys (G : Labelling.TopoDAG n) (c0 : ColState n) :
    ∀ t, timedReachK G ⟨c0, ∅, ∅⟩ t = timedReach G c0 t
  | 0 => rfl
  | 1 => by
    show promote (stepOneK G ⟨c0, ∅, ∅⟩ (timedReachK G ⟨c0, ∅, ∅⟩ 0)) = promote (stepOne G (timedReach G c0 0))
    rw [timedReachK_noKeys G c0 0]
    simp [stepOneK, stepOne, revColsK, revCols]
  | t + 2 => by
    show promote (stepTwoK G ⟨c0, ∅, ∅⟩ (timedReachK G ⟨c0, ∅, ∅⟩ t) (timedReachK G ⟨c0, ∅, ∅⟩ (t + 1))) =
      promote (stepTwo G (timedReach G c0 t) (timedReach G c0 (t + 1)))
    rw [timedReachK_noKeys G c0 t, timedReachK_noKeys G c0 (t + 1)]
    simp [stepTwoK, stepTwo, revColsK, revCols]

section Keyed

variable (G : Labelling.TopoDAG n) (c : KState n)

theorem timedReachK_le_succ : ∀ t, Le (timedReachK G c t) (timedReachK G c (t + 1))
  | 0 => ⟨Finset.subset_union_left.trans Finset.subset_union_left, Finset.subset_union_left,
      Finset.subset_union_left⟩
  | _ + 1 => ⟨(Finset.subset_union_left.trans Finset.subset_union_left).trans Finset.subset_union_left,
      Finset.subset_union_left, Finset.subset_union_left⟩

/-- A known top is held, or all its columns are available (it was computed forward). -/
theorem timedReachK_top : ∀ t, ∀ u ∈ (timedReachK G c t).topWhole,
    u ∈ c.hold.topWhole ∨ ∀ w, avail (timedReachK G c t) w u
  | 0, _, hu => Or.inl hu
  | 1, u, hu => by
    rcases Finset.mem_union.1 hu with hu | hu
    · exact (timedReachK_top 0 u hu).imp id fun h w => avail_mono (timedReachK_le_succ G c 0) (h w)
    · exact Or.inr fun w => avail_mono (timedReachK_le_succ G c 0) ((Finset.mem_filter.1 hu).2 w)
  | t + 2, u, hu => by
    rcases Finset.mem_union.1 hu with hu | hu
    · exact (timedReachK_top (t + 1) u hu).imp id fun h w => avail_mono (timedReachK_le_succ G c (t + 1)) (h w)
    · exact Or.inr fun w => avail_mono (timedReachK_le_succ G c (t + 1)) ((Finset.mem_filter.1 hu).2.1 w)

/-- The keyed game at round `t` is inside the unkeyed game from `dropKeys c` at round `t`: tops and whole lower
labels contained, keyed columns available. -/
def Dom (t : ℕ) : Prop :=
  (timedReachK G c t).topWhole ⊆ (timedReach G (dropKeys c) t).topWhole ∧
  (timedReachK G c t).lowerWhole ⊆ (timedReach G (dropKeys c) t).lowerWhole ∧
  ∀ w u, (w, u) ∈ (timedReachK G c t).lowerCol → avail (timedReach G (dropKeys c) t) w u

theorem avail_of_dom {t : ℕ} (h : Dom G c t) {w u : Fin n} (hw : avail (timedReachK G c t) w u) :
    avail (timedReach G (dropKeys c) t) w u :=
  hw.elim (fun h' => Or.inl (h.2.1 h')) (fun h' => h.2.2 w u h')

theorem lowerKey_sub (t : ℕ) : c.lowerKey ⊆ (timedReach G (dropKeys c) t).lowerWhole :=
  fun _ hw => (timedReach_mono G (dropKeys c) (Nat.zero_le t)).1
    (Finset.mem_union_left _ (Finset.mem_union_right _ hw))

theorem topKey_sub (t : ℕ) : c.topKey ⊆ (timedReach G (dropKeys c) t).topWhole :=
  fun _ hu => (timedReach_mono G (dropKeys c) (Nat.zero_le t)).2.2 (Finset.mem_union_right _ hu)

theorem heldKeyCols_sub (t : ℕ) {w u : Fin n} (hk : u ∈ c.topKey) (hh : u ∈ c.hold.topWhole) :
    (w, u) ∈ (timedReach G (dropKeys c) t).lowerCol :=
  (timedReach_mono G (dropKeys c) (Nat.zero_le t)).2.1
    (Finset.mem_union_right _ (Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_inter.2 ⟨hk, hh⟩⟩))

/-- The columns a keyed reverse at round `t + 1` yields are available in the unkeyed game at `t + 1`. -/
theorem revColsK_avail {t : ℕ} (h : Dom G c t) (hrev : revCols G (timedReach G (dropKeys c) t) ⊆
      (timedReach G (dropKeys c) (t + 1)).lowerCol) {w u : Fin n}
    (hp : (w, u) ∈ revColsK G c.topKey (timedReachK G c t)) :
    avail (timedReach G (dropKeys c) (t + 1)) w u := by
  simp only [revColsK, Finset.mem_product, Finset.mem_univ, true_and, Finset.mem_filter] at hp
  obtain ⟨hu, hgate | hkey⟩ := hp
  · exact Or.inr (hrev (mem_revCols.2 ⟨h.1 hu, hgate.trans h.1⟩))
  · rcases timedReachK_top G c t u hu with hh | hcols
    · exact Or.inr (heldKeyCols_sub G c (t + 1) hkey hh)
    · exact avail_mono (timedReach_le_succ G (dropKeys c) t) (avail_of_dom G c h (hcols w))

theorem dom_zero : Dom G c 0 := by
  refine ⟨Finset.subset_union_left, fun w hw => ?_, fun w u hwu => Or.inr (Finset.mem_union_left _ hwu)⟩
  rcases mem_promote_lowerWhole.1 hw with hw | hw
  · exact Finset.mem_union_left _ (Finset.mem_union_left _ hw)
  · exact mem_promote_lowerWhole.2 (Or.inr fun u => Finset.mem_union_left _ (hw u))

theorem dom_one (h0 : Dom G c 0) : Dom G c 1 := by
  have hm := timedReach_le_succ G (dropKeys c) 0
  have hC : ∀ w u, (w, u) ∈ (timedReachK G c 1).lowerCol → avail (timedReach G (dropKeys c) 1) w u := by
    intro w u hwu
    rcases Finset.mem_union.1 hwu with hwu | hwu
    · exact avail_mono hm (h0.2.2 w u hwu)
    · exact revColsK_avail G c h0 Finset.subset_union_right hwu
  refine ⟨fun u hu => ?_, fun w hw => ?_, hC⟩
  · rcases Finset.mem_union.1 hu with hu | hu
    · exact hm.2.2 (h0.1 hu)
    · exact topKey_sub G c 1 (Finset.mem_filter.1 hu).1
  · rcases mem_promote_lowerWhole.1 hw with hw | hw
    · rcases Finset.mem_union.1 hw with hw | hw
      · exact hm.1 (h0.2.1 hw)
      · exact lowerKey_sub G c 1 hw
    · exact timedReach_whole_of_avail G (dropKeys c) 1 fun u => hC w u (hw u)

theorem dom_succ_succ (t : ℕ) (ht : Dom G c t) (ht1 : Dom G c (t + 1)) : Dom G c (t + 2) := by
  have hm := timedReach_le_succ G (dropKeys c) (t + 1)
  have hC : ∀ w u, (w, u) ∈ (timedReachK G c (t + 2)).lowerCol →
      avail (timedReach G (dropKeys c) (t + 2)) w u := by
    intro w u hwu
    rcases Finset.mem_union.1 hwu with hwu | hwu
    · exact avail_mono hm (ht1.2.2 w u hwu)
    · exact revColsK_avail G c ht1 Finset.subset_union_right hwu
  refine ⟨fun u hu => ?_, fun w hw => ?_, hC⟩
  · rcases Finset.mem_union.1 hu with hu | hu
    · exact hm.2.2 (ht1.1 hu)
    · obtain ⟨hcols, hpar | hkey⟩ := (Finset.mem_filter.1 hu).2
      · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _,
          fun w => avail_of_dom G c ht1 (hcols w), hpar.trans ht.1⟩)
      · exact topKey_sub G c (t + 2) hkey
  · rcases mem_promote_lowerWhole.1 hw with hw | hw
    · rcases Finset.mem_union.1 hw with hw | hw
      · rcases Finset.mem_union.1 hw with hw | hw
        · exact hm.1 (ht1.2.1 hw)
        · exact mem_promote_lowerWhole.2 (Or.inl (Finset.mem_union_right _
            (Finset.mem_filter.2 ⟨Finset.mem_univ _, (Finset.mem_filter.1 hw).2.trans ht.2.1⟩)))
      · exact lowerKey_sub G c (t + 2) hw
    · exact timedReach_whole_of_avail G (dropKeys c) (t + 2) fun u => hC w u (hw u)

theorem dom_pair (t : ℕ) : Dom G c t ∧ Dom G c (t + 1) := by
  induction t with
  | zero => exact ⟨dom_zero G c, dom_one G c (dom_zero G c)⟩
  | succ t ih => exact ⟨ih.2, dom_succ_succ G c t ih.1 ih.2⟩

/-- **Domination**: at every round, the keyed game is inside the unkeyed game from `dropKeys c`. -/
theorem timedReachK_dom (t : ℕ) : Dom G c t :=
  (dom_pair G c t).1

/-- **Keys do not help**: every top known after `D` oracle rounds from a keyed holding is in `colReach` at depth
`D` from the key-free holding `dropKeys c`, which is no larger. -/
theorem topWhole_timedReachK_sub (D : ℕ) :
    (timedReachK G c D).topWhole ⊆ (colReach G (dropKeys c) D).topWhole :=
  (timedReachK_dom G c D).1.trans (topWhole_timedReach_sub G (dropKeys c) D)

/-- `ColumnHard G D k X` prices keyed holdings at their full size (keys at `n` columns each). -/
theorem columnHard_timedK {D k X : ℕ} (hard : ColumnHard G D k X)
    (hk : k ≤ (timedReachK G c D).topWhole.card) : (k - X) * n ≤ c.size :=
  (columnHard_timed G (dropKeys c) hard
    (hk.trans (Finset.card_le_card (timedReachK_dom G c D).1))).trans (size_dropKeys_le c)

end Keyed

end PousTimedGame

end


/-! ════ Freshness.Rounds ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# A program's run, round by round

`rounds f p` lists the query batches `p` sends when answered by `f`, one list per oracle round. `progTrace` is their
concatenation (`progTrace_eq_flatten`), there are `depth` of them (`length_rounds`), and a round's queries depend only on
the answers to earlier rounds (`rounds_congr`). "Known after `t` rounds" is read off `(rounds f p).take t`.
-/

namespace PousRounds

open Pous PousForwardCore

variable {M : IdealModel} {α : Type}

/-- The query batches of `p` answered by `f`, in round order. -/
def rounds (f : M.Qry → M.Ans) : Prog M α → List (List M.Qry)
  | .ret _ => []
  | .round qs k => qs :: rounds f (k (qs.map f))

theorem progTrace_eq_flatten (f : M.Qry → M.Ans) (p : Prog M α) : progTrace f p = (rounds f p).flatten := by
  induction p with
  | ret a => rfl
  | round qs k ih => simp [progTrace, rounds, ih]

theorem length_rounds (f : M.Qry → M.Ans) (p : Prog M α) : (rounds f p).length = p.depth f := by
  induction p with
  | ret a => rfl
  | round qs k ih => simp [rounds, Prog.depth, ih]

theorem length_rounds_le {D Q : ℕ} {p : Prog M α} (hb : p.Bounded D Q) (ω : M.Ω) :
    (rounds (M.answer ω) p).length ≤ D :=
  (length_rounds _ p).trans_le (hb ω).1

/-- The queries of the first `t` rounds. -/
def upTo (f : M.Qry → M.Ans) (p : Prog M α) (t : ℕ) : List M.Qry := ((rounds f p).take t).flatten

/-- Round `t + 1`'s batch, and the first `t` rounds, depend only on the answers to the first `t` rounds. -/
theorem rounds_congr {f g : M.Qry → M.Ans} :
    ∀ (p : Prog M α) (t : ℕ), (∀ q ∈ upTo f p t, f q = g q) → (rounds f p).take (t + 1) = (rounds g p).take (t + 1)
  | .ret _, _, _ => rfl
  | .round qs k, 0, _ => rfl
  | .round qs k, t + 1, h => by
    have hqs : qs.map f = qs.map g :=
      List.map_congr_left fun q hq => h q (by simp [upTo, rounds, hq])
    simp only [rounds, List.take_succ_cons, hqs]
    congr 1
    refine rounds_congr (k (qs.map g)) t fun q hq => ?_
    have := h q (by simp only [upTo, rounds, List.take_succ_cons, List.flatten_cons, List.mem_append]; right; rw [hqs]; exact hq)
    exact this

end PousRounds

end


/-! ════ Pebbling.FreshnessStmt ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `FreshnessInvariant`: the `ColumnHard → fresh-entries-unqueried` bridge (handoff statement)

This is the **exact hypothesis** the `hconstr` decode consumes, factored out for a parallel prover. It says: for a
`(D,Q)`-bounded adversary that answers `≥ k` tops in every (distinct-tagged) segment against a `ColumnHard` graph, on
every winning **non-colliding** `ω` there is, per segment, a set `Fr s` of `≥ k − X` answered top nodes whose honest
`P_t`-entry is **untouched by the run** — neither a forward `P_{(tags s,1,v)}` query at its input nor an inverse query at
its output appears in that segment's trace. Those are exactly the `(k − X)` fresh, deletable entries: unqueried ⇒
`PousTweaked.run_congr` lets the decode replay `A₂` on the reduced oracle and recover each from its correct answer via
`Equiv.Perm.decomposeOption`.

The input of the honest top `(s, v)` is `P_{(tags s,1,v)}⁻¹` of its output, i.e. `(ω.2 (tags s,1,v)).symm (topLabelT …)`.

**Do not edit after handoff without telling the coordinator.** A parallel prover discharges `FreshnessInvariant` from
`ColumnHard` + the model; `pebbling/HconstrTweaked.lean` (this subagent) proves
`FreshnessInvariant → PermIncompressibility → n10prime / n10primeMulti`.

**Depth parametrization (edit after handoff, flagged):** the `ColumnHard` depth is now `PousTweaked.gameDepth D`
(definitionally `(D+1)/2`, so any in-progress proof is unaffected) — the single fix point for the oracle-rounds →
game-depth conversion the red team is adjudicating (§22).
-/

namespace PousFreshness

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked
open scoped ENNReal

/-- **`FreshnessInvariant`** — the `ColumnHard ⇒ fresh-entries-unqueried` bridge the decode consumes. -/
def FreshnessInvariant : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n)
    (W : Fin N → Fin n → Lab n wc) (A₁ : (p3ModelT n wc).Ω → Bits m)
    (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gameDepth D) k X →
    (∀ σ s c, (A₂ σ s c).Bounded D Q) →
    ∀ ω : (p3ModelT n wc).Ω,
      -- winning: ≥ k tops answered in every segment
      (∀ s : Fin N, k ≤ (Finset.univ.filter fun v =>
          (A₂ (A₁ ω) s v).run ((p3ModelT n wc).answer ω) = topLabelT (tags s) G (W s) ω v).card) →
      -- non-colliding: honest labels of each segment are pairwise distinct (both layers)
      (∀ s : Fin N, ¬ labCollT (tags s) G (W s) ω) →
      ∃ Fr : Fin N → Finset (Fin n),
        (∀ s : Fin N, k - X ≤ (Fr s).card) ∧
        (∀ (s : Fin N), ∀ v ∈ Fr s,
          -- answered correctly
          ((A₂ (A₁ ω) s v).run ((p3ModelT n wc).answer ω) = topLabelT (tags s) G (W s) ω v) ∧
          -- the honest top `P_t`-entry is untouched by segment `s`'s run: no forward query at its input …
          (Sum.inr (Sum.inl ((tags s, 1, v),
              (ω.2 (tags s, 1, v)).symm (topLabelT (tags s) G (W s) ω v)))
            ∉ segTrace ((p3ModelT n wc).answer ω) (A₂ (A₁ ω) s)) ∧
          -- … and no inverse query at its output
          (Sum.inr (Sum.inr ((tags s, 1, v), topLabelT (tags s) G (W s) ω v))
            ∉ segTrace ((p3ModelT n wc).answer ω) (A₂ (A₁ ω) s)))

end PousFreshness

end


/-! ════ HintCard.PartialOutput ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Permutations of `Lab` consistent with known output bits, and the saving

A decode that deletes **part** of a permutation output (a lower-layer column: `wc` of the `n·wc` bits of `P_t x_t`) or a
whole output (a top label) stores the rest of the permutation and recovers the deleted bits from the adversary. This
file counts what is left to store.

* `permSplit x : Perm L ≃ L × Perm (L ∖ {x})`, `P ↦ (P x, reduced P)`: the conjugation `L ≃ Option (L ∖ {x})`
  (`Equiv.optionSubtypeNe`) followed by `Equiv.Perm.decomposeOption`.
* **One input, any constraint** (`card_perm_consistent_mul`): `#{P | p (P x)} · |L| = #{y | p y} · |L|!`, exact.
* **One input, known bits** (`card_perm_bits_mul`): with the bits of `P x` at positions `K ⊆ Fin n × Fin wc` fixed,
  `#{P | bits K (P x) = β} · 2^{|K|} = (2^{n·wc})!`, exact: knowing `|K|` output bits saves exactly `|K|` bits.
  `bitSplit x K : Perm Lab ≃ (K → Bool) × RedLab x K` is the encoder, `bitSplit_decode` the decode, and
  `card_redLab_mul` the per-tweak hint count. Columns are `K = cols ×ˢ univ` (`card_perm_cols_mul`, saving `|cols|·wc`).
* **A family over tweaks, one input each** (`familySplit`, `familySplit_decode`, `card_familyRed_mul`,
  `card_family_bits_mul`): `#{F : T → Perm Lab | ∀ t, bits (K t) (F t (x t)) = β t} · 2^{∑ₜ |K t|} = ((2^{n·wc})!)^{|T|}`,
  exact. `K t = ∅` leaves `P_t` whole.
* **A hint type independent of the inputs** (`neEquiv`, `permSplitAt`, `bitSplitAt`, `familySplitAt` and their decodes):
  the honest input `x t` depends on `ω`, so the reduced permutation is re-based at a fixed `x₀` by conjugating with
  `swap (x t) x₀`. The stored part then lies in `FamilyRed (fun _ => x₀) K` for every `x`; only the decoder needs `x`.
* **Several inputs of one permutation** (`card_perm_mem_le`, `card_perm_bits_multi_le`, `card_perm_bits_multi_pool`):
  an upper bound. `d` constrained inputs cost the falling-factorial correction
  `#{P | ∀ x ∈ I, bits (K x) (P x) = β x} · 2^{∑ |K x|} · M.descFactorial d ≤ M^d · M!` with `M = 2^{n·wc}`, i.e.
  `… · (M+1−d)^d ≤ M^d · M!` (the pool form of `PousForwardCore.henc_card_of_pool`).
-/

namespace PousHintCard

open Pous Pous.Invertible Finset

/-! ### Single-entry split -/

section General

variable {L : Type} [Fintype L] [DecidableEq L]

/-- `P ↦ (P x, reduced P)`: conjugate by `L ≃ Option (L ∖ {x})` (sending `x` to `none`), then `decomposeOption`. -/
def permSplit (x : L) : Equiv.Perm L ≃ L × Equiv.Perm {y // y ≠ x} :=
  ((Equiv.permCongr (Equiv.optionSubtypeNe x).symm).trans Equiv.Perm.decomposeOption).trans
    (Equiv.prodCongr (Equiv.optionSubtypeNe x) (Equiv.refl _))

omit [Fintype L] in
@[simp] theorem permSplit_fst (x : L) (P : Equiv.Perm L) : (permSplit x P).1 = P x := by
  change Equiv.optionSubtypeNe x ((Equiv.optionSubtypeNe x).symm (P x)) = P x
  exact Equiv.apply_symm_apply _ _

theorem card_ne (x : L) : Fintype.card {y // y ≠ x} + 1 = Fintype.card L := by
  rw [← Fintype.card_option, Fintype.card_congr (Equiv.optionSubtypeNe x)]

/-- `|Perm L| = |L| · |Perm (L ∖ {x})|`. -/
theorem card_perm_eq_mul (x : L) :
    Fintype.card (Equiv.Perm L) = Fintype.card L * Fintype.card (Equiv.Perm {y // y ≠ x}) := by
  rw [Fintype.card_congr (permSplit x), Fintype.card_prod]

/-- Permutations whose output at `x` satisfies `p` are the allowed outputs times the reduced permutations. -/
def consistentEquiv (x : L) (p : L → Prop) :
    {P : Equiv.Perm L // p (P x)} ≃ {y // p y} × Equiv.Perm {y // y ≠ x} :=
  ((permSplit x).subtypeEquiv (p := fun P => p (P x)) (q := fun c => p c.1) (fun P => by simp)).trans
    Equiv.prodSubtypeFstEquivSubtypeProd

/-- **One input, exact count.** `#{P | p (P x)} = #{y | p y} · (|L| − 1)!`. -/
theorem card_perm_consistent (x : L) (p : L → Prop) [DecidablePred p] :
    Fintype.card {P : Equiv.Perm L // p (P x)} = Fintype.card {y // p y} * (Fintype.card L - 1).factorial := by
  rw [Fintype.card_congr (consistentEquiv x p), Fintype.card_prod, Fintype.card_perm, ← card_ne x,
    Nat.add_sub_cancel]

/-- **One input, exact saving.** `#{P | p (P x)} · |L| = #{y | p y} · |L|!`: restricting `P x` to a set of `c` values
divides the permutation count by `|L| / c`. -/
theorem card_perm_consistent_mul (x : L) (p : L → Prop) [DecidablePred p] :
    Fintype.card {P : Equiv.Perm L // p (P x)} * Fintype.card L
      = Fintype.card {y // p y} * Fintype.card (Equiv.Perm L) := by
  rw [Fintype.card_congr (consistentEquiv x p), Fintype.card_prod, card_perm_eq_mul x]
  ring

/-- Re-base the deleted point at a fixed `x₀` (conjugation by `swap x x₀`), so a hint type need not depend on `x`. -/
def neEquiv (x x₀ : L) : {y // y ≠ x} ≃ {y // y ≠ x₀} :=
  (Equiv.swap x x₀).subtypeEquiv fun y => by
    rw [Ne, Ne, Equiv.swap_apply_eq_iff, Equiv.swap_apply_right]

/-- `permSplit` with the reduced permutation re-based at `x₀`: `P ↦ (P x, reduced P)` in a type independent of `x`. -/
def permSplitAt (x x₀ : L) : Equiv.Perm L ≃ L × Equiv.Perm {y // y ≠ x₀} :=
  (permSplit x).trans (Equiv.prodCongr (Equiv.refl _) (Equiv.permCongr (neEquiv x x₀)))

omit [Fintype L] in
@[simp] theorem permSplitAt_fst (x x₀ : L) (P : Equiv.Perm L) : (permSplitAt x x₀ P).1 = P x :=
  permSplit_fst x P

/-! ### Several inputs of one permutation (upper bound) -/

theorem card_compl_subtype (I : Finset L) : Fintype.card {z // z ∉ I} = Fintype.card L - I.card := by
  classical
  rw [Fintype.card_subtype, filter_not, filter_mem_eq_inter, univ_inter, card_sdiff_of_subset (subset_univ I),
    card_univ]

/-- The permutations with prescribed outputs on `I` number at most `(|L| − |I|)!`: on `Iᶜ` such a permutation is an
embedding `Iᶜ ↪ L ∖ g(I)`, and `g` is injective on `I` as soon as one exists. -/
theorem card_fiber_le (I : Finset L) (g : L → L) :
    (univ.filter fun P : Equiv.Perm L => ∀ x ∈ I, P x = g x).card ≤ (Fintype.card L - I.card).factorial := by
  set s := univ.filter fun P : Equiv.Perm L => ∀ x ∈ I, P x = g x with hs
  rcases s.eq_empty_or_nonempty with h | ⟨P0, hP0⟩
  · rw [h, card_empty]; exact Nat.zero_le _
  have hP0' : ∀ x ∈ I, P0 x = g x := (mem_filter.1 hP0).2
  have himg : (I.image g).card = I.card := by
    refine card_image_of_injOn fun a ha b hb hab => P0.injective ?_
    rw [hP0' a ha, hP0' b hb]; exact hab
  have hmem : ∀ P ∈ s, ∀ x ∈ I, P x = g x := fun P hP => (mem_filter.1 hP).2
  let φ : s → ({z // z ∉ I} ↪ {y // y ∉ I.image g}) := fun P =>
    ⟨fun z => ⟨P.1 z.1, fun hz => by
        obtain ⟨a, ha, hga⟩ := mem_image.1 hz
        have haz : a = z.1 := P.1.injective ((hmem P.1 P.2 a ha).trans hga)
        exact z.2 (haz ▸ ha)⟩,
      fun z₁ z₂ h => Subtype.ext (P.1.injective (congrArg Subtype.val h))⟩
  have hφ : Function.Injective φ := by
    intro P Q h
    refine Subtype.ext (Equiv.ext fun z => ?_)
    by_cases hz : z ∈ I
    · rw [hmem P.1 P.2 z hz, hmem Q.1 Q.2 z hz]
    · exact congrArg Subtype.val (DFunLike.congr_fun h ⟨z, hz⟩)
  have hle := Fintype.card_le_of_injective φ hφ
  rw [Fintype.card_coe, Fintype.card_embedding_eq, card_compl_subtype, card_compl_subtype, himg,
    Nat.descFactorial_self] at hle
  exact hle

/-- **Several inputs, upper bound.** Constraining the outputs at the inputs `I` to sets `A x`:
`#{P | ∀ x ∈ I, P x ∈ A x} ≤ (∏_{x ∈ I} |A x|) · (|L| − |I|)!`. -/
theorem card_perm_mem_le (I : Finset L) (A : L → Finset L) :
    (univ.filter fun P : Equiv.Perm L => ∀ x ∈ I, P x ∈ A x).card
      ≤ (Fintype.card L - I.card).factorial * ∏ x ∈ I, (A x).card := by
  set s := univ.filter fun P : Equiv.Perm L => ∀ x ∈ I, P x ∈ A x with hs
  let f : Equiv.Perm L → ((x : I) → L) := fun P x => P x
  have hmaps : ∀ P ∈ s, f P ∈ Fintype.piFinset fun x : I => A x := by
    intro P hP
    rw [Fintype.mem_piFinset]
    exact fun x => (mem_filter.1 hP).2 x.1 x.2
  have hfib : ∀ h ∈ Fintype.piFinset (fun x : I => A x),
      (s.filter fun P => f P = h).card ≤ (Fintype.card L - I.card).factorial := by
    intro h _
    refine le_trans (card_le_card ?_) (card_fiber_le I fun y => if hy : y ∈ I then h ⟨y, hy⟩ else y)
    intro P hP
    rw [mem_filter] at hP ⊢
    refine ⟨mem_univ _, fun x hx => ?_⟩
    rw [dite_eq_left_of_eq_true (eq_true hx), ← hP.2]
  refine (card_le_mul_card_image_of_maps_to hmaps _ hfib).trans (le_of_eq ?_)
  rw [Fintype.card_piFinset, prod_coe_sort I fun x => (A x).card]

end General

/-! ### Labels: known bits at positions `K` -/

section Lab

variable {n wc : ℕ}

/-- The bits of the label `y` at the positions `K` (`(i, j)`: bit `j` of component `i`). -/
def bits (K : Finset (Fin n × Fin wc)) (y : Lab n wc) : K → Bool := fun p => y p.1.1 p.1.2

/-- `Lab ≃ (bits on K) × (bits off K)`. -/
def labBits (K : Finset (Fin n × Fin wc)) : Lab n wc ≃ (K → Bool) × ({p // p ∉ K} → Bool) :=
  (Equiv.curry (Fin n) (Fin wc) Bool).symm.trans (Equiv.piEquivPiSubtypeProd (· ∈ K) fun _ => Bool)

@[simp] theorem labBits_fst (K : Finset (Fin n × Fin wc)) (y : Lab n wc) : (labBits K y).1 = bits K y := rfl

theorem card_lab (n wc : ℕ) : Fintype.card (Lab n wc) = 2 ^ (n * wc) := by
  show Fintype.card (Fin n → (Fin wc → Bool)) = 2 ^ (n * wc)
  rw [Fintype.card_fun, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin, Fintype.card_fin, ← pow_mul,
    Nat.mul_comm]

theorem card_bits_fun (K : Finset (Fin n × Fin wc)) : Fintype.card (K → Bool) = 2 ^ K.card := by
  rw [Fintype.card_fun, Fintype.card_bool, Fintype.card_coe]

/-- Labels with prescribed bits on `K`: `#{y | bits K y = β} · 2^{|K|} = 2^{n·wc}`. -/
theorem card_bits_eq_mul (K : Finset (Fin n × Fin wc)) (β : K → Bool) :
    Fintype.card {y : Lab n wc // bits K y = β} * 2 ^ K.card = 2 ^ (n * wc) := by
  have e : {y : Lab n wc // bits K y = β} ≃ {a : K → Bool // a = β} × ({p // p ∉ K} → Bool) :=
    ((labBits K).subtypeEquiv (p := fun y => bits K y = β) (q := fun c => c.1 = β) (fun y => Iff.rfl)).trans
      (Equiv.prodSubtypeFstEquivSubtypeProd (p := fun a : K → Bool => a = β))
  rw [Fintype.card_congr e, Fintype.card_prod, Fintype.card_subtype_eq, one_mul, ← card_bits_fun K,
    Nat.mul_comm, ← Fintype.card_prod, ← Fintype.card_congr (labBits K), card_lab]

/-- The per-tweak reduced description: the bits of `P x` off `K`, and the reduced permutation. -/
def RedLab (x : Lab n wc) (K : Finset (Fin n × Fin wc)) : Type :=
  ({p // p ∉ K} → Bool) × Equiv.Perm {y // y ≠ x}

instance instFintypeRedLab (x : Lab n wc) (K : Finset (Fin n × Fin wc)) : Fintype (RedLab x K) :=
  inferInstanceAs (Fintype (({p // p ∉ K} → Bool) × Equiv.Perm {y // y ≠ x}))

/-- **Encoder, one tweak.** `P ↦ (bits K (P x), rest)`, with `rest : RedLab x K` what the hint stores. -/
def bitSplit (x : Lab n wc) (K : Finset (Fin n × Fin wc)) : Equiv.Perm (Lab n wc) ≃ (K → Bool) × RedLab x K :=
  ((permSplit x).trans (Equiv.prodCongr (labBits K) (Equiv.refl _))).trans (Equiv.prodAssoc _ _ _)

@[simp] theorem bitSplit_fst (x : Lab n wc) (K : Finset (Fin n × Fin wc)) (P : Equiv.Perm (Lab n wc)) :
    (bitSplit x K P).1 = bits K (P x) := by
  change (labBits K (permSplit x P).1).1 = bits K (P x)
  rw [permSplit_fst, labBits_fst]

/-- **Decode, one tweak.** The stored rest and correctly predicted bits on `K` give back `P`. -/
theorem bitSplit_decode (x : Lab n wc) (K : Finset (Fin n × Fin wc)) (P : Equiv.Perm (Lab n wc))
    (β : K → Bool) (hβ : bits K (P x) = β) : (bitSplit x K).symm (β, (bitSplit x K P).2) = P := by
  rw [← hβ, ← bitSplit_fst x K P, Prod.mk.eta, Equiv.symm_apply_apply]

/-- **Encoder, one tweak, fixed hint type.** `bitSplit` with the reduced permutation re-based at `x₀`: the stored part
lies in `RedLab x₀ K` whatever the (`ω`-dependent) input `x`; the decoder needs `x`, the hint does not. -/
def bitSplitAt (x x₀ : Lab n wc) (K : Finset (Fin n × Fin wc)) :
    Equiv.Perm (Lab n wc) ≃ (K → Bool) × RedLab x₀ K :=
  ((permSplitAt x x₀).trans (Equiv.prodCongr (labBits K) (Equiv.refl _))).trans (Equiv.prodAssoc _ _ _)

@[simp] theorem bitSplitAt_fst (x x₀ : Lab n wc) (K : Finset (Fin n × Fin wc)) (P : Equiv.Perm (Lab n wc)) :
    (bitSplitAt x x₀ K P).1 = bits K (P x) := by
  change (labBits K (permSplitAt x x₀ P).1).1 = bits K (P x)
  rw [permSplitAt_fst, labBits_fst]

theorem bitSplitAt_decode (x x₀ : Lab n wc) (K : Finset (Fin n × Fin wc)) (P : Equiv.Perm (Lab n wc))
    (β : K → Bool) (hβ : bits K (P x) = β) : (bitSplitAt x x₀ K).symm (β, (bitSplitAt x x₀ K P).2) = P := by
  rw [← hβ, ← bitSplitAt_fst x x₀ K P, Prod.mk.eta, Equiv.symm_apply_apply]

/-- **Per-tweak hint count, exact.** `|RedLab x K| · 2^{|K|} = (2^{n·wc})!`. -/
theorem card_redLab_mul (x : Lab n wc) (K : Finset (Fin n × Fin wc)) :
    Fintype.card (RedLab x K) * 2 ^ K.card = (2 ^ (n * wc)).factorial := by
  have h := Fintype.card_congr (bitSplit x K)
  rw [Fintype.card_prod, card_bits_fun, Fintype.card_perm, card_lab] at h
  rw [h, Nat.mul_comm]

/-- **One input, known bits, exact.** `#{P | bits K (P x) = β} · 2^{|K|} = (2^{n·wc})!`. -/
theorem card_perm_bits_mul (x : Lab n wc) (K : Finset (Fin n × Fin wc)) (β : K → Bool) :
    Fintype.card {P : Equiv.Perm (Lab n wc) // bits K (P x) = β} * 2 ^ K.card = (2 ^ (n * wc)).factorial := by
  have h := card_perm_consistent_mul x (fun y => bits K y = β)
  have hb := card_bits_eq_mul K β
  have hpos : 0 < Fintype.card (Lab n wc) := Fintype.card_pos
  rw [Fintype.card_perm, card_lab] at h
  rw [card_lab] at hpos
  have key : Fintype.card {P : Equiv.Perm (Lab n wc) // bits K (P x) = β} * 2 ^ K.card * 2 ^ (n * wc)
      = (2 ^ (n * wc)).factorial * 2 ^ (n * wc) := by
    rw [Nat.mul_right_comm, h, Nat.mul_right_comm, hb, Nat.mul_comm]
  exact Nat.eq_of_mul_eq_mul_right hpos key

/-- Deleting the columns `cols` of `P x` is `K = cols ×ˢ univ`, `|K| = |cols| · wc`. -/
theorem card_cols (cols : Finset (Fin n)) : (cols ×ˢ (univ : Finset (Fin wc))).card = cols.card * wc := by
  rw [card_product, card_univ, Fintype.card_fin]

/-- **One input, known columns, exact.** Knowing the columns `cols` of `P x` saves `|cols| · wc` bits. -/
theorem card_perm_cols_mul (x : Lab n wc) (cols : Finset (Fin n)) (β : ↥(cols ×ˢ (univ : Finset (Fin wc))) → Bool) :
    Fintype.card {P : Equiv.Perm (Lab n wc) // bits (cols ×ˢ univ) (P x) = β} * 2 ^ (cols.card * wc)
      = (2 ^ (n * wc)).factorial := by
  rw [← card_cols cols]; exact card_perm_bits_mul x _ β

/-! ### A family over tweaks, one input per tweak -/

variable {T : Type} [Fintype T] [DecidableEq T]

/-- The family hint: per tweak, the bits of `P_t (x t)` off `K t` and the reduced permutation. -/
def FamilyRed (x : T → Lab n wc) (K : T → Finset (Fin n × Fin wc)) : Type := (t : T) → RedLab (x t) (K t)

instance instFintypeFamilyRed (x : T → Lab n wc) (K : T → Finset (Fin n × Fin wc)) : Fintype (FamilyRed x K) :=
  inferInstanceAs (Fintype ((t : T) → RedLab (x t) (K t)))

/-- **Encoder, family.** `F ↦ ((bits (K t) (F t (x t)))ₜ, rest)`. -/
def familySplit (x : T → Lab n wc) (K : T → Finset (Fin n × Fin wc)) :
    (T → Equiv.Perm (Lab n wc)) ≃ ((t : T) → K t → Bool) × FamilyRed x K :=
  (Equiv.piCongrRight fun t => bitSplit (x t) (K t)).trans (Equiv.arrowProdEquivProdArrow _ _ _)

omit [Fintype T] [DecidableEq T] in
@[simp] theorem familySplit_fst (x : T → Lab n wc) (K : T → Finset (Fin n × Fin wc)) (F : T → Equiv.Perm (Lab n wc)) :
    (familySplit x K F).1 = fun t => bits (K t) (F t (x t)) := by
  funext t; exact bitSplit_fst (x t) (K t) (F t)

omit [Fintype T] [DecidableEq T] in
/-- **Decode, family.** The stored rest and correctly predicted bits give back the whole family. -/
theorem familySplit_decode (x : T → Lab n wc) (K : T → Finset (Fin n × Fin wc)) (F : T → Equiv.Perm (Lab n wc))
    (β : (t : T) → K t → Bool) (hβ : ∀ t, bits (K t) (F t (x t)) = β t) :
    (familySplit x K).symm (β, (familySplit x K F).2) = F := by
  have : β = (familySplit x K F).1 := by rw [familySplit_fst]; funext t; exact (hβ t).symm
  rw [this, Prod.mk.eta, Equiv.symm_apply_apply]

/-- **Encoder, family, fixed hint type.** Each tweak's reduced permutation re-based at `x₀`, so the stored part lies in
`FamilyRed (fun _ => x₀) K` for every family of inputs `x`. -/
def familySplitAt (x : T → Lab n wc) (x₀ : Lab n wc) (K : T → Finset (Fin n × Fin wc)) :
    (T → Equiv.Perm (Lab n wc)) ≃ ((t : T) → K t → Bool) × FamilyRed (fun _ => x₀) K :=
  (Equiv.piCongrRight fun t => bitSplitAt (x t) x₀ (K t)).trans (Equiv.arrowProdEquivProdArrow _ _ _)

omit [Fintype T] [DecidableEq T] in
@[simp] theorem familySplitAt_fst (x : T → Lab n wc) (x₀ : Lab n wc) (K : T → Finset (Fin n × Fin wc))
    (F : T → Equiv.Perm (Lab n wc)) : (familySplitAt x x₀ K F).1 = fun t => bits (K t) (F t (x t)) := by
  funext t; exact bitSplitAt_fst (x t) x₀ (K t) (F t)

omit [Fintype T] [DecidableEq T] in
theorem familySplitAt_decode (x : T → Lab n wc) (x₀ : Lab n wc) (K : T → Finset (Fin n × Fin wc))
    (F : T → Equiv.Perm (Lab n wc)) (β : (t : T) → K t → Bool) (hβ : ∀ t, bits (K t) (F t (x t)) = β t) :
    (familySplitAt x x₀ K).symm (β, (familySplitAt x x₀ K F).2) = F := by
  have : β = (familySplitAt x x₀ K F).1 := by rw [familySplitAt_fst]; funext t; exact (hβ t).symm
  rw [this, Prod.mk.eta, Equiv.symm_apply_apply]

/-- A per-coordinate saving multiplies out over a Π type. -/
theorem card_pi_mul_prod (β : T → Type) [∀ t, Fintype (β t)] (c : T → ℕ) (K : ℕ)
    (h : ∀ t, Fintype.card (β t) * c t = K) :
    Fintype.card ((t : T) → β t) * ∏ t, c t = K ^ Fintype.card T := by
  rw [Fintype.card_pi, ← prod_mul_distrib, ← card_univ, ← prod_const]
  exact prod_congr rfl fun t _ => h t

/-- **Family hint count, exact.** `|FamilyRed x K| · 2^{∑ₜ |K t|} = ((2^{n·wc})!)^{|T|}` = `|T → Perm Lab|`. -/
theorem card_familyRed_mul (x : T → Lab n wc) (K : T → Finset (Fin n × Fin wc)) :
    Fintype.card (FamilyRed x K) * 2 ^ (∑ t, (K t).card) = ((2 ^ (n * wc)).factorial) ^ Fintype.card T := by
  rw [← prod_pow_eq_pow_sum]
  exact card_pi_mul_prod (fun t => RedLab (x t) (K t)) _ _ fun t => card_redLab_mul (x t) (K t)

theorem card_familyRed_mul' (x : T → Lab n wc) (K : T → Finset (Fin n × Fin wc)) :
    Fintype.card (FamilyRed x K) * 2 ^ (∑ t, (K t).card) = Fintype.card (T → Equiv.Perm (Lab n wc)) := by
  rw [card_familyRed_mul, Fintype.card_fun, Fintype.card_perm, card_lab]

/-- **Family, known bits, exact.** `#{F | ∀ t, bits (K t) (F t (x t)) = β t} · 2^{∑ₜ |K t|} = ((2^{n·wc})!)^{|T|}`. -/
theorem card_family_bits_mul (x : T → Lab n wc) (K : T → Finset (Fin n × Fin wc)) (β : (t : T) → K t → Bool) :
    Fintype.card {F : T → Equiv.Perm (Lab n wc) // ∀ t, bits (K t) (F t (x t)) = β t} * 2 ^ (∑ t, (K t).card)
      = ((2 ^ (n * wc)).factorial) ^ Fintype.card T := by
  have e : {F : T → Equiv.Perm (Lab n wc) // ∀ t, bits (K t) (F t (x t)) = β t}
      ≃ {a : (t : T) → K t → Bool // a = β} × FamilyRed x K :=
    ((familySplit x K).subtypeEquiv (p := fun F => ∀ t, bits (K t) (F t (x t)) = β t) (q := fun c => c.1 = β)
      (fun F => by rw [familySplit_fst, funext_iff])).trans
      (Equiv.prodSubtypeFstEquivSubtypeProd (p := fun a : (t : T) → K t → Bool => a = β))
  rw [Fintype.card_congr e, Fintype.card_prod, Fintype.card_subtype_eq, one_mul, card_familyRed_mul]

/-! ### Several inputs of one permutation, known bits (upper bound with the falling-factorial correction) -/

/-- **Several inputs, known bits.** With `M = 2^{n·wc}` and `d = |I|` constrained inputs of one permutation,
`#{P | ∀ x ∈ I, bits (K x) (P x) = β x} · 2^{∑_{x ∈ I} |K x|} · M.descFactorial d ≤ M^d · M!`. At `d = 1` this is the
exact `card_perm_bits_mul`; for `d > 1` the outputs must be distinct, which costs `M^d / M.descFactorial d`. -/
theorem card_perm_bits_multi_le (I : Finset (Lab n wc)) (K : Lab n wc → Finset (Fin n × Fin wc))
    (β : (x : Lab n wc) → K x → Bool) :
    (univ.filter fun P : Equiv.Perm (Lab n wc) => ∀ x ∈ I, bits (K x) (P x) = β x).card
        * 2 ^ (∑ x ∈ I, (K x).card) * (2 ^ (n * wc)).descFactorial I.card
      ≤ (2 ^ (n * wc)) ^ I.card * (2 ^ (n * wc)).factorial := by
  set M := 2 ^ (n * wc) with hM
  let A : Lab n wc → Finset (Lab n wc) := fun x => univ.filter fun y => bits (K x) y = β x
  have hA : ∀ x, (A x).card * 2 ^ (K x).card = M := by
    intro x
    rw [hM, ← card_bits_eq_mul (K x) (β x), Fintype.card_subtype]
  have hset : (univ.filter fun P : Equiv.Perm (Lab n wc) => ∀ x ∈ I, bits (K x) (P x) = β x)
      = univ.filter fun P : Equiv.Perm (Lab n wc) => ∀ x ∈ I, P x ∈ A x := by
    ext P; simp [A]
  have hd : I.card ≤ M := by rw [hM, ← card_lab]; exact card_le_univ I
  have hle := card_perm_mem_le I A
  rw [card_lab, ← hM] at hle
  rw [hset]
  calc (univ.filter fun P : Equiv.Perm (Lab n wc) => ∀ x ∈ I, P x ∈ A x).card * 2 ^ (∑ x ∈ I, (K x).card)
        * M.descFactorial I.card
      ≤ (M - I.card).factorial * (∏ x ∈ I, (A x).card) * 2 ^ (∑ x ∈ I, (K x).card) * M.descFactorial I.card := by
        gcongr
    _ = (∏ x ∈ I, ((A x).card * 2 ^ (K x).card)) * ((M - I.card).factorial * M.descFactorial I.card) := by
        rw [prod_mul_distrib, prod_pow_eq_pow_sum]; ring
    _ = M ^ I.card * M.factorial := by
        rw [prod_congr rfl fun x _ => hA x, prod_const, Nat.factorial_mul_descFactorial hd]

/-- **Several inputs, known bits, pool form.** `… · (M + 1 − d)^d ≤ M^d · M!`, the shape of
`PousForwardCore.henc_card_of_pool`. -/
theorem card_perm_bits_multi_pool (I : Finset (Lab n wc)) (K : Lab n wc → Finset (Fin n × Fin wc))
    (β : (x : Lab n wc) → K x → Bool) :
    (univ.filter fun P : Equiv.Perm (Lab n wc) => ∀ x ∈ I, bits (K x) (P x) = β x).card
        * 2 ^ (∑ x ∈ I, (K x).card) * (2 ^ (n * wc) + 1 - I.card) ^ I.card
      ≤ (2 ^ (n * wc)) ^ I.card * (2 ^ (n * wc)).factorial :=
  le_trans (Nat.mul_le_mul_left _ (Nat.pow_sub_le_descFactorial _ _)) (card_perm_bits_multi_le I K β)

end Lab

end PousHintCard

end


/-! ════ Pebbling.LabelBirthday ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `labelBirthdayT`: discharging the `LabelBirthdayT` interface to a theorem

`TweakedDraft.LabelBirthdayT` was an *interface* (an undischarged hypothesis) asserting the label-collision birthday
`pr(labCollT) ≤ (2n)²/2^{n·wc}`. An interface that is not discharged is a hidden assumption, so this file **proves** it.

The `2n` honest labels `{c¹_v, c²_v}` are outputs of **distinct** tweaked permutations `P_t` (`t = (tag, layer, node)`),
so they are independent uniform — but their *inputs* cross-depend on the family (`c²_v`'s input reads the layer-0 perms),
so this is **not** a plain random-function birthday. The proof has three parts, exactly as scoped:

1. **Dependency congruence** (`c1T_congr`, `c2T_congr`, and the corollaries `c1T_update_gt`, `c2T_update_gt`,
   `inpOf_fresh`, `labelT_fresh`): `c1T`/`c2T` at node `v` read the permutation family only at topologically-earlier
   tweaks. Hence for a pair `a ≠ b`, the lex-later tweak `c`'s permutation `P_c` is **fresh for both** — it appears
   neither in `c`'s own input nor in the other label.
2. **The permutation per-pair bound** (`pr_pair_perm`): with `P_c` fresh, marginalizing over it, a uniform permutation
   sends a fixed input to a fixed target with probability `1/|Lab|` (single-entry deletion, `permSplitAt`).
3. **Union bound** over the `≤ (2n)²` pairs (`labelBirthdayT`).
-/

namespace PousLabelBirthday

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousHintCard
open scoped ENNReal

variable {n wc : ℕ}

/-! ### Part 1: dependency congruence -/

/-- `c1T` at `v` depends on `P` only at layer-0 tweaks with node `≤ v`. -/
theorem c1T_congr (tag : Bits 256) (G : Labelling.TopoDAG n) (Hf : KQ' n wc → Lab n wc)
    (W : Fin n → Lab n wc) {P P' : Tweak n → Equiv.Perm (Lab n wc)} :
    ∀ v : Fin n, (∀ u : Fin n, u.val ≤ v.val → P (tag, 0, u) = P' (tag, 0, u)) →
      c1T tag G Hf P W v = c1T tag G Hf P' W v
  | v => fun h => by
    have hin : (fun u => if _h : u ∈ G.par v then some (c1T tag G Hf P W u) else none)
             = (fun u => if _h : u ∈ G.par v then some (c1T tag G Hf P' W u) else none) := by
      funext u
      by_cases hu : u ∈ G.par v
      · rw [dif_pos hu, dif_pos hu,
          c1T_congr tag G Hf W u (fun w hw => h w (hw.trans (G.par_lt v u hu).le))]
      · rw [dif_neg hu, dif_neg hu]
    rw [c1T, c1T, h v (le_refl _), hin]
  termination_by v => v.val
  decreasing_by exact G.par_lt v u hu

/-- `c2T` at `v` depends on `P` at all layer-0 tweaks (via `transpose`) and at layer-1 tweaks with node `≤ v`. -/
theorem c2T_congr (tag : Bits 256) (G : Labelling.TopoDAG n) (Hf : KQ' n wc → Lab n wc)
    (W : Fin n → Lab n wc) {P P' : Tweak n → Equiv.Perm (Lab n wc)}
    (hP0 : ∀ u : Fin n, P (tag, 0, u) = P' (tag, 0, u)) :
    ∀ v : Fin n, (∀ u : Fin n, u.val ≤ v.val → P (tag, 1, u) = P' (tag, 1, u)) →
      c2T tag G Hf P W v = c2T tag G Hf P' W v
  | v => fun h => by
    have htrans : transpose (c1T tag G Hf P W) v = transpose (c1T tag G Hf P' W) v := by
      funext u
      show c1T tag G Hf P W u v = c1T tag G Hf P' W u v
      rw [c1T_congr tag G Hf W u (fun w _ => hP0 w)]
    have hin : (fun u => if _h : u ∈ G.par v then some (c2T tag G Hf P W u) else none)
             = (fun u => if _h : u ∈ G.par v then some (c2T tag G Hf P' W u) else none) := by
      funext u
      by_cases hu : u ∈ G.par v
      · rw [dif_pos hu, dif_pos hu,
          c2T_congr tag G Hf W hP0 u (fun w hw => h w (hw.trans (G.par_lt v u hu).le))]
      · rw [dif_neg hu, dif_neg hu]
    rw [c2T, c2T, h v (le_refl _), htrans, hin]
  termination_by v => v.val
  decreasing_by exact G.par_lt v u hu

/-- Lexicographic key on `(layer, node)`: layer dominant since `node < n`. -/
def key (p : Fin 2 × Fin n) : ℕ := p.1.val * n + p.2.val

/-- `c1T v` is unchanged by an update at any tweak `(tag, ℓ, w)` that is not read: layer 1, or layer 0 with `w > v`. -/
theorem c1T_update_gt (tag : Bits 256) (G : Labelling.TopoDAG n) (Hf : KQ' n wc → Lab n wc)
    (W : Fin n → Lab n wc) (P : Tweak n → Equiv.Perm (Lab n wc)) (ℓ : Fin 2) (w : Fin n)
    (σ : Equiv.Perm (Lab n wc)) (v : Fin n) (hgt : ℓ = 0 → v.val < w.val) :
    c1T tag G Hf (Function.update P (tag, ℓ, w) σ) W v = c1T tag G Hf P W v := by
  refine c1T_congr tag G Hf W v (fun u hu => ?_)
  have hne : ((tag, 0, u) : Tweak n) ≠ (tag, ℓ, w) := by
    intro hc; rw [Prod.mk.injEq, Prod.mk.injEq] at hc
    have hvw : v.val < w.val := hgt hc.2.1.symm
    have huw : u.val = w.val := by rw [hc.2.2]
    omega
  exact Function.update_of_ne hne σ P

/-- `c2T v` is unchanged by an update at a layer-1 tweak `(tag, 1, w)` with node `w > v`. -/
theorem c2T_update_gt (tag : Bits 256) (G : Labelling.TopoDAG n) (Hf : KQ' n wc → Lab n wc)
    (W : Fin n → Lab n wc) (P : Tweak n → Equiv.Perm (Lab n wc)) (w : Fin n)
    (σ : Equiv.Perm (Lab n wc)) (v : Fin n) (hgt : v.val < w.val) :
    c2T tag G Hf (Function.update P (tag, 1, w) σ) W v = c2T tag G Hf P W v := by
  refine c2T_congr tag G Hf W ?_ v (fun u hu => ?_)
  · intro u
    have hne : ((tag, 0, u) : Tweak n) ≠ (tag, 1, w) := by
      intro hc; rw [Prod.mk.injEq, Prod.mk.injEq] at hc; exact absurd hc.2.1 (by decide)
    exact Function.update_of_ne hne σ P
  · have hne : ((tag, 1, u) : Tweak n) ≠ (tag, 1, w) := by
      intro hc; rw [Prod.mk.injEq, Prod.mk.injEq] at hc
      have huw : u.val = w.val := by rw [hc.2.2]
      omega
    exact Function.update_of_ne hne σ P

/-- The input node `p` feeds to its own permutation `P_{(tag, p.1, p.2)}`: `labelT p = P_{tw p} (inpOf p)`, and `inpOf p`
never reads `P_{tw p}` (it is applied outermost). -/
noncomputable def inpOf (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (ω : OmegaT n wc) (p : Fin 2 × Fin n) : Lab n wc :=
  if p.1 = 0 then
    labXor (W p.2) (ω.1 (tag, 0, p.2, fun u => if _h : u ∈ G.par p.2 then some (c1T tag G ω.1 ω.2 W u) else none))
  else
    labXor (transpose (c1T tag G ω.1 ω.2 W) p.2)
      (ω.1 (tag, 1, p.2, fun u => if _h : u ∈ G.par p.2 then some (c2T tag G ω.1 ω.2 W u) else none))

theorem labelT_eq (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (ω : OmegaT n wc) (p : Fin 2 × Fin n) :
    labelT tag G W ω p = ω.2 (tag, p.1, p.2) (inpOf tag G W ω p) := by
  simp only [labelT, inpOf]
  by_cases h : p.1 = 0
  · rw [if_pos h, if_pos h, c1T, h]
  · have hp1 : p.1 = 1 := by omega
    rw [if_neg h, if_neg h, c2T, hp1]

/-- `inpOf p` is unchanged by an update at its own tweak `tw p` (that permutation is applied outermost). -/
theorem inpOf_fresh (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (hf : KQ' n wc → Lab n wc) (P : Tweak n → Equiv.Perm (Lab n wc)) (σ : Equiv.Perm (Lab n wc))
    (p : Fin 2 × Fin n) :
    inpOf tag G W (hf, Function.update P (tag, p.1, p.2) σ) p = inpOf tag G W (hf, P) p := by
  simp only [inpOf]
  by_cases hp : p.1 = 0
  · rw [if_pos hp, if_pos hp]
    have hfun : (fun u => if _h : u ∈ G.par p.2 then some (c1T tag G hf (Function.update P (tag, p.1, p.2) σ) W u) else none)
              = (fun u => if _h : u ∈ G.par p.2 then some (c1T tag G hf P W u) else none) := by
      funext u
      by_cases hu : u ∈ G.par p.2
      · rw [dif_pos hu, dif_pos hu, c1T_update_gt tag G hf W P p.1 p.2 σ u (fun _ => G.par_lt p.2 u hu)]
      · rw [dif_neg hu, dif_neg hu]
    rw [hfun]
  · rw [if_neg hp, if_neg hp]
    have hp1 : p.1 = 1 := by omega
    have hall : c1T tag G hf (Function.update P (tag, p.1, p.2) σ) W = c1T tag G hf P W := by
      funext u; rw [hp1]; exact c1T_update_gt tag G hf W P 1 p.2 σ u (fun h => absurd h (by decide))
    have hfun : (fun u => if _h : u ∈ G.par p.2 then some (c2T tag G hf (Function.update P (tag, p.1, p.2) σ) W u) else none)
              = (fun u => if _h : u ∈ G.par p.2 then some (c2T tag G hf P W u) else none) := by
      funext u
      by_cases hu : u ∈ G.par p.2
      · rw [dif_pos hu, dif_pos hu, hp1, c2T_update_gt tag G hf W P p.2 σ u (G.par_lt p.2 u hu)]
      · rw [dif_neg hu, dif_neg hu]
    rw [hall, hfun]

/-- `labelT q` is unchanged by an update at a lex-**later** tweak `tw pc` (`key q < key pc`): `q`'s label reads only
earlier tweaks. -/
theorem labelT_fresh (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (hf : KQ' n wc → Lab n wc) (P : Tweak n → Equiv.Perm (Lab n wc)) (σ : Equiv.Perm (Lab n wc))
    (pc q : Fin 2 × Fin n) (hkey : key q < key pc) :
    labelT tag G W (hf, Function.update P (tag, pc.1, pc.2) σ) q = labelT tag G W (hf, P) q := by
  obtain ⟨q1, q2⟩ := q
  obtain ⟨pc1, pc2⟩ := pc
  have hq2 : q2.val < n := q2.isLt
  have hpc2 : pc2.val < n := pc2.isLt
  simp only [key] at hkey
  fin_cases q1 <;> fin_cases pc1 <;>
    simp only [labelT] <;>
    first
    | (exfalso; simp only [Fin.val_zero, Fin.val_one] at hkey; omega)
    | (rw [if_pos (by rfl), if_pos (by rfl)]
       exact c1T_update_gt tag G hf W P _ pc2 σ q2 (fun hpc => by
         simp only [Fin.val_zero, Fin.val_one] at hkey ⊢; omega))
    | (rw [if_pos (by rfl), if_pos (by rfl)]
       exact c1T_update_gt tag G hf W P _ pc2 σ q2 (fun hpc => by simp at hpc))
    | (rw [if_neg (by decide), if_neg (by decide)]
       exact c2T_update_gt tag G hf W P pc2 σ q2 (by
         simp only [Fin.val_zero, Fin.val_one] at hkey; omega))

/-! ### Part 2: the permutation per-pair bound -/

theorem key_inj {a b : Fin 2 × Fin n} (h : key a = key b) : a = b := by
  obtain ⟨a1, a2⟩ := a; obtain ⟨b1, b2⟩ := b
  have ha2 : a2.val < n := a2.isLt
  have hb2 : b2.val < n := b2.isLt
  simp only [key] at h
  fin_cases a1 <;> fin_cases b1 <;>
    simp only [Fin.val_zero, Fin.val_one] at h <;>
    (first | (omega) | (have : a2 = b2 := Fin.ext (by omega); subst this; rfl))

/-- **Per-pair bound.** Two honest labels of distinct nodes collide with probability `≤ 1/|Lab|`. The lex-later tweak
`c`'s permutation is fresh for both (Part 1), so marginalizing over it, a uniform permutation hits a fixed target at a
fixed input with probability `1/|Lab|` (single-entry deletion via `permSplitAt`). -/
theorem pr_pair_perm (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (a b : Fin 2 × Fin n) (hab : a ≠ b) :
    pr (fun ω : (p3ModelT n wc).Ω => labelT tag G W ω a = labelT tag G W ω b)
      ≤ 1 / (2 ^ (n * wc) : ℝ≥0∞) := by
  classical
  set c : Fin 2 × Fin n := if key a ≤ key b then b else a with hc
  set o : Fin 2 × Fin n := if key a ≤ key b then a else b with ho
  have hko : key o < key c := by
    by_cases hle : key a ≤ key b
    · rw [hc, ho, if_pos hle, if_pos hle]
      exact lt_of_le_of_ne hle fun he => hab (key_inj he)
    · rw [hc, ho, if_neg hle, if_neg hle]; exact not_le.1 hle
  have hev : (fun ω : (p3ModelT n wc).Ω => labelT tag G W ω a = labelT tag G W ω b)
           = (fun ω => labelT tag G W ω c = labelT tag G W ω o) := by
    funext ω
    by_cases hle : key a ≤ key b
    · have hcb : c = b := by rw [hc]; exact if_pos hle
      have hoa : o = a := by rw [ho]; exact if_pos hle
      rw [hcb, hoa]; exact propext eq_comm
    · have hca : c = a := by rw [hc]; exact if_neg hle
      have hob : o = b := by rw [ho]; exact if_neg hle
      rw [hca, hob]
  rw [hev]
  -- decode over Ω, marginalizing the fresh tweak `tw c = (tag, c.1, c.2)`
  set t₀ : Tweak n := (tag, c.1, c.2) with ht0
  set x₀ : Lab n wc := default with hx0
  haveI : Fintype ((KQ' n wc → Lab n wc) × ({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc))
      × Equiv.Perm {z : Lab n wc // z ≠ x₀}) := Fintype.ofFinite _
  refine le_trans (PousP3Forward.pr_le_of_decode
    (Ω := (p3ModelT n wc).Ω)
    (X := (KQ' n wc → Lab n wc) × ({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc))
      × Equiv.Perm {z : Lab n wc // z ≠ x₀})
    (fun ω => labelT tag G W ω c = labelT tag G W ω o)
    (fun X =>
      let fam0 : Tweak n → Equiv.Perm (Lab n wc) := fun t => if h : t = t₀ then 1 else X.2.1 ⟨t, h⟩
      let inp := inpOf tag G W (X.1, fam0) c
      let Lo := labelT tag G W (X.1, fam0) o
      (X.1, fun t => if h : t = t₀ then (permSplitAt inp x₀).symm (Lo, X.2.2) else X.2.1 ⟨t, h⟩))
    ?_) ?_
  · -- coverage
    rintro ω hE
    have hfam0 : (fun t => if h : t = t₀ then (1 : Equiv.Perm (Lab n wc)) else (fun t' : {t // t ≠ t₀} => ω.2 t'.1) ⟨t, h⟩)
        = Function.update ω.2 t₀ 1 := by
      funext t; by_cases h : t = t₀
      · simp [h, Function.update_self]
      · simp [h, Function.update_of_ne h]
    refine ⟨(ω.1, (fun t' : {t // t ≠ t₀} => ω.2 t'.1),
      (permSplitAt (inpOf tag G W ω c) x₀ (ω.2 t₀)).2), ?_⟩
    have hinp : inpOf tag G W (ω.1, Function.update ω.2 t₀ 1) c = inpOf tag G W ω c := by
      rw [ht0]; exact inpOf_fresh tag G W ω.1 ω.2 1 c
    have hLo : labelT tag G W (ω.1, Function.update ω.2 t₀ 1) o = labelT tag G W ω o := by
      rw [ht0]; exact labelT_fresh tag G W ω.1 ω.2 1 c o hko
    simp only [hfam0]
    have hLoc : labelT tag G W ω o = ω.2 t₀ (inpOf tag G W ω c) := by
      rw [← hE, labelT_eq tag G W ω c, ht0]
    have hkey : (permSplitAt (inpOf tag G W ω c) x₀ (ω.2 t₀)).1 = labelT tag G W ω o := by
      rw [permSplitAt_fst, hLoc]
    have hrec : (permSplitAt (inpOf tag G W (ω.1, Function.update ω.2 t₀ 1) c) x₀).symm
          (labelT tag G W (ω.1, Function.update ω.2 t₀ 1) o,
           (permSplitAt (inpOf tag G W ω c) x₀ (ω.2 t₀)).2) = ω.2 t₀ := by
      rw [hinp, hLo, ← hkey, Prod.mk.eta, Equiv.symm_apply_apply]
    refine Prod.ext rfl (funext fun t => ?_)
    by_cases h : t = t₀
    · subst h; simp only [dif_pos rfl]; exact hrec
    · simp only [dif_neg h]
  · -- cardinality: |X| · |Lab| = |Ω|, so |X|/|Ω| ≤ 1/|Lab|
    have hcardLab : ((2 : ℝ≥0∞) ^ (n * wc)) = (Fintype.card (Lab n wc) : ℝ≥0∞) := by
      rw [PousForwardCore.card_lab]; push_cast; ring
    rw [hcardLab]
    have hrest : Fintype.card ((KQ' n wc → Lab n wc) × ({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc))
          × Equiv.Perm {z : Lab n wc // z ≠ x₀}) * Fintype.card (Lab n wc)
        = Fintype.card (p3ModelT n wc).Ω := by
      have e1 : (Tweak n → Equiv.Perm (Lab n wc))
          ≃ Equiv.Perm (Lab n wc) × ({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc)) :=
        Equiv.funSplitAt t₀ (Equiv.Perm (Lab n wc))
      have e2 : Equiv.Perm (Lab n wc) ≃ Lab n wc × Equiv.Perm {z : Lab n wc // z ≠ x₀} :=
        permSplitAt x₀ x₀
      have ereassoc :
          (Lab n wc × Equiv.Perm {z : Lab n wc // z ≠ x₀})
            × ({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc))
          ≃ (({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc)) × Equiv.Perm {z : Lab n wc // z ≠ x₀})
            × Lab n wc :=
        (Equiv.prodAssoc _ _ _).trans
          ((Equiv.prodComm _ _).trans ((Equiv.prodComm _ _).prodCongr (Equiv.refl _)))
      have etw : (Tweak n → Equiv.Perm (Lab n wc))
          ≃ (({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc)) × Equiv.Perm {z : Lab n wc // z ≠ x₀})
            × Lab n wc :=
        e1.trans ((e2.prodCongr (Equiv.refl _)).trans ereassoc)
      have hequiv : (p3ModelT n wc).Ω
          ≃ ((KQ' n wc → Lab n wc) × (({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc))
              × Equiv.Perm {z : Lab n wc // z ≠ x₀})) × Lab n wc :=
        ((Equiv.refl (KQ' n wc → Lab n wc)).prodCongr etw).trans (Equiv.prodAssoc _ _ _).symm
      rw [← Nat.card_eq_fintype_card (α := (KQ' n wc → Lab n wc)
            × ({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc)) × Equiv.Perm {z : Lab n wc // z ≠ x₀}),
          ← Nat.card_eq_fintype_card (α := Lab n wc),
          ← Nat.card_eq_fintype_card (α := (p3ModelT n wc).Ω),
          ← Nat.card_prod, Nat.card_congr hequiv]
    refine le_of_eq ?_
    have hrest' : (Fintype.card ((KQ' n wc → Lab n wc) × ({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc))
          × Equiv.Perm {z : Lab n wc // z ≠ x₀}) : ℝ≥0∞) * (Fintype.card (Lab n wc) : ℝ≥0∞)
        = (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞) := by exact_mod_cast hrest
    have hXne : (Fintype.card ((KQ' n wc → Lab n wc) × ({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc))
          × Equiv.Perm {z : Lab n wc // z ≠ x₀}) : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
    have hXtop : (Fintype.card ((KQ' n wc → Lab n wc) × ({t : Tweak n // t ≠ t₀} → Equiv.Perm (Lab n wc))
          × Equiv.Perm {z : Lab n wc // z ≠ x₀}) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
    rw [← hrest', div_eq_mul_inv, ENNReal.mul_inv (Or.inl hXne) (Or.inl hXtop), ← mul_assoc,
      ENNReal.mul_inv_cancel hXne hXtop, one_mul, one_div]

/-! ### Part 3: the union bound -/

/-- **`LabelBirthdayT` discharged.** The label-collision birthday `pr(labCollT) ≤ (2n)²/2^{n·wc}`, by a union bound over
the `≤ (2n)²` ordered pairs of the `2n` labels, each bounded by `pr_pair_perm`. This turns the former interface into a
theorem — the collision term `hcoll` now rests on no hidden assumption. -/
theorem labelBirthdayT (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) :
    LabelBirthdayT tag G W := by
  classical
  unfold LabelBirthdayT
  have hpred : (fun ω : (p3ModelT n wc).Ω => labCollT tag G W ω)
      = (fun ω => ∃ p ∈ (Finset.univ.filter
          (fun p : (Fin 2 × Fin n) × (Fin 2 × Fin n) => p.1 ≠ p.2)),
          labelT tag G W ω p.1 = labelT tag G W ω p.2) := by
    funext ω
    simp only [labCollT]
    rw [eq_iff_iff]
    constructor
    · rintro ⟨a, b, hab, h⟩; exact ⟨(a, b), by simp [hab], h⟩
    · rintro ⟨p, hp, h⟩; simp only [Finset.mem_filter] at hp; exact ⟨p.1, p.2, hp.2, h⟩
  rw [hpred]
  refine (pr_exists_le _ _).trans ?_
  have hbound : (∑ p ∈ (Finset.univ.filter
          (fun p : (Fin 2 × Fin n) × (Fin 2 × Fin n) => p.1 ≠ p.2)),
        pr (fun ω : (p3ModelT n wc).Ω => labelT tag G W ω p.1 = labelT tag G W ω p.2))
      ≤ ∑ _p ∈ (Finset.univ.filter
          (fun p : (Fin 2 × Fin n) × (Fin 2 × Fin n) => p.1 ≠ p.2)), 1 / (2 ^ (n * wc) : ℝ≥0∞) := by
    apply Finset.sum_le_sum
    intro p hp
    simp only [Finset.mem_filter] at hp
    exact pr_pair_perm tag G W p.1 p.2 hp.2
  refine hbound.trans ?_
  rw [Finset.sum_const, nsmul_eq_mul, mul_one_div]
  gcongr
  calc (Finset.univ.filter (fun p : (Fin 2 × Fin n) × (Fin 2 × Fin n) => p.1 ≠ p.2)).card
      ≤ Fintype.card ((Fin 2 × Fin n) × (Fin 2 × Fin n)) := by
        rw [← Finset.card_univ]; exact Finset.card_filter_le _ _
    _ = (2 * n) ^ 2 := by
        rw [Fintype.card_prod, Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]; ring

/-- **`hcoll`, discharged.** The colliding-winner probability is `≤ (2n)²/2^{n·wc}` with **no** interface hypothesis:
`hbirthdayT_of_labelBirthdayT` composed with the now-proved `labelBirthdayT`. This is the `hcoll` the assembly consumes. -/
theorem hbirthdayT {m : ℕ} (k : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n)
    (W : Fin n → Lab n wc) (A₁ : (p3ModelT n wc).Ω → Bits m)
    (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)) :
    pr (fun ω => (k ≤ (Finset.univ.filter fun v =>
          (A₂ (A₁ ω) v).run ((p3ModelT n wc).answer ω) = topLabelT tag G W ω v).card) ∧ labCollT tag G W ω)
      ≤ (((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) :=
  hbirthdayT_of_labelBirthdayT k tag G W A₁ A₂ (labelBirthdayT tag G W)

end PousLabelBirthday

end


/-! ════ Freshness.Refutation ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `FreshnessInvariant` is false, for every oracle-rounds → game-depth conversion

`FreshnessInvariantAt gd` is `PousFreshness.FreshnessInvariant` with its depth `gameDepth D` replaced by `gd D`
(`freshnessInvariant_eq`: the two agree at `gd = gameDepth`, by `rfl`). It is false for **every** `gd`.

Take `d = gd 1`, the path graph on `n = d + 1` nodes, `wc = 2`, one segment, `k = n`, `X = d` (so `k − X = 1`) and
`D = Q = 1`. `ColumnHard (pathG n) d n d` holds (`columnHard_path`): a holding below `n` column units holds no whole
label and fewer than `n` columns, so top `u` appears no earlier than round `u + 2` (`top_late`), and top `d` not
within `d` rounds. Two adversaries, one query per challenge, answer all `n` tops on every `ω`, and each touches every
answered top's honest entry, so no `Fr` with `k − X = 1` element exists:

* `advFwd` stores the `n` honest top inputs `x²_u` (the lower columns plus the keys) and queries `P_t` forward at
  them: the storage is lower-layer data, the top entries are queried honestly.
* `advInv` stores the `n` top labels `c²_u` (whole tops, the holding the statement means to delete) and makes a
  redundant inverse query `P_t⁻¹(c²_u)` before answering `c²_u`.

At `ω₀` (`H ≡ 0`, each `P_t` a swap sending its honest input to a chosen target) the `2n` labels are the pairwise
distinct targets `tgt`, so the run is non-colliding.
-/

namespace PousFreshnessRefutation

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousFreshness

/-- `FreshnessInvariant` with the depth conversion `gd` as a parameter. -/
def FreshnessInvariantAt (gd : ℕ → ℕ) : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n)
    (W : Fin N → Fin n → Lab n wc) (A₁ : (p3ModelT n wc).Ω → Bits m)
    (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gd D) k X →
    (∀ σ s c, (A₂ σ s c).Bounded D Q) →
    ∀ ω : (p3ModelT n wc).Ω,
      (∀ s : Fin N, k ≤ (Finset.univ.filter fun v =>
          (A₂ (A₁ ω) s v).run ((p3ModelT n wc).answer ω) = topLabelT (tags s) G (W s) ω v).card) →
      (∀ s : Fin N, ¬ labCollT (tags s) G (W s) ω) →
      ∃ Fr : Fin N → Finset (Fin n),
        (∀ s : Fin N, k - X ≤ (Fr s).card) ∧
        (∀ (s : Fin N), ∀ v ∈ Fr s,
          ((A₂ (A₁ ω) s v).run ((p3ModelT n wc).answer ω) = topLabelT (tags s) G (W s) ω v) ∧
          (Sum.inr (Sum.inl ((tags s, 1, v),
              (ω.2 (tags s, 1, v)).symm (topLabelT (tags s) G (W s) ω v)))
            ∉ segTrace ((p3ModelT n wc).answer ω) (A₂ (A₁ ω) s)) ∧
          (Sum.inr (Sum.inr ((tags s, 1, v), topLabelT (tags s) G (W s) ω v))
            ∉ segTrace ((p3ModelT n wc).answer ω) (A₂ (A₁ ω) s)))

theorem freshnessInvariant_eq : FreshnessInvariant = FreshnessInvariantAt gameDepth :=
  rfl

/-! ### The graph: a path, and `ColumnHard` at any depth below its length -/

/-- The path `0 → 1 → ⋯ → n−1`. -/
def pathG (n : ℕ) : Labelling.TopoDAG n where
  par v := Finset.univ.filter fun u : Fin n => (u : ℕ) + 1 = v
  par_lt v u h := by
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at h
    exact Fin.lt_def.2 (by omega)

/-- From a holding below `n` column units, top `u` appears no earlier than round `u + 2`. -/
theorem top_late {n : ℕ} (c0 : ColState n) (hsz : c0.size < n) :
    ∀ r, ∀ u ∈ (colReach (pathG n) c0 r).topWhole, (u : ℕ) + 2 ≤ r := by
  have hn : 0 < n := by omega
  have hLW : c0.lowerWhole = ∅ := by
    refine Finset.card_eq_zero.1 (Nat.eq_zero_of_not_pos fun h => ?_)
    have := Nat.le_mul_of_pos_right n h
    simp only [ColState.size] at hsz
    omega
  have hTW : c0.topWhole = ∅ := by
    refine Finset.card_eq_zero.1 (Nat.eq_zero_of_not_pos fun h => ?_)
    have := Nat.le_mul_of_pos_right n h
    simp only [ColState.size] at hsz
    omega
  have hLC : c0.lowerCol.card < n := by
    simp only [ColState.size] at hsz
    omega
  intro r
  induction r with
  | zero => simp [colReach, hTW]
  | succ r ih =>
    intro u hu
    simp only [colReach, colRound, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and] at hu
    rcases hu with hu | ⟨hcols, hpar⟩
    · exact (ih u hu).trans (Nat.le_succ r)
    · rcases Nat.eq_zero_or_pos (u : ℕ) with h0 | hpos
      · rcases Nat.eq_zero_or_pos r with rfl | hr
        · exfalso
          have hsub : Finset.univ.image (fun w : Fin n => (w, u)) ⊆ c0.lowerCol := by
            intro p hp
            obtain ⟨w, -, rfl⟩ := Finset.mem_image.1 hp
            rcases hcols w with h | h
            · simp [colReach, hLW] at h
            · exact h
          have := Finset.card_le_card hsub
          rw [Finset.card_image_of_injective _ (fun a b h => (Prod.mk.inj h).1), Finset.card_univ,
            Fintype.card_fin] at this
          omega
        · omega
      · have hmem : (⟨(u : ℕ) - 1, by omega⟩ : Fin n) ∈ (pathG n).par u := by
          simp only [pathG, Finset.mem_filter, Finset.mem_univ, true_and]
          omega
        have := ih _ (hpar hmem)
        simp only at this
        omega

theorem columnHard_path (d : ℕ) : ColumnHard (pathG (d + 1)) d (d + 1) d := by
  intro c0 hk
  rw [Nat.add_sub_cancel_left, one_mul]
  by_contra hs
  have hlate := top_late c0 (not_le.1 hs) d
  have hsub : (colReach (pathG (d + 1)) c0 d).topWhole ⊆ Finset.univ.erase ⟨d, by omega⟩ := by
    intro u hu
    refine Finset.mem_erase.2 ⟨fun h => ?_, Finset.mem_univ _⟩
    have := hlate u hu
    rw [h] at this
    simp only at this
    omega
  have := Finset.card_le_card hsub
  rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_fin] at this
  omega

/-! ### Storage codes and the two adversaries (`N = 1`, one query per challenge) -/

section Adversaries

variable {n wc : ℕ}

def tag0 : Bits 256 := fun _ => false

def cell (n wc : ℕ) : Fin n × Fin n × Fin wc ≃ Fin (n * (n * wc)) :=
  (Equiv.prodCongr (Equiv.refl (Fin n)) finProdFinEquiv).trans finProdFinEquiv

def enc (xs : Fin n → Lab n wc) : Bits (n * (n * wc)) := fun j =>
  xs ((cell n wc).symm j).1 ((cell n wc).symm j).2.1 ((cell n wc).symm j).2.2

def dec (σ : Bits (n * (n * wc))) : Fin n → Lab n wc := fun a b c => σ (cell n wc (a, b, c))

theorem dec_enc (xs : Fin n → Lab n wc) : dec (enc xs) = xs := by
  funext a b c
  simp [dec, enc]

/-- The honest top inputs `x²_u = P_t⁻¹(c²_u)`, as the statement writes them. -/
noncomputable def honestIns (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω) :
    Fin n → Lab n wc :=
  fun u => (ω.2 (tag0, 1, u)).symm (topLabelT tag0 G W ω u)

noncomputable def A₁fwd (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω) :
    Bits (n * (n * wc)) :=
  enc (honestIns G W ω)

/-- Query `P_t` forward at the stored honest input, answer the result. -/
def advFwd (σ : Bits (n * (n * wc))) (_s : Fin 1) (c : Fin n) : Prog (p3ModelT n wc) (Lab n wc) :=
  .round [Sum.inr (Sum.inl ((tag0, 1, c), dec σ c))] fun as => .ret (as.headD (show (p3ModelT n wc).Ans from dec σ c))

noncomputable def A₁inv (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω) :
    Bits (n * (n * wc)) :=
  enc (topLabelT tag0 G W ω)

/-- Query `P_t⁻¹` at the stored top label (redundantly), answer the stored label. -/
def advInv (σ : Bits (n * (n * wc))) (_s : Fin 1) (c : Fin n) : Prog (p3ModelT n wc) (Lab n wc) :=
  .round [Sum.inr (Sum.inr ((tag0, 1, c), dec σ c))] fun _ => .ret (dec σ c)

theorem advFwd_bounded (σ : Bits (n * (n * wc))) (s : Fin 1) (c : Fin n) : (advFwd σ s c).Bounded 1 1 :=
  fun _ => ⟨le_of_eq rfl, le_of_eq rfl⟩

theorem advInv_bounded (σ : Bits (n * (n * wc))) (s : Fin 1) (c : Fin n) : (advInv σ s c).Bounded 1 1 :=
  fun _ => ⟨le_of_eq rfl, le_of_eq rfl⟩

theorem advFwd_run (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω) (s : Fin 1)
    (v : Fin n) : (advFwd (A₁fwd G W ω) s v).run ((p3ModelT n wc).answer ω) = topLabelT tag0 G W ω v := by
  show ω.2 (tag0, 1, v) (dec (enc (honestIns G W ω)) v) = _
  rw [dec_enc, honestIns, Equiv.apply_symm_apply]

theorem advInv_run (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω) (s : Fin 1)
    (v : Fin n) : (advInv (A₁inv G W ω) s v).run ((p3ModelT n wc).answer ω) = topLabelT tag0 G W ω v := by
  show dec (enc (topLabelT tag0 G W ω)) v = _
  rw [dec_enc]

theorem mem_segTrace {A₂ : Fin n → Prog (p3ModelT n wc) (Lab n wc)} {f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans}
    {q : (p3ModelT n wc).Qry} (v : Fin n) (h : q ∈ progTrace f (A₂ v)) : q ∈ segTrace f A₂ :=
  List.mem_flatten.2 ⟨_, List.mem_ofFn.2 ⟨v, rfl⟩, h⟩

theorem advFwd_touch (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω) (v : Fin n) :
    Sum.inr (Sum.inl ((tag0, 1, v), (ω.2 (tag0, 1, v)).symm (topLabelT tag0 G W ω v)))
      ∈ segTrace ((p3ModelT n wc).answer ω) (advFwd (A₁fwd G W ω) 0) := by
  refine mem_segTrace v ?_
  simp only [progTrace, advFwd, A₁fwd, dec_enc, honestIns, List.append_nil]
  exact List.mem_singleton.2 rfl

theorem advInv_touch (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω) (v : Fin n) :
    Sum.inr (Sum.inr ((tag0, 1, v), topLabelT tag0 G W ω v))
      ∈ segTrace ((p3ModelT n wc).answer ω) (advInv (A₁inv G W ω) 0) := by
  refine mem_segTrace v ?_
  simp only [progTrace, advInv, A₁inv, dec_enc, List.append_nil]
  exact List.mem_singleton.2 rfl

end Adversaries

/-! ### A non-colliding `ω₀`: every honest label is a chosen, pairwise distinct target -/

section Omega

variable {n : ℕ}

/-- Pairwise distinct labels: `tgt (ℓ, v)` has its one `true` bit at component `v`, bit `ℓ`. -/
def tgt (p : Fin 2 × Fin n) : Lab n 2 := fun i j => decide (i = p.2 ∧ j = p.1)

theorem tgt_injective : Function.Injective (tgt (n := n)) := by
  intro p q h
  have := congrFun (congrFun h p.2) p.1
  simp only [tgt, and_self, decide_true] at this
  have h' := of_decide_eq_true this.symm
  exact Prod.ext h'.2 h'.1

def W0 : Fin n → Lab n 2 := fun _ _ _ => false

/-- `H ≡ 0`; `P_{(·,0,v)}` swaps `W_v` with `tgt (0,v)`, `P_{(·,1,v)}` swaps `transpose(tgt 0) v` with `tgt (1,v)`. -/
def ω₀ : (p3ModelT n 2).Ω :=
  (fun _ _ _ => false, fun t =>
    if t.2.1 = 0 then Equiv.swap (W0 t.2.2) (tgt (0, t.2.2))
    else Equiv.swap (transpose (fun w => tgt (0, w)) t.2.2) (tgt (1, t.2.2)))

theorem labXor_zero (x : Lab n 2) : labXor x (fun _ _ => false) = x := by
  funext v j
  simp [labXor, Labelling.bxor]

theorem c1_ω₀ (G : Labelling.TopoDAG n) (v : Fin n) : c1T tag0 G ω₀.1 ω₀.2 W0 v = tgt (0, v) := by
  rw [c1T]
  show (Equiv.swap (W0 v) (tgt (0, v))) (labXor (W0 v) (fun _ _ => false)) = _
  rw [labXor_zero, Equiv.swap_apply_left]

theorem c2_ω₀ (G : Labelling.TopoDAG n) (v : Fin n) : c2T tag0 G ω₀.1 ω₀.2 W0 v = tgt (1, v) := by
  rw [c2T]
  have hc1 : c1T tag0 G ω₀.1 ω₀.2 W0 = fun w => tgt (0, w) := funext (c1_ω₀ G)
  show (Equiv.swap (transpose (fun w => tgt (0, w)) v) (tgt (1, v)))
      (labXor (transpose (c1T tag0 G ω₀.1 ω₀.2 W0) v) (fun _ _ => false)) = _
  rw [labXor_zero, hc1, Equiv.swap_apply_left]

theorem not_labColl_ω₀ (G : Labelling.TopoDAG n) : ¬ labCollT tag0 G W0 ω₀ := by
  have hlab : ∀ p, labelT tag0 G W0 ω₀ p = tgt p := by
    rintro ⟨ℓ, v⟩
    unfold labelT
    split_ifs with h
    · simp only at h
      rw [c1_ω₀, h]
    · have h1 : ℓ = 1 := by fin_cases ℓ <;> simp_all
      rw [c2_ω₀, h1]
  rintro ⟨a, b, hab, heq⟩
  rw [hlab, hlab] at heq
  exact hab (tgt_injective heq)

end Omega

/-! ### The refutation -/

theorem refute (gd : ℕ → ℕ)
    {A₁ : (p3ModelT (gd 1 + 1) 2).Ω → Bits ((gd 1 + 1) * ((gd 1 + 1) * 2))}
    {A₂ : Bits ((gd 1 + 1) * ((gd 1 + 1) * 2)) → Fin 1 → Fin (gd 1 + 1) →
      Prog (p3ModelT (gd 1 + 1) 2) (Lab (gd 1 + 1) 2)}
    (hb : ∀ σ s c, (A₂ σ s c).Bounded 1 1)
    (hwin : ∀ ω s v,
      (A₂ (A₁ ω) s v).run ((p3ModelT _ 2).answer ω) = topLabelT tag0 (pathG (gd 1 + 1)) W0 ω v)
    (htouch : ∀ ω v,
      Sum.inr (Sum.inl ((tag0, 1, v), (ω.2 (tag0, 1, v)).symm (topLabelT tag0 (pathG (gd 1 + 1)) W0 ω v)))
          ∈ segTrace ((p3ModelT _ 2).answer ω) (A₂ (A₁ ω) 0) ∨
        Sum.inr (Sum.inr ((tag0, 1, v), topLabelT tag0 (pathG (gd 1 + 1)) W0 ω v))
          ∈ segTrace ((p3ModelT _ 2).answer ω) (A₂ (A₁ ω) 0)) :
    ¬ FreshnessInvariantAt gd := by
  intro hF
  obtain ⟨Fr, hcard, hFr⟩ :=
    hF 1 (gd 1 + 1) 2 _ 1 1 (gd 1 + 1) (gd 1) (fun _ => tag0) (pathG (gd 1 + 1)) (fun _ => W0) A₁ A₂
      two_pos le_rfl (Nat.le_succ _) (fun a b _ => Subsingleton.elim a b) (columnHard_path (gd 1)) hb ω₀
      (fun s => by
        rw [Finset.filter_true_of_mem fun v _ => hwin ω₀ s v, Finset.card_univ, Fintype.card_fin])
      (fun _ => not_labColl_ω₀ _)
  have h1 : 0 < (Fr 0).card := lt_of_lt_of_le (by omega) (hcard 0)
  obtain ⟨v, hv⟩ := Finset.card_pos.1 h1
  obtain ⟨-, hfwd, hinv⟩ := hFr 0 v hv
  rcases htouch ω₀ v with h | h
  · exact hfwd h
  · exact hinv h

/-- **False at every depth conversion**, through an honest forward query at stored inputs. -/
theorem not_freshnessInvariantAt (gd : ℕ → ℕ) : ¬ FreshnessInvariantAt gd :=
  refute gd advFwd_bounded (advFwd_run _ _) fun ω v => Or.inl (advFwd_touch _ _ ω v)

/-- **False at every depth conversion**, through a redundant inverse query at stored whole tops. -/
theorem not_freshnessInvariantAt_inv (gd : ℕ → ℕ) : ¬ FreshnessInvariantAt gd :=
  refute gd advInv_bounded (advInv_run _ _) fun ω v => Or.inr (advInv_touch _ _ ω v)

/-- **`FreshnessInvariant` (as handed off) is false.** -/
theorem not_freshnessInvariant : ¬ FreshnessInvariant :=
  freshnessInvariant_eq ▸ not_freshnessInvariantAt gameDepth

theorem not_freshnessInvariant_inv : ¬ FreshnessInvariant :=
  freshnessInvariant_eq ▸ not_freshnessInvariantAt_inv gameDepth

end PousFreshnessRefutation

end


/-! ════ Freshness.KnowledgeSim ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `KnowledgeSim`: what the oracle tells a segment's challenge programs is inside the keyed timed game

One segment: tag `τ`, graph `G`, data `W`, primitive `ω`, and its `n` challenge programs `ps` (in `n10prime`,
`ps = A₂ (A₁ ω)`; per segment of `n10primeMulti`, `ps = A₂ (A₁ ω) s`). They run in parallel from the same `σ`, so
knowledge is the **round-synchronous union** over the programs: `Asked ps ω q t` says some program sends `q` within its
first `t` rounds (`PousRounds.upTo`). Under `Bounded D Q`, "within `D` rounds" is every query (`AskedAll`).

**Honest queries.** Each tweak has one honest input, so the honest queries are fixed by `ω`:
`qH1 w`/`qH2 u` (`H` at the honest key inputs), `qP1 w`/`qP2 u` (`P_t` forward at the honest inputs), and
`qI1 w`/`qI2 u` (`P_t⁻¹` at the honest outputs).

**Knowledge** `know t : ColState n` is what their answers have told the programs by round `t`:
- lower `w`, from `qP1 w`;
- top `u`, from `qP2 u`;
- columns `(·, u)`, from `qI2 u` (masked) together with `qH2 u` (the key).

**Credits** `cred : KState n` are the held units, read off the trace. Each rule is checked at the first round `r` the
triggering query is asked, against what the answers had told by round `r − 1`:
- `qH1 v` and `qH2 v` use the parents' labels: each parent not yet obtained is credited (a lower or top label).
- `qI1 w` and `qI2 u` use `c¹_w` and `c²_u`: credited if not yet obtained.
- `qP1 w` uses `x¹_w = W_w ⊕ k¹_w` (`W` public): the key `k¹_w` is credited if it was not obtained (`qH1 w`, `qI1 w`).
- `qP2 u` uses `x²_u ⊕ k²_u`, **the XOR mask**, one label's worth, credited as **one** unit:
  - key obtained (`qH2 u`), some columns not: the missing columns `(·, u)`;
  - all columns available, key not: the key `k²_u`;
  - neither: top `u` itself. A held top input is dominated by the held top, so this is sound in the game.
- A correct final answer `c²_u` never obtained by `qP2 u` within `D` rounds: top `u`.

**`KnowledgeSim`** (the statement), for every `ω`:
- `know t ⊆ timedReachK G (cred D) t` componentwise, at every round `t`;
- every correctly answered top is in `timedReachK G (cred D) D`.

With `columnHard_timedK` this gives `(k − X)·n ≤ (cred D).size` for `≥ k` correct answers.

**The guess event.** The red team's proposal was to send the "neither part known" XOR use to a guess event.
`XorNeither` is that event, and `XorNeitherUnbounded` is its probability statement: for an adversary that stores the
honest top input (`PousFreshnessRefutation.advFwd`), `pr XorNeither = 1`. So it admits no bound below `1`. It is
credited (top `u`) instead, and `KnowledgeSim` needs no guess event.

**For the decode (not part of this statement).** Each credit must be matched by a deletion.
- Most credits are recovered at the use that triggered them: an `H` slot, a `P⁻¹` input, `W ⊕ k¹` at `qP1`, columns
  as `x²⊕k²` minus a known key, a key as `x²⊕k²` minus known columns, or a final answer.
- The "neither" credit deletes whichever of the key and the columns becomes known second.
- **Load-bearing (DGO19):** a top credited by `qI2 u`, then answered by the decoder, needs `x²_u ⊕ k²_u` computable
  when that query is made.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds
open scoped ENNReal

variable {n wc : ℕ}

/-! ### Honest values and honest queries of one segment -/

section Honest

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω)

/-- The honest lower labels `c¹` and top labels `c²`. -/
def c1 : Fin n → Lab n wc := c1T τ G ω.1 ω.2 W
def c2 : Fin n → Lab n wc := c2T τ G ω.1 ω.2 W

/-- The honest key inputs `(τ, ℓ, v, parents' labels)`, as `c1T`/`c2T` query them. -/
def hk1 (w : Fin n) : KQ' n wc := (τ, 0, w, fun v => if _h : v ∈ G.par w then some (c1 τ G W ω v) else none)
def hk2 (u : Fin n) : KQ' n wc := (τ, 1, u, fun v => if _h : v ∈ G.par u then some (c2 τ G W ω v) else none)

/-- The honest `P_t` inputs `x¹_w = W_w ⊕ k¹_w` and `x²_u ⊕ k²_u`. -/
def in1 (w : Fin n) : Lab n wc := labXor (W w) (ω.1 (hk1 τ G W ω w))
def in2 (u : Fin n) : Lab n wc := labXor (transpose (c1 τ G W ω) u) (ω.1 (hk2 τ G W ω u))

def qH1 (w : Fin n) : (p3ModelT n wc).Qry := Sum.inl (hk1 τ G W ω w)
def qH2 (u : Fin n) : (p3ModelT n wc).Qry := Sum.inl (hk2 τ G W ω u)
def qP1 (w : Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inl ((τ, 0, w), in1 τ G W ω w))
def qP2 (u : Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inl ((τ, 1, u), in2 τ G W ω u))
def qI1 (w : Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inr ((τ, 0, w), c1 τ G W ω w))
def qI2 (u : Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inr ((τ, 1, u), c2 τ G W ω u))

end Honest

/-! ### The round-synchronous union, knowledge, and credits -/

section Trace

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)

/-- Some challenge program sends `q` within its first `t` rounds. -/
def Asked (q : (p3ModelT n wc).Qry) (t : ℕ) : Prop :=
  ∃ c, q ∈ upTo ((p3ModelT n wc).answer ω) (ps c) t

/-- `q` is first asked (by any program) in round `r`. -/
def FirstAt (q : (p3ModelT n wc).Qry) (r : ℕ) : Prop :=
  Asked ps ω q r ∧ ¬ Asked ps ω q (r - 1)

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

open Classical in
/-- What the answers to honest queries have told the programs by round `t`. -/
noncomputable def know (t : ℕ) : ColState n where
  lowerWhole := Finset.univ.filter fun w => Asked ps ω (qP1 τ G W ω w) t
  lowerCol := Finset.univ.filter fun p => Asked ps ω (qI2 τ G W ω p.2) t ∧ Asked ps ω (qH2 τ G W ω p.2) t
  topWhole := Finset.univ.filter fun u => Asked ps ω (qP2 τ G W ω u) t

open Classical in
/-- The held units the trace credits, each at the first round its triggering query is asked (see the module doc).
`D` is the round bound (for the final answers). -/
noncomputable def cred (D : ℕ) : KState n where
  hold :=
    { lowerWhole := Finset.univ.filter fun w =>
        (∃ v r, w ∈ G.par v ∧ FirstAt ps ω (qH1 τ G W ω v) r ∧ ¬ Asked ps ω (qP1 τ G W ω w) (r - 1)) ∨
        (∃ r, FirstAt ps ω (qI1 τ G W ω w) r ∧ ¬ Asked ps ω (qP1 τ G W ω w) (r - 1))
      lowerCol := Finset.univ.filter fun p =>
        ∃ r, FirstAt ps ω (qP2 τ G W ω p.2) r ∧ Asked ps ω (qH2 τ G W ω p.2) (r - 1) ∧
          ¬ avail (know ps ω τ G W (r - 1)) p.1 p.2
      topWhole := Finset.univ.filter fun u =>
        (∃ v r, u ∈ G.par v ∧ FirstAt ps ω (qH2 τ G W ω v) r ∧ ¬ Asked ps ω (qP2 τ G W ω u) (r - 1)) ∨
        (∃ r, FirstAt ps ω (qI2 τ G W ω u) r ∧ ¬ Asked ps ω (qP2 τ G W ω u) (r - 1)) ∨
        (∃ r, FirstAt ps ω (qP2 τ G W ω u) r ∧ ¬ Asked ps ω (qH2 τ G W ω u) (r - 1) ∧
          ¬ ∀ w, avail (know ps ω τ G W (r - 1)) w u) ∨
        ((ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u ∧ ¬ Asked ps ω (qP2 τ G W ω u) D) }
  lowerKey := Finset.univ.filter fun w =>
    ∃ r, FirstAt ps ω (qP1 τ G W ω w) r ∧
      ¬ (Asked ps ω (qH1 τ G W ω w) (r - 1) ∨ Asked ps ω (qI1 τ G W ω w) (r - 1))
  topKey := Finset.univ.filter fun u =>
    ∃ r, FirstAt ps ω (qP2 τ G W ω u) r ∧ ¬ Asked ps ω (qH2 τ G W ω u) (r - 1) ∧
      ∀ w, avail (know ps ω τ G W (r - 1)) w u

/-- The XOR use with neither part obtained: the event the red team proposed to treat as a guess. -/
def XorNeither : Prop :=
  ∃ u r, FirstAt ps ω (qP2 τ G W ω u) r ∧ ¬ Asked ps ω (qH2 τ G W ω u) (r - 1) ∧
    ¬ ∀ w, avail (know ps ω τ G W (r - 1)) w u

end Trace

/-! ### The statements -/

/-- **`KnowledgeSim`.** For every segment, primitive and family of challenge programs: at every round, what the
answers have told the programs is inside the keyed timed game from the credited holding, and every correctly answered
top is in it at `D`. -/
def KnowledgeSim : Prop :=
  ∀ (n wc D : ℕ) (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω),
    (∀ t, Le (know ps ω τ G W t) (timedReachK G (cred ps ω τ G W D) t)) ∧
    (Finset.univ.filter fun u => (ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u) ⊆
      (timedReachK G (cred ps ω τ G W D) D).topWhole

/-- **Round count.** Under `Bounded D Q`, being asked within `D` rounds is being asked at all (in the segment's
trace, the object `run_congr` and the decode read). -/
def AskedAll : Prop :=
  ∀ (n wc D Q : ℕ) (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
    (q : (p3ModelT n wc).Qry), (∀ c, (ps c).Bounded D Q) →
    (Asked ps ω q D ↔ q ∈ segTrace ((p3ModelT n wc).answer ω) ps)

/-- **The guess event admits no bound.** For an adversary storing the honest top inputs, the XOR use with neither part
obtained happens on every `ω`: `pr XorNeither = 1`. -/
def XorNeitherUnbounded : Prop :=
  ∃ (n wc m : ℕ) (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc ∧ (∀ σ c, (A₂ σ c).Bounded 1 1) ∧
    pr (fun ω => XorNeither (A₂ (A₁ ω)) ω τ G W) = 1

end PousKnowledge

end


/-! ════ Freshness.KnowledgeSimProof ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Proofs of `KnowledgeSim`, `AskedAll` and `XorNeitherUnbounded`

`knowledgeSim` is a strong induction over rounds. Each obtained unit is traced to the first round `r` its honest
query was asked. There, every input it used was either obtained earlier (by the induction hypothesis, inside the game at
`r − 1`) or credited (in the held state, inside the game from round `0`). The matching move of the keyed timed game then
produces it by round `r`.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds
open scoped ENNReal

variable {n wc : ℕ}

/-! ### Rounds: nothing is asked in round `0`, asking only grows, and every asked query has a first round -/

section Asked

variable {ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)} {ω : (p3ModelT n wc).Ω}

theorem not_asked_zero {q : (p3ModelT n wc).Qry} : ¬ Asked ps ω q 0 := by
  rintro ⟨c, h⟩
  simp [upTo] at h

theorem asked_mono {q : (p3ModelT n wc).Qry} {s t : ℕ} (h : s ≤ t) (hs : Asked ps ω q s) : Asked ps ω q t := by
  obtain ⟨c, hc⟩ := hs
  refine ⟨c, ?_⟩
  simp only [upTo, List.mem_flatten] at hc ⊢
  obtain ⟨l, hl, hql⟩ := hc
  exact ⟨l, List.take_subset_take_left _ h hl, hql⟩

theorem exists_firstAt {q : (p3ModelT n wc).Qry} {t : ℕ} (h : Asked ps ω q t) :
    ∃ r, 1 ≤ r ∧ r ≤ t ∧ FirstAt ps ω q r := by
  classical
  have hex : ∃ r, Asked ps ω q r := ⟨t, h⟩
  refine ⟨Nat.find hex, ?_, Nat.find_min' hex h, Nat.find_spec hex, ?_⟩
  · rcases Nat.eq_zero_or_pos (Nat.find hex) with h0 | h0
    · exact absurd (h0 ▸ Nat.find_spec hex) not_asked_zero
    · exact h0
  · refine Nat.find_min hex ?_
    rcases Nat.eq_zero_or_pos (Nat.find hex) with h0 | h0
    · exact absurd (h0 ▸ Nat.find_spec hex) not_asked_zero
    · omega

end Asked

/-! ### Moves of the keyed timed game -/

section Moves

variable {G : Labelling.TopoDAG n} {c : KState n}

theorem timedReachK_mono {s t : ℕ} (h : s ≤ t) : Le (timedReachK G c s) (timedReachK G c t) := by
  induction h with
  | refl => exact ⟨subset_rfl, subset_rfl, subset_rfl⟩
  | step _ ih => exact ih.trans (timedReachK_le_succ G c _)

theorem hold_le (t : ℕ) : Le c.hold (timedReachK G c t) :=
  Le.trans (c := c.hold) (d := timedReachK G c 0)
    ⟨fun _ h => mem_promote_lowerWhole.2 (Or.inl h), subset_rfl, subset_rfl⟩ (timedReachK_mono (Nat.zero_le t))

theorem lowerKey_mem {t : ℕ} (ht : 1 ≤ t) {w : Fin n} (hw : w ∈ c.lowerKey) :
    w ∈ (timedReachK G c t).lowerWhole := by
  refine (timedReachK_mono (G := G) (c := c) ht).1 ?_
  show w ∈ (promote (stepOneK G c (timedReachK G c 0))).lowerWhole
  exact mem_promote_lowerWhole.2 (Or.inl (Finset.mem_union_right _ hw))

theorem fwdLower_mem {s : ℕ} {w : Fin n} (h : G.par w ⊆ (timedReachK G c s).lowerWhole) :
    w ∈ (timedReachK G c (s + 2)).lowerWhole := by
  show w ∈ (promote (stepTwoK G c (timedReachK G c s) (timedReachK G c (s + 1)))).lowerWhole
  exact mem_promote_lowerWhole.2 (Or.inl (Finset.mem_union_left _
    (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩))))

theorem fwdTop_mem {s : ℕ} {u : Fin n} (hcols : ∀ w, avail (timedReachK G c (s + 1)) w u)
    (hpar : G.par u ⊆ (timedReachK G c s).topWhole) : u ∈ (timedReachK G c (s + 2)).topWhole := by
  show u ∈ (stepTwoK G c (timedReachK G c s) (timedReachK G c (s + 1))).topWhole
  exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hcols, Or.inl hpar⟩)

theorem keyTop_mem {u : Fin n} (hk : u ∈ c.topKey) :
    ∀ {t : ℕ}, (∀ w, avail (timedReachK G c t) w u) → u ∈ (timedReachK G c (t + 1)).topWhole
  | 0, hcols => by
    show u ∈ (stepOneK G c (timedReachK G c 0)).topWhole
    exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hk, hcols⟩)
  | s + 1, hcols => by
    show u ∈ (stepTwoK G c (timedReachK G c s) (timedReachK G c (s + 1))).topWhole
    exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hcols, Or.inr hk⟩)

theorem rev_mem {u w : Fin n} :
    ∀ {t : ℕ}, u ∈ (timedReachK G c t).topWhole → G.par u ⊆ (timedReachK G c t).topWhole →
      (w, u) ∈ (timedReachK G c (t + 1)).lowerCol
  | 0, hu, hpar => by
    show (w, u) ∈ (stepOneK G c (timedReachK G c 0)).lowerCol
    exact Finset.mem_union_right _
      (Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_filter.2 ⟨hu, Or.inl hpar⟩⟩)
  | s + 1, hu, hpar => by
    show (w, u) ∈ (stepTwoK G c (timedReachK G c s) (timedReachK G c (s + 1))).lowerCol
    exact Finset.mem_union_right _
      (Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_filter.2 ⟨hu, Or.inl hpar⟩⟩)

end Moves

/-! ### The simulation -/

section Sim

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (D : ℕ)

theorem mem_know_lowerWhole {t : ℕ} {w : Fin n} :
    w ∈ (know ps ω τ G W t).lowerWhole ↔ Asked ps ω (qP1 τ G W ω w) t := by
  simp [know]

theorem mem_know_lowerCol {t : ℕ} {p : Fin n × Fin n} :
    p ∈ (know ps ω τ G W t).lowerCol ↔ Asked ps ω (qI2 τ G W ω p.2) t ∧ Asked ps ω (qH2 τ G W ω p.2) t := by
  simp [know]

theorem mem_know_topWhole {t : ℕ} {u : Fin n} :
    u ∈ (know ps ω τ G W t).topWhole ↔ Asked ps ω (qP2 τ G W ω u) t := by
  simp [know]

/-- A top used at round `r` (in an `H` slot or a `P⁻¹` input) is obtained by `r − 1` or credited; either way it is in
the game at `r − 1`. -/
theorem top_in_game {r : ℕ} (hr : 1 ≤ r) {u : Fin n}
    (ih : ∀ s < r, Le (know ps ω τ G W s) (timedReachK G (cred ps ω τ G W D) s))
    (hcred : ¬ Asked ps ω (qP2 τ G W ω u) (r - 1) → u ∈ (cred ps ω τ G W D).hold.topWhole) :
    u ∈ (timedReachK G (cred ps ω τ G W D) (r - 1)).topWhole := by
  by_cases h : Asked ps ω (qP2 τ G W ω u) (r - 1)
  · exact (ih (r - 1) (by omega)).2.2 ((mem_know_topWhole ps ω τ G W).2 h)
  · exact (hold_le (r - 1)).2.2 (hcred h)

theorem lower_in_game {r : ℕ} (hr : 1 ≤ r) {w : Fin n}
    (ih : ∀ s < r, Le (know ps ω τ G W s) (timedReachK G (cred ps ω τ G W D) s))
    (hcred : ¬ Asked ps ω (qP1 τ G W ω w) (r - 1) → w ∈ (cred ps ω τ G W D).hold.lowerWhole) :
    w ∈ (timedReachK G (cred ps ω τ G W D) (r - 1)).lowerWhole := by
  by_cases h : Asked ps ω (qP1 τ G W ω w) (r - 1)
  · exact (ih (r - 1) (by omega)).1 ((mem_know_lowerWhole ps ω τ G W).2 h)
  · exact (hold_le (r - 1)).1 (hcred h)

/-- The parents of `v` are in the game at `r' − 1`, where `r'` is the first round of `qH2 v`. -/
theorem topParents_in_game {r' : ℕ} (hr' : 1 ≤ r') {v : Fin n} (hfirst : FirstAt ps ω (qH2 τ G W ω v) r')
    (ih : ∀ s < r', Le (know ps ω τ G W s) (timedReachK G (cred ps ω τ G W D) s)) :
    G.par v ⊆ (timedReachK G (cred ps ω τ G W D) (r' - 1)).topWhole := fun u hu =>
  top_in_game ps ω τ G W D hr' ih fun h => by
    simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
    exact Or.inl ⟨v, r', hu, hfirst, h⟩

theorem know_le : ∀ t, Le (know ps ω τ G W t) (timedReachK G (cred ps ω τ G W D) t) := by
  intro t
  induction t using Nat.strong_induction_on with
  | _ t ih =>
  set T := timedReachK G (cred ps ω τ G W D) with hT
  have ihr : ∀ {r}, r ≤ t → ∀ s < r, Le (know ps ω τ G W s) (T s) := fun hr s hs => ih s (by omega)
  refine ⟨fun w hw => ?_, fun p hp => ?_, fun u hu => ?_⟩
  · -- a lower label, obtained by `qP1 w`
    obtain ⟨r, hr1, hrt, hfirst⟩ := exists_firstAt ((mem_know_lowerWhole ps ω τ G W).1 hw)
    by_cases hkey : Asked ps ω (qH1 τ G W ω w) (r - 1) ∨ Asked ps ω (qI1 τ G W ω w) (r - 1)
    · rcases hkey with hkey | hkey
      · obtain ⟨r', hr'1, hr'r, hfirst'⟩ := exists_firstAt hkey
        have hpar : G.par w ⊆ (T (r' - 1)).lowerWhole := fun p hp =>
          lower_in_game ps ω τ G W D hr'1 (ihr (by omega)) fun h => by
            simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
            exact Or.inl ⟨w, r', hp, hfirst', h⟩
        have := fwdLower_mem hpar
        exact (timedReachK_mono (by omega)).1 this
      · obtain ⟨r', hr'1, hr'r, hfirst'⟩ := exists_firstAt hkey
        refine (hold_le t).1 ?_
        simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact Or.inr ⟨r', hfirst', fun h => hfirst.2 (asked_mono (by omega) h)⟩
    · refine lowerKey_mem (by omega) ?_
      simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨r, hfirst, hkey⟩
  · -- columns `(·, u)`, obtained by `qI2 u` and `qH2 u` (the reverse move)
    obtain ⟨hI, hH⟩ := (mem_know_lowerCol ps ω τ G W).1 hp
    obtain ⟨r₁, h11, h1t, hfirst₁⟩ := exists_firstAt hI
    obtain ⟨r₂, h21, h2t, hfirst₂⟩ := exists_firstAt hH
    have htop : p.2 ∈ (T (r₁ - 1)).topWhole :=
      top_in_game ps ω τ G W D h11 (ihr h1t) fun h => by
        simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact Or.inr (Or.inl ⟨r₁, hfirst₁, h⟩)
    have hpar := topParents_in_game ps ω τ G W D h21 hfirst₂ (ihr h2t)
    have hm1 : r₁ - 1 ≤ max r₁ r₂ - 1 := by omega
    have hm2 : r₂ - 1 ≤ max r₁ r₂ - 1 := by omega
    have := rev_mem (w := p.1) ((timedReachK_mono hm1).2.2 htop) (hpar.trans (timedReachK_mono hm2).2.2)
    have hmt : max r₁ r₂ - 1 + 1 ≤ t := by omega
    exact (timedReachK_mono hmt).2.1 this
  · -- a top, obtained by `qP2 u`: the XOR use, by cases
    obtain ⟨r, hr1, hrt, hfirst⟩ := exists_firstAt ((mem_know_topWhole ps ω τ G W).1 hu)
    have ihk := ih (r - 1) (by omega)
    by_cases hK : Asked ps ω (qH2 τ G W ω u) (r - 1)
    · -- key obtained: the columns are obtained or credited, the parents are in the game
      obtain ⟨r', hr'1, hr'r, hfirst'⟩ := exists_firstAt hK
      have hpar := topParents_in_game ps ω τ G W D hr'1 hfirst' (ihr (by omega))
      have hcols : ∀ w, avail (T (r - 2 + 1)) w u := by
        intro w
        have he : r - 2 + 1 = r - 1 := by omega
        rw [he]
        by_cases hav : avail (know ps ω τ G W (r - 1)) w u
        · exact avail_mono ihk hav
        · refine Or.inr ((hold_le (r - 1)).2.1 ?_)
          simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
          exact ⟨r, hfirst, hK, hav⟩
      have := fwdTop_mem hcols (hpar.trans (timedReachK_mono (by omega)).2.2)
      exact (timedReachK_mono (by omega)).2.2 this
    · by_cases hC : ∀ w, avail (know ps ω τ G W (r - 1)) w u
      · -- columns obtained, key not: the key is credited
        have hk : u ∈ (cred ps ω τ G W D).topKey := by
          simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
          exact ⟨r, hfirst, hK, hC⟩
        have := keyTop_mem hk (t := r - 1) fun w => avail_mono ihk (hC w)
        exact (timedReachK_mono (by omega)).2.2 this
      · -- neither: top `u` is credited
        refine (hold_le t).2.2 ?_
        simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact Or.inr (Or.inr (Or.inl ⟨r, hfirst, hK, hC⟩))

theorem answered_sub :
    (Finset.univ.filter fun u => (ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u) ⊆
      (timedReachK G (cred ps ω τ G W D) D).topWhole := by
  intro u hu
  have hans := (Finset.mem_filter.1 hu).2
  by_cases h : Asked ps ω (qP2 τ G W ω u) D
  · exact (know_le ps ω τ G W D D).2.2 ((mem_know_topWhole ps ω τ G W).2 h)
  · refine (hold_le D).2.2 ?_
    simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
    exact Or.inr (Or.inr (Or.inr ⟨hans, h⟩))

end Sim

/-- **`KnowledgeSim` holds.** -/
theorem knowledgeSim : KnowledgeSim := fun _ _ D τ G W ps ω =>
  ⟨know_le ps ω τ G W D, answered_sub ps ω τ G W D⟩

/-- **`AskedAll` holds**: under `Bounded D Q`, the first `D` rounds are all rounds. -/
theorem askedAll : AskedAll := by
  intro n wc D Q ps ω q hb
  have hup : ∀ c, upTo ((p3ModelT n wc).answer ω) (ps c) D = progTrace ((p3ModelT n wc).answer ω) (ps c) := by
    intro c
    rw [upTo, List.take_of_length_le (length_rounds_le (hb c) ω), ← progTrace_eq_flatten]
  simp only [Asked, hup, segTrace, List.mem_flatten, List.mem_ofFn]
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨_, ⟨c, rfl⟩, hc⟩
  · rintro ⟨l, ⟨c, rfl⟩, hc⟩
    exact ⟨c, hc⟩

/-! ### The guess event admits no bound -/

theorem c2_eq (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω)
    (u : Fin n) : c2 τ G W ω u = ω.2 (τ, 1, u) (in2 τ G W ω u) := by
  show c2T τ G ω.1 ω.2 W u = _
  rw [c2T]
  rfl

def W0' : Fin 1 → Lab 1 1 := fun _ _ _ => false

open PousFreshnessRefutation in
/-- `advFwd` (store the honest top inputs, query `P_t` at them) hits the "neither part obtained" XOR use on every
`ω`, at top `0` in round `1`. -/
theorem xorNeither_advFwd (ω : (p3ModelT 1 1).Ω) :
    XorNeither (fun c => advFwd (A₁fwd (pathG 1) W0' ω) 0 c) ω tag0 (pathG 1) W0' := by
  refine ⟨0, 1, ⟨⟨0, ?_⟩, not_asked_zero⟩, not_asked_zero, fun h => ?_⟩
  · have hin : dec (enc (honestIns (pathG 1) W0' ω)) 0 = in2 tag0 (pathG 1) W0' ω 0 := by
      rw [dec_enc, honestIns]
      show (ω.2 (tag0, 1, 0)).symm (c2 tag0 (pathG 1) W0' ω 0) = _
      rw [c2_eq, Equiv.symm_apply_apply]
    simp only [upTo, rounds, advFwd, A₁fwd, List.take_succ_cons, List.take_zero, List.flatten_cons,
      List.flatten_nil, List.append_nil, qP2]
    rw [hin]
    exact List.mem_singleton.2 rfl
  · rcases h 0 with h0 | h0
    · exact not_asked_zero ((mem_know_lowerWhole _ ω tag0 (pathG 1) W0').1 h0)
    · exact not_asked_zero ((mem_know_lowerCol _ ω tag0 (pathG 1) W0').1 h0).1

open PousFreshnessRefutation in
/-- **`XorNeitherUnbounded` holds**: `pr XorNeither = 1` for `advFwd`. -/
theorem xorNeitherUnbounded : XorNeitherUnbounded := by
  refine ⟨1, 1, 1 * (1 * 1), tag0, pathG 1, W0', A₁fwd (pathG 1) W0', fun σ c => advFwd σ 0 c, one_pos,
    fun σ c => advFwd_bounded σ 0 c, ?_⟩
  simp only [pr, xorNeither_advFwd, Finset.filter_true, Finset.card_univ]
  exact ENNReal.div_self (by exact_mod_cast (Fintype.card_ne_zero (α := (p3ModelT 1 1).Ω)))
    (ENNReal.natCast_ne_top _)

end PousKnowledge

end


/-! ════ Freshness.Probe ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Probe: `cred` over-credits, so no decode recovers every credit

One node, no edges (`pathG 1`), `wc = 1`. `σ` holds one label, `c²_0`. The program for challenge `0`:

* round 1: `P⁻¹_{(τ,1,0)}(c²_0)` and the key query `H(τ,1,0, ∅)`. Their answers give `x²_0 ⊕ k²_0` and `k²_0`, so the
  adversary knows column `(0,0)` of `c¹_0`, which for `n = 1` is all of `c¹_0` (a promotion, in its head);
* round 2: `P⁻¹_{(τ,0,0)}(c¹_0)`, a use of `c¹_0`;
* answer `c²_0`.

`cred` credits top `0` (inverse use, round 1) and lower `0` (inverse use, round 2, since `know` has no promotion), so
`2 ≤ (cred …).size` on every `ω` while `σ` is one label (`overcredit`). The adversary wins on every `ω`
(`overcredit_run`), so a decode deleting both units would compress every `ω` by two labels from one label of `σ`: no
decode order, and no decoder, recovers both. The cycle is the one asked about: answering the round-1 inverse needs
`c¹_0`, whose only recovery is the round-2 query, built from that answer.

The fix is to credit against the game: at round 1, `timedReachK` from `{top 0}` already has lower `0`
(`lower_in_game_top`), so a game-relative rule does not credit it.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds
open PousFreshnessRefutation

/-- `Lab 1 1` as one bit and back. -/
def enc1 (x : Lab 1 1) : Bits 1 := fun j => x 0 j
def dec1 (σ : Bits 1) : Lab 1 1 := fun _ j => σ j

theorem dec1_enc1 (x : Lab 1 1) : dec1 (enc1 x) = x := by
  funext u j
  rw [Subsingleton.elim u 0]
  rfl

/-- The key input of top `0` with no parents. -/
def key0 : KQ' 1 1 := (tag0, 1, 0, fun _ => none)

/-- Round 1: inverse at the stored top and its key; round 2: inverse at `c¹_0 = x²_0 ⊕ k²_0` (in its head). -/
def advOver (σ : Bits 1) : Prog (p3ModelT 1 1) (Lab 1 1) :=
  .round [Sum.inr (Sum.inr ((tag0, 1, 0), dec1 σ)), Sum.inl key0] fun as =>
    .round [Sum.inr (Sum.inr ((tag0, 0, 0), labXor (as.headD (dec1 σ)) (as.tail.headD (dec1 σ))))] fun _ =>
      .ret (dec1 σ)

noncomputable def A₁over (ω : (p3ModelT 1 1).Ω) : Bits 1 := enc1 (c2 tag0 (pathG 1) W0' ω 0)

theorem advOver_bounded (σ : Bits 1) : (advOver σ).Bounded 2 3 :=
  fun _ => ⟨le_of_eq rfl, le_of_eq rfl⟩

theorem hk2_zero (ω : (p3ModelT 1 1).Ω) : hk2 tag0 (pathG 1) W0' ω 0 = key0 := by
  simp only [hk2, key0]
  congr

theorem xor_cancel (a b : Lab 1 1) : labXor (labXor a b) b = a := by
  funext v j
  simp [labXor, Labelling.bxor]

/-- The round-2 value is `c¹_0`. -/
theorem round2_eq (ω : (p3ModelT 1 1).Ω) :
    labXor ((ω.2 (tag0, 1, 0)).symm (c2 tag0 (pathG 1) W0' ω 0)) (ω.1 key0) = c1 tag0 (pathG 1) W0' ω 0 := by
  rw [c2_eq, Equiv.symm_apply_apply, ← hk2_zero ω, in2, xor_cancel]
  funext u j
  rw [Subsingleton.elim u 0]
  rfl

theorem overcredit_run (ω : (p3ModelT 1 1).Ω) :
    (advOver (A₁over ω)).run ((p3ModelT 1 1).answer ω) = c2 tag0 (pathG 1) W0' ω 0 :=
  dec1_enc1 _

theorem overcredit_rounds (ω : (p3ModelT 1 1).Ω) :
    rounds ((p3ModelT 1 1).answer ω) (advOver (A₁over ω)) =
      [[qI2 tag0 (pathG 1) W0' ω 0, Sum.inl key0], [qI1 tag0 (pathG 1) W0' ω 0]] := by
  have h1 : dec1 (A₁over ω) = c2 tag0 (pathG 1) W0' ω 0 := dec1_enc1 _
  have e : rounds ((p3ModelT 1 1).answer ω) (advOver (A₁over ω)) =
      [[Sum.inr (Sum.inr ((tag0, 1, 0), dec1 (A₁over ω))), Sum.inl key0],
        [Sum.inr (Sum.inr ((tag0, 0, 0), labXor ((ω.2 (tag0, 1, 0)).symm (dec1 (A₁over ω))) (ω.1 key0)))]] :=
    rfl
  rw [e, h1, round2_eq]
  rfl

theorem overcredit_upTo (ω : (p3ModelT 1 1).Ω) :
    upTo ((p3ModelT 1 1).answer ω) (advOver (A₁over ω)) 1 = [qI2 tag0 (pathG 1) W0' ω 0, Sum.inl key0] ∧
    upTo ((p3ModelT 1 1).answer ω) (advOver (A₁over ω)) 2 =
      [qI2 tag0 (pathG 1) W0' ω 0, Sum.inl key0, qI1 tag0 (pathG 1) W0' ω 0] := by
  constructor <;> simp [upTo, overcredit_rounds]; rfl

/-- Neither round-1 query is a lower-layer `P⁻¹` query. -/
theorem not_mem_round1_inv (ω : (p3ModelT 1 1).Ω) (y : Lab 1 1) :
    (Sum.inr (Sum.inr ((tag0, 0, 0), y)) : (p3ModelT 1 1).Qry) ∉ [qI2 tag0 (pathG 1) W0' ω 0, Sum.inl key0] := by
  intro h
  rcases List.mem_cons.1 h with h | h
  · have := congrArg (fun p => p.1.2.1) (Sum.inr.inj (Sum.inr.inj h))
    exact (by decide : (0 : Fin 2) ≠ 1) this
  · rcases List.mem_cons.1 h with h | h
    · cases h
    · exact absurd h List.not_mem_nil

/-- Neither round-1 query is a lower-layer `P` query. -/
theorem not_mem_round1_fwd (ω : (p3ModelT 1 1).Ω) (y : Lab 1 1) :
    (Sum.inr (Sum.inl ((tag0, 0, 0), y)) : (p3ModelT 1 1).Qry) ∉ [qI2 tag0 (pathG 1) W0' ω 0, Sum.inl key0] := by
  intro h
  rcases List.mem_cons.1 h with h | h
  · unfold qI2 at h
    cases h
  · rcases List.mem_cons.1 h with h | h
    · cases h
    · exact absurd h List.not_mem_nil

/-- **`cred` over-credits**: on every `ω`, top `0` and lower `0` are both credited (two labels) though `σ` holds one. -/
theorem overcredit (ω : (p3ModelT 1 1).Ω) :
    0 ∈ (cred (fun _ => advOver (A₁over ω)) ω tag0 (pathG 1) W0' 2).hold.topWhole ∧
    0 ∈ (cred (fun _ => advOver (A₁over ω)) ω tag0 (pathG 1) W0' 2).hold.lowerWhole ∧
    2 ≤ (cred (fun _ => advOver (A₁over ω)) ω tag0 (pathG 1) W0' 2).size := by
  obtain ⟨hu1, hu2⟩ := overcredit_upTo ω
  have hne1 : ∀ q, Asked (fun _ => advOver (A₁over ω)) ω q 1 ↔ q ∈ [qI2 tag0 (pathG 1) W0' ω 0, Sum.inl key0] := by
    intro q
    simp only [Asked, hu1]
    exact ⟨fun ⟨_, h⟩ => h, fun h => ⟨0, h⟩⟩
  have hne2 : ∀ q, Asked (fun _ => advOver (A₁over ω)) ω q 2 ↔
      q ∈ [qI2 tag0 (pathG 1) W0' ω 0, Sum.inl key0, qI1 tag0 (pathG 1) W0' ω 0] := by
    intro q
    simp only [Asked, hu2]
    exact ⟨fun ⟨_, h⟩ => h, fun h => ⟨0, h⟩⟩
  have hI2 : FirstAt (fun _ => advOver (A₁over ω)) ω (qI2 tag0 (pathG 1) W0' ω 0) 1 :=
    ⟨(hne1 _).2 (List.mem_cons_self), not_asked_zero⟩
  have hP2 : ¬ Asked (fun _ => advOver (A₁over ω)) ω (qP2 tag0 (pathG 1) W0' ω 0) 0 := not_asked_zero
  have hI1 : FirstAt (fun _ => advOver (A₁over ω)) ω (qI1 tag0 (pathG 1) W0' ω 0) 2 := by
    refine ⟨(hne2 _).2 (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)), ?_⟩
    rw [show 2 - 1 = 1 from rfl, hne1]
    exact not_mem_round1_inv ω _
  have hP1 : ¬ Asked (fun _ => advOver (A₁over ω)) ω (qP1 tag0 (pathG 1) W0' ω 0) 1 := by
    rw [hne1]
    exact not_mem_round1_fwd ω _
  have htop : 0 ∈ (cred (fun _ => advOver (A₁over ω)) ω tag0 (pathG 1) W0' 2).hold.topWhole := by
    simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
    exact Or.inr (Or.inl ⟨1, hI2, hP2⟩)
  have hlow : 0 ∈ (cred (fun _ => advOver (A₁over ω)) ω tag0 (pathG 1) W0' 2).hold.lowerWhole := by
    simp only [cred, Finset.mem_filter, Finset.mem_univ, true_and]
    exact Or.inr ⟨2, hI1, hP1⟩
  refine ⟨htop, hlow, ?_⟩
  have h1 := Finset.card_pos.2 ⟨0, htop⟩
  have h2 := Finset.card_pos.2 ⟨0, hlow⟩
  simp only [KState.size, ColState.size]
  omega

/-- The game-relative fix: from `{top 0}`, lower `0` is already in the game at round 1 (reverse, then promotion). -/
theorem lower_in_game_top :
    (0 : Fin 1) ∈ (timedReachK (pathG 1)
      ⟨{ lowerWhole := ∅, lowerCol := ∅, topWhole := {0} }, ∅, ∅⟩ 1).lowerWhole := by
  decide

end PousKnowledge

end


/-! ════ Freshness.KnowledgeSim2 ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `KnowledgeSim2`: game-relative credits `cred′`

`KnowledgeSim.lean` (frozen) credits against `know`, the oracle answers alone, so it over-credits what the adversary
derives in its head (`Probe.lean`). Here credits are made **round by round against the keyed timed game of the earlier
credits**, and lower labels are credited **by column**.

`credUpTo r` is the credit accumulated through round `r`. Round `r`'s credits `roundCred C r` are read off the queries
first asked in round `r`, against `Γ = timedReachK G C (r − 1)`, where `C = credUpTo (r − 1)`:

* `qH1 v` uses each parent's lower label: its columns not available in `Γ`.
* `qI1 w` uses `c¹_w`: its columns not available in `Γ`.
* `qH2 v` uses each parent's top label: the top, if not in `Γ`.
* `qI2 u` uses `c²_u`: the top, if not in `Γ`.
* `qP1 w`, with `w` not in `Γ` and its key not available in the game (`keyLow`: held, or parents in the game at
  `r − 2`): the key `k¹_w`.
* `qP2 u`, with `u` not in `Γ`: the XOR use, credited as one unit.
  - Key available (`keyTop`), some columns not: the missing columns.
  - Columns available, key not: the key `k²_u`.
  - Neither: top `u`.

`cred2 D` adds the correctly answered tops not in the game at `D`.

Statements:
* **`KnowledgeSim2`**: for `t ≤ D`, `know t ⊆ timedReachK G (cred2 D) t`, and the correct answers are in it at `D`.
* **`ProbeCredOne`**: `Probe.lean`'s instance now credits exactly one label.
* **`ConsistentCompression`**: the counting step a rewind-and-solve decoder needs. For a reduction `R` (the
  undeleted tables) and a pattern `pat` (the credits), suppose at most `2^b` winning `ω` share `σ`, `R ω` and `pat ω`.
  Then the winners number at most `2^m · |Red| · |Pat| · 2^b`.
  - `ConsistentBound` is the hypothesis. The decode worker (`internal/p3-decode/`) owns the concrete `R`.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds
open PousFreshnessRefutation

variable {n wc : ℕ}

/-- Componentwise union of keyed holdings. -/
def _root_.PousTimedGame.KState.union (a b : KState n) : KState n :=
  ⟨⟨a.hold.lowerWhole ∪ b.hold.lowerWhole, a.hold.lowerCol ∪ b.hold.lowerCol, a.hold.topWhole ∪ b.hold.topWhole⟩,
    a.lowerKey ∪ b.lowerKey, a.topKey ∪ b.topKey⟩

/-- The empty holding. -/
def _root_.PousTimedGame.KState.empty : KState n := ⟨⟨∅, ∅, ∅⟩, ∅, ∅⟩

/-- Top `u`'s key is available to a forward-top at round `r` in the game from `C`: held, or its parents' tops in the
game at `r − 2` (so `H` can be queried at `r − 1`). -/
def keyTop (G : Labelling.TopoDAG n) (C : KState n) (r : ℕ) (u : Fin n) : Prop :=
  u ∈ C.topKey ∨ (2 ≤ r ∧ G.par u ⊆ (timedReachK G C (r - 2)).topWhole)

/-- Lower `w`'s key is available to a forward-lower at round `r` in the game from `C`. -/
def keyLow (G : Labelling.TopoDAG n) (C : KState n) (r : ℕ) (w : Fin n) : Prop :=
  w ∈ C.lowerKey ∨ (2 ≤ r ∧ G.par w ⊆ (timedReachK G C (r - 2)).lowerWhole)

section Credits

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

open Classical in
/-- The credits of round `r`, against the game from the earlier credits `C` (see the module doc). -/
noncomputable def roundCred (C : KState n) (r : ℕ) : KState n where
  hold :=
    { lowerWhole := ∅
      lowerCol := Finset.univ.filter fun p : Fin n × Fin n =>
        ¬ avail (timedReachK G C (r - 1)) p.1 p.2 ∧
          ((∃ v, p.1 ∈ G.par v ∧ FirstAt ps ω (qH1 τ G W ω v) r) ∨ FirstAt ps ω (qI1 τ G W ω p.1) r ∨
            (FirstAt ps ω (qP2 τ G W ω p.2) r ∧ p.2 ∉ (timedReachK G C (r - 1)).topWhole ∧ keyTop G C r p.2))
      topWhole := Finset.univ.filter fun u =>
        u ∉ (timedReachK G C (r - 1)).topWhole ∧
          ((∃ v, u ∈ G.par v ∧ FirstAt ps ω (qH2 τ G W ω v) r) ∨ FirstAt ps ω (qI2 τ G W ω u) r ∨
            (FirstAt ps ω (qP2 τ G W ω u) r ∧ ¬ keyTop G C r u ∧
              ¬ ∀ w, avail (timedReachK G C (r - 1)) w u)) }
  lowerKey := Finset.univ.filter fun w =>
    FirstAt ps ω (qP1 τ G W ω w) r ∧ w ∉ (timedReachK G C (r - 1)).lowerWhole ∧ ¬ keyLow G C r w
  topKey := Finset.univ.filter fun u =>
    FirstAt ps ω (qP2 τ G W ω u) r ∧ u ∉ (timedReachK G C (r - 1)).topWhole ∧ ¬ keyTop G C r u ∧
      ∀ w, avail (timedReachK G C (r - 1)) w u

/-- The credits through round `r`. -/
noncomputable def credUpTo : ℕ → KState n
  | 0 => KState.empty
  | r + 1 => (credUpTo r).union (roundCred ps ω τ G W (credUpTo r) (r + 1))

open Classical in
/-- **`cred′ D`**: the credits of rounds `1, …, D`, and the correctly answered tops not in the game at `D`. -/
noncomputable def cred2 (D : ℕ) : KState n :=
  (credUpTo ps ω τ G W D).union
    ⟨⟨∅, ∅, Finset.univ.filter fun u => (ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u ∧
      u ∉ (timedReachK G (credUpTo ps ω τ G W D) D).topWhole⟩, ∅, ∅⟩

end Credits

/-! ### Statements -/

/-- **`KnowledgeSim2`.** Within `D` rounds, what the answers have told the programs is inside the keyed timed game from
`cred′ D`, and every correctly answered top is in it at `D`. -/
def KnowledgeSim2 : Prop :=
  ∀ (n wc D : ℕ) (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω),
    (∀ t ≤ D, Le (know ps ω τ G W t) (timedReachK G (cred2 ps ω τ G W D) t)) ∧
    (Finset.univ.filter fun u => (ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u) ⊆
      (timedReachK G (cred2 ps ω τ G W D) D).topWhole

/-- **Sanity: `Probe.lean`'s over-credit instance now credits exactly one label** (`σ` is one label). -/
def ProbeCredOne : Prop :=
  ∀ ω : (p3ModelT 1 1).Ω, (cred2 (fun _ => advOver (A₁over ω)) ω tag0 (pathG 1) W0' 2).size = 1

open Classical in
/-- **The rewind-and-solve decoder's counting hypothesis.** For a reduction `R` (what the decoder keeps: the undeleted
tables) and a credit pattern `pat`, at most `2^b` winning `ω` share the same `σ`, reduction and pattern. `b` is the hint
index. -/
def ConsistentBound {Ω : Type} [Fintype Ω] {m : ℕ} {Red Pat : Type} (A₁ : Ω → Bits m) (R : Ω → Red)
    (pat : Ω → Pat) (Win : Ω → Prop) (b : ℕ) : Prop :=
  ∀ σ ρ P, (Finset.univ.filter fun ω => A₁ ω = σ ∧ R ω = ρ ∧ pat ω = P ∧ Win ω).card ≤ 2 ^ b

open Classical in
/-- **The counting step**: `ConsistentBound` bounds the winners by `2^m · |Red| · |Pat| · 2^b`. With the decode worker's
`Red` (`|Red| ≈ |Ω| / 2^{(credited units)·wc}` per pattern) this is the compression bound. -/
def ConsistentCompression : Prop :=
  ∀ {Ω : Type} [Fintype Ω] {m : ℕ} {Red Pat : Type} [Fintype Red] [Fintype Pat] (A₁ : Ω → Bits m) (R : Ω → Red)
    (pat : Ω → Pat) (Win : Ω → Prop) (b : ℕ), ConsistentBound A₁ R pat Win b →
    (Finset.univ.filter Win).card ≤ 2 ^ m * Fintype.card Red * Fintype.card Pat * 2 ^ b

end PousKnowledge

end


/-! ════ Freshness.AssemblyHyp ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The assembly's events, the decode worker's target, and the named hypotheses

The events (`Win1`, `WinMulti`, `CollMulti`) and the decode worker's targets (`DecodeTarget`, `DecodeTargetMulti`) that
`Assembly.lean` consumes. `DecodeHyp`/`DecodeHypMulti` package, for every instance `n10prime`/`n10primeMulti` quantifies
over, a reduction satisfying `ConsistentBound` and the target, at `pos` hit positions. The named hypotheses of the
pinned shapes are `DecodeHyp3` (`pos = 3n`), `DecodeHypMulti3` (`pos = 3nN`) and `LabelBirthdayAll`. Moving to `6n` is
one edit here.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge
open scoped ENNReal

variable {n wc : ℕ}

/-! ### Events and targets -/

/-- One segment wins: at least `k` of its challenges are answered with the top label. -/
def Win1 {m : ℕ} (k : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc))
    (ω : (p3ModelT n wc).Ω) : Prop :=
  k ≤ (Finset.univ.filter fun v => (A₂ (A₁ ω) v).run ((p3ModelT n wc).answer ω) = topLabelT tag G W ω v).card

/-- Every segment wins. -/
def WinMulti {N m : ℕ} (k : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc))
    (ω : (p3ModelT n wc).Ω) : Prop :=
  ∀ s : Fin N, k ≤ (Finset.univ.filter fun v =>
    (A₂ (A₁ ω) s v).run ((p3ModelT n wc).answer ω) = topLabelT (tags s) G (W s) ω v).card

/-- Some segment's honest labels collide. -/
def CollMulti {N : ℕ} (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (ω : (p3ModelT n wc).Ω) : Prop :=
  ∃ s : Fin N, labCollT (tags s) G (W s) ω

/-- **The decode worker's target, one segment**: `|Red| · 2^b · 2^{(k−X)·n·wc} ≤ C(Q_tot, pos) · |Ω|`. -/
def DecodeTarget (n wc Q k X pos : ℕ) (Red : Type) [Fintype Red] (b : ℕ) : Prop :=
  (Fintype.card Red : ℝ≥0∞) * 2 ^ b * 2 ^ ((k - X) * (n * wc)) ≤
    ((Nat.choose (1 * (n * (Q + 1) + 2 * n)) pos : ℕ) : ℝ≥0∞) * (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞)

/-- **The decode worker's target, `N` segments**: `|Red| · 2^b · 2^{N·(k−X)·n·wc} ≤ N · C(N·Q_tot, pos) · |Ω|`. -/
def DecodeTargetMulti (N n wc Q k X pos : ℕ) (Red : Type) [Fintype Red] (b : ℕ) : Prop :=
  (Fintype.card Red : ℝ≥0∞) * 2 ^ b * 2 ^ ((N * (k - X)) * (n * wc)) ≤
    (N : ℝ≥0∞) * ((Nat.choose (N * (n * (Q + 1) + 2 * n)) pos : ℕ) : ℝ≥0∞) *
      (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞)

/-- **The decode hypothesis, one segment, at `pos n` positions**: a reduction meeting `ConsistentBound` and the
target, for every instance `n10prime` quantifies over. -/
def DecodeHyp (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc m D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X → (∀ σ c, (A₂ σ c).Bounded D Q) →
    ∃ (Red : Type) (_ : Fintype Red) (R : (p3ModelT n wc).Ω → Red) (b : ℕ),
      ConsistentBound A₁ R (fun _ => ()) (fun ω => Win1 k tag G W A₁ A₂ ω ∧ ¬ labCollT tag G W ω) b ∧
      DecodeTarget n wc Q k X (pos n) Red b

/-- **The decode hypothesis, `N` segments, at `pos N n` positions.** -/
def DecodeHypMulti (pos : ℕ → ℕ → ℕ) : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gameDepth D) k X →
    (∀ σ s c, (A₂ σ s c).Bounded D Q) →
    ∃ (Red : Type) (_ : Fintype Red) (R : (p3ModelT n wc).Ω → Red) (b : ℕ),
      ConsistentBound A₁ R (fun _ => ())
        (fun ω => WinMulti k tags G W A₁ A₂ ω ∧ ¬ CollMulti tags G W ω) b ∧
      DecodeTargetMulti N n wc Q k X (pos N n) Red b

/-- The decode hypothesis at `pos = 3n` (`PousTweaked.n10prime`'s positions). -/
def DecodeHyp3 : Prop := DecodeHyp fun n => 3 * n

/-- The decode hypothesis at `pos = 3nN` (`PousTweaked.n10primeMulti`'s positions). -/
def DecodeHypMulti3 : Prop := DecodeHypMulti fun N n => 3 * n * N

/-- `LabelBirthdayT` for every segment (the pebbling prover's hypothesis). -/
def LabelBirthdayAll : Prop :=
  ∀ (n wc : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc), LabelBirthdayT tag G W

/-! ### The fixed-advice core, and `n10prime` at any `pos` -/

open Classical in
/-- The winning, non-colliding `ω` of one segment with advice `σ`. -/
noncomputable def advWinners {m : ℕ} (k : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)) (σ : Bits m) : ℕ :=
  (Finset.univ.filter fun ω => A₁ ω = σ ∧ Win1 k tag G W A₁ A₂ ω ∧ ¬ labCollT tag G W ω).card

open Classical in
/-- The winning, non-colliding `ω` of `N` segments with advice `σ`. -/
noncomputable def advWinnersMulti {N m : ℕ} (k : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n)
    (W : Fin N → Fin n → Lab n wc) (A₁ : (p3ModelT n wc).Ω → Bits m)
    (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)) (σ : Bits m) : ℕ :=
  (Finset.univ.filter fun ω => A₁ ω = σ ∧ WinMulti k tags G W A₁ A₂ ω ∧ ¬ CollMulti tags G W ω).card

/-- **The fixed-advice core, one segment, at `pos n` positions**: for every advice string `σ`, the winning,
non-colliding `ω` with `A₁ ω = σ` satisfy `2 · max(#, 1) · 2^{(k−X)·n·wc} ≤ C(Q_tot, pos n) · |Ω|`. It implies
`DecodeHyp pos` (`decodeHyp_of_fixedAdvice`), and follows from it up to the factor `2`. -/
def FixedAdvice (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc m D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X → (∀ σ c, (A₂ σ c).Bounded D Q) →
    ∀ σ : Bits m, 2 * max (advWinners k tag G W A₁ A₂ σ) 1 * 2 ^ ((k - X) * (n * wc)) ≤
      Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n) * Fintype.card (p3ModelT n wc).Ω

/-- **The fixed-advice core, `N` segments, at `pos N n` positions.** -/
def FixedAdviceMulti (pos : ℕ → ℕ → ℕ) : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gameDepth D) k X →
    (∀ σ s c, (A₂ σ s c).Bounded D Q) →
    ∀ σ : Bits m, 2 * max (advWinnersMulti k tags G W A₁ A₂ σ) 1 * 2 ^ ((N * (k - X)) * (n * wc)) ≤
      N * Nat.choose (N * (n * (Q + 1) + 2 * n)) (pos N n) * Fintype.card (p3ModelT n wc).Ω

/-- `n10prime`'s statement at `pos n` hit positions (`N10primeAt fun n => 3 * n` is `PousTweaked.n10prime`'s type). -/
def N10primeAt (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc m D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc),
    0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X →
    ∀ (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    (∀ σ c, (A₂ σ c).Bounded D Q) →
    pr (fun ω : (p3ModelT n wc).Ω =>
        k ≤ (Finset.univ.filter fun v =>
          (A₂ (A₁ ω) v).run ((p3ModelT n wc).answer ω) = topLabelT tag G W ω v).card)
      ≤ N10primeBoundT 1 m n wc (n * (Q + 1) + 2 * n) (pos n) (k - X)
        + (((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

/-- `n10primeMulti`'s statement at `pos N n` hit positions. -/
def N10primeMultiAt (pos : ℕ → ℕ → ℕ) : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gameDepth D) k X →
    ∀ (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    (∀ σ s c, (A₂ σ s c).Bounded D Q) →
    pr (fun ω : (p3ModelT n wc).Ω =>
        ∀ s : Fin N, k ≤ (Finset.univ.filter fun v =>
          (A₂ (A₁ ω) s v).run ((p3ModelT n wc).answer ω) = topLabelT (tags s) G (W s) ω v).card)
      ≤ N10primeBoundT N m n wc (n * (Q + 1) + 2 * n) (pos N n) (N * (k - X))
        + (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

/-- The positions the decode needs (`inverse-decode.md` §4): `7n` per segment. -/
def posP3 (n : ℕ) : ℕ := 7 * n

/-- The positions the decode needs, `N` segments: `7nN`. -/
def posP3Multi (N n : ℕ) : ℕ := 7 * n * N

/-- The fixed-advice core at `pos = 3n` (`PousTweaked.n10prime`'s positions). -/
def FixedAdvice3 : Prop := FixedAdvice fun n => 3 * n

/-- The fixed-advice core at `pos = 3nN`. -/
def FixedAdviceMulti3 : Prop := FixedAdviceMulti fun N n => 3 * n * N

/-- The fixed-advice core at the decode's `pos = 7n`. -/
def FixedAdvice7 : Prop := FixedAdvice posP3

/-- The fixed-advice core at the decode's `pos = 7nN`. -/
def FixedAdviceMulti7 : Prop := FixedAdviceMulti posP3Multi

/-! ### The corrected hypothesis: the per-advice count without `max`, and its zero-advice form

`DecodeHyp` and `FixedAdvice` (with `max (·) 1`) are unsatisfiable (`DecodeHypFalse.lean`). `AdviceBound` bounds the
per-advice count alone, which is `0` when nothing wins. `ZeroAdvice` bounds every fixed, advice-free program family, and
implies `AdviceBound` by dropping `A₁ ω = σ`. -/

/-- A fixed program family wins one segment: at least `k` challenges answered with the top label. -/
def WinZ (k : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω) : Prop :=
  k ≤ (Finset.univ.filter fun v => (p v).run ((p3ModelT n wc).answer ω) = topLabelT tag G W ω v).card

/-- A fixed program family wins every segment. -/
def WinZMulti {N : ℕ} (k : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω) : Prop :=
  ∀ s : Fin N, k ≤ (Finset.univ.filter fun v =>
    (p s v).run ((p3ModelT n wc).answer ω) = topLabelT (tags s) G (W s) ω v).card

/-- **The per-advice count**, one segment: `#{ω | A₁ ω = σ ∧ win ∧ ¬coll} · 2^{(k−X)·n·wc} ≤ C(Q_tot, pos n) · |Ω|`. -/
def AdviceBound (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc m D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X → (∀ σ c, (A₂ σ c).Bounded D Q) →
    ∀ σ : Bits m, advWinners k tag G W A₁ A₂ σ * 2 ^ ((k - X) * (n * wc)) ≤
      Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n) * Fintype.card (p3ModelT n wc).Ω

/-- **The per-advice count**, `N` segments. -/
def AdviceBoundMulti (pos : ℕ → ℕ → ℕ) : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gameDepth D) k X →
    (∀ σ s c, (A₂ σ s c).Bounded D Q) →
    ∀ σ : Bits m, advWinnersMulti k tags G W A₁ A₂ σ * 2 ^ ((N * (k - X)) * (n * wc)) ≤
      N * Nat.choose (N * (n * (Q + 1) + 2 * n)) (pos N n) * Fintype.card (p3ModelT n wc).Ω

open Classical in
/-- **The zero-advice core**, one segment: every fixed `(D, Q)`-bounded program family wins (and does not collide) on
at most `C(Q_tot, pos n) · |Ω| / 2^{(k−X)·n·wc}` primitives. -/
def ZeroAdvice (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X → (∀ c, (p c).Bounded D Q) →
    (Finset.univ.filter fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω).card * 2 ^ ((k - X) * (n * wc)) ≤
      Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n) * Fintype.card (p3ModelT n wc).Ω

open Classical in
/-- **The zero-advice core**, `N` segments. -/
def ZeroAdviceMulti (pos : ℕ → ℕ → ℕ) : Prop :=
  ∀ (N n wc D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gameDepth D) k X →
    (∀ s c, (p s c).Bounded D Q) →
    (Finset.univ.filter fun ω => WinZMulti k tags G W p ω ∧ ¬ CollMulti tags G W ω).card *
        2 ^ ((N * (k - X)) * (n * wc)) ≤
      N * Nat.choose (N * (n * (Q + 1) + 2 * n)) (pos N n) * Fintype.card (p3ModelT n wc).Ω

/-- The zero-advice core at `pos = 3n` (`PousTweaked.n10prime`'s positions). -/
def ZeroAdvice3 : Prop := ZeroAdvice fun n => 3 * n

/-- The zero-advice core at `pos = 3nN`. -/
def ZeroAdviceMulti3 : Prop := ZeroAdviceMulti fun N n => 3 * n * N

/-! ### Restricted to `0 < n` and `Q₀ ≤ Q`

`N10primeAt pos` is false whenever `pos 0 > 0` or `pos 1 > 3` (`PosTooLarge.lean`): at `n = 0`, or at `Q = 0`, the
binomial `C(Q_tot, pos n)` is `0` while `k = 0` always wins. The lucky-guess bound (`inverse-decode.md` §7.4) needs
`pos = 9n + 1` and `Q_tot ≥ 30n`, i.e. `Q ≥ 27`, so its statements carry `0 < n` and `Q₀ ≤ Q`. -/

/-- `N10primeAt pos`, for `0 < n` and `Q₀ ≤ Q` only. -/
def N10primeAtGe (Q₀ : ℕ) (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc m D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc),
    0 < n → Q₀ ≤ Q → 0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X →
    ∀ (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    (∀ σ c, (A₂ σ c).Bounded D Q) →
    pr (fun ω : (p3ModelT n wc).Ω =>
        k ≤ (Finset.univ.filter fun v =>
          (A₂ (A₁ ω) v).run ((p3ModelT n wc).answer ω) = topLabelT tag G W ω v).card)
      ≤ N10primeBoundT 1 m n wc (n * (Q + 1) + 2 * n) (pos n) (k - X)
        + (((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

/-- `N10primeMultiAt pos`, for `0 < n` and `Q₀ ≤ Q` only. -/
def N10primeMultiAtGe (Q₀ : ℕ) (pos : ℕ → ℕ → ℕ) : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    0 < n → Q₀ ≤ Q → 0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gameDepth D) k X →
    ∀ (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    (∀ σ s c, (A₂ σ s c).Bounded D Q) →
    pr (fun ω : (p3ModelT n wc).Ω =>
        ∀ s : Fin N, k ≤ (Finset.univ.filter fun v =>
          (A₂ (A₁ ω) s v).run ((p3ModelT n wc).answer ω) = topLabelT (tags s) G (W s) ω v).card)
      ≤ N10primeBoundT N m n wc (n * (Q + 1) + 2 * n) (pos N n) (N * (k - X))
        + (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

/-- `AdviceBound pos`, for `0 < n` and `Q₀ ≤ Q` only. -/
def AdviceBoundGe (Q₀ : ℕ) (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc m D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < n → Q₀ ≤ Q → 0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X → (∀ σ c, (A₂ σ c).Bounded D Q) →
    ∀ σ : Bits m, advWinners k tag G W A₁ A₂ σ * 2 ^ ((k - X) * (n * wc)) ≤
      Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n) * Fintype.card (p3ModelT n wc).Ω

/-- `AdviceBoundMulti pos`, for `0 < n` and `Q₀ ≤ Q` only. -/
def AdviceBoundMultiGe (Q₀ : ℕ) (pos : ℕ → ℕ → ℕ) : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < n → Q₀ ≤ Q → 0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gameDepth D) k X →
    (∀ σ s c, (A₂ σ s c).Bounded D Q) →
    ∀ σ : Bits m, advWinnersMulti k tags G W A₁ A₂ σ * 2 ^ ((N * (k - X)) * (n * wc)) ≤
      N * Nat.choose (N * (n * (Q + 1) + 2 * n)) (pos N n) * Fintype.card (p3ModelT n wc).Ω

open Classical in
/-- `ZeroAdvice pos`, for `0 < n` and `Q₀ ≤ Q` only. -/
def ZeroAdviceGe (Q₀ : ℕ) (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < n → Q₀ ≤ Q → 0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X → (∀ c, (p c).Bounded D Q) →
    (Finset.univ.filter fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω).card * 2 ^ ((k - X) * (n * wc)) ≤
      Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n) * Fintype.card (p3ModelT n wc).Ω

open Classical in
/-- `ZeroAdviceMulti pos`, for `0 < n` and `Q₀ ≤ Q` only. -/
def ZeroAdviceMultiGe (Q₀ : ℕ) (pos : ℕ → ℕ → ℕ) : Prop :=
  ∀ (N n wc D Q k X : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    0 < n → Q₀ ≤ Q → 0 < wc → 1 ≤ N → X ≤ k → Function.Injective tags → ColumnHard G (gameDepth D) k X →
    (∀ s c, (p s c).Bounded D Q) →
    (Finset.univ.filter fun ω => WinZMulti k tags G W p ω ∧ ¬ CollMulti tags G W ω).card *
        2 ^ ((N * (k - X)) * (n * wc)) ≤
      N * Nat.choose (N * (n * (Q + 1) + 2 * n)) (pos N n) * Fintype.card (p3ModelT n wc).Ω

/-- The lucky-guess positions, one segment: `9n + 1` (`inverse-decode.md` §7.4). -/
def posZA (n : ℕ) : ℕ := 9 * n + 1

/-- The lucky-guess positions, `N` segments: `9nN + 1`. -/
def posZAMulti (N n : ℕ) : ℕ := 9 * n * N + 1

/-- The zero-advice core at `pos = 9n + 1`, for `Q ≥ 27`: what the lucky-guess lemma claims. -/
def ZeroAdvice9 : Prop := ZeroAdviceGe 27 posZA

/-- The zero-advice core at `pos = 9nN + 1`, for `Q ≥ 27`. -/
def ZeroAdviceMulti9 : Prop := ZeroAdviceMultiGe 27 posZAMulti

end PousAssembly

end


/-! ════ Freshness.Lucky ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Lucky hits and hit-aware credits (`ZeroAdvicePlan.md`, M1)

A **hit** (L2) on `t = (layer, node)` is a forward query `P_t(z₀_t)` at the preimage `z₀_t = P_t⁻¹(x_t)` of the honest
input, with `z₀_t ≠ x_t`, first asked in round `r`, with `P_t⁻¹(x_t)` not asked before `r`. Its answer is the honest
input `x_t`. So a hit on top `u` holds top `u` (one forward away), and a hit on lower `w` holds the key `k¹_w`. Each
costs `n` units, like the unit it replaces.

`cred3` applies `cred2`'s round rules (`roundCred`, reused unchanged), but each round is checked against the game from
the earlier credits **and hits**.

**`KnowledgeSimHits`** (red-team §29, point 1) is `KnowledgeSim2` for this game. Knowledge is inside the keyed timed
game from `cred3 D ∪ hits D`, and every correctly answered top is in it at `D`.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

/-! ### Honest pairs and hits -/

section Hits

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω)

/-- The tweak of `t = (layer, node)`. -/
def twk (t : Fin 2 × Fin n) : Tweak n := (τ, t.1, t.2)

/-- The honest input of `P_t`: `x¹_w = W_w ⊕ k¹_w` or `x²_u ⊕ k²_u`. -/
def hin (t : Fin 2 × Fin n) : Lab n wc := if t.1 = 0 then in1 τ G W ω t.2 else in2 τ G W ω t.2

/-- The preimage of the honest input: `z₀_t = P_t⁻¹(x_t)`. -/
def z0 (t : Fin 2 × Fin n) : Lab n wc := (ω.2 (twk τ t)).symm (hin τ G W ω t)

/-- The hit query: `P_t` forward at `z₀_t` (answer `x_t`). -/
def qHit (t : Fin 2 × Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inl (twk τ t, z0 τ G W ω t))

/-- `P_t⁻¹` at the honest input (answer `z₀_t`). -/
def qInvIn (t : Fin 2 × Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inr (twk τ t, hin τ G W ω t))

end Hits

section Credits3

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

/-- **A hit on `t` in round `r`.** -/
def hitAt (t : Fin 2 × Fin n) (r : ℕ) : Prop :=
  FirstAt ps ω (qHit τ G W ω t) r ∧ z0 τ G W ω t ≠ hin τ G W ω t ∧ ¬ Asked ps ω (qInvIn τ G W ω t) (r - 1)

open Classical in
/-- The tweaks hit by round `R`. -/
noncomputable def hitsBy (R : ℕ) : Finset (Fin 2 × Fin n) :=
  Finset.univ.filter fun t => ∃ r ≤ R, hitAt ps ω τ G W t r

open Classical in
/-- What the hits by round `R` hold: top `u` for a top hit, the key `k¹_w` for a lower hit. -/
noncomputable def hitUnits (R : ℕ) : KState n :=
  ⟨⟨∅, ∅, Finset.univ.filter fun u => ((1 : Fin 2), u) ∈ hitsBy ps ω τ G W R⟩,
    Finset.univ.filter fun w => ((0 : Fin 2), w) ∈ hitsBy ps ω τ G W R, ∅⟩

/-- The hit-aware credits through round `r`: round `r + 1` is checked against the game from the earlier credits and
the hits by round `r`. -/
noncomputable def credUpTo3 : ℕ → KState n
  | 0 => KState.empty
  | r + 1 => (credUpTo3 r).union
      (roundCred ps ω τ G W ((credUpTo3 r).union (hitUnits ps ω τ G W r)) (r + 1))

open Classical in
/-- **`cred3 D`**: the hit-aware credits of rounds `1, …, D`, and the correctly answered tops not in the game (from the
credits and hits) at `D`. -/
noncomputable def cred3 (D : ℕ) : KState n :=
  (credUpTo3 ps ω τ G W D).union
    ⟨⟨∅, ∅, Finset.univ.filter fun u => (ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u ∧
      u ∉ (timedReachK G ((credUpTo3 ps ω τ G W D).union (hitUnits ps ω τ G W D)) D).topWhole⟩, ∅, ∅⟩

end Credits3

/-- **`KnowledgeSimHits`** (§29, point 1). Within `D` rounds, what the answers have told the programs is inside the
keyed timed game from `cred3 D ∪ hits D`, and every correctly answered top is in it at `D`. -/
def KnowledgeSimHits : Prop :=
  ∀ (n wc D : ℕ) (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω),
    (∀ t ≤ D, Le (know ps ω τ G W t)
      (timedReachK G ((cred3 ps ω τ G W D).union (hitUnits ps ω τ G W D)) t)) ∧
    (Finset.univ.filter fun u => (ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u) ⊆
      (timedReachK G ((cred3 ps ω τ G W D).union (hitUnits ps ω τ G W D)) D).topWhole

end PousKnowledge

end


/-! ════ Freshness.KnowledgeSim2Proof ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Proofs of `KnowledgeSim2`, `ProbeCredOne` and `ConsistentCompression`

Every credit rule of `cred′` checks the keyed timed game of the earlier credits directly. So `knowledgeSim2` is a case
analysis at the first round of each obtained unit, plus monotonicity of the game in its holding (`timedReachK_mono_hold`)
and of the credits in the round (`credUpTo_mono`). No induction on knowledge is needed.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds
open PousFreshnessRefutation

variable {n wc : ℕ}

/-! ### The order on keyed holdings, and monotonicity of the game in the holding -/

/-- `c ≤ c'` componentwise, keys included. -/
def KLe (c c' : KState n) : Prop :=
  Le c.hold c'.hold ∧ c.lowerKey ⊆ c'.lowerKey ∧ c.topKey ⊆ c'.topKey

theorem KLe.refl (c : KState n) : KLe c c := ⟨⟨subset_rfl, subset_rfl, subset_rfl⟩, subset_rfl, subset_rfl⟩

theorem KLe.trans {a b c : KState n} (h₁ : KLe a b) (h₂ : KLe b c) : KLe a c :=
  ⟨h₁.1.trans h₂.1, h₁.2.1.trans h₂.2.1, h₁.2.2.trans h₂.2.2⟩

theorem KLe.union_left (a b : KState n) : KLe a (a.union b) :=
  ⟨⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left⟩,
    Finset.subset_union_left, Finset.subset_union_left⟩

theorem KLe.union_right (a b : KState n) : KLe b (a.union b) :=
  ⟨⟨Finset.subset_union_right, Finset.subset_union_right, Finset.subset_union_right⟩,
    Finset.subset_union_right, Finset.subset_union_right⟩

theorem Le.refl' (c : ColState n) : Le c c := ⟨subset_rfl, subset_rfl, subset_rfl⟩

theorem promote_mono {a b : ColState n} (h : Le a b) : Le (promote a) (promote b) := by
  refine ⟨fun w hw => ?_, h.2.1, h.2.2⟩
  rcases mem_promote_lowerWhole.1 hw with hw | hw
  · exact mem_promote_lowerWhole.2 (Or.inl (h.1 hw))
  · exact mem_promote_lowerWhole.2 (Or.inr fun u => h.2.1 (hw u))

theorem revColsK_mono {G : Labelling.TopoDAG n} {K K' : Finset (Fin n)} {b b' : ColState n} (hK : K ⊆ K')
    (h : Le b b') : revColsK G K b ⊆ revColsK G K' b' := by
  intro p hp
  simp only [revColsK, Finset.mem_product, Finset.mem_univ, true_and, Finset.mem_filter] at hp ⊢
  exact ⟨h.2.2 hp.1, hp.2.imp (fun hp' => hp'.trans h.2.2) (fun hk => hK hk)⟩

theorem stepOneK_mono {G : Labelling.TopoDAG n} {c c' : KState n} {b b' : ColState n} (hc : KLe c c')
    (h : Le b b') : Le (stepOneK G c b) (stepOneK G c' b') := by
  refine ⟨Finset.union_subset_union h.1 hc.2.1, Finset.union_subset_union h.2.1 (revColsK_mono hc.2.2 h),
    Finset.union_subset_union h.2.2 ?_⟩
  intro u hu
  rw [Finset.mem_filter] at hu ⊢
  exact ⟨hc.2.2 hu.1, fun w => avail_mono h (hu.2 w)⟩

theorem stepTwoK_mono {G : Labelling.TopoDAG n} {c c' : KState n} {a a' b b' : ColState n} (hc : KLe c c')
    (ha : Le a a') (hb : Le b b') : Le (stepTwoK G c a b) (stepTwoK G c' a' b') := by
  refine ⟨Finset.union_subset_union (Finset.union_subset_union hb.1 ?_) hc.2.1,
    Finset.union_subset_union hb.2.1 (revColsK_mono hc.2.2 hb), Finset.union_subset_union hb.2.2 ?_⟩
  · intro w hw
    rw [Finset.mem_filter] at hw ⊢
    exact ⟨hw.1, hw.2.trans ha.1⟩
  · intro u hu
    rw [Finset.mem_filter] at hu ⊢
    exact ⟨hu.1, fun w => avail_mono hb (hu.2.1 w), hu.2.2.imp (fun hp => hp.trans ha.2.2) (fun hk => hc.2.2 hk)⟩

theorem timedReachK_mono_pair (G : Labelling.TopoDAG n) {c c' : KState n} (hc : KLe c c') :
    ∀ t, Le (timedReachK G c t) (timedReachK G c' t) ∧ Le (timedReachK G c (t + 1)) (timedReachK G c' (t + 1))
  | 0 => by
    have h0 : Le (timedReachK G c 0) (timedReachK G c' 0) := promote_mono hc.1
    exact ⟨h0, promote_mono (stepOneK_mono hc h0)⟩
  | t + 1 => by
    obtain ⟨h0, h1⟩ := timedReachK_mono_pair G hc t
    exact ⟨h1, promote_mono (stepTwoK_mono hc h0 h1)⟩

/-- The game grows with the holding. -/
theorem timedReachK_mono_hold (G : Labelling.TopoDAG n) {c c' : KState n} (hc : KLe c c') (t : ℕ) :
    Le (timedReachK G c t) (timedReachK G c' t) :=
  (timedReachK_mono_pair G hc t).1

theorem tk_le {G : Labelling.TopoDAG n} {c c' : KState n} (hc : KLe c c') {s t : ℕ} (hst : s ≤ t) :
    Le (timedReachK G c s) (timedReachK G c' t) :=
  (timedReachK_mono_hold G hc s).trans (timedReachK_mono hst)

theorem keyTop_mono {G : Labelling.TopoDAG n} {C C' : KState n} (h : KLe C C') {r : ℕ} {u : Fin n}
    (hk : keyTop G C r u) : keyTop G C' r u :=
  hk.imp (fun h' => h.2.2 h') fun ⟨hr, hp⟩ => ⟨hr, hp.trans (timedReachK_mono_hold G h _).2.2⟩

/-- A top with every column available at `r − 1` and its key available is in the game at `r`. -/
theorem top_move {G : Labelling.TopoDAG n} {C : KState n} {r : ℕ} (hr : 1 ≤ r) {u : Fin n}
    (hk : keyTop G C r u) (hcols : ∀ w, avail (timedReachK G C (r - 1)) w u) :
    u ∈ (timedReachK G C r).topWhole := by
  rcases hk with hk | ⟨hr2, hpar⟩
  · have := keyTop_mem (G := G) hk (t := r - 1) hcols
    rwa [show r - 1 + 1 = r by omega] at this
  · obtain ⟨s, rfl⟩ : ∃ s, r = s + 2 := ⟨r - 2, by omega⟩
    exact fwdTop_mem (by simpa using hcols) (by simpa using hpar)

/-- A lower label whose key is available at `r` is in the game at `r`. -/
theorem lower_move {G : Labelling.TopoDAG n} {C : KState n} {r : ℕ} (hr : 1 ≤ r) {w : Fin n}
    (hk : keyLow G C r w) : w ∈ (timedReachK G C r).lowerWhole := by
  rcases hk with hk | ⟨hr2, hpar⟩
  · exact lowerKey_mem hr hk
  · obtain ⟨s, rfl⟩ : ∃ s, r = s + 2 := ⟨r - 2, by omega⟩
    exact fwdLower_mem (by simpa using hpar)

/-! ### The credits grow with the round -/

section Credits

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

theorem credUpTo_succ (r : ℕ) :
    credUpTo ps ω τ G W (r + 1) = (credUpTo ps ω τ G W r).union (roundCred ps ω τ G W (credUpTo ps ω τ G W r) (r + 1)) :=
  rfl

theorem credUpTo_mono {r s : ℕ} (h : r ≤ s) : KLe (credUpTo ps ω τ G W r) (credUpTo ps ω τ G W s) := by
  induction h with
  | refl => exact KLe.refl _
  | step _ ih => exact ih.trans (KLe.union_left _ _)

theorem round_le (r : ℕ) :
    KLe (roundCred ps ω τ G W (credUpTo ps ω τ G W r) (r + 1)) (credUpTo ps ω τ G W (r + 1)) :=
  KLe.union_right _ _

theorem credUpTo_le_cred2 {r D : ℕ} (h : r ≤ D) : KLe (credUpTo ps ω τ G W r) (cred2 ps ω τ G W D) :=
  (credUpTo_mono ps ω τ G W h).trans (KLe.union_left _ _)

/-- A unit credited as a held top at round `r + 1` is in the game from `credUpTo (r + 1)` at `r`. -/
theorem top_used {r : ℕ} {u : Fin n}
    (hcred : u ∉ (timedReachK G (credUpTo ps ω τ G W r) r).topWhole →
      u ∈ (roundCred ps ω τ G W (credUpTo ps ω τ G W r) (r + 1)).hold.topWhole) :
    u ∈ (timedReachK G (credUpTo ps ω τ G W (r + 1)) r).topWhole := by
  by_cases h : u ∈ (timedReachK G (credUpTo ps ω τ G W r) r).topWhole
  · exact (timedReachK_mono_hold G (credUpTo_mono ps ω τ G W (Nat.le_succ r)) r).2.2 h
  · exact (hold_le r).2.2 ((round_le ps ω τ G W r).1.2.2 (hcred h))

/-! ### The simulation -/

theorem knowledgeSim2_know (D : ℕ) :
    ∀ t ≤ D, Le (know ps ω τ G W t) (timedReachK G (cred2 ps ω τ G W D) t) := by
  intro t htD
  refine ⟨fun w hw => ?_, fun p hp => ?_, fun u hu => ?_⟩
  · -- a lower label, obtained by `qP1 w`
    obtain ⟨r1, hr1, hrt, hfirst⟩ := exists_firstAt ((mem_know_lowerWhole ps ω τ G W).1 hw)
    obtain ⟨r, rfl⟩ : ∃ r, r1 = r + 1 := ⟨r1 - 1, by omega⟩
    set C := credUpTo ps ω τ G W r with hC
    have hfin : ∀ {c : KState n}, KLe c (credUpTo ps ω τ G W (r + 1)) → ∀ {s}, s ≤ r + 1 →
        w ∈ (timedReachK G c s).lowerWhole → w ∈ (timedReachK G (cred2 ps ω τ G W D) t).lowerWhole :=
      fun hc s hs hm => (tk_le (hc.trans (credUpTo_le_cred2 ps ω τ G W (by omega))) (by omega)).1 hm
    by_cases hin : w ∈ (timedReachK G C r).lowerWhole
    · exact hfin (credUpTo_mono ps ω τ G W (Nat.le_succ r)) (Nat.le_succ r) hin
    by_cases hk : keyLow G C (r + 1) w
    · exact hfin (credUpTo_mono ps ω τ G W (Nat.le_succ r)) le_rfl (lower_move (by omega) hk)
    · have hkey : w ∈ (credUpTo ps ω τ G W (r + 1)).lowerKey := (round_le ps ω τ G W r).2.1 (by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨hfirst, by simpa using hin, hk⟩)
      exact hfin (KLe.refl _) le_rfl (lowerKey_mem (by omega) hkey)
  · -- columns `(·, u)`, obtained by `qI2 u` and `qH2 u`
    obtain ⟨hI, hH⟩ := (mem_know_lowerCol ps ω τ G W).1 hp
    obtain ⟨r1, h11, h1t, hfirst₁⟩ := exists_firstAt hI
    obtain ⟨r2, h21, h2t, hfirst₂⟩ := exists_firstAt hH
    obtain ⟨a, rfl⟩ : ∃ a, r1 = a + 1 := ⟨r1 - 1, by omega⟩
    obtain ⟨b, rfl⟩ : ∃ b, r2 = b + 1 := ⟨r2 - 1, by omega⟩
    have htop : p.2 ∈ (timedReachK G (credUpTo ps ω τ G W (a + 1)) a).topWhole :=
      top_used ps ω τ G W fun h => by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨h, Or.inr (Or.inl hfirst₁)⟩
    have hpar : G.par p.2 ⊆ (timedReachK G (credUpTo ps ω τ G W (b + 1)) b).topWhole := fun v hv =>
      top_used ps ω τ G W fun h => by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨h, Or.inl ⟨p.2, hv, hfirst₂⟩⟩
    set m := max a b
    have hCm : ∀ {x}, x ≤ m → KLe (credUpTo ps ω τ G W (x + 1)) (credUpTo ps ω τ G W (m + 1)) :=
      fun hx => credUpTo_mono ps ω τ G W (by omega)
    have := rev_mem (w := p.1) ((tk_le (hCm (le_max_left a b)) (le_max_left a b)).2.2 htop)
      (hpar.trans (tk_le (hCm (le_max_right a b)) (le_max_right a b)).2.2)
    exact (tk_le (credUpTo_le_cred2 ps ω τ G W (by omega)) (by omega)).2.1 this
  · -- a top, obtained by `qP2 u`: the XOR use
    obtain ⟨r1, hr1, hrt, hfirst⟩ := exists_firstAt ((mem_know_topWhole ps ω τ G W).1 hu)
    obtain ⟨r, rfl⟩ : ∃ r, r1 = r + 1 := ⟨r1 - 1, by omega⟩
    set C := credUpTo ps ω τ G W r with hC
    set C' := credUpTo ps ω τ G W (r + 1) with hC'
    have hCC' : KLe C C' := credUpTo_mono ps ω τ G W (Nat.le_succ r)
    have hfin : ∀ {s}, s ≤ r + 1 → u ∈ (timedReachK G C' s).topWhole →
        u ∈ (timedReachK G (cred2 ps ω τ G W D) t).topWhole :=
      fun hs hm => (tk_le (credUpTo_le_cred2 ps ω τ G W (by omega)) (by omega)).2.2 hm
    have hr' : r + 1 - 1 = r := by omega
    by_cases hin : u ∈ (timedReachK G C r).topWhole
    · exact hfin (Nat.le_succ r) ((timedReachK_mono_hold G hCC' r).2.2 hin)
    by_cases hK : keyTop G C (r + 1) u <;> by_cases hcols : ∀ w, avail (timedReachK G C r) w u
    · -- both available: the game's forward-top
      refine hfin le_rfl ((timedReachK_mono_hold G hCC' (r + 1)).2.2 (top_move (by omega) hK ?_))
      rwa [hr']
    · -- key available, columns missing: the missing columns are credited
      have hcols' : ∀ w, avail (timedReachK G C' r) w u := by
        intro w
        by_cases hw : avail (timedReachK G C r) w u
        · exact avail_mono (timedReachK_mono_hold G hCC' r) hw
        · refine Or.inr ((hold_le r).2.1 ((round_le ps ω τ G W r).1.2.1 ?_))
          simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
          refine ⟨by simpa using hw, Or.inr (Or.inr ⟨hfirst, by simpa using hin, hK⟩)⟩
      exact hfin le_rfl (top_move (by omega) (keyTop_mono hCC' hK) (by rwa [hr']))
    · -- columns available, key not: the key is credited
      have hkey : u ∈ C'.topKey := (round_le ps ω τ G W r).2.2 (by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨hfirst, by simpa using hin, hK, by simpa using hcols⟩)
      exact hfin le_rfl (top_move (by omega) (Or.inl hkey)
        (by rw [hr']; exact fun w => avail_mono (timedReachK_mono_hold G hCC' r) (hcols w)))
    · -- neither: top `u` is credited
      refine hfin (Nat.zero_le _) ((hold_le 0).2.2 ((round_le ps ω τ G W r).1.2.2 ?_))
      simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨by simpa using hin, Or.inr (Or.inr ⟨hfirst, hK, by simpa using hcols⟩)⟩

theorem knowledgeSim2_answered (D : ℕ) :
    (Finset.univ.filter fun u => (ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u) ⊆
      (timedReachK G (cred2 ps ω τ G W D) D).topWhole := by
  intro u hu
  have hans := (Finset.mem_filter.1 hu).2
  by_cases h : u ∈ (timedReachK G (credUpTo ps ω τ G W D) D).topWhole
  · exact (timedReachK_mono_hold G (KLe.union_left _ _) D).2.2 h
  · refine (hold_le D).2.2 (Finset.mem_union_right _ ?_)
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨hans, h⟩

end Credits

/-- **`KnowledgeSim2` holds.** -/
theorem knowledgeSim2 : KnowledgeSim2 := fun _ _ D τ G W ps ω =>
  ⟨knowledgeSim2_know ps ω τ G W D, knowledgeSim2_answered ps ω τ G W D⟩

/-! ### The probe instance now credits exactly one label -/

section ProbeOne

variable (ω : (p3ModelT 1 1).Ω)

/-- The probe's program family (one challenge). -/
noncomputable abbrev ps0 : Fin 1 → Prog (p3ModelT 1 1) (Lab 1 1) := fun _ => advOver (A₁over ω)

theorem pathG1_par (v : Fin 1) : (pathG 1).par v = ∅ := by
  ext u
  simp only [pathG, Finset.mem_filter, Finset.mem_univ, true_and, Finset.notMem_empty, iff_false]
  omega

theorem probe_asked1 (q : (p3ModelT 1 1).Qry) :
    Asked (ps0 ω) ω q 1 ↔ q ∈ [qI2 tag0 (pathG 1) W0' ω 0, Sum.inl key0] := by
  simp only [Asked, (overcredit_upTo ω).1]
  exact ⟨fun ⟨_, h⟩ => h, fun h => ⟨0, h⟩⟩

theorem probe_asked2 (q : (p3ModelT 1 1).Qry) :
    Asked (ps0 ω) ω q 2 ↔ q ∈ [qI2 tag0 (pathG 1) W0' ω 0, Sum.inl key0, qI1 tag0 (pathG 1) W0' ω 0] := by
  simp only [Asked, (overcredit_upTo ω).2]
  exact ⟨fun ⟨_, h⟩ => h, fun h => ⟨0, h⟩⟩

theorem probe_not_asked_qP1 {r : ℕ} (hr : r ≤ 2) (w : Fin 1) :
    ¬ Asked (ps0 ω) ω (qP1 tag0 (pathG 1) W0' ω w) r := fun h => by
  have h2 := (probe_asked2 ω _).1 (asked_mono hr h)
  rcases List.mem_cons.1 h2 with h2 | h2
  · unfold qP1 qI2 at h2
    cases h2
  rcases List.mem_cons.1 h2 with h2 | h2
  · cases h2
  rcases List.mem_cons.1 h2 with h2 | h2
  · unfold qP1 qI1 at h2
    cases h2
  · exact absurd h2 List.not_mem_nil

theorem probe_not_asked_qP2 {r : ℕ} (hr : r ≤ 2) (u : Fin 1) :
    ¬ Asked (ps0 ω) ω (qP2 tag0 (pathG 1) W0' ω u) r := fun h => by
  have h2 := (probe_asked2 ω _).1 (asked_mono hr h)
  rcases List.mem_cons.1 h2 with h2 | h2
  · unfold qP2 qI2 at h2
    cases h2
  rcases List.mem_cons.1 h2 with h2 | h2
  · cases h2
  rcases List.mem_cons.1 h2 with h2 | h2
  · unfold qP2 qI1 at h2
    cases h2
  · exact absurd h2 List.not_mem_nil

theorem probe_firstAt_qI2 : FirstAt (ps0 ω) ω (qI2 tag0 (pathG 1) W0' ω 0) 1 :=
  ⟨(probe_asked1 ω _).2 List.mem_cons_self, not_asked_zero⟩

theorem probe_not_firstAt_qI1_one (w : Fin 1) : ¬ FirstAt (ps0 ω) ω (qI1 tag0 (pathG 1) W0' ω w) 1 := by
  rintro ⟨h, -⟩
  rw [Subsingleton.elim w 0, probe_asked1] at h
  exact not_mem_round1_inv ω _ h

/-- Round 1 credits top `0` and nothing else. -/
theorem probe_C1 :
    (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1).hold.lowerWhole = ∅ ∧
    (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1).hold.lowerCol = ∅ ∧
    (0 : Fin 1) ∈ (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1).hold.topWhole ∧
    (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1).lowerKey = ∅ ∧
    (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1).topKey = ∅ := by
  rw [credUpTo_succ]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simp [KState.union, KState.empty, credUpTo, roundCred]
  · refine Finset.eq_empty_of_forall_notMem fun p hp => ?_
    rcases Finset.mem_union.1 hp with hp | hp
    · exact Finset.notMem_empty _ hp
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at hp
    rcases hp.2 with ⟨v, hv, -⟩ | h | ⟨h, -⟩
    · simp [pathG1_par] at hv
    · exact probe_not_firstAt_qI1_one ω _ h
    · exact probe_not_asked_qP2 ω (r := 1) (by omega) _ h.1
  · refine Finset.mem_union_right _ ?_
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
    refine ⟨?_, Or.inr (Or.inl (probe_firstAt_qI2 ω))⟩
    show (0 : Fin 1) ∉ (promote KState.empty.hold).topWhole
    simp [promote, KState.empty]
  · refine Finset.eq_empty_of_forall_notMem fun w hw => ?_
    rcases Finset.mem_union.1 hw with hw | hw
    · exact Finset.notMem_empty _ hw
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at hw
    exact probe_not_asked_qP1 ω (r := 1) (by omega) _ hw.1.1
  · refine Finset.eq_empty_of_forall_notMem fun u hu => ?_
    rcases Finset.mem_union.1 hu with hu | hu
    · exact Finset.notMem_empty _ hu
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at hu
    exact probe_not_asked_qP2 ω (r := 1) (by omega) _ hu.1.1

/-- Round 2 credits nothing: `c¹_0`'s column is already in the game (reverse at the held top). -/
theorem probe_R2 :
    (roundCred (ps0 ω) ω tag0 (pathG 1) W0' (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1) 2).hold.lowerCol = ∅ ∧
    (roundCred (ps0 ω) ω tag0 (pathG 1) W0' (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1) 2).hold.topWhole = ∅ ∧
    (roundCred (ps0 ω) ω tag0 (pathG 1) W0' (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1) 2).lowerKey = ∅ ∧
    (roundCred (ps0 ω) ω tag0 (pathG 1) W0' (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1) 2).topKey = ∅ := by
  set C1 := credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1 with hC1
  have h0 : (0 : Fin 1) ∈ C1.hold.topWhole := (probe_C1 ω).2.2.1
  have htop : ∀ t, (0 : Fin 1) ∈ (timedReachK (pathG 1) C1 t).topWhole := fun t => (hold_le t).2.2 h0
  have hcol : ∀ p : Fin 1 × Fin 1, avail (timedReachK (pathG 1) C1 1) p.1 p.2 := by
    rintro ⟨w, u⟩
    rw [Subsingleton.elim u 0]
    exact Or.inr (rev_mem (htop 0) (by simp [pathG1_par]))
  refine ⟨?_, ?_, ?_, ?_⟩
  · refine Finset.eq_empty_of_forall_notMem fun p hp => ?_
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at hp
    exact hp.1 (hcol p)
  · refine Finset.eq_empty_of_forall_notMem fun u hu => ?_
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at hu
    rw [Subsingleton.elim u 0] at hu
    exact hu.1 (htop 1)
  · refine Finset.eq_empty_of_forall_notMem fun w hw => ?_
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at hw
    exact probe_not_asked_qP1 ω le_rfl _ hw.1.1
  · refine Finset.eq_empty_of_forall_notMem fun u hu => ?_
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at hu
    exact probe_not_asked_qP2 ω le_rfl _ hu.1.1

/-- **`ProbeCredOne` holds**: the probe instance credits exactly top `0`, one label. -/
theorem probeCredOne : ProbeCredOne := by
  intro ω
  obtain ⟨hLW1, hLC1, hTW1, hLK1, hTK1⟩ := probe_C1 ω
  obtain ⟨hLC2, hTW2, hLK2, hTK2⟩ := probe_R2 ω
  set C2 := credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 2 with hC2
  have hC2eq : C2 = (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1).union
      (roundCred (ps0 ω) ω tag0 (pathG 1) W0' (credUpTo (ps0 ω) ω tag0 (pathG 1) W0' 1) 2) := rfl
  have hTW : (cred2 (ps0 ω) ω tag0 (pathG 1) W0' 2).hold.topWhole = Finset.univ := by
    refine Finset.eq_univ_of_forall fun u => ?_
    rw [Subsingleton.elim u 0]
    exact Finset.mem_union_left _ (Finset.mem_union_left _ hTW1)
  have hLW : (cred2 (ps0 ω) ω tag0 (pathG 1) W0' 2).hold.lowerWhole = ∅ := by
    show (C2.hold.lowerWhole ∪ ∅) = ∅
    rw [hC2eq]
    simp [KState.union, hLW1, roundCred]
  have hLC : (cred2 (ps0 ω) ω tag0 (pathG 1) W0' 2).hold.lowerCol = ∅ := by
    show (C2.hold.lowerCol ∪ ∅) = ∅
    rw [hC2eq]
    simp only [KState.union, hLC1, hLC2, Finset.union_empty]
  have hLK : (cred2 (ps0 ω) ω tag0 (pathG 1) W0' 2).lowerKey = ∅ := by
    show (C2.lowerKey ∪ ∅) = ∅
    rw [hC2eq]
    simp only [KState.union, hLK1, hLK2, Finset.union_empty]
  have hTK : (cred2 (ps0 ω) ω tag0 (pathG 1) W0' 2).topKey = ∅ := by
    show (C2.topKey ∪ ∅) = ∅
    rw [hC2eq]
    simp only [KState.union, hTK1, hTK2, Finset.union_empty]
  simp only [KState.size, ColState.size, hTW, hLW, hLC, hLK, hTK, Finset.card_univ, Fintype.card_fin,
    Finset.card_empty]

end ProbeOne

/-! ### The counting step -/

open Classical in
/-- **`ConsistentCompression` holds**: summing the fibres of `ω ↦ (σ, R ω, pat ω)`. -/
theorem consistentCompression : ConsistentCompression := by
  intro Ω _ m Red Pat _ _ A₁ R pat Win b hb
  classical
  let F : Ω → Bits m × Red × Pat := fun ω => (A₁ ω, R ω, pat ω)
  rw [Finset.card_eq_sum_card_fiberwise (f := F) (t := Finset.univ) (fun _ _ => Finset.mem_univ _)]
  calc ∑ y ∈ (Finset.univ : Finset (Bits m × Red × Pat)), ((Finset.univ.filter Win).filter fun ω => F ω = y).card
      ≤ ∑ _y ∈ (Finset.univ : Finset (Bits m × Red × Pat)), 2 ^ b := by
        refine Finset.sum_le_sum fun y _ => ?_
        refine le_trans (Finset.card_le_card ?_) (hb y.1 y.2.1 y.2.2)
        intro ω hω
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, F] at hω ⊢
        obtain ⟨hw, hy⟩ := hω
        rw [← hy]
        exact ⟨rfl, rfl, rfl, hw⟩
    _ = 2 ^ m * Fintype.card Red * Fintype.card Pat * 2 ^ b := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_prod, Fintype.card_prod, smul_eq_mul]
        simp only [Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
        ring

end PousKnowledge

end


/-! ════ Freshness.LuckySim ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `KnowledgeSimHits` holds (`ZeroAdvicePlan.md`, M2)

The proof of `knowledgeSim2`, with every round's game taken from the credits and the hits so far
(`Cg r = credUpTo3 r ∪ hitUnits r`). The hits only enlarge the holding, and they grow with the round
(`hitUnits_mono`), so each case of `knowledgeSim2_know` goes through unchanged.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

theorem KLe.union_mono {a a' b b' : KState n} (ha : KLe a a') (hb : KLe b b') : KLe (a.union b) (a'.union b') :=
  ⟨⟨Finset.union_subset_union ha.1.1 hb.1.1, Finset.union_subset_union ha.1.2.1 hb.1.2.1,
      Finset.union_subset_union ha.1.2.2 hb.1.2.2⟩,
    Finset.union_subset_union ha.2.1 hb.2.1, Finset.union_subset_union ha.2.2 hb.2.2⟩

section Mono

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

theorem hitsBy_mono {R R' : ℕ} (h : R ≤ R') : hitsBy ps ω τ G W R ⊆ hitsBy ps ω τ G W R' := by
  intro t ht
  simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht ⊢
  obtain ⟨r, hr, hhit⟩ := ht
  exact ⟨r, hr.trans h, hhit⟩

theorem hitUnits_mono {R R' : ℕ} (h : R ≤ R') : KLe (hitUnits ps ω τ G W R) (hitUnits ps ω τ G W R') := by
  refine ⟨⟨subset_rfl, subset_rfl, fun u hu => ?_⟩, fun w hw => ?_, subset_rfl⟩
  · simp only [hitUnits, Finset.mem_filter, Finset.mem_univ, true_and] at hu ⊢
    exact hitsBy_mono ps ω τ G W h hu
  · simp only [hitUnits, Finset.mem_filter, Finset.mem_univ, true_and] at hw ⊢
    exact hitsBy_mono ps ω τ G W h hw

/-- The holding round `r + 1` is checked against: the credits and the hits through round `r`. -/
noncomputable abbrev Cg (r : ℕ) : KState n := (credUpTo3 ps ω τ G W r).union (hitUnits ps ω τ G W r)

theorem credUpTo3_succ (r : ℕ) :
    credUpTo3 ps ω τ G W (r + 1) =
      (credUpTo3 ps ω τ G W r).union (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)) := rfl

theorem credUpTo3_mono {r s : ℕ} (h : r ≤ s) : KLe (credUpTo3 ps ω τ G W r) (credUpTo3 ps ω τ G W s) := by
  induction h with
  | refl => exact KLe.refl _
  | step _ ih => exact ih.trans (KLe.union_left _ _)

theorem Cg_mono {r s : ℕ} (h : r ≤ s) : KLe (Cg ps ω τ G W r) (Cg ps ω τ G W s) :=
  KLe.union_mono (credUpTo3_mono ps ω τ G W h) (hitUnits_mono ps ω τ G W h)

/-- Round `r + 1`'s credits land in `Cg (r + 1)`. -/
theorem round3_le (r : ℕ) : KLe (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)) (Cg ps ω τ G W (r + 1)) :=
  (KLe.union_right _ _).trans (KLe.union_left _ _)

/-- The final holding `cred3 D ∪ hits D`. -/
noncomputable abbrev Cfin (D : ℕ) : KState n := (cred3 ps ω τ G W D).union (hitUnits ps ω τ G W D)

theorem Cg_le_fin {r D : ℕ} (h : r ≤ D) : KLe (Cg ps ω τ G W r) (Cfin ps ω τ G W D) :=
  KLe.union_mono ((credUpTo3_mono ps ω τ G W h).trans (KLe.union_left _ _)) (hitUnits_mono ps ω τ G W h)

/-- A top credited at round `r + 1` is in the game from `Cg (r + 1)` at `r`. -/
theorem top_used3 {r : ℕ} {u : Fin n}
    (hcred : u ∉ (timedReachK G (Cg ps ω τ G W r) r).topWhole →
      u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).hold.topWhole) :
    u ∈ (timedReachK G (Cg ps ω τ G W (r + 1)) r).topWhole := by
  by_cases h : u ∈ (timedReachK G (Cg ps ω τ G W r) r).topWhole
  · exact (timedReachK_mono_hold G (Cg_mono ps ω τ G W (Nat.le_succ r)) r).2.2 h
  · exact (hold_le r).2.2 ((round3_le ps ω τ G W r).1.2.2 (hcred h))

end Mono

section Sim

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

theorem knowledgeSimHits_know (D : ℕ) :
    ∀ t ≤ D, Le (know ps ω τ G W t) (timedReachK G (Cfin ps ω τ G W D) t) := by
  intro t htD
  refine ⟨fun w hw => ?_, fun p hp => ?_, fun u hu => ?_⟩
  · -- a lower label, obtained by `qP1 w`
    obtain ⟨r1, hr1, hrt, hfirst⟩ := exists_firstAt ((mem_know_lowerWhole ps ω τ G W).1 hw)
    obtain ⟨r, rfl⟩ : ∃ r, r1 = r + 1 := ⟨r1 - 1, by omega⟩
    set C := Cg ps ω τ G W r with hC
    have hfin : ∀ {c : KState n}, KLe c (Cg ps ω τ G W (r + 1)) → ∀ {s}, s ≤ r + 1 →
        w ∈ (timedReachK G c s).lowerWhole → w ∈ (timedReachK G (Cfin ps ω τ G W D) t).lowerWhole :=
      fun hc s hs hm => (tk_le (hc.trans (Cg_le_fin ps ω τ G W (by omega))) (by omega)).1 hm
    by_cases hin : w ∈ (timedReachK G C r).lowerWhole
    · exact hfin (Cg_mono ps ω τ G W (Nat.le_succ r)) (Nat.le_succ r) hin
    by_cases hk : keyLow G C (r + 1) w
    · exact hfin (Cg_mono ps ω τ G W (Nat.le_succ r)) le_rfl (lower_move (by omega) hk)
    · have hkey : w ∈ (Cg ps ω τ G W (r + 1)).lowerKey := (round3_le ps ω τ G W r).2.1 (by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨hfirst, by simpa using hin, hk⟩)
      exact hfin (KLe.refl _) le_rfl (lowerKey_mem (by omega) hkey)
  · -- columns `(·, u)`, obtained by `qI2 u` and `qH2 u`
    obtain ⟨hI, hH⟩ := (mem_know_lowerCol ps ω τ G W).1 hp
    obtain ⟨r1, h11, h1t, hfirst₁⟩ := exists_firstAt hI
    obtain ⟨r2, h21, h2t, hfirst₂⟩ := exists_firstAt hH
    obtain ⟨a, rfl⟩ : ∃ a, r1 = a + 1 := ⟨r1 - 1, by omega⟩
    obtain ⟨b, rfl⟩ : ∃ b, r2 = b + 1 := ⟨r2 - 1, by omega⟩
    have htop : p.2 ∈ (timedReachK G (Cg ps ω τ G W (a + 1)) a).topWhole :=
      top_used3 ps ω τ G W fun h => by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨h, Or.inr (Or.inl hfirst₁)⟩
    have hpar : G.par p.2 ⊆ (timedReachK G (Cg ps ω τ G W (b + 1)) b).topWhole := fun v hv =>
      top_used3 ps ω τ G W fun h => by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨h, Or.inl ⟨p.2, hv, hfirst₂⟩⟩
    set m := max a b
    have hCm : ∀ {x}, x ≤ m → KLe (Cg ps ω τ G W (x + 1)) (Cg ps ω τ G W (m + 1)) :=
      fun hx => Cg_mono ps ω τ G W (by omega)
    have := rev_mem (w := p.1) ((tk_le (hCm (le_max_left a b)) (le_max_left a b)).2.2 htop)
      (hpar.trans (tk_le (hCm (le_max_right a b)) (le_max_right a b)).2.2)
    exact (tk_le (Cg_le_fin ps ω τ G W (by omega)) (by omega)).2.1 this
  · -- a top, obtained by `qP2 u`: the XOR use
    obtain ⟨r1, hr1, hrt, hfirst⟩ := exists_firstAt ((mem_know_topWhole ps ω τ G W).1 hu)
    obtain ⟨r, rfl⟩ : ∃ r, r1 = r + 1 := ⟨r1 - 1, by omega⟩
    set C := Cg ps ω τ G W r with hC
    set C' := Cg ps ω τ G W (r + 1) with hC'
    have hCC' : KLe C C' := Cg_mono ps ω τ G W (Nat.le_succ r)
    have hfin : ∀ {s}, s ≤ r + 1 → u ∈ (timedReachK G C' s).topWhole →
        u ∈ (timedReachK G (Cfin ps ω τ G W D) t).topWhole :=
      fun hs hm => (tk_le (Cg_le_fin ps ω τ G W (by omega)) (by omega)).2.2 hm
    have hr' : r + 1 - 1 = r := by omega
    by_cases hin : u ∈ (timedReachK G C r).topWhole
    · exact hfin (Nat.le_succ r) ((timedReachK_mono_hold G hCC' r).2.2 hin)
    by_cases hK : keyTop G C (r + 1) u <;> by_cases hcols : ∀ w, avail (timedReachK G C r) w u
    · -- both available: the game's forward-top
      refine hfin le_rfl ((timedReachK_mono_hold G hCC' (r + 1)).2.2 (top_move (by omega) hK ?_))
      rwa [hr']
    · -- key available, columns missing: the missing columns are credited
      have hcols' : ∀ w, avail (timedReachK G C' r) w u := by
        intro w
        by_cases hw : avail (timedReachK G C r) w u
        · exact avail_mono (timedReachK_mono_hold G hCC' r) hw
        · refine Or.inr ((hold_le r).2.1 ((round3_le ps ω τ G W r).1.2.1 ?_))
          simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
          refine ⟨by simpa using hw, Or.inr (Or.inr ⟨hfirst, by simpa using hin, hK⟩)⟩
      exact hfin le_rfl (top_move (by omega) (keyTop_mono hCC' hK) (by rwa [hr']))
    · -- columns available, key not: the key is credited
      have hkey : u ∈ C'.topKey := (round3_le ps ω τ G W r).2.2 (by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨hfirst, by simpa using hin, hK, by simpa using hcols⟩)
      exact hfin le_rfl (top_move (by omega) (Or.inl hkey)
        (by rw [hr']; exact fun w => avail_mono (timedReachK_mono_hold G hCC' r) (hcols w)))
    · -- neither: top `u` is credited
      refine hfin (Nat.zero_le _) ((hold_le 0).2.2 ((round3_le ps ω τ G W r).1.2.2 ?_))
      simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨by simpa using hin, Or.inr (Or.inr ⟨hfirst, hK, by simpa using hcols⟩)⟩

theorem knowledgeSimHits_answered (D : ℕ) :
    (Finset.univ.filter fun u => (ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u) ⊆
      (timedReachK G (Cfin ps ω τ G W D) D).topWhole := by
  intro u hu
  have hans := (Finset.mem_filter.1 hu).2
  by_cases h : u ∈ (timedReachK G (Cg ps ω τ G W D) D).topWhole
  · exact (timedReachK_mono_hold G (Cg_le_fin ps ω τ G W le_rfl) D).2.2 h
  · refine (hold_le D).2.2 (Finset.mem_union_left _ (Finset.mem_union_right _ ?_))
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨hans, h⟩

end Sim

/-- **`KnowledgeSimHits` holds** (§29, point 1). -/
theorem knowledgeSimHits : KnowledgeSimHits := fun _ _ D τ G W ps ω =>
  ⟨knowledgeSimHits_know ps ω τ G W D, knowledgeSimHits_answered ps ω τ G W D⟩

end PousKnowledge

end


/-! ════ Freshness.LuckySlots ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Slots, the lucky set and its bits (`ZeroAdvicePlan.md`, M3)

A slot `(c, j) : ℕ × ℕ` is program `c`'s `j`-th query (`j < Q`), or its output (`j = Q`). The lucky set `luckySet` holds:
- the first-ask slot of every honest query asked (`6n` honest queries);
- the first-ask slot of every hit (`2n` tweaks);
- the output slot of every credited final answer (`n`).
So `|luckySet| ≤ 9n` (`card_luckySet_le`). The first-ask slot of `q` is at its first round, in the least program that
asks it then. `luckyBits = wc · |cred3 D| + n·wc · #hits`.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

/-- The `6n` honest queries of a segment, by kind. -/
def honestQ (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω) :
    Fin 6 × Fin n → (p3ModelT n wc).Qry
  | (0, v) => qH1 τ G W ω v
  | (1, v) => qH2 τ G W ω v
  | (2, v) => qP1 τ G W ω v
  | (3, v) => qP2 τ G W ω v
  | (4, v) => qI1 τ G W ω v
  | (5, v) => qI2 τ G W ω v

section Slots

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)

open Classical in
/-- The first round in which `q` is asked (`0` if never). -/
noncomputable def firstRound (q : (p3ModelT n wc).Qry) : ℕ :=
  if h : ∃ r, Asked ps ω q r then Nat.find h else 0

open Classical in
/-- The programs asking `q` within their first `r` rounds. -/
noncomputable def askers (q : (p3ModelT n wc).Qry) (r : ℕ) : Finset (Fin n) :=
  Finset.univ.filter fun c => q ∈ upTo ((p3ModelT n wc).answer ω) (ps c) r

open Classical in
/-- The first-ask slot of `q`: the least program asking it in its first round, and its index there. -/
noncomputable def slotOf (q : (p3ModelT n wc).Qry) : ℕ × ℕ :=
  if h : (askers ps ω q (firstRound ps ω q)).Nonempty then
    (((askers ps ω q (firstRound ps ω q)).min' h : Fin n),
      (progTrace ((p3ModelT n wc).answer ω) (ps ((askers ps ω q (firstRound ps ω q)).min' h))).idxOf q)
  else (0, 0)

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

open Classical in
/-- The final answers `cred3` credits: correct, and not in the game from the credits and hits at `D`. -/
noncomputable def creditedOut (D : ℕ) : Finset (Fin n) :=
  Finset.univ.filter fun u => (ps u).run ((p3ModelT n wc).answer ω) = c2 τ G W ω u ∧
    u ∉ (timedReachK G ((credUpTo3 ps ω τ G W D).union (hitUnits ps ω τ G W D)) D).topWhole

open Classical in
/-- **The lucky set**: honest first-asks, hits, and credited outputs (at index `Q`). -/
noncomputable def luckySet (D Q : ℕ) : Finset (ℕ × ℕ) :=
  ((Finset.univ.filter fun h : Fin 6 × Fin n => ∃ r, Asked ps ω (honestQ τ G W ω h) r).image
      fun h => slotOf ps ω (honestQ τ G W ω h)) ∪
    (hitsBy ps ω τ G W D).image (fun t => slotOf ps ω (qHit τ G W ω t)) ∪
    (creditedOut ps ω τ G W D).image (fun c : Fin n => ((c : ℕ), Q))

/-- **The hit slots**: the lucky slots that are hits. With `luckySet`, this is the typed class of `ω` (a forward slot
is honest or a hit). -/
noncomputable def hitSlotSet (D : ℕ) : Finset (ℕ × ℕ) :=
  (hitsBy ps ω τ G W D).image (fun t => slotOf ps ω (qHit τ G W ω t))

theorem hitSlotSet_subset (D Q : ℕ) : hitSlotSet ps ω τ G W D ⊆ luckySet ps ω τ G W D Q := by
  intro s hs
  unfold luckySet
  exact Finset.mem_union_left _ (Finset.mem_union_right _ hs)

/-- **The lucky bits**: `wc` per credited unit, `n·wc` per hit. -/
noncomputable def luckyBits (D : ℕ) : ℕ :=
  wc * (cred3 ps ω τ G W D).size + n * wc * (hitsBy ps ω τ G W D).card

/-- **`|luckySet| ≤ 9n`.** -/
theorem card_luckySet_le (D Q : ℕ) : (luckySet ps ω τ G W D Q).card ≤ 9 * n := by
  classical
  unfold luckySet
  refine (Finset.card_union_le _ _).trans ?_
  have h1 := (Finset.card_union_le
    ((Finset.univ.filter fun h : Fin 6 × Fin n => ∃ r, Asked ps ω (honestQ τ G W ω h) r).image
      fun h => slotOf ps ω (honestQ τ G W ω h))
    ((hitsBy ps ω τ G W D).image (fun t => slotOf ps ω (qHit τ G W ω t))))
  have h2 : ((Finset.univ.filter fun h : Fin 6 × Fin n => ∃ r, Asked ps ω (honestQ τ G W ω h) r).image
      fun h => slotOf ps ω (honestQ τ G W ω h)).card ≤ 6 * n :=
    Finset.card_image_le.trans ((Finset.card_filter_le _ _).trans (by simp))
  have h3 : ((hitsBy ps ω τ G W D).image (fun t => slotOf ps ω (qHit τ G W ω t))).card ≤ 2 * n :=
    Finset.card_image_le.trans ((Finset.card_le_univ _).trans (by simp))
  have h4 : ((creditedOut ps ω τ G W D).image (fun c : Fin n => ((c : ℕ), Q))).card ≤ n :=
    Finset.card_image_le.trans ((Finset.card_le_univ _).trans (by simp))
  omega

/-! ### The lucky set lies in the `n·(Q+1)` slots -/

theorem mem_progTrace_of_mem_upTo {M : IdealModel} {α : Type} {f : M.Qry → M.Ans} {p : Prog M α} {t : ℕ}
    {q : M.Qry} (h : q ∈ upTo f p t) : q ∈ progTrace f p := by
  rw [progTrace_eq_flatten]
  obtain ⟨l, hl, hq⟩ := List.mem_flatten.1 h
  exact List.mem_flatten.2 ⟨l, List.mem_of_mem_take hl, hq⟩

theorem asked_firstRound {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked ps ω q r) :
    Asked ps ω q (firstRound ps ω q) := by
  classical
  unfold firstRound
  rw [dif_pos h]
  exact Nat.find_spec h

theorem slotOf_mem {D Q : ℕ} (hb : ∀ c, (ps c).Bounded D Q) {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked ps ω q r) :
    slotOf ps ω q ∈ Finset.range n ×ˢ Finset.range (Q + 1) := by
  classical
  have hne : (askers ps ω q (firstRound ps ω q)).Nonempty := by
    obtain ⟨c, hc⟩ := asked_firstRound ps ω h
    exact ⟨c, by simp [askers, hc]⟩
  unfold slotOf
  rw [dif_pos hne]
  set c := (askers ps ω q (firstRound ps ω q)).min' hne
  have hc : q ∈ upTo ((p3ModelT n wc).answer ω) (ps c) (firstRound ps ω q) := by
    exact (Finset.mem_filter.1 (Finset.min'_mem _ hne)).2
  have hmem := mem_progTrace_of_mem_upTo hc
  have hidx := List.idxOf_lt_length_of_mem hmem
  rw [progTrace_length] at hidx
  have hw := (hb c ω).2
  simp only [Finset.mem_product, Finset.mem_range]
  exact ⟨c.isLt, by omega⟩

theorem luckySet_subset {D Q : ℕ} (hb : ∀ c, (ps c).Bounded D Q) :
    luckySet ps ω τ G W D Q ⊆ Finset.range n ×ˢ Finset.range (Q + 1) := by
  intro s hs
  simp only [luckySet, Finset.mem_union, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and] at hs
  rcases hs with (⟨h, hask, rfl⟩ | ⟨t, ht, rfl⟩) | ⟨c, -, rfl⟩
  · exact slotOf_mem ps ω hb hask
  · simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht
    obtain ⟨r, -, hhit, -⟩ := ht
    exact slotOf_mem ps ω hb ⟨r, hhit.1⟩
  · simp only [Finset.mem_product, Finset.mem_range]
    exact ⟨c.isLt, by omega⟩

/-! ### Coverage: a winner's lucky bits pay for the saving -/

theorem KState.size_union_le (a b : KState n) : (a.union b).size ≤ a.size + b.size := by
  simp only [KState.size, ColState.size, KState.union]
  have e1 := Nat.mul_le_mul_left n (Finset.card_union_le a.hold.lowerWhole b.hold.lowerWhole)
  have e2 := Finset.card_union_le a.hold.lowerCol b.hold.lowerCol
  have e3 := Nat.mul_le_mul_left n (Finset.card_union_le a.hold.topWhole b.hold.topWhole)
  have e4 := Nat.mul_le_mul_left n (Finset.card_union_le a.lowerKey b.lowerKey)
  have e5 := Nat.mul_le_mul_left n (Finset.card_union_le a.topKey b.topKey)
  rw [mul_add] at e1 e3 e4 e5
  linarith

theorem size_hitUnits_le (R : ℕ) : (hitUnits ps ω τ G W R).size ≤ n * (hitsBy ps ω τ G W R).card := by
  classical
  set H := hitsBy ps ω τ G W R
  set A := Finset.univ.filter fun u : Fin n => ((1 : Fin 2), u) ∈ H
  set B := Finset.univ.filter fun w : Fin n => ((0 : Fin 2), w) ∈ H
  have hA : A.image (fun u => ((1 : Fin 2), u)) ⊆ H := by
    intro x hx
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.1 hx
    simpa [A] using hu
  have hB : B.image (fun w => ((0 : Fin 2), w)) ⊆ H := by
    intro x hx
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.1 hx
    simpa [B] using hw
  have hdisj : Disjoint (A.image fun u => ((1 : Fin 2), u)) (B.image fun w => ((0 : Fin 2), w)) := by
    rw [Finset.disjoint_left]
    intro x hx hx'
    obtain ⟨u, -, rfl⟩ := Finset.mem_image.1 hx
    obtain ⟨w, -, hw⟩ := Finset.mem_image.1 hx'
    simp at hw
  have hcA : (A.image fun u => ((1 : Fin 2), u)).card = A.card :=
    Finset.card_image_of_injective _ fun x y h => by simpa using h
  have hcB : (B.image fun w => ((0 : Fin 2), w)).card = B.card :=
    Finset.card_image_of_injective _ fun x y h => by simpa using h
  have hsum : A.card + B.card ≤ H.card := by
    rw [← hcA, ← hcB, ← Finset.card_union_of_disjoint hdisj]
    exact Finset.card_le_card (Finset.union_subset hA hB)
  have hsz : (hitUnits ps ω τ G W R).size = n * A.card + n * B.card := by
    simp [hitUnits, KState.size, ColState.size, A, B, H]
  rw [hsz, ← mul_add]
  exact Nat.mul_le_mul_left n hsum

/-- **Coverage.** A family answering `≥ k` tops correctly, against `ColumnHard G D k X`, has
`(k − X)·n·wc ≤ luckyBits`. -/
theorem luckyBits_ge {D k X : ℕ} (hard : ColumnHard G D k X)
    (hwin : k ≤ (Finset.univ.filter fun v => (ps v).run ((p3ModelT n wc).answer ω) = c2 τ G W ω v).card) :
    (k - X) * (n * wc) ≤ luckyBits ps ω τ G W D := by
  have hk : k ≤ (timedReachK G (Cfin ps ω τ G W D) D).topWhole.card :=
    hwin.trans (Finset.card_le_card (knowledgeSimHits_answered ps ω τ G W D))
  have hcov := columnHard_timedK G _ hard hk
  have hsz := (KState.size_union_le (cred3 ps ω τ G W D) (hitUnits ps ω τ G W D)).trans
    (Nat.add_le_add_left (size_hitUnits_le ps ω τ G W D) _)
  have h := Nat.mul_le_mul_right wc (hcov.trans hsz)
  unfold luckyBits
  calc (k - X) * (n * wc) = (k - X) * n * wc := by ring
    _ ≤ ((cred3 ps ω τ G W D).size + n * (hitsBy ps ω τ G W D).card) * wc := h
    _ = wc * (cred3 ps ω τ G W D).size + n * wc * (hitsBy ps ω τ G W D).card := by ring

end Slots

end PousKnowledge

end


/-! ════ Freshness.LuckyChain ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The counting chain (`ZeroAdvicePlan.md` §5b, M8c; model-free)

Variables `X ℓ : Ω → V`, `ℓ = 0, 1, …`, each with a pool `P ℓ ω` and a pin set `A ℓ ω` determined by the earlier
variables (`PrefixDet`). The fibre condition `Fibre` says each value takes at most a `1/P` share of every prefix
class. Then pins pay: `Σ_ω Π_{ℓ<m} w ℓ ω ≤ |Ω|` (`chain_sum_le`), where `w ℓ ω = P/|A|` if `X ℓ ω ∈ A ℓ ω` and `0`
otherwise.

The proof peels the last variable. The earlier weights are constant on its prefix class (`avg_le`), and the last
weight averages to `≤ 1` there (`class_sum_w_le`).
-/

namespace PousLuckyChain

open Classical

variable {Ω V : Type} [Fintype Ω] [DecidableEq V]

/-- `ω` and `ω'` agree on the variables before `ℓ`. -/
def PrefixEq (X : ℕ → Ω → V) (ℓ : ℕ) (ω ω' : Ω) : Prop := ∀ i < ℓ, X i ω = X i ω'

/-- The prefix class of `ω` before `ℓ`. -/
noncomputable def cls (X : ℕ → Ω → V) (ℓ : ℕ) (ω : Ω) : Finset Ω := Finset.univ.filter (PrefixEq X ℓ ω)

theorem mem_cls {X : ℕ → Ω → V} {ℓ : ℕ} {ω ω' : Ω} : ω' ∈ cls X ℓ ω ↔ PrefixEq X ℓ ω ω' := by
  simp [cls]

theorem prefixEq_symm {X : ℕ → Ω → V} {ℓ : ℕ} {ω ω' : Ω} (h : PrefixEq X ℓ ω ω') : PrefixEq X ℓ ω' ω :=
  fun i hi => (h i hi).symm

theorem cls_eq {X : ℕ → Ω → V} {ℓ : ℕ} {ω ω' : Ω} (h : PrefixEq X ℓ ω ω') : cls X ℓ ω' = cls X ℓ ω := by
  ext ω''
  simp only [mem_cls, PrefixEq]
  exact ⟨fun h' i hi => (h i hi).trans (h' i hi), fun h' i hi => (h i hi).symm.trans (h' i hi)⟩

/-- **Averaging over prefix classes.** If `g ≥ 0` is constant on the classes and `h ≥ 0` sums to at most the class
size on every class, then `Σ g·h ≤ Σ g`. -/
theorem avg_le (X : ℕ → Ω → V) (ℓ : ℕ) (g h : Ω → ℝ) (hg0 : ∀ ω, 0 ≤ g ω) (hh0 : ∀ ω, 0 ≤ h ω)
    (hg : ∀ ω ω', PrefixEq X ℓ ω ω' → g ω = g ω')
    (hcls : ∀ ω, ∑ ω' ∈ cls X ℓ ω, h ω' ≤ (cls X ℓ ω).card) :
    ∑ ω, g ω * h ω ≤ ∑ ω, g ω := by
  have hpos : ∀ ω, (0 : ℝ) < (cls X ℓ ω).card := fun ω => by
    exact_mod_cast Finset.card_pos.2 ⟨ω, mem_cls.2 fun _ _ => rfl⟩
  have key : ∑ ω, g ω * h ω = ∑ ω, g ω / (cls X ℓ ω).card * ∑ ω' ∈ cls X ℓ ω, h ω' := by
    calc ∑ ω, g ω * h ω
        = ∑ ω, ∑ ω' ∈ cls X ℓ ω, g ω' / (cls X ℓ ω').card * h ω := by
          refine Finset.sum_congr rfl fun ω _ => ?_
          have : ∀ ω' ∈ cls X ℓ ω, g ω' / (cls X ℓ ω').card * h ω = g ω / (cls X ℓ ω).card * h ω := by
            intro ω' hω'
            have hp := mem_cls.1 hω'
            rw [hg ω ω' hp, cls_eq hp]
          rw [Finset.sum_congr rfl this, Finset.sum_const, nsmul_eq_mul]
          field_simp [(hpos ω).ne']
      _ = ∑ ω', ∑ ω ∈ cls X ℓ ω', g ω' / (cls X ℓ ω').card * h ω := by
          rw [Finset.sum_comm' (t' := Finset.univ) (s' := fun ω' => cls X ℓ ω')]
          intro ω ω'
          simp only [Finset.mem_univ, true_and, and_true, mem_cls]
          exact ⟨prefixEq_symm, prefixEq_symm⟩
      _ = ∑ ω, g ω / (cls X ℓ ω).card * ∑ ω' ∈ cls X ℓ ω, h ω' := by
          refine Finset.sum_congr rfl fun ω _ => ?_
          rw [Finset.mul_sum]
  rw [key]
  refine Finset.sum_le_sum fun ω _ => ?_
  have hq : 0 ≤ g ω / (cls X ℓ ω).card := div_nonneg (hg0 ω) (hpos ω).le
  calc g ω / (cls X ℓ ω).card * ∑ ω' ∈ cls X ℓ ω, h ω' ≤ g ω / (cls X ℓ ω).card * (cls X ℓ ω).card :=
        mul_le_mul_of_nonneg_left (hcls ω) hq
    _ = g ω := by field_simp [(hpos ω).ne']

/-- Pools and pin sets are determined by the earlier variables. -/
def PrefixDet (X : ℕ → Ω → V) (P : ℕ → Ω → ℕ) (A : ℕ → Ω → Finset V) : Prop :=
  ∀ ℓ ω ω', PrefixEq X ℓ ω ω' → P ℓ ω = P ℓ ω' ∧ A ℓ ω = A ℓ ω'

/-- **The fibre condition**: in every prefix class, each value of `X ℓ` has at most a `1/P` share. -/
def Fibre (X : ℕ → Ω → V) (P : ℕ → Ω → ℕ) : Prop :=
  ∀ ℓ ω a, ((cls X ℓ ω).filter fun ω' => X ℓ ω' = a).card * P ℓ ω ≤ (cls X ℓ ω).card

/-- The weight of pin `ℓ`: `P/|A|` if pinned, else `0`. -/
noncomputable def w (X : ℕ → Ω → V) (P : ℕ → Ω → ℕ) (A : ℕ → Ω → Finset V) (ℓ : ℕ) (ω : Ω) : ℝ :=
  if X ℓ ω ∈ A ℓ ω then (P ℓ ω : ℝ) / (A ℓ ω).card else 0

theorem w_nonneg (X : ℕ → Ω → V) (P : ℕ → Ω → ℕ) (A : ℕ → Ω → Finset V) (ℓ : ℕ) (ω : Ω) :
    0 ≤ w X P A ℓ ω := by
  unfold w; split_ifs <;> positivity

/-- A pin's weight averages to at most `1` on its prefix class. -/
theorem class_sum_w_le (X : ℕ → Ω → V) (P : ℕ → Ω → ℕ) (A : ℕ → Ω → Finset V) (hdet : PrefixDet X P A)
    (hfib : Fibre X P) (ℓ : ℕ) (ω : Ω) :
    ∑ ω' ∈ cls X ℓ ω, w X P A ℓ ω' ≤ (cls X ℓ ω).card := by
  have hPA : ∀ ω' ∈ cls X ℓ ω, P ℓ ω' = P ℓ ω ∧ A ℓ ω' = A ℓ ω := fun ω' h => by
    obtain ⟨h1, h2⟩ := hdet ℓ ω ω' (mem_cls.1 h)
    exact ⟨h1.symm, h2.symm⟩
  rcases (A ℓ ω).eq_empty_or_nonempty with hA | hA
  · have : ∀ ω' ∈ cls X ℓ ω, w X P A ℓ ω' = 0 := fun ω' h => by
      unfold w; rw [(hPA ω' h).2, hA]; simp
    rw [Finset.sum_congr rfl this, Finset.sum_const_zero]
    positivity
  have hcard : (0 : ℝ) < (A ℓ ω).card := by exact_mod_cast Finset.card_pos.2 hA
  have heq : ∑ ω' ∈ cls X ℓ ω, w X P A ℓ ω' =
      ∑ a ∈ A ℓ ω, ((cls X ℓ ω).filter fun ω' => X ℓ ω' = a).card * ((P ℓ ω : ℝ) / (A ℓ ω).card) := by
    have hw : ∀ ω' ∈ cls X ℓ ω, w X P A ℓ ω' =
        ∑ a ∈ A ℓ ω, if X ℓ ω' = a then (P ℓ ω : ℝ) / (A ℓ ω).card else 0 := by
      intro ω' h
      unfold w
      rw [(hPA ω' h).1, (hPA ω' h).2, Finset.sum_ite_eq]
    rw [Finset.sum_congr rfl hw, Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  rw [heq]
  calc ∑ a ∈ A ℓ ω, (((cls X ℓ ω).filter fun ω' => X ℓ ω' = a).card : ℝ) * ((P ℓ ω : ℝ) / (A ℓ ω).card)
      ≤ ∑ _a ∈ A ℓ ω, ((cls X ℓ ω).card : ℝ) / (A ℓ ω).card := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [← mul_div_assoc]
        refine div_le_div_of_nonneg_right ?_ hcard.le
        exact_mod_cast hfib ℓ ω a
    _ = (cls X ℓ ω).card := by
        rw [Finset.sum_const, nsmul_eq_mul]
        field_simp [hcard.ne']

/-- **The chain lemma**: `Σ_ω Π_{ℓ<m} w ℓ ω ≤ |Ω|`. -/
theorem chain_sum_le (X : ℕ → Ω → V) (P : ℕ → Ω → ℕ) (A : ℕ → Ω → Finset V) (hdet : PrefixDet X P A)
    (hfib : Fibre X P) : ∀ m, ∑ ω, ∏ ℓ ∈ Finset.range m, w X P A ℓ ω ≤ Fintype.card Ω
  | 0 => by simp
  | m + 1 => by
    have hconst : ∀ ω ω', PrefixEq X m ω ω' →
        ∏ ℓ ∈ Finset.range m, w X P A ℓ ω = ∏ ℓ ∈ Finset.range m, w X P A ℓ ω' := by
      intro ω ω' h
      refine Finset.prod_congr rfl fun ℓ hℓ => ?_
      have hℓ' := Finset.mem_range.1 hℓ
      have hpre : PrefixEq X ℓ ω ω' := fun i hi => h i (hi.trans hℓ')
      obtain ⟨h1, h2⟩ := hdet ℓ ω ω' hpre
      unfold w
      rw [h ℓ hℓ', h1, h2]
    calc ∑ ω, ∏ ℓ ∈ Finset.range (m + 1), w X P A ℓ ω
        = ∑ ω, (∏ ℓ ∈ Finset.range m, w X P A ℓ ω) * w X P A m ω := by
          refine Finset.sum_congr rfl fun ω _ => ?_
          rw [Finset.prod_range_succ]
      _ ≤ ∑ ω, ∏ ℓ ∈ Finset.range m, w X P A ℓ ω :=
          avg_le X m _ _ (fun ω => Finset.prod_nonneg fun ℓ _ => w_nonneg X P A ℓ ω) (w_nonneg X P A m)
            hconst (class_sum_w_le X P A hdet hfib m)
      _ ≤ Fintype.card Ω := chain_sum_le X P A hdet hfib m

end PousLuckyChain

end


/-! ════ Freshness.LuckyHyp ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The lucky-guess target and its open named lemma (`ZeroAdvicePlan.md`, M5)

**`ZeroAdviceLucky`** is `ZeroAdvice` at `pos = 10n`, restricted to `0 < n`, `2^15 ≤ Q` and
`64·n·Q_tot ≤ 2^{n·wc}` (plan §1: F1 needs the pool hypothesis, and F2 needs `10n` at large `Q`). The restriction is
`okLucky`, and the chain to `n10prime` is stated for any restriction `ok` (`…If`).

**`AdaptiveMinEntropy`** (§29, point 4) is the one open step. For every bounded program family and every slot set `S`,
`(Σ_{ω : luckySet ω = S} 2^{luckyBits ω}) · (M − 2·Q_tot)^{|S|} ≤ (2M)^{|S|} · |Ω|`, with `M = 2^{n·wc}`. The factor
`2` per slot is the two lucky targets of a forward query (F2), and `M/(M − 2·Q_tot)` per slot is the pool (F1).
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge
open scoped ENNReal

/-- `n10prime`'s statement at `pos n`, for the instances `ok n wc Q` admits. -/
def N10primeAtIf (ok : ℕ → ℕ → ℕ → Prop) (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc m D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc),
    ok n wc Q → 0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X →
    ∀ (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    (∀ σ c, (A₂ σ c).Bounded D Q) →
    pr (fun ω : (p3ModelT n wc).Ω =>
        k ≤ (Finset.univ.filter fun v =>
          (A₂ (A₁ ω) v).run ((p3ModelT n wc).answer ω) = topLabelT tag G W ω v).card)
      ≤ N10primeBoundT 1 m n wc (n * (Q + 1) + 2 * n) (pos n) (k - X)
        + (((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

/-- The per-advice count, for the instances `ok` admits. -/
def AdviceBoundIf (ok : ℕ → ℕ → ℕ → Prop) (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc m D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (A₁ : (p3ModelT n wc).Ω → Bits m) (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    ok n wc Q → 0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X → (∀ σ c, (A₂ σ c).Bounded D Q) →
    ∀ σ : Bits m, advWinners k tag G W A₁ A₂ σ * 2 ^ ((k - X) * (n * wc)) ≤
      Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n) * Fintype.card (p3ModelT n wc).Ω

open Classical in
/-- The zero-advice core, for the instances `ok` admits. -/
def ZeroAdviceIf (ok : ℕ → ℕ → ℕ → Prop) (pos : ℕ → ℕ) : Prop :=
  ∀ (n wc D Q k X : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    ok n wc Q → 0 < wc → X ≤ k → ColumnHard G (gameDepth D) k X → (∀ c, (p c).Bounded D Q) →
    (Finset.univ.filter fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω).card * 2 ^ ((k - X) * (n * wc)) ≤
      Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n) * Fintype.card (p3ModelT n wc).Ω

/-- The instances the lucky-guess argument covers: `0 < n`, `2^15 ≤ Q`, and the pool `64·n·Q_tot ≤ 2^{n·wc}`. -/
def okLucky (n wc Q : ℕ) : Prop :=
  0 < n ∧ 2 ^ 15 ≤ Q ∧ 64 * n * (n * (Q + 1) + 2 * n) ≤ 2 ^ (n * wc)

/-- The lucky-guess positions: `10n`. -/
def posLucky (n : ℕ) : ℕ := 10 * n

/-- **The target**: the zero-advice core at `10n`, on the instances `okLucky` admits. -/
def ZeroAdviceLucky : Prop := ZeroAdviceIf okLucky posLucky

open Classical in
/-- **`AdaptiveMinEntropy`** (§29, point 4; open). -/
def AdaptiveMinEntropy : Prop :=
  ∀ (n wc D Q : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)), (∀ c, (p c).Bounded D Q) →
    ∀ S : Finset (ℕ × ℕ),
      (∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S), 2 ^ luckyBits p ω tag G W D) *
          (2 ^ (n * wc) - 2 * (n * (Q + 1) + 2 * n)) ^ S.card ≤
        (2 * 2 ^ (n * wc)) ^ S.card * Fintype.card (p3ModelT n wc).Ω

open Classical in
/-- **`AdaptiveMinEntropyPool`**: `AdaptiveMinEntropy` on the instances with `0 < n` and the pool
`64·n·Q_tot ≤ 2^{n·wc}`, which is all `ZeroAdviceLucky` uses. Pool losses accrue per pinned variable, not per slot, so
this is the form the proof (`CreditResolved`) reaches. `AdaptiveMinEntropy` implies it (`LuckyGlue.lean`). -/
def AdaptiveMinEntropyPool : Prop :=
  ∀ (n wc D Q : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)), 0 < n →
    64 * n * (n * (Q + 1) + 2 * n) ≤ 2 ^ (n * wc) → (∀ c, (p c).Bounded D Q) →
    ∀ S : Finset (ℕ × ℕ),
      (∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S), 2 ^ luckyBits p ω tag G W D) *
          (2 ^ (n * wc) - 2 * (n * (Q + 1) + 2 * n)) ^ S.card ≤
        (2 * 2 ^ (n * wc)) ^ S.card * Fintype.card (p3ModelT n wc).Ω

/-- **`CreditResolved`** (M8d; the load-bearing lemma). For every class `S` there is a counting chain (`LuckyChain.lean`)
whose pins pay for the lucky bits of every `ω` with `luckySet ω = S`:
`2^{bits} · (M − 2Q_tot)^{|S|} ≤ (2M)^{|S|} · Π_{ℓ<m} w ℓ ω`. The chain's variables are the answers, in round order,
then the honest sources in topological order. The pins are the lucky equations, each resolved at the variable it
constrains. So every credited unit is paid for by randomness that no other unit uses. -/
def CreditResolved : Prop :=
  ∀ (n wc D Q : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)), 0 < n →
    64 * n * (n * (Q + 1) + 2 * n) ≤ 2 ^ (n * wc) → (∀ c, (p c).Bounded D Q) →
    ∀ S : Finset (ℕ × ℕ), ∃ (m : ℕ) (X : ℕ → (p3ModelT n wc).Ω → Lab n wc) (P : ℕ → (p3ModelT n wc).Ω → ℕ)
      (A : ℕ → (p3ModelT n wc).Ω → Finset (Lab n wc)),
      PousLuckyChain.PrefixDet X P A ∧ PousLuckyChain.Fibre X P ∧
      ∀ ω, luckySet p ω tag G W D Q = S →
        (2 ^ luckyBits p ω tag G W D : ℝ) * (((2 ^ (n * wc) - 2 * (n * (Q + 1) + 2 * n) : ℕ) : ℝ) ^ S.card) ≤
          ((2 * 2 ^ (n * wc) : ℕ) : ℝ) ^ S.card * ∏ ℓ ∈ Finset.range m, PousLuckyChain.w X P A ℓ ω

/-- **`CreditResolvedTyped`** (M8d, per typed class; the load-bearing lemma). For every slot set `S` and every set of hit
slots `H`, there is a counting chain whose pins pay, up to a factor `2`, for every `ω` with `luckySet ω = S` and
`hitSlotSet ω = H`: `2^{bits} ≤ 2 · Π_{ℓ<m} w ℓ ω`. The `H` records which forward slots are hits.
- The factor `2` absorbs every pool loss. A pinned permutation variable's pool is `≥ M − Q_tot`, there are `≤ 6n` of
  them, and `64·n·Q_tot ≤ M`.
- Summing over the `≤ 2^{|S|}` choices of `H` gives the class weight `≤ 2^{|S|+1}·|Ω|` that the union bound needs
  (`zeroAdviceLucky_of_creditResolvedTyped`, `LuckyResolve.lean`). -/
def CreditResolvedTyped : Prop :=
  ∀ (n wc D Q : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)), 0 < n →
    64 * n * (n * (Q + 1) + 2 * n) ≤ 2 ^ (n * wc) → (∀ c, (p c).Bounded D Q) →
    ∀ S H : Finset (ℕ × ℕ), ∃ (m : ℕ) (X : ℕ → (p3ModelT n wc).Ω → Lab n wc)
      (P : ℕ → (p3ModelT n wc).Ω → ℕ) (A : ℕ → (p3ModelT n wc).Ω → Finset (Lab n wc)),
      PousLuckyChain.PrefixDet X P A ∧ PousLuckyChain.Fibre X P ∧
      ∀ ω, luckySet p ω tag G W D Q = S → hitSlotSet p ω tag G W D = H →
        (2 ^ luckyBits p ω tag G W D : ℝ) ≤ 2 * ∏ ℓ ∈ Finset.range m, PousLuckyChain.w X P A ℓ ω

end PousAssembly

end


/-! ════ Freshness.LuckyCount ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Counting for the lucky-guess union bound (`ZeroAdvicePlan.md`, M4)

Model-free arithmetic (it imports `Pebbling.TweakedDraft` only for the Mathlib closure the package already uses):
- `sum_choose_le_two`: `Σ_{j ≤ a} C(N, j) ≤ 2·C(N, a)` when `3a ≤ N`;
- `pow_mul_choose_le`: `K^m · C(N, a) ≤ C(N, a + m)` when `N ≥ K·(a + m) + a + m`;
- `choose_ten_ge`: `2^{9n+2} · C(N, 9n) ≤ C(N, 10n)` when `N ≥ 20490·n` and `0 < n`;
- `pow_le_two_mul_pow_sub`: `M^a ≤ 2·(M − x)^a` when `64·a·x ≤ 18·M` (the pool factor).
-/

namespace PousLuckyCount

/-- `2·C(N, j) ≤ C(N, j + 1)` when `2·(j + 1) ≤ N − j`. -/
theorem two_mul_choose_le_succ {N j : ℕ} (h : 2 * (j + 1) ≤ N - j) :
    2 * Nat.choose N j ≤ Nat.choose N (j + 1) := by
  have e := Nat.choose_succ_right_eq N j
  have h1 : Nat.choose N j * (2 * (j + 1)) ≤ Nat.choose N j * (N - j) := Nat.mul_le_mul_left _ h
  have h2 : 2 * Nat.choose N j * (j + 1) ≤ Nat.choose N (j + 1) * (j + 1) := by
    rw [e]; nlinarith
  exact Nat.le_of_mul_le_mul_right h2 (Nat.succ_pos j)

/-- **`Σ_{j ≤ a} C(N, j) ≤ 2·C(N, a)`** when `3a ≤ N`. -/
theorem sum_choose_le_two {N a : ℕ} (h : 3 * a ≤ N) :
    ∑ j ∈ Finset.range (a + 1), Nat.choose N j ≤ 2 * Nat.choose N a := by
  suffices H : ∀ m ≤ a, ∑ j ∈ Finset.range (m + 1), Nat.choose N j ≤ 2 * Nat.choose N m from H a le_rfl
  intro m
  induction m with
  | zero => intro _; simp
  | succ m ih =>
    intro hm
    rw [Finset.sum_range_succ]
    have := two_mul_choose_le_succ (N := N) (j := m) (by omega)
    have := ih (by omega)
    omega

/-- `K·C(N, j) ≤ C(N, j + 1)` when `K·(j + 1) ≤ N − j`. -/
theorem mul_choose_le_succ {N j K : ℕ} (h : K * (j + 1) ≤ N - j) :
    K * Nat.choose N j ≤ Nat.choose N (j + 1) := by
  have e := Nat.choose_succ_right_eq N j
  have h1 : Nat.choose N j * (K * (j + 1)) ≤ Nat.choose N j * (N - j) := Nat.mul_le_mul_left _ h
  have h2 : K * Nat.choose N j * (j + 1) ≤ Nat.choose N (j + 1) * (j + 1) := by
    rw [e]; nlinarith
  exact Nat.le_of_mul_le_mul_right h2 (Nat.succ_pos j)

/-- **`K^m · C(N, a) ≤ C(N, a + m)`** when `K·(a + m) + a + m ≤ N`. -/
theorem pow_mul_choose_le {N a K : ℕ} : ∀ m, K * (a + m) + a + m ≤ N →
    K ^ m * Nat.choose N a ≤ Nat.choose N (a + m)
  | 0, _ => by simp
  | m + 1, h => by
    have ih := pow_mul_choose_le (N := N) (a := a) (K := K) m (by nlinarith)
    have step := mul_choose_le_succ (N := N) (j := a + m) (K := K) (by
      have : K * (a + m + 1) ≤ K * (a + (m + 1)) := le_of_eq (by ring)
      omega)
    calc K ^ (m + 1) * Nat.choose N a = K * (K ^ m * Nat.choose N a) := by ring
      _ ≤ K * Nat.choose N (a + m) := Nat.mul_le_mul_left _ ih
      _ ≤ Nat.choose N (a + m + 1) := step
      _ = Nat.choose N (a + (m + 1)) := by rw [Nat.add_assoc]

/-- **`2^{9n+2} · C(N, 9n) ≤ C(N, 10n)`** when `20490·n ≤ N` and `0 < n`. -/
theorem choose_ten_ge {N n : ℕ} (hn : 0 < n) (hN : 20490 * n ≤ N) :
    2 ^ (9 * n + 2) * Nat.choose N (9 * n) ≤ Nat.choose N (10 * n) := by
  have h := pow_mul_choose_le (N := N) (a := 9 * n) (K := 2 ^ 11) n (by norm_num; omega)
  have hpow : 2 ^ (9 * n + 2) ≤ (2 ^ 11) ^ n := by
    rw [← pow_mul]
    exact Nat.pow_le_pow_right (by norm_num) (by omega)
  calc 2 ^ (9 * n + 2) * Nat.choose N (9 * n) ≤ (2 ^ 11) ^ n * Nat.choose N (9 * n) :=
        Nat.mul_le_mul_right _ hpow
    _ ≤ Nat.choose N (9 * n + n) := h
    _ = Nat.choose N (10 * n) := by congr 1; ring

/-- Bernoulli, multiplied out: `M^a · M ≤ (M − x)^a · M + a·x·M^a` for `x ≤ M`. -/
theorem pow_mul_le_pow_sub_add {M x : ℕ} (hx : x ≤ M) :
    ∀ a, M ^ a * M ≤ (M - x) ^ a * M + a * x * M ^ a := by
  obtain ⟨y, rfl⟩ : ∃ y, M = y + x := ⟨M - x, by omega⟩
  rw [Nat.add_sub_cancel]
  intro a
  induction a with
  | zero => simp
  | succ a ih =>
    have hy : y ^ a ≤ (y + x) ^ a := Nat.pow_le_pow_left (Nat.le_add_right y x) a
    have h1 := Nat.mul_le_mul_right (y + x) ih
    have h2 : y ^ a * (y + x) * (y + x) ≤ y ^ (a + 1) * (y + x) + x * (y + x) ^ (a + 1) := by
      have : y ^ a * (y + x) * (y + x) = y ^ (a + 1) * (y + x) + x * (y ^ a * (y + x)) := by ring
      rw [this]
      have : y ^ a * (y + x) ≤ (y + x) ^ (a + 1) := by
        rw [pow_succ]; exact Nat.mul_le_mul_right _ hy
      nlinarith
    calc (y + x) ^ (a + 1) * (y + x) = (y + x) ^ a * (y + x) * (y + x) := by ring
      _ ≤ (y ^ a * (y + x) + a * x * (y + x) ^ a) * (y + x) := h1
      _ = y ^ a * (y + x) * (y + x) + a * x * (y + x) ^ (a + 1) := by ring
      _ ≤ y ^ (a + 1) * (y + x) + x * (y + x) ^ (a + 1) + a * x * (y + x) ^ (a + 1) := by omega
      _ = y ^ (a + 1) * (y + x) + (a + 1) * x * (y + x) ^ (a + 1) := by ring

/-- **The pool factor**: `M^a ≤ 2·(M − x)^a` when `64·a·x ≤ 18·M`. -/
theorem pow_le_two_mul_pow_sub {M x a : ℕ} (hM : 0 < M) (h : 64 * (a * x) ≤ 18 * M) :
    M ^ a ≤ 2 * (M - x) ^ a := by
  rcases Nat.eq_zero_or_pos a with rfl | ha
  · simp
  have hx : x ≤ M := by nlinarith
  have hb := pow_mul_le_pow_sub_add hx a
  have h3 : 46 * M ^ a * M ≤ 64 * (M - x) ^ a * M := by
    have : 64 * (a * x * M ^ a) ≤ 18 * M * M ^ a := by
      calc 64 * (a * x * M ^ a) = 64 * (a * x) * M ^ a := by ring
        _ ≤ 18 * M * M ^ a := Nat.mul_le_mul_right _ h
    nlinarith
  have h4 : 46 * M ^ a ≤ 64 * (M - x) ^ a := Nat.le_of_mul_le_mul_right h3 hM
  omega

open Classical in
/-- **The union bound over lucky sets.** If every winner's lucky set is a subset of `T` of size `≤ a` with
`≥ B` bits, and every class `{ω | L ω = S}` has weight `Σ 2^{bits} ≤ K`, then
`#win · 2^B ≤ (Σ_{j ≤ a} C(|T|, j)) · K`. -/
theorem union_bound {Ω : Type} [Fintype Ω] (Win : Ω → Prop) (L : Ω → Finset (ℕ × ℕ)) (bits : Ω → ℕ)
    (T : Finset (ℕ × ℕ)) (a B K : ℕ)
    (hwin : ∀ ω, Win ω → L ω ⊆ T ∧ (L ω).card ≤ a ∧ B ≤ bits ω)
    (hclass : ∀ S ⊆ T, S.card ≤ a → ∑ ω ∈ Finset.univ.filter (fun ω => L ω = S), 2 ^ bits ω ≤ K) :
    (Finset.univ.filter Win).card * 2 ^ B ≤ (∑ j ∈ Finset.range (a + 1), Nat.choose T.card j) * K := by
  set P := T.powerset.filter fun S => S.card ≤ a with hP
  have hmaps : ∀ ω ∈ Finset.univ.filter Win, L ω ∈ P := by
    intro ω hω
    obtain ⟨h1, h2, -⟩ := hwin ω (Finset.mem_filter.1 hω).2
    simp only [hP, Finset.mem_filter, Finset.mem_powerset]
    exact ⟨h1, h2⟩
  have hP_card : P.card ≤ ∑ j ∈ Finset.range (a + 1), Nat.choose T.card j := by
    have hsub : P ⊆ (Finset.range (a + 1)).biUnion fun j => T.powersetCard j := by
      intro S hS
      simp only [hP, Finset.mem_filter, Finset.mem_powerset] at hS
      simp only [Finset.mem_biUnion, Finset.mem_range, Finset.mem_powersetCard]
      exact ⟨S.card, by omega, hS.1, rfl⟩
    refine (Finset.card_le_card hsub).trans (Finset.card_biUnion_le.trans (le_of_eq ?_))
    exact Finset.sum_congr rfl fun j _ => Finset.card_powersetCard j T
  calc (Finset.univ.filter Win).card * 2 ^ B = ∑ ω ∈ Finset.univ.filter Win, 2 ^ B := by
        rw [Finset.sum_const, smul_eq_mul]
    _ ≤ ∑ ω ∈ Finset.univ.filter Win, 2 ^ bits ω := by
        refine Finset.sum_le_sum fun ω hω => Nat.pow_le_pow_right (by norm_num) ?_
        exact (hwin ω (Finset.mem_filter.1 hω).2).2.2
    _ = ∑ S ∈ P, ∑ ω ∈ (Finset.univ.filter Win).filter (fun ω => L ω = S), 2 ^ bits ω :=
        (Finset.sum_fiberwise_of_maps_to hmaps _).symm
    _ ≤ ∑ S ∈ P, ∑ ω ∈ Finset.univ.filter (fun ω => L ω = S), 2 ^ bits ω := by
        refine Finset.sum_le_sum fun S _ => Finset.sum_le_sum_of_subset_of_nonneg ?_ fun _ _ _ => Nat.zero_le _
        intro ω hω
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
        exact hω.2
    _ ≤ ∑ _S ∈ P, K := by
        refine Finset.sum_le_sum fun S hS => ?_
        simp only [hP, Finset.mem_filter, Finset.mem_powerset] at hS
        exact hclass S hS.1 hS.2
    _ = P.card * K := by rw [Finset.sum_const, smul_eq_mul]
    _ ≤ (∑ j ∈ Finset.range (a + 1), Nat.choose T.card j) * K := Nat.mul_le_mul_right _ hP_card

end PousLuckyCount

end


/-! ════ Pebbling.HconstrTweaked ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `HconstrTweaked.lean`: the chain `FreshnessInvariant → PermIncompressibility → n10prime / n10primeMulti`

This builds the decode (`hconstr`) over `p3ModelT` from the handed-off `FreshnessInvariant`
(`FreshnessStmt.lean`, sha `8e9ca7a1…`), and assembles the chain to `n10prime`/`n10primeMulti`, `sorry`-free apart from
that one hypothesis.

Layers:
* `core_to_bound_T` — the assembly over `p3ModelT` with the **set-encoded** position factor `Nat.choose (N·Q_tot) pos`
  (`e = 0` in `pr_le_of_decode_charge`).
-/

namespace PousHconstr

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousFreshness
open scoped ENNReal

/-- **Assembly over `p3ModelT` (proved).** `e = 0` in `pr_le_of_decode_charge`, so the saving lives entirely in the hint
cardinality: a decode of every `E`-outcome from `σ` and a hint `Xh` with
`|Xh|·2^{sav·(n·wc)} ≤ Nat.choose (N·Q_tot) pos · |Ω|` gives `pr E ≤ N10primeBoundT N m n wc Q_tot pos sav`. Needs
`1 ≤ N`. This is `PousForwardCore.core_to_bound` ported to `p3ModelT` with the binomial position factor. -/
theorem core_to_bound_T {n wc : ℕ} (N m Q_tot pos sav : ℕ) (hN : 1 ≤ N)
    (E : (p3ModelT n wc).Ω → Prop) (Xh : Type) [Fintype Xh]
    (dec : Bits m → (Fin 0 → Bits 0) → Xh → (p3ModelT n wc).Ω)
    (hcov : ∀ ω, E ω → ∃ σ a x, dec σ a x = ω)
    (hcard : (Fintype.card Xh : ℝ≥0∞) * 2 ^ (sav * (n * wc))
      ≤ ((Nat.choose (N * Q_tot) pos : ℕ) : ℝ≥0∞) * (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞)) :
    pr E ≤ N10primeBoundT N m n wc Q_tot pos sav := by
  classical
  have hdec := PousP3Forward.pr_le_of_decode_charge m 0 0 E dec hcov
  simp only [Nat.zero_mul, pow_zero, mul_one] at hdec
  simp only [N10primeBoundT]
  set Ωc : ℝ≥0∞ := (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞) with hΩc
  set Xc : ℝ≥0∞ := (Fintype.card Xh : ℝ≥0∞) with hXc
  set P : ℝ≥0∞ := ((Nat.choose (N * Q_tot) pos : ℕ) : ℝ≥0∞) with hP
  set S : ℝ≥0∞ := (2 : ℝ≥0∞) ^ (sav * (n * wc)) with hS
  have hStop : S ≠ ⊤ := by rw [hS]; finiteness
  have hS0 : S ≠ 0 := by rw [hS]; positivity
  have hN' : (1 : ℝ≥0∞) ≤ (N : ℝ≥0∞) := by exact_mod_cast hN
  refine hdec.trans ?_
  refine ENNReal.div_le_of_le_mul ?_
  have mul_mono : ∀ x y : ℝ≥0∞, x ≤ y → 2 ^ m * x ≤ (N : ℝ≥0∞) * 2 ^ m * y := by
    intro x y hxy
    calc 2 ^ m * x ≤ 2 ^ m * y := by gcongr
      _ = 1 * (2 ^ m * y) := (one_mul _).symm
      _ ≤ (N : ℝ≥0∞) * (2 ^ m * y) := by gcongr
      _ = (N : ℝ≥0∞) * 2 ^ m * y := by ring
  have hkey : 2 ^ m * Xc * S ≤ (N : ℝ≥0∞) * 2 ^ m * P * Ωc := by
    calc 2 ^ m * Xc * S = 2 ^ m * (Xc * S) := by ring
      _ ≤ (N : ℝ≥0∞) * 2 ^ m * (P * Ωc) := mul_mono _ _ hcard
      _ = (N : ℝ≥0∞) * 2 ^ m * P * Ωc := by ring
  have hmix : (N : ℝ≥0∞) * 2 ^ m * P / S * Ωc = (N : ℝ≥0∞) * 2 ^ m * P * Ωc / S := by
    rw [div_eq_mul_inv, div_eq_mul_inv, mul_right_comm]
  have hstep : 2 ^ m * Xc ≤ (N : ℝ≥0∞) * 2 ^ m * P * Ωc / S :=
    (ENNReal.le_div_iff_mul_le (Or.inl hS0) (Or.inl hStop)).mpr hkey
  rw [hmix]
  exact hstep

/-- **Reduction skeleton over `p3ModelT` (proved).** `pr Win ≤ N10primeBoundT + coll_bd` from (i) a covering decode of
the non-colliding winners with the reduced-`Ω` cardinality and (ii) a bound on the colliding winners. `pr_partition`
splits `Win`; `core_to_bound_T` handles `¬Coll`, `hcoll` the `Coll` part. This ports `n10prime_core_of_encoding` to
`p3ModelT` with the binomial position factor; the two hypotheses are `hconstr_of_freshness` (the decode, from
`FreshnessInvariant`) and the birthday `hbirthdayT_of_labelBirthdayT`. -/
theorem n10prime_core_of_encoding_T {n wc : ℕ} (N m Q_tot pos sav : ℕ) (hN : 1 ≤ N)
    (Win Coll : (p3ModelT n wc).Ω → Prop) (coll_bd : ℝ≥0∞)
    (henc : ∃ (Xh : Type) (_ : Fintype Xh)
        (dec : Bits m → (Fin 0 → Bits 0) → Xh → (p3ModelT n wc).Ω),
        (∀ ω, (Win ω ∧ ¬ Coll ω) → ∃ σ a x, dec σ a x = ω) ∧
        (Fintype.card Xh : ℝ≥0∞) * 2 ^ (sav * (n * wc))
          ≤ ((Nat.choose (N * Q_tot) pos : ℕ) : ℝ≥0∞) * (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞))
    (hcoll : pr (fun ω => Win ω ∧ Coll ω) ≤ coll_bd) :
    pr Win ≤ N10primeBoundT N m n wc Q_tot pos sav + coll_bd := by
  obtain ⟨Xh, hXhFin, dec, hcov, hcard⟩ := henc
  rw [pr_partition Win Coll]
  exact add_le_add
    (@core_to_bound_T n wc N m Q_tot pos sav hN (fun ω => Win ω ∧ ¬ Coll ω) Xh hXhFin dec hcov hcard) hcoll

end PousHconstr

end


/-! ════ Pebbling.HintCardStmt ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `HintCardStmt`: the partial-output deletion count for the tweaked decode, on `KnowledgeSim`'s credits

`freshness/KnowledgeSim.lean` (sha `67e6c3a2…`) reads off, per segment, a **keyed** credited holding `cred D : KState n`
and proves `know t ⊆ timedReachK G (cred D) t`; with `columnHard_timedK` that gives `(k − X)·n ≤ (cred D).size`. There is
**no guess event** — the XOR use with neither part known is *credited* one unit (the top), not sent to a guess. The decode
deletes **exactly the credited units**, each recovered at the use that triggered it (`KnowledgeSim`'s module doc).

A `KState` credit has two kinds of held unit, and they delete from the two parts of `Ω = (H\text{-table}) × (P\text{-family})`:

* **`hold` (a `ColState`) → permutation-output deletions.** Lower whole labels and tops as **whole** `P_t` outputs
  (`n·wc` bits), lower columns as **partial** `P_t` outputs (`wc` bits). These reduce to `card_familyRed_mul'` over the
  permutation family `P_t : Tweak → Perm Lab` (`K t = ∅` leaves `P_t` whole): the ω-independent reduced family is
  `PousHintCard.FamilyRed (fun _ => x₀) KP` (re-based at a fixed `x₀`).
* **`lowerKey`/`topKey` (held keys `k = H(τ,ℓ,v,par)`) → `H`-output deletions.** Each key is a **whole** predicted `H`
  output (`n·wc` bits). These reduce over the `H`-table `H : KQ' → Lab`; since `KQ'` carries a function component and has
  no cheap `DecidableEq`, the counts go through `Nat.card` (`Nat.card_pi`), using the per-input off-bits type
  `OffBits (KH q)` (ω-independent). `card_offbits` (from `PousHintCard.labBits`) gives the per-input saving.

The bound the encoding consumes (`n10prime_core_of_encoding_T`'s `hcard`): `|HintT| · 2^{sav·(n·wc)} ≤ choose(N·Q_tot, pos) · |Ω|`,
with total deleted bits `∑_q |KH q| + ∑_t |KP t| = wc · (cred D).size ≥ sav·(n·wc)`. Both the `H` off-bits and the position
subset cancel against `|Ω|` exactly, and the family term is `card_familyRed_mul'`.

**No double credit** (`KnowledgeSim`, the XOR case): a top's honest input reveals only `x²_u ⊕ k²_u` — one label's worth —
so a single use is credited **one** unit; `∑ KH + ∑ KP` counts each deleted output bit once. This statement takes the
deleted-bit maps `KH, KP` (the credited units' bit-positions) and is agnostic to how they were read off, so it cannot
double-credit; the `cred → (KH, KP)` bridge (with `∑ = wc·size`) is the decode's, on `KnowledgeSim`'s credits.

This subagent keeps decode-coverage (`FreshnessStmt.lean`), `hcoll` (the birthday bound), and this file.
-/

namespace PousHintCardStmt

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousHintCard
open scoped ENNReal
open Finset

variable {n wc : ℕ}

/-! ### The reduced pieces (all ω-independent) -/

/-- The off-`K` bits of one label: an `H`/`P` output with the bits at `K` deleted stores exactly these. ω-independent. -/
abbrev OffBits (K : Finset (Fin n × Fin wc)) : Type := {p : Fin n × Fin wc // p ∉ K} → Bool

/-- The reduced `H`-table: per input `q`, the off-`KH q` bits of `H q`. ω-independent (it never names the value `H q`). -/
abbrev RedHTable (KH : KQ' n wc → Finset (Fin n × Fin wc)) : Type := (q : KQ' n wc) → OffBits (KH q)

/-- **The ω-independent hint type.** The reduced `H`-table (keys deleted as partial/whole `H`-outputs), the reduced
permutation family re-based at a fixed `x₀` (`FamilyRed (fun _ => x₀) KP`, hold deleted as partial/whole `P`-outputs), and
the `pos` hit positions among the `N·Q_tot` query positions. -/
abbrev HintT (N Q_tot pos : ℕ) (x₀ : Lab n wc)
    (KH : KQ' n wc → Finset (Fin n × Fin wc)) (KP : Tweak n → Finset (Fin n × Fin wc)) : Type :=
  RedHTable KH × FamilyRed (fun _ : Tweak n => x₀) KP × {s : Finset (Fin (N * Q_tot)) // s.card = pos}

noncomputable instance instFintypeHintT (N Q_tot pos : ℕ) (x₀ : Lab n wc)
    (KH : KQ' n wc → Finset (Fin n × Fin wc)) (KP : Tweak n → Finset (Fin n × Fin wc)) :
    Fintype (HintT N Q_tot pos x₀ KH KP) := Fintype.ofFinite _

/-! ### The reductions -/

/-- **The hold fresh set reduces to `card_familyRed_mul'`.** Over all tweaks at once (`KP t = ∅` leaves `P_t` whole), the
ω-independent reduced family has `|FamilyRed (fun _ => x₀) KP| · 2^{∑ₜ |KP t|} = |Tweak → Perm Lab|`. -/
theorem hintFamily_card (x₀ : Lab n wc) (KP : Tweak n → Finset (Fin n × Fin wc)) :
    Fintype.card (FamilyRed (fun _ : Tweak n => x₀) KP) * 2 ^ (∑ t, (KP t).card)
      = Fintype.card (Tweak n → Equiv.Perm (Lab n wc)) :=
  card_familyRed_mul' (fun _ => x₀) KP

/-- The hit positions contribute `Nat.choose (N·Q_tot) pos`. -/
theorem hintPos_card (m pos : ℕ) :
    Fintype.card {s : Finset (Fin m) // s.card = pos} = m.choose pos := by
  rw [Fintype.card_finset_len, Fintype.card_fin]

/-- **One `H`-output's saving.** The off-`K` bits, times the `2^{|K|}` deleted bits, is one whole label. -/
theorem card_offbits (K : Finset (Fin n × Fin wc)) :
    Nat.card (OffBits K) * 2 ^ K.card = Nat.card (Lab n wc) := by
  have e := Nat.card_congr (labBits K)
  rw [Nat.card_prod] at e
  have hb : Nat.card ((↥K) → Bool) = 2 ^ K.card := by
    rw [Nat.card_fun, Nat.card_eq_fintype_card (α := Bool), Fintype.card_bool,
      Nat.card_eq_fintype_card (α := (↥K)), Fintype.card_coe]
  rw [hb] at e
  rw [e, Nat.mul_comm]

/-- **The `H`-key fresh set reduces (over `Nat.card`, since `KQ'` has no cheap `DecidableEq`).** The reduced `H`-table,
times the `2^{∑_q |KH q|}` deleted `H`-output bits, is the whole `H`-table `|KQ' → Lab|`. -/
theorem card_redHTable (KH : KQ' n wc → Finset (Fin n × Fin wc)) :
    Nat.card (RedHTable KH) * 2 ^ (∑ q, (KH q).card) = Nat.card (KQ' n wc → Lab n wc) := by
  rw [RedHTable, Nat.card_pi, Nat.card_pi (β := fun _ : KQ' n wc => Lab n wc),
    ← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
  exact Finset.prod_congr rfl fun q _ => card_offbits (KH q)

/-- The tweaked model's sample space factors as the `H`-table times the permutation family. -/
theorem card_omegaT :
    Nat.card (p3ModelT n wc).Ω
      = Nat.card (KQ' n wc → Lab n wc) * Fintype.card (Tweak n → Equiv.Perm (Lab n wc)) := by
  have e : (p3ModelT n wc).Ω = ((KQ' n wc → Lab n wc) × (Tweak n → Equiv.Perm (Lab n wc))) := rfl
  rw [e, Nat.card_prod, Nat.card_eq_fintype_card (α := (Tweak n → Equiv.Perm (Lab n wc)))]

/-- **The ℕ identity behind the bound.** `|HintT| · 2^{∑ KH + ∑ KP} = choose(N·Q_tot, pos) · |Ω|`: the reduced `H`-table
recovers `|KQ' → Lab|` and the reduced family recovers `|Tweak → Perm Lab|`, so both parts of `|Ω|` and the positions
cancel exactly. Reduces to `card_redHTable` and `card_familyRed_mul'`. -/
theorem hintCard_nat (N Q_tot pos : ℕ) (x₀ : Lab n wc)
    (KH : KQ' n wc → Finset (Fin n × Fin wc)) (KP : Tweak n → Finset (Fin n × Fin wc)) :
    Nat.card (HintT N Q_tot pos x₀ KH KP) * 2 ^ ((∑ q, (KH q).card) + (∑ t, (KP t).card))
      = (N * Q_tot).choose pos * Nat.card (p3ModelT n wc).Ω := by
  have hH : Nat.card (RedHTable KH) * 2 ^ (∑ q, (KH q).card)
      = Nat.card (KQ' n wc → Lab n wc) := card_redHTable KH
  have hP : Fintype.card (FamilyRed (fun _ : Tweak n => x₀) KP) * 2 ^ (∑ t, (KP t).card)
      = Fintype.card (Tweak n → Equiv.Perm (Lab n wc)) := card_familyRed_mul' (fun _ => x₀) KP
  have hHint : Nat.card (HintT N Q_tot pos x₀ KH KP)
      = Nat.card (RedHTable KH)
        * (Fintype.card (FamilyRed (fun _ : Tweak n => x₀) KP) * (N * Q_tot).choose pos) := by
    rw [HintT, Nat.card_prod, Nat.card_prod,
      Nat.card_eq_fintype_card (α := FamilyRed (fun _ : Tweak n => x₀) KP),
      Nat.card_eq_fintype_card (α := {s : Finset (Fin (N * Q_tot)) // s.card = pos}), hintPos_card]
  rw [hHint, card_omegaT, pow_add]
  calc Nat.card (RedHTable KH)
          * (Fintype.card (FamilyRed (fun _ : Tweak n => x₀) KP) * (N * Q_tot).choose pos)
          * (2 ^ (∑ q, (KH q).card) * 2 ^ (∑ t, (KP t).card))
      = (N * Q_tot).choose pos
          * ((Nat.card (RedHTable KH) * 2 ^ (∑ q, (KH q).card))
            * (Fintype.card (FamilyRed (fun _ : Tweak n => x₀) KP) * 2 ^ (∑ t, (KP t).card))) := by ring
    _ = (N * Q_tot).choose pos
          * (Nat.card (KQ' n wc → Lab n wc) * Fintype.card (Tweak n → Equiv.Perm (Lab n wc))) := by
        rw [hH, hP]

/-- **`HintCardStmt` — the hint-cardinality bound the decode's encoding consumes** (`n10prime_core_of_encoding_T`'s
`hcard`), on `KnowledgeSim`'s credits. With the ω-independent hint type `HintT` and the deleted-bit maps `KH` (keys, from
`lowerKey`/`topKey`) and `KP` (hold, from `lowerWhole`/`lowerCol`/`topWhole`) whose total charge covers the saving
(`sav·(n·wc) ≤ ∑_q |KH q| + ∑_t |KP t| = wc·(cred D).size`, from `columnHard_timedK`),
`|HintT| · 2^{sav·(n·wc)} ≤ choose(N·Q_tot, pos) · |Ω|`. The proof reduces to `card_familyRed_mul'` (hold) and
`card_offbits` (keys). -/
theorem hintCard_bound (N Q_tot pos sav : ℕ) (x₀ : Lab n wc)
    (KH : KQ' n wc → Finset (Fin n × Fin wc)) (KP : Tweak n → Finset (Fin n × Fin wc))
    (hsum : sav * (n * wc) ≤ (∑ q, (KH q).card) + (∑ t, (KP t).card)) :
    (Fintype.card (HintT N Q_tot pos x₀ KH KP) : ℝ≥0∞) * 2 ^ (sav * (n * wc))
      ≤ ((N * Q_tot).choose pos : ℝ≥0∞) * (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞) := by
  have hnat := hintCard_nat N Q_tot pos x₀ KH KP
  rw [Nat.card_eq_fintype_card (α := HintT N Q_tot pos x₀ KH KP),
    Nat.card_eq_fintype_card (α := (p3ModelT n wc).Ω)] at hnat
  have hcast : (Fintype.card (HintT N Q_tot pos x₀ KH KP) : ℝ≥0∞)
        * 2 ^ ((∑ q, (KH q).card) + (∑ t, (KP t).card))
      = ((N * Q_tot).choose pos : ℝ≥0∞) * (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞) := by
    calc (Fintype.card (HintT N Q_tot pos x₀ KH KP) : ℝ≥0∞)
            * 2 ^ ((∑ q, (KH q).card) + (∑ t, (KP t).card))
        = ((Fintype.card (HintT N Q_tot pos x₀ KH KP)
            * 2 ^ ((∑ q, (KH q).card) + (∑ t, (KP t).card)) : ℕ) : ℝ≥0∞) := by push_cast; ring
      _ = (((N * Q_tot).choose pos * Fintype.card (p3ModelT n wc).Ω : ℕ) : ℝ≥0∞) := by rw [hnat]
      _ = ((N * Q_tot).choose pos : ℝ≥0∞) * (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞) := by push_cast; ring
  have hpow : (2 : ℝ≥0∞) ^ (sav * (n * wc))
      ≤ 2 ^ ((∑ q, (KH q).card) + (∑ t, (KP t).card)) := pow_le_pow_right₀ one_le_two hsum
  calc (Fintype.card (HintT N Q_tot pos x₀ KH KP) : ℝ≥0∞) * 2 ^ (sav * (n * wc))
      ≤ (Fintype.card (HintT N Q_tot pos x₀ KH KP) : ℝ≥0∞)
          * 2 ^ ((∑ q, (KH q).card) + (∑ t, (KP t).card)) := mul_le_mul_of_nonneg_left hpow zero_le
    _ = ((N * Q_tot).choose pos : ℝ≥0∞) * (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞) := hcast

end PousHintCardStmt

end


/-! ════ Freshness.Assembly ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Assembly: `n10prime` and `n10primeMulti` from the decode's counting hypothesis and `LabelBirthdayT`

`n10prime_of_consistent` and `n10primeMulti_of_consistent` prove the N10′ bounds, at `pos` hit positions and any
depth conversion, from exactly two hypotheses:
* `ConsistentBound A₁ R (fun _ => ()) (Win ∧ ¬Coll) b` for a reduction `R : Ω → Red`. The pattern is folded into
  `Red`, so `R` holds everything the decoder keeps besides `σ`: tables, positions, and which entries were deleted.
* `LabelBirthdayT` (per segment).

`|Red|` and `b` are parameters, subject to **the decode worker's target**, with `Q_tot = n·(Q+1) + 2n`:
* one segment (`DecodeTarget`): `|Red| · 2^b · 2^{(k−X)·n·wc} ≤ C(Q_tot, pos) · |Ω|`;
* `N` segments (`DecodeTargetMulti`): `|Red| · 2^b · 2^{N·(k−X)·n·wc} ≤ N · C(N·Q_tot, pos) · |Ω|`.

Supporting lemmas:
* **Where `ColumnHard` enters (the decode's side).** `winner_cred2_size` combines `knowledgeSim2` and
  `columnHard_timedK`: at depth `gd D ≥ D`, every winning segment has `(k − X)·n ≤ (cred2 D).size`.
  `winner_bits` restates it in deleted bits.
* **The `HintCardStmt` bridge.** With fixed deletion maps `KH, KP` covering the saving, `HintT` meets the target at
  `b = 0` (`decodeTarget_of_hintCard`, `decodeTargetMulti_of_hintCard`).
* **The pinned shapes.** `n10prime_of_decodeHyp` and `n10primeMulti_of_decodeHyp` prove `PousTweaked.N10primeT`
  and `…n10primeMulti` (`gameDepth D = D`, `pos = 3n`, `3nN`) from `DecodeHyp3`/`DecodeHypMulti3` and `LabelBirthdayAll`.
  `labelBirthdayAll` discharges the latter (`PousLabelBirthday.labelBirthdayT`), so `n10prime_of_decode` and
  `n10primeMulti_of_decode` rest on the decode hypothesis alone.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge
open scoped ENNReal

variable {n wc : ℕ}

/-! ### The counting step in probability form -/

/-- `ConsistentBound` with the target `|Red| · 2^b · S ≤ C · |Ω|` gives `pr E ≤ 2^m · C / S`. -/
theorem pr_le_of_consistent {Ω : Type} [Fintype Ω] {m : ℕ} {Red : Type} [Fintype Red] (E : Ω → Prop)
    (A₁ : Ω → Bits m) (R : Ω → Red) (b : ℕ) (hcons : ConsistentBound A₁ R (fun _ => ()) E b)
    (C S : ℝ≥0∞) (hS0 : S ≠ 0) (hST : S ≠ ⊤)
    (htarget : (Fintype.card Red : ℝ≥0∞) * 2 ^ b * S ≤ C * Fintype.card Ω) :
    pr E ≤ 2 ^ m * C / S := by
  classical
  have hc := consistentCompression A₁ R (fun _ => ()) E b hcons
  rw [Fintype.card_unit, mul_one] at hc
  have hc' : ((Finset.univ.filter E).card : ℝ≥0∞) ≤ 2 ^ m * (Fintype.card Red : ℝ≥0∞) * 2 ^ b := by
    exact_mod_cast hc
  rw [pr_def, ENNReal.le_div_iff_mul_le (Or.inl hS0) (Or.inl hST)]
  have hsplit : ((Finset.univ.filter E).card : ℝ≥0∞) / (Fintype.card Ω : ℝ≥0∞) * S =
      ((Finset.univ.filter E).card : ℝ≥0∞) * S / (Fintype.card Ω : ℝ≥0∞) := by
    rw [div_eq_mul_inv, div_eq_mul_inv, mul_right_comm]
  rw [hsplit]
  refine ENNReal.div_le_of_le_mul ?_
  calc ((Finset.univ.filter E).card : ℝ≥0∞) * S ≤ 2 ^ m * (Fintype.card Red : ℝ≥0∞) * 2 ^ b * S := by gcongr
    _ = 2 ^ m * ((Fintype.card Red : ℝ≥0∞) * 2 ^ b * S) := by ring
    _ ≤ 2 ^ m * (C * Fintype.card Ω) := by gcongr
    _ = 2 ^ m * C * Fintype.card Ω := by ring

/-! ### The conditional N10′ bounds -/

/-- **`n10prime`, conditional**: from `ConsistentBound` (with the target) and `LabelBirthdayT`, at `pos` positions. -/
theorem n10prime_of_consistent (n wc m Q k X pos : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n)
    (W : Fin n → Lab n wc) (A₁ : (p3ModelT n wc).Ω → Bits m)
    (A₂ : Bits m → Fin n → Prog (p3ModelT n wc) (Lab n wc))
    {Red : Type} [Fintype Red] (R : (p3ModelT n wc).Ω → Red) (b : ℕ)
    (hcons : ConsistentBound A₁ R (fun _ => ()) (fun ω => Win1 k tag G W A₁ A₂ ω ∧ ¬ labCollT tag G W ω) b)
    (htarget : DecodeTarget n wc Q k X pos Red b)
    (hlab : LabelBirthdayT tag G W) :
    pr (fun ω => Win1 k tag G W A₁ A₂ ω)
      ≤ N10primeBoundT 1 m n wc (n * (Q + 1) + 2 * n) pos (k - X)
        + (((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
  rw [pr_partition (fun ω => Win1 k tag G W A₁ A₂ ω) (fun ω : (p3ModelT n wc).Ω => labCollT tag G W ω)]
  refine add_le_add ?_ (hbirthdayT_of_labelBirthdayT k tag G W A₁ A₂ hlab)
  have h := pr_le_of_consistent _ A₁ R b hcons _ _ (by positivity) (by finiteness) htarget
  refine h.trans (le_of_eq ?_)
  simp only [N10primeBoundT, Nat.cast_one, one_mul]

/-- **`n10primeMulti`, conditional**: from `ConsistentBound` (with the target) and `LabelBirthdayT` per segment. -/
theorem n10primeMulti_of_consistent (N n wc m Q k X pos : ℕ) (tags : Fin N → Bits 256)
    (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc) (A₁ : (p3ModelT n wc).Ω → Bits m)
    (A₂ : Bits m → Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc))
    {Red : Type} [Fintype Red] (R : (p3ModelT n wc).Ω → Red) (b : ℕ)
    (hcons : ConsistentBound A₁ R (fun _ => ())
      (fun ω => WinMulti k tags G W A₁ A₂ ω ∧ ¬ CollMulti tags G W ω) b)
    (htarget : DecodeTargetMulti N n wc Q k X pos Red b)
    (hlab : ∀ s, LabelBirthdayT (tags s) G (W s)) :
    pr (fun ω => WinMulti k tags G W A₁ A₂ ω)
      ≤ N10primeBoundT N m n wc (n * (Q + 1) + 2 * n) pos (N * (k - X))
        + (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
  rw [pr_partition (fun ω => WinMulti k tags G W A₁ A₂ ω) (fun ω : (p3ModelT n wc).Ω => CollMulti tags G W ω)]
  refine add_le_add ?_ ?_
  · have h := pr_le_of_consistent _ A₁ R b hcons _ _ (by positivity) (by finiteness) htarget
    refine h.trans (le_of_eq ?_)
    simp only [N10primeBoundT, div_eq_mul_inv]
    ring
  · calc pr (fun ω => WinMulti k tags G W A₁ A₂ ω ∧ CollMulti tags G W ω)
        ≤ pr (fun ω => ∃ s ∈ (Finset.univ : Finset (Fin N)), labCollT (tags s) G (W s) ω) :=
          pr_mono fun ω h => by
            obtain ⟨s, hs⟩ := h.2
            exact ⟨s, Finset.mem_univ _, hs⟩
      _ ≤ ∑ s ∈ (Finset.univ : Finset (Fin N)), pr (fun ω => labCollT (tags s) G (W s) ω) := pr_exists_le _ _
      _ ≤ ∑ _s ∈ (Finset.univ : Finset (Fin N)), (((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) :=
          Finset.sum_le_sum fun s _ => hlab s
      _ = (N : ℝ≥0∞) * ((((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ = (((N * (2 * n) ^ 2 : ℕ) : ℝ≥0∞)) / 2 ^ (n * wc) := by
          push_cast
          rw [mul_div_assoc]
      _ ≤ (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
          refine ENNReal.div_le_div_right ?_ _
          have : N * (2 * n) ^ 2 ≤ (2 * N * n) ^ 2 := by
            have h1 : N ≤ N * N := Nat.le_mul_self N
            calc N * (2 * n) ^ 2 ≤ (N * N) * (2 * n) ^ 2 := Nat.mul_le_mul_right _ h1
              _ = (2 * N * n) ^ 2 := by ring
          exact_mod_cast this

/-! ### Where `ColumnHard` enters: the credits of a winning segment -/

theorem columnHard_antitone {G : Labelling.TopoDAG n} {d d' k X : ℕ} (h : ColumnHard G d k X) (hd : d' ≤ d) :
    ColumnHard G d' k X :=
  fun c0 hk => h c0 (hk.trans (Finset.card_le_card (colReach_mono G c0 hd).2.2))

/-- **A winning segment's credits are large** (`knowledgeSim2` + `columnHard_timedK`): at depth `gd D ≥ D`,
`(k − X)·n ≤ (cred2 D).size`. -/
theorem winner_cred2_size {D k X : ℕ} (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (gd : ℕ → ℕ) (hgd : D ≤ gd D) (hard : ColumnHard G (gd D) k X)
    (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
    (hwin : k ≤ (Finset.univ.filter fun v => (ps v).run ((p3ModelT n wc).answer ω) = topLabelT tag G W ω v).card) :
    (k - X) * n ≤ (cred2 ps ω tag G W D).size :=
  columnHard_timedK G (cred2 ps ω tag G W D) (columnHard_antitone hard hgd)
    (hwin.trans (Finset.card_le_card (knowledgeSim2 n wc D tag G W ps ω).2))

/-- The same, in deleted bits: `(k − X)·n·wc ≤ wc · (cred2 D).size`. -/
theorem winner_bits {D k X : ℕ} (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (gd : ℕ → ℕ) (hgd : D ≤ gd D) (hard : ColumnHard G (gd D) k X)
    (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
    (hwin : k ≤ (Finset.univ.filter fun v => (ps v).run ((p3ModelT n wc).answer ω) = topLabelT tag G W ω v).card) :
    (k - X) * (n * wc) ≤ wc * (cred2 ps ω tag G W D).size := by
  have := Nat.mul_le_mul_right wc (winner_cred2_size tag G W gd hgd hard ps ω hwin)
  calc (k - X) * (n * wc) = (k - X) * n * wc := by ring
    _ ≤ (cred2 ps ω tag G W D).size * wc := this
    _ = wc * (cred2 ps ω tag G W D).size := by ring

/-! ### The `HintCardStmt` bridge: fixed deletion maps meet the target at `b = 0` -/

theorem decodeTarget_of_hintCard (Q k X pos : ℕ) (x₀ : Lab n wc)
    (KH : KQ' n wc → Finset (Fin n × Fin wc)) (KP : Tweak n → Finset (Fin n × Fin wc))
    (hsum : (k - X) * (n * wc) ≤ (∑ q, (KH q).card) + (∑ t, (KP t).card)) :
    DecodeTarget n wc Q k X pos (PousHintCardStmt.HintT 1 (n * (Q + 1) + 2 * n) pos x₀ KH KP) 0 := by
  have h := PousHintCardStmt.hintCard_bound 1 (n * (Q + 1) + 2 * n) pos (k - X) x₀ KH KP hsum
  simpa only [DecodeTarget, pow_zero, mul_one] using h

theorem decodeTargetMulti_of_hintCard (N Q k X pos : ℕ) (hN : 1 ≤ N) (x₀ : Lab n wc)
    (KH : KQ' n wc → Finset (Fin n × Fin wc)) (KP : Tweak n → Finset (Fin n × Fin wc))
    (hsum : (N * (k - X)) * (n * wc) ≤ (∑ q, (KH q).card) + (∑ t, (KP t).card)) :
    DecodeTargetMulti N n wc Q k X pos (PousHintCardStmt.HintT N (n * (Q + 1) + 2 * n) pos x₀ KH KP) 0 := by
  have h := PousHintCardStmt.hintCard_bound N (n * (Q + 1) + 2 * n) pos (N * (k - X)) x₀ KH KP hsum
  simp only [DecodeTargetMulti, pow_zero, mul_one]
  refine h.trans ?_
  have hN' : (1 : ℝ≥0∞) ≤ N := by exact_mod_cast hN
  calc ((Nat.choose (N * (n * (Q + 1) + 2 * n)) pos : ℕ) : ℝ≥0∞) * (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞)
      = 1 * (((Nat.choose (N * (n * (Q + 1) + 2 * n)) pos : ℕ) : ℝ≥0∞) *
          (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞)) := (one_mul _).symm
    _ ≤ (N : ℝ≥0∞) * (((Nat.choose (N * (n * (Q + 1) + 2 * n)) pos : ℕ) : ℝ≥0∞) *
          (Fintype.card (p3ModelT n wc).Ω : ℝ≥0∞)) := by gcongr
    _ = _ := by ring

/-! ### The pinned shapes: `PousTweaked.n10prime` and `PousTweaked.n10primeMulti` -/

/-- **`PousTweaked.n10prime` holds** given the decode hypothesis (at `pos = 3n`) and `LabelBirthdayT`. -/
theorem n10prime_of_decodeHyp (hdec : DecodeHyp3) (hlab : LabelBirthdayAll) :
    PousTweaked.N10primeT := by
  intro n wc m D Q k X tag G W hwc hXk hard A₁ A₂ hA₂
  obtain ⟨Red, hRed, R, b, hcons, htarget⟩ := hdec n wc m D Q k X tag G W A₁ A₂ hwc hXk hard hA₂
  exact n10prime_of_consistent n wc m Q k X (3 * n) tag G W A₁ A₂ R b hcons htarget (hlab n wc tag G W)

/-- **`PousTweaked.n10primeMulti` holds** given the decode hypothesis (at `pos = 3nN`) and `LabelBirthdayT`. -/
theorem n10primeMulti_of_decodeHyp (hdec : DecodeHypMulti3) (hlab : LabelBirthdayAll) :
    PousTweaked.N10primeMultiT := by
  intro N n wc m D Q k X tags G W hwc hN hXk htags hard A₁ A₂ hA₂
  obtain ⟨Red, hRed, R, b, hcons, htarget⟩ :=
    hdec N n wc m D Q k X tags G W A₁ A₂ hwc hN hXk htags hard hA₂
  exact n10primeMulti_of_consistent N n wc m Q k X (3 * n * N) tags G W A₁ A₂ R b hcons htarget
    fun s => hlab n wc (tags s) G (W s)

/-! ### `LabelBirthdayAll` discharged: the N10′ bounds rest on the decode hypothesis alone -/

/-- **`LabelBirthdayAll` holds** (`PousLabelBirthday.labelBirthdayT`, the pebbling prover's theorem). -/
theorem labelBirthdayAll : LabelBirthdayAll := fun _ _ tag G W => PousLabelBirthday.labelBirthdayT tag G W

/-- **`PousTweaked.n10prime` from the decode hypothesis alone** (at `pos = 3n`). -/
theorem n10prime_of_decode (hdec : DecodeHyp3) : PousTweaked.N10primeT :=
  n10prime_of_decodeHyp hdec labelBirthdayAll

/-- **`PousTweaked.n10primeMulti` from the decode hypothesis alone** (at `pos = 3nN`). -/
theorem n10primeMulti_of_decode (hdec : DecodeHypMulti3) : PousTweaked.N10primeMultiT :=
  n10primeMulti_of_decodeHyp hdec labelBirthdayAll

end PousAssembly

end


/-! ════ Freshness.Decode ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The decode: `FixedAdvice` as the hypothesis, its bridge to `DecodeHyp`, and `n10prime` at any `pos`

`DecodeHyp pos` asks for a reduction `R` and a fibre bound `b`. It is implied by the plain fixed-advice count
`FixedAdvice pos` (`AssemblyHyp.lean`): take `R` constant and `b = ⌈log₂ max_σ #winners(σ)⌉`
(`decodeHyp_of_fixedAdvice`), and conversely up to the factor `2`. So the decode's whole content is the count of
winning `ω` per advice string.

* `n10primeAt_of_decodeHyp` / `n10primeMultiAt_of_decodeHyp`: `n10prime` at any `pos`, from `DecodeHyp pos` alone
  (`LabelBirthdayAll` is discharged).
* `n10prime_of_fixedAdvice3`: `PousTweaked.n10prime`, from `FixedAdvice3`.
* `n10prime_of_fixedAdvice7`: `n10prime` at the decode's `pos = 7n` (`posP3`), from `FixedAdvice7`.
* The same three for `n10primeMulti`.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge
open scoped ENNReal

variable {n wc : ℕ}

/-- `2^{⌈log₂ F⌉} ≤ 2F` for `F ≥ 1`. -/
theorem two_pow_clog_le {F : ℕ} (hF : 1 ≤ F) : 2 ^ Nat.clog 2 F ≤ 2 * F := by
  rcases Nat.lt_or_ge F 2 with h | h
  · have : F = 1 := by omega
    subst this
    simp
  · have hpos : 0 < Nat.clog 2 F := Nat.clog_pos one_lt_two h
    have hlt := Nat.pow_pred_clog_lt_self one_lt_two h
    obtain ⟨c, hc⟩ : ∃ c, Nat.clog 2 F = c + 1 := ⟨Nat.clog 2 F - 1, by omega⟩
    rw [hc] at hlt ⊢
    simp only [Nat.pred_succ] at hlt
    rw [pow_succ]
    omega

open Classical in
/-- A per-advice count `W σ ≤ F` gives `ConsistentBound` with `R` constant and `b = ⌈log₂ F⌉`. -/
theorem consistentBound_const {Ω : Type} [Fintype Ω] {m : ℕ} (A₁ : Ω → Bits m) (E : Ω → Prop) (F : ℕ)
    (hW : ∀ σ, (Finset.univ.filter fun ω => A₁ ω = σ ∧ E ω).card ≤ F) :
    ConsistentBound A₁ (fun _ => ()) (fun _ => ()) E (Nat.clog 2 F) := by
  intro σ ρ P
  refine le_trans ?_ ((hW σ).trans (Nat.le_pow_clog one_lt_two F))
  refine Finset.card_le_card fun ω hω => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
  exact ⟨hω.1, by simpa using hω.2⟩

/-- **`FixedAdvice pos` implies `DecodeHyp pos`.** -/
theorem decodeHyp_of_fixedAdvice (pos : ℕ → ℕ) (h : FixedAdvice pos) : DecodeHyp pos := by
  classical
  intro n wc m D Q k X tag G W A₁ A₂ hwc hXk hard hA₂
  set Wσ : Bits m → ℕ := fun σ => max (advWinners k tag G W A₁ A₂ σ) 1 with hWσ
  set F := Finset.univ.sup Wσ with hF
  have hF1 : 1 ≤ F := le_trans (le_max_right _ 1) (Finset.le_sup (f := Wσ) (Finset.mem_univ (fun _ => false)))
  obtain ⟨σ₀, -, hσ₀⟩ := Finset.exists_mem_eq_sup Finset.univ Finset.univ_nonempty Wσ
  refine ⟨Unit, inferInstance, fun _ => (), Nat.clog 2 F, ?_, ?_⟩
  · refine consistentBound_const A₁ _ F fun σ => ?_
    have h1 : advWinners k tag G W A₁ A₂ σ ≤ F := (le_max_left _ 1).trans (Finset.le_sup (f := Wσ) (Finset.mem_univ σ))
    refine le_trans (Finset.card_le_card fun ω hω => ?_) h1
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
    exact hω
  · have hfix := h n wc m D Q k X tag G W A₁ A₂ hwc hXk hard hA₂ σ₀
    have hnat : 2 ^ Nat.clog 2 F * 2 ^ ((k - X) * (n * wc)) ≤
        Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n) * Fintype.card (p3ModelT n wc).Ω := by
      refine le_trans (Nat.mul_le_mul_right _ (two_pow_clog_le hF1)) ?_
      rw [hF, hσ₀]
      exact hfix
    simp only [DecodeTarget, Fintype.card_unit, Nat.cast_one, one_mul]
    rw [one_mul] at hnat
    exact_mod_cast hnat

/-- **`FixedAdviceMulti pos` implies `DecodeHypMulti pos`.** -/
theorem decodeHypMulti_of_fixedAdvice (pos : ℕ → ℕ → ℕ) (h : FixedAdviceMulti pos) : DecodeHypMulti pos := by
  classical
  intro N n wc m D Q k X tags G W A₁ A₂ hwc hN hXk htags hard hA₂
  set Wσ : Bits m → ℕ := fun σ => max (advWinnersMulti k tags G W A₁ A₂ σ) 1 with hWσ
  set F := Finset.univ.sup Wσ with hF
  have hF1 : 1 ≤ F := le_trans (le_max_right _ 1) (Finset.le_sup (f := Wσ) (Finset.mem_univ (fun _ => false)))
  obtain ⟨σ₀, -, hσ₀⟩ := Finset.exists_mem_eq_sup Finset.univ Finset.univ_nonempty Wσ
  refine ⟨Unit, inferInstance, fun _ => (), Nat.clog 2 F, ?_, ?_⟩
  · refine consistentBound_const A₁ _ F fun σ => ?_
    have h1 : advWinnersMulti k tags G W A₁ A₂ σ ≤ F := (le_max_left _ 1).trans (Finset.le_sup (f := Wσ) (Finset.mem_univ σ))
    refine le_trans (Finset.card_le_card fun ω hω => ?_) h1
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
    exact hω
  · have hfix := h N n wc m D Q k X tags G W A₁ A₂ hwc hN hXk htags hard hA₂ σ₀
    have hnat : 2 ^ Nat.clog 2 F * 2 ^ ((N * (k - X)) * (n * wc)) ≤
        N * Nat.choose (N * (n * (Q + 1) + 2 * n)) (pos N n) * Fintype.card (p3ModelT n wc).Ω := by
      refine le_trans (Nat.mul_le_mul_right _ (two_pow_clog_le hF1)) ?_
      rw [hF, hσ₀]
      exact hfix
    simp only [DecodeTargetMulti, Fintype.card_unit, Nat.cast_one, one_mul]
    exact_mod_cast hnat

/-! ### `n10prime` at any `pos`, from the decode hypothesis alone -/

theorem n10primeAt_of_decodeHyp (pos : ℕ → ℕ) (hdec : DecodeHyp pos) : N10primeAt pos := by
  intro n wc m D Q k X tag G W hwc hXk hard A₁ A₂ hA₂
  obtain ⟨Red, hRed, R, b, hcons, htarget⟩ := hdec n wc m D Q k X tag G W A₁ A₂ hwc hXk hard hA₂
  exact n10prime_of_consistent n wc m Q k X (pos n) tag G W A₁ A₂ R b hcons htarget (labelBirthdayAll n wc tag G W)

theorem n10primeMultiAt_of_decodeHyp (pos : ℕ → ℕ → ℕ) (hdec : DecodeHypMulti pos) : N10primeMultiAt pos := by
  intro N n wc m D Q k X tags G W hwc hN hXk htags hard A₁ A₂ hA₂
  obtain ⟨Red, hRed, R, b, hcons, htarget⟩ := hdec N n wc m D Q k X tags G W A₁ A₂ hwc hN hXk htags hard hA₂
  exact n10primeMulti_of_consistent N n wc m Q k X (pos N n) tags G W A₁ A₂ R b hcons htarget
    fun s => labelBirthdayAll n wc (tags s) G (W s)

/-- `N10primeAt` at `3n` is `PousTweaked.n10prime`'s statement. -/
theorem n10primeAt_three : N10primeAt (fun n => 3 * n) = PousTweaked.N10primeT := rfl

/-- `N10primeMultiAt` at `3nN` is `PousTweaked.n10primeMulti`'s statement. -/
theorem n10primeMultiAt_three : N10primeMultiAt (fun N n => 3 * n * N) = PousTweaked.N10primeMultiT := rfl

/-- **`PousTweaked.n10prime` from the fixed-advice core** (at `pos = 3n`). -/
theorem n10prime_of_fixedAdvice3 (h : FixedAdvice3) : PousTweaked.N10primeT :=
  n10primeAt_three ▸ n10primeAt_of_decodeHyp _ (decodeHyp_of_fixedAdvice _ h)

/-- **`PousTweaked.n10primeMulti` from the fixed-advice core** (at `pos = 3nN`). -/
theorem n10primeMulti_of_fixedAdvice3 (h : FixedAdviceMulti3) : PousTweaked.N10primeMultiT :=
  n10primeMultiAt_three ▸ n10primeMultiAt_of_decodeHyp _ (decodeHypMulti_of_fixedAdvice _ h)

/-- **`n10prime` at the decode's `pos = 7n`**, from the fixed-advice core at `7n`. -/
theorem n10prime_of_fixedAdvice7 (h : FixedAdvice7) : N10primeAt posP3 :=
  n10primeAt_of_decodeHyp _ (decodeHyp_of_fixedAdvice _ h)

/-- **`n10primeMulti` at the decode's `pos = 7nN`**, from the fixed-advice core at `7nN`. -/
theorem n10primeMulti_of_fixedAdvice7 (h : FixedAdviceMulti7) : N10primeMultiAt posP3Multi :=
  n10primeMultiAt_of_decodeHyp _ (decodeHypMulti_of_fixedAdvice _ h)

end PousAssembly

end


/-! ════ Freshness.DecodeHypFalse ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `DecodeHyp` and `FixedAdvice` (with `max (·) 1`) are unsatisfiable

Take `k > n`. Then `ColumnHard G d k X` holds vacuously, since no holding reaches more than `n` tops, but
`DecodeHyp pos` still demands `|Red| · 2^b · 2^{(k−X)·n·wc} ≤ C · |Ω|` with `|Red| ≥ 1`. That fails once
`2^k > C · |Ω|`. `FixedAdvice pos` fails for the same reason: its `max (#winners) 1` is `1` when nothing wins.

So `n10prime_of_decode`, `n10prime_of_fixedAdvice3` and their `7n` and multi-segment forms are vacuous: they are proved,
but from false hypotheses. The corrected hypothesis (`AdviceBound`, `ZeroAdvice`) drops the `max`, and `n10prime`
follows from it directly (`Decode2.lean`).

The witness: `n = 1`, `wc = 1`, `m = D = Q = X = 0`, `k = C·|Ω| + 2`, `A₂` returning at once. The multi-segment forms
(`DecodeHypMulti`, `FixedAdviceMulti`) fall to the same witness at `N = 1`.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge
open scoped ENNReal

/-- The one-node graph with no edges. -/
def G1' : Labelling.TopoDAG 1 where
  par _ := ∅
  par_lt _ _ h := by simp at h

def tagZ : Bits 256 := fun _ => false
def WZ : Fin 1 → Lab 1 1 := fun _ _ _ => false
def A₁Z : (p3ModelT 1 1).Ω → Bits 0 := fun _ i => i.elim0
def A₂Z : Bits 0 → Fin 1 → Prog (p3ModelT 1 1) (Lab 1 1) := fun _ _ => .ret (WZ 0)

/-- With `k` above `n = 1`, `ColumnHard` holds vacuously. -/
theorem columnHard_vacuous (d k X : ℕ) (hk : 2 ≤ k) : ColumnHard G1' d k X := by
  intro c0 hc
  have : (colReach G1' c0 d).topWhole.card ≤ 1 := by
    simpa using Finset.card_le_univ (colReach G1' c0 d).topWhole
  omega

/-- The instance's `C · |Ω|`, plus `2`: the `k` that breaks the target. -/
noncomputable def kBad (pos : ℕ → ℕ) : ℕ :=
  Nat.choose (1 * (1 * (0 + 1) + 2 * 1)) (pos 1) * Fintype.card (p3ModelT 1 1).Ω + 2

theorem two_pow_kBad_gt (pos : ℕ → ℕ) :
    Nat.choose (1 * (1 * (0 + 1) + 2 * 1)) (pos 1) * Fintype.card (p3ModelT 1 1).Ω < 2 ^ kBad pos := by
  have := Nat.lt_two_pow_self (n := kBad pos)
  unfold kBad at this ⊢
  omega

/-- **`DecodeHyp pos` is false, for every `pos`.** -/
theorem not_decodeHyp (pos : ℕ → ℕ) : ¬ DecodeHyp pos := by
  intro h
  obtain ⟨Red, hRed, R, b, -, htarget⟩ :=
    h 1 1 0 0 0 (kBad pos) 0 tagZ G1' WZ A₁Z A₂Z one_pos (Nat.zero_le _)
      (columnHard_vacuous _ _ _ (by unfold kBad; omega)) (fun _ _ _ => ⟨le_of_eq rfl, le_of_eq rfl⟩)
  have hne : Nonempty Red := ⟨R (Classical.arbitrary _)⟩
  have hcard : 1 ≤ Fintype.card Red := Fintype.card_pos
  simp only [DecodeTarget, Nat.sub_zero, mul_one] at htarget
  have hnat : Fintype.card Red * 2 ^ b * 2 ^ kBad pos ≤
      Nat.choose (1 * (1 * (0 + 1) + 2 * 1)) (pos 1) * Fintype.card (p3ModelT 1 1).Ω := by
    exact_mod_cast htarget
  have h1 : 2 ^ kBad pos ≤ Fintype.card Red * 2 ^ b * 2 ^ kBad pos := by
    have : 1 ≤ Fintype.card Red * 2 ^ b := Nat.one_le_iff_ne_zero.2 (by positivity)
    calc 2 ^ kBad pos = 1 * 2 ^ kBad pos := (one_mul _).symm
      _ ≤ _ := Nat.mul_le_mul_right _ this
  have := two_pow_kBad_gt pos
  omega

/-- **`FixedAdvice pos` (with `max (·) 1`) is false, for every `pos`.** -/
theorem not_fixedAdvice (pos : ℕ → ℕ) : ¬ FixedAdvice pos :=
  fun h => not_decodeHyp pos (decodeHyp_of_fixedAdvice pos h)

theorem not_decodeHyp3 : ¬ DecodeHyp3 := not_decodeHyp _
theorem not_fixedAdvice3 : ¬ FixedAdvice3 := not_fixedAdvice _
theorem not_fixedAdvice7 : ¬ FixedAdvice7 := not_fixedAdvice _

/-- The multi-segment instance's `N · C · |Ω|` at `N = 1`, plus `2`. -/
noncomputable def kBadMulti (pos : ℕ → ℕ → ℕ) : ℕ :=
  Nat.choose (1 * (1 * (0 + 1) + 2 * 1)) (pos 1 1) * Fintype.card (p3ModelT 1 1).Ω + 2

/-- **`DecodeHypMulti pos` is false, for every `pos`**: the same witness at `N = 1`. -/
theorem not_decodeHypMulti (pos : ℕ → ℕ → ℕ) : ¬ DecodeHypMulti pos := by
  intro h
  obtain ⟨Red, hRed, R, b, -, htarget⟩ :=
    h 1 1 1 0 0 0 (kBadMulti pos) 0 (fun _ => tagZ) G1' (fun _ => WZ) A₁Z (fun σ _ => A₂Z σ) one_pos le_rfl
      (Nat.zero_le _) (fun a b _ => Subsingleton.elim a b)
      (columnHard_vacuous _ _ _ (by unfold kBadMulti; omega)) (fun _ _ _ _ => ⟨le_of_eq rfl, le_of_eq rfl⟩)
  have hne : Nonempty Red := ⟨R (Classical.arbitrary _)⟩
  have hcard : 1 ≤ Fintype.card Red := Fintype.card_pos
  set C := Nat.choose (1 * (1 * (0 + 1) + 2 * 1)) (pos 1 1) * Fintype.card (p3ModelT 1 1).Ω with hC
  have hnat : Fintype.card Red * 2 ^ b * 2 ^ kBadMulti pos ≤ C := by
    have e : (1 * (kBadMulti pos - 0)) * (1 * 1) = kBadMulti pos := by omega
    unfold DecodeTargetMulti at htarget
    rw [e] at htarget
    rw [hC]
    have h' := htarget
    simp only [Nat.cast_one, one_mul] at h'
    exact_mod_cast h'
  have h1 : 2 ^ kBadMulti pos ≤ Fintype.card Red * 2 ^ b * 2 ^ kBadMulti pos := by
    have : 1 ≤ Fintype.card Red * 2 ^ b := Nat.one_le_iff_ne_zero.2 (by positivity)
    calc 2 ^ kBadMulti pos = 1 * 2 ^ kBadMulti pos := (one_mul _).symm
      _ ≤ _ := Nat.mul_le_mul_right _ this
  have h2 : C < 2 ^ kBadMulti pos := by
    have := Nat.lt_two_pow_self (n := kBadMulti pos)
    unfold kBadMulti at this ⊢
    omega
  omega

/-- **`FixedAdviceMulti pos` (with `max (·) 1`) is false, for every `pos`.** -/
theorem not_fixedAdviceMulti (pos : ℕ → ℕ → ℕ) : ¬ FixedAdviceMulti pos :=
  fun h => not_decodeHypMulti pos (decodeHypMulti_of_fixedAdvice pos h)

theorem not_decodeHypMulti3 : ¬ DecodeHypMulti3 := not_decodeHypMulti _
theorem not_fixedAdviceMulti3 : ¬ FixedAdviceMulti3 := not_fixedAdviceMulti _
theorem not_fixedAdviceMulti7 : ¬ FixedAdviceMulti7 := not_fixedAdviceMulti _

end PousAssembly

end


/-! ════ Freshness.Decode2 ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The corrected chain: `ZeroAdvice → AdviceBound → n10prime`

The per-advice count `AdviceBound` has no `max`, so it holds trivially when nothing wins. It gives `n10prime`
directly: summing the per-`σ` count over the `2^m` advice strings gives `pr ≤ 2^m · C / 2^{(k−X)·n·wc}`
(`n10primeAt_of_adviceBound`). No reduction `R` and no fibre bound `b` are involved.

`AdviceBound` follows from the **zero-advice core** `ZeroAdvice`, by one inclusion. When `A₁ ω = σ`, the run is the
fixed program family `A₂ σ`, so `{ω | A₁ ω = σ ∧ win}` is contained in `{ω | A₂ σ wins}`
(`adviceBound_of_zeroAdvice`). So `n10prime` rests on a statement about advice-free programs. The paper proof of that
statement, the lucky-guess lemma, is in `internal/p3-decode/inverse-decode.md`.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge
open scoped ENNReal

variable {n wc : ℕ}

/-- `#E · S ≤ B · |Ω|` gives `pr E ≤ B / S`. -/
theorem pr_le_of_card_mul_le {Ω : Type} [Fintype Ω] (E : Ω → Prop) [DecidablePred E] (B S : ℝ≥0∞)
    (hS0 : S ≠ 0) (hST : S ≠ ⊤)
    (h : ((Finset.univ.filter E).card : ℝ≥0∞) * S ≤ B * Fintype.card Ω) : pr E ≤ B / S := by
  rw [pr_def, ENNReal.le_div_iff_mul_le (Or.inl hS0) (Or.inl hST)]
  have hsplit : ((Finset.univ.filter E).card : ℝ≥0∞) / (Fintype.card Ω : ℝ≥0∞) * S =
      ((Finset.univ.filter E).card : ℝ≥0∞) * S / (Fintype.card Ω : ℝ≥0∞) := by
    rw [div_eq_mul_inv, div_eq_mul_inv, mul_right_comm]
  rw [hsplit]
  exact ENNReal.div_le_of_le_mul h

open Classical in
/-- **Summing the per-advice count.** `#{ω | A₁ ω = σ ∧ E ω} · S ≤ C · |Ω|` for every `σ` gives
`pr E ≤ 2^m · C / S`. -/
theorem pr_le_of_advice {Ω : Type} [Fintype Ω] {m : ℕ} (A₁ : Ω → Bits m) (E : Ω → Prop) (C S : ℕ) (hS : 0 < S)
    (h : ∀ σ, (Finset.univ.filter fun ω => A₁ ω = σ ∧ E ω).card * S ≤ C * Fintype.card Ω) :
    pr E ≤ 2 ^ m * (C : ℝ≥0∞) / (S : ℝ≥0∞) := by
  refine pr_le_of_card_mul_le E _ _ (by exact_mod_cast hS.ne') (ENNReal.natCast_ne_top _) ?_
  have hsum : (Finset.univ.filter E).card * S ≤ 2 ^ m * C * Fintype.card Ω := by
    rw [Finset.card_eq_sum_card_fiberwise (f := A₁) (t := Finset.univ) (fun _ _ => Finset.mem_univ _),
      Finset.sum_mul]
    calc ∑ σ ∈ (Finset.univ : Finset (Bits m)), ((Finset.univ.filter E).filter fun ω => A₁ ω = σ).card * S
        ≤ ∑ _σ ∈ (Finset.univ : Finset (Bits m)), C * Fintype.card Ω := by
          refine Finset.sum_le_sum fun σ _ => le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card ?_)) (h σ)
          intro ω hω
          simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
          exact ⟨hω.2, hω.1⟩
      _ = 2 ^ m * C * Fintype.card Ω := by
          rw [Finset.sum_const, Finset.card_univ, smul_eq_mul]
          simp only [Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
          ring
  exact_mod_cast hsum

/-! ### `AdviceBound → n10prime` (at any `pos`) -/

theorem n10primeAt_of_adviceBound (pos : ℕ → ℕ) (h : AdviceBound pos) : N10primeAt pos := by
  classical
  intro n wc m D Q k X tag G W hwc hXk hard A₁ A₂ hA₂
  show (pr fun ω => Win1 k tag G W A₁ A₂ ω) ≤ _
  rw [pr_partition (fun ω => Win1 k tag G W A₁ A₂ ω) (fun ω : (p3ModelT n wc).Ω => labCollT tag G W ω)]
  refine add_le_add ?_ (hbirthdayT_of_labelBirthdayT k tag G W A₁ A₂ (labelBirthdayAll n wc tag G W))
  have hpr := pr_le_of_advice A₁ (fun ω => Win1 k tag G W A₁ A₂ ω ∧ ¬ labCollT tag G W ω)
    (Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n)) (2 ^ ((k - X) * (n * wc))) (by positivity)
    fun σ => le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card fun ω hω => by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
      exact hω)) (h n wc m D Q k X tag G W A₁ A₂ hwc hXk hard hA₂ σ)
  refine hpr.trans (le_of_eq ?_)
  simp only [N10primeBoundT, Nat.cast_one, one_mul, Nat.cast_pow, Nat.cast_ofNat]

theorem n10primeMultiAt_of_adviceBound (pos : ℕ → ℕ → ℕ) (h : AdviceBoundMulti pos) : N10primeMultiAt pos := by
  classical
  intro N n wc m D Q k X tags G W hwc hN hXk htags hard A₁ A₂ hA₂
  show (pr fun ω => WinMulti k tags G W A₁ A₂ ω) ≤ _
  rw [pr_partition (fun ω => WinMulti k tags G W A₁ A₂ ω) (fun ω : (p3ModelT n wc).Ω => CollMulti tags G W ω)]
  refine add_le_add ?_ ?_
  · have hpr := pr_le_of_advice A₁ (fun ω => WinMulti k tags G W A₁ A₂ ω ∧ ¬ CollMulti tags G W ω)
      (N * Nat.choose (N * (n * (Q + 1) + 2 * n)) (pos N n)) (2 ^ ((N * (k - X)) * (n * wc))) (by positivity)
      fun σ => le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card fun ω hω => by
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
        exact hω)) (h N n wc m D Q k X tags G W A₁ A₂ hwc hN hXk htags hard hA₂ σ)
    refine hpr.trans (le_of_eq ?_)
    simp only [N10primeBoundT, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat, div_eq_mul_inv]
    ring
  · calc pr (fun ω => WinMulti k tags G W A₁ A₂ ω ∧ CollMulti tags G W ω)
        ≤ pr (fun ω => ∃ s ∈ (Finset.univ : Finset (Fin N)), labCollT (tags s) G (W s) ω) :=
          pr_mono fun ω h => by
            obtain ⟨s, hs⟩ := h.2
            exact ⟨s, Finset.mem_univ _, hs⟩
      _ ≤ ∑ s ∈ (Finset.univ : Finset (Fin N)), pr (fun ω => labCollT (tags s) G (W s) ω) := pr_exists_le _ _
      _ ≤ ∑ _s ∈ (Finset.univ : Finset (Fin N)), (((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) :=
          Finset.sum_le_sum fun s _ => labelBirthdayAll n wc (tags s) G (W s)
      _ = (N : ℝ≥0∞) * ((((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ = (((N * (2 * n) ^ 2 : ℕ) : ℝ≥0∞)) / 2 ^ (n * wc) := by
          push_cast
          rw [mul_div_assoc]
      _ ≤ (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
          refine ENNReal.div_le_div_right ?_ _
          have : N * (2 * n) ^ 2 ≤ (2 * N * n) ^ 2 := by
            calc N * (2 * n) ^ 2 ≤ (N * N) * (2 * n) ^ 2 := Nat.mul_le_mul_right _ (Nat.le_mul_self N)
              _ = (2 * N * n) ^ 2 := by ring
          exact_mod_cast this

/-! ### `ZeroAdvice → AdviceBound`: the advice string only selects a fixed program family -/

theorem adviceBound_of_zeroAdvice (pos : ℕ → ℕ) (h : ZeroAdvice pos) : AdviceBound pos := by
  classical
  intro n wc m D Q k X tag G W A₁ A₂ hwc hXk hard hA₂ σ
  refine le_trans (Nat.mul_le_mul_right _ ?_) (h n wc D Q k X tag G W (A₂ σ) hwc hXk hard (hA₂ σ))
  refine Finset.card_le_card fun ω hω => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
  obtain ⟨hσ, hwin, hcoll⟩ := hω
  refine ⟨?_, hcoll⟩
  unfold Win1 at hwin
  rw [hσ] at hwin
  exact hwin

theorem adviceBoundMulti_of_zeroAdvice (pos : ℕ → ℕ → ℕ) (h : ZeroAdviceMulti pos) : AdviceBoundMulti pos := by
  classical
  intro N n wc m D Q k X tags G W A₁ A₂ hwc hN hXk htags hard hA₂ σ
  refine le_trans (Nat.mul_le_mul_right _ ?_) (h N n wc D Q k X tags G W (A₂ σ) hwc hN hXk htags hard (hA₂ σ))
  refine Finset.card_le_card fun ω hω => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
  obtain ⟨hσ, hwin, hcoll⟩ := hω
  refine ⟨?_, hcoll⟩
  unfold WinMulti at hwin
  rw [hσ] at hwin
  exact hwin

/-! ### The pinned shapes, from the zero-advice core -/

/-- **`PousTweaked.n10prime` from the zero-advice core** (at `pos = 3n`). -/
theorem n10prime_of_zeroAdvice3 (h : ZeroAdvice3) : PousTweaked.N10primeT :=
  n10primeAt_three ▸ n10primeAt_of_adviceBound _ (adviceBound_of_zeroAdvice _ h)

/-- **`PousTweaked.n10primeMulti` from the zero-advice core** (at `pos = 3nN`). -/
theorem n10primeMulti_of_zeroAdvice3 (h : ZeroAdviceMulti3) : PousTweaked.N10primeMultiT :=
  n10primeMultiAt_three ▸ n10primeMultiAt_of_adviceBound _ (adviceBoundMulti_of_zeroAdvice _ h)

/-- `n10prime` at any `pos`, from the zero-advice core at that `pos`. -/
theorem n10primeAt_of_zeroAdvice (pos : ℕ → ℕ) (h : ZeroAdvice pos) : N10primeAt pos :=
  n10primeAt_of_adviceBound _ (adviceBound_of_zeroAdvice _ h)

theorem n10primeMultiAt_of_zeroAdvice (pos : ℕ → ℕ → ℕ) (h : ZeroAdviceMulti pos) : N10primeMultiAt pos :=
  n10primeMultiAt_of_adviceBound _ (adviceBoundMulti_of_zeroAdvice _ h)

/-! ### Restricted to `0 < n` and `Q₀ ≤ Q`: the same chain

The unrestricted statements are false at `pos = 9n + 1` (`PosTooLarge.lean`), so the lucky-guess bound is stated for
`0 < n` and `Q ≥ 27`. The proofs are the ones above, with the two hypotheses passed through. -/

theorem n10primeAtGe_of_adviceBoundGe (Q₀ : ℕ) (pos : ℕ → ℕ) (h : AdviceBoundGe Q₀ pos) :
    N10primeAtGe Q₀ pos := by
  classical
  intro n wc m D Q k X tag G W hn hQ hwc hXk hard A₁ A₂ hA₂
  show (pr fun ω => Win1 k tag G W A₁ A₂ ω) ≤ _
  rw [pr_partition (fun ω => Win1 k tag G W A₁ A₂ ω) (fun ω : (p3ModelT n wc).Ω => labCollT tag G W ω)]
  refine add_le_add ?_ (hbirthdayT_of_labelBirthdayT k tag G W A₁ A₂ (labelBirthdayAll n wc tag G W))
  have hpr := pr_le_of_advice A₁ (fun ω => Win1 k tag G W A₁ A₂ ω ∧ ¬ labCollT tag G W ω)
    (Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n)) (2 ^ ((k - X) * (n * wc))) (by positivity)
    fun σ => le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card fun ω hω => by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
      exact hω)) (h n wc m D Q k X tag G W A₁ A₂ hn hQ hwc hXk hard hA₂ σ)
  refine hpr.trans (le_of_eq ?_)
  simp only [N10primeBoundT, Nat.cast_one, one_mul, Nat.cast_pow, Nat.cast_ofNat]

theorem n10primeMultiAtGe_of_adviceBoundMultiGe (Q₀ : ℕ) (pos : ℕ → ℕ → ℕ) (h : AdviceBoundMultiGe Q₀ pos) :
    N10primeMultiAtGe Q₀ pos := by
  classical
  intro N n wc m D Q k X tags G W hn hQ hwc hN hXk htags hard A₁ A₂ hA₂
  show (pr fun ω => WinMulti k tags G W A₁ A₂ ω) ≤ _
  rw [pr_partition (fun ω => WinMulti k tags G W A₁ A₂ ω) (fun ω : (p3ModelT n wc).Ω => CollMulti tags G W ω)]
  refine add_le_add ?_ ?_
  · have hpr := pr_le_of_advice A₁ (fun ω => WinMulti k tags G W A₁ A₂ ω ∧ ¬ CollMulti tags G W ω)
      (N * Nat.choose (N * (n * (Q + 1) + 2 * n)) (pos N n)) (2 ^ ((N * (k - X)) * (n * wc))) (by positivity)
      fun σ => le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card fun ω hω => by
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
        exact hω)) (h N n wc m D Q k X tags G W A₁ A₂ hn hQ hwc hN hXk htags hard hA₂ σ)
    refine hpr.trans (le_of_eq ?_)
    simp only [N10primeBoundT, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat, div_eq_mul_inv]
    ring
  · calc pr (fun ω => WinMulti k tags G W A₁ A₂ ω ∧ CollMulti tags G W ω)
        ≤ pr (fun ω => ∃ s ∈ (Finset.univ : Finset (Fin N)), labCollT (tags s) G (W s) ω) :=
          pr_mono fun ω h => by
            obtain ⟨s, hs⟩ := h.2
            exact ⟨s, Finset.mem_univ _, hs⟩
      _ ≤ ∑ s ∈ (Finset.univ : Finset (Fin N)), pr (fun ω => labCollT (tags s) G (W s) ω) := pr_exists_le _ _
      _ ≤ ∑ _s ∈ (Finset.univ : Finset (Fin N)), (((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) :=
          Finset.sum_le_sum fun s _ => labelBirthdayAll n wc (tags s) G (W s)
      _ = (N : ℝ≥0∞) * ((((2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ = (((N * (2 * n) ^ 2 : ℕ) : ℝ≥0∞)) / 2 ^ (n * wc) := by
          push_cast
          rw [mul_div_assoc]
      _ ≤ (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
          refine ENNReal.div_le_div_right ?_ _
          have : N * (2 * n) ^ 2 ≤ (2 * N * n) ^ 2 := by
            calc N * (2 * n) ^ 2 ≤ (N * N) * (2 * n) ^ 2 := Nat.mul_le_mul_right _ (Nat.le_mul_self N)
              _ = (2 * N * n) ^ 2 := by ring
          exact_mod_cast this

theorem adviceBoundGe_of_zeroAdviceGe (Q₀ : ℕ) (pos : ℕ → ℕ) (h : ZeroAdviceGe Q₀ pos) : AdviceBoundGe Q₀ pos := by
  classical
  intro n wc m D Q k X tag G W A₁ A₂ hn hQ hwc hXk hard hA₂ σ
  refine le_trans (Nat.mul_le_mul_right _ ?_) (h n wc D Q k X tag G W (A₂ σ) hn hQ hwc hXk hard (hA₂ σ))
  refine Finset.card_le_card fun ω hω => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
  obtain ⟨hσ, hwin, hcoll⟩ := hω
  refine ⟨?_, hcoll⟩
