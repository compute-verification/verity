/-! ════ BandChainModel ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace Pous.BandChain

open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal


/-- The nodes of `VC` whose own row fits in `D` rounds: at most `D` calls. -/
def shortRows {N : ℕ} (G : TopoDAG N) (VC : Finset (Fin N)) (D : ℕ) : Finset (Fin N) :=
  VC.filter fun v => ovCalls G v ≤ D

/-- **Target: the chain clock.** In the chain game on any DAG, from any holding `P₀` (labels, chaining values at any
position, dropped `r`s), a label known after `t` rounds is a seed of `P₀` (held; the row of a held chaining value; the
block of a held `r`, or the row of a held pad-call `r`), or its own row has at most `t` calls. -/
def ChainClock : Prop :=
  ∀ (N : ℕ) (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) (v : Fin N),
    v ∈ (ChainKnow.reach G P₀ t).labs → v ∈ P₀.seeds G ∨ ovCalls G v ≤ t

/-- **Target: the weighted chain certificate.** A holding priced at most `s` has at most `s` seeds
(`card_seeds_le_size`), so with `ChainClock` it knows at most `s + |shortRows G VC D|` challenge labels after `D`
rounds. -/
def WeightedChainCert : Prop :=
  ∀ (N : ℕ) (G : TopoDAG N) (VC : Finset (Fin N)) (c ℓ : ℕ) (s : ℚ) (D k : ℕ),
    s + (shortRows G VC D).card < k → ChainHard G VC c ℓ s D k

/-- **Target: the band with in-degree `d ≥ D` is `(B − D − 1, D, B)`-hard in the chain game**, as dense is
(`chainDense_hard`). Explicit parameters: in-degree `d`, `B` blocks, `D` rounds, and storage bound `B − D − 1` labels
(a chaining value priced `1 + c/ℓ`, a dropped `r` 1), with every block a challenge. -/
def BandChainHard : Prop :=
  ∀ (B d D c ℓ : ℕ), D ≤ d → D + 1 ≤ B →
    ChainHard (bandDAG B d) Finset.univ c ℓ ((B - D - 1 : ℕ) : ℚ) D B

/-- **Target: `d ≥ D` cannot be dropped (the gap attack).** With `d + 1 ≤ D`, the holding of every label except the
positive multiples of `d + 1`, priced `B − ⌊(B − 1)/(d + 1)⌋`, knows all `B` labels after `D` rounds. -/
def BandGapAttack : Prop :=
  ∀ (B d D c ℓ : ℕ), d + 1 ≤ D →
    ¬ ChainHard (bandDAG B d) Finset.univ c ℓ ((B - (B - 1) / (d + 1) : ℕ) : ℚ) D B


/-- **Hypothesis of §4: `ChainExPostFacto` on any DAG.** The same statement with `Dense.completeDAG B` and `labelOv`
replaced by any `G : TopoDAG B` and `labelG G`. Every term is unchanged: the labeller makes `Σ_v ovCalls G v ≤
B(B + 1)/2` calls on any DAG on `Fin B`, so `nPos B Q` still bounds the positions; a fresh item is still named by two
positions and a row; and the collision term is the amended `nPos²/2^(ℓ+c)` (red-team §35: a pad-call input is the fixed
`padBlk` beside an `(ℓ + c)`-bit chaining value). -/
def ChainExPostFactoG : Prop :=
  ∀ (B ℓ c m s D Q k : ℕ) (G : TopoDAG B) (dom : ℕ → Bits c) (Wb : Fin B → Bits ℓ),
    Function.Injective (fun i : Fin B => dom i) → ChainHard G Finset.univ c ℓ s D k →
    ∀ (A₁ : Equiv.Perm (Bits (ℓ + (ℓ + c))) → Bits m)
      (A₂ : Bits m → Fin B → Pous.OracleProg (idealPerm (ℓ + (ℓ + c))) (Bits ℓ)),
      (∀ σ i, (A₂ σ i).Bounded D Q) →
      pr (fun π : Equiv.Perm (Bits (ℓ + (ℓ + c))) =>
          k ≤ (Finset.univ.filter fun i =>
            (A₂ (A₁ π) i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG G π dom Wb i).card)
        ≤ 2 ^ m * 2 * ((((nPos B Q) ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * s) +
          (((nPos B Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c)

/-- **Target: `ChainExPostFactoG` is the DAG-generic form of `ChainExPostFacto`.** At `G = Dense.completeDAG B` it is
exactly `ChainExPostFacto`, since `labelG` on the complete DAG is `labelOv`. -/
def ChainExPostFactoGSpec : Prop := ChainExPostFactoG → ChainExPostFacto


/-- **Target: the glue.** With `d ≥ D`, `ChainExPostFactoG` and `BandChainHard` give `TimedINC` for the band scheme
with dense's `chainPi B ℓ c D Q β`: the port of `chain_timedINC`, for explicit `B`, `d`, `ℓ`, `c`, `D`, `Q`, `β`. -/
def BandTimedINC : Prop :=
  ChainExPostFactoG → ∀ (B d ℓ c D Q β : ℕ) [NeZero B] (dom : ℕ → Bits c),
    D ≤ d → D + 1 ≤ B → Function.Injective (fun i : Fin B => dom i) →
    TimedINC (chainBand B d ℓ c dom) D Q β (chainPi B ℓ c D Q β)

/-- **The band scheme meets the requirement at the dense chain deployment point** (`chain_meets_64`): 64 KiB labels,
`B = 512`, in-degree `d`, capacity 512, any salt, sequential reveal, `D = 5` rounds and `Q = 2^20` queries of `Π₂^{±1}`
per answer, `k = 111`, `ε = 2^-128`. -/
def ChainBandMeets64 (d : ℕ) : Prop :=
  ∀ salt : Bits 256,
    Pous.Meets (chainBand (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)) .sequential 5 (2 ^ 20) 111
      ((2⁻¹ : ℝ≥0∞) ^ 128)

/-- **Target: the band deployment, given `ChainExPostFactoG`**, for every in-degree `d ≥ D = 5`, with the dense chain
certificate's numbers unchanged (`β = 265253616`, `k = 111`). -/
def BandMeets64 : Prop := ChainExPostFactoG → ∀ d : ℕ, 5 ≤ d → ChainBandMeets64 d

end Pous.BandChain

end


/-! ════ BandChain ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace Pous.BandChain

open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal


section Clock

variable {N : ℕ}

/-- **The clock invariant.** After `t` rounds from `P₀`, on a row with no held chaining value:
1. a known chaining value `h_{v,j}` has `j ≤ t`;
2. a known dropped `r_{v,j}` that was not held has `j ≤ t`;
and every known label is a seed of `P₀` or its row has at most `t` calls. -/
theorem clock_invariant (G : TopoDAG N) (P₀ : ChainKnow N) : ∀ t,
    (∀ p ∈ (ChainKnow.reach G P₀ t).hs, p.2 ≠ 0 →
        p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst → p.2 ≤ t) ∧
    (∀ p ∈ (ChainKnow.reach G P₀ t).rs, p ∉ P₀.rs →
        p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst → p.2 ≤ t) ∧
    (∀ v ∈ (ChainKnow.reach G P₀ t).labs, v ∈ P₀.seeds G ∨ ovCalls G v ≤ t) := by
  intro t
  induction t with
  | zero =>
    refine ⟨?_, ?_, ?_⟩
    · intro p hp h0 hH
      exact absurd (Finset.mem_image.2 ⟨p, Finset.mem_filter.2 ⟨hp, h0⟩, rfl⟩) hH
    · intro p hp hn; exact absurd hp hn
    · intro v hv
      rw [ChainKnow.reach, mem_read_labs] at hv
      left
      unfold ChainKnow.seeds
      rcases hv with hv | hv
      · exact Finset.mem_union_left _ (Finset.mem_union_left _ hv)
      · exact Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨_, hv, by simp⟩)
  | succ t ih =>
    obtain ⟨ih1, ih2, ih3⟩ := ih
    set K := ChainKnow.reach G P₀ t with hK
    have hKs : ChainKnow.reach G P₀ (t + 1) = K.round G := rfl
    -- a call that can be made in round `t + 1` has index at most `t + 1`
    have hcall : ∀ p : Fin N × ℕ, K.canCall G p.1 p.2 →
        p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst → p.2 ≤ t + 1 := by
      rintro p ⟨hj1, -, -, hprev⟩ hH
      rcases hprev with h1 | hprev
      · omega
      · by_cases h0 : p.2 - 1 = 0
        · omega
        · have := ih1 _ hprev h0 hH
          simp only at this
          omega
    have h2 : ∀ p ∈ (K.round G).rs, p ∉ P₀.rs →
        p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst → p.2 ≤ t + 1 := by
      intro p hp hn hH
      rcases mem_round_rs G K p hp with hp' | hc
      · have := ih2 p hp' hn hH; omega
      · exact hcall p hc hH
    refine ⟨?_, ?_, ?_⟩
    · intro p hp h0 hH
      rw [hKs] at hp
      rcases mem_round_hs G K p hp with hp' | hc | ⟨-, hnext, -⟩
      · have := ih1 p hp' h0 hH; omega
      · exact hcall p hc hH
      · have := ih1 _ hnext (by simp) hH
        simp only at this
        omega
    · rw [hKs]; exact h2
    · intro v hv
      rw [hKs, mem_round_labs] at hv
      rcases hv with (hv | ⟨p, hph, hpr, hb⟩) | hread
      · rcases ih3 v hv with h | h
        · exact Or.inl h
        · exact Or.inr (by omega)
      · by_cases hn : p ∈ P₀.rs
        · left
          unfold ChainKnow.seeds
          refine Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨p, hn, ?_⟩)
          have hne : p.2 ≠ ovCalls G p.1 := fun h => by rw [h, ovBlock_pad] at hb; simp at hb
          simp [hne, hb]
        · rcases ih3 v ((chain_invariant G P₀ t).2.2.1 p hpr hn v hb) with h | h
          · exact Or.inl h
          · exact Or.inr (by omega)
      · by_cases hn : (v, ovCalls G v) ∈ P₀.rs
        · left
          unfold ChainKnow.seeds
          exact Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨_, hn, by simp⟩)
        · by_cases hH : v ∈ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst
          · left
            unfold ChainKnow.seeds
            exact Finset.mem_union_left _ (Finset.mem_union_right _ hH)
          · exact Or.inr (h2 _ hread hn hH)

/-- **`ChainClock`, proved.** -/
theorem chain_clock : ChainClock := fun _ G P₀ t v hv => (clock_invariant G P₀ t).2.2 v hv

end Clock


/-- **`WeightedChainCert`, proved.** The known challenge labels are seeds or short rows, and there are at most `s`
seeds (`card_seeds_le_size`). -/
theorem weighted_chain_cert : WeightedChainCert := by
  intro N G VC c ℓ s D k hk P₀ hsize
  have hsub : VC.filter (fun v => v ∈ (ChainKnow.reach G P₀ D).labs) ⊆ P₀.seeds G ∪ shortRows G VC D := by
    intro v hv
    rw [Finset.mem_filter] at hv
    rcases chain_clock N G P₀ D v hv.2 with h | h
    · exact Finset.mem_union_left _ h
    · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hv.1, h⟩)
  have h1 := (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
  have h2 := (card_seeds_le_size G c ℓ P₀).trans hsize
  have h3 : ((VC.filter fun v => v ∈ (ChainKnow.reach G P₀ D).labs).card : ℚ) < k :=
    calc ((VC.filter fun v => v ∈ (ChainKnow.reach G P₀ D).labs).card : ℚ)
        ≤ ((P₀.seeds G).card : ℚ) + (shortRows G VC D).card := by exact_mod_cast h1
      _ ≤ s + (shortRows G VC D).card := by linarith
      _ < k := hk
  exact_mod_cast h3

section Rows

variable {N : ℕ}

/-- A row's call count is its in-degree plus the pad call. -/
theorem ovCalls_eq (G : TopoDAG N) (v : Fin N) : ovCalls G v = (G.par v).card + 1 := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]

/-- Node `v` has at most `v` parents. -/
theorem card_par_le (G : TopoDAG N) (v : Fin N) : (G.par v).card ≤ v.val := by
  calc (G.par v).card ≤ (Finset.range v.val).card :=
        Finset.card_le_card_of_injOn (fun u => u.val)
          (fun u hu => Finset.mem_range.2 (Fin.lt_def.1 (G.par_lt v u hu)))
          (fun a _ b _ h => Fin.ext h)
    _ = v.val := Finset.card_range _

/-- **Short rows are among the first `D`** when every node from `D` on has its `D` predecessors as parents. -/
theorem card_shortRows_le (G : TopoDAG N) (D : ℕ)
    (hG : ∀ v : Fin N, D ≤ v.val → ∀ u : Fin N, u < v → v.val ≤ u.val + D → u ∈ G.par v) :
    (shortRows G Finset.univ D).card ≤ D := by
  have hsub : shortRows G Finset.univ D ⊆ Finset.univ.filter fun v : Fin N => v.val < D := by
    intro v hv
    simp only [shortRows, Finset.mem_filter, Finset.mem_univ, true_and] at hv ⊢
    by_contra h
    have hD : D ≤ v.val := by omega
    have : D ≤ (G.par v).card :=
      Finset.le_card_of_inj_on_range (fun i => (⟨v.val - 1 - i, by omega⟩ : Fin N))
        (fun i hi => hG v hD _ (Fin.lt_def.2 (by simp only; omega)) (by simp only; omega))
        (fun i hi j hj h => by simp only [Fin.mk.injEq] at h; omega)
    rw [ovCalls_eq] at hv
    omega
  refine (Finset.card_le_card hsub).trans ?_
  calc (Finset.univ.filter fun v : Fin N => v.val < D).card ≤ (Finset.range D).card :=
        Finset.card_le_card_of_injOn (fun v => v.val)
          (fun v hv => Finset.mem_range.2 (Finset.mem_filter.1 hv).2) (fun a _ b _ h => Fin.ext h)
    _ = D := Finset.card_range _

/-- **The first `D` rows are short** when `D ≤ N`: row `v < D` has at most `v + 1 ≤ D` calls. -/
theorem le_card_shortRows (G : TopoDAG N) (D : ℕ) (hDN : D ≤ N) : D ≤ (shortRows G Finset.univ D).card := by
  rcases Nat.eq_zero_or_pos D with hD0 | hDpos
  · omega
  have hN : 0 < N := by omega
  refine Finset.le_card_of_inj_on_range (fun i => (⟨i % N, Nat.mod_lt _ hN⟩ : Fin N)) (fun i hi => ?_)
    (fun i hi j hj h => ?_)
  · simp only [shortRows, Finset.mem_filter, Finset.mem_univ, true_and]
    have h1 := card_par_le G ⟨i % N, Nat.mod_lt _ hN⟩
    have h2 := Nat.mod_le i N
    rw [ovCalls_eq]
    simp only at h1
    omega
  · simp only [Fin.mk.injEq] at h
    rwa [Nat.mod_eq_of_lt (by omega : i < N), Nat.mod_eq_of_lt (by omega : j < N)] at h

end Rows

/-- The band with `d ≥ D` gives every node from `D` on its `D` predecessors as parents. -/
theorem band_has_preds (B d D : ℕ) (hd : D ≤ d) :
    ∀ v : Fin B, D ≤ v.val → ∀ u : Fin B, u < v → v.val ≤ u.val + D → u ∈ (bandDAG B d).par v :=
  fun _ _ _ huv hle => Finset.mem_filter.2 ⟨Finset.mem_univ _, huv, by omega⟩

/-- **The band with `d ≥ D` has exactly `D` short rows** (rows `0 … D − 1`), dense's loss. -/
theorem card_shortRows_band (B d D : ℕ) (hd : D ≤ d) (hDB : D ≤ B) :
    (shortRows (bandDAG B d) Finset.univ D).card = D :=
  le_antisymm (card_shortRows_le _ D (band_has_preds B d D hd)) (le_card_shortRows _ D hDB)

/-- **`BandChainHard`, proved.** -/
theorem band_chain_hard : BandChainHard := by
  intro B d D c ℓ hd hB
  refine weighted_chain_cert B (bandDAG B d) Finset.univ c ℓ _ D B ?_
  have hc := card_shortRows_band B d D hd (by omega)
  have h : B - D - 1 + (shortRows (bandDAG B d) Finset.univ D).card < B := by omega
  exact_mod_cast h


section Attack

variable {N : ℕ}

theorem reach_labs_succ (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) :
    (ChainKnow.reach G P₀ t).labs ⊆ (ChainKnow.reach G P₀ (t + 1)).labs :=
  labs_subset_round G _

theorem reach_labs_mono (G : TopoDAG N) (P₀ : ChainKnow N) {t t' : ℕ} (h : t ≤ t') :
    (ChainKnow.reach G P₀ t).labs ⊆ (ChainKnow.reach G P₀ t').labs := by
  induction h with
  | refl => exact le_rfl
  | step _ ih => exact ih.trans (reach_labs_succ G P₀ _)

theorem held_subset_reach (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) :
    P₀.labs ⊆ (ChainKnow.reach G P₀ t).labs :=
  Finset.Subset.trans (fun v hv => (mem_read_labs G P₀ v).2 (Or.inl hv)) (reach_labs_mono G P₀ (Nat.zero_le t))

/-- A call that can be made is made: its `h` and `r` are known after the round. -/
theorem mem_round_of_canCall (G : TopoDAG N) (K : ChainKnow N) (v : Fin N) (j : ℕ) (hc : K.canCall G v j)
    (hj : j < N + 2) : (v, j) ∈ (K.round G).hs ∧ (v, j) ∈ (K.round G).rs := by
  have hpos : (v, j) ∈ ovPos N := Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 hj⟩
  simp only [ChainKnow.round, ChainKnow.read, Finset.mem_union, Finset.mem_filter]
  exact ⟨Or.inr ⟨hpos, Or.inl hc⟩, Or.inr ⟨hpos, hc⟩⟩

/-- **A row whose parents are all held runs one call per round**: call `j` is made in round `j`. -/
theorem row_progress (G : TopoDAG N) (P₀ : ChainKnow N) (v : Fin N) (hpar : G.par v ⊆ P₀.labs) :
    ∀ j, 1 ≤ j → j ≤ ovCalls G v →
      (v, j) ∈ (ChainKnow.reach G P₀ j).hs ∧ (v, j) ∈ (ChainKnow.reach G P₀ j).rs := by
  intro j
  induction j with
  | zero => intro h; omega
  | succ j ih =>
    intro _ hj
    have hN : j + 1 < N + 2 := by
      have := card_par_le G v
      have := v.isLt
      rw [ovCalls_eq] at hj
      omega
    refine mem_round_of_canCall G _ v (j + 1) ⟨by omega, hj, ?_, ?_⟩ hN
    · intro u hu
      have hmem : u ∈ parentsDesc G v := List.mem_of_getElem? hu
      exact held_subset_reach G P₀ j (hpar ((Finset.mem_sort _).1 hmem))
    · rcases Nat.eq_zero_or_pos j with h0 | hpos
      · left; omega
      · right; simpa using (ih hpos (by omega)).1

/-- **Such a row's label is known after `ovCalls G v` rounds.** -/
theorem row_label (G : TopoDAG N) (P₀ : ChainKnow N) (v : Fin N) (hpar : G.par v ⊆ P₀.labs) :
    v ∈ (ChainKnow.reach G P₀ (ovCalls G v)).labs := by
  have h1 : 1 ≤ ovCalls G v := by rw [ovCalls_eq]; omega
  obtain ⟨j, hj⟩ : ∃ j, ovCalls G v = j + 1 := ⟨ovCalls G v - 1, by omega⟩
  have hr := (row_progress G P₀ v hpar (ovCalls G v) h1 le_rfl).2
  rw [hj] at hr ⊢
  exact (mem_round_labs G _ v).2 (Or.inr (by rw [hj]; exact hr))

/-- A label-only holding is priced at its label count. -/
theorem size_labels (c ℓ : ℕ) (H : Finset (Fin N)) :
    ChainKnow.size c ℓ (⟨H, ∅, ∅⟩ : ChainKnow N) = H.card := by
  simp [ChainKnow.size]

/-- If a holding priced at most `s` knows every label after `D` rounds, `G` is not `(s, D, N)`-hard. -/
theorem not_hard_of_all (G : TopoDAG N) (c ℓ : ℕ) (s : ℚ) (D : ℕ) (P₀ : ChainKnow N)
    (hsize : P₀.size c ℓ ≤ s) (hall : ∀ v, v ∈ (ChainKnow.reach G P₀ D).labs) :
    ¬ ChainHard G Finset.univ c ℓ s D N := by
  intro h
  have := h P₀ hsize
  rw [Finset.filter_true_of_mem fun v _ => hall v, Finset.card_univ, Fintype.card_fin] at this
  exact lt_irrefl _ this

end Attack

/-- In the band, node `v` has at most `d` parents. -/
theorem card_par_band_le (B d : ℕ) (v : Fin B) : ((bandDAG B d).par v).card ≤ d := by
  calc ((bandDAG B d).par v).card ≤ (Finset.Ico (v.val - d) v.val).card :=
        Finset.card_le_card_of_injOn (fun u => u.val)
          (fun u hu => by
            have := (Finset.mem_filter.1 hu).2
            rw [Fin.lt_def] at this
            simp only [Finset.coe_Ico, Set.mem_Ico]
            omega)
          (fun a _ b _ h => Fin.ext h)
    _ ≤ d := by rw [Nat.card_Ico]; omega

/-- **`BandGapAttack`, proved.** With `d + 1 ≤ D`, drop the positive multiples of `d + 1`: each dropped row has its
`≤ d` parents held (no two multiples are within `d`), so it finishes within `d + 1 ≤ D` rounds. -/
theorem band_gap_attack : BandGapAttack := by
  intro B d D c ℓ hdD
  classical
  rcases Nat.eq_zero_or_pos B with hB0 | hBpos
  · subst hB0
    intro h
    exact Nat.not_lt_zero _ (h ⟨∅, ∅, ∅⟩ (by rw [size_labels]; simp))
  set H : Finset (Fin B) := Finset.univ.filter fun v => ¬ (0 < v.val ∧ (d + 1) ∣ v.val) with hH
  have hlt : ∀ k, k < (B - 1) / (d + 1) → (d + 1) * (k + 1) < B := by
    intro k hk
    have h1 : (d + 1) * (k + 1) ≤ (d + 1) * ((B - 1) / (d + 1)) := Nat.mul_le_mul_left _ (by omega)
    have h2 : (d + 1) * ((B - 1) / (d + 1)) ≤ B - 1 := Nat.mul_div_le _ _
    omega
  have hHc : H.card ≤ B - (B - 1) / (d + 1) := by
    have hM : (B - 1) / (d + 1) ≤ (Finset.univ.filter fun v : Fin B => 0 < v.val ∧ (d + 1) ∣ v.val).card := by
      refine Finset.le_card_of_inj_on_range
        (fun i => if h : (d + 1) * (i + 1) < B then (⟨(d + 1) * (i + 1), h⟩ : Fin B) else ⟨0, hBpos⟩)
        (fun i hi => ?_) (fun i hi j hj h => ?_)
      · simp only [hlt i hi, dite_true, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨by positivity, Dvd.intro _ rfl⟩
      · simp only [hlt i hi, hlt j hj, dite_true, Fin.mk.injEq] at h
        have := Nat.eq_of_mul_eq_mul_left (by omega : 0 < d + 1) h
        omega
    have hsplit : (Finset.univ.filter fun v : Fin B => 0 < v.val ∧ (d + 1) ∣ v.val).card + H.card = B := by
      have := Finset.card_filter_add_card_filter_not
        (s := (Finset.univ : Finset (Fin B))) (fun v : Fin B => 0 < v.val ∧ (d + 1) ∣ v.val)
      rw [Finset.card_univ, Fintype.card_fin] at this
      rw [hH]
      convert this using 3
    omega
  refine not_hard_of_all (bandDAG B d) c ℓ _ D ⟨H, ∅, ∅⟩ ?_ ?_
  · rw [size_labels]; exact_mod_cast hHc
  · intro v
    by_cases hv : v ∈ H
    · exact held_subset_reach _ _ D hv
    · have hvm : 0 < v.val ∧ (d + 1) ∣ v.val := by
        simpa [hH] using hv
      have hpar : (bandDAG B d).par v ⊆ H := by
        intro u hu
        have hu' := (Finset.mem_filter.1 hu).2
        rw [Fin.lt_def] at hu'
        simp only [hH, Finset.mem_filter, Finset.mem_univ, true_and]
        rintro ⟨-, hdu⟩
        have hdvd : (d + 1) ∣ v.val - u.val := Nat.dvd_sub hvm.2 hdu
        have := Nat.le_of_dvd (by omega) hdvd
        omega
      have hcalls : ovCalls (bandDAG B d) v ≤ D := by
        rw [ovCalls_eq]; have := card_par_band_le B d v; omega
      exact reach_labs_mono _ _ hcalls (row_label _ ⟨H, ∅, ∅⟩ v hpar)

/-- Hardness weakens as the storage bound shrinks. -/
theorem ChainHard.mono {N : ℕ} {G : TopoDAG N} {VC : Finset (Fin N)} {c ℓ : ℕ} {s s' : ℚ} {D k : ℕ}
    (h : ChainHard G VC c ℓ s D k) (hs : s' ≤ s) : ChainHard G VC c ℓ s' D k :=
  fun P₀ hP => h P₀ (hP.trans hs)


section Scheme

variable {N ℓ c : ℕ}

theorem labelG_eq (G : TopoDAG N) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin N → Bits ℓ) (v : Fin N) :
    labelG G f dom Wb v = bxor (ovKey f (dom v) (absorbedG G (labelG G f dom Wb) v)) (Wb v) := by
  rw [labelG]
  unfold absorbedG
  rw [List.attach_map_val]

/-- Bit-exact public decoding on any DAG. -/
theorem chainScheme_correct {B : ℕ} [NeZero B] (G : TopoDAG B) (ℓ c : ℕ) (dom : ℕ → Bits c) :
    (chainScheme G ℓ c dom).Correct := by
  intro W π r
  let f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c)) := fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)
  show codeEquiv B ℓ (fun i => bxor (labelG G f dom (Dense.blocks B ℓ W) i)
    (ovKey f (dom i) (absorbedG G (labelG G f dom (Dense.blocks B ℓ W)) i))) = W
  have h : ∀ i, bxor (labelG G f dom (Dense.blocks B ℓ W) i)
      (ovKey f (dom i) (absorbedG G (labelG G f dom (Dense.blocks B ℓ W)) i)) = Dense.blocks B ℓ W i := by
    intro i
    rw [labelG_eq]
    exact bxor_self_left _ _
  rw [funext h]
  exact (codeEquiv B ℓ).apply_symm_apply W


/-- In the band, node `v` has exactly `min(v, d)` parents. -/
theorem card_par_band (B d : ℕ) (v : Fin B) : ((bandDAG B d).par v).card = min v.val d := by
  refine le_antisymm (le_min (card_par_le _ v) (card_par_band_le B d v)) ?_
  refine Finset.le_card_of_inj_on_range (fun i => (⟨v.val - 1 - i, by omega⟩ : Fin B)) (fun i hi => ?_)
    (fun i hi j hj h => ?_)
  · have := min_le_left v.val d
    have := min_le_right v.val d
    exact Finset.mem_filter.2 ⟨Finset.mem_univ _, Fin.lt_def.2 (by simp only; omega), by simp only; omega⟩
  · have := min_le_left v.val d
    simp only [Fin.mk.injEq] at h
    omega


end Scheme

/-- On the complete DAG, the parents newest first are `v − 1, …, 0`. -/
theorem parentsDesc_complete {B : ℕ} (v : Fin B) :
    parentsDesc (Dense.completeDAG B) v =
      List.ofFn fun j : Fin v.val => (⟨v.val - 1 - j.val, by omega⟩ : Fin B) := by
  apply List.Perm.eq_of_pairwise' (r := fun a b : Fin B => b ≤ a)
  · exact Finset.pairwise_sort _ _
  · rw [List.pairwise_ofFn]
    intro i j hij
    rw [Fin.lt_def] at hij
    simp only [Fin.le_def]
    omega
  · refine List.perm_of_nodup_nodup_toFinset_eq (Finset.sort_nodup _ _) ?_ ?_
    · rw [List.nodup_ofFn]
      intro i j h
      simp only [Fin.mk.injEq] at h
      exact Fin.ext (by omega)
    · unfold parentsDesc
      rw [Finset.sort_toFinset]
      ext u
      simp only [Dense.completeDAG, Finset.mem_filter, Finset.mem_univ, true_and, List.mem_toFinset,
        List.mem_ofFn, Fin.lt_def]
      constructor
      · intro hu
        exact ⟨⟨v.val - 1 - u.val, by omega⟩, Fin.ext (by simp only; omega)⟩
      · rintro ⟨j, rfl⟩
        simp only
        omega

/-- **`labelG` on the complete DAG is `labelOv`.** -/
theorem labelG_complete {B ℓ c : ℕ} (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin B → Bits ℓ) : ∀ v, labelG (Dense.completeDAG B) f dom Wb v = labelOv f dom Wb v := by
  intro v
  induction v using WellFoundedLT.induction with
  | _ v ih =>
    have habs : absorbedG (Dense.completeDAG B) (labelG (Dense.completeDAG B) f dom Wb) v =
        absorbed (labelOv f dom Wb) v := by
      unfold absorbedG absorbed parentsNF
      rw [parentsDesc_complete, List.map_ofFn]
      congr 1
      refine List.ofFn_inj.2 (funext fun j => ?_)
      exact ih _ (Fin.lt_def.2 (by simp only; omega))
    rw [labelG_eq, labelOv_eq, habs]

/-- **`ChainExPostFactoGSpec`, proved**: at the complete DAG, `ChainExPostFactoG` is `ChainExPostFacto`. -/
theorem chainExPostFactoG_spec : ChainExPostFactoGSpec := by
  intro h B ℓ c m s D Q k dom Wb hdom hhard A₁ A₂ hA
  have := h B ℓ c m s D Q k (Dense.completeDAG B) dom Wb hdom hhard A₁ A₂ hA
  simpa only [labelG_complete] using this

/-- **`BandTimedINC`, proved** (conditional on `ChainExPostFactoG`, by its statement): the port of `chain_timedINC`,
with `band_chain_hard` in place of `chainDense_hard`. -/
theorem band_timedINC : BandTimedINC := by
  intro hepf B d ℓ c D Q β _ dom hd hD hdom
  classical
  intro W cmp exp hexp
  have hE := hepf B ℓ c β (B - D - 1) D Q B (bandDAG B d) dom (Dense.blocks B ℓ W) hdom
    (band_chain_hard B d D c ℓ hd hD)
    (fun π => cmp W (fun i => i.elim0)
      (fun i => labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom
        (Dense.blocks B ℓ W) i) π)
    (fun σ i => exp W (fun i => i.elim0) σ i) (fun σ i => hexp W _ σ i)
  refine le_trans (le_of_eq_of_le (PousThm1Dense.pr_fst (β := Unit)
    (fun π : Equiv.Perm (Bits (ℓ + (ℓ + c))) =>
      ∀ i, (exp W (fun i => i.elim0)
        (cmp W (fun i => i.elim0)
          (fun i => labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom
            (Dense.blocks B ℓ W) i) π)
        i).run ((idealPerm (ℓ + (ℓ + c))).answer π) =
        labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom (Dense.blocks B ℓ W) i))
    (pr_mono fun π hH => ?_)) hE
  refine le_trans (le_of_eq (by rw [Finset.card_univ, Fintype.card_fin]))
    (Finset.card_le_card (s := Finset.univ) fun c _ => Finset.mem_filter.2 ⟨Finset.mem_univ _, hH c⟩)

/-- `⌊ρ·|C|⌋ = 254307274` at `|C| = 2^9·524288 = 2^28`, as for dense. -/
theorem stateBound_band_64 (d : ℕ) (dom : ℕ → Bits 512) :
    (chainBand (2 ^ 9) d 524288 512 dom).stateBound Params.ρ = 254307274 := by
  show ⌊Params.ρ * (((2 ^ 9) * 524288 : ℕ) : ℚ)⌋₊ = 254307274
  rw [Nat.floor_eq_iff (by norm_num [Params.ρ])]
  norm_num [Params.ρ]

/-- **`BandMeets64`, proved** (conditional on `ChainExPostFactoG`, by its statement): for every `d ≥ 5` the band meets
the requirement at the dense chain deployment point, with dense's certificate terms `chain_union_term_64` and
`chain_sampling_term_64` verbatim (`β = 265253616`, `k = 111`). -/
theorem band_meets_64 : BandMeets64 := by
  intro hepf d hd salt
  refine ⟨le_rfl, chainScheme_correct _ _ _ _, le_rfl, ?_, ?_⟩
  · show ((((2 ^ 9) * 524288 + 0 : ℕ)) : ℚ) ≤ Pous.Params.expansion * (((2 ^ 9) * 524288 : ℕ) : ℚ)
    norm_num [Pous.Params.expansion]
  · intro W A₁ A₂
    have hINC := band_timedINC hepf (2 ^ 9) d 524288 512 5 (2 ^ 20) 265253616 (Pous.Sponge.dom salt) hd
      (by norm_num) (dom_inj salt (by norm_num))
    refine (PousTargetsDense.theorem1_ii_seq (chainBand (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)) 5 (2 ^ 20)
      265253616 ((chainBand (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)).stateBound Pous.Params.ρ) 111 _
      hINC W A₁ A₂).trans ?_
    rw [stateBound_band_64, add_comm]
    exact add_le_add chain_sampling_term_64 chain_union_term_64


/-- **Witnesses for `BandMeets64`'s `5 ≤ d`**: the deployment at `d = 5` and at the recommended `d = 12`. -/
theorem band_meets_64_d5 (hepf : ChainExPostFactoG) : ChainBandMeets64 5 := band_meets_64 hepf 5 le_rfl

theorem band_meets_64_d12 (hepf : ChainExPostFactoG) : ChainBandMeets64 12 :=
  band_meets_64 hepf 12 (by norm_num)


/-- **And its cliff at `D = 13`**: the gap attack costs `512 − 39 = 473` labels, below the `498` allowed. -/
theorem band_cliff_d12 (c ℓ : ℕ) :
    ¬ ChainHard (bandDAG 512 12) Finset.univ c ℓ ((512 - 13 - 1 : ℕ) : ℚ) 13 512 :=
  fun h => band_gap_attack 512 12 13 c ℓ le_rfl (ChainHard.mono h (by norm_num))

end Pous.BandChain

end


/-! ════ ChainEPFCore ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

variable {r c : ℕ}

/-- The forward-query inputs the overwrite chain asks while absorbing `blks` from the running pair `p`. -/
def ovInputs (f : Bits (r + (r + c)) → Bits (r + (r + c))) :
    Bits r × Bits (r + c) → List (Bits r) → List (Bits (r + (r + c)))
  | _, [] => []
  | p, blk :: blks => Fin.append blk p.2 :: ovInputs f (ovStep f p blk) blks


end PousSpongeChain

end


/-! ════ ChainEPFGraph ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

variable {N ℓ c : ℕ}

/-- A parent index is strictly earlier (topological order). -/
theorem parentsDesc_lt (G : TopoDAG N) {v u : Fin N} (hu : u ∈ parentsDesc G v) : u < v :=
  G.par_lt v u ((Finset.mem_sort _).1 hu)

/-- Block `v` has at most `v` parents (they are all earlier). -/
theorem parentsDesc_length_le (G : TopoDAG N) (v : Fin N) : (parentsDesc G v).length ≤ v.val := by
  rw [parentsDesc, Finset.length_sort]
  refine le_trans (Finset.card_le_card (fun u hu => Finset.mem_Iio.2 (G.par_lt v u hu))) ?_
  simp [Fin.card_Iio]

/-- **The recursion unfolds** to `key(IV(dom v); labels of parents, pad) ⊕ W_v`. -/
theorem labelG_eq (G : TopoDAG N) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin N → Bits ℓ) (v : Fin N) :
    labelG G f dom Wb v = bxor (ovKey f (dom v) (absorbedG G (labelG G f dom Wb) v)) (Wb v) := by
  rw [labelG]
  unfold absorbedG
  rw [List.attach_map_val]


end PousSpongeChain

end


/-! ════ ChainEPFReplay ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

variable {r c : ℕ}

/-- The chaining value after absorbing `parents` from `IV(domi)` (before the pad call). -/
def chainState (f : Bits (r + (r + c)) → Bits (r + (r + c))) (domi : Bits c) (parents : List (Bits r)) :
    Bits (r + c) :=
  (ovAbsorb f (iv domi) parents).2

/-- The pad call's input: `padBlk ‖ chainState`. Its `r`-part under `f` is the key. -/
def padInput (f : Bits (r + (r + c)) → Bits (r + (r + c))) (domi : Bits c) (parents : List (Bits r)) :
    Bits (r + (r + c)) :=
  Fin.append padBlk (chainState f domi parents)

/-- **The key is one forward query.** `ovKey f domi (parents ++ pad) = ovR (f (padInput …))`. -/
theorem ovKey_pad (f : Bits (r + (r + c)) → Bits (r + (r + c))) (domi : Bits c) (parents : List (Bits r)) :
    ovKey f domi (parents ++ [padBlk]) = ovR (f (padInput f domi parents)) := by
  simp only [ovKey, ovAbsorb, padInput, chainState]
  rw [List.foldl_append, List.foldl_cons, List.foldl_nil]
  rfl

/-- The pad input of block `i` over the DAG `G` (parents = its labels, `parentsDesc` order). -/
def chainRealG {B ℓ : ℕ} (G : TopoDAG B) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin B → Bits ℓ) (i : Fin B) : Bits (ℓ + (ℓ + c)) :=
  padInput f (dom i.val) ((parentsDesc G i).map (labelG G f dom Wb))

/-- **Block label as one pad query.** `labelG G f dom Wb i = ovR (f (chainRealG …)) ⊕ Wb i`. -/
theorem labelG_pad {B ℓ : ℕ} (G : TopoDAG B) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin B → Bits ℓ) (i : Fin B) :
    labelG G f dom Wb i = bxor (ovR (f (chainRealG G f dom Wb i))) (Wb i) := by
  rw [labelG_eq]
  unfold absorbedG chainRealG
  rw [ovKey_pad]

end PousSpongeChain

end


/-! ════ ChainEPFTranscript ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

/-- One chain-audit replay: the DAG, block domains, free words, the round/query budget, and the online programs. -/
structure ChainReplay (B ℓ c : ℕ) where
  G : TopoDAG B
  dom : ℕ → Bits c
  Wb : Fin B → Bits ℓ
  D : ℕ
  Q : ℕ
  P : Fin B → OracleProg (idealPerm (ℓ + (ℓ + c))) (Bits ℓ)

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- Positions: thread `i`'s query/guess slots, and the labeller's pad query for block `i`. -/
abbrev Pos : Type := (Fin B × Fin (R.Q + 1)) ⊕ Fin B

/-- Thread `i`'s transcript against `π`. -/
def tr (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) :
    List (ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))) :=
  PousB5Chain.trace ((idealPerm (ℓ + (ℓ + c))).answer π) (R.P i)

/-- The input point a query reveals about `π`: `x` for a forward `Π x`, `π⁻¹ y` for an inverse `Π⁻¹ y`. -/
def revealPt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))
  | .inl x => x
  | .inr y => π.symm y

/-- The ℓ-bit key a query **shows in the clear** (its input, per `NOTES.md` §6): the parent-label block `ovR x` fed to a
forward `Π x`, or the dropped `r = ovR y` chosen for an inverse `Π⁻¹ y`. Independent of `π` (it is a query payload). -/
def qKey : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits ℓ
  | .inl x => ovR x
  | .inr y => ovR y

/-- Block `i`'s real query point (its pad input). -/
def realPt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) : Bits (ℓ + (ℓ + c)) :=
  chainRealG R.G (fun x => π x) R.dom R.Wb i


/-- The revealed point and round at a position (none for a guess slot). -/
def realAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.Pos → Option (Bits (ℓ + (ℓ + c)) × ℕ)
  | .inl (i, k) => if k.val < R.Q then ((R.tr π i)[k.val]?).map fun e => (revealPt π e.2, e.1) else none
  | .inr i => some (R.realPt π i, R.D + i.val)

/-- What a position shows: the ℓ-bit **label** and its round; a query slot shows its input's parent-label `ovR x`, a guess
slot shows the thread's output (its guess of the block's label). -/
def obsKey (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.Pos → Option (Bits ℓ × ℕ)
  | .inl (i, k) =>
      if k.val < R.Q then ((R.tr π i)[k.val]?).map fun e => (qKey e.2, e.1)
      else some ((R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π),
                 (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π))
  | .inr _ => none

/-- Some thread reveals point `z` at round `ρ`. -/
def askedPt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (z : Bits (ℓ + (ℓ + c))) (ρ : ℕ) : Prop :=
  ∃ i, ∃ e ∈ R.tr π i, e.1 = ρ ∧ revealPt π e.2 = z


end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFResample ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

variable {r c : ℕ}

@[simp] theorem ovR_append (a : Bits r) (b : Bits (r + c)) : ovR (Fin.append a b) = a := by
  funext j; simp only [ovR, Fin.append_left]

@[simp] theorem ovH_append (a : Bits r) (b : Bits (r + c)) : ovH (Fin.append a b) = b := by
  funext j; simp only [ovH, Fin.append_right]

theorem append_ovR_ovH (o : Bits (r + (r + c))) : Fin.append (ovR o) (ovH o) = o := by
  funext i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;>
    simp only [Fin.append_left, Fin.append_right, ovR, ovH]

/-- Resample `π` at `z`, keeping the h-part of `π z` and setting the r-part to `r'`. -/
def resamp (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r) :
    Equiv.Perm (Bits (r + (r + c))) :=
  Equiv.swap (π z) (Fin.append r' (ovH (π z))) * π

theorem resamp_self (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r) :
    resamp π z r' z = Fin.append r' (ovH (π z)) := by
  simp only [resamp, Equiv.Perm.mul_apply, Equiv.swap_apply_left]

@[simp] theorem ovR_resamp_self (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r) :
    ovR (resamp π z r' z) = r' := by rw [resamp_self, ovR_append]

@[simp] theorem ovH_resamp_self (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r) :
    ovH (resamp π z r' z) = ovH (π z) := by rw [resamp_self, ovH_append]


end PousSpongeChain

end


/-! ════ ChainEPFPrEv ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

variable {r c : ℕ}

/-- The chain's forward inputs split along a block-list concatenation. -/
theorem ovInputs_append (f : Bits (r + (r + c)) → Bits (r + (r + c))) (blks₁ blks₂ : List (Bits r)) :
    ∀ p : Bits r × Bits (r + c),
      ovInputs f p (blks₁ ++ blks₂) = ovInputs f p blks₁ ++ ovInputs f (blks₁.foldl (ovStep f) p) blks₂ := by
  induction blks₁ with
  | nil => intro p; simp [ovInputs]
  | cons blk blks ih => intro p; simp only [List.cons_append, ovInputs, List.foldl_cons, ih]


end PousSpongeChain

end


/-! ════ ChainEPFCount ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

/-- The chain asks exactly one forward query per absorbed block. -/
theorem ovInputs_length {r c : ℕ} (f : Bits (r + (r + c)) → Bits (r + (r + c))) :
    ∀ (p : Bits r × Bits (r + c)) (blks : List (Bits r)), (ovInputs f p blks).length = blks.length
  | _, [] => rfl
  | p, blk :: blks => by
      rw [ovInputs, List.length_cons, List.length_cons, ovInputs_length f (ovStep f p blk) blks]


end PousSpongeChain

end


/-! ════ ChainEPFSim ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

/-- The `ChainKnow` holding whose only knowledge is the labels in `F` (priced `|F|`). -/
def holdingOf {B : ℕ} (F : Finset (Fin B)) : ChainKnow B := ⟨F, ∅, ∅⟩

@[simp] theorem holdingOf_labs {B : ℕ} (F : Finset (Fin B)) : (holdingOf F).labs = F := rfl


/-- **Numeric core of the assembly, under the side condition `2·n ≤ 2^ℓ`.** A fresh item costs `2/2^ℓ` rather than
`1/(2^ℓ−n)`: the "factor 2 from resampling". (Off the side condition the collision term dominates.) -/
theorem inv_two_pow_sub_le {ℓ n : ℕ} (h : 2 * n ≤ 2 ^ ℓ) :
    (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹ ≤ 2 * ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := by
  have hnat : (2 : ℕ) ^ ℓ ≤ 2 * (2 ^ ℓ - n) := by omega
  have hpow : ((2 : ℝ≥0∞) ^ ℓ) = ((2 ^ ℓ : ℕ) : ℝ≥0∞) := by push_cast; ring
  have hcast : ((2 : ℝ≥0∞) ^ ℓ) ≤ 2 * (((2 ^ ℓ - n : ℕ) : ℝ≥0∞)) := by
    rw [hpow]
    have := (Nat.cast_le (α := ℝ≥0∞)).2 hnat
    rw [Nat.cast_mul] at this
    simpa using this
  have ha : ((2 ^ ℓ - n : ℕ) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : (2 : ℝ≥0∞) ≠ 0 := two_ne_zero
  have h2t : (2 : ℝ≥0∞) ≠ ⊤ := ENNReal.ofNat_ne_top
  have hinv : (2 * ((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹ ≤ ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := ENNReal.inv_le_inv.2 hcast
  rw [ENNReal.mul_inv (Or.inl h2) (Or.inl h2t)] at hinv
  calc (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹
      = 2 * (2⁻¹ * (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel h2 h2t, one_mul]
    _ ≤ 2 * ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := mul_le_mul' le_rfl hinv

end PousSpongeChain

end


/-! ════ ChainEPFItem ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- Block `v`'s chain inputs as a list: the parents' inputs, then the pad input. Length `ovCalls G v`. -/
noncomputable def chainInputList (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : List (Bits (ℓ + (ℓ + c))) :=
  ovInputs (fun x => π x) (fun _ => false, iv (R.dom v.val))
    (absorbedG R.G (labelG R.G (fun x => π x) R.dom R.Wb) v)

/-- Block `v`'s parent-chain inputs as a list (without the pad). -/
noncomputable def parentInputList (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : List (Bits (ℓ + (ℓ + c))) :=
  ovInputs (fun x => π x) (fun _ => false, iv (R.dom v.val))
    ((parentsDesc R.G v).map (labelG R.G (fun x => π x) R.dom R.Wb))

/-- The chain input list is the parent inputs followed by the pad input `realPt v`. -/
theorem chainInputList_eq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    R.chainInputList π v = R.parentInputList π v ++ [R.realPt π v] := by
  rw [chainInputList, parentInputList, absorbedG, ovInputs_append]
  congr 1

/-- The chain input list has length `ovCalls G v`. -/
theorem chainInputList_length (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    (R.chainInputList π v).length = ovCalls R.G v := by
  rw [chainInputList, ovInputs_length, absorbedG, List.length_append, List.length_map, List.length_singleton,
    ovCalls]

/-- The `p`-th chain input of block `v` (1-indexed); the point pinned by item `(v, p)`. -/
noncomputable def xin (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) : Bits (ℓ + (ℓ + c)) :=
  ((R.chainInputList π v)[p - 1]?).getD (fun _ => false)

/-- The pad position's input is `realPt v` (the label item's point). -/
theorem xin_pad (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    R.xin π v (ovCalls R.G v) = R.realPt π v := by
  have hlen : (R.parentInputList π v).length = ovCalls R.G v - 1 := by
    rw [parentInputList, ovInputs_length, List.length_map, ovCalls]; omega
  have hpos : 1 ≤ ovCalls R.G v := by rw [ovCalls]; omega
  rw [xin, chainInputList_eq]
  rw [List.getElem?_append_right (by omega)]
  rw [hlen]
  simp only [show ovCalls R.G v - 1 - (ovCalls R.G v - 1) = 0 from by omega]
  rfl

end ChainReplay


end PousSpongeChain

end


/-! ════ ChainEPFFresh ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

/-- The `(ℓ+c)`-bit chaining a query shows in the clear (its input h-part). π-independent. -/
def qKeyH {ℓ c : ℕ} : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + c)
  | .inl x => ovH x
  | .inr y => ovH y

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)


/-- What a position shows as a chaining value: a query slot shows its input h-part; a guess slot shows nothing. -/
def obsKeyH (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.Pos → Option (Bits (ℓ + c) × ℕ)
  | .inl (i, k) => if k.val < R.Q then ((R.tr π i)[k.val]?).map (fun e => (qKeyH e.2, e.1)) else none
  | .inr _ => none


/-- Distinct chain positions have distinct chain inputs. The honest-chain collision (`π`-only). -/
def NoCollU (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : Prop :=
  ∀ (v : Fin B) (p : ℕ) (v' : Fin B) (p' : ℕ),
    1 ≤ p → p ≤ ovCalls R.G v → 1 ≤ p' → p' ≤ ovCalls R.G v' →
    (v ≠ v' ∨ p ≠ p') → R.xin π v p ≠ R.xin π v' p'

/-- The bad event: a chain-input collision (negation of `NoCollU`). Adversary-independent. -/
def Bad (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : Prop := ¬ R.NoCollU π

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFReach ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace Reach


section Chain

variable {r c : ℕ}

/-- The chaining value after absorbing the first `k` blocks of `blks` from `s`. -/
def stateAfter (f : Bits (r + (r + c)) → Bits (r + (r + c))) (s : Bits r × Bits (r + c)) (blks : List (Bits r))
    (k : ℕ) : Bits (r + c) :=
  ((blks.take k).foldl (ovStep f) s).2

theorem stateAfter_zero (f : Bits (r + (r + c)) → Bits (r + (r + c))) (s : Bits r × Bits (r + c))
    (blks : List (Bits r)) : stateAfter f s blks 0 = s.2 := by
  simp [stateAfter]

/-- **The `k`-th forward input** is the `k`-th block beside the chaining value after `k` blocks. -/
theorem ovInputs_getElem (f : Bits (r + (r + c)) → Bits (r + (r + c))) :
    ∀ (s : Bits r × Bits (r + c)) (blks : List (Bits r)) (k : ℕ) (hk : k < blks.length),
      (ovInputs f s blks)[k]? = some (Fin.append blks[k] (stateAfter f s blks k))
  | _, [], _, hk => absurd hk (Nat.not_lt_zero _)
  | s, blk :: blks, 0, _ => by simp [ovInputs, stateAfter]
  | s, blk :: blks, k + 1, hk => by
      have ih := ovInputs_getElem f (ovStep f s blk) blks k (by simpa using hk)
      simp only [ovInputs, List.getElem?_cons_succ, ih, List.getElem_cons_succ]
      simp [stateAfter, List.take_succ_cons, List.foldl_cons]

/-- **The next chaining value** is the `h`-part of `f` at the current input. -/
theorem stateAfter_succ (f : Bits (r + (r + c)) → Bits (r + (r + c))) (s : Bits r × Bits (r + c))
    (blks : List (Bits r)) (k : ℕ) (hk : k < blks.length) :
    stateAfter f s blks (k + 1) = ovH (f (Fin.append blks[k] (stateAfter f s blks k))) := by
  unfold stateAfter
  rw [List.take_add_one, List.getElem?_eq_getElem hk, Option.toList_some, List.foldl_append]
  rfl

end Chain


namespace ChainReplayR

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- Block `v`'s absorbed blocks: its parents' labels newest first, then the pad. -/
noncomputable abbrev blks (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : List (Bits ℓ) :=
  absorbedG R.G (labelG R.G (fun x => π x) R.dom R.Wb) v

/-- Block `v`'s chaining value after `p` calls (`chainH 0` is the IV). -/
noncomputable def chainH (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) : Bits (ℓ + c) :=
  stateAfter (fun x => π x) (fun _ => false, iv (R.dom v.val)) (blks R π v) p

theorem blks_length (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : (blks R π v).length = ovCalls R.G v := by
  simp [blks, absorbedG, ovCalls]

theorem chainH_zero (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : chainH R π v 0 = iv (R.dom v.val) :=
  stateAfter_zero _ _ _

/-- **Input `p + 1`** is the `p`-th absorbed block beside the chaining value after `p` calls. -/
theorem xin_succ (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) (hp : p < ovCalls R.G v) :
    R.xin π v (p + 1) = Fin.append ((blks R π v)[p]'(by rw [blks_length]; exact hp)) (chainH R π v p) := by
  have h := ovInputs_getElem (fun x => π x) (fun _ => false, iv (R.dom v.val)) (blks R π v) p
    (by rw [blks_length]; exact hp)
  unfold ChainReplay.xin ChainReplay.chainInputList
  simp only [Nat.add_sub_cancel]
  rw [h]
  rfl

/-- **The chaining value after call `p + 1`** is the `h`-part of `π` at input `p + 1`. -/
theorem chainH_succ (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) (hp : p < ovCalls R.G v) :
    chainH R π v (p + 1) = ovH (π (R.xin π v (p + 1))) := by
  rw [xin_succ R π v p hp]
  exact stateAfter_succ _ _ _ p (by rw [blks_length]; exact hp)

/-- Before the pad, the absorbed block is a parent's label. -/
theorem blks_getElem_parent (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ)
    (hp : p < (parentsDesc R.G v).length) :
    (blks R π v)[p]'(by rw [blks_length, ovCalls]; omega) =
      labelG R.G (fun x => π x) R.dom R.Wb ((parentsDesc R.G v)[p]) := by
  simp [blks, absorbedG, List.getElem_append_left, hp]

/-- At the pad position the absorbed block is `padBlk`. -/
theorem blks_getElem_pad (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    (blks R π v)[(parentsDesc R.G v).length]'(by rw [blks_length, ovCalls]; omega) = padBlk := by
  simp [blks, absorbedG]

end ChainReplayR


end Reach


namespace ChainReplay

open Reach Reach.ChainReplayR

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)


/-- A thread's transcript has at most `Q` entries. -/
theorem tr_length_le (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) :
    (R.tr π i).length ≤ R.Q :=
  (PousB5Chain.length_trace (M := idealPerm (ℓ + (ℓ + c))) ((idealPerm (ℓ + (ℓ + c))).answer π) (R.P i)).le.trans
    (hP i π).2


/-- `realPt v` is block `v`'s last chain input. -/
theorem realPt_eq_xin (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    R.realPt π v = R.xin π v (ovCalls R.G v) := (R.xin_pad π v).symm

theorem ovCalls_lt (v : Fin B) : ovCalls R.G v < B + 2 := by
  have h1 := parentsDesc_length_le R.G v
  have h2 := v.isLt
  unfold ovCalls
  omega

/-- A label is `ovR (π (realPt v)) ⊕ Wb v`. -/
theorem labelG_eq_realPt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    labelG R.G (fun x => π x) R.dom R.Wb v = bxor (ovR (π (R.realPt π v))) (R.Wb v) :=
  labelG_pad R.G (fun x => π x) R.dom R.Wb v


end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFBirthday ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace Birthday


section Pin

variable {r c : ℕ}

/-- Set `π z` to `t`, swapping with the point that `π` sent to `t`. -/
def swapTo (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) : Equiv.Perm (Bits (r + (r + c))) :=
  Equiv.swap (π z) t * π

theorem swapTo_self (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) : swapTo π z t z = t := by
  simp only [swapTo, Equiv.Perm.mul_apply, Equiv.swap_apply_left]

theorem swapTo_apply_ne (π : Equiv.Perm (Bits (r + (r + c)))) (z t x : Bits (r + (r + c))) (hx : x ≠ z)
    (hy : π x ≠ t) : swapTo π z t x = π x := by
  simp only [swapTo, Equiv.Perm.mul_apply]
  exact Equiv.swap_apply_of_ne_of_ne (fun h => hx (π.injective h)) hy

theorem swapTo_recover (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) :
    Equiv.swap (π z) (swapTo π z t z) * swapTo π z t = π := by
  rw [swapTo_self]
  show Equiv.swap (π z) t * (Equiv.swap (π z) t * π) = π
  rw [← mul_assoc, Equiv.swap_mul_self, one_mul]

theorem card_bits (n : ℕ) : Fintype.card (Bits n) = 2 ^ n := by simp [Bits]

open Classical in
/-- **Adaptive pin.** Let `z π` be a point, `T π` an `h`-value and `S π` a set of at most `n` points, where `z` and `T`
depend on `π` only through `S π`. The permutations with `ovH (π (z π)) = T π` and `z π ∉ S π`, times `2^(r+c) − n`,
number at most all permutations. -/
theorem card_pin_le (z : Equiv.Perm (Bits (r + (r + c))) → Bits (r + (r + c)))
    (T : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c))
    (S : Equiv.Perm (Bits (r + (r + c))) → Finset (Bits (r + (r + c)))) (n : ℕ)
    (hS : ∀ π, (S π).card ≤ n)
    (hstab : ∀ π π' : Equiv.Perm (Bits (r + (r + c))), (∀ x ∈ S π, π' x = π x) → z π' = z π ∧ T π' = T π)
    (E : Equiv.Perm (Bits (r + (r + c))) → Prop)
    (hE : ∀ π, E π → ovH (π (z π)) = T π ∧ z π ∉ S π) :
    (Finset.univ.filter E).card * (2 ^ (r + c) - n) ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := by
  let good : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c) → Prop :=
    fun π h' => ∀ x ∈ S π, π x ≠ Fin.append (ovR (π (z π))) h'
  have hgood_card : ∀ π, 2 ^ (r + c) - n ≤ (Finset.univ.filter (good π)).card := by
    intro π
    have hbad : (Finset.univ.filter fun h' => ¬ good π h') ⊆ (S π).image (fun x => ovH (π x)) := by
      intro h' hh
      simp only [good, Finset.mem_filter, Finset.mem_univ, true_and, not_forall, not_not] at hh
      obtain ⟨x, hx, hxe⟩ := hh
      exact Finset.mem_image.2 ⟨x, hx, by rw [hxe, ovH_append]⟩
    have hsplit := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset (Bits (r + c)))) (good π)
    rw [Finset.card_univ, card_bits] at hsplit
    have := (Finset.card_le_card hbad).trans (Finset.card_image_le.trans (hS π))
    omega
  have hpairs : (Finset.univ.filter E).card * (2 ^ (r + c) - n) ≤
      ((Finset.univ.filter E ×ˢ (Finset.univ : Finset (Bits (r + c)))).filter (fun p => good p.1 p.2)).card := by
    have hsum : ((Finset.univ.filter E ×ˢ (Finset.univ : Finset (Bits (r + c)))).filter
        (fun p => good p.1 p.2)).card = ∑ π ∈ Finset.univ.filter E, (Finset.univ.filter (good π)).card := by
      rw [Finset.card_filter, Finset.sum_product]
      exact Finset.sum_congr rfl (fun π _ => (Finset.card_filter _ _).symm)
    rw [hsum, ← smul_eq_mul]
    exact Finset.card_nsmul_le_sum _ _ _ (fun π _ => hgood_card π)
  refine hpairs.trans ((Finset.card_le_card_of_injOn
    (fun p => swapTo p.1 (z p.1) (Fin.append (ovR (p.1 (z p.1))) p.2))
    (fun _ _ => Finset.mem_coe.2 (Finset.mem_univ _)) ?_).trans Finset.card_univ.le)
  intro p₁ hp₁ p₂ hp₂ heq
  simp only [Finset.coe_filter, Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and,
    Set.mem_ofPred_eq] at hp₁ hp₂
  obtain ⟨⟨hE₁, -⟩, hg₁⟩ := hp₁
  obtain ⟨⟨hE₂, -⟩, hg₂⟩ := hp₂
  dsimp only at heq
  set π' := swapTo p₁.1 (z p₁.1) (Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2) with hπ'
  have hag₁ : ∀ x ∈ S p₁.1, π' x = p₁.1 x := fun x hx =>
    swapTo_apply_ne _ _ _ x (fun h => (hE p₁.1 hE₁).2 (h ▸ hx)) (hg₁ x hx)
  have hag₂ : ∀ x ∈ S p₂.1, π' x = p₂.1 x := fun x hx => by
    rw [heq]; exact swapTo_apply_ne _ _ _ x (fun h => (hE p₂.1 hE₂).2 (h ▸ hx)) (hg₂ x hx)
  obtain ⟨hz₁, hT₁⟩ := hstab p₁.1 π' hag₁
  obtain ⟨hz₂, hT₂⟩ := hstab p₂.1 π' hag₂
  have hzz : z p₂.1 = z p₁.1 := hz₂.symm.trans hz₁
  have hself₁ : π' (z p₁.1) = Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2 := swapTo_self _ _ _
  have hself₂ : π' (z p₁.1) = Fin.append (ovR (p₂.1 (z p₁.1))) p₂.2 := by
    rw [heq, ← hzz]; exact swapTo_self _ _ _
  have hh : p₁.2 = p₂.2 := by
    have := congrArg ovH (hself₁.symm.trans hself₂)
    simpa only [ovH_append] using this
  have hr : ovR (p₁.1 (z p₁.1)) = ovR (p₂.1 (z p₁.1)) := by
    have := congrArg ovR (hself₁.symm.trans hself₂)
    simpa only [ovR_append] using this
  have hv : p₁.1 (z p₁.1) = p₂.1 (z p₁.1) := by
    rw [← append_ovR_ovH (p₁.1 (z p₁.1)), ← append_ovR_ovH (p₂.1 (z p₁.1)), hr]
    congr 1
    rw [(hE p₁.1 hE₁).1, ← hzz, (hE p₂.1 hE₂).1, ← hT₁, hT₂]
  have hrec₁ := swapTo_recover p₁.1 (z p₁.1) (Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2)
  have hrec₂ := swapTo_recover p₂.1 (z p₂.1) (Fin.append (ovR (p₂.1 (z p₂.1))) p₂.2)
  rw [← hπ'] at hrec₁
  rw [← heq, hzz] at hrec₂
  refine Prod.ext ?_ hh
  rw [← hrec₁, ← hrec₂, hv]

open Classical in
/-- **Adaptive pin, as a probability**: the event has probability at most `1/(2^(r+c) − n)`. -/
theorem pr_pin_le (z : Equiv.Perm (Bits (r + (r + c))) → Bits (r + (r + c)))
    (T : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c))
    (S : Equiv.Perm (Bits (r + (r + c))) → Finset (Bits (r + (r + c)))) (n : ℕ)
    (hS : ∀ π, (S π).card ≤ n)
    (hstab : ∀ π π' : Equiv.Perm (Bits (r + (r + c))), (∀ x ∈ S π, π' x = π x) → z π' = z π ∧ T π' = T π)
    (E : Equiv.Perm (Bits (r + (r + c))) → Prop)
    (hE : ∀ π, E π → ovH (π (z π)) = T π ∧ z π ∉ S π) :
    pr E ≤ (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by
  have hnat := card_pin_le z T S n hS hstab E hE
  rcases Nat.eq_zero_or_pos (2 ^ (r + c) - n) with h0 | hpos
  · rw [h0, Nat.cast_zero, ENNReal.inv_zero]; exact le_top
  have hΩ0 : (Fintype.card (Equiv.Perm (Bits (r + (r + c)))) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (Equiv.Perm (Bits (r + (r + c)))) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) ≠ 0 := by exact_mod_cast hpos.ne'
  have h2t : (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) ≠ ⊤ := ENNReal.natCast_ne_top _
  rw [pr, ENNReal.div_le_iff hΩ0 hΩt]
  have hc : ((Finset.univ.filter E).card : ℝ≥0∞) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))
      ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := by exact_mod_cast hnat
  calc ((Finset.univ.filter E).card : ℝ≥0∞)
      = (Finset.univ.filter E).card * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by
        rw [mul_assoc, ENNReal.mul_inv_cancel h2 h2t, mul_one]
    _ ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by gcongr
    _ = (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ * Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := mul_comm _ _

end Pin

/-- The lexicographic key of a chain position `(v, p)`, `p < B + 2`. -/
def posKey {B : ℕ} (q : Fin B × ℕ) : ℕ := q.1.val * (B + 2) + q.2

end Birthday

namespace ChainReplay

open Reach Reach.ChainReplayR Birthday

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)


/-- The honest chain positions `(v, p)`, `1 ≤ p ≤ ovCalls v`. -/
def posSet : Finset (Fin B × ℕ) := (ovPos B).filter (fun q => 1 ≤ q.2 ∧ q.2 ≤ ovCalls R.G q.1)

theorem mem_posSet {q : Fin B × ℕ} : q ∈ R.posSet ↔ 1 ≤ q.2 ∧ q.2 ≤ ovCalls R.G q.1 := by
  unfold posSet
  rw [Finset.mem_filter]
  refine ⟨fun h => h.2, fun h => ⟨Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 ?_⟩, h⟩⟩
  have := R.ovCalls_lt q.1
  omega

theorem posKey_inj {q q' : Fin B × ℕ} (hq : q ∈ R.posSet) (hq' : q' ∈ R.posSet) (h : posKey q = posKey q') :
    q = q' := by
  have h1 : q.2 < B + 2 := by have := R.ovCalls_lt q.1; have := (R.mem_posSet.1 hq).2; omega
  have h2 : q'.2 < B + 2 := by have := R.ovCalls_lt q'.1; have := (R.mem_posSet.1 hq').2; omega
  unfold posKey at h
  have hmod : q.2 = q'.2 := by
    have e1 : (q.1.val * (B + 2) + q.2) % (B + 2) = q.2 := by
      rw [Nat.mul_add_mod_of_lt h1]
    have e2 : (q'.1.val * (B + 2) + q'.2) % (B + 2) = q'.2 := by
      rw [Nat.mul_add_mod_of_lt h2]
    rw [← e1, ← e2, h]
  have hdiv : q.1.val = q'.1.val := by
    rw [hmod] at h
    exact Nat.eq_of_mul_eq_mul_right (by omega) (Nat.add_right_cancel h)
  exact Prod.ext (Fin.ext hdiv) hmod

/-- A parent's pad position comes before every position of its child. -/
theorem posKey_parent_lt {u v : Fin B} (huv : u < v) (p : ℕ) :
    posKey (u, ovCalls R.G u) < posKey (v, p + 1) := by
  have h1 := R.ovCalls_lt u
  have h2 : u.val + 1 ≤ v.val := huv
  have h3 : (u.val + 1) * (B + 2) ≤ v.val * (B + 2) := Nat.mul_le_mul_right _ h2
  unfold posKey
  simp only
  rw [Nat.succ_mul] at h3
  omega

/-- The number of chain positions is at most `B(B+1)/2`: block `v` has `ovCalls v ≤ v + 1` positions. -/
theorem card_posSet_le_half : R.posSet.card ≤ B * (B + 1) / 2 := by
  have hsub : R.posSet ⊆ Finset.univ.biUnion (fun v : Fin B => (Finset.Icc 1 (ovCalls R.G v)).image (fun p => (v, p))) := by
    intro q hq
    obtain ⟨h1, h2⟩ := R.mem_posSet.1 hq
    exact Finset.mem_biUnion.2 ⟨q.1, Finset.mem_univ _, Finset.mem_image.2 ⟨q.2, Finset.mem_Icc.2 ⟨h1, h2⟩, rfl⟩⟩
  refine (Finset.card_le_card hsub).trans (Finset.card_biUnion_le.trans ?_)
  calc ∑ v : Fin B, ((Finset.Icc 1 (ovCalls R.G v)).image (fun p => (v, p))).card
      ≤ ∑ v : Fin B, (v.val + 1) := Finset.sum_le_sum fun v _ => by
        refine Finset.card_image_le.trans ?_
        rw [Nat.card_Icc]
        have := parentsDesc_length_le R.G v
        unfold ovCalls; omega
    _ ≤ B * (B + 1) / 2 := by
        rw [Nat.le_div_iff_mul_le (by norm_num : (0 : ℕ) < 2)]
        have hg : (∑ j : Fin B, (j.val + 1)) * 2 = B * (B + 1) := by
          rw [Fin.sum_univ_eq_sum_range (fun i => i + 1) B, Finset.sum_add_distrib, Finset.sum_const,
            Finset.card_range, smul_eq_mul, mul_one, add_mul, Finset.sum_range_id_mul_two]
          cases B with
          | zero => rfl
          | succ n => simp only [Nat.succ_sub_one]; ring
        exact hg.le

/-- The number of chain positions is at most `nPos`. -/
theorem card_posSet_le : R.posSet.card ≤ nPos B R.Q := by
  have := R.card_posSet_le_half
  unfold nPos; omega


/-- **Prefix stability.** If `π'` agrees with `π` at the chain inputs of every position before key `n`, the chain
inputs of every position up to key `n` agree. -/
theorem xin_stable {π π' : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (n : ℕ)
    (hag : ∀ q ∈ R.posSet, posKey q < n → π' (R.xin π q.1 q.2) = π (R.xin π q.1 q.2)) :
    ∀ q ∈ R.posSet, posKey q ≤ n → R.xin π' q.1 q.2 = R.xin π q.1 q.2 := by
  suffices h : ∀ m, ∀ q ∈ R.posSet, posKey q = m → m ≤ n → R.xin π' q.1 q.2 = R.xin π q.1 q.2 from
    fun q hq hn => h _ q hq rfl hn
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    rintro ⟨v, p⟩ hq rfl hn
    obtain ⟨hp1, hp⟩ := R.mem_posSet.1 hq
    simp only at hp1 hp ⊢
    obtain ⟨p', rfl⟩ : ∃ p', p = p' + 1 := ⟨p - 1, by omega⟩
    rw [xin_succ R π' v p' (by omega), xin_succ R π v p' (by omega)]
    congr 1
    · by_cases hpar : p' < (parentsDesc R.G v).length
      · rw [blks_getElem_parent R π' v p' hpar, blks_getElem_parent R π v p' hpar]
        have hu : (parentsDesc R.G v)[p'] < v := parentsDesc_lt R.G (List.getElem_mem hpar)
        rw [R.labelG_eq_realPt π' _, R.labelG_eq_realPt π _, R.realPt_eq_xin π' _, R.realPt_eq_xin π _]
        have hmem : ((parentsDesc R.G v)[p'], ovCalls R.G (parentsDesc R.G v)[p']) ∈ R.posSet :=
          R.mem_posSet.2 ⟨by unfold ovCalls; omega, le_rfl⟩
        have hkey := R.posKey_parent_lt hu p'
        have hx := ih _ hkey _ hmem rfl (by omega)
        simp only at hx
        rw [hx, hag _ hmem (by omega)]
      · have hpad : p' = (parentsDesc R.G v).length := by unfold ovCalls at hp; omega
        have e : ∀ ρ : Equiv.Perm (Bits (ℓ + (ℓ + c))),
            (blks R ρ v)[p']'(by rw [blks_length]; omega) = padBlk := by
          intro ρ
          simp only [blks, absorbedG]
          rw [List.getElem_append_right (by simp; omega)]
          simp [hpad]
        rw [e π', e π]
    · rcases Nat.eq_zero_or_pos p' with h0 | hpos
      · subst h0; rw [chainH_zero, chainH_zero]
      · obtain ⟨q', rfl⟩ : ∃ q', p' = q' + 1 := ⟨p' - 1, by omega⟩
        rw [chainH_succ R π' v q' (by omega), chainH_succ R π v q' (by omega)]
        have hmem : (v, q' + 1) ∈ R.posSet := R.mem_posSet.2 ⟨by omega, by simp only; omega⟩
        have hkey : posKey (v, q' + 1) < posKey (v, q' + 1 + 1) := by simp only [posKey]; omega
        have hx := ih _ hkey _ hmem rfl (by omega)
        simp only at hx
        rw [hx, hag _ hmem (by omega)]


/-- `a` and `b` share their chain input, and no two positions before `b` do. -/
def FirstColl (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (a b : Fin B × ℕ) : Prop :=
  R.xin π a.1 a.2 = R.xin π b.1 b.2 ∧
    ∀ q ∈ R.posSet, ∀ q' ∈ R.posSet, posKey q < posKey q' → posKey q' < posKey b →
      R.xin π q.1 q.2 ≠ R.xin π q'.1 q'.2

/-- **A collision has a first one.** -/
theorem exists_firstColl {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (h : R.Bad π) :
    ∃ a ∈ R.posSet, ∃ b ∈ R.posSet, posKey a < posKey b ∧ R.FirstColl π a b := by
  classical
  unfold Bad NoCollU at h
  push Not at h
  obtain ⟨v, p, v', p', hp1, hp, hp1', hp', hne, heq⟩ := h
  have hm : (v, p) ∈ R.posSet := R.mem_posSet.2 ⟨hp1, hp⟩
  have hm' : (v', p') ∈ R.posSet := R.mem_posSet.2 ⟨hp1', hp'⟩
  have hkne : posKey (v, p) ≠ posKey (v', p') := by
    intro hk
    have := R.posKey_inj hm hm' hk
    simp only [Prod.mk.injEq] at this
    rcases hne with h | h
    · exact h this.1
    · exact h this.2
  have hP : ∃ n, ∃ a ∈ R.posSet, ∃ b ∈ R.posSet, posKey a < posKey b ∧ posKey b = n ∧
      R.xin π a.1 a.2 = R.xin π b.1 b.2 := by
    rcases lt_or_gt_of_ne hkne with hlt | hlt
    · exact ⟨_, (v, p), hm, (v', p'), hm', hlt, rfl, heq⟩
    · exact ⟨_, (v', p'), hm', (v, p), hm, hlt, rfl, heq.symm⟩
  obtain ⟨a, ha, b, hb, hab, hbn, hxe⟩ := Nat.find_spec hP
  refine ⟨a, ha, b, hb, hab, hxe, fun q hq q' hq' hqq' hq'b hcoll => ?_⟩
  exact Nat.find_min hP (hbn ▸ hq'b) ⟨q, hq, q', hq', hqq', rfl, hcoll⟩

/-- The position whose output is pinned by a collision of `a < b`: `b`'s predecessor, or `a`'s if `b` is a first call. -/
def pinPos (a b : Fin B × ℕ) : Fin B × ℕ := if 2 ≤ b.2 then (b.1, b.2 - 1) else (a.1, a.2 - 1)

/-- The `h`-value it is pinned to: `a`'s previous chaining value, or `b`'s IV. -/
noncomputable def pinVal (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (a b : Fin B × ℕ) : Bits (ℓ + c) :=
  if 2 ≤ b.2 then chainH R π a.1 (a.2 - 1) else iv (R.dom b.1.val)

/-- The chain inputs of the positions before key `n`. -/
noncomputable def earlierPts (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (n : ℕ) : Finset (Bits (ℓ + (ℓ + c))) :=
  (R.posSet.filter (fun q => posKey q < n)).image (fun q => R.xin π q.1 q.2)

theorem card_earlierPts_le (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (n : ℕ) :
    (R.earlierPts π n).card ≤ R.posSet.card :=
  Finset.card_image_le.trans (Finset.card_filter_le _ _)

/-- A chain input's `h`-part is the previous chaining value. -/
theorem ovH_xin (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ} (hq : q ∈ R.posSet) :
    ovH (R.xin π q.1 q.2) = chainH R π q.1 (q.2 - 1) := by
  obtain ⟨h1, h2⟩ := R.mem_posSet.1 hq
  obtain ⟨p', hp'⟩ : ∃ p', q.2 = p' + 1 := ⟨q.2 - 1, by omega⟩
  rw [hp', xin_succ R π q.1 p' (by omega), ovH_append]
  simp

theorem iv_injective {d d' : Bits c} (h : iv (r := ℓ) d = iv d') : d = d' := by
  funext j
  have := congrFun h (Fin.natAdd ℓ j)
  simpa [iv, Fin.append_right] using this

/-- **A first collision pins one output.** Both inputs share their `h`-part. If `b` is a first call, `a` is not (two IVs
differ), and `a`'s predecessor's output equals `b`'s IV. Otherwise `b`'s predecessor's output equals `a`'s previous
chaining value. The pinned input is new. -/
theorem firstColl_pin (hdom : Function.Injective (fun i : Fin B => R.dom i)) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {a b : Fin B × ℕ} (ha : a ∈ R.posSet) (hb : b ∈ R.posSet) (hab : posKey a < posKey b)
    (hF : R.FirstColl π a b) :
    (2 ≤ b.2 ∨ 2 ≤ a.2) ∧
      ovH (π (R.xin π (pinPos a b).1 (pinPos a b).2)) = R.pinVal π a b ∧
      R.xin π (pinPos a b).1 (pinPos a b).2 ∉ R.earlierPts π (posKey (pinPos a b)) := by
  obtain ⟨hxe, hfirst⟩ := hF
  obtain ⟨ha1, ha2⟩ := R.mem_posSet.1 ha
  obtain ⟨hb1, hb2⟩ := R.mem_posSet.1 hb
  have hh : chainH R π a.1 (a.2 - 1) = chainH R π b.1 (b.2 - 1) := by
    rw [← R.ovH_xin π ha, ← R.ovH_xin π hb, hxe]
  -- the pinned position is in the order before `b`, and is a chain position
  have hcase : 2 ≤ b.2 ∨ 2 ≤ a.2 := by
    by_contra hno
    push Not at hno
    have hb1' : b.2 = 1 := by omega
    have ha1' : a.2 = 1 := by omega
    rw [ha1', hb1', show 1 - 1 = 0 from rfl, chainH_zero, chainH_zero] at hh
    have hd := hdom (iv_injective hh)
    have : a = b := Prod.ext hd (by omega)
    rw [this] at hab
    exact lt_irrefl _ hab
  have hpin_mem : pinPos a b ∈ R.posSet := by
    unfold pinPos
    split_ifs with h2
    · exact R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
    · exact R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
  have hpin_key : posKey (pinPos a b) < posKey b := by
    unfold pinPos posKey
    split_ifs with h2
    · simp only; omega
    · simp only; unfold posKey at hab; omega
  refine ⟨hcase, ?_, ?_⟩
  · unfold pinPos pinVal
    split_ifs with h2
    · simp only
      obtain ⟨q', hq'⟩ : ∃ q', b.2 - 1 = q' + 1 := ⟨b.2 - 2, by omega⟩
      rw [hh, hq', chainH_succ R π b.1 q' (by omega)]
    · simp only
      have hb1' : b.2 = 1 := by omega
      have ha2' : 2 ≤ a.2 := by omega
      obtain ⟨q', hq'⟩ : ∃ q', a.2 - 1 = q' + 1 := ⟨a.2 - 2, by omega⟩
      rw [hq', ← chainH_succ R π a.1 q' (by omega), ← hq', hh, hb1', show 1 - 1 = 0 from rfl, chainH_zero]
  · intro hmem
    obtain ⟨q, hq, hqx⟩ := Finset.mem_image.1 hmem
    obtain ⟨hqs, hqk⟩ := Finset.mem_filter.1 hq
    exact hfirst q hqs _ hpin_mem hqk hpin_key hqx

/-- **One pair collides first with probability at most `1/(2^(ℓ+c) − M)`.** -/
theorem pr_firstColl_le (hdom : Function.Injective (fun i : Fin B => R.dom i)) {a b : Fin B × ℕ}
    (ha : a ∈ R.posSet) (hb : b ∈ R.posSet) (hab : posKey a < posKey b) :
    pr (fun π => R.FirstColl π a b) ≤ (((2 ^ (ℓ + c) - R.posSet.card : ℕ) : ℝ≥0∞))⁻¹ := by
  by_cases hcase : 2 ≤ b.2 ∨ 2 ≤ a.2
  · obtain ⟨ha1, ha2⟩ := R.mem_posSet.1 ha
    obtain ⟨hb1, hb2⟩ := R.mem_posSet.1 hb
    have hpin_mem : pinPos a b ∈ R.posSet := by
      unfold pinPos
      split_ifs with h2
      · exact R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
      · exact R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
    refine pr_pin_le (fun π => R.xin π (pinPos a b).1 (pinPos a b).2) (fun π => R.pinVal π a b)
      (fun π => R.earlierPts π (posKey (pinPos a b))) R.posSet.card (fun π => R.card_earlierPts_le π _)
      ?_ _ (fun π hF => (R.firstColl_pin hdom ha hb hab hF).2)
    intro π π' hag
    have hag' : ∀ q ∈ R.posSet, posKey q < posKey (pinPos a b) →
        π' (R.xin π q.1 q.2) = π (R.xin π q.1 q.2) := fun q hq hk =>
      hag _ (Finset.mem_image.2 ⟨q, Finset.mem_filter.2 ⟨hq, hk⟩, rfl⟩)
    refine ⟨R.xin_stable _ hag' _ hpin_mem le_rfl, ?_⟩
    show R.pinVal π' a b = R.pinVal π a b
    unfold pinVal
    split_ifs with h2
    · rcases Nat.lt_or_ge a.2 2 with ha' | ha'
      · rw [show a.2 - 1 = 0 by omega, chainH_zero, chainH_zero]
      · obtain ⟨q', hq'⟩ : ∃ q', a.2 - 1 = q' + 1 := ⟨a.2 - 2, by omega⟩
        rw [hq', chainH_succ R π' a.1 q' (by omega), chainH_succ R π a.1 q' (by omega)]
        have hmem : (a.1, q' + 1) ∈ R.posSet := R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
        have hkey : posKey (a.1, q' + 1) < posKey (pinPos a b) := by
          unfold pinPos; simp only [h2, ↓reduceIte, posKey] at hab ⊢; omega
        have hx := R.xin_stable _ hag' _ hmem hkey.le
        simp only at hx
        rw [hx, hag' _ hmem hkey]
    · rfl
  · classical
    push Not at hcase
    refine le_trans (le_of_eq ?_) zero_le
    rw [pr, ENNReal.div_eq_zero_iff]
    left
    norm_cast
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    intro π _ hF
    have := (R.firstColl_pin hdom ha hb hab hF).1
    omega

/-- **The collision term.** With injective block domains, `pr[Bad] ≤ nPos²/2^(ℓ+c)`. -/
theorem pr_Bad_le (hdom : Function.Injective (fun i : Fin B => R.dom i)) :
    pr (fun π => R.Bad π) ≤ (((nPos B R.Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c) := by
  classical
  set M := R.posSet.card with hM
  set pairs := (R.posSet ×ˢ R.posSet).filter (fun x => posKey x.1 < posKey x.2) with hpairs
  have hunion : pr (fun π => R.Bad π) ≤ ∑ x ∈ pairs, pr (fun π => R.FirstColl π x.1 x.2) := by
    refine le_trans (pr_mono fun π hπ => ?_) (PousThm1Dense.pr_exists_le pairs (fun x π => R.FirstColl π x.1 x.2))
    obtain ⟨a, ha, b, hb, hab, hF⟩ := R.exists_firstColl hπ
    exact ⟨(a, b), Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨ha, hb⟩, hab⟩, hF⟩
  have hsum : ∑ x ∈ pairs, pr (fun π => R.FirstColl π x.1 x.2)
      ≤ pairs.card * (((2 ^ (ℓ + c) - M : ℕ) : ℝ≥0∞))⁻¹ := by
    rw [← nsmul_eq_mul]
    refine Finset.sum_le_card_nsmul _ _ _ fun x hx => ?_
    obtain ⟨hx1, hx2⟩ := Finset.mem_filter.1 hx
    obtain ⟨ha, hb⟩ := Finset.mem_product.1 hx1
    exact R.pr_firstColl_le hdom ha hb hx2
  -- `2·|pairs| ≤ M²`: the pairs and their swaps are disjoint within `posSet²`
  have hpairs2 : 2 * pairs.card ≤ M ^ 2 := by
    set pairs' := (R.posSet ×ˢ R.posSet).filter (fun x => posKey x.2 < posKey x.1)
    have hcard' : pairs'.card = pairs.card := by
      refine Finset.card_bij (fun x _ => x.swap) (fun x hx => ?_) (fun x _ y _ h => ?_) (fun y hy => ?_)
      · obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hx
        obtain ⟨ha, hb⟩ := Finset.mem_product.1 h1
        exact Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨hb, ha⟩, h2⟩
      · simpa using h
      · obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hy
        obtain ⟨ha, hb⟩ := Finset.mem_product.1 h1
        exact ⟨y.swap, Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨hb, ha⟩, h2⟩, by simp⟩
    have hdisj : Disjoint pairs pairs' := by
      rw [Finset.disjoint_filter]
      intro x _ h1 h2
      omega
    have hsub : pairs ∪ pairs' ⊆ R.posSet ×ˢ R.posSet :=
      Finset.union_subset (Finset.filter_subset _ _) (Finset.filter_subset _ _)
    have := Finset.card_le_card hsub
    rw [Finset.card_union_of_disjoint hdisj, Finset.card_product, hcard'] at this
    rw [sq, hM]; omega
  have hMn : M ≤ nPos B R.Q := R.card_posSet_le
  by_cases h2M : 2 * M ≤ 2 ^ (ℓ + c)
  · have hinv := inv_two_pow_sub_le (ℓ := ℓ + c) h2M
    calc pr (fun π => R.Bad π)
        ≤ pairs.card * (((2 ^ (ℓ + c) - M : ℕ) : ℝ≥0∞))⁻¹ := hunion.trans hsum
      _ ≤ pairs.card * (2 * ((2 : ℝ≥0∞) ^ (ℓ + c))⁻¹) := by gcongr
      _ = ((2 * pairs.card : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c) := by
          rw [div_eq_mul_inv]; push_cast; ring
      _ ≤ (((nPos B R.Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c) := by
          gcongr
          exact hpairs2.trans (Nat.pow_le_pow_left hMn 2)
  · push Not at h2M
    have hbig : 2 ^ (ℓ + c) ≤ (nPos B R.Q) ^ 2 := by
      have hM1 : 1 ≤ M := by
        rcases Nat.eq_zero_or_pos M with h | h
        · rw [h] at h2M; simp at h2M
        · exact h
      have hMM : 2 ^ (ℓ + c) ≤ M ^ 2 := by
        rcases Nat.lt_or_ge M 2 with hM2 | hM2
        · have hM1' : M = 1 := by omega
          rw [hM1'] at h2M ⊢
          have : 2 ^ (ℓ + c) ≤ 1 := by omega
          simpa using this
        · calc 2 ^ (ℓ + c) ≤ 2 * M := h2M.le
            _ ≤ M * M := Nat.mul_le_mul_right _ hM2
            _ = M ^ 2 := (sq M).symm
      exact hMM.trans (Nat.pow_le_pow_left hMn 2)
    refine (PousThm1Dense.pr_le_one _).trans ?_
    rw [ENNReal.le_div_iff_mul_le (Or.inl (by positivity)) (Or.inl (by simp)), one_mul]
    exact_mod_cast hbig

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFLazy ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)


/-- **The deciding point** of item `(v, p)`: the one `Π₂` input whose sample decides its honest quantity, `xin v p`
(the label at `p = ovCalls v` decides `keyAt v = ovR (π (xin v (ovCalls v)))`, and `xin v (ovCalls v) = realPt v`). -/
noncomputable def decidePt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (q : Fin B × ℕ) : Bits (ℓ + (ℓ + c)) :=
  R.xin π q.1 q.2

/-- **Independence (load-bearing).** Distinct chain positions have distinct deciding points, directly from `NoCollU`. So
no single `Π₂` sample decides two fresh items, and the lazy-sampling per-item factors multiply. -/
theorem decidePt_inj {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (hnc : R.NoCollU π)
    {q q' : Fin B × ℕ} (hq : q ∈ R.posSet) (hq' : q' ∈ R.posSet) (hne : q ≠ q') :
    R.decidePt π q ≠ R.decidePt π q' := by
  obtain ⟨hp1, hp2⟩ := R.mem_posSet.1 hq
  obtain ⟨hp1', hp2'⟩ := R.mem_posSet.1 hq'
  refine hnc q.1 q.2 q'.1 q'.2 hp1 hp2 hp1' hp2' ?_
  by_cases h1 : q.1 = q'.1
  · by_cases h2 : q.2 = q'.2
    · exact absurd (Prod.ext h1 h2) hne
    · exact Or.inr h2
  · exact Or.inl h1


/-- **The folded key an observation commits for a label at `v`.** An inverse query `Π₂⁻¹ y` commits its dropped r-part
`ovR y` as the **key**; a forward query `Π₂ x` and a guess commit their r-part as the **label**, whose key is `⊕ Wb v`.
So one obs commits exactly one `ℓ`-bit key — no two-form disjunction — and the item needs no form bit. π-independent
given the transcript entry. -/
noncomputable def obsFoldKey (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (o : R.Pos) (v : Fin B) :
    Option (Bits ℓ × ℕ) :=
  match o with
  | .inl (i, k) =>
      if k.val < R.Q then
        ((R.tr π i)[k.val]?).map (fun e =>
          ((match e.2 with | .inl _ => bxor (qKey e.2) (R.Wb v) | .inr _ => qKey e.2), e.1))
      else some (bxor ((R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π)) (R.Wb v),
                 (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π))
  | .inr _ => none


/-- **Obligation 3 (every step below `nPos`).** The adversary's queries (`≤ B·Q`, each thread `(D,Q)`-bounded) plus the
honest chain points (`≤ B(B+1)/2`, `card_posSet_le_half`) number at most `nPos = B(Q+1) + B(B+1)/2`. So every named
(deciding) step index — a step of this sequence — is below `nPos`, and `pin_mul_le` applies with `k = nPos`. -/
theorem steps_le_nPos (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (∑ i : Fin B, (R.tr π i).length) + R.posSet.card ≤ nPos B R.Q := by
  have hadv : (∑ i : Fin B, (R.tr π i).length) ≤ B * R.Q := by
    calc (∑ i : Fin B, (R.tr π i).length) ≤ ∑ _i : Fin B, R.Q :=
          Finset.sum_le_sum (fun i _ => R.tr_length_le hP π i)
      _ = B * R.Q := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
  have hlab : R.posSet.card ≤ B * (B + 1) / 2 := R.card_posSet_le_half
  have hnpos : nPos B R.Q = B * (R.Q + 1) + B * (B + 1) / 2 := rfl
  have hBQ : B * (R.Q + 1) = B * R.Q + B := by ring
  omega

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFLabeller ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal


/-- `idealPerm`'s answers, as a plain function: forward `σ x`, inverse `σ⁻¹ y`. -/
def bandAnswer {n : ℕ} (σ : Equiv.Perm (Bits n)) : Bits n ⊕ Bits n → Bits n
  | .inl x => σ x
  | .inr y => σ.symm y

theorem bandAnswer_eq {n : ℕ} (σ : Equiv.Perm (Bits n)) : bandAnswer σ = (idealPerm n).answer σ := by
  funext q; cases q <;> rfl


/-- An `idealPerm` program as a round program over explicit `Bits` queries and answers. -/
def toRProgI {n : ℕ} {X : Type} : OracleProg (idealPerm n) X → LazyPerm.RProg (Bits n ⊕ Bits n) (Bits n) X
  | .ret x => .ret x
  | .round qs k => .round qs (fun as => toRProgI (k as))

theorem trace_toRProgI {n : ℕ} {X : Type} (f : Bits n ⊕ Bits n → Bits n) (P : OracleProg (idealPerm n) X) :
    (toRProgI P).trace f = PousB5Chain.trace f P := by
  induction P with
  | ret x => rfl
  | round qs k ih =>
    exact congrArg (fun L => qs.map (fun x => (0, x)) ++ L.map (fun e => (e.1 + 1, e.2))) (ih (qs.map f))


section Labeller

variable {ℓ c : ℕ}

/-- The overwrite chain as rounds: one forward query per block, then `k` on the final pair. -/
def chainR {X : Type} (p : Bits ℓ × Bits (ℓ + c)) :
    List (Bits ℓ) → (Bits ℓ × Bits (ℓ + c) → LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))
      (Bits (ℓ + (ℓ + c))) X) → LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) (Bits (ℓ + (ℓ + c))) X
  | [], k => k p
  | blk :: blks, k => .round [.inl (Fin.append blk p.2)] fun ys =>
      chainR (ovR (ys.headD (Fin.append blk p.2)), ovH (ys.headD (Fin.append blk p.2))) blks k


end Labeller

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- **The labeller from block `k` on.** `acc` holds the labels of the blocks before `k`. Block `k`'s chain absorbs its
parents' labels, newest first, then the pad; its label (`r` of the pad call `⊕ Wb k`) is passed on. -/
def labR : (k : ℕ) → (Fin B → Bits ℓ) →
    LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) (Bits (ℓ + (ℓ + c))) (Bits ℓ)
  | k, acc =>
    if hk : k < B then
      chainR (fun _ => false, iv (R.dom k)) (absorbedG R.G acc ⟨k, hk⟩) fun p =>
        labR (k + 1) (Function.update acc ⟨k, hk⟩ (bxor p.1 (R.Wb ⟨k, hk⟩)))
    else .ret (fun _ => false)
  termination_by k => B - k


/-- The labeller's queries from block `k` on, when forward queries are answered by `f'` (`labR`'s fold, flattened). -/
def honestFrom (f' : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) : (k : ℕ) → (Fin B → Bits ℓ) →
    List (Bits (ℓ + (ℓ + c)))
  | k, acc =>
    if hk : k < B then
      ovInputs f' (fun _ => false, iv (R.dom k)) (absorbedG R.G acc ⟨k, hk⟩) ++
        honestFrom f' (k + 1) (Function.update acc ⟨k, hk⟩
          (bxor ((absorbedG R.G acc ⟨k, hk⟩).foldl (ovStep f') (fun _ => false, iv (R.dom k))).1 (R.Wb ⟨k, hk⟩)))
    else []
  termination_by k => B - k


/-- **The labeller's queries are the honest chain points.** Under a permutation, `honestFrom` from block `k` (with the
true labels before `k`) is the chain inputs of blocks `k, …, B−1`. -/
theorem honestFrom_eq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ (k : ℕ) (acc : Fin B → Bits ℓ), (∀ u : Fin B, u.val < k → acc u = labelG R.G (fun x => π x) R.dom R.Wb u) →
      R.honestFrom (fun x => π x) k acc = ((List.finRange B).drop k).flatMap (R.chainInputList π) := by
  intro k
  induction h : B - k using Nat.strong_induction_on generalizing k with
  | _ n ih =>
    intro acc hacc
    rw [honestFrom]
    by_cases hk : k < B
    · simp only [hk, ↓reduceDIte]
      have habs : absorbedG R.G acc ⟨k, hk⟩ = absorbedG R.G (labelG R.G (fun x => π x) R.dom R.Wb) ⟨k, hk⟩ := by
        unfold absorbedG
        congr 1
        exact List.map_congr_left fun u hu => hacc u (parentsDesc_lt R.G hu)
      have hlab : bxor ((absorbedG R.G acc ⟨k, hk⟩).foldl (ovStep (fun x => π x)) (fun _ => false, iv (R.dom k))).1
          (R.Wb ⟨k, hk⟩) = labelG R.G (fun x => π x) R.dom R.Wb ⟨k, hk⟩ := by
        rw [labelG_eq, habs]
        rfl
      rw [hlab, ih (B - (k + 1)) (by omega) (k + 1) rfl _ (fun u hu => ?_)]
      · rw [List.drop_eq_getElem_cons (i := k) (l := List.finRange B) (by simp; exact hk), List.flatMap_cons, List.getElem_finRange]
        simp only [Fin.cast_mk]
        rw [habs]
        rfl
      · by_cases huk : u = ⟨k, hk⟩
        · rw [huk, Function.update_self]
        · rw [Function.update_of_ne huk]
          exact hacc u (lt_of_le_of_ne (Nat.lt_succ_iff.1 hu) (fun h => huk (Fin.ext h)))
    · simp only [hk, ↓reduceDIte]
      rw [List.drop_eq_nil_of_le (by simp; omega), List.flatMap_nil]


/-- The one-component oracle of the band game. -/
abbrev BandAlpha (ℓ c : ℕ) : Unit → Type := fun _ => Bits (ℓ + (ℓ + c))

/-- A band query as a lazy-perm query. -/
def bandEnc (q : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) : LazyPerm.Qry (BandAlpha ℓ c) := ⟨(), q⟩

/-- A lazy-perm answer as a band answer. -/
def bandDec (e : LazyPerm.Entry (BandAlpha ℓ c)) : Bits (ℓ + (ℓ + c)) := e.2


/-- The answers the strategy's threads see: `idealPerm`'s (`bandAnswer_eq`), for `π ()`. -/
theorem bandAns (π : LazyPerm.Oracle (BandAlpha ℓ c)) :
    (fun q => bandDec (LazyPerm.qEntry π bandEnc q)) = bandAnswer (π ()) := by
  funext q; cases q <;> rfl

/-- The honest chain points, block by block: `chainInputList 0 ++ … ++ chainInputList (B−1)`. -/
noncomputable def honestSeq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : List (Bits (ℓ + (ℓ + c))) :=
  (List.finRange B).flatMap (R.chainInputList π)

/-- The adversary's queries, round by round and thread by thread. -/
noncomputable def advSeq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : List (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) :=
  (List.range R.D).flatMap fun ρ => (List.finRange B).flatMap fun i =>
    (toRProgI (R.P i)).roundQs (bandAnswer π) ρ


/-- An adversary thread's round-program trace is its transcript `R.tr`. -/
theorem advTrace_eq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) :
    (toRProgI (R.P i)).trace (bandAnswer π) = R.tr π i :=
  trace_toRProgI (bandAnswer π) (R.P i)


/-- The number of chain positions is the number of chain calls. -/
theorem card_posSet_eq : R.posSet.card = ∑ v : Fin B, ovCalls R.G v := by
  classical
  have heq : R.posSet = Finset.univ.biUnion
      (fun v : Fin B => (Finset.Icc 1 (ovCalls R.G v)).image (fun p => (v, p))) := by
    ext q
    simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_image, Finset.mem_Icc, R.mem_posSet]
    constructor
    · rintro ⟨h1, h2⟩; exact ⟨q.1, q.2, ⟨h1, h2⟩, rfl⟩
    · rintro ⟨v, p, ⟨h1, h2⟩, rfl⟩; exact ⟨h1, h2⟩
  rw [heq, Finset.card_biUnion]
  · refine Finset.sum_congr rfl (fun v _ => ?_)
    rw [Finset.card_image_of_injective _ (fun a b h => (Prod.mk.inj h).2), Nat.card_Icc]
    omega
  · intro v _ w _ hvw
    simp only [Function.onFun, Finset.disjoint_left, Finset.mem_image]
    rintro q ⟨p, _, rfl⟩ ⟨p', _, h⟩
    exact hvw (congrArg Prod.fst h).symm

/-- There is one honest point per chain position. -/
theorem honestSeq_length (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : (R.honestSeq π).length = R.posSet.card := by
  rw [R.card_posSet_eq, honestSeq, List.length_flatMap, Fin.sum_univ_def]
  congr 1
  exact List.map_congr_left fun v _ => R.chainInputList_length π v

theorem honestFrom_zero (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    R.honestFrom (fun x => π x) 0 (fun _ _ => false) = R.honestSeq π := by
  rw [R.honestFrom_eq π 0 _ (fun u hu => absurd hu (Nat.not_lt_zero _)), List.drop_zero]
  rfl


theorem len_flatMap_range {β : Type} (g : ℕ → List β) :
    ∀ D, ((List.range D).flatMap g).length = ∑ ρ ∈ Finset.range D, (g ρ).length
  | 0 => rfl
  | D + 1 => by
    rw [List.range_succ, List.flatMap_append, List.length_append, len_flatMap_range g D, Finset.sum_range_succ]
    simp

theorem len_flatMap_finRange {β : Type} (g : Fin B → List β) :
    ((List.finRange B).flatMap g).length = ∑ i : Fin B, (g i).length := by
  rw [List.length_flatMap, Fin.sum_univ_def]

theorem sum_filterMap_round {Q : Type} {D : ℕ} :
    ∀ (L : List (ℕ × Q)), (∀ e ∈ L, e.1 < D) →
      ∑ ρ ∈ Finset.range D, (L.filterMap (fun e => if e.1 = ρ then some e.2 else none)).length = L.length
  | [], _ => by simp
  | e :: L, hL => by
    have hstep : ∀ ρ, ((e :: L).filterMap (fun e => if e.1 = ρ then some e.2 else none)).length
        = (if e.1 = ρ then 1 else 0) + (L.filterMap (fun e => if e.1 = ρ then some e.2 else none)).length := by
      intro ρ
      by_cases h : e.1 = ρ
      · simp [List.filterMap_cons, h]; omega
      · simp [List.filterMap_cons, h]
    simp only [hstep, Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.mem_range,
      hL e (List.mem_cons_self), ↓reduceIte, sum_filterMap_round L (fun e' he' => hL e' (List.mem_cons_of_mem _ he')),
      List.length_cons]
    omega

/-- The number of steps: all adversary queries plus one per chain position. -/
theorem bandSeq_length (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : LazyPerm.Oracle (BandAlpha ℓ c)) :
    (R.advSeq (π ())).length + (R.honestSeq (π ())).length
      = (∑ i : Fin B, (R.tr (π ()) i).length) + R.posSet.card := by
  rw [R.honestSeq_length]
  congr 1
  unfold advSeq
  rw [len_flatMap_range]
  simp only [len_flatMap_finRange]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  simp only [LazyPerm.RProg.roundQs_eq_trace, R.advTrace_eq]
  refine sum_filterMap_round _ (fun e he => ?_)
  exact lt_of_lt_of_le (PousB5Chain.round_lt_depth ((idealPerm (ℓ + (ℓ + c))).answer (π ())) (R.P i) e he)
    (hP i (π ())).1


/-- **Every chain point is an honest point.** -/
theorem xin_mem_honestSeq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ} (hq : q ∈ R.posSet) :
    R.xin π q.1 q.2 ∈ R.honestSeq π := by
  obtain ⟨h1, h2⟩ := R.mem_posSet.1 hq
  have hlt : q.2 - 1 < (R.chainInputList π q.1).length := by rw [R.chainInputList_length]; omega
  have hx : R.xin π q.1 q.2 = (R.chainInputList π q.1)[q.2 - 1] := by
    rw [xin, List.getElem?_eq_getElem hlt]; rfl
  rw [hx]
  exact List.mem_flatMap.2 ⟨q.1, List.mem_finRange _, List.getElem_mem hlt⟩


end ChainReplay

end PousSpongeChain

end


/-! ════ BandChainKeyRule ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace Pous.BandChain

namespace KeyRule

open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal

variable {N : ℕ}


open Classical in
/-- `read` with the key rule: keys give labels, and labels give keys (the pad call's `r`). -/
noncomputable def read' (G : TopoDAG N) (K : ChainKnow N) : ChainKnow N where
  labs := K.labs ∪ Finset.univ.filter fun v => (v, ovCalls G v) ∈ K.rs
  hs := K.hs
  rs := K.rs ∪ K.labs.image fun v => (v, ovCalls G v)

open Classical in
/-- `round` with the key rule in its `read`. -/
noncomputable def round' (G : TopoDAG N) (K : ChainKnow N) : ChainKnow N :=
  read' G
    { labs := K.labs ∪ Finset.univ.filter fun u => ∃ p ∈ K.hs, p ∈ K.rs ∧ ovBlock G p.1 p.2 = some u
      hs := K.hs ∪ (ovPos N).filter fun p => K.canCall G p.1 p.2 ∨
          (1 ≤ p.2 ∧ (p.1, p.2 + 1) ∈ K.hs ∧ (p.1, p.2 + 1) ∈ K.rs)
      rs := K.rs ∪ (ovPos N).filter fun p => K.canCall G p.1 p.2 }

/-- The knowledge after `t` rounds, with the key rule. -/
noncomputable def reach' (G : TopoDAG N) (P₀ : ChainKnow N) : ℕ → ChainKnow N
  | 0 => read' G P₀
  | t + 1 => round' G (reach' G P₀ t)

/-- Hardness in the chain game with the key rule. -/
def ChainHard' (G : TopoDAG N) (VC : Finset (Fin N)) (c ℓ : ℕ) (s : ℚ) (D k : ℕ) : Prop :=
  ∀ P₀ : ChainKnow N, P₀.size c ℓ ≤ s → (VC.filter fun v => v ∈ (reach' G P₀ D).labs).card < k

theorem mem_read'_labs (G : TopoDAG N) (K : ChainKnow N) (v : Fin N) :
    v ∈ (read' G K).labs ↔ v ∈ K.labs ∨ (v, ovCalls G v) ∈ K.rs := by
  simp [read']

theorem mem_read'_hs (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) : p ∈ (read' G K).hs ↔ p ∈ K.hs := Iff.rfl

theorem mem_read'_rs (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) :
    p ∈ (read' G K).rs ↔ p ∈ K.rs ∨ ∃ v ∈ K.labs, p = (v, ovCalls G v) := by
  simp only [read', Finset.mem_union, Finset.mem_image]
  constructor
  · rintro (h | ⟨v, hv, rfl⟩)
    · exact Or.inl h
    · exact Or.inr ⟨v, hv, rfl⟩
  · rintro (h | ⟨v, hv, rfl⟩)
    · exact Or.inl h
    · exact Or.inr ⟨v, hv, rfl⟩


/-- Componentwise inclusion of knowledge. -/
def Le (K K' : ChainKnow N) : Prop := K.labs ⊆ K'.labs ∧ K.hs ⊆ K'.hs ∧ K.rs ⊆ K'.rs

theorem canCall_mono {G : TopoDAG N} {K K' : ChainKnow N} (h : Le K K') {v : Fin N} {j : ℕ}
    (hc : K.canCall G v j) : K'.canCall G v j := by
  obtain ⟨h1, h2, h3, h4⟩ := hc
  refine ⟨h1, h2, fun u hu => h.1 (h3 u hu), ?_⟩
  rcases h4 with h4 | h4
  · exact Or.inl h4
  · exact Or.inr (h.2.1 h4)

theorem mem_round'_labs (G : TopoDAG N) (K : ChainKnow N) (u : Fin N) :
    u ∈ (round' G K).labs ↔ (u ∈ K.labs ∨ ∃ p ∈ K.hs, p ∈ K.rs ∧ ovBlock G p.1 p.2 = some u) ∨
      ((u, ovCalls G u) ∈ K.rs ∨ ((u, ovCalls G u) ∈ ovPos N ∧ K.canCall G u (ovCalls G u))) := by
  simp [round', read', or_assoc]

theorem mem_round'_hs (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) :
    p ∈ (round' G K).hs ↔ p ∈ K.hs ∨ (p ∈ ovPos N ∧ (K.canCall G p.1 p.2 ∨
      (1 ≤ p.2 ∧ (p.1, p.2 + 1) ∈ K.hs ∧ (p.1, p.2 + 1) ∈ K.rs))) := by
  simp [round', read']

theorem mem_round'_rs (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) :
    p ∈ (round' G K).rs ↔ (p ∈ K.rs ∨ (p ∈ ovPos N ∧ K.canCall G p.1 p.2)) ∨
      ∃ v, (v ∈ K.labs ∨ ∃ q ∈ K.hs, q ∈ K.rs ∧ ovBlock G q.1 q.2 = some v) ∧ p = (v, ovCalls G v) := by
  simp only [round', mem_read'_rs, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]


end KeyRule

open KeyRule
open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal


/-- `ChainExPostFactoG` with `ChainHard'` as its hardness hypothesis. -/
def ChainExPostFactoG' : Prop :=
  ∀ (B ℓ c m s D Q k : ℕ) (G : TopoDAG B) (dom : ℕ → Bits c) (Wb : Fin B → Bits ℓ),
    Function.Injective (fun i : Fin B => dom i) → ChainHard' G Finset.univ c ℓ s D k →
    ∀ (A₁ : Equiv.Perm (Bits (ℓ + (ℓ + c))) → Bits m)
      (A₂ : Bits m → Fin B → Pous.OracleProg (idealPerm (ℓ + (ℓ + c))) (Bits ℓ)),
      (∀ σ i, (A₂ σ i).Bounded D Q) →
      pr (fun π : Equiv.Perm (Bits (ℓ + (ℓ + c))) =>
          k ≤ (Finset.univ.filter fun i =>
            (A₂ (A₁ π) i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG G π dom Wb i).card)
        ≤ 2 ^ m * 2 * ((((nPos B Q) ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * s) +
          (((nPos B Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c)


end Pous.BandChain

end


/-! ════ BandChainKeyRuleEquiv ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace Pous.BandChain

namespace KeyRule

open Pous Pous.Labelling Pous.Sponge PousSpongeChain

variable {N : ℕ}

open Classical in
/-- Every seeded `h` at or above a row's pad call becomes the `h` before the pad call. -/
noncomputable def swapH (G : TopoDAG N) (P₀ : ChainKnow N) : ChainKnow N where
  labs := P₀.labs
  hs := P₀.hs.filter (fun p => p.2 < ovCalls G p.1) ∪
    (P₀.hs.filter (fun p => ovCalls G p.1 ≤ p.2)).image (fun p => (p.1, ovCalls G p.1 - 1))
  rs := P₀.rs

theorem ovBlock_lt {G : TopoDAG N} {v : Fin N} {j : ℕ} {u : Fin N} (h : ovBlock G v j = some u) :
    j < ovCalls G v := by
  unfold ovBlock at h
  have := (List.getElem?_eq_some_iff.1 h).1
  unfold ovCalls
  omega

/-- The domination invariant: `K'` (with the key rule) against `K` (without it). -/
structure Dom (G : TopoDAG N) (K' K : ChainKnow N) : Prop where
  labs : K'.labs ⊆ K.labs
  hlo : ∀ p ∈ K'.hs, p.2 < ovCalls G p.1 → p ∈ K.hs
  hhi : ∀ p ∈ K'.hs, ovCalls G p.1 ≤ p.2 → ovCalls G p.1 - 1 = 0 ∨ (p.1, ovCalls G p.1 - 1) ∈ K.hs
  rs : ∀ p ∈ K'.rs, p.2 ≠ ovCalls G p.1 → p ∈ K.rs
  pad : ∀ v, (v, ovCalls G v) ∈ K'.rs → v ∈ K.labs

theorem canCall_of_dom {G : TopoDAG N} {K' K : ChainKnow N} (h : Dom G K' K) {v : Fin N} {j : ℕ}
    (hc : K'.canCall G v j) : K.canCall G v j := by
  obtain ⟨h1, h2, h3, h4⟩ := hc
  refine ⟨h1, h2, fun u hu => h.labs (h3 u hu), ?_⟩
  rcases h4 with h4 | h4
  · exact Or.inl h4
  · exact Or.inr (h.hlo _ h4 (by simp only; omega))

theorem mem_round_labs_iff (G : TopoDAG N) (K : ChainKnow N) (u : Fin N) :
    u ∈ (K.round G).labs ↔ (u ∈ K.labs ∨ ∃ p ∈ K.hs, p ∈ K.rs ∧ ovBlock G p.1 p.2 = some u) ∨
      ((u, ovCalls G u) ∈ K.rs ∨ ((u, ovCalls G u) ∈ ovPos N ∧ K.canCall G u (ovCalls G u))) := by
  simp [ChainKnow.round, ChainKnow.read, or_assoc]

theorem mem_round_hs_iff (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) :
    p ∈ (K.round G).hs ↔ p ∈ K.hs ∨ (p ∈ ovPos N ∧ (K.canCall G p.1 p.2 ∨
      (1 ≤ p.2 ∧ (p.1, p.2 + 1) ∈ K.hs ∧ (p.1, p.2 + 1) ∈ K.rs))) := by
  simp [ChainKnow.round, ChainKnow.read]

theorem mem_round_rs_iff (G : TopoDAG N) (K : ChainKnow N) (p : Fin N × ℕ) :
    p ∈ (K.round G).rs ↔ p ∈ K.rs ∨ (p ∈ ovPos N ∧ K.canCall G p.1 p.2) := by
  simp [ChainKnow.round, ChainKnow.read]

theorem dom_zero (G : TopoDAG N) (P₀ : ChainKnow N) : Dom G (reach' G P₀ 0) (ChainKnow.reach G (swapH G P₀) 0) := by
  classical
  refine ⟨fun v hv => ?_, fun p hp hlt => ?_, fun p hp hge => ?_, fun p hp hne => ?_, fun v hv => ?_⟩
  · rw [reach', mem_read'_labs] at hv
    rw [ChainKnow.reach, mem_read_labs]
    exact hv
  · rw [reach', mem_read'_hs] at hp
    show p ∈ (swapH G P₀).hs
    exact Finset.mem_union_left _ (Finset.mem_filter.2 ⟨hp, hlt⟩)
  · rw [reach', mem_read'_hs] at hp
    refine Or.inr ?_
    show (p.1, ovCalls G p.1 - 1) ∈ (swapH G P₀).hs
    exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨p, Finset.mem_filter.2 ⟨hp, hge⟩, rfl⟩)
  · rw [reach', mem_read'_rs] at hp
    rcases hp with hp | ⟨v, _, rfl⟩
    · exact hp
    · exact absurd rfl hne
  · rw [reach', mem_read'_rs] at hv
    rw [ChainKnow.reach, mem_read_labs]
    rcases hv with hv | ⟨w, hw, hwv⟩
    · exact Or.inr hv
    · have : w = v := (Prod.ext_iff.1 hwv).1.symm
      subst this
      exact Or.inl hw

theorem dom_round (G : TopoDAG N) {K' K : ChainKnow N} (h : Dom G K' K) : Dom G (round' G K') (K.round G) := by
  classical
  have hKl : ∀ u ∈ K.labs, u ∈ (K.round G).labs := fun u hu => (mem_round_labs_iff G K u).2 (Or.inl (Or.inl hu))
  have hKh : ∀ p ∈ K.hs, p ∈ (K.round G).hs := fun p hp => (mem_round_hs_iff G K p).2 (Or.inl hp)
  -- the labels `round'` adds before its `read'` are labels of `K.round`
  have hlab : ∀ u, (u ∈ K'.labs ∨ ∃ p ∈ K'.hs, p ∈ K'.rs ∧ ovBlock G p.1 p.2 = some u) → u ∈ (K.round G).labs := by
    intro u hu
    rw [mem_round_labs_iff]
    rcases hu with hu | ⟨p, hph, hpr, hb⟩
    · exact Or.inl (Or.inl (h.labs hu))
    · have hlt := ovBlock_lt hb
      exact Or.inl (Or.inr ⟨p, h.hlo p hph hlt, h.rs p hpr (by omega), hb⟩)
  refine ⟨fun u hu => ?_, fun p hp hlt => ?_, fun p hp hge => ?_, fun p hp hne => ?_, fun v hv => ?_⟩
  · rw [mem_round'_labs] at hu
    rcases hu with hu | hu | ⟨hpos, hc⟩
    · exact hlab u hu
    · exact hKl _ (h.pad u hu)
    · rw [mem_round_labs_iff]
      exact Or.inr (Or.inr ⟨hpos, canCall_of_dom h hc⟩)
  · rw [mem_round'_hs] at hp
    rw [mem_round_hs_iff]
    rcases hp with hp | ⟨hpos, hc | ⟨h1, h2, h3⟩⟩
    · exact Or.inl (h.hlo p hp hlt)
    · exact Or.inr ⟨hpos, Or.inl (canCall_of_dom h hc)⟩
    · by_cases hnext : p.2 + 1 < ovCalls G p.1
      · exact Or.inr ⟨hpos, Or.inr ⟨h1, h.hlo _ h2 hnext, h.rs _ h3 (by simp only; omega)⟩⟩
      · have heq : p.2 + 1 = ovCalls G p.1 := by omega
        rcases h.hhi _ h2 (by simp only; omega) with h0 | hprev
        · simp only at h0; omega
        · have : (p.1, ovCalls G p.1 - 1) = p := Prod.ext rfl (by simp only; omega)
          rw [this] at hprev
          exact Or.inl hprev
  · rw [mem_round'_hs] at hp
    rcases hp with hp | ⟨hpos, hc | ⟨h1, h2, h3⟩⟩
    · exact (h.hhi p hp hge).imp_right fun h' => hKh _ h'
    · have hle := hc.2.1
      have heq : p.2 = ovCalls G p.1 := by omega
      rcases hc.2.2.2 with h1' | hprev
      · exact Or.inl (by omega)
      · refine Or.inr (hKh _ ?_)
        have h1p := hc.1
        have := h.hlo _ hprev (by show p.2 - 1 < ovCalls G p.1; omega)
        rwa [heq] at this
    · exact (h.hhi _ h2 (by simp only; omega)).imp_right fun h' => hKh _ h'
  · rw [mem_round'_rs] at hp
    rw [mem_round_rs_iff]
    rcases hp with (hp | ⟨hpos, hc⟩) | ⟨v, _, rfl⟩
    · exact Or.inl (h.rs p hp hne)
    · exact Or.inr ⟨hpos, canCall_of_dom h hc⟩
    · exact absurd rfl hne
  · rw [mem_round'_rs] at hv
    rcases hv with (hv | ⟨hpos, hc⟩) | ⟨w, hw, hwv⟩
    · exact hKl _ (h.pad v hv)
    · rw [mem_round_labs_iff]
      exact Or.inr (Or.inr ⟨hpos, canCall_of_dom h hc⟩)
    · have : w = v := (Prod.ext_iff.1 hwv).1.symm
      subst this
      exact hlab w hw

theorem dom_reach (G : TopoDAG N) (P₀ : ChainKnow N) :
    ∀ t, Dom G (reach' G P₀ t) (ChainKnow.reach G (swapH G P₀) t)
  | 0 => dom_zero G P₀
  | t + 1 => dom_round G (dom_reach G P₀ t)

theorem card_swapH_hs_le (G : TopoDAG N) (P₀ : ChainKnow N) :
    ((swapH G P₀).hs.filter fun p => p.2 ≠ 0).card ≤ (P₀.hs.filter fun p => p.2 ≠ 0).card := by
  classical
  set A := P₀.hs.filter (fun p => p.2 < ovCalls G p.1)
  set B := P₀.hs.filter (fun p => ovCalls G p.1 ≤ p.2)
  have hsub : ((swapH G P₀).hs.filter fun p => p.2 ≠ 0) ⊆
      (A.filter fun p => p.2 ≠ 0) ∪ B.image (fun p => (p.1, ovCalls G p.1 - 1)) := by
    intro p hp
    rw [Finset.mem_filter] at hp
    rcases Finset.mem_union.1 hp.1 with h1 | h2
    · exact Finset.mem_union_left _ (Finset.mem_filter.2 ⟨h1, hp.2⟩)
    · exact Finset.mem_union_right _ h2
  have hdisj : Disjoint (A.filter fun p => p.2 ≠ 0) B := by
    rw [Finset.disjoint_left]
    intro p hA hB
    have := (Finset.mem_filter.1 (Finset.mem_filter.1 hA).1).2
    have := (Finset.mem_filter.1 hB).2
    omega
  have hunion : (A.filter fun p => p.2 ≠ 0) ∪ B ⊆ P₀.hs.filter fun p => p.2 ≠ 0 := by
    intro p hp
    rcases Finset.mem_union.1 hp with h1 | h2
    · exact Finset.mem_filter.2 ⟨(Finset.mem_filter.1 (Finset.mem_filter.1 h1).1).1, (Finset.mem_filter.1 h1).2⟩
    · have h2' := Finset.mem_filter.1 h2
      have : 1 ≤ ovCalls G p.1 := by unfold ovCalls; omega
      exact Finset.mem_filter.2 ⟨h2'.1, by omega⟩
  calc ((swapH G P₀).hs.filter fun p => p.2 ≠ 0).card
      ≤ ((A.filter fun p => p.2 ≠ 0) ∪ B.image (fun p => (p.1, ovCalls G p.1 - 1))).card := Finset.card_le_card hsub
    _ ≤ (A.filter fun p => p.2 ≠ 0).card + (B.image (fun p => (p.1, ovCalls G p.1 - 1))).card := Finset.card_union_le _ _
    _ ≤ (A.filter fun p => p.2 ≠ 0).card + B.card := Nat.add_le_add_left Finset.card_image_le _
    _ = ((A.filter fun p => p.2 ≠ 0) ∪ B).card := (Finset.card_union_of_disjoint hdisj).symm
    _ ≤ (P₀.hs.filter fun p => p.2 ≠ 0).card := Finset.card_le_card hunion

theorem size_swapH_le (G : TopoDAG N) (P₀ : ChainKnow N) (c ℓ : ℕ) :
    (swapH G P₀).size c ℓ ≤ P₀.size c ℓ := by
  unfold ChainKnow.size
  have h := card_swapH_hs_le G P₀
  have hc : (0 : ℚ) ≤ 1 + (c : ℚ) / ℓ := by positivity
  have : (1 + (c : ℚ) / ℓ) * ((swapH G P₀).hs.filter fun p => p.2 ≠ 0).card ≤
      (1 + (c : ℚ) / ℓ) * (P₀.hs.filter fun p => p.2 ≠ 0).card := by
    gcongr
  simp only [swapH] at this ⊢
  linarith

/-- **The key rule does not change hardness.** -/
theorem chainHard'_of_chainHard {G : TopoDAG N} {VC : Finset (Fin N)} {c ℓ : ℕ} {s : ℚ} {D k : ℕ}
    (h : ChainHard G VC c ℓ s D k) : ChainHard' G VC c ℓ s D k := fun P₀ hs =>
  lt_of_le_of_lt (Finset.card_le_card fun v hv => by
      rw [Finset.mem_filter] at hv ⊢; exact ⟨hv.1, (dom_reach G P₀ D).labs hv.2⟩)
    (h (swapH G P₀) ((size_swapH_le G P₀ c ℓ).trans hs))


end KeyRule

open KeyRule

/-- **The two targets are equivalent**: `ChainExPostFactoG'` gives back `ChainExPostFactoG`, so every theorem
conditional on `ChainExPostFactoG` (band 64 KB and 14 GB, dense via `ChainExPostFactoGSpec`) transfers verbatim. -/
theorem chainExPostFactoG_of_chainExPostFactoG' (h : ChainExPostFactoG') : ChainExPostFactoG :=
  fun B ℓ c m s D Q k G dom Wb hdom hhard A₁ A₂ hA =>
    h B ℓ c m s D Q k G dom Wb hdom (chainHard'_of_chainHard hhard) A₁ A₂ hA


open Pous Pous.Sponge PousSpongeChain


end Pous.BandChain

end


/-! ════ ChainEPFV6VC ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

/-- A v6 seed coordinate. Labels and pad keys share the single `.r (v,pad)` atom. -/
inductive VAtom (B : ℕ) where
  | r : Fin B × ℕ → VAtom B
  | h : Fin B × ℕ → VAtom B
deriving DecidableEq

/-- One coordinate commitment at one showing position. -/
structure VCommit (B Q : ℕ) where
  pos : ((Fin B × Fin (Q + 1)) ⊕ Fin B)
  atom : VAtom B
deriving DecidableEq

namespace ChainKnow

variable {N : ℕ}

def empty : ChainKnow N := ⟨∅, ∅, ∅⟩

def union (A B : ChainKnow N) : ChainKnow N :=
  ⟨A.labs ∪ B.labs, A.hs ∪ B.hs, A.rs ∪ B.rs⟩

open Classical in
/-- Coordinates shown now and not already determined. -/
noncomputable def fresh (S K : ChainKnow N) : ChainKnow N :=
  ⟨S.labs \ K.labs, S.hs \ K.hs, S.rs \ K.rs⟩


end ChainKnow

end PousSpongeChain

namespace Pous.BandChain.KeyRule

open Pous Pous.Labelling Pous.Sponge PousSpongeChain

variable {N : ℕ}

theorem Le.rfl' (K : ChainKnow N) : Le K K :=
  ⟨subset_rfl, subset_rfl, subset_rfl⟩

theorem Le.trans {A B C : ChainKnow N} (h₁ : Le A B) (h₂ : Le B C) : Le A C :=
  ⟨h₁.1.trans h₂.1, h₁.2.1.trans h₂.2.1, h₁.2.2.trans h₂.2.2⟩

theorem le_union_left (A B : ChainKnow N) : Le A (PousSpongeChain.ChainKnow.union A B) :=
  ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left⟩

theorem le_union_right (A B : ChainKnow N) : Le B (PousSpongeChain.ChainKnow.union A B) :=
  ⟨Finset.subset_union_right, Finset.subset_union_right, Finset.subset_union_right⟩

theorem read'_mono (G : TopoDAG N) {K K' : ChainKnow N} (h : Le K K') :
    Le (read' G K) (read' G K') := by
  refine ⟨fun v hv => ?_, fun p hp => ?_, fun p hp => ?_⟩
  · rw [mem_read'_labs] at hv ⊢
    exact hv.imp (fun hl => h.1 hl) (fun hr => h.2.2 hr)
  · rw [mem_read'_hs] at hp ⊢
    exact h.2.1 hp
  · rw [mem_read'_rs] at hp ⊢
    rcases hp with hp | ⟨v, hv, rfl⟩
    · exact Or.inl (h.2.2 hp)
    · exact Or.inr ⟨v, h.1 hv, rfl⟩

theorem round'_mono (G : TopoDAG N) {K K' : ChainKnow N} (h : Le K K') :
    Le (round' G K) (round' G K') := by
  refine ⟨fun u hu => ?_, fun p hp => ?_, fun p hp => ?_⟩
  · rw [mem_round'_labs] at hu ⊢
    rcases hu with (hu | ⟨p, hh, hr, hb⟩) | (hr | ⟨hpos, hc⟩)
    · exact Or.inl (Or.inl (h.1 hu))
    · exact Or.inl (Or.inr ⟨p, h.2.1 hh, h.2.2 hr, hb⟩)
    · exact Or.inr (Or.inl (h.2.2 hr))
    · exact Or.inr (Or.inr ⟨hpos, canCall_mono h hc⟩)
  · rw [mem_round'_hs] at hp ⊢
    rcases hp with hp | ⟨hpos, hc | ⟨h1, hh, hr⟩⟩
    · exact Or.inl (h.2.1 hp)
    · exact Or.inr ⟨hpos, Or.inl (canCall_mono h hc)⟩
    · exact Or.inr ⟨hpos, Or.inr ⟨h1, h.2.1 hh, h.2.2 hr⟩⟩
  · rw [mem_round'_rs] at hp ⊢
    rcases hp with (hp | ⟨hpos, hc⟩) | ⟨v, hv, rfl⟩
    · exact Or.inl (Or.inl (h.2.2 hp))
    · exact Or.inl (Or.inr ⟨hpos, canCall_mono h hc⟩)
    · rcases hv with hv | ⟨q, hh, hr, hb⟩
      · exact Or.inr ⟨v, Or.inl (h.1 hv), rfl⟩
      · exact Or.inr ⟨v, Or.inr ⟨q, h.2.1 hh, h.2.2 hr, hb⟩, rfl⟩

theorem reach'_mono (G : TopoDAG N) {K K' : ChainKnow N} (h : Le K K') :
    ∀ t, Le (reach' G K t) (reach' G K' t)
  | 0 => read'_mono G h
  | t + 1 => round'_mono G (reach'_mono G h t)

theorem le_read' (G : TopoDAG N) (K : ChainKnow N) : Le K (read' G K) :=
  ⟨fun v hv => (mem_read'_labs G K v).2 (Or.inl hv), fun p hp => hp,
    fun p hp => (mem_read'_rs G K p).2 (Or.inl hp)⟩

theorem le_round' (G : TopoDAG N) (K : ChainKnow N) : Le K (round' G K) := by
  refine ⟨fun u hu => ?_, fun p hp => ?_, fun p hp => ?_⟩
  · exact (mem_round'_labs G K u).2 (Or.inl (Or.inl hu))
  · exact (mem_round'_hs G K p).2 (Or.inl hp)
  · exact (mem_round'_rs G K p).2 (Or.inl (Or.inl hp))

theorem reach'_le_succ (G : TopoDAG N) (K : ChainKnow N) (t : ℕ) :
    Le (reach' G K t) (reach' G K (t + 1)) :=
  le_round' G _

theorem reach'_le (G : TopoDAG N) (K : ChainKnow N) {t t' : ℕ} (h : t ≤ t') :
    Le (reach' G K t) (reach' G K t') := by
  induction t', h using Nat.le_induction with
  | base => exact Le.rfl' _
  | succ t' _ ih => exact ih.trans (reach'_le_succ G K t')

theorem holding_le_reach' (G : TopoDAG N) (K : ChainKnow N) (t : ℕ) :
    Le K (reach' G K t) :=
  (le_read' G K).trans (reach'_le G K (Nat.zero_le t))

theorem label_of_pad_r_reach' (G : TopoDAG N) (K : ChainKnow N) (t : ℕ) (v : Fin N)
    (h : (v, ovCalls G v) ∈ (reach' G K t).rs) : v ∈ (reach' G K t).labs := by
  classical
  cases t with
  | zero =>
      rw [reach'] at h ⊢
      rw [mem_read'_rs] at h
      rw [mem_read'_labs]
      rcases h with h | ⟨u, hu, heq⟩
      · exact Or.inr h
      · cases heq
        exact Or.inl hu
  | succ t =>
      rw [reach', round'] at h ⊢
      rw [mem_read'_rs] at h
      rw [mem_read'_labs]
      rcases h with h | ⟨u, hu, heq⟩
      · exact Or.inr h
      · cases heq
        exact Or.inl hu

end Pous.BandChain.KeyRule

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

open Pous.BandChain.KeyRule

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- The honest output coordinates of call `(v,p)`. -/
noncomputable def rVal (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (q : Fin B × ℕ) : Bits ℓ :=
  ovR (π (R.xin π q.1 q.2))

noncomputable def hVal (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (q : Fin B × ℕ) : Bits (ℓ + c) :=
  ovH (π (R.xin π q.1 q.2))


noncomputable def obsR (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (o : R.Pos) (q : Fin B × ℕ) :
    Option (Bits ℓ × ℕ) :=
  if q.2 = ovCalls R.G q.1 then R.obsFoldKey π o q.1
  else
    match o with
    | .inl (_, k) => if k.val < R.Q then R.obsKey π o else none
    | .inr _ => none

/-- A chain pair is revealed in round `ρ`. -/
def revealedAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ρ : ℕ) (q : Fin B × ℕ) : Prop :=
  R.askedPt π (R.xin π q.1 q.2) ρ


open Classical in
/-- One round of the history-backed closure.  Only pairs revealed in this round fire. -/
noncomputable def vcStepAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ρ : ℕ) (K : ChainKnow B) :
    ChainKnow B where
  labs := K.labs ∪ Finset.univ.filter fun u =>
    ∃ q ∈ K.hs, q ∈ K.rs ∧ q ∈ R.posSet ∧ R.revealedAt π ρ q ∧
      ovBlock R.G q.1 q.2 = some u
  hs := K.hs ∪ R.posSet.filter fun q =>
    (R.revealedAt π ρ q ∧ K.canCall R.G q.1 q.2) ∨
      (q.2 + 1 ≤ ovCalls R.G q.1 ∧ R.revealedAt π ρ (q.1, q.2 + 1) ∧
        (q.1, q.2 + 1) ∈ K.hs ∧ (q.1, q.2 + 1) ∈ K.rs)
  rs := K.rs ∪ R.posSet.filter fun q =>
    R.revealedAt π ρ q ∧ K.canCall R.G q.1 q.2

open Classical in
/-- The unrestricted one-round move before `read'`; factored out of `round'` for the inclusion proof. -/
noncomputable def gameStep (K : ChainKnow B) : ChainKnow B where
  labs := K.labs ∪ Finset.univ.filter fun u => ∃ p ∈ K.hs, p ∈ K.rs ∧ ovBlock R.G p.1 p.2 = some u
  hs := K.hs ∪ (ovPos B).filter fun p => K.canCall R.G p.1 p.2 ∨
    (1 ≤ p.2 ∧ (p.1, p.2 + 1) ∈ K.hs ∧ (p.1, p.2 + 1) ∈ K.rs)
  rs := K.rs ∪ (ovPos B).filter fun p => K.canCall R.G p.1 p.2

theorem round'_eq_read_gameStep (K : ChainKnow B) :
    round' R.G K = read' R.G (R.gameStep K) := rfl

theorem vcStepAt_le_gameStep (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ρ : ℕ) (K : ChainKnow B) :
    Le (R.vcStepAt π ρ K) (R.gameStep K) := by
  classical
  refine ⟨fun u hu => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · rcases Finset.mem_union.1 hu with hu | hu
    · exact Finset.mem_union_left _ hu
    · obtain ⟨p, hpH, hpR, -, -, hb⟩ := (Finset.mem_filter.1 hu).2
      exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, ⟨p, hpH, hpR, hb⟩⟩)
  · rcases Finset.mem_union.1 hq with hq | hq
    · exact Finset.mem_union_left _ hq
    · obtain ⟨hpos, hq⟩ := Finset.mem_filter.1 hq
      have hov : q ∈ ovPos B := by
        unfold posSet at hpos
        exact (Finset.mem_filter.1 hpos).1
      refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hov, ?_⟩)
      rcases hq with ⟨-, hc⟩ | ⟨hn, -, hh, hr⟩
      · exact Or.inl hc
      · exact Or.inr ⟨by
          have := (R.mem_posSet.1 hpos).1
          omega, hh, hr⟩
  · rcases Finset.mem_union.1 hq with hq | hq
    · exact Finset.mem_union_left _ hq
    · obtain ⟨hpos, -, hc⟩ := Finset.mem_filter.1 hq
      have hov : q ∈ ovPos B := by
        unfold posSet at hpos
        exact (Finset.mem_filter.1 hpos).1
      exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hov, hc⟩)

/-- One causal VC step is contained in one key-rule game round. -/
theorem vcStepAt_subset_round (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ρ : ℕ) (K : ChainKnow B) :
    Le (read' R.G (R.vcStepAt π ρ K)) (round' R.G K) := by
  rw [R.round'_eq_read_gameStep]
  exact read'_mono R.G (R.vcStepAt_le_gameStep π ρ K)

/-- `VCcredit(τ)`: start with the accepted seeds and process the revealed pairs of rounds
`0, …, τ-1`, once per causal round.  Round-`τ` pairs are absent. -/
noncomputable def vcCredit (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ℕ → ChainKnow B → ChainKnow B
  | 0, H => read' R.G H
  | τ + 1, H => read' R.G (R.vcStepAt π τ (vcCredit R π τ H))

/-- **G2, no slack.** The round-causal determined set is in key-rule reach after exactly `τ`
rounds, not `τ+1`. -/
theorem vc_credit_subset_reach (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (H : ChainKnow B) :
    ∀ τ, Le (R.vcCredit π τ H) (reach' R.G H τ)
  | 0 => Le.rfl' _
  | τ + 1 =>
      (R.vcStepAt_subset_round π τ (R.vcCredit π τ H)).trans
        (round'_mono R.G (R.vc_credit_subset_reach π H τ))


/-- Query positions of round `τ`, in the global thread/within-thread schedule order. -/
def queryBasisAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) : List R.Pos :=
  (List.finRange B).flatMap fun i =>
    (R.tr π i).zipIdx.filterMap fun ek =>
      if ek.1.1 = τ then
        if hk : ek.2 < R.Q then some (.inl (i, ⟨ek.2, Nat.lt_succ_of_lt hk⟩))
        else none
      else none

/-- Program outputs of depth `τ`, after the round's query commitments. -/
def guessBasisAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) : List R.Pos :=
  (List.finRange B).filterMap fun i =>
    if (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π) = τ then
      some (.inl (i, ⟨R.Q, Nat.lt_succ_self R.Q⟩))
    else none

/-- The round's showing positions: query commitments in schedule order, then depth-`τ` outputs. -/
def positionBasisAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) : List R.Pos :=
  R.queryBasisAt π τ ++ R.guessBasisAt π τ

open Classical in
/-- Candidate atoms in the fixed chain-position/r-before-h order. -/
noncomputable def atomBasis : List (VAtom B) :=
  R.posSet.toList.flatMap fun q => [VAtom.r q, VAtom.h q]

/-- This position commits this honest coordinate in round `τ`. -/
def commitMatches (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) (x : VCommit B R.Q) : Prop :=
  match x.atom with
  | .r q => R.obsR π x.pos q = some (R.rVal π q, τ)
  | .h q => R.obsKeyH π x.pos = some (R.hVal π q, τ)

open Classical in
/-- The coordinate-granular causal basis. A position that shows both `r` and `h` contributes
two consecutive commitments, so a first crossing adds at most one seed. -/
noncomputable def basisAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) : List (VCommit B R.Q) :=
  (R.positionBasisAt π τ).flatMap fun o =>
    R.atomBasis.filterMap fun a =>
      if R.commitMatches π τ ⟨o, a⟩ then some ⟨o, a⟩ else none

def atomValid : VAtom B → Prop
  | .r q => q ∈ R.posSet
  | .h q => q ∈ R.posSet

theorem atom_mem_atomBasis {a : VAtom B} (h : a ∈ R.atomBasis) : R.atomValid a := by
  classical
  unfold atomBasis at h
  obtain ⟨q, hq, ha⟩ := List.mem_flatMap.1 h
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl <;> exact Finset.mem_toList.1 hq

theorem commit_mem_basis_valid {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {τ : ℕ}
    {x : VCommit B R.Q} (h : x ∈ R.basisAt π τ) : R.atomValid x.atom := by
  classical
  unfold basisAt at h
  obtain ⟨o, -, hx⟩ := List.mem_flatMap.1 h
  obtain ⟨a, ha, hsome⟩ := List.mem_filterMap.1 hx
  split at hsome
  · have := Option.some.inj hsome
    cases this
    exact R.atom_mem_atomBasis ha
  · simp at hsome

/-- The singleton coordinate carried by one basis commitment. -/
def shownCommit (R : ChainReplay B ℓ c) (x : VCommit B R.Q) : ChainKnow B where
  labs := ∅
  hs := match x.atom with | .h q => {q} | .r _ => ∅
  rs := match x.atom with | .r q => {q} | .h _ => ∅

def PositionsValid (H : ChainKnow B) : Prop := H.hs ⊆ R.posSet ∧ H.rs ⊆ R.posSet

/-- Classify one coordinate against the causal VC plus all earlier coordinates of the round. -/
noncomputable def seedBasisStep (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ)
    (H : ChainKnow B) (x : VCommit B R.Q) : ChainKnow B :=
  PousSpongeChain.ChainKnow.union H
    (PousSpongeChain.ChainKnow.fresh (R.shownCommit x) (R.vcCredit π τ H))

theorem seedBasisStep_valid {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {τ : ℕ}
    {H : ChainKnow B} {x : VCommit B R.Q} (hH : R.PositionsValid H)
    (hx : R.atomValid x.atom) : R.PositionsValid (R.seedBasisStep π τ H x) := by
  classical
  rcases x with ⟨o, a⟩
  cases a with
  | r q =>
      simp only [atomValid] at hx
      refine ⟨?_, ?_⟩
      · simpa [seedBasisStep, PousSpongeChain.ChainKnow.union,
          PousSpongeChain.ChainKnow.fresh, shownCommit] using hH.1
      · intro p hp
        simp [seedBasisStep, PousSpongeChain.ChainKnow.union,
          PousSpongeChain.ChainKnow.fresh, shownCommit] at hp
        rcases hp with hp | hp
        · exact hH.2 hp
        · exact hp.1 ▸ hx
  | h q =>
      simp only [atomValid] at hx
      refine ⟨?_, ?_⟩
      · intro p hp
        simp [seedBasisStep, PousSpongeChain.ChainKnow.union,
          PousSpongeChain.ChainKnow.fresh, shownCommit] at hp
        rcases hp with hp | hp
        · exact hH.1 hp
        · exact hp.1 ▸ hx
      · simpa [seedBasisStep, PousSpongeChain.ChainKnow.union,
          PousSpongeChain.ChainKnow.fresh, shownCommit] using hH.2

/-- Fold a list of round-`τ` coordinate commitments. -/
noncomputable def seedFold (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ)
    (l : List (VCommit B R.Q)) (H : ChainKnow B) : ChainKnow B :=
  l.foldl (R.seedBasisStep π τ) H

theorem seedBasisStep_labs (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ)
    (H : ChainKnow B) (x : VCommit B R.Q) : (R.seedBasisStep π τ H x).labs = H.labs := by
  classical
  rcases x with ⟨o, a⟩
  cases a <;>
    simp [seedBasisStep, PousSpongeChain.ChainKnow.union, PousSpongeChain.ChainKnow.fresh, shownCommit]

theorem seedFold_labs (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) :
    ∀ (l : List (VCommit B R.Q)) (H : ChainKnow B), (R.seedFold π τ l H).labs = H.labs
  | [], _ => rfl
  | o :: l, H => by
      rw [seedFold, List.foldl_cons]
      change (R.seedFold π τ l (R.seedBasisStep π τ H o)).labs = H.labs
      rw [R.seedFold_labs π τ l, R.seedBasisStep_labs π τ H o]

/-- Seeds through the first `b` positions of round `τ`. -/
noncomputable def seedPrefixAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ)
    (H : ChainKnow B) (b : ℕ) : ChainKnow B :=
  R.seedFold π τ ((R.basisAt π τ).take b) H

theorem le_seedFold (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) :
    ∀ (l : List (VCommit B R.Q)) (H : ChainKnow B), Le H (R.seedFold π τ l H)
  | [], H => Le.rfl' H
  | o :: l, H =>
      (le_union_left H _).trans (R.le_seedFold π τ l (R.seedBasisStep π τ H o))

theorem seedFold_valid (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) :
    ∀ (l : List (VCommit B R.Q)) (H : ChainKnow B),
      (∀ x ∈ l, R.atomValid x.atom) → R.PositionsValid H →
      R.PositionsValid (R.seedFold π τ l H)
  | [], _, _, hH => hH
  | x :: l, H, hall, hH =>
      R.seedFold_valid π τ l (R.seedBasisStep π τ H x)
        (fun y hy => hall y (List.mem_cons_of_mem x hy))
        (R.seedBasisStep_valid hH (hall x (List.mem_cons_self)))

theorem le_seedPrefixAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ)
    (H : ChainKnow B) (b : ℕ) : Le H (R.seedPrefixAt π τ H b) := by
  exact R.le_seedFold π τ _ H

/-- One committed coordinate is known after classifying it. -/
theorem shownCommit_le_step (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ)
    (H : ChainKnow B) (x : VCommit B R.Q) :
    Le (R.shownCommit x) (reach' R.G (R.seedBasisStep π τ H x) τ) := by
  classical
  set S := R.shownCommit x
  set V := R.vcCredit π τ H
  set F := PousSpongeChain.ChainKnow.fresh S V
  set H' := R.seedBasisStep π τ H x
  have hH : Le H H' := le_union_left _ _
  have hF : Le F H' := le_union_right _ _
  have hV : Le V (reach' R.G H' τ) :=
    (R.vc_credit_subset_reach π H τ).trans (reach'_mono R.G hH τ)
  have hbase : Le H' (reach' R.G H' τ) := holding_le_reach' R.G H' τ
  refine ⟨fun x hx => ?_, fun x hx => ?_, fun x hx => ?_⟩
  · simpa [S, shownCommit] using hx
  · by_cases hv : x ∈ V.hs
    · exact hV.2.1 hv
    · exact hbase.2.1 (hF.2.1 (Finset.mem_sdiff.2 ⟨hx, hv⟩))
  · by_cases hv : x ∈ V.rs
    · exact hV.2.2 hv
    · exact hbase.2.2 (hF.2.2 (Finset.mem_sdiff.2 ⟨hx, hv⟩))

/-- Every coordinate in a folded basis list is known from the completed fold at the same round. -/
theorem shown_mem_seedFold (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) :
    ∀ (l : List (VCommit B R.Q)) (H : ChainKnow B) {x : VCommit B R.Q}, x ∈ l →
      Le (R.shownCommit x) (reach' R.G (R.seedFold π τ l H) τ)
  | [], _, _, h => by simp at h
  | x' :: l, H, x, h => by
      rw [List.mem_cons] at h
      set H' := R.seedBasisStep π τ H x'
      rcases h with rfl | h
      · exact (R.shownCommit_le_step π τ H x).trans
          (reach'_mono R.G (R.le_seedFold π τ l H') τ)
      · exact R.shown_mem_seedFold π τ l H' h

/-- The round-causal seed holding, with each round classified in basis order. -/
noncomputable def v6SeedsThrough (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ℕ → ChainKnow B
  | 0 => PousSpongeChain.ChainKnow.empty
  | τ + 1 =>
      let H := v6SeedsThrough R π τ
      R.seedPrefixAt π τ H (R.basisAt π τ).length

theorem v6SeedsThrough_labs_empty (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ τ, (R.v6SeedsThrough π τ).labs = ∅
  | 0 => rfl
  | τ + 1 => by
      rw [v6SeedsThrough, seedPrefixAt, R.seedFold_labs, R.v6SeedsThrough_labs_empty π τ]

theorem v6SeedsThrough_valid (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ τ, R.PositionsValid (R.v6SeedsThrough π τ)
  | 0 => ⟨Finset.empty_subset _, Finset.empty_subset _⟩
  | τ + 1 => by
      rw [v6SeedsThrough, seedPrefixAt, List.take_length]
      exact R.seedFold_valid π τ (R.basisAt π τ) (R.v6SeedsThrough π τ)
        (fun x hx => R.commit_mem_basis_valid hx) (R.v6SeedsThrough_valid π τ)


theorem seedsThrough_le_succ (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) :
    Le (R.v6SeedsThrough π τ) (R.v6SeedsThrough π (τ + 1)) :=
  by
    simp only [v6SeedsThrough]
    exact R.le_seedPrefixAt π τ _ _

theorem seedsThrough_mono (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {τ τ' : ℕ} (h : τ ≤ τ') :
    Le (R.v6SeedsThrough π τ) (R.v6SeedsThrough π τ') := by
  induction τ', h using Nat.le_induction with
  | base => exact Le.rfl' _
  | succ τ' _ ih => exact ih.trans (R.seedsThrough_le_succ π τ')

/-- Every coordinate in a completed round basis is known at that round from the resulting
seed holding. -/
theorem shown_mem_round (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) {x : VCommit B R.Q}
    (hx : x ∈ R.basisAt π τ) :
    Le (R.shownCommit x) (reach' R.G (R.v6SeedsThrough π (τ + 1)) τ) := by
  simpa only [v6SeedsThrough, seedPrefixAt, List.take_length] using
    R.shown_mem_seedFold π τ (R.basisAt π τ) (R.v6SeedsThrough π τ) hx

/-- A correct output is in the no-slack key-rule reach of the complete causal seed holding. -/
theorem correct_mem_reach_v6 (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {v : Fin B}
    (hcorr : (R.P v).run ((idealPerm (ℓ + (ℓ + c))).answer π) =
      labelG R.G (fun x => π x) R.dom R.Wb v) :
    v ∈ (reach' R.G (R.v6SeedsThrough π (R.D + 1)) R.D).labs := by
  classical
  let τ := (R.P v).depth ((idealPerm (ℓ + (ℓ + c))).answer π)
  let o : R.Pos := .inl (v, ⟨R.Q, Nat.lt_succ_self R.Q⟩)
  let q : Fin B × ℕ := (v, ovCalls R.G v)
  let x : VCommit B R.Q := ⟨o, VAtom.r q⟩
  have hτ : τ ≤ R.D := (hP v π).1
  have hoG : o ∈ R.guessBasisAt π τ := by
    unfold guessBasisAt
    exact List.mem_filterMap.2 ⟨v, List.mem_finRange v, by simp [τ, o]⟩
  have ho : o ∈ R.positionBasisAt π τ := by
    unfold positionBasisAt
    exact List.mem_append_right _ hoG
  have hq : q ∈ R.posSet := by
    apply R.mem_posSet.2
    dsimp only [q]
    exact ⟨by unfold ovCalls; omega, le_rfl⟩
  have hmatch : R.commitMatches π τ x := by
    simp only [commitMatches, x]
    simp only [obsR, q, o, if_pos rfl, obsFoldKey, lt_irrefl, ↓reduceIte, Option.some.injEq,
      Prod.mk.injEq, τ]
    rw [hcorr, R.labelG_eq_realPt π v]
    unfold rVal
    rw [R.realPt_eq_xin, PousB5Chain.bxor_cancel]
    simp
  have ha : VAtom.r q ∈ R.atomBasis := by
    unfold atomBasis
    exact List.mem_flatMap.2
      ⟨q, Finset.mem_toList.2 hq, by simp⟩
  have hx : x ∈ R.basisAt π τ := by
    unfold basisAt
    refine List.mem_flatMap.2 ⟨o, ho, ?_⟩
    refine List.mem_filterMap.2 ⟨VAtom.r q, ha, ?_⟩
    have hm : R.commitMatches π τ ⟨o, VAtom.r q⟩ := by simpa [x] using hmatch
    simp only [hm, ↓reduceIte]
    rfl
  have hshow : q ∈ (R.shownCommit x).rs := by simp [shownCommit, x]
  have hrτ := (R.shown_mem_round π τ hx).2.2 hshow
  have hhold : Le (R.v6SeedsThrough π (τ + 1)) (R.v6SeedsThrough π (R.D + 1)) :=
    R.seedsThrough_mono π (by omega)
  have hrτ' := (reach'_mono R.G hhold τ).2.2 hrτ
  have hrD := (reach'_le R.G (R.v6SeedsThrough π (R.D + 1)) hτ).2.2 hrτ'
  exact label_of_pad_r_reach' R.G _ R.D v hrD

/-- A win forces the complete v6 seed holding above the `ChainHard'` price. -/
theorem size_v6Seeds_gt (hP : ∀ i, (R.P i).Bounded R.D R.Q) {s : ℚ} {k : ℕ}
    (hard : ChainHard' R.G Finset.univ c ℓ s R.D k)
    {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hwin : k ≤ (Finset.univ.filter fun i =>
      (R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π) =
        labelG R.G (fun x => π x) R.dom R.Wb i).card) :
    s < (R.v6SeedsThrough π (R.D + 1)).size c ℓ := by
  by_contra hle
  push Not at hle
  have hhard := hard (R.v6SeedsThrough π (R.D + 1)) hle
  have hsub : (Finset.univ.filter fun i =>
      (R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π) =
        labelG R.G (fun x => π x) R.dom R.Wb i) ⊆
      Finset.univ.filter fun v =>
        v ∈ (reach' R.G (R.v6SeedsThrough π (R.D + 1)) R.D).labs := by
    intro v hv
    exact Finset.mem_filter.2
      ⟨Finset.mem_univ _, R.correct_mem_reach_v6 hP (Finset.mem_filter.1 hv).2⟩
  have := Finset.card_le_card hsub
  omega


/-- The pad `r` is the block key; labels are its zero-step `⊕ Wb` presentation. -/
theorem label_eq_pad_r (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    labelG R.G (fun x => π x) R.dom R.Wb v =
      bxor (R.rVal π (v, ovCalls R.G v)) (R.Wb v) := by
  rw [R.labelG_eq_realPt π v]
  unfold rVal
  rw [R.realPt_eq_xin]


/-- A revealed pair whose input is determined contributes both output coordinates in the next
causal VC round. -/
theorem vc_forward_complete (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ρ : ℕ) (H : ChainKnow B)
    {q : Fin B × ℕ} (hpos : q ∈ R.posSet) (hrev : R.revealedAt π ρ q)
    (hcall : (R.vcCredit π ρ H).canCall R.G q.1 q.2) :
    q ∈ (R.vcCredit π (ρ + 1) H).hs ∧ q ∈ (R.vcCredit π (ρ + 1) H).rs := by
  classical
  rw [vcCredit, mem_read'_hs, mem_read'_rs]
  constructor
  · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, Or.inl ⟨hrev, hcall⟩⟩)
  · exact Or.inl (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, hrev, hcall⟩))

/-- A revealed pair whose whole output is determined contributes its input block and preceding
chaining coordinate in the next causal VC round. -/
theorem vc_inverse_complete (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ρ : ℕ) (H : ChainKnow B)
    {q : Fin B × ℕ} (hpos : q ∈ R.posSet) (hrev : R.revealedAt π ρ q)
    (hh : q ∈ (R.vcCredit π ρ H).hs) (hr : q ∈ (R.vcCredit π ρ H).rs) :
    (∀ u, ovBlock R.G q.1 q.2 = some u → u ∈ (R.vcCredit π (ρ + 1) H).labs) ∧
      (2 ≤ q.2 → (q.1, q.2 - 1) ∈ (R.vcCredit π (ρ + 1) H).hs) := by
  classical
  constructor
  · intro u hb
    rw [vcCredit, mem_read'_labs]
    exact Or.inl (Finset.mem_union_right _ (Finset.mem_filter.2
      ⟨Finset.mem_univ _, ⟨q, hh, hr, hpos, hrev, hb⟩⟩))
  · intro hq2
    have hqle := (R.mem_posSet.1 hpos).2
    have hpEq : q.2 - 1 + 1 = q.2 := Nat.sub_add_cancel (by omega)
    have hprev : (q.1, q.2 - 1) ∈ R.posSet := R.mem_posSet.2 ⟨by omega, by
      change q.2 - 1 ≤ ovCalls R.G q.1
      omega⟩
    rw [vcCredit, mem_read'_hs]
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hprev, Or.inr ?_⟩)
    refine ⟨by simpa only [hpEq] using hqle, ?_, ?_, ?_⟩
    · simpa only [hpEq] using hrev
    · simpa only [hpEq] using hh
    · simpa only [hpEq] using hr

/-- **Band completeness of the causal VC.** At every revealed honest pair, whichever side is
already determined causes the other side to enter the next causal prefix. -/
theorem vc_band_complete (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ρ : ℕ) (H : ChainKnow B)
    {q : Fin B × ℕ} (hpos : q ∈ R.posSet) (hrev : R.revealedAt π ρ q) :
    ((R.vcCredit π ρ H).canCall R.G q.1 q.2 →
        q ∈ (R.vcCredit π (ρ + 1) H).hs ∧ q ∈ (R.vcCredit π (ρ + 1) H).rs) ∧
      (q ∈ (R.vcCredit π ρ H).hs → q ∈ (R.vcCredit π ρ H).rs →
        (∀ u, ovBlock R.G q.1 q.2 = some u → u ∈ (R.vcCredit π (ρ + 1) H).labs) ∧
          (2 ≤ q.2 → (q.1, q.2 - 1) ∈ (R.vcCredit π (ρ + 1) H).hs)) :=
  ⟨R.vc_forward_complete π ρ H hpos hrev,
    fun hh hr => R.vc_inverse_complete π ρ H hpos hrev hh hr⟩

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Charge ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.BandChain LazyPerm
open scoped ENNReal


def atomWidth {B : ℕ} (ℓ c : ℕ) : VAtom B → ℕ
  | .r _ => ℓ
  | .h _ => ℓ + c


namespace ChainReplay

open Pous.BandChain.KeyRule Birthday

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

open Classical in
/-- Seed coordinates of a holding, with labels identified with pad `r`s. -/
noncomputable def seedAtoms (H : ChainKnow B) : Finset (VAtom B) :=
  H.rs.image VAtom.r ∪
    H.labs.image (fun v => VAtom.r (v, ovCalls R.G v)) ∪
    (H.hs.filter fun q => q.2 ≠ 0).image VAtom.h

noncomputable def seedWidth (R : ChainReplay B ℓ c) (H : ChainKnow B) : ℕ :=
  ℓ * H.labs.card + (ℓ + c) * (H.hs.filter fun q => q.2 ≠ 0).card + ℓ * H.rs.card

theorem seedWidth_eq_mul_size (R : ChainReplay B ℓ c) (H : ChainKnow B) (hℓ : 1 ≤ ℓ) :
    ((R.seedWidth H : ℕ) : ℚ) = ℓ * H.size c ℓ := by
  have hℓ0 : (ℓ : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hℓ)
  unfold seedWidth ChainKnow.size
  push_cast
  field_simp [hℓ0]
  <;> ring

/-- Number of program queries before round `τ`. -/
def roundStart (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) : ℕ :=
  ((List.range τ).flatMap (R.queryBasisAt π)).length

/-- Program-prefix length at which one coordinate commitment is available. -/
def commitCut (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) (x : VCommit B R.Q) : ℕ :=
  R.roundStart π τ + (R.queryBasisAt π τ).length

/-- A coordinate commitment together with the program-prefix length at which it is available. -/
noncomputable def showRecords (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    List (ℕ × (ℕ × VCommit B R.Q)) :=
  (List.range (R.D + 1)).flatMap fun τ =>
    (R.basisAt π τ).map fun x => (R.commitCut π τ x, (τ, x))

/-- Program schedule length. -/
def programSteps (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ℕ :=
  (roundsSeq (List.finRange B)
    (fun q => bandDec (qEntry (fun _ : Unit => π) bandEnc q))
    R.D (fun i => toRProgI (R.P i))).length

/-- Causal seeds from precisely the shows available in the first `cut` program steps. -/
noncomputable def seedsAtCut (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (cut : ℕ) : ChainKnow B :=
  if R.programSteps π ≤ cut then R.v6SeedsThrough π (R.D + 1)
  else
    ((R.showRecords π).filter fun x => x.1 ≤ cut).foldl
      (fun H x => R.seedBasisStep π x.2.1 H x.2.2) PousSpongeChain.ChainKnow.empty

theorem recordsFold_labs (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ (l : List (ℕ × (ℕ × VCommit B R.Q))) (H : ChainKnow B),
      (l.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2) H).labs = H.labs
  | [], _ => rfl
  | x :: l, H => by
      rw [List.foldl_cons, R.recordsFold_labs π l, R.seedBasisStep_labs]

theorem showRecord_valid {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {x : ℕ × (ℕ × VCommit B R.Q)} (hx : x ∈ R.showRecords π) :
    R.atomValid x.2.2.atom := by
  classical
  unfold showRecords at hx
  obtain ⟨τ, -, hτ⟩ := List.mem_flatMap.1 hx
  obtain ⟨a, ha, rfl⟩ := List.mem_map.1 hτ
  exact R.commit_mem_basis_valid ha

theorem recordsFold_valid (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ (l : List (ℕ × (ℕ × VCommit B R.Q))) (H : ChainKnow B),
      (∀ x ∈ l, R.atomValid x.2.2.atom) → R.PositionsValid H →
      R.PositionsValid (l.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2) H)
  | [], _, _, hH => hH
  | x :: l, H, hall, hH =>
      R.recordsFold_valid π l (R.seedBasisStep π x.2.1 H x.2.2)
        (fun y hy => hall y (List.mem_cons_of_mem x hy))
        (R.seedBasisStep_valid hH (hall x (List.mem_cons_self)))

theorem seedsAtCut_labs_empty (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (cut : ℕ) :
    (R.seedsAtCut π cut).labs = ∅ := by
  classical
  unfold seedsAtCut
  split_ifs
  · exact R.v6SeedsThrough_labs_empty π _
  · exact R.recordsFold_labs π _ PousSpongeChain.ChainKnow.empty

theorem seedsAtCut_valid (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (cut : ℕ) :
    R.PositionsValid (R.seedsAtCut π cut) := by
  classical
  unfold seedsAtCut
  split_ifs
  · exact R.v6SeedsThrough_valid π _
  · apply R.recordsFold_valid
    · intro x hx
      exact R.showRecord_valid (List.mem_of_mem_filter hx)
    · exact ⟨Finset.empty_subset _, Finset.empty_subset _⟩

theorem seedAtoms_width (H : ChainKnow B) (hlab : H.labs = ∅) :
    ∑ a ∈ R.seedAtoms H, atomWidth ℓ c a = R.seedWidth H := by
  classical
  have hdisj : Disjoint (H.rs.image VAtom.r)
      ((H.hs.filter fun q => q.2 ≠ 0).image VAtom.h) := by
    rw [Finset.disjoint_left]
    intro a ha hb
    obtain ⟨q, -, rfl⟩ := Finset.mem_image.1 ha
    obtain ⟨q', -, h⟩ := Finset.mem_image.1 hb
    cases h
  unfold seedAtoms seedWidth
  rw [hlab, Finset.image_empty, Finset.union_empty, Finset.sum_union hdisj]
  rw [Finset.sum_image fun x _ y _ h => VAtom.r.inj h]
  rw [Finset.sum_image fun x _ y _ h => VAtom.h.inj h]
  simp only [atomWidth, Finset.sum_const, nsmul_eq_mul]
  simp [Nat.mul_comm, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]


theorem mem_seedAtoms_valid {H : ChainKnow B} (hpos : R.PositionsValid H)
    (hlab : H.labs = ∅) {a : VAtom B} (ha : a ∈ R.seedAtoms H) : R.atomValid a := by
  classical
  unfold seedAtoms at ha
  rw [hlab, Finset.image_empty, Finset.union_empty] at ha
  rcases Finset.mem_union.1 ha with ha | ha
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.1 ha
    exact hpos.2 hq
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.1 ha
    exact hpos.1 (Finset.mem_filter.1 hq).1

def crosses (R : ChainReplay B ℓ c)
    (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (cut : ℕ) : Prop :=
  ℓ * s < R.seedWidth (R.seedsAtCut π cut)

theorem full_crosses_of_size_gt (hℓ : 1 ≤ ℓ) (s : ℕ)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hsize : (s : ℚ) < (R.v6SeedsThrough π (R.D + 1)).size c ℓ) :
    R.crosses s π (R.programSteps π) := by
  have hℓq : (0 : ℚ) < ℓ := by exact_mod_cast hℓ
  have hm := mul_lt_mul_of_pos_left hsize hℓq
  rw [← R.seedWidth_eq_mul_size _ hℓ] at hm
  unfold crosses seedsAtCut
  simp only [le_refl, ↓reduceIte]
  exact_mod_cast hm


open Classical in
/-- The first realized crossing, defaulting to the full program prefix when there is none. -/
noncomputable def firstCrossing (R : ChainReplay B ℓ c)
    (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ℕ :=
  if h : ∃ cut ≤ R.programSteps π, R.crosses s π cut then Nat.find h else R.programSteps π

theorem firstCrossing_le (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (h : ∃ cut ≤ R.programSteps π, R.crosses s π cut) :
    R.firstCrossing s π ≤ R.programSteps π := by
  classical
  rw [firstCrossing, dif_pos h]
  exact (Nat.find_spec h).1

theorem firstCrossing_crosses (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (h : ∃ cut ≤ R.programSteps π, R.crosses s π cut) :
    R.crosses s π (R.firstCrossing s π) := by
  classical
  rw [firstCrossing, dif_pos h]
  exact (Nat.find_spec h).2

theorem before_firstCrossing (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (h : ∃ cut ≤ R.programSteps π, R.crosses s π cut) {cut : ℕ}
    (hlt : cut < R.firstCrossing s π) : ¬ R.crosses s π cut := by
  classical
  rw [firstCrossing, dif_pos h] at hlt
  intro hcross
  exact Nat.find_min h hlt ⟨by
    have hle := R.firstCrossing_le s π h
    rw [firstCrossing, dif_pos h] at hle
    omega, hcross⟩

/-- The complete realized seed pattern at its first crossing cut. -/
noncomputable def realizedSeeds (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : Finset (VAtom B) :=
  R.seedAtoms (R.seedsAtCut π (R.firstCrossing s π))

theorem realizedSeeds_width (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∑ a ∈ R.realizedSeeds s π, atomWidth ℓ c a =
      R.seedWidth (R.seedsAtCut π (R.firstCrossing s π)) :=
  R.seedAtoms_width _ (R.seedsAtCut_labs_empty π _)

theorem realizedSeeds_width_gt (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (h : ∃ cut ≤ R.programSteps π, R.crosses s π cut) :
    ℓ * s < ∑ a ∈ R.realizedSeeds s π, atomWidth ℓ c a := by
  rw [R.realizedSeeds_width]
  exact R.firstCrossing_crosses s π h


/-- The answer already recorded for a band query. -/
def histBandAns (h : History (BandAlpha ℓ c))
    (q : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) : Option (Bits (ℓ + (ℓ + c))) :=
  h.findSome? fun e => if e.1 = bandEnc q then some (bandDec e) else none

/-- Answers reconstructed from a partial history, with the all-zero default used only past the
first missing labeller query. -/
def bandAnsOf (R : ChainReplay B ℓ c) (h : History (BandAlpha ℓ c)) :
    Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c)) :=
  fun q => (histBandAns h q).getD (fun _ => false)


/-- Replay the honest labeller and ask its first query absent from the history. -/
def labTail (R : ChainReplay B ℓ c) (h : History (BandAlpha ℓ c)) : Option (Qry (BandAlpha ℓ c)) :=
  let qs : List (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) :=
    ((R.labR 0 (fun _ _ => false)).trace (R.bandAnsOf h)).map Prod.snd
  (qs.find? fun q => (histBandAns h q).isNone).map bandEnc

theorem histBandAns_none_iff (h : History (BandAlpha ℓ c))
    (q : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) :
    histBandAns h q = none ↔ ∀ e ∈ h, e.1 ≠ bandEnc q := by
  unfold histBandAns
  rw [List.findSome?_eq_none_iff]
  refine forall₂_congr fun e _ => ?_
  constructor
  · intro he hq
    simp [hq] at he
  · intro hq
    simp [hq]

theorem histBandAns_some_eq {π : Oracle (BandAlpha ℓ c)} (h : History (BandAlpha ℓ c))
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) {q} {a : Bits (ℓ + (ℓ + c))}
    (ha : histBandAns h q = some a) : a = bandAnswer (π ()) q := by
  unfold histBandAns at ha
  obtain ⟨e, he, hfe⟩ := List.exists_of_findSome?_eq_some ha
  split at hfe
  · rename_i hq
    obtain ⟨q', b⟩ := e
    subst hq
    simp only [Option.some.injEq] at hfe
    rw [← hfe]
    have hc := hcons _ he
    cases q <;> simpa [bandEnc, bandDec, ans, bandAnswer] using hc
  · exact absurd hfe (by simp)

theorem bandAnsOf_eq {π : Oracle (BandAlpha ℓ c)} (h : History (BandAlpha ℓ c))
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) {q}
    (hq : (histBandAns h q).isNone = false) :
    R.bandAnsOf h q = bandAnswer (π ()) q := by
  cases ha : histBandAns h q with
  | none => rw [ha] at hq; simp at hq
  | some a =>
      unfold bandAnsOf
      rw [ha, Option.getD_some, histBandAns_some_eq h hcons ha]

namespace BandTr


/-
theorem mem_trace_round {X : Type} (f : Bits n ⊕ Bits n → Bits n)
    (qs : List (Bits n ⊕ Bits n)) (k : List (Bits n) → OracleProg (idealPerm n) X)
    (x : Bits n ⊕ Bits n) (hx : x ∈ qs) : (0, x) ∈ trace f (.round qs k) := by
  simp only [trace, List.mem_append, List.mem_map]
  exact Or.inl ⟨x, hx, rfl⟩

theorem mem_trace_round_succ {X : Type} (f : Bits n ⊕ Bits n → Bits n)
    (qs : List (Bits n ⊕ Bits n)) (k : List (Bits n) → OracleProg (idealPerm n) X)
    (e : ℕ × (Bits n ⊕ Bits n)) (he : e ∈ trace f (k (qs.map f))) :
    (e.1 + 1, e.2) ∈ trace f (.round qs k) := by
  simp only [trace, List.mem_append, List.mem_map]
  exact Or.inr ⟨e, he, rfl⟩

theorem agree_round {X : Type} {f g : Bits n ⊕ Bits n → Bits n}
    {qs : List (Bits n ⊕ Bits n)} {k : List (Bits n) → OracleProg (idealPerm n) X} {r : ℕ}
    (h : AgreeBefore f g (.round qs k) (r + 1)) :
    qs.map f = qs.map g ∧ AgreeBefore f g (k (qs.map f)) r :=
  ⟨List.map_congr_left fun x hx => h (0, x) (mem_trace_round f qs k x hx) (Nat.succ_pos r),
    fun e he hlt => h (e.1 + 1, e.2) (mem_trace_round_succ f qs k e he) (by omega)⟩

theorem trace_stable {X : Type} (f g : Bits n ⊕ Bits n → Bits n)
    (P : OracleProg (idealPerm n) X) : ∀ r, AgreeBefore f g P r →
    (∀ m e, (trace f P)[m]? = some e → e.1 ≤ r → (trace g P)[m]? = some e) ∧
    (∀ e ∈ trace g P, e.1 ≤ r → e ∈ trace f P) := by
  induction P with
  | ret _ => intro r _; simp [trace]
  | round qs k ih =>
      intro r hag
      cases r with
      | zero =>
          constructor
          · intro m e hm he
            simp only [trace] at hm ⊢
            by_cases hlt : m < qs.length
            · rw [List.getElem?_append_left (by simpa using hlt)] at hm ⊢
              exact hm
            · rw [List.getElem?_append_right (by simpa using not_lt.1 hlt),
                List.getElem?_map, List.length_map] at hm
              cases hk : (trace f (k (qs.map f)))[m - qs.length]? with
              | none => rw [hk] at hm; simp at hm
              | some e' =>
                  simp only [hk, Option.map_some, Option.some.injEq] at hm
                  subst hm
                  simp at he
          · intro e he he0
            simp only [trace, List.mem_append, List.mem_map] at he ⊢
            rcases he with ⟨x, hx, rfl⟩ | ⟨e', _, rfl⟩
            · exact Or.inl ⟨x, hx, rfl⟩
            · simp at he0
      | succ r =>
          obtain ⟨hqs, hag'⟩ := agree_round hag
          obtain ⟨ih1, ih2⟩ := ih (qs.map f) r hag'
          constructor
          · intro m e hm he
            simp only [trace] at hm ⊢
            rw [← hqs]
            by_cases hlt : m < qs.length
            · rw [List.getElem?_append_left (by simpa using hlt)] at hm ⊢
              exact hm
            · rw [List.getElem?_append_right (by simpa using not_lt.1 hlt),
                List.getElem?_map, List.length_map] at hm ⊢
              cases hk : (trace f (k (qs.map f)))[m - qs.length]? with
              | none => rw [hk] at hm; simp at hm
              | some e' =>
                  simp only [hk, Option.map_some, Option.some.injEq] at hm
                  subst hm
                  rw [ih1 _ e' hk (by simp only at he; omega)]
                  rfl
          · intro e he her
            simp only [trace, List.mem_append, List.mem_map] at he ⊢
            rw [← hqs] at he
            rcases he with ⟨x, hx, rfl⟩ | ⟨e', he', rfl⟩
            · exact Or.inl ⟨x, hx, rfl⟩
            · exact Or.inr ⟨e', ih2 e' he' (by simp only at her; omega), rfl⟩
-/


end BandTr

theorem rtrace_pairwise {Q A X : Type} (f : Q → A) (P : RProg Q A X) :
    P.trace f |>.Pairwise (fun a b => a.1 ≤ b.1) := by
  induction P with
  | ret _ => simp [RProg.trace]
  | round qs k ih =>
      simp only [RProg.trace]
      refine List.pairwise_append.2 ⟨?_, ?_, ?_⟩
      · rw [List.pairwise_map]
        exact List.pairwise_of_forall fun _ _ => le_rfl
      · rw [List.pairwise_map]
        exact (ih (qs.map f)).imp fun h => Nat.succ_le_succ h
      · intro a ha b _
        obtain ⟨x, _, rfl⟩ := List.mem_map.1 ha
        exact Nat.zero_le _


/-
theorem bandChainProg_trace (f : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) →
    Bits (ℓ + (ℓ + c))) (k : Bits ℓ × Bits (ℓ + c) → OracleProg (idealPerm (ℓ + (ℓ + c))) Unit) :
    ∀ (blks : List (Bits ℓ)) (p : Bits ℓ × Bits (ℓ + c)),
      (BandTr.trace f (bandChainProg p blks k)).map Prod.snd =
        (ovInputs (fun x => f (.inl x)) p blks).map Sum.inl ++
          (BandTr.trace f (k (blks.foldl (ovStep (fun x => f (.inl x))) p))).map Prod.snd := by
  intro blks
  induction blks with
  | nil =>
      intro p
      simp [bandChainProg, ovInputs]
  | cons blk blks ih =>
      intro p
      simp only [bandChainProg, BandTr.trace, toRProgI, RProg.trace, List.map_append,
        List.map_map, Function.comp_apply, List.map_cons, List.map_nil, List.singleton_append,
        List.headD_cons, ovInputs, List.foldl_cons]
      rw [ih]
      rfl

theorem labProg_trace (f : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) →
    Bits (ℓ + (ℓ + c))) :
    ∀ (k : ℕ) (acc : Fin B → Bits ℓ),
      (BandTr.trace f (R.labProg k acc)).map Prod.snd =
        (R.honestFrom (fun x => f (.inl x)) k acc).map Sum.inl := by
  intro k
  induction hn : B - k using Nat.strong_induction_on generalizing k with
  | _ n ih =>
      intro acc
      rw [labProg, honestFrom]
      by_cases hk : k < B
      · simp only [hk, ↓reduceDIte]
        rw [bandChainProg_trace]
        rw [ih (B - (k + 1)) (by omega) (k + 1) rfl]
        rw [List.map_append]
      · simp only [hk, ↓reduceDIte, BandTr.trace, toRProgI, RProg.trace, List.map_nil]

theorem labProg_trace_true (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (BandTr.trace (bandAnswer π) (R.labProg 0 (fun _ _ => false))).map Prod.snd =
      (R.honestSeq π).map Sum.inl := by
  rw [R.labProg_trace (bandAnswer π) 0, show (fun x => bandAnswer π (.inl x)) = fun x => π x from rfl,
    R.honestFrom_zero]

theorem labProg_work (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (R.labProg 0 (fun _ _ => false)).work (bandAnswer π) = R.posSet.card := by
  rw [← BandTr.length_trace (bandAnswer π), ← List.length_map (f := Prod.snd),
    R.labProg_trace_true π, List.length_map, R.honestSeq_length]

theorem xin_mem_labProg_trace (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ}
    (hq : q ∈ R.posSet) :
    .inl (R.xin π q.1 q.2) ∈
      (BandTr.trace (bandAnswer π) (R.labProg 0 (fun _ _ => false))).map Prod.snd := by
  rw [R.labProg_trace_true π]
  exact List.mem_map_of_mem (R.xin_mem_honestSeq π hq)
-/

/-- Query list of the RProg overwrite chain with continuation. -/
theorem chainR_trace_v6 {X : Type}
    (f : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) →
    Bits (ℓ + (ℓ + c)))
    (k : Bits ℓ × Bits (ℓ + c) →
      RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) (Bits (ℓ + (ℓ + c))) X) :
    ∀ (blks : List (Bits ℓ)) (p : Bits ℓ × Bits (ℓ + c)),
      ((chainR p blks k).trace f).map Prod.snd =
        (ovInputs (fun x => f (.inl x)) p blks).map Sum.inl ++
          ((k (blks.foldl (ovStep (fun x => f (.inl x))) p)).trace f).map Prod.snd := by
  intro blks
  induction blks with
  | nil =>
      intro p
      simp [chainR, ovInputs]
  | cons blk blks ih =>
      intro p
      simp only [chainR, RProg.trace, List.map_append, List.map_map, Function.comp_apply,
        List.map_cons, List.map_nil, List.singleton_append, List.headD_cons, ovInputs, List.foldl_cons]
      change Sum.inl (Fin.append blk p.2) ::
          ((chainR (ovStep (fun x => f (.inl x)) p blk) blks k).trace f).map Prod.snd =
        Sum.inl (Fin.append blk p.2) ::
          (ovInputs (fun x => f (.inl x)) (ovStep (fun x => f (.inl x)) p blk) blks).map Sum.inl ++
            ((k (blks.foldl (ovStep (fun x => f (.inl x)))
              (ovStep (fun x => f (.inl x)) p blk))).trace f).map Prod.snd
      rw [ih]
      rfl

theorem labR_trace_v6 (f : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) →
    Bits (ℓ + (ℓ + c))) :
    ∀ (k : ℕ) (acc : Fin B → Bits ℓ),
      ((R.labR k acc).trace f).map Prod.snd =
        (R.honestFrom (fun x => f (.inl x)) k acc).map Sum.inl := by
  intro k
  induction hn : B - k using Nat.strong_induction_on generalizing k with
  | _ n ih =>
      intro acc
      rw [labR, honestFrom]
      by_cases hk : k < B
      · simp only [hk, ↓reduceDIte]
        calc
          _ = (ovInputs (fun x => f (.inl x)) (fun _ => false, iv (R.dom k))
                (absorbedG R.G acc ⟨k, hk⟩)).map Sum.inl ++
              ((R.labR (k + 1) (Function.update acc ⟨k, hk⟩
                (bxor ((absorbedG R.G acc ⟨k, hk⟩).foldl
                  (ovStep (fun x => f (.inl x))) (fun _ => false, iv (R.dom k))).1
                  (R.Wb ⟨k, hk⟩)))).trace f).map Prod.snd :=
            by
              simpa using
                (chainR_trace_v6 f
                  (fun p => R.labR (k + 1)
                    (Function.update acc ⟨k, hk⟩ (bxor p.1 (R.Wb ⟨k, hk⟩))))
                  (absorbedG R.G acc ⟨k, hk⟩)
                  ((fun _ => false), iv (R.dom k)))
          _ = _ := by
            rw [ih (B - (k + 1)) (by omega) (k + 1) rfl, List.map_append]
      · simp only [hk, ↓reduceDIte, RProg.trace, List.map_nil]

theorem labR_trace_true (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ((R.labR 0 (fun _ _ => false)).trace (bandAnswer π)).map Prod.snd =
      (R.honestSeq π).map Sum.inl := by
  rw [R.labR_trace_v6 (bandAnswer π) 0, show (fun x => bandAnswer π (.inl x)) = fun x => π x from rfl,
    R.honestFrom_zero]

theorem labR_trace_length (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ((R.labR 0 (fun _ _ => false)).trace (bandAnswer π)).length = R.posSet.card := by
  rw [← List.length_map (f := Prod.snd), R.labR_trace_true π, List.length_map, R.honestSeq_length]

theorem xin_mem_labR_trace (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ}
    (hq : q ∈ R.posSet) :
    .inl (R.xin π q.1 q.2) ∈
      ((R.labR 0 (fun _ _ => false)).trace (bandAnswer π)).map Prod.snd := by
  rw [R.labR_trace_true π]
  exact List.mem_map_of_mem (R.xin_mem_honestSeq π hq)

/-- A tail step is a new query from the true honest-labeller trace. -/
theorem labTail_some {π : Oracle (BandAlpha ℓ c)} (h : History (BandAlpha ℓ c))
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) {x : Qry (BandAlpha ℓ c)}
    (hx : R.labTail h = some x) :
    ∃ q, x = bandEnc q ∧
      q ∈ ((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).map Prod.snd ∧
      histBandAns h q = none := by
  unfold labTail at hx
  obtain ⟨q, hfind, rfl⟩ := Option.map_eq_some_iff.1 hx
  obtain ⟨hpq, as, bs, hl, hbefore⟩ := List.find?_eq_some_iff_append.1 hfind
  refine ⟨q, rfl, ?_, Option.isNone_iff_eq_none.1 hpq⟩
  obtain ⟨l1, l2, htr, hl1, hl2⟩ := List.map_eq_append_iff.1 hl
  obtain ⟨e, l3, rfl, he, -⟩ := List.map_eq_cons_iff.1 hl2
  have hsorted := rtrace_pairwise (R.bandAnsOf h) (R.labR 0 (fun _ _ => false))
  rw [htr] at hsorted
  have hagree : ∀ e' ∈ (R.labR 0 (fun _ _ => false)).trace (R.bandAnsOf h),
      e'.1 < e.1 → R.bandAnsOf h e'.2 = bandAnswer (π ()) e'.2 := by
    intro e' he' hlt
    rw [htr] at he'
    rcases List.mem_append.1 he' with h1 | h1
    · have hmem : e'.2 ∈ as := hl1 ▸ List.mem_map_of_mem h1
      have hn := hbefore _ hmem
      simp only [Bool.not_eq_true'] at hn
      exact R.bandAnsOf_eq h hcons hn
    · rcases List.mem_cons.1 h1 with h2 | h2
      · subst h2; exact absurd hlt (lt_irrefl _)
      · have hs := (List.pairwise_append.1 hsorted).2.1
        exact absurd ((List.pairwise_cons.1 hs).1 e' h2) (not_le.2 hlt)
  have hidx : ((R.labR 0 (fun _ _ => false)).trace (R.bandAnsOf h))[l1.length]? =
      some e := by
    rw [htr, List.getElem?_append_right le_rfl, Nat.sub_self]
    rfl
  have hs : e ∈ ((R.labR 0 (fun _ _ => false)).trace (R.bandAnsOf h)).filter
      (fun z => z.1 ≤ e.1) :=
    List.mem_filter.2 ⟨List.mem_of_getElem? hidx, by simp⟩
  rw [LazyPerm.RProg.trace_le_congr (R.bandAnsOf h) (bandAnswer (π ()))
    (R.labR 0 (fun _ _ => false)) e.1 hagree] at hs
  rw [← he]
  exact List.mem_map_of_mem (List.mem_filter.1 hs).1

/-- All adversary threads, followed by the honest labeller tail. -/
def advThenLab : Strategy (BandAlpha ℓ c) :=
  Strategy.ofRounds (List.finRange B) R.D (fun i => toRProgI (R.P i)) bandEnc bandDec R.labTail

/-- Strategy truncated after `cut` program steps, then switched to the honest labeller. -/
def stratC (cut : ℕ) : Strategy (BandAlpha ℓ c) where
  next h := if h.length < cut then R.advThenLab.next h else R.labTail h

/-- The adversary schedule against a lazy oracle. -/
noncomputable def advSched (π : Oracle (BandAlpha ℓ c)) :
    List (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) :=
  roundsSeq (List.finRange B) (fun q => bandDec (qEntry π bandEnc q))
    R.D (fun i => toRProgI (R.P i))

theorem programSteps_eq_advSched (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    R.programSteps π = (R.advSched (fun _ : Unit => π)).length := rfl

theorem advSched_eq_advSeq (π : Oracle (BandAlpha ℓ c)) :
    R.advSched π = R.advSeq (π ()) := by
  unfold advSched advSeq
  have hans : (fun q => bandDec (qEntry π bandEnc q)) = bandAnswer (π ()) := by
    funext q
    cases q <;> rfl
  rw [hans, roundsSeq_eq (List.nodup_finRange B)]

theorem programSteps_add_pos_le (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    R.programSteps π + R.posSet.card ≤ nPos B R.Q := by
  rw [R.programSteps_eq_advSched π, R.advSched_eq_advSeq]
  have hlen := R.bandSeq_length hP (fun _ : Unit => π)
  rw [R.honestSeq_length π] at hlen
  have hsteps := R.steps_le_nPos hP π
  omega

theorem stratC_hist_le {cut : ℕ} {π : Oracle (BandAlpha ℓ c)}
    (hcut : cut ≤ (R.advSched π).length) :
    ∀ j ≤ cut, (R.stratC cut).hist π j = R.advThenLab.hist π j := by
  intro j
  induction j with
  | zero => intro _; rfl
  | succ j ih =>
      intro hj
      have ihj := ih (by omega)
      have hnext : (R.stratC cut).next ((R.stratC cut).hist π j) =
          R.advThenLab.next (R.advThenLab.hist π j) := by
        rw [ihj]
        have hlen : (R.advThenLab.hist π j).length = j := by
          unfold advThenLab
          rw [Strategy.ofRounds_hist _ _ _ _ _ _ π j (le_trans (by omega) hcut),
            List.length_map, List.length_take]
          exact min_eq_left (le_trans (by omega) hcut)
        show (if _ < cut then _ else _) = _
        simp only [hlen, show j < cut by omega, ↓reduceIte]
      cases hq : R.advThenLab.next (R.advThenLab.hist π j) with
      | none =>
          rw [Strategy.hist_succ_of_none _ (hnext.trans hq),
            Strategy.hist_succ_of_none _ hq, ihj]
      | some q =>
          rw [Strategy.hist_succ_of_some _ (hnext.trans hq),
            Strategy.hist_succ_of_some _ hq, ihj]

theorem stratC_hist_cut {cut : ℕ} {π : Oracle (BandAlpha ℓ c)}
    (hcut : cut ≤ (R.advSched π).length) :
    (R.stratC cut).hist π cut =
      ((R.advSched π).take cut).map (qEntry π bandEnc) := by
  rw [R.stratC_hist_le hcut cut le_rfl]
  unfold advThenLab
  exact Strategy.ofRounds_hist _ _ _ _ _ _ π cut hcut

theorem stratC_next_tail {cut : ℕ} {h : History (BandAlpha ℓ c)}
    (hh : cut ≤ h.length) : (R.stratC cut).next h = R.labTail h := by
  show (if _ < cut then _ else _) = _
  simp only [show ¬ h.length < cut by omega, ↓reduceIte]

/-- After the cut, the history is the fixed adversary prefix and distinct honest-labeller
queries from the true trace. -/
theorem stratC_inv {cut : ℕ} {π : Oracle (BandAlpha ℓ c)}
    (hcut : cut ≤ (R.advSched π).length) :
    ∀ j, cut ≤ j → ∃ tq : List (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))),
      tq.Nodup ∧
      (∀ q ∈ tq, q ∈
        ((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).map Prod.snd) ∧
      (R.stratC cut).hist π j =
        ((R.advSched π).take cut ++ tq).map (qEntry π bandEnc) := by
  intro j hj
  induction j, hj using Nat.le_induction with
  | base =>
      exact ⟨[], List.nodup_nil, fun q hq => absurd hq (List.not_mem_nil),
        by rw [List.append_nil]; exact R.stratC_hist_cut hcut⟩
  | succ j hcj ih =>
      obtain ⟨tq, hnd, hsub, hh⟩ := ih
      set S := R.stratC cut
      cases hnext : S.next (S.hist π j) with
      | none => exact ⟨tq, hnd, hsub, by rw [S.hist_succ_of_none hnext, hh]⟩
      | some x =>
          have hlen : cut ≤ (S.hist π j).length := by
            rw [hh, List.length_map, List.length_append, List.length_take]
            omega
          have htail := R.stratC_next_tail hlen
          rw [htail] at hnext
          obtain ⟨q, rfl, hqT, hnew⟩ :=
            R.labTail_some (S.hist π j) (fun e he => S.mem_hist he) hnext
          have hqtq : q ∉ tq := by
            intro hq
            have hmem : qEntry π bandEnc q ∈ S.hist π j := by
              rw [hh, List.map_append]
              exact List.mem_append_right _ (List.mem_map_of_mem hq)
            exact (histBandAns_none_iff _ _).1 hnew _ hmem rfl
          refine ⟨tq ++ [q], hnd.append (List.nodup_singleton q)
            (List.disjoint_singleton.2 hqtq), fun q' hq' => ?_, ?_⟩
          · rcases List.mem_append.1 hq' with h1 | h1
            · exact hsub q' h1
            · rw [List.mem_singleton.1 h1]; exact hqT
          · rw [S.hist_succ_of_some (by rw [← htail] at hnext; exact hnext), hh]
            simp only [List.map_append, List.map_cons, List.map_nil, List.append_assoc]
            rfl

theorem stratC_length_le {cut : ℕ} {π : Oracle (BandAlpha ℓ c)}
    (hcut : cut ≤ (R.advSched π).length) (j : ℕ) :
    ((R.stratC cut).hist π j).length ≤
      cut + ((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).length := by
  classical
  rcases Nat.lt_or_ge j cut with hj | hj
  · exact ((R.stratC cut).hist_length_le π j).trans (by omega)
  obtain ⟨tq, hnd, hsub, hh⟩ := R.stratC_inv hcut j hj
  rw [hh, List.length_map, List.length_append, List.length_take]
  have hle : tq.length ≤
      (((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).map Prod.snd).length := by
    rw [← List.toFinset_card_of_nodup hnd]
    exact (Finset.card_le_card fun q hq =>
      List.mem_toFinset.2 (hsub q (List.mem_toFinset.1 hq))).trans (List.toFinset_card_le _)
  rw [List.length_map] at hle
  omega

theorem stratC_stop {cut : ℕ} {π : Oracle (BandAlpha ℓ c)}
    (hcut : cut ≤ (R.advSched π).length) :
    (R.stratC cut).next ((R.stratC cut).hist π
      (cut + ((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).length)) = none := by
  set S := R.stratC cut
  set L := cut + ((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).length
  cases hn : S.next (S.hist π L) with
  | none => rfl
  | some q =>
      have hlen := S.length_hist_of_next hn
      have hb := R.stratC_length_le hcut (L + 1)
      rw [S.hist_succ_of_some hn, List.length_append, List.length_singleton, hlen] at hb
      omega

/-- By the end of the truncated run, the history contains every query of the true
honest-labeller trace. -/
theorem stratC_complete {cut : ℕ} {π : Oracle (BandAlpha ℓ c)}
    (hcut : cut ≤ (R.advSched π).length) :
    ∀ q ∈ ((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).map Prod.snd,
      ∃ e ∈ (R.stratC cut).hist π
        (cut + ((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).length),
        e.1 = bandEnc q := by
  set S := R.stratC cut
  set L := cut + ((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).length
  set h := S.hist π L
  have hlen : cut ≤ h.length := by
    obtain ⟨tq, _, _, hh⟩ := R.stratC_inv hcut L (by omega)
    change h = _ at hh
    rw [hh, List.length_map, List.length_append, List.length_take]
    omega
  have hstop := R.stratC_stop hcut
  rw [R.stratC_next_tail hlen] at hstop
  unfold labTail at hstop
  rw [Option.map_eq_none_iff, List.find?_eq_none] at hstop
  have hcons : ∀ e ∈ h, e.2 = ans π e.1 := fun e he => S.mem_hist he
  have hin : ∀ q ∈ ((R.labR 0 (fun _ _ => false)).trace (R.bandAnsOf h)).map Prod.snd,
      (histBandAns h q).isNone = false := by
    intro q hq
    exact Bool.eq_false_iff.2 (hstop q hq)
  have hagree : ∀ e ∈ (R.labR 0 (fun _ _ => false)).trace (R.bandAnsOf h),
      e.1 < (((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).map Prod.fst).sum →
      R.bandAnsOf h e.2 = bandAnswer (π ()) e.2 :=
    fun e he _ => R.bandAnsOf_eq h hcons (hin e.2 (List.mem_map_of_mem he))
  intro q hq
  obtain ⟨e, he, rfl⟩ := List.mem_map.1 hq
  let r := (((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).map Prod.fst).sum
  have he' : e ∈ ((R.labR 0 (fun _ _ => false)).trace (bandAnswer (π ()))).filter (fun z => z.1 ≤ r) :=
    List.mem_filter.2 ⟨he, by
      simp only [decide_eq_true_eq]
      exact List.le_sum_of_mem (List.mem_map_of_mem he)⟩
  have heq := LazyPerm.RProg.trace_le_congr (R.bandAnsOf h) (bandAnswer (π ()))
    (R.labR 0 (fun _ _ => false)) r hagree
  rw [← heq] at he'
  have he'' := (List.mem_filter.1 he').1
  have hne := hin e.2 (List.mem_map_of_mem he'')
  cases hh : histBandAns h e.2 with
  | none => rw [hh] at hne; simp at hne
  | some a =>
      by_contra hall
      push Not at hall
      rw [(histBandAns_none_iff h _).2 hall] at hh
      exact absurd hh (by simp)


inductive DAtom (B : ℕ) where
  | lab : Fin B → DAtom B
  | r : Fin B × ℕ → DAtom B
  | h : Fin B × ℕ → DAtom B
deriving DecidableEq

def DAtom.ofVAtom : VAtom B → DAtom B
  | .r q => .r q
  | .h q => .h q


/-- Least semantic value closure of a history and seed table. -/
inductive VCTarget (R : ChainReplay B ℓ c) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hist : History (BandAlpha ℓ c)) (H : ChainKnow B) : DAtom B → Prop
  | heldLab {v} : v ∈ H.labs → VCTarget R π hist H (.lab v)
  | heldR {q} : q ∈ H.rs → VCTarget R π hist H (.r q)
  | heldH {q} : q ∈ H.hs → VCTarget R π hist H (.h q)
  | padLabel {v} : VCTarget R π hist H (.r (v, ovCalls R.G v)) →
      VCTarget R π hist H (.lab v)
  | padR {v} : VCTarget R π hist H (.lab v) →
      VCTarget R π hist H (.r (v, ovCalls R.G v))
  | forwardRFirst {q} : q ∈ R.posSet → q.2 = 1 → R.xin π q.1 q.2 ∈ hist.dom () →
      (∀ u, ovBlock R.G q.1 q.2 = some u → VCTarget R π hist H (.lab u)) →
      VCTarget R π hist H (.r q)
  | forwardRPrev {q} : q ∈ R.posSet → 2 ≤ q.2 → R.xin π q.1 q.2 ∈ hist.dom () →
      (∀ u, ovBlock R.G q.1 q.2 = some u → VCTarget R π hist H (.lab u)) →
      VCTarget R π hist H (.h (q.1, q.2 - 1)) →
      VCTarget R π hist H (.r q)
  | forwardHFirst {q} : q ∈ R.posSet → q.2 = 1 → R.xin π q.1 q.2 ∈ hist.dom () →
      (∀ u, ovBlock R.G q.1 q.2 = some u → VCTarget R π hist H (.lab u)) →
      VCTarget R π hist H (.h q)
  | forwardHPrev {q} : q ∈ R.posSet → 2 ≤ q.2 → R.xin π q.1 q.2 ∈ hist.dom () →
      (∀ u, ovBlock R.G q.1 q.2 = some u → VCTarget R π hist H (.lab u)) →
      VCTarget R π hist H (.h (q.1, q.2 - 1)) →
      VCTarget R π hist H (.h q)
  | inverseLab {q u} : q ∈ R.posSet → R.xin π q.1 q.2 ∈ hist.dom () →
      VCTarget R π hist H (.r q) → VCTarget R π hist H (.h q) →
      ovBlock R.G q.1 q.2 = some u → VCTarget R π hist H (.lab u)
  | inverseH {q} : q ∈ R.posSet → 2 ≤ q.2 → R.xin π q.1 q.2 ∈ hist.dom () →
      VCTarget R π hist H (.r q) → VCTarget R π hist H (.h q) →
      VCTarget R π hist H (.h (q.1, q.2 - 1))

def targetKnown (R : ChainReplay B ℓ c)
    (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (j : ℕ)
    (H : ChainKnow B) (a : VAtom B) : Prop :=
  R.VCTarget π ((R.stratC cut).hist (fun _ => π) j) H (DAtom.ofVAtom a)


/-- Every producer lies in the truncated program plus honest-labeller budget. -/
def chargeBound (cut : ℕ) : ℕ := cut + R.posSet.card

/-- A seed atom names an honest chain position. -/
def AtomValid : VAtom B → Prop
  | .r q => q ∈ R.posSet
  | .h q => q ∈ R.posSet

/-- At the end of the truncated run, every honest point is fixed in the history. -/
theorem honest_fixed_C {cut : ℕ} (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcut : cut ≤ R.programSteps π) {q : Fin B × ℕ} (hq : q ∈ R.posSet) :
    R.xin π q.1 q.2 ∈
      ((R.stratC cut).hist (fun _ : Unit => π) (R.chargeBound cut)).dom () := by
  have hsched : cut ≤ (R.advSched (fun _ : Unit => π)).length := by
    rwa [← R.programSteps_eq_advSched π]
  have hc := R.stratC_complete hsched (.inl (R.xin π q.1 q.2))
    (R.xin_mem_labR_trace π hq)
  rw [R.labR_trace_length π] at hc
  obtain ⟨e, he, heq⟩ := hc
  refine History.mem_dom.2 ⟨e, ?_, ?_⟩
  · simpa [chargeBound] using he
  · obtain ⟨qe, a⟩ := e
    change qe = bandEnc (.inl (R.xin π q.1 q.2)) at heq
    subst qe
    rfl


theorem realized_atom_valid (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    {a : VAtom B} (ha : a ∈ R.realizedSeeds s π) : R.AtomValid a := by
  exact R.mem_seedAtoms_valid (R.seedsAtCut_valid π _) (R.seedsAtCut_labs_empty π _) ha


end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Pin ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm

inductive V6Part where
  | r
  | h
deriving DecidableEq

instance instFintypeV6Part : Fintype V6Part where
  elems := {.r, .h}
  complete := by intro x; cases x <;> simp

namespace VAtom

def pair : VAtom B → Fin B × ℕ
  | .r q => q
  | .h q => q

def part : VAtom B → V6Part
  | .r _ => .r
  | .h _ => .h

theorem eq_of_pair_part {a b : VAtom B} (hp : a.pair = b.pair)
    (hc : a.part = b.part) : a = b := by
  rcases a with ⟨q⟩ | ⟨q⟩ <;> rcases b with ⟨q'⟩ | ⟨q'⟩
  · simp only [pair] at hp; subst q'; rfl
  · simp [part] at hc
  · simp [part] at hc
  · simp only [pair] at hp; subst q'; rfl

end VAtom

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- The positional input-side partner of an output atom. -/
def pinPartner : VAtom B → Option (VAtom B)
  | .r q =>
      if q ∈ R.posSet then
        match ovBlock R.G q.1 q.2 with
        | some u => some (.r (u, ovCalls R.G u))
        | none => none
      else none
  | .h q =>
      if q ∈ R.posSet ∧ 2 ≤ q.2 then some (.h (q.1, q.2 - 1)) else none

theorem pinPartner_rank_lt {a b : VAtom B} (h : R.pinPartner a = some b) :
    Birthday.posKey b.pair < Birthday.posKey a.pair := by
  rcases a with ⟨q⟩ | ⟨q⟩
  · simp only [pinPartner] at h
    split at h
    · rename_i hq
      have hq1 := (R.mem_posSet.1 hq).1
      split at h
      · rename_i u hb
        obtain rfl := Option.some.inj h
        have humem : u ∈ parentsDesc R.G q.1 := List.mem_iff_getElem?.2 ⟨q.2 - 1, hb⟩
        have huv := parentsDesc_lt R.G humem
        change Birthday.posKey (u, ovCalls R.G u) < Birthday.posKey q
        have heq : (q.1, q.2 - 1 + 1) = q :=
          Prod.ext rfl (Nat.sub_add_cancel hq1)
        rw [← heq]
        exact R.posKey_parent_lt huv (q.2 - 1)
      · simp at h
    · simp at h
  · simp only [pinPartner] at h
    split at h
    · obtain rfl := Option.some.inj h
      simp [VAtom.pair, Birthday.posKey]
      omega
    · simp at h

theorem pinPartner_source_valid {a b : VAtom B} (h : R.pinPartner a = some b) :
    R.atomValid a := by
  rcases a with ⟨q⟩ | ⟨q⟩
  · simp only [pinPartner, atomValid] at h ⊢
    split at h
    · assumption
    · simp at h
  · simp only [pinPartner, atomValid] at h ⊢
    split at h
    · exact ‹q ∈ R.posSet ∧ 2 ≤ q.2›.1
    · simp at h

theorem pinPartner_target_valid {a b : VAtom B} (h : R.pinPartner a = some b) :
    R.atomValid b := by
  rcases a with ⟨q⟩ | ⟨q⟩
  · simp only [pinPartner] at h
    split at h
    · split at h
      · obtain rfl := Option.some.inj h
        simp only [atomValid]
        exact R.mem_posSet.2 ⟨by unfold ovCalls; omega, le_rfl⟩
      · simp at h
    · simp at h
  · simp only [pinPartner] at h
    split at h
    · obtain rfl := Option.some.inj h
      simp only [atomValid]
      exact R.mem_posSet.2 ⟨by omega, by
        have hv := (R.mem_posSet.1 ‹q ∈ R.posSet ∧ 2 ≤ q.2›.1).2
        change q.2 - 1 ≤ ovCalls R.G q.1
        omega⟩
    · simp at h

theorem atomValid_pair {a : VAtom B} (h : R.atomValid a) : a.pair ∈ R.posSet := by
  rcases a with ⟨q⟩ | ⟨q⟩ <;> exact h

theorem pinPartner_part {a b : VAtom B} (h : R.pinPartner a = some b) :
    b.part = a.part := by
  rcases a with ⟨q⟩ | ⟨q⟩
  · simp only [pinPartner] at h
    split at h
    · split at h
      · obtain rfl := Option.some.inj h
        rfl
      · simp at h
    · simp at h
  · simp only [pinPartner] at h
    split at h
    · obtain rfl := Option.some.inj h
      rfl
    · simp at h

def pointFixed (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (q : Fin B × ℕ) (j : ℕ) : Prop :=
  R.xin π q.1 q.2 ∈ ((R.stratC cut).hist (fun _ : Unit => π) j).dom ()

open Classical in
/-- First history transition fixing an honest pair. -/
noncomputable def pairStep (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (q : Fin B × ℕ) : ℕ :=
  if h : ∃ j < R.chargeBound cut,
      ¬ R.pointFixed cut π q j ∧ R.pointFixed cut π q (j + 1) then Nat.find h
  else R.chargeBound cut

theorem pairStep_exists {cut : ℕ} (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcut : cut ≤ R.programSteps π) {q : Fin B × ℕ} (hq : q ∈ R.posSet) :
    ∃ j < R.chargeBound cut,
      ¬ R.pointFixed cut π q j ∧ R.pointFixed cut π q (j + 1) := by
  exact (R.stratC cut).exists_first_fix (R.honest_fixed_C π hcut hq)

theorem pairStep_spec {cut : ℕ} (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcut : cut ≤ R.programSteps π) {q : Fin B × ℕ} (hq : q ∈ R.posSet) :
    R.pairStep cut π q < R.chargeBound cut ∧
      ¬ R.pointFixed cut π q (R.pairStep cut π q) ∧
      R.pointFixed cut π q (R.pairStep cut π q + 1) := by
  classical
  have h := R.pairStep_exists π hcut hq
  rw [pairStep, dif_pos h]
  exact Nat.find_spec h

theorem pairStep_inj {cut : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcut : cut ≤ R.programSteps π) (hnc : R.NoCollU π)
    {q q' : Fin B × ℕ} (hq : q ∈ R.posSet) (hq' : q' ∈ R.posSet)
    (heq : R.pairStep cut π q = R.pairStep cut π q') : q = q' := by
  let j := R.pairStep cut π q
  have hs := R.pairStep_spec π hcut hq
  have hs' := R.pairStep_spec π hcut hq'
  rw [← heq] at hs'
  obtain ⟨x, hx, -, hcase⟩ := (R.stratC cut).first_fix hs.2.1 hs.2.2
  obtain ⟨x', hx', -, hcase'⟩ := (R.stratC cut).first_fix hs'.2.1 hs'.2.2
  have hxx : x = x' := by
    rw [hx] at hx'
    exact Option.some.inj hx'
  have hpt : R.xin π q.1 q.2 = R.xin π q'.1 q'.2 := by
    rcases hcase with hf | hi <;> rcases hcase' with hf' | hi'
    · rw [hf, hf'] at hxx
      have hout := (Sigma.mk.inj_iff.mp hxx).2
      rw [heq_eq_eq] at hout
      exact Sum.inl.inj hout
    · rw [hf, hi'] at hxx
      simp at hxx
    · rw [hi, hf'] at hxx
      simp at hxx
    · rw [hi, hi'] at hxx
      have hout := (Sigma.mk.inj_iff.mp hxx).2
      rw [heq_eq_eq] at hout
      exact π.injective (Sum.inr.inj hout)
  by_cases hqq : q = q'
  · exact hqq
  · exact absurd hpt (R.decidePt_inj hnc hq hq' hqq)

/-- Whether a pair's first fresh decision is a forward query. -/
noncomputable def pairForward (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (q : Fin B × ℕ) : Bool :=
  match (R.stratC cut).next ((R.stratC cut).hist (fun _ : Unit => π)
    (R.pairStep cut π q)) with
  | some ⟨_, .inl _⟩ => true
  | _ => false

/-- Full cut holding, including every seed of the truncated pattern. -/
noncomputable def cutHolding (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ChainKnow B :=
  R.seedsAtCut π cut

def pinKnownAt (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (j : ℕ) (a : VAtom B) : Prop :=
  R.targetKnown cut π j (R.cutHolding cut π) a ∨
    ∃ z, R.pinPartner z = some a ∧ R.pairStep cut π z.pair < j

open Classical in
/-- One reviewed ι transfer. -/
noncomputable def pinNext (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (a : VAtom B) : Option (VAtom B) :=
  if R.pairForward cut π a.pair then none
  else match R.pinPartner a with
    | none => none
    | some b =>
        if R.pinKnownAt cut π (R.pairStep cut π a.pair) b then none else some b

theorem pinNext_some {cut : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {a b : VAtom B} (h : R.pinNext cut π a = some b) :
    R.pairForward cut π a.pair = false ∧ R.pinPartner a = some b ∧
      ¬ R.pinKnownAt cut π (R.pairStep cut π a.pair) b := by
  unfold pinNext at h
  split at h
  · simp at h
  · rename_i hf
    cases hp : R.pinPartner a with
    | none => rw [hp] at h; simp at h
    | some b' =>
        rw [hp] at h
        simp only at h
        split at h
        · simp at h
        · rename_i hk
          simp only [Option.some.injEq] at h
          subst b
          exact ⟨Bool.eq_false_of_not_eq_true hf, rfl, hk⟩

/-- The cell-level backing property needed by the reviewed stopping rule. -/
def PinBacking (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : Prop :=
  ∀ {a b : VAtom B}, R.pinPartner a = some b →
    ∀ {j}, R.pairStep cut π a.pair < j → R.pinKnownAt cut π j b

theorem pin_backing (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    R.PinBacking cut π :=
  fun h j hj => Or.inr ⟨_, h, hj⟩

theorem pinPartner_inj_same_pair {a₁ a₂ b : VAtom B}
    (hp : a₁.pair = a₂.pair)
    (h₁ : R.pinPartner a₁ = some b) (h₂ : R.pinPartner a₂ = some b) :
    a₁ = a₂ :=
  VAtom.eq_of_pair_part hp ((R.pinPartner_part h₁).symm.trans (R.pinPartner_part h₂))

theorem pinNext_inj {cut : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcut : cut ≤ R.programSteps π) (hnc : R.NoCollU π)
    (hback : R.PinBacking cut π)
    {a₁ a₂ b : VAtom B}
    (h₁ : R.pinNext cut π a₁ = some b) (h₂ : R.pinNext cut π a₂ = some b) :
    a₁ = a₂ := by
  obtain ⟨-, hp₁, hk₁⟩ := R.pinNext_some h₁
  obtain ⟨-, hp₂, hk₂⟩ := R.pinNext_some h₂
  by_cases hp : a₁.pair = a₂.pair
  · exact R.pinPartner_inj_same_pair hp hp₁ hp₂
  · have hs : R.pairStep cut π a₁.pair ≠ R.pairStep cut π a₂.pair := fun he =>
      hp (R.pairStep_inj hcut hnc
        (R.atomValid_pair (R.pinPartner_source_valid hp₁))
        (R.atomValid_pair (R.pinPartner_source_valid hp₂)) he)
    rcases lt_or_gt_of_ne hs with hlt | hlt
    · exact absurd (hback hp₁ hlt) hk₂
    · exact absurd (hback hp₂ hlt) hk₁

/-- Exactly `k` reviewed transfers. -/
noncomputable def pinNextN (R : ChainReplay B ℓ c)
    (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ℕ → VAtom B → Option (VAtom B)
  | 0, a => some a
  | k + 1, a => (pinNextN R cut π k a).bind (R.pinNext cut π)

theorem pinNextN_succ {cut : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {k : ℕ} {a e : VAtom B} :
    R.pinNextN cut π (k + 1) a = some e ↔
      ∃ y, R.pinNextN cut π k a = some y ∧ R.pinNext cut π y = some e := by
  simp [pinNextN, Option.bind_eq_some_iff]

theorem pinNextN_shift (R : ChainReplay B ℓ c)
    {cut : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {a b e : VAtom B} (hab : R.pinNext cut π a = some b) :
    ∀ k, R.pinNextN cut π k b = some e →
      R.pinNextN cut π (k + 1) a = some e
  | 0, h => by
      simp only [pinNextN, Option.some.injEq] at h
      subst e
      simp [pinNextN, hab]
  | k + 1, h => by
      obtain ⟨y, hy, he⟩ := R.pinNextN_succ.1 h
      exact R.pinNextN_succ.2 ⟨y, R.pinNextN_shift hab k hy, he⟩

/-- The reviewed direct/transfer charge cell. -/
noncomputable def pinCell (R : ChainReplay B ℓ c)
    (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (a : VAtom B) : VAtom B :=
  match h : R.pinNext cut π a with
  | none => a
  | some b => pinCell R cut π b
  termination_by Birthday.posKey a.pair
  decreasing_by exact R.pinPartner_rank_lt (R.pinNext_some h).2.1

theorem pinCell_spec (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ a : VAtom B, ∃ k,
      R.pinNextN cut π k a = some (R.pinCell cut π a) ∧
      R.pinNext cut π (R.pinCell cut π a) = none := by
  intro a
  induction n : Birthday.posKey a.pair using Nat.strong_induction_on generalizing a with
  | _ n ih =>
      rw [pinCell]
      cases h : R.pinNext cut π a with
      | none => exact ⟨0, rfl, h⟩
      | some b =>
          have hr := R.pinPartner_rank_lt (R.pinNext_some h).2.1
          obtain ⟨k, hk, hstop⟩ := ih _ (n ▸ hr) b rfl
          exact ⟨k + 1, R.pinNextN_shift h k hk, hstop⟩

theorem pinCell_valid (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ {a : VAtom B}, R.atomValid a → R.atomValid (R.pinCell cut π a) := by
  intro a ha
  induction n : Birthday.posKey a.pair using Nat.strong_induction_on generalizing a with
  | _ n ih =>
      rw [pinCell]
      cases h : R.pinNext cut π a with
      | none => exact ha
      | some b =>
          have hp := (R.pinNext_some h).2.1
          exact ih _ (n ▸ R.pinPartner_rank_lt hp) (R.pinPartner_target_valid hp) rfl

theorem pinCell_part (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ a : VAtom B, (R.pinCell cut π a).part = a.part := by
  intro a
  induction n : Birthday.posKey a.pair using Nat.strong_induction_on generalizing a with
  | _ n ih =>
      rw [pinCell]
      cases h : R.pinNext cut π a with
      | none => rfl
      | some b =>
          have hp := (R.pinNext_some h).2.1
          exact (ih _ (n ▸ R.pinPartner_rank_lt hp) b rfl).trans (R.pinPartner_part hp)

theorem seedAtom_pinKnown {cut j : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {a : VAtom B} (ha : a ∈ R.seedAtoms (R.cutHolding cut π)) :
    R.pinKnownAt cut π j a := by
  have hlab := R.seedsAtCut_labs_empty π cut
  have hlab' : (R.cutHolding cut π).labs = ∅ := by
    simpa [cutHolding] using hlab
  apply Or.inl
  unfold targetKnown
  rcases a with ⟨q⟩ | ⟨q⟩
  · unfold seedAtoms at ha
    rw [hlab', Finset.image_empty, Finset.union_empty] at ha
    rcases Finset.mem_union.1 ha with ha | ha
    · obtain ⟨q', hq', heq⟩ := Finset.mem_image.1 ha
      have hqq := VAtom.r.inj heq
      subst q'
      exact VCTarget.heldR hq'
    · obtain ⟨q', hq', heq⟩ := Finset.mem_image.1 ha
      cases heq
  · unfold seedAtoms at ha
    rw [hlab', Finset.image_empty, Finset.union_empty] at ha
    rcases Finset.mem_union.1 ha with ha | ha
    · obtain ⟨q', hq', heq⟩ := Finset.mem_image.1 ha
      cases heq
    · obtain ⟨q', hq', heq⟩ := Finset.mem_image.1 ha
      have hqq := VAtom.h.inj heq
      subst q'
      exact VCTarget.heldH (Finset.mem_filter.1 hq').1

theorem pinNext_not_seed {cut : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {a b : VAtom B} (h : R.pinNext cut π a = some b)
    (hb : b ∈ R.seedAtoms (R.cutHolding cut π)) : False :=
  (R.pinNext_some h).2.2 (R.seedAtom_pinKnown hb)

theorem pinReach_unique (R : ChainReplay B ℓ c)
    {cut : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcut : cut ≤ R.programSteps π) (hnc : R.NoCollU π)
    (hback : R.PinBacking cut π) :
    ∀ k₁ k₂ {a₁ a₂ e : VAtom B},
      a₁ ∈ R.seedAtoms (R.cutHolding cut π) →
      a₂ ∈ R.seedAtoms (R.cutHolding cut π) →
      R.pinNextN cut π k₁ a₁ = some e →
      R.pinNextN cut π k₂ a₂ = some e → a₁ = a₂
  | 0, 0, a₁, a₂, e, _, _, h₁, h₂ => by
      simp only [pinNextN, Option.some.injEq] at h₁ h₂
      exact h₁.trans h₂.symm
  | 0, k₂ + 1, a₁, a₂, e, hs₁, _, h₁, h₂ => by
      simp only [pinNextN, Option.some.injEq] at h₁
      obtain rfl := h₁
      obtain ⟨y, -, he⟩ := R.pinNextN_succ.1 h₂
      exact (R.pinNext_not_seed he hs₁).elim
  | k₁ + 1, 0, a₁, a₂, e, _, hs₂, h₁, h₂ => by
      simp only [pinNextN, Option.some.injEq] at h₂
      obtain rfl := h₂
      obtain ⟨y, -, he⟩ := R.pinNextN_succ.1 h₁
      exact (R.pinNext_not_seed he hs₂).elim
  | k₁ + 1, k₂ + 1, a₁, a₂, e, hs₁, hs₂, h₁, h₂ => by
      obtain ⟨y₁, hy₁, he₁⟩ := R.pinNextN_succ.1 h₁
      obtain ⟨y₂, hy₂, he₂⟩ := R.pinNextN_succ.1 h₂
      have heq := R.pinNext_inj hcut hnc hback he₁ he₂
      subst y₂
      exact R.pinReach_unique hcut hnc hback k₁ k₂ hs₁ hs₂ hy₁ hy₂

structure V6ChargePin (B : ℕ) where
  step : ℕ
  pair : Fin B × ℕ
  part : V6Part
deriving DecidableEq

noncomputable def chargePin (R : ChainReplay B ℓ c)
    (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (a : VAtom B) : V6ChargePin B where
  step := R.pairStep cut π (R.pinCell cut π a).pair
  pair := (R.pinCell cut π a).pair
  part := (R.pinCell cut π a).part

theorem chargePin_step_lt_nPos (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {s : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)
    {a : VAtom B} (ha : a ∈ R.realizedSeeds s π) :
    (R.chargePin (R.firstCrossing s π) π a).step < nPos B R.Q := by
  let cut := R.firstCrossing s π
  let e := R.pinCell cut π a
  have hev : R.atomValid e :=
    R.pinCell_valid cut π (R.realized_atom_valid s π ha)
  have hs := R.pairStep_spec π (R.firstCrossing_le s π hcross)
    (R.atomValid_pair hev)
  exact hs.1.trans_le
    ((Nat.add_le_add_right (R.firstCrossing_le s π hcross) R.posSet.card).trans
      (R.programSteps_add_pos_le hP π))


/-- The exact reviewed attribution obligation consumed downstream. -/
def V6ChargePinInjective : Prop :=
  ∀ (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))),
    (∃ cut ≤ R.programSteps π, R.crosses s π cut) →
    R.NoCollU π →
    Set.InjOn (R.chargePin (R.firstCrossing s π) π)
      (↑(R.realizedSeeds s π) : Set (VAtom B))

theorem v6_charge_pin_injective : R.V6ChargePinInjective := by
  intro s π hcross hnc a₁ ha₁ a₂ ha₂ heq
  let cut := R.firstCrossing s π
  let e₁ := R.pinCell cut π a₁
  let e₂ := R.pinCell cut π a₂
  have hpair : e₁.pair = e₂.pair :=
    congrArg V6ChargePin.pair heq
  have hpart : e₁.part = e₂.part :=
    congrArg V6ChargePin.part heq
  have he : e₁ = e₂ := VAtom.eq_of_pair_part hpair hpart
  obtain ⟨k₁, hk₁, -⟩ := R.pinCell_spec cut π a₁
  obtain ⟨k₂, hk₂, -⟩ := R.pinCell_spec cut π a₂
  change R.pinNextN cut π k₁ a₁ = some e₁ at hk₁
  change R.pinNextN cut π k₂ a₂ = some e₂ at hk₂
  rw [he] at hk₁
  exact R.pinReach_unique (R.firstCrossing_le s π hcross)
    hnc
    (R.pin_backing _ _)
    k₁ k₂
    (by simpa [cut, cutHolding, realizedSeeds] using ha₁)
    (by simpa [cut, cutHolding, realizedSeeds] using ha₂)
    hk₁ hk₂

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Geom ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open scoped ENNReal


theorem ennreal_ratio_mul_den (M P : ℕ) (hP : 0 < P) :
    ((M : ℝ≥0∞) / P) * P = M := by
  rw [div_eq_mul_inv, mul_assoc,
    ENNReal.inv_mul_cancel (by exact_mod_cast (Nat.ne_of_gt hP)) (ENNReal.natCast_ne_top _), mul_one]


private theorem nat_pow_le_two_mul_sub_pow
    (P n m : ℕ) (hm : m ≤ n) (hpop : 4 * n ^ 2 ≤ P) :
    P ^ m ≤ 2 * (P - n) ^ m := by
  by_cases hn : n = 0
  · subst n
    have : m = 0 := by omega
    subst m
    simp
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn
  have hPpos : 0 < P := by nlinarith
  have hnP : n ≤ P := by nlinarith
  have hmn : 2 * m * n ≤ P := by
    have hmn' : m * n ≤ n ^ 2 := by
      calc
        m * n ≤ n * n := Nat.mul_le_mul_right n hm
        _ = n ^ 2 := by ring
    nlinarith
  let a : ℝ := 1 - (n : ℝ) / P
  have ha0 : 0 ≤ a := by
    dsimp [a]
    rw [sub_nonneg, div_le_one (by exact_mod_cast hPpos)]
    exact_mod_cast hnP
  have hfrac : (m : ℝ) * n / P ≤ 1 / 2 := by
    rw [div_le_iff₀ (by exact_mod_cast hPpos)]
    have hmnR : 2 * (m : ℝ) * n ≤ P := by exact_mod_cast hmn
    nlinarith
  have hbern := one_add_mul_sub_le_pow (a := a) (by linarith : (-1 : ℝ) ≤ a) m
  have ha_pow : (1 / 2 : ℝ) ≤ a ^ m := by
    have ha_sub : a - 1 = -(n : ℝ) / P := by
      dsimp [a]
      ring
    rw [ha_sub] at hbern
    have hrewrite :
        (m : ℝ) * (-(n : ℝ) / P) = -((m : ℝ) * n / P) := by ring
    rw [hrewrite] at hbern
    nlinarith
  have ha_eq : a = ((P - n : ℕ) : ℝ) / P := by
    rw [Nat.cast_sub hnP]
    dsimp [a]
    field_simp
  have hmul := mul_le_mul_of_nonneg_right ha_pow
    (show 0 ≤ (P : ℝ) ^ m by positivity)
  rw [ha_eq, div_pow] at hmul
  have hratio :
      ((P : ℝ) ^ m) / 2 ≤ ((P - n : ℕ) : ℝ) ^ m := by
    calc
      ((P : ℝ) ^ m) / 2 = (1 / 2 : ℝ) * (P : ℝ) ^ m := by ring
      _ ≤ (((P - n : ℕ) : ℝ) ^ m / (P : ℝ) ^ m) * (P : ℝ) ^ m := hmul
      _ = ((P - n : ℕ) : ℝ) ^ m := by
        field_simp
  have hreal :
      ((P : ℝ) ^ m) ≤ 2 * ((P - n : ℕ) : ℝ) ^ m := by
    nlinarith
  exact_mod_cast hreal

private theorem nat_sub_mul_le_mul_sub
    (P n q : ℕ) (hq : 1 ≤ q) :
    (P - n) * q ≤ P * q - n := by
  rw [Nat.sub_mul]
  have hnq : n ≤ n * q := by
    simpa using Nat.mul_le_mul_left n hq
  exact Nat.sub_le_sub_left hnq _

/-- A finite population costs one global factor two, rather than one factor
two per pin. -/
theorem v6_finite_population_product_le
    {ι : Type} [DecidableEq ι] (Z : Finset ι) (w : ι → ℕ)
    (nPos ℓ : ℕ)
    (hw : ∀ z ∈ Z, ℓ ≤ w z)
    (hcard : Z.card ≤ nPos)
    (hpop : 4 * nPos ^ 2 ≤ 2 ^ ℓ) :
    ∏ z ∈ Z, (((2 ^ w z - nPos : ℕ) : ℝ≥0∞))⁻¹
      ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ (∑ z ∈ Z, w z) := by
  let P := 2 ^ ℓ
  let q : ι → ℕ := fun z => 2 ^ (w z - ℓ)
  have hP : ∀ z ∈ Z, 2 ^ w z = P * q z := by
    intro z hz
    rw [show w z = ℓ + (w z - ℓ) by
      exact (Nat.add_sub_of_le (hw z hz)).symm, pow_add]
  have hq : ∀ z ∈ Z, 1 ≤ q z := by
    intro z hz
    exact one_le_pow₀ (by norm_num)
  have hden :
      (P - nPos) ^ Z.card * ∏ z ∈ Z, q z
        ≤ ∏ z ∈ Z, (2 ^ w z - nPos) := by
    rw [← Finset.prod_const, ← Finset.prod_mul_distrib]
    exact Finset.prod_le_prod fun z hz => by
      rw [hP z hz]
      exact nat_sub_mul_le_mul_sub P nPos (q z) (hq z hz)
  have hcore : P ^ Z.card ≤ 2 * (P - nPos) ^ Z.card :=
    nat_pow_le_two_mul_sub_pow P nPos Z.card hcard hpop
  have hnum :
      ∏ z ∈ Z, 2 ^ w z
        ≤ 2 * ∏ z ∈ Z, (2 ^ w z - nPos) := by
    calc
      ∏ z ∈ Z, 2 ^ w z =
          P ^ Z.card * ∏ z ∈ Z, q z := by
            rw [Finset.prod_congr rfl fun z hz => hP z hz,
              Finset.prod_mul_distrib, Finset.prod_const]
      _ ≤ (2 * (P - nPos) ^ Z.card) * ∏ z ∈ Z, q z :=
        Nat.mul_le_mul_right _ hcore
      _ ≤ 2 * ∏ z ∈ Z, (2 ^ w z - nPos) := by
        rw [mul_assoc]
        exact Nat.mul_le_mul_left 2 hden
  have hcast :
      (∏ z ∈ Z, ((2 ^ w z - nPos : ℕ) : ℝ≥0∞))⁻¹
        ≤ 2 * (∏ z ∈ Z, ((2 ^ w z : ℕ) : ℝ≥0∞))⁻¹ := by
    have hinv :
        (2 * ∏ z ∈ Z, ((2 ^ w z - nPos : ℕ) : ℝ≥0∞))⁻¹
          ≤ (∏ z ∈ Z, ((2 ^ w z : ℕ) : ℝ≥0∞))⁻¹ := by
      apply ENNReal.inv_le_inv.2
      exact_mod_cast hnum
    rw [ENNReal.mul_inv (Or.inl (by norm_num)) (Or.inl (by simp))] at hinv
    calc
      (∏ z ∈ Z, ((2 ^ w z - nPos : ℕ) : ℝ≥0∞))⁻¹ =
          2 * (2⁻¹ *
            (∏ z ∈ Z, ((2 ^ w z - nPos : ℕ) : ℝ≥0∞))⁻¹) := by
              rw [← mul_assoc,
                ENNReal.mul_inv_cancel (by norm_num) (by norm_num), one_mul]
      _ ≤ 2 * (∏ z ∈ Z, ((2 ^ w z : ℕ) : ℝ≥0∞))⁻¹ := by
        gcongr
  calc
    ∏ z ∈ Z, (((2 ^ w z - nPos : ℕ) : ℝ≥0∞))⁻¹ =
        (∏ z ∈ Z, ((2 ^ w z - nPos : ℕ) : ℝ≥0∞))⁻¹ := by
          rw [ENNReal.prod_inv_distrib]
          intro i _ j _ _
          exact Or.inr (ENNReal.natCast_ne_top _)
    _ ≤ 2 * (∏ z ∈ Z, ((2 ^ w z : ℕ) : ℝ≥0∞))⁻¹ := hcast
    _ = 2 * (2⁻¹ : ℝ≥0∞) ^ (∑ z ∈ Z, w z) := by
      congr 1
      simp only [Nat.cast_pow, Nat.cast_ofNat, Finset.prod_pow_eq_pow_sum,
        ENNReal.inv_pow]

theorem ennreal_v6_tail_half
    (M P s K : ℕ) (hP : 0 < P) (hgap : M + 2 ≤ P) :
    ∑ k ∈ Finset.range K, ((M : ℝ≥0∞) / P) ^ (s + 1 + k)
      ≤ ((M : ℝ≥0∞) / P) ^ s * M / 2 := by
  let r : ℝ≥0∞ := (M : ℝ≥0∞) / P
  have hgeom : ∀ k : ℕ,
      ∑ i ∈ Finset.range k, r ^ i ≤ (P : ℝ≥0∞) / 2 := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
        rw [geom_sum_succ]
        calc
          r * (∑ i ∈ Finset.range k, r ^ i) + 1
              ≤ r * ((P : ℝ≥0∞) / 2) + 1 := by gcongr
          _ = (M : ℝ≥0∞) / 2 + 1 := by
            calc
              r * ((P : ℝ≥0∞) / 2) + 1 =
                  (r * P) / 2 + 1 := by
                    simp only [div_eq_mul_inv]
                    ring
              _ = (M : ℝ≥0∞) / 2 + 1 := by
                rw [ennreal_ratio_mul_den M P hP]
          _ ≤ (P : ℝ≥0∞) / 2 := by
            calc
              (M : ℝ≥0∞) / 2 + 1 =
                  ((M + 2 : ℕ) : ℝ≥0∞) / 2 := by
                    push_cast
                    simp only [div_eq_mul_inv]
                    have h2 : (2 : ℝ≥0∞)⁻¹ * 2 = 1 :=
                      ENNReal.inv_mul_cancel (by norm_num) (by norm_num)
                    calc
                      (M : ℝ≥0∞) * 2⁻¹ + 1 =
                          M * 2⁻¹ + 2⁻¹ * 2 := by rw [h2]
                      _ = (M + 2) * 2⁻¹ := by ring
              _ ≤ (P : ℝ≥0∞) / 2 :=
                ENNReal.div_le_div_right (by exact_mod_cast hgap) _
  calc
    ∑ k ∈ Finset.range K, r ^ (s + 1 + k)
        = r ^ (s + 1) * ∑ k ∈ Finset.range K, r ^ k := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [← pow_add]
    _ ≤ r ^ (s + 1) * ((P : ℝ≥0∞) / 2) := by
      exact mul_le_mul' le_rfl (hgeom K)
    _ = r ^ s * M / 2 := by
      rw [pow_succ, mul_assoc]
      have hrP : r * P = M := by
        exact ennreal_ratio_mul_den M P hP
      calc
        r ^ s * (r * ((P : ℝ≥0∞) / 2)) =
            r ^ s * (r * P) / 2 := by
              simp only [div_eq_mul_inv]
              ring
        _ = r ^ s * M / 2 := by rw [hrP]

private theorem nat_v6_pattern_numerator_le
    (M P s : ℕ) (hM : 4 ≤ M) (hgap : M + 2 ≤ P) :
    P * (∑ n ∈ Finset.range (s + 2), M ^ n) + M ^ (s + 2)
      ≤ 2 * P * M ^ (s + 1) := by
  induction s with
  | zero =>
      simp only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, zero_add,
        pow_one]
      nlinarith
  | succ s ih =>
      have hcoef : 2 * P + P * M + M ^ 2 ≤ 2 * P * M + M := by
        nlinarith
      have hcoef' := Nat.mul_le_mul_right (M ^ (s + 1)) hcoef
      rw [show s + 1 + 2 = (s + 2) + 1 by omega, Finset.sum_range_succ]
      rw [show s + 1 + 1 = s + 2 by omega, show s + 1 + 2 = s + 3 by omega]
      rw [show M ^ (s + 2) = M ^ (s + 1) * M by rw [pow_succ],
        show M ^ (s + 3) = M ^ (s + 1) * M ^ 2 by ring]
      have hsum := Nat.add_le_add ih hcoef'
      ring_nf at hsum ⊢
      omega

/-- Geometric accounting with one global finite-population factor. -/
theorem sum_v6_patterns_global_le
    (M P s K : ℕ) (hM : 4 ≤ M) (hP : 0 < P) (hgap : M + 2 ≤ P) :
    ((∑ n ∈ Finset.range (s + 2), M ^ n : ℕ) : ℝ≥0∞) / P ^ s +
        2 * ∑ k ∈ Finset.range K,
          ((M : ℝ≥0∞) / P) ^ (s + 2 + k)
      ≤ 2 * (((M : ℝ≥0∞) ^ (s + 1)) / P ^ s) := by
  let r : ℝ≥0∞ := (M : ℝ≥0∞) / P
  have htail :
      2 * ∑ k ∈ Finset.range K, r ^ (s + 2 + k)
        ≤ r ^ (s + 1) * M := by
    have h := ennreal_v6_tail_half M P (s + 1) K hP hgap
    calc
      2 * ∑ k ∈ Finset.range K, r ^ (s + 2 + k)
          ≤ 2 * (r ^ (s + 1) * M / 2) := by
            simpa [r, add_assoc] using
              (mul_le_mul' (le_refl (2 : ℝ≥0∞)) h)
      _ = r ^ (s + 1) * M := by
        have h2 : (2 : ℝ≥0∞) * 2⁻¹ = 1 :=
          ENNReal.mul_inv_cancel (by norm_num) (by norm_num)
        rw [div_eq_mul_inv]
        calc
          2 * (r ^ (s + 1) * M * 2⁻¹) =
              r ^ (s + 1) * M * (2 * 2⁻¹) := by ring
          _ = r ^ (s + 1) * M := by rw [h2, mul_one]
  have hnat := nat_v6_pattern_numerator_le M P s hM hgap
  have hP0 : (P : ℝ≥0∞) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hP)
  have hPt : (P : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hPinv : (P : ℝ≥0∞) * (P : ℝ≥0∞)⁻¹ = 1 :=
    ENNReal.mul_inv_cancel hP0 hPt
  have hmulInv :
      (((P : ℝ≥0∞) ^ s * P)⁻¹) =
        (P : ℝ≥0∞)⁻¹ ^ s * (P : ℝ≥0∞)⁻¹ := by
    rw [ENNReal.mul_inv
      (Or.inl (pow_ne_zero s hP0)) (Or.inr hP0), ENNReal.inv_pow]
  calc
    ((∑ n ∈ Finset.range (s + 2), M ^ n : ℕ) : ℝ≥0∞) / P ^ s +
          2 * ∑ k ∈ Finset.range K, r ^ (s + 2 + k)
        ≤ ((∑ n ∈ Finset.range (s + 2), M ^ n : ℕ) : ℝ≥0∞) / P ^ s +
          r ^ (s + 1) * M := add_le_add le_rfl htail
    _ = (((P * (∑ n ∈ Finset.range (s + 2), M ^ n) +
          M ^ (s + 2) : ℕ) : ℝ≥0∞) / P ^ (s + 1)) := by
          push_cast
          simp only [r, div_eq_mul_inv, mul_pow, pow_succ, ENNReal.inv_pow]
          rw [hmulInv]
          set A : ℝ≥0∞ := ∑ n ∈ Finset.range (s + 2), (M : ℝ≥0∞) ^ n
          set X : ℝ≥0∞ := (M : ℝ≥0∞) ^ s
          set Q : ℝ≥0∞ := (P : ℝ≥0∞)⁻¹ ^ s
          change A * Q + X * Q * (M * (P : ℝ≥0∞)⁻¹) * M =
            (P * A + X * M * M) * (Q * (P : ℝ≥0∞)⁻¹)
          calc
            A * Q + X * Q * (M * (P : ℝ≥0∞)⁻¹) * M =
                ((P : ℝ≥0∞) * (P : ℝ≥0∞)⁻¹) * (A * Q) +
                  X * M * M * Q * (P : ℝ≥0∞)⁻¹ := by
                    rw [hPinv, one_mul]
                    ring
            _ = (P * A + X * M * M) *
                (Q * (P : ℝ≥0∞)⁻¹) := by ring
    _ ≤ (((2 * P * M ^ (s + 1) : ℕ) : ℝ≥0∞) / P ^ (s + 1)) :=
      ENNReal.div_le_div_right (by exact_mod_cast hnat) _
    _ = 2 * (((M : ℝ≥0∞) ^ (s + 1)) / P ^ s) := by
      push_cast
      simp only [div_eq_mul_inv, pow_succ, ENNReal.inv_pow]
      rw [hmulInv]
      set X : ℝ≥0∞ := (M : ℝ≥0∞) ^ s
      set Q : ℝ≥0∞ := (P : ℝ≥0∞)⁻¹ ^ s
      change 2 * P * (X * M) * (Q * (P : ℝ≥0∞)⁻¹) =
        2 * (X * M * Q)
      calc
        2 * P * (X * M) * (Q * (P : ℝ≥0∞)⁻¹) =
            2 * (X * M * Q) *
              ((P : ℝ≥0∞) * (P : ℝ≥0∞)⁻¹) := by ring
        _ = 2 * (X * M * Q) := by rw [hPinv, mul_one]


end PousSpongeChain

end


/-! ════ ChainEPFV6Tail ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- A source pointer: a real program slot, or the honest position consumed by an
inverse source.  Labeller positions are deliberately absent: the fixed-pattern
strategy derives its cut only from the adversary prefix. -/
abbrev V6Pointer : Type := (Fin B × Fin (R.Q + 1)) ⊕ R.posSet

/-- One seed's G1 name. The charged step is kept separately.  The row is needed
to interpret a forward label-form `r` source as the corresponding pad key. -/
abbrev V6SeedName : Type := V6Part × R.V6Pointer × Fin B

def v6M : ℕ := nPos B R.Q ^ 2 * B * 2


theorem card_v6_seed_names_large (hB : 1 ≤ B) :
    Fintype.card (Fin (nPos B R.Q) × R.V6SeedName) ≤ R.v6M := by
  have hpart : Fintype.card V6Part = 2 := by decide
  simp only [Fintype.card_prod, Fintype.card_fin, Fintype.card_sum,
    Fintype.card_coe, hpart]
  have hq := R.card_posSet_le_half
  have hptr :
      B * (R.Q + 1) + R.posSet.card ≤ nPos B R.Q := by
    unfold nPos
    omega
  unfold v6M
  calc
    nPos B R.Q * (2 * ((B * (R.Q + 1) + R.posSet.card) * B))
        ≤ nPos B R.Q * (2 * (nPos B R.Q * B)) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _
            (Nat.mul_le_mul_right B hptr))
    _ = nPos B R.Q ^ 2 * B * 2 := by ring


noncomputable def v6Seeds
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ChainKnow B :=
  R.v6SeedsThrough π (R.D + 1)

end ChainReplay

/-- Fixed-pattern fibers supplied by the charge-pin bridge in the nontrivial branch. -/
def V6PatternFibers : Prop :=
  ∀ (B ℓ c s : ℕ) (R : ChainReplay B ℓ c), (∀ i, (R.P i).Bounded R.D R.Q) →
    1 ≤ B → R.v6M < 2 ^ ℓ →
    ∃ (K : ℕ) (E : ℕ → ℕ → Equiv.Perm (Bits (ℓ + (ℓ + c))) → Prop),
      (∀ π, ((s : ℚ) < (R.v6Seeds π).size c ℓ ∧ R.NoCollU π) →
        (∃ n ∈ Finset.range (s + 2), ∃ f ∈ Finset.range (R.v6M ^ n), E n f π) ∨
        (∃ k ∈ Finset.range K, ∃ f ∈ Finset.range (R.v6M ^ (s + 2 + k)),
          E (s + 2 + k) f π)) ∧
      (∀ n ∈ Finset.range (s + 2), ∀ f ∈ Finset.range (R.v6M ^ n),
        pr (E n f) ≤ (((2 ^ ℓ : ℕ) : ℝ≥0∞) ^ s)⁻¹) ∧
      (∀ k ∈ Finset.range K, ∀ f ∈ Finset.range (R.v6M ^ (s + 2 + k)),
        pr (E (s + 2 + k) f) ≤
          2 * (((2 ^ ℓ : ℕ) : ℝ≥0∞)⁻¹) ^ (s + 2 + k))

theorem v6_pr_or_le {Ω : Type} [Fintype Ω] (P Q : Ω → Prop) :
    pr (fun x => P x ∨ Q x) ≤ pr P + pr Q := by
  have h := PousThm1Dense.pr_exists_le (Finset.univ : Finset Bool)
    (fun b x => if b then P x else Q x)
  rw [Fintype.sum_bool] at h
  refine le_trans (pr_mono fun x hx => ?_) (le_of_le_of_eq h ?_)
  · rcases hx with hp | hq
    · exact ⟨true, Finset.mem_univ _, by simpa using hp⟩
    · exact ⟨false, Finset.mem_univ _, by simpa using hq⟩
  · simp only [ite_true, Bool.false_eq_true, ite_false]


/-- Downstream assembly with the sharp one-global-factor finite-population
bound. -/
theorem band_tail_of_pattern_fibers {Ω : Type} [Fintype Ω]
    (M P s K : ℕ) (hM : 4 ≤ M) (hP : 0 < P) (hgap : M + 2 ≤ P)
    (E : ℕ → ℕ → Ω → Prop) (Win : Ω → Prop)
    (hcover : ∀ ω, Win ω →
      (∃ n ∈ Finset.range (s + 2), ∃ f ∈ Finset.range (M ^ n), E n f ω) ∨
      (∃ k ∈ Finset.range K, ∃ f ∈ Finset.range (M ^ (s + 2 + k)),
        E (s + 2 + k) f ω))
    (hsmall : ∀ n ∈ Finset.range (s + 2), ∀ f ∈ Finset.range (M ^ n),
      pr (E n f) ≤ (((P : ℝ≥0∞) ^ s)⁻¹))
    (hlarge : ∀ k ∈ Finset.range K,
      ∀ f ∈ Finset.range (M ^ (s + 2 + k)),
      pr (E (s + 2 + k) f) ≤
        2 * ((P : ℝ≥0∞)⁻¹) ^ (s + 2 + k)) :
    pr Win ≤ 2 * (((M : ℝ≥0∞) ^ (s + 1)) / P ^ s) := by
  let Small : Ω → Prop := fun ω =>
    ∃ n ∈ Finset.range (s + 2), ∃ f ∈ Finset.range (M ^ n), E n f ω
  let Large : Ω → Prop := fun ω =>
    ∃ k ∈ Finset.range K, ∃ f ∈ Finset.range (M ^ (s + 2 + k)),
      E (s + 2 + k) f ω
  refine (pr_mono hcover).trans ((v6_pr_or_le Small Large).trans ?_)
  have hs : pr Small ≤
      ((∑ n ∈ Finset.range (s + 2), M ^ n : ℕ) : ℝ≥0∞) / P ^ s := by
    calc
      pr Small ≤ ∑ n ∈ Finset.range (s + 2),
          pr (fun ω => ∃ f ∈ Finset.range (M ^ n), E n f ω) :=
        PousThm1Dense.pr_exists_le _ _
      _ ≤ ∑ n ∈ Finset.range (s + 2),
          ∑ f ∈ Finset.range (M ^ n), pr (E n f) :=
        Finset.sum_le_sum fun n _ => PousThm1Dense.pr_exists_le _ _
      _ ≤ ∑ n ∈ Finset.range (s + 2),
          ((M ^ n : ℕ) : ℝ≥0∞) * (((P : ℝ≥0∞) ^ s)⁻¹) := by
        refine Finset.sum_le_sum fun n hn => ?_
        calc
          ∑ f ∈ Finset.range (M ^ n), pr (E n f)
              ≤ ∑ _f ∈ Finset.range (M ^ n),
                  (((P : ℝ≥0∞) ^ s)⁻¹) :=
                Finset.sum_le_sum fun f hf => hsmall n hn f hf
          _ = _ := by
            rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      _ = _ := by
        rw [← Finset.sum_mul, div_eq_mul_inv]
        push_cast
        rfl
  have hl : pr Large ≤
      2 * ∑ k ∈ Finset.range K,
        ((M : ℝ≥0∞) / P) ^ (s + 2 + k) := by
    calc
      pr Large ≤ ∑ k ∈ Finset.range K,
          pr (fun ω => ∃ f ∈ Finset.range (M ^ (s + 2 + k)),
            E (s + 2 + k) f ω) :=
        PousThm1Dense.pr_exists_le _ _
      _ ≤ ∑ k ∈ Finset.range K,
          ∑ f ∈ Finset.range (M ^ (s + 2 + k)),
            pr (E (s + 2 + k) f) :=
        Finset.sum_le_sum fun k _ => PousThm1Dense.pr_exists_le _ _
      _ ≤ ∑ k ∈ Finset.range K,
          ((M ^ (s + 2 + k) : ℕ) : ℝ≥0∞) *
            (2 * ((P : ℝ≥0∞)⁻¹) ^ (s + 2 + k)) := by
        refine Finset.sum_le_sum fun k hk => ?_
        calc
          ∑ f ∈ Finset.range (M ^ (s + 2 + k)),
              pr (E (s + 2 + k) f)
              ≤ ∑ _f ∈ Finset.range (M ^ (s + 2 + k)),
                  2 * ((P : ℝ≥0∞)⁻¹) ^ (s + 2 + k) :=
                Finset.sum_le_sum fun f hf => hlarge k hk f hf
          _ = _ := by
            rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      _ = _ := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [Nat.cast_pow, div_eq_mul_inv, mul_pow]
        ring
  exact (add_le_add hs hl).trans
    (sum_v6_patterns_global_le M P s K hM hP hgap)

/-

theorem ennreal_two_mul_div_two_mul (A B : ℝ≥0∞) :
    (2 * A) / (2 * B) = A / B := by
  rw [div_eq_mul_inv, div_eq_mul_inv,
    ENNReal.mul_inv (Or.inl (by norm_num)) (Or.inl (by norm_num))]
  have h2 : (2 : ℝ≥0∞) * 2⁻¹ = 1 :=
    ENNReal.mul_inv_cancel (by norm_num) (by norm_num)
  calc
    2 * A * (2⁻¹ * B⁻¹) = A * B⁻¹ * (2 * 2⁻¹) := by ring
    _ = A * B⁻¹ := by rw [h2, mul_one]

theorem ennreal_geom_ratio_le (M P k : ℕ) (h : M < P) :
    ∑ i ∈ Finset.range k, ((M : ℝ≥0∞) / P) ^ i ≤ P := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [geom_sum_succ]
      calc
        (M / P : ℝ≥0∞) * (∑ i ∈ Finset.range k, (M / P : ℝ≥0∞) ^ i) + 1
            ≤ (M / P : ℝ≥0∞) * P + 1 := by gcongr
        _ = M + 1 := by
          rw [div_eq_mul_inv, mul_assoc,
            ENNReal.inv_mul_cancel
              (by exact_mod_cast (Nat.ne_of_gt (lt_of_le_of_lt (Nat.zero_le _) h)))
              (ENNReal.natCast_ne_top _), mul_one]
        _ ≤ P := by exact_mod_cast h

theorem ennreal_ratio_mul_den (M P : ℕ) (hP : 0 < P) :
    ((M : ℝ≥0∞) / P) * P = M := by
  rw [div_eq_mul_inv, mul_assoc,
    ENNReal.inv_mul_cancel (by exact_mod_cast (Nat.ne_of_gt hP)) (ENNReal.natCast_ne_top _), mul_one]

set_option maxHeartbeats 4000000 in
theorem ennreal_ratio_pow_mul_den (M P s : ℕ) (hP : 0 < P) :
    ((M : ℝ≥0∞) / P) ^ (s + 1) * P = (M : ℝ≥0∞) ^ (s + 1) / P ^ s := by
  induction s with
  | zero => simpa using ennreal_ratio_mul_den M P hP
  | succ s ih =>
      calc
        ((M : ℝ≥0∞) / P) ^ (s + 1 + 1) * P =
            ((M : ℝ≥0∞) / P) * (((M : ℝ≥0∞) / P) ^ (s + 1) * P) := by ring
        _ = ((M : ℝ≥0∞) / P) * ((M : ℝ≥0∞) ^ (s + 1) / P ^ s) := by rw [ih]
        _ = (M : ℝ≥0∞) ^ (s + 1 + 1) / P ^ (s + 1) := by
          have hp0 : (P : ℝ≥0∞) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hP)
          have hpt : (P : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
          simp only [div_eq_mul_inv, pow_succ']
          rw [ENNReal.mul_inv (Or.inl hp0) (Or.inl hpt), ENNReal.inv_pow]
          ring

/-- **G3 finite geometric envelope.** The first-crossing sizes cost one extra bit;
all larger sizes pay their own `M / P` ratio. Instantiate `P = 2^ℓ`; integer strictness
`M < P` bounds the entire large-size tail without strengthening the branch split. -/
theorem sum_v6_patterns_le (M P s K : ℕ) (hM : 2 ≤ M) (hMP : M < P) :
    ((∑ n ∈ Finset.range (s + 2), M ^ n : ℕ) : ℝ≥0∞) /
          (2 * P ^ s) +
        ∑ k ∈ Finset.range K, ((M : ℝ≥0∞) / P) ^ (s + 2 + k)
      ≤ 2 * (((M : ℝ≥0∞) ^ (s + 1)) / P ^ s) := by
  have hP : 0 < P := lt_of_le_of_lt (by omega : 0 ≤ M) hMP
  have hsmall :
      ((∑ n ∈ Finset.range (s + 2), M ^ n : ℕ) : ℝ≥0∞) / (2 * P ^ s)
        ≤ ((M : ℝ≥0∞) ^ (s + 1)) / P ^ s := by
    calc
      _ ≤ ((2 * M ^ (s + 1) : ℕ) : ℝ≥0∞) / (2 * P ^ s) :=
        ENNReal.div_le_div_right (by exact_mod_cast geom_sum_le M hM (s + 1)) _
      _ = _ := by
        push_cast
        exact ennreal_two_mul_div_two_mul _ _
  have htail :
      ∑ k ∈ Finset.range K, ((M : ℝ≥0∞) / P) ^ (s + 2 + k)
        ≤ ((M : ℝ≥0∞) ^ (s + 1)) / P ^ s := by
    let r : ℝ≥0∞ := (M : ℝ≥0∞) / P
    calc
      ∑ k ∈ Finset.range K, r ^ (s + 2 + k)
          = r ^ (s + 2) * ∑ k ∈ Finset.range K, r ^ k := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun k _ => ?_
            rw [← pow_add]
      _ ≤ r ^ (s + 2) * P :=
        mul_le_mul' le_rfl (ennreal_geom_ratio_le M P K hMP)
      _ = r ^ (s + 1) * M := by
        rw [show s + 2 = (s + 1) + 1 by omega, pow_succ, mul_assoc,
          ennreal_ratio_mul_den M P hP]
      _ ≤ r ^ (s + 1) * P := by
        exact mul_le_mul' le_rfl (by exact_mod_cast hMP.le)
      _ = ((M : ℝ≥0∞) ^ (s + 1)) / P ^ s :=
        ennreal_ratio_pow_mul_den M P s hP
  calc
    _ ≤ ((M : ℝ≥0∞) ^ (s + 1)) / P ^ s +
        ((M : ℝ≥0∞) ^ (s + 1)) / P ^ s := add_le_add hsmall htail
    _ = _ := by ring
-/

end PousSpongeChain

