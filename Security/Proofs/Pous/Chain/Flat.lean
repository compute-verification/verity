/-!
# `AdaptiveMinEntropy → ZeroAdviceLucky → n10prime` (`ZeroAdvicePlan.md`, M5)

`zeroAdviceLucky_of_adaptiveMinEntropy` takes the union bound over lucky sets (`PousLuckyCount.union_bound`), with:
- coverage `luckyBits_ge` (from `knowledgeSimHits`);
- `card_luckySet_le` and `luckySet_subset`;
- the pool factor `pow_le_two_mul_pow_sub`;
- the binomial bounds `sum_choose_le_two` and `choose_ten_ge`.

The only hypothesis is `AdaptiveMinEntropyPool`, which `AdaptiveMinEntropy` implies.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge PousLuckyCount
open scoped ENNReal

/-- One class's weight, from `AdaptiveMinEntropy` and the pool hypothesis: `Σ 2^{bits} ≤ 2^{9n+1}·|Ω|`. -/
theorem class_weight_le {n wc Q j : ℕ} {Wt Ωc : ℕ} (hn : 0 < n) (hj : j ≤ 9 * n)
    (hpool : 64 * n * (n * (Q + 1) + 2 * n) ≤ 2 ^ (n * wc))
    (h : Wt * (2 ^ (n * wc) - 2 * (n * (Q + 1) + 2 * n)) ^ j ≤ (2 * 2 ^ (n * wc)) ^ j * Ωc) :
    Wt ≤ 2 ^ (9 * n + 1) * Ωc := by
  set M := 2 ^ (n * wc) with hM
  set x := 2 * (n * (Q + 1) + 2 * n) with hx
  have hMpos : 0 < M := by positivity
  have hxM : x < M := by
    have : 1 ≤ n * (Q + 1) + 2 * n := by nlinarith
    nlinarith
  have hbern : M ^ j ≤ 2 * (M - x) ^ j := by
    refine pow_le_two_mul_pow_sub hMpos ?_
    have : 64 * (j * x) ≤ 64 * (9 * n * x) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hj)
    calc 64 * (j * x) ≤ 64 * (9 * n * x) := this
      _ = 18 * (64 * n * (n * (Q + 1) + 2 * n)) := by rw [hx]; ring
      _ ≤ 18 * M := Nat.mul_le_mul_left _ hpool
  have hpos : 0 < (M - x) ^ j := pow_pos (by omega) j
  have h2 : Wt * (M - x) ^ j ≤ 2 ^ (j + 1) * Ωc * (M - x) ^ j := by
    calc Wt * (M - x) ^ j ≤ (2 * M) ^ j * Ωc := h
      _ = 2 ^ j * M ^ j * Ωc := by rw [mul_pow]
      _ ≤ 2 ^ j * (2 * (M - x) ^ j) * Ωc := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hbern)
      _ = 2 ^ (j + 1) * Ωc * (M - x) ^ j := by ring
  have h3 : Wt ≤ 2 ^ (j + 1) * Ωc := Nat.le_of_mul_le_mul_right h2 hpos
  exact h3.trans (Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by norm_num) (by omega)))

/-- `AdaptiveMinEntropy` implies its pool-restricted form. -/
theorem adaptiveMinEntropyPool_of_adaptiveMinEntropy (hme : AdaptiveMinEntropy) : AdaptiveMinEntropyPool :=
  fun n wc D Q tag G W p _ _ hb S => hme n wc D Q tag G W p hb S

open Classical in
/-- **`ZeroAdviceLucky` from `AdaptiveMinEntropyPool`.** -/
theorem zeroAdviceLucky_of_adaptiveMinEntropyPool (hme : AdaptiveMinEntropyPool) : ZeroAdviceLucky := by
  intro n wc D Q k X tag G W p ⟨hn, hQ, hpool⟩ _hwc _hXk hard hb
  set N := 1 * (n * (Q + 1) + 2 * n) with hN
  have hNge : 20490 * n ≤ N := by
    have : 20490 ≤ Q + 3 := by omega
    calc 20490 * n ≤ (Q + 3) * n := Nat.mul_le_mul_right _ this
      _ = N := by rw [hN]; ring
  have hub := union_bound (fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω)
    (fun ω => luckySet p ω tag G W D Q) (fun ω => luckyBits p ω tag G W D)
    (Finset.range n ×ˢ Finset.range (Q + 1)) (9 * n) ((k - X) * (n * wc))
    (2 ^ (9 * n + 1) * Fintype.card (p3ModelT n wc).Ω)
    (fun ω hω => ⟨luckySet_subset p ω tag G W hb, card_luckySet_le p ω tag G W D Q,
      luckyBits_ge p ω tag G W hard hω.1⟩)
    (fun S _ hS => class_weight_le hn hS hpool (hme n wc D Q tag G W p hn hpool hb S))
  have hT : (Finset.range n ×ˢ Finset.range (Q + 1)).card = n * (Q + 1) := by simp
  rw [hT] at hub
  have hsum : ∑ j ∈ Finset.range (9 * n + 1), Nat.choose (n * (Q + 1)) j ≤ 2 * Nat.choose N (9 * n) :=
    (Finset.sum_le_sum fun j _ => Nat.choose_le_choose j (by rw [hN]; omega)).trans
      (sum_choose_le_two (by omega))
  calc (Finset.univ.filter fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω).card * 2 ^ ((k - X) * (n * wc))
      ≤ (∑ j ∈ Finset.range (9 * n + 1), Nat.choose (n * (Q + 1)) j) *
          (2 ^ (9 * n + 1) * Fintype.card (p3ModelT n wc).Ω) := by convert hub using 3; ext; simp only [Finset.mem_filter]
    _ ≤ 2 * Nat.choose N (9 * n) * (2 ^ (9 * n + 1) * Fintype.card (p3ModelT n wc).Ω) :=
        Nat.mul_le_mul_right _ hsum
    _ = 2 ^ (9 * n + 2) * Nat.choose N (9 * n) * Fintype.card (p3ModelT n wc).Ω := by ring
    _ ≤ Nat.choose N (10 * n) * Fintype.card (p3ModelT n wc).Ω :=
        Nat.mul_le_mul_right _ (choose_ten_ge hn hNge)
    _ = Nat.choose N (posLucky n) * Fintype.card (p3ModelT n wc).Ω := rfl

/-- **`ZeroAdviceLucky` from `AdaptiveMinEntropy`.** -/
theorem zeroAdviceLucky_of_adaptiveMinEntropy (hme : AdaptiveMinEntropy) : ZeroAdviceLucky :=
  zeroAdviceLucky_of_adaptiveMinEntropyPool (adaptiveMinEntropyPool_of_adaptiveMinEntropy hme)

/-! ### The chain, for any admissible-instance predicate `ok` (the `Ge` proofs of `Decode2.lean`) -/

theorem n10primeAtIf_of_adviceBoundIf (ok : ℕ → ℕ → ℕ → Prop) (pos : ℕ → ℕ) (h : AdviceBoundIf ok pos) :
    N10primeAtIf ok pos := by
  classical
  intro n wc m D Q k X tag G W hok hwc hXk hard A₁ A₂ hA₂
  show (pr fun ω => Win1 k tag G W A₁ A₂ ω) ≤ _
  rw [pr_partition (fun ω => Win1 k tag G W A₁ A₂ ω) (fun ω : (p3ModelT n wc).Ω => labCollT tag G W ω)]
  refine add_le_add ?_ (hbirthdayT_of_labelBirthdayT k tag G W A₁ A₂ (labelBirthdayAll n wc tag G W))
  have hpr := pr_le_of_advice A₁ (fun ω => Win1 k tag G W A₁ A₂ ω ∧ ¬ labCollT tag G W ω)
    (Nat.choose (1 * (n * (Q + 1) + 2 * n)) (pos n)) (2 ^ ((k - X) * (n * wc))) (by positivity)
    fun σ => le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card fun ω hω => by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
      exact hω)) (h n wc m D Q k X tag G W A₁ A₂ hok hwc hXk hard hA₂ σ)
  refine hpr.trans (le_of_eq ?_)
  simp only [N10primeBoundT, Nat.cast_one, one_mul, Nat.cast_pow, Nat.cast_ofNat]

theorem adviceBoundIf_of_zeroAdviceIf (ok : ℕ → ℕ → ℕ → Prop) (pos : ℕ → ℕ) (h : ZeroAdviceIf ok pos) :
    AdviceBoundIf ok pos := by
  classical
  intro n wc m D Q k X tag G W A₁ A₂ hok hwc hXk hard hA₂ σ
  refine le_trans (Nat.mul_le_mul_right _ ?_) (h n wc D Q k X tag G W (A₂ σ) hok hwc hXk hard (hA₂ σ))
  refine Finset.card_le_card fun ω hω => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
  obtain ⟨hσ, hwin, hcoll⟩ := hω
  refine ⟨?_, hcoll⟩
  unfold Win1 at hwin
  rw [hσ] at hwin
  exact hwin

/-- **`n10prime` at `10n`, on `okLucky`'s instances**, from the zero-advice core there. -/
theorem n10prime_of_zeroAdviceLucky (h : ZeroAdviceLucky) : N10primeAtIf okLucky posLucky :=
  n10primeAtIf_of_adviceBoundIf _ _ (adviceBoundIf_of_zeroAdviceIf _ _ h)

/-- **`n10prime` at `10n`, on `okLucky`'s instances, from `AdaptiveMinEntropyPool` alone.** -/
theorem n10prime_of_adaptiveMinEntropyPool (h : AdaptiveMinEntropyPool) : N10primeAtIf okLucky posLucky :=
  n10prime_of_zeroAdviceLucky (zeroAdviceLucky_of_adaptiveMinEntropyPool h)

/-- **`n10prime` at `10n`, on `okLucky`'s instances, from `AdaptiveMinEntropy` alone.** -/
theorem n10prime_of_adaptiveMinEntropy (h : AdaptiveMinEntropy) : N10primeAtIf okLucky posLucky :=
