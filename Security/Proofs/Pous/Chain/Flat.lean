/-! ════ PebblingMeets.P3Base ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousP3Base

open Pous Pous.ColumnAware Pous.P3Column Pous.Invertible
open scoped ENNReal

theorem labXor_labXor_cancel {n wc : ℕ} (a b : Lab n wc) : labXor (labXor a b) b = a := by
  funext v j
  simp only [labXor, Labelling.bxor]
  cases a v j <;> cases b v j <;> rfl

theorem transpose_transpose {n wc : ℕ} (C : Fin n → Lab n wc) : transpose (transpose C) = C := rfl

/-- **Averaging over the second coordinate.** -/
theorem pr_prod_le_snd {α β : Type} [Fintype α] [Fintype β] [Nonempty α] [Nonempty β] (R : α → β → Prop)
    (c : ℝ≥0∞) (h : ∀ b, pr (fun a => R a b) ≤ c) : pr (fun x : α × β => R x.1 x.2) ≤ c := by
  classical
  have hα0 : (Fintype.card α : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hβ0 : (Fintype.card β : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hαt : (Fintype.card α : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hβt : (Fintype.card β : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hcount : ((Finset.univ.filter fun x : α × β => R x.1 x.2).card : ℝ≥0∞) =
      ∑ b, ((Finset.univ.filter fun a => R a b).card : ℝ≥0∞) := by
    rw [Finset.natCast_card_filter, Fintype.sum_prod_type, Finset.sum_comm]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [Finset.natCast_card_filter]
  have hfib : ∀ b, ((Finset.univ.filter fun a => R a b).card : ℝ≥0∞) ≤ c * Fintype.card α := by
    intro b
    have := h b
    rwa [pr_def, ENNReal.div_le_iff hα0 hαt] at this
  rw [pr_def, hcount, Fintype.card_prod, Nat.cast_mul,
    ENNReal.div_le_iff (mul_ne_zero hα0 hβ0) (ENNReal.mul_ne_top hαt hβt)]
  calc ∑ b, ((Finset.univ.filter fun a => R a b).card : ℝ≥0∞) ≤ ∑ _b : β, c * Fintype.card α :=
        Finset.sum_le_sum fun b _ => hfib b
    _ = c * (Fintype.card α * Fintype.card β) := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; ring

/-- Post-process a program's output; the queries are unchanged. -/
def progMap {M : IdealModel} {α β : Type} (g : α → β) : OracleProg M α → OracleProg M β
  | .ret a => .ret (g a)
  | .round qs k => .round qs fun as => progMap g (k as)

theorem run_progMap {M : IdealModel} {α β : Type} (g : α → β) (f : M.Qry → M.Ans) (p : OracleProg M α) :
    (progMap g p).run f = g (p.run f) := by
  induction p with
  | ret a => rfl
  | round qs k ih => exact ih _

theorem bounded_progMap {M : IdealModel} {α β : Type} (g : α → β) {D Q : ℕ} {p : OracleProg M α} (h : p.Bounded D Q) :
    (progMap g p).Bounded D Q := by
  have hd : ∀ (f : M.Qry → M.Ans) (p : OracleProg M α), (progMap g p).depth f = p.depth f := by
    intro f p
    induction p with
    | ret a => rfl
    | round qs k ih => exact congrArg (· + 1) (ih _)
  have hw : ∀ (f : M.Qry → M.Ans) (p : OracleProg M α), (progMap g p).work f = p.work f := by
    intro f p
    induction p with
    | ret a => rfl
    | round qs k ih => exact congrArg (qs.length + ·) (ih _)
  exact fun ω => by rw [hd, hw]; exact h ω

theorem two_pow_mul_inv_pow (a b : ℕ) (h : a ≤ b) :
    (2 : ℝ≥0∞) ^ a * (2⁻¹ : ℝ≥0∞) ^ b = (2⁻¹ : ℝ≥0∞) ^ (b - a) := by
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [pow_add, ← mul_assoc, ← mul_pow, ENNReal.mul_inv_cancel two_ne_zero ENNReal.ofNat_ne_top, one_pow, one_mul,
    Nat.add_sub_cancel_left]


theorem sum_pow_le (n t : ℕ) (hn : 2 ≤ n) : ∑ j ∈ Finset.range t, (n : ℝ≥0∞) ^ j ≤ (n : ℝ≥0∞) ^ t := by
  have h : ∑ j ∈ Finset.range t, n ^ j ≤ n ^ t := by
    induction t with
    | zero => simp
    | succ t ih =>
      rw [Finset.sum_range_succ, pow_succ]
      nlinarith [pow_pos (by omega : 0 < n) t]
  exact_mod_cast h


end PousP3Base

end


