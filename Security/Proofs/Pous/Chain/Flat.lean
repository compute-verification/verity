/-!
# `ChainExPostFacto` for the overwrite chain, and its deployment

Work file for the critical-path task (`sponge-dense/CHAIN-EPF-PLAN.md`). Reuses the game side already proved in
`SpongeDense.lean` (`chainDense_hard`, `chainHard_of_pebblingHard`, `chain_invariant`) and the numeric assembly of
`DenseMeets.lean`/`DenseReCert.lean`.

Milestone 6 first (conditional glue): `chain_timedINC` maps `Pous.Sponge.ChainExPostFacto` into `TimedINC` for the
concrete overwrite chain `chainDense`, exactly as `PousDenseChain.dense_timedINC` maps B5 into `TimedINC` for the random
oracle. This is a faithful port; it isolates `ChainExPostFacto` as the sole remaining obligation for the deployment
and segmented forms.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

set_option maxRecDepth 8000

/-! ### Permutation multi-point compression (milestone 2/4 core)

The permutation analogue of B5's per-prediction `2^{-w}` cost. For a uniform permutation, pinning each of a set `I`
of inputs into a target set `A x` costs `(∏|A x|)·(|L|−|I|)!/|L|!`. This is the one-shot replacement for B5's
inductive `card_Ev_snoc`/`Ev_update` resampling, and the base of both the freshness term and the collision term.
It rests only on `PousHintCard.card_perm_mem_le` (`card_fiber_le`: on `Iᶜ` a pinned permutation is an embedding into
`L ∖ g(I)`). -/
theorem pr_perm_pin {L : Type} [Fintype L] [DecidableEq L] [Nonempty L] (I : Finset L) (A : L → Finset L) :
    pr (fun π : Equiv.Perm L => ∀ x ∈ I, π x ∈ A x)
      ≤ ((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * ((Fintype.card L - I.card).factorial : ℝ≥0∞)
          / ((Fintype.card L).factorial : ℝ≥0∞) := by
  classical
  rw [pr_def, Fintype.card_perm]
  gcongr ?_ / _
  calc ((Finset.univ.filter fun π : Equiv.Perm L => ∀ x ∈ I, π x ∈ A x).card : ℝ≥0∞)
      ≤ (((Fintype.card L - I.card).factorial * ∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) := by
        exact_mod_cast PousHintCard.card_perm_mem_le I A
    _ = ((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * ((Fintype.card L - I.card).factorial : ℝ≥0∞) := by
        push_cast; ring

/-! ### Part A: permutation resampling — the factor `2` per fresh item

Resampling a permutation at a fresh point is uniform over the `≥ |L|/2` unused points (when `2·|I| ≤ |L|`), so each
fresh item costs `2·|A x|/|L|` rather than `|A x|/|L|`. The combinatorial core is `descFactorial_pow_bound`
(`|L|^t ≤ 2^t·|L|(|L|−1)…(|L|−t+1)`); `pr_perm_pin_two` is the probability form. Off `2·|I| ≤ |L|`, the collision
term of `ChainExPostFacto` already exceeds `1`, so this side condition is free. -/

/-- `M^t ≤ 2^t · (M.descFactorial t)` when `2t ≤ M`: the descending product `M(M−1)…(M−t+1)` is at least `(M/2)^t`.
Each fresh permutation answer lands among the `≥ M/2` still-unused points, the source of the per-item factor `2`. -/
theorem descFactorial_pow_bound : ∀ (M t : ℕ), 2 * t ≤ M → M ^ t ≤ 2 ^ t * M.descFactorial t
  | _, 0, _ => by simp
  | M, t + 1, h => by
      have ih : M ^ t ≤ 2 ^ t * M.descFactorial t := descFactorial_pow_bound M t (by omega)
      have hM : M ≤ 2 * (M - t) := by omega
      calc M ^ (t + 1) = M ^ t * M := by rw [pow_succ]
        _ ≤ (2 ^ t * M.descFactorial t) * (2 * (M - t)) := Nat.mul_le_mul ih hM
        _ = 2 ^ (t + 1) * ((M - t) * M.descFactorial t) := by ring
        _ = 2 ^ (t + 1) * M.descFactorial (t + 1) := by rw [Nat.descFactorial_succ]

/-- **Permutation resampling bound (Part A).** With `2·|I| ≤ |L|`, pinning each `x ∈ I` into `A x` happens with
probability at most `2^{|I|}·(∏|A x|)/|L|^{|I|}` — a factor `2` per item over the naive `∏(|A x|/|L|)`. -/
theorem pr_perm_pin_two {L : Type} [Fintype L] [DecidableEq L] [Nonempty L] (I : Finset L) (A : L → Finset L)
    (h : 2 * I.card ≤ Fintype.card L) :
    pr (fun π : Equiv.Perm L => ∀ x ∈ I, π x ∈ A x)
      ≤ 2 ^ I.card * ((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) / (Fintype.card L : ℝ≥0∞) ^ I.card := by
  classical
  have hMpos : 0 < Fintype.card L := Fintype.card_pos
  have htM : I.card ≤ Fintype.card L := by omega
  have hkey : (Fintype.card L) ^ I.card * (Fintype.card L - I.card).factorial
      ≤ 2 ^ I.card * (Fintype.card L).factorial := by
    calc (Fintype.card L) ^ I.card * (Fintype.card L - I.card).factorial
        ≤ (2 ^ I.card * (Fintype.card L).descFactorial I.card) * (Fintype.card L - I.card).factorial :=
          Nat.mul_le_mul_right _ (descFactorial_pow_bound _ _ h)
      _ = 2 ^ I.card * ((Fintype.card L - I.card).factorial * (Fintype.card L).descFactorial I.card) := by ring
      _ = 2 ^ I.card * (Fintype.card L).factorial := by rw [Nat.factorial_mul_descFactorial htM]
  have hF0 : ((Fintype.card L).factorial : ℝ≥0∞) ≠ 0 := by exact_mod_cast (Nat.factorial_pos _).ne'
  have hFt : ((Fintype.card L).factorial : ℝ≥0∞) ≠ ∞ := ENNReal.natCast_ne_top _
  have hM0 : ((Fintype.card L : ℝ≥0∞)) ^ I.card ≠ 0 := by
    exact pow_ne_zero _ (by exact_mod_cast hMpos.ne')
  have hMt : ((Fintype.card L : ℝ≥0∞)) ^ I.card ≠ ∞ := by
    apply ENNReal.pow_ne_top; exact ENNReal.natCast_ne_top _
  have hc : ((Fintype.card L : ℝ≥0∞)) ^ I.card * ((Fintype.card L - I.card).factorial : ℝ≥0∞)
      ≤ (2 : ℝ≥0∞) ^ I.card * ((Fintype.card L).factorial : ℝ≥0∞) := by exact_mod_cast hkey
  have hcancelF : ((Fintype.card L).factorial : ℝ≥0∞) * ((Fintype.card L).factorial : ℝ≥0∞)⁻¹ = 1 :=
    ENNReal.mul_inv_cancel hF0 hFt
  have hcancelM : ((Fintype.card L : ℝ≥0∞)) ^ I.card * (((Fintype.card L : ℝ≥0∞)) ^ I.card)⁻¹ = 1 :=
    ENNReal.mul_inv_cancel hM0 hMt
  refine (pr_perm_pin I A).trans ?_
  rw [div_eq_mul_inv, div_eq_mul_inv]
  have key := mul_le_mul' hc (le_refl
    (((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * ((Fintype.card L).factorial : ℝ≥0∞)⁻¹ *
      (((Fintype.card L : ℝ≥0∞)) ^ I.card)⁻¹))
  have eL : ((Fintype.card L : ℝ≥0∞)) ^ I.card * ((Fintype.card L - I.card).factorial : ℝ≥0∞) *
      (((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * ((Fintype.card L).factorial : ℝ≥0∞)⁻¹ *
        (((Fintype.card L : ℝ≥0∞)) ^ I.card)⁻¹) =
      ((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * ((Fintype.card L - I.card).factorial : ℝ≥0∞) *
        ((Fintype.card L).factorial : ℝ≥0∞)⁻¹ := by
    rw [show ((Fintype.card L : ℝ≥0∞)) ^ I.card * ((Fintype.card L - I.card).factorial : ℝ≥0∞) *
        (((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * ((Fintype.card L).factorial : ℝ≥0∞)⁻¹ *
          (((Fintype.card L : ℝ≥0∞)) ^ I.card)⁻¹) =
        (((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * ((Fintype.card L - I.card).factorial : ℝ≥0∞) *
          ((Fintype.card L).factorial : ℝ≥0∞)⁻¹) *
          (((Fintype.card L : ℝ≥0∞)) ^ I.card * (((Fintype.card L : ℝ≥0∞)) ^ I.card)⁻¹) from by ac_rfl,
      hcancelM, mul_one]
  have eR : (2 : ℝ≥0∞) ^ I.card * ((Fintype.card L).factorial : ℝ≥0∞) *
      (((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * ((Fintype.card L).factorial : ℝ≥0∞)⁻¹ *
        (((Fintype.card L : ℝ≥0∞)) ^ I.card)⁻¹) =
      2 ^ I.card * ((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * (((Fintype.card L : ℝ≥0∞)) ^ I.card)⁻¹ := by
    rw [show (2 : ℝ≥0∞) ^ I.card * ((Fintype.card L).factorial : ℝ≥0∞) *
        (((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * ((Fintype.card L).factorial : ℝ≥0∞)⁻¹ *
          (((Fintype.card L : ℝ≥0∞)) ^ I.card)⁻¹) =
        (2 ^ I.card * ((∏ x ∈ I, (A x).card : ℕ) : ℝ≥0∞) * (((Fintype.card L : ℝ≥0∞)) ^ I.card)⁻¹) *
          (((Fintype.card L).factorial : ℝ≥0∞) * ((Fintype.card L).factorial : ℝ≥0∞)⁻¹) from by ac_rfl,
      hcancelF, mul_one]
  rw [eL, eR] at key
  exact key

/-- The ex-post-facto `π` for the overwrite chain: the `ChainExPostFacto` right-hand side at `N = B`, width `ℓ`,
preprocessor width `m = β`, pebbling loss `s = B − D − 1`, and every block a challenge (`k = B`). -/
noncomputable def chainPi (B ℓ c D Q β : ℕ) : ℝ≥0∞ :=
  2 ^ β * 2 * ((((nPos B Q) ^ 2 * B * 2) ^ (B - D - 1 + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * (B - D - 1)) +
    (((nPos B Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c)

/-- **Glue (milestone 6).** Rebuilding every block of `chainDense` within `(D, Q)` from a `β`-bit compression answers
all `B` challenges of the complete DAG, so `ChainExPostFacto` bounds `TimedINC` by `chainPi`. The port of
`PousDenseChain.dense_timedINC` to the permutation model. -/
theorem chain_timedINC (hepf : ChainExPostFacto) (B ℓ c D Q β : ℕ) [NeZero B] (hD : D + 1 ≤ B)
    (dom : ℕ → Bits c) (hdom : Function.Injective (fun i : Fin B => dom i)) :
    TimedINC (chainDense B ℓ c dom) D Q β (chainPi B ℓ c D Q β) := by
  classical
  intro W cmp exp hexp
  have hE := hepf B ℓ c β (B - D - 1) D Q B dom (Dense.blocks B ℓ W) hdom
    (chainDense_hard B D c ℓ hD)
    (fun π => cmp W (fun i => i.elim0)
      (fun i => labelOv (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom (Dense.blocks B ℓ W) i) π)
    (fun σ i => exp W (fun i => i.elim0) σ i) (fun σ i => hexp W _ σ i)
  refine le_trans (le_of_eq_of_le (PousThm1Dense.pr_fst (β := Unit)
    (fun π : Equiv.Perm (Bits (ℓ + (ℓ + c))) =>
      ∀ i, (exp W (fun i => i.elim0)
        (cmp W (fun i => i.elim0)
          (fun i => labelOv (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom (Dense.blocks B ℓ W) i) π)
        i).run ((idealPerm (ℓ + (ℓ + c))).answer π) =
        labelOv (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom (Dense.blocks B ℓ W) i))
    (pr_mono fun π hH => ?_)) hE
  refine le_trans (le_of_eq (by rw [Finset.card_univ, Fintype.card_fin]))
    (Finset.card_le_card (s := Finset.univ) fun c _ => Finset.mem_filter.2 ⟨Finset.mem_univ _, hH c⟩)

/-! ### Deployment at the 64 KB point (milestone 7), conditional on `ChainExPostFacto`

`B = 2^9`, `ℓ = 524288` (64 KiB), `c = 512`, `D = 5`, `Q = 2^20`. The chain's ex-post-facto `π` has `/2^(ℓ·s)`
(`s = B − D − 1`), one factor `2^ℓ` weaker than B5's `/2^(ℓ·(s+1))` — the "costs one label" of `NOTES.md` §6. That
one missing `2^ℓ` moves the certified `k` from the random-oracle `106` (`dense_meets_64`) to **`k = 111`** here:
with `β = 265253616` the union term is `2^-128` exactly and `p₀^111 ≤ 1%` (while `p₀^110 > 1%`). `k = 106` is the
2-position charge of `NOTES.md` §6, which the stated bound (2 positions **and a row**, base `nPos²·B·2`) does not give.
-/

/-- The state bound `⌊ρ·|C|⌋ = 254307274` at `|C| = 2^9·524288 = 2^28`, the same as the random-oracle point. -/
theorem stateBound_chain_64 (dom : ℕ → Bits 512) :
    (chainDense (2 ^ 9) 524288 512 dom).stateBound Params.ρ = 254307274 := by
  show ⌊Params.ρ * (((2 ^ 9) * 524288 : ℕ) : ℚ)⌋₊ = 254307274
  rw [Nat.floor_eq_iff (by norm_num [Params.ρ])]
  norm_num [Params.ρ]

/-- `|Hist|·chainPi ≤ 2^-128` at the 64 KB point with `β = 265253616`, `k = 111`. The freshness term is `2^-129`
(exponent `265289728 − 265289599 = 129`) and the collision term is far below it, summing to `2^-128`. -/
theorem chain_union_term_64 :
    (∑ j ∈ Finset.range 111, ((2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) * chainPi (2 ^ 9) 524288 512 5 (2 ^ 20) 265253616
      ≤ (2⁻¹ : ℝ≥0∞) ^ 128 := by
  have hsum : (∑ j ∈ Finset.range 111, ((2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) ≤ (2 : ℝ≥0∞) ^ 999 := by
    refine (PousDenseChain.sum_pow_le _ _ (by norm_num)).trans (le_of_eq ?_)
    rw [show ((2 ^ 9 : ℕ) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ 9 by norm_num, ← pow_mul]
  have hbase : ((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 * 2 ^ 9 * 2 : ℕ) ≤ 2 ^ 69 := by
    norm_num [Pous.Sponge.nPos]
  have hnp2 : ((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) ≤ 2 ^ 59 := by norm_num [Pous.Sponge.nPos]
  have hE1 : 524288 * (2 ^ 9 - 5 - 1) = 265289728 := by norm_num
  have hs1 : 2 ^ 9 - 5 - 1 + 1 = 507 := by norm_num
  -- term1 ≤ 2^-1128
  have ht1 : (2 : ℝ≥0∞) ^ 265253616 * 2 *
      ((((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 * 2 ^ 9 * 2) ^ (2 ^ 9 - 5 - 1 + 1) : ℕ) : ℝ≥0∞) /
        2 ^ (524288 * (2 ^ 9 - 5 - 1)) ≤ (2⁻¹ : ℝ≥0∞) ^ 1128 := by
    rw [hs1, hE1]
    have hb : ((((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 * 2 ^ 9 * 2) ^ 507 : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 34983 := by
      have hmid : (((2 ^ 69) ^ 507 : ℕ) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ 34983 := by
        rw [show ((2 : ℕ) ^ 69) ^ 507 = 2 ^ 34983 from by rw [← pow_mul]]; push_cast; ring
      exact hmid ▸ (by exact_mod_cast Nat.pow_le_pow_left hbase 507)
    calc (2 : ℝ≥0∞) ^ 265253616 * 2 *
            ((((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 * 2 ^ 9 * 2) ^ 507 : ℕ) : ℝ≥0∞) / 2 ^ 265289728
        ≤ (2 : ℝ≥0∞) ^ 265253616 * 2 * 2 ^ 34983 / 2 ^ 265289728 := by gcongr
      _ = (2⁻¹ : ℝ≥0∞) ^ 1128 := by
          rw [div_eq_mul_inv, ENNReal.inv_pow, ← pow_succ, ← pow_add]
          exact PousDenseChain.two_pow_mul_inv_pow _ _ (by norm_num)
  -- term2 (collision term, corrected width ℓ+c) ≤ 2^-1128
  have hE2 : 524288 + 512 = 524800 := by norm_num
  have ht2 : ((((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞)) / 2 ^ (524288 + 512)
      ≤ (2⁻¹ : ℝ≥0∞) ^ 1128 := by
    rw [hE2]
    have hb : (((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 59 := by
      have hmid : (((2 ^ 59 : ℕ)) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ 59 := by push_cast; ring
      exact hmid ▸ (by exact_mod_cast hnp2)
    calc (((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ 524800
        ≤ (2 : ℝ≥0∞) ^ 59 / 2 ^ 524800 := by gcongr
      _ = (2⁻¹ : ℝ≥0∞) ^ 524741 := by
          rw [div_eq_mul_inv, ENNReal.inv_pow]; exact PousDenseChain.two_pow_mul_inv_pow _ _ (by norm_num)
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ 1128 := pow_le_pow_right_of_le_one' (by norm_num) (by norm_num)
  have hhalf : (2⁻¹ : ℝ≥0∞) ^ 129 + (2⁻¹ : ℝ≥0∞) ^ 129 = (2⁻¹ : ℝ≥0∞) ^ 128 := by
    have key : (2 : ℝ≥0∞) * 2⁻¹ = 1 := ENNReal.mul_inv_cancel (by norm_num) (by norm_num)
    calc (2⁻¹ : ℝ≥0∞) ^ 129 + (2⁻¹ : ℝ≥0∞) ^ 129 = 2 * (2⁻¹ : ℝ≥0∞) ^ 129 := (two_mul _).symm
      _ = 2 * (2⁻¹ * (2⁻¹ : ℝ≥0∞) ^ 128) := by rw [pow_succ']
      _ = (2 * 2⁻¹) * (2⁻¹ : ℝ≥0∞) ^ 128 := by rw [← mul_assoc]
      _ = (2⁻¹ : ℝ≥0∞) ^ 128 := by rw [key, one_mul]
  unfold chainPi
  calc (∑ j ∈ Finset.range 111, ((2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) *
        ((2 : ℝ≥0∞) ^ 265253616 * 2 *
            ((((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 * 2 ^ 9 * 2) ^ (2 ^ 9 - 5 - 1 + 1) : ℕ) : ℝ≥0∞) /
              2 ^ (524288 * (2 ^ 9 - 5 - 1)) +
          (((Pous.Sponge.nPos (2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (524288 + 512))
      ≤ (2 : ℝ≥0∞) ^ 999 * ((2⁻¹ : ℝ≥0∞) ^ 1128 + (2⁻¹ : ℝ≥0∞) ^ 1128) :=
        mul_le_mul' hsum (add_le_add ht1 ht2)
    _ = (2⁻¹ : ℝ≥0∞) ^ 129 + (2⁻¹ : ℝ≥0∞) ^ 129 := by
        rw [mul_add, PousDenseChain.two_pow_mul_inv_pow _ _ (by norm_num)]
    _ = (2⁻¹ : ℝ≥0∞) ^ 128 := hhalf

/-- `p₀^111 ≤ 1%` at `β = 265253616`, `S = 254307274`, `B = 2^9`, `ℓ = 524288` (`p₀ ≈ 0.95922`). -/
theorem chain_sampling_term_64 :
    ENNReal.ofReal (p₀ 265253616 254307274 (2 ^ 9) 524288) ^ 111 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  have h0 : 0 ≤ p₀ 265253616 254307274 (2 ^ 9) 524288 := by unfold p₀; norm_num
  rw [← ENNReal.ofReal_pow h0]
  refine ENNReal.ofReal_le_ofReal ?_
  unfold p₀
  norm_num [Params.δ]

/-- Distinct block indices get distinct domains `dom salt` (`salt ‖ u256 i`), for `B ≤ 2^256`. -/
theorem dom_inj (salt : Bits 256) {B : ℕ} (hB : B ≤ 2 ^ 256) :
    Function.Injective (fun i : Fin B => Pous.Sponge.dom salt i.val) := by
  intro a b h
  refine Fin.ext (Nat.eq_of_testBit_eq fun n => ?_)
  by_cases hn : n < 256
  · have hh := congrFun h (Fin.natAdd 256 (⟨n, hn⟩ : Fin 256))
    simp only [Pous.Sponge.dom] at hh
    rw [Fin.append_right, Fin.append_right] at hh
    simpa using hh
  · push_neg at hn
    rw [Nat.testBit_eq_false_of_lt (lt_of_lt_of_le a.isLt (le_trans hB (Nat.pow_le_pow_right (by norm_num) hn))),
      Nat.testBit_eq_false_of_lt (lt_of_lt_of_le b.isLt (le_trans hB (Nat.pow_le_pow_right (by norm_num) hn)))]

/-- **The overwrite-chain dense scheme meets the requirement at the 64 KB point** (conditional on
`ChainExPostFacto`): sequential reveal, `D = 5`, `Q = 2^20`, `k = 111`, `ε = 2^-128`. The chain analogue of
`Pous.DenseReCert.dense_meets_64`, at the honest `k = 111` the stated ex-post-facto bound delivers. -/
theorem chain_meets_64 (hepf : ChainExPostFacto) (salt : Bits 256) :
    Pous.Meets (chainDense (2 ^ 9) 524288 512 (Pous.Sponge.dom salt)) .sequential 5 (2 ^ 20) 111
      ((2⁻¹ : ℝ≥0∞) ^ 128) := by
  refine ⟨le_rfl, chainDense_correct _ _ _ _, le_rfl, ?_, ?_⟩
  · show ((((2 ^ 9) * 524288 + 0 : ℕ)) : ℚ) ≤ Pous.Params.expansion * (((2 ^ 9) * 524288 : ℕ) : ℚ)
    norm_num [Pous.Params.expansion]
  · intro W A₁ A₂
    have hINC := chain_timedINC hepf (2 ^ 9) 524288 512 5 (2 ^ 20) 265253616 (by norm_num)
      (Pous.Sponge.dom salt) (dom_inj salt (by norm_num))
    refine (PousTargetsDense.theorem1_ii_seq (chainDense (2 ^ 9) 524288 512 (Pous.Sponge.dom salt)) 5 (2 ^ 20)
      265253616 ((chainDense (2 ^ 9) 524288 512 (Pous.Sponge.dom salt)).stateBound Pous.Params.ρ) 111 _
      hINC W A₁ A₂).trans ?_
    rw [stateBound_chain_64, add_comm]
    exact add_le_add chain_sampling_term_64 chain_union_term_64

end PousSpongeChain

end


/-! ════ BandChainModel ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# The band graph over the overwrite chain: a weighted chain certificate (statements for red-team review)

Definitions and targets only, no proofs. `BandChain.lean` will import this file unchanged and prove the targets.

**The scheme.** One layer on the band DAG with in-degree `d`, over the overwrite chain `H` of `SpongeModel.lean` §9:
`C_v = key_Π₂(IV(dom v); C_(v−1), …, C_(v−d), pad) ⊕ W_v`. Row `v` is `min(v, d) + 1` calls, against dense's `v + 1`
(256.5 on average at `B = 512`). Sources: `internal/chain-band-graph-plausibility.md`, and
`docs/public-encoder/problem-statement.md` §4 (A1, "Graph changes").

**Why the existing proof does not cover it.** `chainHard_of_pebblingHard` forgets time: it maps the chain game to
random-oracle pebbling, where a node is pebbled one round after its parents. On a band graph that pebbling frees a
constant fraction of the nodes (`b1_free_fraction`), so the certificate collapses.

**The weighted certificate (§2) keeps the chain clock instead.**
- `ChainClock`: in the chain game on any DAG, a label known after `t` rounds is a seed of the holding
  (`ChainKnow.seeds`, whose count `card_seeds_le_size` already bounds by the price), or its own row has at most `t`
  calls. Every row starts from its own `IV(dom v)`, so nothing held for another row shortens it.
- `WeightedChainCert`: hence `ChainHard G VC c ℓ s D k` whenever `s + |shortRows G VC D| < k`.
- `BandChainHard`: with `d ≥ D`, the band's rows of at most `D` calls are exactly rows `0 … D − 1`. So the band is
  `(B − D − 1, D, B)`-hard, the hardness `chainDense_hard` gives dense.

**The three attacks the red team named.**
- **Held partial chain states.** `ChainClock` quantifies over every `ChainKnow` holding: labels, chaining values
  `h_{v,j}` at any position, and dropped `r`s. A held `h_{v,j}` is a seed for row `v` only, priced `1 + c/ℓ ≥ 1`.
- **Adversarial gap placement.** `BandChainHard` holds for every holding and assumes no spacing. The row length alone
  exceeds `D`, so no cross-gap argument is needed.
- **The collision width.** `ChainExPostFactoG` carries the amended `nPos²/2^(ℓ+c)` of red-team §35.

**`d ≥ D` is necessary** (`BandGapAttack`). With `d + 1 ≤ D`, hold every label except the positive multiples of
`d + 1`. Each dropped row has all its parents held and at most `D` calls, so all `B` labels are known after `D` rounds.
At `B = 512`, `d = 4`, `D = 5` that frees 102 blocks, against dense's 5 (`BandGapAttack512`).

**Plugging into `Meets` (§3–4).**
- `ChainExPostFacto` is stated for the complete DAG. `ChainExPostFactoG` is the same statement for any `TopoDAG`,
  with `labelG` in place of `labelOv`, and every term unchanged. On any DAG on `Fin B` the labeller makes
  `Σ_v ovCalls G v ≤ B(B + 1)/2` calls, so `nPos B Q` still bounds the positions.
- `ChainExPostFactoGSpec`: at the complete DAG it is `ChainExPostFacto`.
- `BandTimedINC`: with `BandChainHard`, it gives `TimedINC` for the band scheme at dense's `chainPi`.
- `BandMeets64`: the band scheme meets the requirement at the dense chain deployment point (`chain_meets_64`: 64 KiB,
  `B = 512`, `D = 5`, `Q = 2^20`, `k = 111`, `ε = 2^-128`), for every `d ≥ 5`.
-/

namespace Pous.BandChain

open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal

/-! ## 1. The band DAG, and the overwrite-chain scheme on any DAG -/






/-! ## 2. The weighted chain certificate -/

/-- The nodes of `VC` whose own row fits in `D` rounds: at most `D` calls. -/
def shortRows {N : ℕ} (G : TopoDAG N) (VC : Finset (Fin N)) (D : ℕ) : Finset (Fin N) :=
  VC.filter fun v => ovCalls G v ≤ D

/-- **Target: the chain clock.** In the chain game on any DAG, from any holding `P₀` (labels, chaining values at any
position, dropped `r`s), a label known after `t` rounds is a seed of `P₀` (held; the row of a held chaining value; the
block of a held `r`, or the row of a held pad-call `r`), or its own row has at most `t` calls. -/
def ChainClock : Prop :=
  ∀ (N : ℕ) (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) (v : Fin N),
    v ∈ (ChainKnow.reach G P₀ t).labs → v ∈ P₀.seeds G ∨ ovCalls G v ≤ t

/-- **Target: the weighted chain certificate.** A holding priced at most `s` has at most `s` seeds
(`card_seeds_le_size`), so with `ChainClock` it knows at most `s + |shortRows G VC D|` challenge labels after `D`
rounds. -/
def WeightedChainCert : Prop :=
  ∀ (N : ℕ) (G : TopoDAG N) (VC : Finset (Fin N)) (c ℓ : ℕ) (s : ℚ) (D k : ℕ),
    s + (shortRows G VC D).card < k → ChainHard G VC c ℓ s D k

/-- **Target: the band with in-degree `d ≥ D` is `(B − D − 1, D, B)`-hard in the chain game**, as dense is
(`chainDense_hard`). Explicit parameters: in-degree `d`, `B` blocks, `D` rounds, and storage bound `B − D − 1` labels
(a chaining value priced `1 + c/ℓ`, a dropped `r` 1), with every block a challenge. -/
def BandChainHard : Prop :=
  ∀ (B d D c ℓ : ℕ), D ≤ d → D + 1 ≤ B →
    ChainHard (bandDAG B d) Finset.univ c ℓ ((B - D - 1 : ℕ) : ℚ) D B

/-- **Target: `d ≥ D` cannot be dropped (the gap attack).** With `d + 1 ≤ D`, the holding of every label except the
positive multiples of `d + 1`, priced `B − ⌊(B − 1)/(d + 1)⌋`, knows all `B` labels after `D` rounds. -/
def BandGapAttack : Prop :=
  ∀ (B d D c ℓ : ℕ), d + 1 ≤ D →
    ¬ ChainHard (bandDAG B d) Finset.univ c ℓ ((B - (B - 1) / (d + 1) : ℕ) : ℚ) D B

/-- **Target: the gap attack at the deployment size.** At `B = 512`, `D = 5`, in-degree `d = 4` is not `(506, 5, 512)`-hard:
the holding of `BandGapAttack` costs 410 labels and knows all 512. -/
def BandGapAttack512 : Prop :=
  ∀ c ℓ : ℕ, ¬ ChainHard (bandDAG 512 4) Finset.univ c ℓ ((512 - 5 - 1 : ℕ) : ℚ) 5 512

/-- **Target: `D + 1 ≤ B` cannot be dropped.** With `B = D = d = 1`, the empty holding knows the one label after one
round. -/
def BandNeedsRoom : Prop :=
  ∀ c ℓ : ℕ, ¬ ChainHard (bandDAG 1 1) Finset.univ c ℓ ((1 - 1 - 1 : ℕ) : ℚ) 1 1

/-! ## 3. The ex post facto bound on any DAG -/

/-- **Hypothesis of §4: `ChainExPostFacto` on any DAG.** The same statement with `Dense.completeDAG B` and `labelOv`
replaced by any `G : TopoDAG B` and `labelG G`. Every term is unchanged: the labeller makes `Σ_v ovCalls G v ≤
B(B + 1)/2` calls on any DAG on `Fin B`, so `nPos B Q` still bounds the positions; a fresh item is still named by two
positions and a row; and the collision term is the amended `nPos²/2^(ℓ+c)` (red-team §35: a pad-call input is the fixed
`padBlk` beside an `(ℓ + c)`-bit chaining value). -/
def ChainExPostFactoG : Prop :=
  ∀ (B ℓ c m s D Q k : ℕ) (G : TopoDAG B) (dom : ℕ → Bits c) (Wb : Fin B → Bits ℓ),
    Function.Injective (fun i : Fin B => dom i) → ChainHard G Finset.univ c ℓ s D k →
    ∀ (A₁ : Equiv.Perm (Bits (ℓ + (ℓ + c))) → Bits m)
      (A₂ : Bits m → Fin B → Pous.Prog (idealPerm (ℓ + (ℓ + c))) (Bits ℓ)),
      (∀ σ i, (A₂ σ i).Bounded D Q) →
      pr (fun π : Equiv.Perm (Bits (ℓ + (ℓ + c))) =>
          k ≤ (Finset.univ.filter fun i =>
            (A₂ (A₁ π) i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG G π dom Wb i).card)
        ≤ 2 ^ m * 2 * ((((nPos B Q) ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * s) +
          (((nPos B Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c)

/-- **Target: `ChainExPostFactoG` is the DAG-generic form of `ChainExPostFacto`.** At `G = Dense.completeDAG B` it is
exactly `ChainExPostFacto`, since `labelG` on the complete DAG is `labelOv`. -/
def ChainExPostFactoGSpec : Prop := ChainExPostFactoG → ChainExPostFacto

/-! ## 4. Into the `Meets` chain -/

/-- **Target: the glue.** With `d ≥ D`, `ChainExPostFactoG` and `BandChainHard` give `TimedINC` for the band scheme
with dense's `chainPi B ℓ c D Q β`: the port of `chain_timedINC`, for explicit `B`, `d`, `ℓ`, `c`, `D`, `Q`, `β`. -/
def BandTimedINC : Prop :=
  ChainExPostFactoG → ∀ (B d ℓ c D Q β : ℕ) [NeZero B] (dom : ℕ → Bits c),
    D ≤ d → D + 1 ≤ B → Function.Injective (fun i : Fin B => dom i) →
    TimedINC (chainBand B d ℓ c dom) D Q β (chainPi B ℓ c D Q β)

/-- **The band scheme meets the requirement at the dense chain deployment point** (`chain_meets_64`): 64 KiB labels,
`B = 512`, in-degree `d`, capacity 512, any salt, sequential reveal, `D = 5` rounds and `Q = 2^20` queries of `Π₂^{±1}`
per answer, `k = 111`, `ε = 2^-128`. -/
def ChainBandMeets64 (d : ℕ) : Prop :=
  ∀ salt : Bits 256,
    Pous.Meets (chainBand (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)) .sequential 5 (2 ^ 20) 111
      ((2⁻¹ : ℝ≥0∞) ^ 128)

/-- **Target: the band deployment, given `ChainExPostFactoG`**, for every in-degree `d ≥ D = 5`, with the dense chain
certificate's numbers unchanged (`β = 265253616`, `k = 111`). -/
def BandMeets64 : Prop := ChainExPostFactoG → ∀ d : ℕ, 5 ≤ d → ChainBandMeets64 d

end Pous.BandChain

end


/-! ════ BandChain ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# The band graph over the overwrite chain: proofs

Proves the targets of `BandChainModel.lean` (imported unchanged): `ChainClock`, `WeightedChainCert`, `BandChainHard`,
`BandGapAttack`, `BandGapAttack512`, `BandNeedsRoom`, `ChainExPostFactoGSpec`, `BandTimedINC` and `BandMeets64` (the
last two conditional on `ChainExPostFactoG`, by their statements), with satisfiability witnesses and the cliff at
`D = d + 1`.
-/

namespace Pous.BandChain

open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal

/-! ## 1. The chain clock -/

section Clock

variable {N : ℕ}

/-- **The clock invariant.** After `t` rounds from `P₀`, on a row with no held chaining value:
1. a known chaining value `h_{v,j}` has `j ≤ t`;
2. a known dropped `r_{v,j}` that was not held has `j ≤ t`;
and every known label is a seed of `P₀` or its row has at most `t` calls. -/
theorem clock_invariant (G : TopoDAG N) (P₀ : ChainKnow N) : ∀ t,
    (∀ p ∈ (ChainKnow.reach G P₀ t).hs, p.2 ≠ 0 →
        p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst → p.2 ≤ t) ∧
    (∀ p ∈ (ChainKnow.reach G P₀ t).rs, p ∉ P₀.rs →
        p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst → p.2 ≤ t) ∧
    (∀ v ∈ (ChainKnow.reach G P₀ t).labs, v ∈ P₀.seeds G ∨ ovCalls G v ≤ t) := by
  intro t
  induction t with
  | zero =>
    refine ⟨?_, ?_, ?_⟩
    · intro p hp h0 hH
      exact absurd (Finset.mem_image.2 ⟨p, Finset.mem_filter.2 ⟨hp, h0⟩, rfl⟩) hH
    · intro p hp hn; exact absurd hp hn
    · intro v hv
      rw [ChainKnow.reach, mem_read_labs] at hv
      left
      unfold ChainKnow.seeds
      rcases hv with hv | hv
      · exact Finset.mem_union_left _ (Finset.mem_union_left _ hv)
      · exact Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨_, hv, by simp⟩)
  | succ t ih =>
    obtain ⟨ih1, ih2, ih3⟩ := ih
    set K := ChainKnow.reach G P₀ t with hK
    have hKs : ChainKnow.reach G P₀ (t + 1) = K.round G := rfl
    -- a call that can be made in round `t + 1` has index at most `t + 1`
    have hcall : ∀ p : Fin N × ℕ, K.canCall G p.1 p.2 →
        p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst → p.2 ≤ t + 1 := by
      rintro p ⟨hj1, -, -, hprev⟩ hH
      rcases hprev with h1 | hprev
      · omega
      · by_cases h0 : p.2 - 1 = 0
        · omega
        · have := ih1 _ hprev h0 hH
          simp only at this
          omega
    have h2 : ∀ p ∈ (K.round G).rs, p ∉ P₀.rs →
        p.1 ∉ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst → p.2 ≤ t + 1 := by
      intro p hp hn hH
      rcases mem_round_rs G K p hp with hp' | hc
      · have := ih2 p hp' hn hH; omega
      · exact hcall p hc hH
    refine ⟨?_, ?_, ?_⟩
    · intro p hp h0 hH
      rw [hKs] at hp
      rcases mem_round_hs G K p hp with hp' | hc | ⟨-, hnext, -⟩
      · have := ih1 p hp' h0 hH; omega
      · exact hcall p hc hH
      · have := ih1 _ hnext (by simp) hH
        simp only at this
        omega
    · rw [hKs]; exact h2
    · intro v hv
      rw [hKs, mem_round_labs] at hv
      rcases hv with (hv | ⟨p, hph, hpr, hb⟩) | hread
      · rcases ih3 v hv with h | h
        · exact Or.inl h
        · exact Or.inr (by omega)
      · by_cases hn : p ∈ P₀.rs
        · left
          unfold ChainKnow.seeds
          refine Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨p, hn, ?_⟩)
          have hne : p.2 ≠ ovCalls G p.1 := fun h => by rw [h, ovBlock_pad] at hb; simp at hb
          simp [hne, hb]
        · rcases ih3 v ((chain_invariant G P₀ t).2.2.1 p hpr hn v hb) with h | h
          · exact Or.inl h
          · exact Or.inr (by omega)
      · by_cases hn : (v, ovCalls G v) ∈ P₀.rs
        · left
          unfold ChainKnow.seeds
          exact Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨_, hn, by simp⟩)
        · by_cases hH : v ∈ (P₀.hs.filter fun q => q.2 ≠ 0).image Prod.fst
          · left
            unfold ChainKnow.seeds
            exact Finset.mem_union_left _ (Finset.mem_union_right _ hH)
          · exact Or.inr (h2 _ hread hn hH)

/-- **`ChainClock`, proved.** -/
theorem chain_clock : ChainClock := fun _ G P₀ t v hv => (clock_invariant G P₀ t).2.2 v hv

end Clock

/-! ## 2. The weighted chain certificate -/

/-- **`WeightedChainCert`, proved.** The known challenge labels are seeds or short rows, and there are at most `s`
seeds (`card_seeds_le_size`). -/
theorem weighted_chain_cert : WeightedChainCert := by
  intro N G VC c ℓ s D k hk P₀ hsize
  have hsub : VC.filter (fun v => v ∈ (ChainKnow.reach G P₀ D).labs) ⊆ P₀.seeds G ∪ shortRows G VC D := by
    intro v hv
    rw [Finset.mem_filter] at hv
    rcases chain_clock N G P₀ D v hv.2 with h | h
    · exact Finset.mem_union_left _ h
    · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hv.1, h⟩)
  have h1 := (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
  have h2 := (card_seeds_le_size G c ℓ P₀).trans hsize
  have h3 : ((VC.filter fun v => v ∈ (ChainKnow.reach G P₀ D).labs).card : ℚ) < k :=
    calc ((VC.filter fun v => v ∈ (ChainKnow.reach G P₀ D).labs).card : ℚ)
        ≤ ((P₀.seeds G).card : ℚ) + (shortRows G VC D).card := by exact_mod_cast h1
      _ ≤ s + (shortRows G VC D).card := by linarith
      _ < k := hk
  exact_mod_cast h3

section Rows

variable {N : ℕ}

/-- A row's call count is its in-degree plus the pad call. -/
theorem ovCalls_eq (G : TopoDAG N) (v : Fin N) : ovCalls G v = (G.par v).card + 1 := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]

/-- Node `v` has at most `v` parents. -/
theorem card_par_le (G : TopoDAG N) (v : Fin N) : (G.par v).card ≤ v.val := by
  calc (G.par v).card ≤ (Finset.range v.val).card :=
        Finset.card_le_card_of_injOn (fun u => u.val)
          (fun u hu => Finset.mem_range.2 (Fin.lt_def.1 (G.par_lt v u hu)))
          (fun a _ b _ h => Fin.ext h)
    _ = v.val := Finset.card_range _

/-- **Short rows are among the first `D`** when every node from `D` on has its `D` predecessors as parents. -/
theorem card_shortRows_le (G : TopoDAG N) (D : ℕ)
    (hG : ∀ v : Fin N, D ≤ v.val → ∀ u : Fin N, u < v → v.val ≤ u.val + D → u ∈ G.par v) :
    (shortRows G Finset.univ D).card ≤ D := by
  have hsub : shortRows G Finset.univ D ⊆ Finset.univ.filter fun v : Fin N => v.val < D := by
    intro v hv
    simp only [shortRows, Finset.mem_filter, Finset.mem_univ, true_and] at hv ⊢
    by_contra h
    have hD : D ≤ v.val := by omega
    have : D ≤ (G.par v).card :=
      Finset.le_card_of_inj_on_range (fun i => (⟨v.val - 1 - i, by omega⟩ : Fin N))
        (fun i hi => hG v hD _ (Fin.lt_def.2 (by simp only; omega)) (by simp only; omega))
        (fun i hi j hj h => by simp only [Fin.mk.injEq] at h; omega)
    rw [ovCalls_eq] at hv
    omega
  refine (Finset.card_le_card hsub).trans ?_
  calc (Finset.univ.filter fun v : Fin N => v.val < D).card ≤ (Finset.range D).card :=
        Finset.card_le_card_of_injOn (fun v => v.val)
          (fun v hv => Finset.mem_range.2 (Finset.mem_filter.1 hv).2) (fun a _ b _ h => Fin.ext h)
    _ = D := Finset.card_range _

/-- **The first `D` rows are short** when `D ≤ N`: row `v < D` has at most `v + 1 ≤ D` calls. -/
theorem le_card_shortRows (G : TopoDAG N) (D : ℕ) (hDN : D ≤ N) : D ≤ (shortRows G Finset.univ D).card := by
  rcases Nat.eq_zero_or_pos D with hD0 | hDpos
  · omega
  have hN : 0 < N := by omega
  refine Finset.le_card_of_inj_on_range (fun i => (⟨i % N, Nat.mod_lt _ hN⟩ : Fin N)) (fun i hi => ?_)
    (fun i hi j hj h => ?_)
  · simp only [shortRows, Finset.mem_filter, Finset.mem_univ, true_and]
    have h1 := card_par_le G ⟨i % N, Nat.mod_lt _ hN⟩
    have h2 := Nat.mod_le i N
    rw [ovCalls_eq]
    simp only at h1
    omega
  · simp only [Fin.mk.injEq] at h
    rwa [Nat.mod_eq_of_lt (by omega : i < N), Nat.mod_eq_of_lt (by omega : j < N)] at h

end Rows

/-- The band with `d ≥ D` gives every node from `D` on its `D` predecessors as parents. -/
theorem band_has_preds (B d D : ℕ) (hd : D ≤ d) :
    ∀ v : Fin B, D ≤ v.val → ∀ u : Fin B, u < v → v.val ≤ u.val + D → u ∈ (bandDAG B d).par v :=
  fun _ _ _ huv hle => Finset.mem_filter.2 ⟨Finset.mem_univ _, huv, by omega⟩

/-- **The band with `d ≥ D` has exactly `D` short rows** (rows `0 … D − 1`), dense's loss. -/
theorem card_shortRows_band (B d D : ℕ) (hd : D ≤ d) (hDB : D ≤ B) :
    (shortRows (bandDAG B d) Finset.univ D).card = D :=
  le_antisymm (card_shortRows_le _ D (band_has_preds B d D hd)) (le_card_shortRows _ D hDB)

/-- **`BandChainHard`, proved.** -/
theorem band_chain_hard : BandChainHard := by
  intro B d D c ℓ hd hB
  refine weighted_chain_cert B (bandDAG B d) Finset.univ c ℓ _ D B ?_
  have hc := card_shortRows_band B d D hd (by omega)
  have h : B - D - 1 + (shortRows (bandDAG B d) Finset.univ D).card < B := by omega
  exact_mod_cast h

/-- **The same certificate reproduces `chainDense_hard`**: the complete DAG also has exactly `D` short rows. -/
theorem chainDense_hard_of_clock (B D c ℓ : ℕ) (hD : D + 1 ≤ B) :
    ChainHard (Dense.completeDAG B) Finset.univ c ℓ ((B - D - 1 : ℕ) : ℚ) D B := by
  refine weighted_chain_cert B (Dense.completeDAG B) Finset.univ c ℓ _ D B ?_
  have hc := card_shortRows_le (Dense.completeDAG B) D
    (fun _ _ _ huv _ => Finset.mem_filter.2 ⟨Finset.mem_univ _, huv⟩)
  have h : B - D - 1 + (shortRows (Dense.completeDAG B) Finset.univ D).card < B := by omega
  exact_mod_cast h

/-! ## 3. The gap attack: `d ≥ D` and `D + 1 ≤ B` are necessary -/

section Attack

variable {N : ℕ}

theorem reach_labs_succ (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) :
    (ChainKnow.reach G P₀ t).labs ⊆ (ChainKnow.reach G P₀ (t + 1)).labs :=
  labs_subset_round G _

theorem reach_labs_mono (G : TopoDAG N) (P₀ : ChainKnow N) {t t' : ℕ} (h : t ≤ t') :
    (ChainKnow.reach G P₀ t).labs ⊆ (ChainKnow.reach G P₀ t').labs := by
  induction h with
  | refl => exact le_rfl
  | step _ ih => exact ih.trans (reach_labs_succ G P₀ _)

theorem held_subset_reach (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) :
    P₀.labs ⊆ (ChainKnow.reach G P₀ t).labs :=
  Finset.Subset.trans (fun v hv => (mem_read_labs G P₀ v).2 (Or.inl hv)) (reach_labs_mono G P₀ (Nat.zero_le t))

/-- A call that can be made is made: its `h` and `r` are known after the round. -/
theorem mem_round_of_canCall (G : TopoDAG N) (K : ChainKnow N) (v : Fin N) (j : ℕ) (hc : K.canCall G v j)
    (hj : j < N + 2) : (v, j) ∈ (K.round G).hs ∧ (v, j) ∈ (K.round G).rs := by
  have hpos : (v, j) ∈ ovPos N := Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 hj⟩
  simp only [ChainKnow.round, ChainKnow.read, Finset.mem_union, Finset.mem_filter]
  exact ⟨Or.inr ⟨hpos, Or.inl hc⟩, Or.inr ⟨hpos, hc⟩⟩

/-- **A row whose parents are all held runs one call per round**: call `j` is made in round `j`. -/
theorem row_progress (G : TopoDAG N) (P₀ : ChainKnow N) (v : Fin N) (hpar : G.par v ⊆ P₀.labs) :
    ∀ j, 1 ≤ j → j ≤ ovCalls G v →
      (v, j) ∈ (ChainKnow.reach G P₀ j).hs ∧ (v, j) ∈ (ChainKnow.reach G P₀ j).rs := by
  intro j
  induction j with
  | zero => intro h; omega
  | succ j ih =>
    intro _ hj
    have hN : j + 1 < N + 2 := by
      have := card_par_le G v
      have := v.isLt
      rw [ovCalls_eq] at hj
      omega
    refine mem_round_of_canCall G _ v (j + 1) ⟨by omega, hj, ?_, ?_⟩ hN
    · intro u hu
      have hmem : u ∈ parentsDesc G v := List.mem_of_getElem? hu
      exact held_subset_reach G P₀ j (hpar ((Finset.mem_sort _).1 hmem))
    · rcases Nat.eq_zero_or_pos j with h0 | hpos
      · left; omega
      · right; simpa using (ih hpos (by omega)).1

/-- **Such a row's label is known after `ovCalls G v` rounds.** -/
theorem row_label (G : TopoDAG N) (P₀ : ChainKnow N) (v : Fin N) (hpar : G.par v ⊆ P₀.labs) :
    v ∈ (ChainKnow.reach G P₀ (ovCalls G v)).labs := by
  have h1 : 1 ≤ ovCalls G v := by rw [ovCalls_eq]; omega
  obtain ⟨j, hj⟩ : ∃ j, ovCalls G v = j + 1 := ⟨ovCalls G v - 1, by omega⟩
  have hr := (row_progress G P₀ v hpar (ovCalls G v) h1 le_rfl).2
  rw [hj] at hr ⊢
  exact (mem_round_labs G _ v).2 (Or.inr (by rw [hj]; exact hr))

/-- A label-only holding is priced at its label count. -/
theorem size_labels (c ℓ : ℕ) (H : Finset (Fin N)) :
    ChainKnow.size c ℓ (⟨H, ∅, ∅⟩ : ChainKnow N) = H.card := by
  simp [ChainKnow.size]

/-- If a holding priced at most `s` knows every label after `D` rounds, `G` is not `(s, D, N)`-hard. -/
theorem not_hard_of_all (G : TopoDAG N) (c ℓ : ℕ) (s : ℚ) (D : ℕ) (P₀ : ChainKnow N)
    (hsize : P₀.size c ℓ ≤ s) (hall : ∀ v, v ∈ (ChainKnow.reach G P₀ D).labs) :
    ¬ ChainHard G Finset.univ c ℓ s D N := by
  intro h
  have := h P₀ hsize
  rw [Finset.filter_true_of_mem fun v _ => hall v, Finset.card_univ, Fintype.card_fin] at this
  exact lt_irrefl _ this

end Attack

/-- In the band, node `v` has at most `d` parents. -/
theorem card_par_band_le (B d : ℕ) (v : Fin B) : ((bandDAG B d).par v).card ≤ d := by
  calc ((bandDAG B d).par v).card ≤ (Finset.Ico (v.val - d) v.val).card :=
        Finset.card_le_card_of_injOn (fun u => u.val)
          (fun u hu => by
            have := (Finset.mem_filter.1 hu).2
            rw [Fin.lt_def] at this
            simp only [Finset.coe_Ico, Set.mem_Ico]
            omega)
          (fun a _ b _ h => Fin.ext h)
    _ ≤ d := by rw [Nat.card_Ico]; omega

/-- **`BandGapAttack`, proved.** With `d + 1 ≤ D`, drop the positive multiples of `d + 1`: each dropped row has its
`≤ d` parents held (no two multiples are within `d`), so it finishes within `d + 1 ≤ D` rounds. -/
theorem band_gap_attack : BandGapAttack := by
  intro B d D c ℓ hdD
  classical
  rcases Nat.eq_zero_or_pos B with hB0 | hBpos
  · subst hB0
    intro h
    exact Nat.not_lt_zero _ (h ⟨∅, ∅, ∅⟩ (by rw [size_labels]; simp))
  set H : Finset (Fin B) := Finset.univ.filter fun v => ¬ (0 < v.val ∧ (d + 1) ∣ v.val) with hH
  have hlt : ∀ k, k < (B - 1) / (d + 1) → (d + 1) * (k + 1) < B := by
    intro k hk
    have h1 : (d + 1) * (k + 1) ≤ (d + 1) * ((B - 1) / (d + 1)) := Nat.mul_le_mul_left _ (by omega)
    have h2 : (d + 1) * ((B - 1) / (d + 1)) ≤ B - 1 := Nat.mul_div_le _ _
    omega
  have hHc : H.card ≤ B - (B - 1) / (d + 1) := by
    have hM : (B - 1) / (d + 1) ≤ (Finset.univ.filter fun v : Fin B => 0 < v.val ∧ (d + 1) ∣ v.val).card := by
      refine Finset.le_card_of_inj_on_range
        (fun i => if h : (d + 1) * (i + 1) < B then (⟨(d + 1) * (i + 1), h⟩ : Fin B) else ⟨0, hBpos⟩)
        (fun i hi => ?_) (fun i hi j hj h => ?_)
      · simp only [hlt i hi, dite_true, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨by positivity, Dvd.intro _ rfl⟩
      · simp only [hlt i hi, hlt j hj, dite_true, Fin.mk.injEq] at h
        have := Nat.eq_of_mul_eq_mul_left (by omega : 0 < d + 1) h
        omega
    have hsplit : (Finset.univ.filter fun v : Fin B => 0 < v.val ∧ (d + 1) ∣ v.val).card + H.card = B := by
      have := Finset.card_filter_add_card_filter_not
        (s := (Finset.univ : Finset (Fin B))) (fun v : Fin B => 0 < v.val ∧ (d + 1) ∣ v.val)
      rw [Finset.card_univ, Fintype.card_fin] at this
      rw [hH]
      convert this using 3
    omega
  refine not_hard_of_all (bandDAG B d) c ℓ _ D ⟨H, ∅, ∅⟩ ?_ ?_
  · rw [size_labels]; exact_mod_cast hHc
  · intro v
    by_cases hv : v ∈ H
    · exact held_subset_reach _ _ D hv
    · have hvm : 0 < v.val ∧ (d + 1) ∣ v.val := by
        simpa [hH] using hv
      have hpar : (bandDAG B d).par v ⊆ H := by
        intro u hu
        have hu' := (Finset.mem_filter.1 hu).2
        rw [Fin.lt_def] at hu'
        simp only [hH, Finset.mem_filter, Finset.mem_univ, true_and]
        rintro ⟨-, hdu⟩
        have hdvd : (d + 1) ∣ v.val - u.val := Nat.dvd_sub hvm.2 hdu
        have := Nat.le_of_dvd (by omega) hdvd
        omega
      have hcalls : ovCalls (bandDAG B d) v ≤ D := by
        rw [ovCalls_eq]; have := card_par_band_le B d v; omega
      exact reach_labs_mono _ _ hcalls (row_label _ ⟨H, ∅, ∅⟩ v hpar)

/-- Hardness weakens as the storage bound shrinks. -/
theorem ChainHard.mono {N : ℕ} {G : TopoDAG N} {VC : Finset (Fin N)} {c ℓ : ℕ} {s s' : ℚ} {D k : ℕ}
    (h : ChainHard G VC c ℓ s D k) (hs : s' ≤ s) : ChainHard G VC c ℓ s' D k :=
  fun P₀ hP => h P₀ (hP.trans hs)

/-- **`BandGapAttack512`, proved**: the gap attack costs 410 labels, below the 506 dense-level hardness allows. -/
theorem band_gap_attack_512 : BandGapAttack512 := by
  intro c ℓ h
  exact band_gap_attack 512 4 5 c ℓ (by norm_num) (ChainHard.mono h (by norm_num))

/-- **`BandNeedsRoom`, proved**: with `B = 1`, the lone row has no parent and is one call. -/
theorem band_needs_room : BandNeedsRoom := by
  intro c ℓ
  refine not_hard_of_all (bandDAG 1 1) c ℓ _ 1 ⟨∅, ∅, ∅⟩ (by rw [size_labels]; simp) ?_
  intro v
  have hpar : (bandDAG 1 1).par v ⊆ (∅ : Finset (Fin 1)) := by
    intro u hu
    have := (Finset.mem_filter.1 hu).2.1
    rw [Fin.lt_def] at this
    omega
  have hcalls : ovCalls (bandDAG 1 1) v ≤ 1 := by
    rw [ovCalls_eq]; have := card_par_le (bandDAG 1 1) v; omega
  exact reach_labs_mono _ _ hcalls (row_label _ ⟨∅, ∅, ∅⟩ v hpar)

/-! ## 4. The scheme, the specialization to `ChainExPostFacto`, and `Meets` -/

section Scheme

variable {N ℓ c : ℕ}

theorem labelG_eq (G : TopoDAG N) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin N → Bits ℓ) (v : Fin N) :
    labelG G f dom Wb v = bxor (ovKey f (dom v) (absorbedG G (labelG G f dom Wb) v)) (Wb v) := by
  rw [labelG]
  unfold absorbedG
  rw [List.attach_map_val]

/-- Bit-exact public decoding on any DAG. -/
theorem chainScheme_correct {B : ℕ} [NeZero B] (G : TopoDAG B) (ℓ c : ℕ) (dom : ℕ → Bits c) :
    (chainScheme G ℓ c dom).Correct := by
  intro W π r
  let f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c)) := fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)
  show codeEquiv B ℓ (fun i => bxor (labelG G f dom (Dense.blocks B ℓ W) i)
    (ovKey f (dom i) (absorbedG G (labelG G f dom (Dense.blocks B ℓ W)) i))) = W
  have h : ∀ i, bxor (labelG G f dom (Dense.blocks B ℓ W) i)
      (ovKey f (dom i) (absorbedG G (labelG G f dom (Dense.blocks B ℓ W)) i)) = Dense.blocks B ℓ W i := by
    intro i
    rw [labelG_eq]
    exact bxor_self_left _ _
  rw [funext h]
  exact (codeEquiv B ℓ).apply_symm_apply W

/-- **Honest cost.** Decoding a block is one forward `Π₂` query per absorbed block, `ovCalls G v` in all. -/
theorem depth_rowKey (G : TopoDAG N) (f : (idealPerm (ℓ + (ℓ + c))).Qry → (idealPerm (ℓ + (ℓ + c))).Ans)
    (dom : ℕ → Bits c) (C : Fin N → Bits ℓ) (v : Fin N) :
    (ovProg ((fun _ => false), iv (dom v)) (absorbedG G C v)).depth f = ovCalls G v := by
  rw [depth_ovProg, absorbedG, List.length_append, List.length_map, List.length_singleton]
  rfl

/-- In the band, node `v` has exactly `min(v, d)` parents. -/
theorem card_par_band (B d : ℕ) (v : Fin B) : ((bandDAG B d).par v).card = min v.val d := by
  refine le_antisymm (le_min (card_par_le _ v) (card_par_band_le B d v)) ?_
  refine Finset.le_card_of_inj_on_range (fun i => (⟨v.val - 1 - i, by omega⟩ : Fin B)) (fun i hi => ?_)
    (fun i hi j hj h => ?_)
  · have := min_le_left v.val d
    have := min_le_right v.val d
    exact Finset.mem_filter.2 ⟨Finset.mem_univ _, Fin.lt_def.2 (by simp only; omega), by simp only; omega⟩
  · have := min_le_left v.val d
    simp only [Fin.mk.injEq] at h
    omega

/-- **The band's decode cost: block `v` is `min(v, d) + 1` sequential `Π₂` calls** (6 at `d = 5`, 13 at `d = 12`),
against dense's `v + 1` (`depth_blockKeyOv`). -/
theorem depth_bandKey (B d : ℕ) (f : (idealPerm (ℓ + (ℓ + c))).Qry → (idealPerm (ℓ + (ℓ + c))).Ans)
    (dom : ℕ → Bits c) (C : Fin B → Bits ℓ) (v : Fin B) :
    (ovProg ((fun _ => false), iv (dom v)) (absorbedG (bandDAG B d) C v)).depth f = min v.val d + 1 := by
  rw [depth_rowKey, ovCalls_eq, card_par_band]

end Scheme

/-- On the complete DAG, the parents newest first are `v − 1, …, 0`. -/
theorem parentsDesc_complete {B : ℕ} (v : Fin B) :
    parentsDesc (Dense.completeDAG B) v =
      List.ofFn fun j : Fin v.val => (⟨v.val - 1 - j.val, by omega⟩ : Fin B) := by
  apply List.Perm.eq_of_pairwise' (r := fun a b : Fin B => b ≤ a)
  · exact Finset.pairwise_sort _ _
  · rw [List.pairwise_ofFn]
    intro i j hij
    rw [Fin.lt_def] at hij
    simp only [Fin.le_def]
    omega
  · refine List.perm_of_nodup_nodup_toFinset_eq (Finset.sort_nodup _ _) ?_ ?_
    · rw [List.nodup_ofFn]
      intro i j h
      simp only [Fin.mk.injEq] at h
      exact Fin.ext (by omega)
    · unfold parentsDesc
      rw [Finset.sort_toFinset]
      ext u
      simp only [Dense.completeDAG, Finset.mem_filter, Finset.mem_univ, true_and, List.mem_toFinset,
        List.mem_ofFn, Fin.lt_def]
      constructor
      · intro hu
        exact ⟨⟨v.val - 1 - u.val, by omega⟩, Fin.ext (by simp only; omega)⟩
      · rintro ⟨j, rfl⟩
        simp only
        omega

/-- **`labelG` on the complete DAG is `labelOv`.** -/
theorem labelG_complete {B ℓ c : ℕ} (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin B → Bits ℓ) : ∀ v, labelG (Dense.completeDAG B) f dom Wb v = labelOv f dom Wb v := by
  intro v
  induction v using WellFoundedLT.induction with
  | _ v ih =>
    have habs : absorbedG (Dense.completeDAG B) (labelG (Dense.completeDAG B) f dom Wb) v =
        absorbed (labelOv f dom Wb) v := by
      unfold absorbedG absorbed parentsNF
      rw [parentsDesc_complete, List.map_ofFn]
      congr 1
      refine List.ofFn_inj.2 (funext fun j => ?_)
      exact ih _ (Fin.lt_def.2 (by simp only; omega))
    rw [labelG_eq, labelOv_eq, habs]

/-- **`ChainExPostFactoGSpec`, proved**: at the complete DAG, `ChainExPostFactoG` is `ChainExPostFacto`. -/
theorem chainExPostFactoG_spec : ChainExPostFactoGSpec := by
  intro h B ℓ c m s D Q k dom Wb hdom hhard A₁ A₂ hA
  have := h B ℓ c m s D Q k (Dense.completeDAG B) dom Wb hdom hhard A₁ A₂ hA
  simpa only [labelG_complete] using this

/-- **`BandTimedINC`, proved** (conditional on `ChainExPostFactoG`, by its statement): the port of `chain_timedINC`,
with `band_chain_hard` in place of `chainDense_hard`. -/
theorem band_timedINC : BandTimedINC := by
  intro hepf B d ℓ c D Q β _ dom hd hD hdom
  classical
  intro W cmp exp hexp
  have hE := hepf B ℓ c β (B - D - 1) D Q B (bandDAG B d) dom (Dense.blocks B ℓ W) hdom
    (band_chain_hard B d D c ℓ hd hD)
    (fun π => cmp W (fun i => i.elim0)
      (fun i => labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom
        (Dense.blocks B ℓ W) i) π)
    (fun σ i => exp W (fun i => i.elim0) σ i) (fun σ i => hexp W _ σ i)
  refine le_trans (le_of_eq_of_le (PousThm1Dense.pr_fst (β := Unit)
    (fun π : Equiv.Perm (Bits (ℓ + (ℓ + c))) =>
      ∀ i, (exp W (fun i => i.elim0)
        (cmp W (fun i => i.elim0)
          (fun i => labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom
            (Dense.blocks B ℓ W) i) π)
        i).run ((idealPerm (ℓ + (ℓ + c))).answer π) =
        labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom (Dense.blocks B ℓ W) i))
    (pr_mono fun π hH => ?_)) hE
  refine le_trans (le_of_eq (by rw [Finset.card_univ, Fintype.card_fin]))
    (Finset.card_le_card (s := Finset.univ) fun c _ => Finset.mem_filter.2 ⟨Finset.mem_univ _, hH c⟩)

/-- `⌊ρ·|C|⌋ = 254307274` at `|C| = 2^9·524288 = 2^28`, as for dense. -/
theorem stateBound_band_64 (d : ℕ) (dom : ℕ → Bits 512) :
    (chainBand (2 ^ 9) d 524288 512 dom).stateBound Params.ρ = 254307274 := by
  show ⌊Params.ρ * (((2 ^ 9) * 524288 : ℕ) : ℚ)⌋₊ = 254307274
  rw [Nat.floor_eq_iff (by norm_num [Params.ρ])]
  norm_num [Params.ρ]

/-- **`BandMeets64`, proved** (conditional on `ChainExPostFactoG`, by its statement): for every `d ≥ 5` the band meets
the requirement at the dense chain deployment point, with dense's certificate terms `chain_union_term_64` and
`chain_sampling_term_64` verbatim (`β = 265253616`, `k = 111`). -/
theorem band_meets_64 : BandMeets64 := by
  intro hepf d hd salt
  refine ⟨le_rfl, chainScheme_correct _ _ _ _, le_rfl, ?_, ?_⟩
  · show ((((2 ^ 9) * 524288 + 0 : ℕ)) : ℚ) ≤ Pous.Params.expansion * (((2 ^ 9) * 524288 : ℕ) : ℚ)
    norm_num [Pous.Params.expansion]
  · intro W A₁ A₂
    have hINC := band_timedINC hepf (2 ^ 9) d 524288 512 5 (2 ^ 20) 265253616 (Pous.Sponge.dom salt) hd
      (by norm_num) (dom_inj salt (by norm_num))
    refine (PousTargetsDense.theorem1_ii_seq (chainBand (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)) 5 (2 ^ 20)
      265253616 ((chainBand (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)).stateBound Pous.Params.ρ) 111 _
      hINC W A₁ A₂).trans ?_
    rw [stateBound_band_64, add_comm]
    exact add_le_add chain_sampling_term_64 chain_union_term_64

/-! ## 5. Satisfiability witnesses, and the cliff -/

/-- **Witness for `BandChainHard`'s hypotheses** at the deployment point `B = 512`, `d = D = 5`. The conclusion is
tight: `k = B = |univ|`. -/
theorem band_hard_512 (c ℓ : ℕ) :
    ChainHard (bandDAG 512 5) Finset.univ c ℓ ((512 - 5 - 1 : ℕ) : ℚ) 5 512 :=
  band_chain_hard 512 5 5 c ℓ le_rfl (by norm_num)

/-- The recommended in-degree `d = 12` at `D = 5`. -/
theorem band_hard_512_d12 (c ℓ : ℕ) :
    ChainHard (bandDAG 512 12) Finset.univ c ℓ ((512 - 5 - 1 : ℕ) : ℚ) 5 512 :=
  band_chain_hard 512 12 5 c ℓ (by norm_num) (by norm_num)

/-- **Witness for `WeightedChainCert`'s hypothesis** at the deployment point: exactly 5 short rows, and
`506 + 5 < 512`, one below the bound, so the certificate is used at full strength. -/
theorem shortRows_512 : (shortRows (bandDAG 512 5) Finset.univ 5).card = 5 :=
  card_shortRows_band 512 5 5 le_rfl (by norm_num)

theorem weighted_cert_hyp_512 :
    ((512 - 5 - 1 : ℕ) : ℚ) + (shortRows (bandDAG 512 5) Finset.univ 5).card < ((512 : ℕ) : ℚ) := by
  rw [shortRows_512]; norm_num

/-- **Witness for `ChainExPostFactoG`'s domain hypothesis** at the deployment point (`dom salt` is injective on
`Fin 512`), with `band_hard_512` its hardness hypothesis. -/
theorem dom_inj_512 (salt : Bits 256) : Function.Injective (fun i : Fin (2 ^ 9) => Pous.Sponge.dom salt i.val) :=
  dom_inj salt (by norm_num)

/-- **Witnesses for `BandMeets64`'s `5 ≤ d`**: the deployment at `d = 5` and at the recommended `d = 12`. -/
theorem band_meets_64_d5 (hepf : ChainExPostFactoG) : ChainBandMeets64 5 := band_meets_64 hepf 5 le_rfl

theorem band_meets_64_d12 (hepf : ChainExPostFactoG) : ChainBandMeets64 12 :=
  band_meets_64 hepf 12 (by norm_num)

/-- **The cliff at `D = d + 1`.** One round more than the in-degree breaks dense-level hardness: at `d = 5`, `D = 6`
the gap attack costs `512 − 85 = 427` labels, below the `505` that hardness allows. -/
theorem band_cliff_d5 (c ℓ : ℕ) :
    ¬ ChainHard (bandDAG 512 5) Finset.univ c ℓ ((512 - 6 - 1 : ℕ) : ℚ) 6 512 :=
  fun h => band_gap_attack 512 5 6 c ℓ le_rfl (ChainHard.mono h (by norm_num))

/-- **The margin at `d = 12`**: dense-level hardness for every `D ≤ 12`. -/
theorem band_d12_margin (c ℓ D : ℕ) (hD : D ≤ 12) :
    ChainHard (bandDAG 512 12) Finset.univ c ℓ ((512 - D - 1 : ℕ) : ℚ) D 512 :=
  band_chain_hard 512 12 D c ℓ hD (by omega)

/-- **And its cliff at `D = 13`**: the gap attack costs `512 − 39 = 473` labels, below the `498` allowed. -/
theorem band_cliff_d12 (c ℓ : ℕ) :
    ¬ ChainHard (bandDAG 512 12) Finset.univ c ℓ ((512 - 13 - 1 : ℕ) : ℚ) 13 512 :=
  fun h => band_gap_attack 512 12 13 c ℓ le_rfl (ChainHard.mono h (by norm_num))

end Pous.BandChain

end


/-! ════ ChainEPFCore ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFacto` framework — locality layer (foundation for Part B/C)

The overwrite chain's labeller makes only forward `Π₂` queries. `ovInputs` lists the inputs it asks while absorbing a
block list, and `ovAbsorb_congr`/`ovKey_congr` are the locality facts the replay decoder needs: the chain's output and
its own query list depend on the permutation only at the inputs it actually asks. `labelOv_congr` lifts this to block
labels over the complete DAG. Everything here is stdlib/`SpongeDense` only and self-contained.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

variable {r c : ℕ}

/-- The forward-query inputs the overwrite chain asks while absorbing `blks` from the running pair `p`. -/
def ovInputs (f : Bits (r + (r + c)) → Bits (r + (r + c))) :
    Bits r × Bits (r + c) → List (Bits r) → List (Bits (r + (r + c)))
  | _, [] => []
  | p, blk :: blks => Fin.append blk p.2 :: ovInputs f (ovStep f p blk) blks

/-- One overwrite step reads the permutation only at its single input `blk ‖ h`. -/
theorem ovStep_congr {f g : Bits (r + (r + c)) → Bits (r + (r + c))} {p : Bits r × Bits (r + c)} {blk : Bits r}
    (h : g (Fin.append blk p.2) = f (Fin.append blk p.2)) : ovStep g p blk = ovStep f p blk := by
  simp only [ovStep, h]

/-- **Locality of the chain.** If `g` agrees with `f` on the inputs `f` asks, the fold and the input list agree. -/
theorem ovAbsorb_congr {f g : Bits (r + (r + c)) → Bits (r + (r + c))} :
    ∀ (p : Bits r × Bits (r + c)) (blks : List (Bits r)),
      (∀ x ∈ ovInputs f p blks, g x = f x) →
      blks.foldl (ovStep g) p = blks.foldl (ovStep f) p ∧ ovInputs g p blks = ovInputs f p blks
  | _, [], _ => ⟨rfl, rfl⟩
  | p, blk :: blks, hagree => by
      have hhead : g (Fin.append blk p.2) = f (Fin.append blk p.2) :=
        hagree _ (by simp [ovInputs])
      have hstep : ovStep g p blk = ovStep f p blk := ovStep_congr hhead
      have htail : ∀ x ∈ ovInputs f (ovStep f p blk) blks, g x = f x := fun x hx =>
        hagree x (by rw [ovInputs]; exact List.mem_cons_of_mem _ hx)
      obtain ⟨hfold, hin⟩ := ovAbsorb_congr (ovStep f p blk) blks htail
      refine ⟨?_, ?_⟩
      · rw [List.foldl_cons, List.foldl_cons, hstep, hfold]
      · rw [ovInputs, ovInputs, hstep, hin]

/-- **Key locality.** `ovKey` reads the permutation only at the inputs of its own absorb chain. -/
theorem ovKey_congr {f g : Bits (r + (r + c)) → Bits (r + (r + c))} (dom : Bits c) (blks : List (Bits r))
    (h : ∀ x ∈ ovInputs f (fun _ => false, iv dom) blks, g x = f x) :
    ovKey g dom blks = ovKey f dom blks := by
  unfold ovKey ovAbsorb
  rw [(ovAbsorb_congr (fun _ => false, iv dom) blks h).1]

/-- The parents-newest-first list reads `C` only at earlier blocks. -/
theorem parentsNF_congr {B ℓ : ℕ} {C C' : Fin B → Bits ℓ} (i : Fin B) (h : ∀ j : Fin B, j < i → C' j = C j) :
    parentsNF C' i = parentsNF C i := by
  unfold parentsNF
  congr 1
  funext j
  exact h _ (by simp only [Fin.lt_def]; omega)

/-- **Block-label locality.** If `g` agrees with `f` on the forward inputs of the chains of all blocks `≤ i`, then the
overwrite-chain labels agree at `i`. Lifts `ovKey_congr` over the complete-DAG recursion, like B5's `label_congr`. -/
theorem labelOv_congr {B ℓ c : ℕ} {f g : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))} (dom : ℕ → Bits c)
    (Wb : Fin B → Bits ℓ) (i : Fin B)
    (h : ∀ j : Fin B, j ≤ i →
      ∀ x ∈ ovInputs f (fun _ => false, iv (dom j.val)) (absorbed (labelOv f dom Wb) j), g x = f x) :
    labelOv g dom Wb i = labelOv f dom Wb i := by
  induction i using WellFoundedLT.induction with
  | _ i ih =>
    have hlt : ∀ j : Fin B, j < i → labelOv g dom Wb j = labelOv f dom Wb j := by
      intro j hj
      exact ih j hj fun j' hj' => h j' (le_trans hj' hj.le)
    have habs : absorbed (labelOv g dom Wb) i = absorbed (labelOv f dom Wb) i := by
      unfold absorbed
      rw [parentsNF_congr i fun j hj => hlt j hj]
    rw [labelOv_eq, labelOv_eq, habs, ovKey_congr (dom i.val) (absorbed (labelOv f dom Wb) i) (h i le_rfl)]

end PousSpongeChain

end


/-! ════ ChainEPFGraph ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFactoG` — the DAG-generic locality layer

Generalizes `ChainEPFCore`'s complete-DAG `parentsNF_congr`/`labelOv_congr` to an arbitrary `G : TopoDAG B`: block `v`'s
absorb chain is `(parentsDesc G v).map (labelG G f) ++ [padBlk]`, i.e. the labels of `G`'s parents (newest first) then the
pad. `labelG_congr` lifts `ovKey_congr` over the DAG recursion; `parentsDesc_lt`/`parentsDesc_length_le` bound the parent
lists. Everything else in the framework reads the honest chain through these, so the only change to generalize from the
complete DAG is to route `parentsNF (labelOv …)` and `absorbed (labelOv …)` through `parentsDesc G`/`absorbedG G`/`labelG G`.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

variable {N ℓ c : ℕ}

/-- A parent index is strictly earlier (topological order). -/
theorem parentsDesc_lt (G : TopoDAG N) {v u : Fin N} (hu : u ∈ parentsDesc G v) : u < v :=
  G.par_lt v u ((Finset.mem_sort _).1 hu)

/-- Block `v` has at most `v` parents (they are all earlier). -/
theorem parentsDesc_length_le (G : TopoDAG N) (v : Fin N) : (parentsDesc G v).length ≤ v.val := by
  rw [parentsDesc, Finset.length_sort]
  refine le_trans (Finset.card_le_card (fun u hu => Finset.mem_Iio.2 (G.par_lt v u hu))) ?_
  simp [Fin.card_Iio]

/-- **The recursion unfolds** to `key(IV(dom v); labels of parents, pad) ⊕ W_v`. -/
theorem labelG_eq (G : TopoDAG N) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin N → Bits ℓ) (v : Fin N) :
    labelG G f dom Wb v = bxor (ovKey f (dom v) (absorbedG G (labelG G f dom Wb) v)) (Wb v) := by
  rw [labelG]
  unfold absorbedG
  rw [List.attach_map_val]

/-- **Block-label locality on any DAG.** If `g` agrees with `f` on the forward inputs of the chains of all blocks `≤ v`,
the labels agree at `v`. The DAG-generic form of `labelOv_congr`. -/
theorem labelG_congr {f g : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))} (G : TopoDAG N) (dom : ℕ → Bits c)
    (Wb : Fin N → Bits ℓ) (v : Fin N)
    (h : ∀ u : Fin N, u ≤ v →
      ∀ x ∈ ovInputs f (fun _ => false, iv (dom u.val)) (absorbedG G (labelG G f dom Wb) u), g x = f x) :
    labelG G g dom Wb v = labelG G f dom Wb v := by
  induction v using WellFoundedLT.induction with
  | _ v ih =>
    have hlt : ∀ u : Fin N, u < v → labelG G g dom Wb u = labelG G f dom Wb u := by
      intro u hu
      exact ih u hu fun u' hu' => h u' (le_trans hu' hu.le)
    have habs : absorbedG G (labelG G g dom Wb) v = absorbedG G (labelG G f dom Wb) v := by
      unfold absorbedG
      congr 1
      exact List.map_congr_left fun u hu => hlt u (parentsDesc_lt G hu)
    rw [labelG_eq, labelG_eq, habs, ovKey_congr (dom v.val) (absorbedG G (labelG G f dom Wb) v) (h v le_rfl)]

end PousSpongeChain

end


/-! ════ ChainEPFReplay ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFacto` framework — Part B, step 1: the pad-query view of a label

Each block's overwrite-chain label is the `r`-part of a single forward `Π₂` query, its **pad query**
`padInput f (dom i) (parents)`, whose input is the pad block next to the chaining value after the parents. `ovKey_pad`
and `labelOv_pad` expose this. This is the chain analogue of B5's `label_eq` (`label = H(realQ) ⊕ d`): it turns the
`i+1`-call chain into "one real query per block" for the freshness argument, with the parents handled by the game side
(`ChainKnow`/`chain_invariant`) in Part C.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

variable {r c : ℕ}

/-- The chaining value after absorbing `parents` from `IV(domi)` (before the pad call). -/
def chainState (f : Bits (r + (r + c)) → Bits (r + (r + c))) (domi : Bits c) (parents : List (Bits r)) :
    Bits (r + c) :=
  (ovAbsorb f (iv domi) parents).2

/-- The pad call's input: `padBlk ‖ chainState`. Its `r`-part under `f` is the key. -/
def padInput (f : Bits (r + (r + c)) → Bits (r + (r + c))) (domi : Bits c) (parents : List (Bits r)) :
    Bits (r + (r + c)) :=
  Fin.append padBlk (chainState f domi parents)

/-- **The key is one forward query.** `ovKey f domi (parents ++ pad) = ovR (f (padInput …))`. -/
theorem ovKey_pad (f : Bits (r + (r + c)) → Bits (r + (r + c))) (domi : Bits c) (parents : List (Bits r)) :
    ovKey f domi (parents ++ [padBlk]) = ovR (f (padInput f domi parents)) := by
  simp only [ovKey, ovAbsorb, padInput, chainState]
  rw [List.foldl_append, List.foldl_cons, List.foldl_nil]
  rfl

/-- The pad input of block `i` over the DAG `G` (parents = its labels, `parentsDesc` order). -/
def chainRealG {B ℓ : ℕ} (G : TopoDAG B) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin B → Bits ℓ) (i : Fin B) : Bits (ℓ + (ℓ + c)) :=
  padInput f (dom i.val) ((parentsDesc G i).map (labelG G f dom Wb))

/-- **Block label as one pad query.** `labelG G f dom Wb i = ovR (f (chainRealG …)) ⊕ Wb i`. -/
theorem labelG_pad {B ℓ : ℕ} (G : TopoDAG B) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin B → Bits ℓ) (i : Fin B) :
    labelG G f dom Wb i = bxor (ovR (f (chainRealG G f dom Wb i))) (Wb i) := by
  rw [labelG_eq]
  unfold absorbedG chainRealG
  rw [ovKey_pad]

end PousSpongeChain

end


/-! ════ ChainEPFTranscript ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFacto` framework — Part B, step 2: the transcript / prediction layer

Block-indexed predictions for the overwrite chain over `idealPerm`. Positions are thread query/guess slots plus the
labeller's pad query per block; `realAt` gives the input point a position reveals (forward `x`, inverse `π⁻¹ y`),
`obsKey` the ℓ-bit key it shows, and `cond`/`rel`/`Ev` the prediction pattern (each item names an observing position, a
revealing position, and a block). This mirrors B5's `Replay`/`Ev`, adapted to raw permutation queries via the
pad-query bridge `labelOv_pad`.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

/-- One chain-audit replay: the DAG, block domains, free words, the round/query budget, and the online programs. -/
structure ChainReplay (B ℓ c : ℕ) where
  G : TopoDAG B
  dom : ℕ → Bits c
  Wb : Fin B → Bits ℓ
  D : ℕ
  Q : ℕ
  P : Fin B → Prog (idealPerm (ℓ + (ℓ + c))) (Bits ℓ)

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- Positions: thread `i`'s query/guess slots, and the labeller's pad query for block `i`. -/
abbrev Pos : Type := (Fin B × Fin (R.Q + 1)) ⊕ Fin B

/-- Thread `i`'s transcript against `π`. -/
def tr (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) :
    List (ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))) :=
  PousB5Chain.trace ((idealPerm (ℓ + (ℓ + c))).answer π) (R.P i)

/-- The input point a query reveals about `π`: `x` for a forward `Π x`, `π⁻¹ y` for an inverse `Π⁻¹ y`. -/
def revealPt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))
  | .inl x => x
  | .inr y => π.symm y

/-- The ℓ-bit key a query **shows in the clear** (its input, per `NOTES.md` §6): the parent-label block `ovR x` fed to a
forward `Π x`, or the dropped `r = ovR y` chosen for an inverse `Π⁻¹ y`. Independent of `π` (it is a query payload). -/
def qKey : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits ℓ
  | .inl x => ovR x
  | .inr y => ovR y

/-- Block `i`'s real query point (its pad input). -/
def realPt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) : Bits (ℓ + (ℓ + c)) :=
  chainRealG R.G (fun x => π x) R.dom R.Wb i

/-- Block `i`'s key `= ovR (π (realPt i))`. -/
def keyAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) : Bits ℓ := ovR (π (R.realPt π i))

/-- The revealed point and round at a position (none for a guess slot). -/
def realAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.Pos → Option (Bits (ℓ + (ℓ + c)) × ℕ)
  | .inl (i, k) => if k.val < R.Q then ((R.tr π i)[k.val]?).map fun e => (revealPt π e.2, e.1) else none
  | .inr i => some (R.realPt π i, R.D + i.val)

/-- What a position shows: the ℓ-bit **label** and its round; a query slot shows its input's parent-label `ovR x`, a guess
slot shows the thread's output (its guess of the block's label). -/
def obsKey (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.Pos → Option (Bits ℓ × ℕ)
  | .inl (i, k) =>
      if k.val < R.Q then ((R.tr π i)[k.val]?).map fun e => (qKey e.2, e.1)
      else some ((R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π),
                 (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π))
  | .inr _ => none

/-- Some thread reveals point `z` at round `ρ`. -/
def askedPt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (z : Bits (ℓ + (ℓ + c))) (ρ : ℕ) : Prop :=
  ∃ i, ∃ e ∈ R.tr π i, e.1 = ρ ∧ revealPt π e.2 = z

/-- A prediction `(o, r, i)`: `r` reveals block `i`'s real point at round `κ`; `o` shows key `v` by round `τ ≤ κ`; the
real point is unasked before `κ`; and `i`'s key equals `v`. -/
def cond (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (t : R.Pos × R.Pos × Fin B) : Prop :=
  ∃ κ v τ, R.realAt π t.2.1 = some (R.realPt π t.2.2, κ) ∧ R.obsKey π t.1 = some (v, τ) ∧ τ ≤ κ ∧
    (∀ ρ < κ, ¬ R.askedPt π (R.realPt π t.2.2) ρ) ∧ R.keyAt π t.2.2 = v

/-- Two predictions concern different blocks and come in round order. -/
def rel (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (t t' : R.Pos × R.Pos × Fin B) : Prop :=
  ∀ κ κ', R.realAt π t.2.1 = some (R.realPt π t.2.2, κ) → R.realAt π t'.2.1 = some (R.realPt π t'.2.2, κ') →
    t.2.2 ≠ t'.2.2 ∧ κ ≤ κ'

/-- The pattern of predictions holds. -/
def Ev (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (φ : List (R.Pos × R.Pos × Fin B)) : Prop :=
  (∀ t ∈ φ, R.cond π t) ∧ φ.Pairwise (R.rel π)

theorem Ev_take {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {φ : List (R.Pos × R.Pos × Fin B)} (n : ℕ)
    (h : R.Ev π φ) : R.Ev π (φ.take n) :=
  ⟨fun t ht => h.1 t (List.mem_of_mem_take ht), h.2.sublist (List.take_sublist _ _)⟩

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFResample ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFacto` — the r-part-preserving resampling transposition (Ev_update core)

`resamp π z r'` swaps `π z` with `r' ‖ ovH (π z)`: it sets the r-part of `π` at `z` to `r'` while **keeping the
h-part**, so only ℓ bits move. These are the mechanical facts the `Ev_update` injection and its inverse need, all
self-contained.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

variable {r c : ℕ}

@[simp] theorem ovR_append (a : Bits r) (b : Bits (r + c)) : ovR (Fin.append a b) = a := by
  funext j; simp only [ovR, Fin.append_left]

@[simp] theorem ovH_append (a : Bits r) (b : Bits (r + c)) : ovH (Fin.append a b) = b := by
  funext j; simp only [ovH, Fin.append_right]

theorem append_ovR_ovH (o : Bits (r + (r + c))) : Fin.append (ovR o) (ovH o) = o := by
  funext i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;>
    simp only [Fin.append_left, Fin.append_right, ovR, ovH]

/-- Resample `π` at `z`, keeping the h-part of `π z` and setting the r-part to `r'`. -/
def resamp (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r) :
    Equiv.Perm (Bits (r + (r + c))) :=
  Equiv.swap (π z) (Fin.append r' (ovH (π z))) * π

theorem resamp_self (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r) :
    resamp π z r' z = Fin.append r' (ovH (π z)) := by
  simp only [resamp, Equiv.Perm.mul_apply, Equiv.swap_apply_left]

@[simp] theorem ovR_resamp_self (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r) :
    ovR (resamp π z r' z) = r' := by rw [resamp_self, ovR_append]

@[simp] theorem ovH_resamp_self (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r) :
    ovH (resamp π z r' z) = ovH (π z) := by rw [resamp_self, ovH_append]

/-- Off `z` and the swap partner `π⁻¹ (r' ‖ ovH (π z))`, `resamp` agrees with `π`. -/
theorem resamp_apply_ne (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r)
    (x : Bits (r + (r + c))) (hx : x ≠ z) (hy : π x ≠ Fin.append r' (ovH (π z))) :
    resamp π z r' x = π x := by
  simp only [resamp, Equiv.Perm.mul_apply]
  exact Equiv.swap_apply_of_ne_of_ne (fun h => hx (π.injective h)) hy

/-- The inverse of `resamp` agrees with `π⁻¹` off the swap points `π z` and `r' ‖ ovH (π z)`. -/
theorem resamp_symm_apply_ne (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r)
    (y : Bits (r + (r + c))) (h1 : y ≠ π z) (h2 : y ≠ Fin.append r' (ovH (π z))) :
    (resamp π z r').symm y = π.symm y := by
  apply (resamp π z r').injective
  rw [Equiv.apply_symm_apply]
  symm
  simp only [resamp, Equiv.Perm.mul_apply, Equiv.apply_symm_apply]
  exact Equiv.swap_apply_of_ne_of_ne h1 h2

/-- **Undoing the resample.** Swapping back with the recovered `π z` (from the pin's r-part and `resamp`'s h-part)
returns `π`; the basis of injectivity of `(π, r') ↦ resamp π z r'`. -/
theorem resamp_recover (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (r' : Bits r) :
    Equiv.swap (π z) (resamp π z r' z) * resamp π z r' = π := by
  rw [resamp_self]
  show Equiv.swap (π z) (Fin.append r' (ovH (π z))) *
    (Equiv.swap (π z) (Fin.append r' (ovH (π z))) * π) = π
  rw [← mul_assoc, Equiv.swap_mul_self, one_mul]

end PousSpongeChain

end


/-! ════ ChainEPFStable ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFacto` — stability lemmas for `Ev_update` (labeller side)

`realPt`/`keyAt` stability under changing the permutation. The key structural fact: `realPt π j` (block `j`'s pad
input) depends on `π` only through the labels of earlier blocks and the parent chain — **not** through `π` at the pad
input itself. So resampling one block's pad output leaves every block's real point fixed, provided the swap partner
dodges the parent-chain inputs.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- **Real-point stability.** If `π'` agrees with `π` on the earlier-block labels and on block `j`'s parent-chain
inputs, then `j`'s pad input is unchanged. -/
theorem realPt_congr {π π' : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (j : Fin B)
    (hlab : ∀ i : Fin B, i < j →
      labelG R.G (fun x => π' x) R.dom R.Wb i = labelG R.G (fun x => π x) R.dom R.Wb i)
    (hpar : ∀ x ∈ ovInputs (fun x => π x) (fun _ => false, iv (R.dom j.val))
        ((parentsDesc R.G j).map (labelG R.G (fun x => π x) R.dom R.Wb)), (π' : Bits _ → Bits _) x = π x) :
    R.realPt π' j = R.realPt π j := by
  show chainRealG R.G (fun x => π' x) R.dom R.Wb j = chainRealG R.G (fun x => π x) R.dom R.Wb j
  unfold chainRealG padInput chainState ovAbsorb
  rw [show (parentsDesc R.G j).map (labelG R.G (fun x => π' x) R.dom R.Wb)
        = (parentsDesc R.G j).map (labelG R.G (fun x => π x) R.dom R.Wb) from
      List.map_congr_left fun u hu => hlab u (parentsDesc_lt R.G hu),
    (ovAbsorb_congr (fun _ => false, iv (R.dom j.val))
      ((parentsDesc R.G j).map (labelG R.G (fun x => π x) R.dom R.Wb)) hpar).1]

/-- **Key stability.** If block `j`'s real point is unchanged and `π'` agrees with `π` there, its key is unchanged. -/
theorem keyAt_congr {π π' : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (j : Fin B)
    (hreal : R.realPt π' j = R.realPt π j) (hz : π' (R.realPt π j) = π (R.realPt π j)) :
    R.keyAt π' j = R.keyAt π j := by
  unfold keyAt
  rw [hreal, hz]

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFStable2 ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFacto` — transcript-side stability under `resamp`

The resample `resamp π z r'` changes `π` only at `z` and the swap partner `π⁻¹ (r' ‖ ovH (π z))`. If neither is
revealed by any thread before round `κ`, then `π` and `resamp π z r'` agree on every pre-`κ` query (forward *and*
inverse), i.e. `PousB5Chain.AgreeBefore` holds, and B5's generic `trace_stable`/`run_stable` transfer the transcript
verbatim up to `κ`.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- **`AgreeBefore` from the two avoidance conditions.** If neither `z` nor the swap partner
`π⁻¹ (r' ‖ ovH (π z))` is revealed by thread `i` before round `κ`, then `π` and `resamp π z r'` give thread `i` the same
answers on every pre-`κ` query. -/
theorem agreeBefore_resamp {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z : Bits (ℓ + (ℓ + c))} {r' : Bits ℓ}
    (i : Fin B) {κ : ℕ} (hz : ∀ ρ < κ, ¬ R.askedPt π z ρ)
    (hw : ∀ ρ < κ, ¬ R.askedPt π (π.symm (Fin.append r' (ovH (π z)))) ρ) :
    PousB5Chain.AgreeBefore ((idealPerm (ℓ + (ℓ + c))).answer π)
      ((idealPerm (ℓ + (ℓ + c))).answer (resamp π z r')) (R.P i) κ := by
  intro e he hlt
  rcases hq : e.2 with x | y
  · show π x = resamp π z r' x
    refine (resamp_apply_ne π z r' x ?_ ?_).symm
    · intro h
      exact hz e.1 hlt ⟨i, e, he, rfl, by rw [hq]; exact h⟩
    · intro h
      refine hw e.1 hlt ⟨i, e, he, rfl, ?_⟩
      rw [hq]; show x = π.symm (Fin.append r' (ovH (π z)))
      rw [← h, Equiv.symm_apply_apply]
  · show π.symm y = (resamp π z r').symm y
    refine (resamp_symm_apply_ne π z r' y ?_ ?_).symm
    · intro h
      exact hz e.1 hlt ⟨i, e, he, rfl, by rw [hq]; show π.symm y = z; rw [h, Equiv.symm_apply_apply]⟩
    · intro h
      exact hw e.1 hlt ⟨i, e, he, rfl, by rw [hq]; show π.symm y = π.symm (Fin.append r' (ovH (π z))); rw [h]⟩

/-- Transcript entries transfer up to round `κ` under `AgreeBefore` (B5's `trace_stable`). -/
theorem tr_stable {π π' : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {i : Fin B} {κ : ℕ}
    (hag : PousB5Chain.AgreeBefore ((idealPerm (ℓ + (ℓ + c))).answer π)
      ((idealPerm (ℓ + (ℓ + c))).answer π') (R.P i) κ) :
    (∀ (n : ℕ) e, (R.tr π i)[n]? = some e → e.1 ≤ κ → (R.tr π' i)[n]? = some e) ∧
      (∀ e ∈ R.tr π' i, e.1 ≤ κ → e ∈ R.tr π i) :=
  PousB5Chain.trace_stable _ _ (R.P i) κ hag

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFEvUpdate ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFacto` — per-position stability under `resamp`, toward `Ev_update`

`realAt`/`obsKey` for an adversary slot transfer under `resamp` when the revealed point / shown key dodges the two
swap points `z` and `π⁻¹ (r' ‖ ovH (π z))`. Built on `agreeBefore_resamp` + `tr_stable`.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- `realAt` at an adversary slot transfers under `resamp`, if its revealed point dodges the two swap points. -/
theorem realAt_inl_resamp {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z : Bits (ℓ + (ℓ + c))} {r' : Bits ℓ}
    {i : Fin B} {k : Fin (R.Q + 1)} {pt : Bits (ℓ + (ℓ + c))} {ρ κ : ℕ}
    (hag : PousB5Chain.AgreeBefore ((idealPerm (ℓ + (ℓ + c))).answer π)
      ((idealPerm (ℓ + (ℓ + c))).answer (resamp π z r')) (R.P i) κ)
    (h : R.realAt π (.inl (i, k)) = some (pt, ρ)) (hρ : ρ ≤ κ)
    (hz : pt ≠ z) (hw : pt ≠ π.symm (Fin.append r' (ovH (π z)))) :
    R.realAt (resamp π z r') (.inl (i, k)) = some (pt, ρ) := by
  simp only [realAt] at h ⊢
  by_cases hk : k.val < R.Q
  · rw [if_pos hk] at h ⊢
    rw [Option.map_eq_some_iff] at h
    obtain ⟨e, he, hfe⟩ := h
    injection hfe with hrev hround
    rw [(R.tr_stable hag).1 k.val e he (hround.trans_le hρ), Option.map_some]
    have hval : revealPt (resamp π z r') e.2 = pt := by
      rcases hq : e.2 with x | y
      · rw [hq] at hrev
        simpa only [revealPt] using hrev
      · rw [hq] at hrev
        simp only [revealPt] at hrev ⊢
        have hy1 : y ≠ π z := fun h => hz (by rw [← hrev, h, Equiv.symm_apply_apply])
        have hy2 : y ≠ Fin.append r' (ovH (π z)) := fun h => hw (by rw [← hrev, h])
        rw [resamp_symm_apply_ne π z r' y hy1 hy2]; exact hrev
    rw [hval, hround]
  · rw [if_neg hk] at h; exact absurd h (by simp)

/-- `obsKey` at an adversary slot transfers under `resamp`. Query slots (`k < Q`) show a **π-independent** input key, so
they need only the entry (`tr_stable`); the guess slot (`k = Q`) uses `run_stable`. -/
theorem obsKey_inl_resamp {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z : Bits (ℓ + (ℓ + c))} {r' : Bits ℓ}
    {i : Fin B} {k : Fin (R.Q + 1)} {v : Bits ℓ} {τ κ : ℕ}
    (hag : PousB5Chain.AgreeBefore ((idealPerm (ℓ + (ℓ + c))).answer π)
      ((idealPerm (ℓ + (ℓ + c))).answer (resamp π z r')) (R.P i) κ)
    (h : R.obsKey π (.inl (i, k)) = some (v, τ)) (hτ : τ ≤ κ) :
    R.obsKey (resamp π z r') (.inl (i, k)) = some (v, τ) := by
  simp only [obsKey] at h ⊢
  by_cases hk : k.val < R.Q
  · rw [if_pos hk] at h ⊢
    rw [Option.map_eq_some_iff] at h
    obtain ⟨e, he, hfe⟩ := h
    injection hfe with hqk hround
    rw [(R.tr_stable hag).1 k.val e he (hround.trans_le hτ), Option.map_some, hqk, hround]
  · rw [if_neg hk] at h ⊢
    simp only [Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨hval, hdep⟩ := h
    obtain ⟨hrun, hdepth⟩ := PousB5Chain.run_stable _ _ (R.P i) κ hag (hdep.trans_le hτ)
    rw [hrun, hdepth, hval, hdep]

/-- `realAt` at the labeller position transfers under `resamp` once the block's real point is preserved (supplied by
`realPt_congr` in the assembly). -/
theorem realAt_inr_resamp {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z : Bits (ℓ + (ℓ + c))} {r' : Bits ℓ} {j : Fin B}
    (hrp : R.realPt (resamp π z r') j = R.realPt π j) :
    R.realAt (resamp π z r') (.inr j) = R.realAt π (.inr j) := by
  simp only [realAt, hrp]

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFPrEv ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFacto` — `Ev_update` assembly and the compression `card_Ev_snoc`/`card_Ev`/`pr_Ev`

`resamp_realPt_stable` lifts `realPt_congr` to `resamp` via `ovInputs_append` (block `j`'s parent chain is a prefix of
its full absorb chain). The `Ev_update` assembly and the counting follow.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

variable {r c : ℕ}

/-- The chain's forward inputs split along a block-list concatenation. -/
theorem ovInputs_append (f : Bits (r + (r + c)) → Bits (r + (r + c))) (blks₁ blks₂ : List (Bits r)) :
    ∀ p : Bits r × Bits (r + c),
      ovInputs f p (blks₁ ++ blks₂) = ovInputs f p blks₁ ++ ovInputs f (blks₁.foldl (ovStep f) p) blks₂ := by
  induction blks₁ with
  | nil => intro p; simp [ovInputs]
  | cons blk blks ih => intro p; simp only [List.cons_append, ovInputs, List.foldl_cons, ih]

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- **Real-point stability for `resamp`.** If `resamp π z r'` agrees with `π` on the forward inputs of every block
`≤ j`'s absorb chain, then block `j`'s real point is unchanged. (The pad input `z_j` itself is not in that set, so the
resample of one block's pad output does not move it.) -/
theorem resamp_realPt_stable {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z : Bits (ℓ + (ℓ + c))} {r' : Bits ℓ} (j : Fin B)
    (hall : ∀ i : Fin B, i ≤ j → ∀ x ∈ ovInputs (fun x => π x) (fun _ => false, iv (R.dom i.val))
        (absorbedG R.G (labelG R.G (fun x => π x) R.dom R.Wb) i), (resamp π z r') x = π x) :
    R.realPt (resamp π z r') j = R.realPt π j := by
  apply R.realPt_congr j
  · intro i hi
    exact labelG_congr R.G R.dom R.Wb i (fun i' hi' => hall i' (le_trans hi' hi.le))
  · intro x hx
    refine hall j le_rfl x ?_
    rw [absorbedG, ovInputs_append]
    exact List.mem_append_left _ hx

/-- Block `j`'s honest-chain forward inputs (parents newest-first, then pad), as a finset. `realPt j` (the pad input)
is its last element. -/
noncomputable def chainInputsSet (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (j : Fin B) : Finset (Bits (ℓ + (ℓ + c))) :=
  (ovInputs (fun x => π x) (fun _ => false, iv (R.dom j.val))
    (absorbedG R.G (labelG R.G (fun x => π x) R.dom R.Wb) j)).toFinset

/-- Block `j`'s **parent-chain** forward inputs only (parents newest-first, without the pad call). This is
`chainInputsSet` minus the pad input `realPt j`. -/
noncomputable def parentInputsSet (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (j : Fin B) : Finset (Bits (ℓ + (ℓ + c))) :=
  (ovInputs (fun x => π x) (fun _ => false, iv (R.dom j.val))
    ((parentsDesc R.G j).map (labelG R.G (fun x => π x) R.dom R.Wb))).toFinset

/-- The chain inputs of block `j` are its parent inputs together with its pad input `realPt j`. -/
theorem mem_chainInputsSet {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (j : Fin B) {x : Bits (ℓ + (ℓ + c))} :
    x ∈ R.chainInputsSet π j ↔ x ∈ R.parentInputsSet π j ∨ x = R.realPt π j := by
  unfold chainInputsSet parentInputsSet
  rw [absorbedG, ovInputs_append]
  simp only [List.toFinset_append, Finset.mem_union, List.mem_toFinset]
  refine or_congr Iff.rfl ?_
  show x ∈ ovInputs (fun x => π x) _ [padBlk] ↔ x = R.realPt π j
  rw [ovInputs, ovInputs]
  simp only [List.mem_cons, List.not_mem_nil, or_false]
  exact Iff.rfl

/-- `realPt j` (the pad input) is not one of block `j`'s **parent** inputs; distinct blocks have distinct real points and
no block's real point is another's parent input — **below block `n`**. `NoColl = NoCollUpto B` is the global version.
Bounded so the `card_Ev` induction can carry it: resampling the max block preserves it below that block. The failure of
`NoColl` is the collision term, a birthday over the honest labeller's calls (independent of the adversary). -/
def NoCollUpto (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (n : ℕ) : Prop :=
  ∀ i j : Fin B, i.val < n → j.val < n →
    R.realPt π i ∉ R.parentInputsSet π j ∧ (i ≠ j → R.realPt π i ≠ R.realPt π j)

/-- The global collision-free predicate. Its failure is the collision term. -/
def NoColl (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : Prop := R.NoCollUpto π B

/-- `NoCollUpto` is antitone in the block bound: constraining more blocks is stronger. -/
theorem NoCollUpto_antitone {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {m n : ℕ} (hmn : m ≤ n)
    (h : R.NoCollUpto π n) : R.NoCollUpto π m :=
  fun i j hi hj => h i j (hi.trans_le hmn) (hj.trans_le hmn)

/-- `NoColl` implies every bounded form. -/
theorem NoColl.noCollUpto {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (h : R.NoColl π) (n : ℕ) [NeZero B] :
    R.NoCollUpto π n :=
  fun i j _ _ => h i j i.isLt j.isLt

/-- The cross-block form used by `bEv_update`: distinct blocks below `n` have no real point among the other's full chain
inputs. -/
theorem realPt_notMem_chainInputsSet {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {n : ℕ} (hNC : R.NoCollUpto π n)
    {i j : Fin B} (hi : i.val < n) (hj : j.val < n) (hij : i ≠ j) :
    R.realPt π i ∉ R.chainInputsSet π j := by
  rw [R.mem_chainInputsSet, not_or]
  exact ⟨(hNC i j hi hj).1, (hNC i j hi hj).2 hij⟩

/-- A block-indexed prediction `(o, block)`: the labeller's pad query for `block` (round `D + block`) is fresh, and an
earlier position `o` shows its **label** `keyAt block ⊕ Wb block`. -/
def bcond (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (o : R.Pos) (blk : Fin B) : Prop :=
  ∃ v τ, R.obsKey π o = some (v, τ) ∧ τ ≤ R.D + blk.val ∧
    (∀ ρ < R.D + blk.val, ¬ R.askedPt π (R.realPt π blk) ρ) ∧ bxor (R.keyAt π blk) (R.Wb blk) = v

/-- Predictions concern different blocks, in block (= round) order. -/
def brel (t t' : R.Pos × Fin B) : Prop := t.2 ≠ t'.2 ∧ t.2.val ≤ t'.2.val

/-- The block-indexed prediction pattern holds. -/
def bEv (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (φ : List (R.Pos × Fin B)) : Prop :=
  (∀ t ∈ φ, R.bcond π t.1 t.2) ∧ φ.Pairwise R.brel

theorem bEv_take {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {φ : List (R.Pos × Fin B)} (n : ℕ) (h : R.bEv π φ) :
    R.bEv π (φ.take n) :=
  ⟨fun t ht => h.1 t (List.mem_of_mem_take ht), h.2.sublist (List.take_sublist _ _)⟩

/-- All points `π` is used at by the honest chains and the adversary threads. The swap partner of a good resample
avoids this set. -/
noncomputable def Used (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : Finset (Bits (ℓ + (ℓ + c))) :=
  Finset.univ.biUnion (fun j => R.chainInputsSet π j) ∪
    Finset.univ.biUnion (fun i => ((R.tr π i).map fun e => revealPt π e.2).toFinset)

theorem askedPt_mem_Used {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z' : Bits (ℓ + (ℓ + c))} {ρ : ℕ}
    (h : R.askedPt π z' ρ) : z' ∈ R.Used π := by
  obtain ⟨i, e, he, _, hrev⟩ := h
  exact Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨i, Finset.mem_univ _,
    List.mem_toFinset.2 (List.mem_map.2 ⟨e, he, hrev⟩)⟩)

theorem chainInputsSet_subset_Used {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (j : Fin B) :
    R.chainInputsSet π j ⊆ R.Used π :=
  fun x hx => Finset.mem_union_left _ (Finset.mem_biUnion.2 ⟨j, Finset.mem_univ _, hx⟩)

/-- `realPt j` (the pad input) is one of block `j`'s chain inputs. -/
theorem realPt_mem_chainInputsSet {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (j : Fin B) :
    R.realPt π j ∈ R.chainInputsSet π j := by
  rw [chainInputsSet, List.mem_toFinset, absorbedG, ovInputs_append]
  refine List.mem_append_right _ ?_
  show R.realPt π j ∈ ovInputs (fun x => π x) _ [padBlk]
  rw [ovInputs]
  refine List.mem_cons.2 (Or.inl ?_)
  show R.realPt π j = Fin.append padBlk _
  rfl

/-- Reverse freshness under `resamp`: a point asked before `κ` under `resamp` was asked under `π`. -/
theorem askedPt_resamp_rev {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z : Bits (ℓ + (ℓ + c))} {r' : Bits ℓ}
    {z' : Bits (ℓ + (ℓ + c))} {ρ κ : ℕ}
    (hag : ∀ i, PousB5Chain.AgreeBefore ((idealPerm (ℓ + (ℓ + c))).answer π)
      ((idealPerm (ℓ + (ℓ + c))).answer (resamp π z r')) (R.P i) κ) (hρ : ρ < κ)
    (h : R.askedPt (resamp π z r') z' ρ) : R.askedPt π z' ρ := by
  obtain ⟨i, e, he, hround, hrev⟩ := h
  have he' : e ∈ R.tr π i := (R.tr_stable (hag i)).2 e he (le_of_lt (hround.symm ▸ hρ))
  refine ⟨i, e, he', hround, ?_⟩
  have hans := hag i e he' (hround.symm ▸ hρ)
  rcases hq : e.2 with x | y
  · rw [hq] at hrev; exact hrev
  · rw [hq] at hrev hans; exact hans.trans hrev

/-- **`Ev_update` (block-indexed, `NoColl`).** Resampling `π` at the last item's real point (max block) to a good `r'`
keeps the shorter block-indexed pattern. -/
theorem bEv_update (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {r' : Bits ℓ}
    {φ : List (R.Pos × Fin B)} {t : R.Pos × Fin B} (hE : R.bEv π (φ ++ [t]))
    (hNoColl : R.NoCollUpto π (t.2.val + 1))
    (hgood : π.symm (Fin.append r' (ovH (π (R.realPt π t.2)))) ∉ R.Used π) :
    R.bEv (resamp π (R.realPt π t.2) r') φ := by
  obtain ⟨hcond, hpw⟩ := hE
  rw [List.pairwise_append] at hpw
  obtain ⟨hpwφ, -, hlast⟩ := hpw
  obtain ⟨vt, τt, -, -, hfresht, -⟩ := hcond t (List.mem_append_right _ (List.mem_singleton_self _))
  refine ⟨fun s hs => ?_, hpwφ⟩
  obtain ⟨o, m⟩ := s
  obtain ⟨hmne, hmle⟩ := hlast (o, m) hs t (List.mem_singleton_self _)
  have hmlt : m.val < t.2.val := lt_of_le_of_ne hmle (fun h => hmne (Fin.ext h))
  obtain ⟨v, τ, hobs, hτ, hfresh, hkey⟩ := hcond (o, m) (List.mem_append_left _ hs)
  -- AgreeBefore for every thread up to D + m
  have hzfresh : ∀ ρ < R.D + m.val, ¬ R.askedPt π (R.realPt π t.2) ρ := fun ρ hρ => hfresht ρ (by omega)
  have hwfresh : ∀ ρ < R.D + m.val, ¬ R.askedPt π (π.symm (Fin.append r' (ovH (π (R.realPt π t.2))))) ρ :=
    fun ρ _ hask => hgood (R.askedPt_mem_Used hask)
  have hag : ∀ i, PousB5Chain.AgreeBefore ((idealPerm (ℓ + (ℓ + c))).answer π)
      ((idealPerm (ℓ + (ℓ + c))).answer (resamp π (R.realPt π t.2) r')) (R.P i) (R.D + m.val) :=
    fun i => R.agreeBefore_resamp i hzfresh hwfresh
  -- real point of m preserved
  have hall : ∀ i : Fin B, i ≤ m → ∀ x ∈ ovInputs (fun x => π x) (fun _ => false, iv (R.dom i.val))
      (absorbedG R.G (labelG R.G (fun x => π x) R.dom R.Wb) i), (resamp π (R.realPt π t.2) r') x = π x := by
    intro i hi x hx
    have hivm : i.val ≤ m.val := Fin.le_def.mp hi
    have hxset : x ∈ R.chainInputsSet π i := List.mem_toFinset.2 hx
    have hxz : x ≠ R.realPt π t.2 := fun h =>
      R.realPt_notMem_chainInputsSet hNoColl (by omega) (by omega) (Fin.ne_of_val_ne (by omega)) (h ▸ hxset)
    have hxw : π x ≠ Fin.append r' (ovH (π (R.realPt π t.2))) := fun h =>
      hgood (by rw [show π.symm (Fin.append r' (ovH (π (R.realPt π t.2)))) = x from by
        rw [← h, Equiv.symm_apply_apply]]; exact R.chainInputsSet_subset_Used i hxset)
    exact resamp_apply_ne π (R.realPt π t.2) r' x hxz hxw
  have hrp : R.realPt (resamp π (R.realPt π t.2) r') m = R.realPt π m := R.resamp_realPt_stable m hall
  -- key of m preserved
  have hrealm_ne_z : R.realPt π m ≠ R.realPt π t.2 :=
    fun h => R.realPt_notMem_chainInputsSet hNoColl (by omega) (by omega) (Fin.ne_of_val_ne (by omega))
      (h ▸ R.realPt_mem_chainInputsSet t.2)
  have hrealm_ne_w : π (R.realPt π m) ≠ Fin.append r' (ovH (π (R.realPt π t.2))) := fun h =>
    hgood (by rw [show π.symm (Fin.append r' (ovH (π (R.realPt π t.2)))) = R.realPt π m from by
      rw [← h, Equiv.symm_apply_apply]]; exact R.chainInputsSet_subset_Used m (R.realPt_mem_chainInputsSet m))
  have hzeq : (resamp π (R.realPt π t.2) r') (R.realPt π m) = π (R.realPt π m) :=
    resamp_apply_ne π (R.realPt π t.2) r' (R.realPt π m) hrealm_ne_z hrealm_ne_w
  have hkm : R.keyAt (resamp π (R.realPt π t.2) r') m = R.keyAt π m := R.keyAt_congr m hrp hzeq
  -- obsKey of o preserved (o must be an adversary slot)
  obtain ⟨oi, ok⟩ | oj := o
  · have hok : R.obsKey (resamp π (R.realPt π t.2) r') (.inl (oi, ok)) = some (v, τ) :=
      R.obsKey_inl_resamp (hag oi) hobs hτ
    refine ⟨v, τ, hok, hτ, ?_, ?_⟩
    · intro ρ hρ hask
      rw [hrp] at hask
      exact hfresh ρ hρ (R.askedPt_resamp_rev hag hρ hask)
    · rw [hkm]; exact hkey
  · simp [obsKey] at hobs

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFCount ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFacto` — the compression `card_Ev_snoc`, `card_Ev`, `pr_Ev`

The block-indexed permutation compression. `card_Ev_snoc` resamples the max-block item's pad output to one of the
`≥ 2^ℓ − nPos` "good" r-parts (those whose swap partner is outside the used-point set), an injection into the shorter
pattern by `resamp_recover`; iterating gives `card_Ev`, and `pr_Ev` is its probability form. All under `NoColl` (the
honest chain collision-free); the collision term is discharged separately as an adversary-independent birthday.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

/-- The chain asks exactly one forward query per absorbed block. -/
theorem ovInputs_length {r c : ℕ} (f : Bits (r + (r + c)) → Bits (r + (r + c))) :
    ∀ (p : Bits r × Bits (r + c)) (blks : List (Bits r)), (ovInputs f p blks).length = blks.length
  | _, [] => rfl
  | p, blk :: blks => by
      rw [ovInputs, List.length_cons, List.length_cons, ovInputs_length f (ovStep f p blk) blks]

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-! ### Resampling the max block preserves the shorter blocks' honest chain -/

/-- `resamp` at `realPt π t` agrees with `π` on any strictly-shorter block's full chain inputs (freshness of `t`'s pad
input across blocks + the good `r'` avoiding the used set). -/
theorem resamp_agree_chain {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {r' : Bits ℓ} {n : ℕ} {t : Fin B}
    (htn : t.val < n) (hNC : R.NoCollUpto π n)
    (hgood : π.symm (Fin.append r' (ovH (π (R.realPt π t)))) ∉ R.Used π)
    {j : Fin B} (hjt : j.val < t.val) {x : Bits (ℓ + (ℓ + c))} (hx : x ∈ R.chainInputsSet π j) :
    (resamp π (R.realPt π t) r') x = π x := by
  refine resamp_apply_ne π (R.realPt π t) r' x ?_ ?_
  · intro h
    exact R.realPt_notMem_chainInputsSet hNC htn (by omega) (Fin.ne_of_val_ne (by omega)) (h ▸ hx)
  · intro h
    exact hgood (by rw [show π.symm (Fin.append r' (ovH (π (R.realPt π t)))) = x from by
      rw [← h, Equiv.symm_apply_apply]]; exact R.chainInputsSet_subset_Used j hx)

/-- `resamp` at `realPt π t` agrees with `π` on any block `≤ t`'s parent inputs (`t`'s pad input is not a parent input,
by the intra-block clause of `NoCollUpto`; the good `r'` avoids the used set). -/
theorem resamp_agree_parent {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {r' : Bits ℓ} {n : ℕ} {t : Fin B}
    (htn : t.val < n) (hNC : R.NoCollUpto π n)
    (hgood : π.symm (Fin.append r' (ovH (π (R.realPt π t)))) ∉ R.Used π)
    {i : Fin B} (hit : i.val ≤ t.val) {x : Bits (ℓ + (ℓ + c))} (hx : x ∈ R.parentInputsSet π i) :
    (resamp π (R.realPt π t) r') x = π x := by
  have hxset : x ∈ R.chainInputsSet π i := (R.mem_chainInputsSet i).2 (Or.inl hx)
  refine resamp_apply_ne π (R.realPt π t) r' x ?_ ?_
  · intro h
    exact (hNC t i htn (by omega)).1 (h ▸ hx)
  · intro h
    exact hgood (by rw [show π.symm (Fin.append r' (ovH (π (R.realPt π t)))) = x from by
      rw [← h, Equiv.symm_apply_apply]]; exact R.chainInputsSet_subset_Used i hxset)

/-- Labels of blocks `< t` are unchanged by resampling `t`'s pad output. -/
theorem labelG_resamp_eq {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {r' : Bits ℓ} {n : ℕ} {t : Fin B}
    (htn : t.val < n) (hNC : R.NoCollUpto π n)
    (hgood : π.symm (Fin.append r' (ovH (π (R.realPt π t)))) ∉ R.Used π)
    {i : Fin B} (hit : i.val < t.val) :
    labelG R.G (fun x => resamp π (R.realPt π t) r' x) R.dom R.Wb i
      = labelG R.G (fun x => π x) R.dom R.Wb i := by
  apply labelG_congr R.G R.dom R.Wb i
  intro j hj x hx
  exact R.resamp_agree_chain htn hNC hgood (by have := Fin.le_def.mp hj; omega) (List.mem_toFinset.2 hx)

/-- Real points of blocks `≤ t` are unchanged by resampling `t`'s pad output (`t`'s own real point too: its pad input is
read only through `t`'s parent chain, which the resample fixes). -/
theorem realPt_resamp_eq {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {r' : Bits ℓ} {n : ℕ} {t : Fin B}
    (htn : t.val < n) (hNC : R.NoCollUpto π n)
    (hgood : π.symm (Fin.append r' (ovH (π (R.realPt π t)))) ∉ R.Used π)
    {i : Fin B} (hi : i.val ≤ t.val) :
    R.realPt (resamp π (R.realPt π t) r') i = R.realPt π i := by
  apply R.realPt_congr i
  · intro i' hi'
    exact R.labelG_resamp_eq htn hNC hgood (by have := Fin.lt_def.mp hi'; omega)
  · intro x hx
    exact R.resamp_agree_parent htn hNC hgood hi (List.mem_toFinset.2 hx)

/-- Parent-input sets of blocks `≤ t` are unchanged by resampling `t`'s pad output. -/
theorem parentInputsSet_resamp_eq {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {r' : Bits ℓ} {n : ℕ} {t : Fin B}
    (htn : t.val < n) (hNC : R.NoCollUpto π n)
    (hgood : π.symm (Fin.append r' (ovH (π (R.realPt π t)))) ∉ R.Used π)
    {j : Fin B} (hj : j.val ≤ t.val) :
    R.parentInputsSet (resamp π (R.realPt π t) r') j = R.parentInputsSet π j := by
  unfold parentInputsSet
  have hpNF : (parentsDesc R.G j).map (labelG R.G (fun x => resamp π (R.realPt π t) r' x) R.dom R.Wb)
      = (parentsDesc R.G j).map (labelG R.G (fun x => π x) R.dom R.Wb) :=
    List.map_congr_left fun u hu => R.labelG_resamp_eq htn hNC hgood (by
      have h1 := parentsDesc_lt R.G hu; have := Fin.lt_def.mp h1; omega)
  rw [hpNF]
  congr 1
  exact (ovAbsorb_congr (fun _ => false, iv (R.dom j.val))
    ((parentsDesc R.G j).map (labelG R.G (fun x => π x) R.dom R.Wb))
    (fun x hx => R.resamp_agree_parent htn hNC hgood hj (List.mem_toFinset.2 hx))).2

/-- **`NoCollUpto` is preserved** below the peeled block: resampling the max block `t` fixes every block `≤ t`'s real
point and parent inputs, so the collision-free pattern below `t + 1` transfers. -/
theorem NoCollUpto_resamp {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {r' : Bits ℓ} {t : Fin B}
    (hNC : R.NoCollUpto π (t.val + 1))
    (hgood : π.symm (Fin.append r' (ovH (π (R.realPt π t)))) ∉ R.Used π) :
    R.NoCollUpto (resamp π (R.realPt π t) r') (t.val + 1) := by
  have htn : t.val < t.val + 1 := Nat.lt_succ_self _
  intro i j hi hj
  have hile : i.val ≤ t.val := by omega
  have hjle : j.val ≤ t.val := by omega
  rw [R.realPt_resamp_eq htn hNC hgood hile, R.parentInputsSet_resamp_eq htn hNC hgood hjle]
  refine ⟨(hNC i j hi hj).1, fun hij => ?_⟩
  rw [R.realPt_resamp_eq htn hNC hgood hjle]
  exact (hNC i j hi hj).2 hij

/-- **The last item's observation is preserved** by the resample, and its shown value is `t`'s label
`ovR (π (realPt π t)) ⊕ Wb t`. The basis for recovering `π` from `resamp π (realPt π t) r'` in `card_Ev_snoc`. -/
theorem obsKey_last_resamp {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {r' : Bits ℓ}
    {φ : List (R.Pos × Fin B)} {t : R.Pos × Fin B}
    (hE : R.bEv π (φ ++ [t]))
    (hgood : π.symm (Fin.append r' (ovH (π (R.realPt π t.2)))) ∉ R.Used π) :
    ∃ τ, R.obsKey (resamp π (R.realPt π t.2) r') t.1
      = some (bxor (ovR (π (R.realPt π t.2))) (R.Wb t.2), τ) := by
  obtain ⟨hcond, -⟩ := hE
  obtain ⟨v, τ, hobs, hτ, hfresh, hkey⟩ := hcond t (List.mem_append_right _ (List.mem_singleton_self _))
  rcases ho : t.1 with ⟨oi, ok⟩ | oj
  · rw [ho] at hobs
    have hwfresh : ∀ ρ < R.D + t.2.val,
        ¬ R.askedPt π (π.symm (Fin.append r' (ovH (π (R.realPt π t.2))))) ρ :=
      fun ρ _ hask => hgood (R.askedPt_mem_Used hask)
    have hag := R.agreeBefore_resamp (z := R.realPt π t.2) (r' := r') oi hfresh hwfresh
    simp only [keyAt] at hkey
    exact ⟨τ, by rw [R.obsKey_inl_resamp hag hobs hτ, hkey]⟩
  · rw [ho] at hobs
    simp [obsKey] at hobs

/-! ### The used-point set has at most `nPos` points -/

/-- Block `j` has at most `j + 1` chain inputs (`j` parents and the pad). -/
theorem chainInputsSet_card_le (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (j : Fin B) :
    (R.chainInputsSet π j).card ≤ j.val + 1 := by
  refine (List.toFinset_card_le _).trans ?_
  rw [ovInputs_length, absorbedG, List.length_append, List.length_map, List.length_singleton]
  have := parentsDesc_length_le R.G j
  omega

/-- Thread `i` makes at most `Q` queries. -/
theorem tr_length (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) :
    (R.tr π i).length ≤ R.Q :=
  (PousB5Chain.length_trace ((idealPerm (ℓ + (ℓ + c))).answer π) (R.P i)).le.trans (hP i π).2

/-- **The used-point set is small.** All the labeller's chain inputs (`≤ B(B+1)/2`) plus all the adversary threads'
revealed points (`≤ B·Q`) number at most `nPos B Q`. -/
theorem Used_card_le (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (R.Used π).card ≤ nPos B R.Q := by
  have h1 : (Finset.univ.biUnion (fun j => R.chainInputsSet π j)).card ≤ B * (B + 1) / 2 := by
    refine Finset.card_biUnion_le.trans ((Finset.sum_le_sum (fun j _ => R.chainInputsSet_card_le π j)).trans ?_)
    rw [Nat.le_div_iff_mul_le (by norm_num : (0 : ℕ) < 2)]
    have hg : (∑ j : Fin B, (j.val + 1)) * 2 = B * (B + 1) := by
      rw [Fin.sum_univ_eq_sum_range (fun i => i + 1) B, Finset.sum_add_distrib, Finset.sum_const,
        Finset.card_range, smul_eq_mul, mul_one, add_mul, Finset.sum_range_id_mul_two]
      cases B with
      | zero => rfl
      | succ n => simp only [Nat.succ_sub_one]; ring
    exact hg.le
  have h2 : (Finset.univ.biUnion (fun i => ((R.tr π i).map fun e => revealPt π e.2).toFinset)).card ≤ B * R.Q := by
    refine Finset.card_biUnion_le.trans ?_
    calc ∑ i : Fin B, ((R.tr π i).map fun e => revealPt π e.2).toFinset.card
        ≤ ∑ _i : Fin B, R.Q := Finset.sum_le_sum (fun i _ =>
            (List.toFinset_card_le _).trans (by rw [List.length_map]; exact R.tr_length hP π i))
      _ = B * R.Q := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
  have hnp : B * R.Q ≤ B * (R.Q + 1) := Nat.mul_le_mul (le_refl B) (Nat.le_succ R.Q)
  calc (R.Used π).card
      ≤ (Finset.univ.biUnion (fun j => R.chainInputsSet π j)).card +
          (Finset.univ.biUnion (fun i => ((R.tr π i).map fun e => revealPt π e.2).toFinset)).card :=
        Finset.card_union_le _ _
    _ ≤ B * (B + 1) / 2 + B * R.Q := Nat.add_le_add h1 h2
    _ ≤ nPos B R.Q := by rw [nPos]; omega

/-! ### One prediction costs a factor `2^ℓ − nPos` -/

/-- A resample r-part is **good** for block `blk` when its swap partner is outside the used-point set, so resampling
`blk`'s pad output to it keeps the shorter pattern. -/
def goodR (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (blk : Fin B) (r' : Bits ℓ) : Prop :=
  π.symm (Fin.append r' (ovH (π (R.realPt π blk)))) ∉ R.Used π

open Classical in
/-- **At least `2^ℓ − nPos` good r-parts.** The bad ones inject (via `r' ↦ π⁻¹ (r' ‖ ovH(π z))`) into the used set,
which has `≤ nPos` points. -/
theorem goodR_card_ge (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (blk : Fin B) :
    2 ^ ℓ - nPos B R.Q ≤ (Finset.univ.filter (R.goodR π blk)).card := by
  have hbad : (Finset.univ.filter (fun r' => ¬ R.goodR π blk r')).card ≤ nPos B R.Q := by
    refine le_trans (Finset.card_le_card_of_injOn
      (fun r' => π.symm (Fin.append r' (ovH (π (R.realPt π blk))))) ?_ ?_) (R.Used_card_le hP π)
    · intro r' hr'
      rw [Finset.mem_coe, Finset.mem_filter] at hr'
      rw [Finset.mem_coe]
      simpa [goodR] using hr'.2
    · intro r'₁ _ r'₂ _ heq
      have h := π.symm.injective heq
      have h2 := congrArg ovR h
      rwa [ovR_append, ovR_append] at h2
  have htot := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset (Bits ℓ))) (R.goodR π blk)
  rw [Finset.card_univ] at htot
  have hbits : Fintype.card (Bits ℓ) = 2 ^ ℓ := by
    simp [Bits, Fintype.card_bool, Fintype.card_fin]
  omega

open Classical in
/-- **One prediction costs a factor `2^ℓ − nPos`.** Resampling the max-block item's pad output over the good r-parts is
an injection into the shorter pattern (recovered by `resamp_recover`); each source `π` has `≥ 2^ℓ − nPos` good r-parts. -/
theorem card_Ev_snoc (hP : ∀ i, (R.P i).Bounded R.D R.Q) (φ : List (R.Pos × Fin B)) (t : R.Pos × Fin B) :
    (Finset.univ.filter (fun π => R.bEv π (φ ++ [t]) ∧ R.NoCollUpto π (t.2.val + 1))).card
        * (2 ^ ℓ - nPos B R.Q)
      ≤ (Finset.univ.filter (fun π => R.bEv π φ ∧ R.NoCollUpto π (t.2.val + 1))).card := by
  have hDcard :
      (Finset.univ.filter (fun π => R.bEv π (φ ++ [t]) ∧ R.NoCollUpto π (t.2.val + 1))).card
          * (2 ^ ℓ - nPos B R.Q)
        ≤ ((Finset.univ.filter (fun π => R.bEv π (φ ++ [t]) ∧ R.NoCollUpto π (t.2.val + 1))
              ×ˢ (Finset.univ : Finset (Bits ℓ))).filter (fun p => R.goodR p.1 t.2 p.2)).card := by
    have hsum : ((Finset.univ.filter (fun π => R.bEv π (φ ++ [t]) ∧ R.NoCollUpto π (t.2.val + 1))
              ×ˢ (Finset.univ : Finset (Bits ℓ))).filter (fun p => R.goodR p.1 t.2 p.2)).card
        = ∑ π ∈ Finset.univ.filter (fun π => R.bEv π (φ ++ [t]) ∧ R.NoCollUpto π (t.2.val + 1)),
            (Finset.univ.filter (R.goodR π t.2)).card := by
      rw [Finset.card_filter, Finset.sum_product]
      exact Finset.sum_congr rfl (fun π _ => (Finset.card_filter _ _).symm)
    rw [hsum, ← smul_eq_mul]
    exact Finset.card_nsmul_le_sum _ _ _ (fun π _ => R.goodR_card_ge hP π t.2)
  refine le_trans hDcard (Finset.card_le_card_of_injOn (fun p => resamp p.1 (R.realPt p.1 t.2) p.2) ?_ ?_)
  · intro p hp
    rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_product, Finset.mem_filter] at hp
    obtain ⟨⟨⟨-, hE, hNC⟩, -⟩, hgood⟩ := hp
    rw [Finset.mem_coe, Finset.mem_filter]
    exact ⟨Finset.mem_univ _, R.bEv_update hP hE hNC hgood, R.NoCollUpto_resamp hNC hgood⟩
  · intro p₁ hp₁ p₂ hp₂ heq
    rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_product, Finset.mem_filter] at hp₁ hp₂
    obtain ⟨⟨⟨-, hE₁, hNC₁⟩, -⟩, hgood₁⟩ := hp₁
    obtain ⟨⟨⟨-, hE₂, hNC₂⟩, -⟩, hgood₂⟩ := hp₂
    dsimp only at heq
    have hz₁ := R.realPt_resamp_eq (t := t.2) (Nat.lt_succ_self _) hNC₁ hgood₁ (le_refl t.2.val)
    have hz₂ := R.realPt_resamp_eq (t := t.2) (Nat.lt_succ_self _) hNC₂ hgood₂ (le_refl t.2.val)
    have hzeq : R.realPt p₁.1 t.2 = R.realPt p₂.1 t.2 := by rw [← hz₁, ← hz₂, heq]
    have hr₁ : p₁.2 = ovR ((resamp p₁.1 (R.realPt p₁.1 t.2) p₁.2) (R.realPt p₁.1 t.2)) :=
      (ovR_resamp_self _ _ _).symm
    have hr₂ : p₂.2 = ovR ((resamp p₂.1 (R.realPt p₂.1 t.2) p₂.2) (R.realPt p₂.1 t.2)) :=
      (ovR_resamp_self _ _ _).symm
    have hr'eq : p₁.2 = p₂.2 := by rw [hr₁, hr₂, heq, hzeq]
    obtain ⟨τ₁, hobs₁⟩ := R.obsKey_last_resamp hE₁ hgood₁
    obtain ⟨τ₂, hobs₂⟩ := R.obsKey_last_resamp hE₂ hgood₂
    have hobseq : R.obsKey (resamp p₁.1 (R.realPt p₁.1 t.2) p₁.2) t.1
        = R.obsKey (resamp p₂.1 (R.realPt p₂.1 t.2) p₂.2) t.1 := by rw [heq]
    rw [hobs₁, hobs₂] at hobseq
    have hveq : ovR (p₁.1 (R.realPt p₁.1 t.2)) = ovR (p₂.1 (R.realPt p₂.1 t.2)) := by
      rw [Option.some_inj, Prod.mk.injEq] at hobseq
      have h := congrArg (fun x => bxor x (R.Wb t.2)) hobseq.1
      simpa only [bxor_self_right] using h
    have hheq : ovH (p₁.1 (R.realPt p₁.1 t.2)) = ovH (p₂.1 (R.realPt p₂.1 t.2)) := by
      rw [← ovH_resamp_self p₁.1 (R.realPt p₁.1 t.2) p₁.2, ← ovH_resamp_self p₂.1 (R.realPt p₂.1 t.2) p₂.2,
        heq, hzeq]
    have hpz : p₁.1 (R.realPt p₁.1 t.2) = p₂.1 (R.realPt p₂.1 t.2) := by
      rw [← append_ovR_ovH (p₁.1 (R.realPt p₁.1 t.2)), ← append_ovR_ovH (p₂.1 (R.realPt p₂.1 t.2)), hveq, hheq]
    have hpi : p₁.1 = p₂.1 := by
      have rec₁ := resamp_recover p₁.1 (R.realPt p₁.1 t.2) p₁.2
      have rec₂ := resamp_recover p₂.1 (R.realPt p₂.1 t.2) p₂.2
      rw [← rec₁, ← rec₂, heq, hpz]
      try rw [hzeq]
    exact Prod.ext hpi hr'eq

open Classical in
/-- **Iterating the compression.** A block-sorted pattern of `n` predictions leaves at most `|Ω|/(2^ℓ−nPos)^n`
permutations, under `NoCollUpto` above the pattern's blocks. -/
theorem card_Ev (hP : ∀ i, (R.P i).Bounded R.D R.Q) :
    ∀ (φ : List (R.Pos × Fin B)) (n : ℕ), φ.Pairwise R.brel → (∀ s ∈ φ, s.2.val < n) →
      (Finset.univ.filter (fun π => R.bEv π φ ∧ R.NoCollUpto π n)).card
          * (2 ^ ℓ - nPos B R.Q) ^ φ.length
        ≤ Fintype.card (Equiv.Perm (Bits (ℓ + (ℓ + c)))) := by
  intro φ
  induction φ using List.reverseRecOn with
  | nil =>
    intro n _ _
    rw [List.length_nil, pow_zero, mul_one]
    exact (Finset.card_filter_le _ _).trans Finset.card_univ.le
  | append_singleton φ t ih =>
    intro n hsorted hblk
    have htn : t.2.val < n := hblk t (by simp)
    have hsa := List.pairwise_append.1 hsorted
    have hsorted' : φ.Pairwise R.brel := hsa.1
    have hblk' : ∀ s ∈ φ, s.2.val < t.2.val + 1 := fun s hs => by
      have hb := hsa.2.2 s hs t (List.mem_singleton_self _)
      have : s.2.val < t.2.val := lt_of_le_of_ne hb.2 (fun h => hb.1 (Fin.ext h))
      omega
    rw [List.length_append, List.length_singleton, pow_succ', ← mul_assoc]
    have hsub : (Finset.univ.filter (fun π => R.bEv π (φ ++ [t]) ∧ R.NoCollUpto π n)).card
        ≤ (Finset.univ.filter (fun π => R.bEv π (φ ++ [t]) ∧ R.NoCollUpto π (t.2.val + 1))).card :=
      Finset.card_le_card (fun π hπ => Finset.mem_filter.2 ⟨Finset.mem_univ _,
        (Finset.mem_filter.1 hπ).2.1, R.NoCollUpto_antitone (by omega) (Finset.mem_filter.1 hπ).2.2⟩)
    calc (Finset.univ.filter (fun π => R.bEv π (φ ++ [t]) ∧ R.NoCollUpto π n)).card
            * (2 ^ ℓ - nPos B R.Q) * (2 ^ ℓ - nPos B R.Q) ^ φ.length
        ≤ (Finset.univ.filter (fun π => R.bEv π (φ ++ [t]) ∧ R.NoCollUpto π (t.2.val + 1))).card
            * (2 ^ ℓ - nPos B R.Q) * (2 ^ ℓ - nPos B R.Q) ^ φ.length :=
          Nat.mul_le_mul (Nat.mul_le_mul hsub le_rfl) le_rfl
      _ ≤ (Finset.univ.filter (fun π => R.bEv π φ ∧ R.NoCollUpto π (t.2.val + 1))).card
            * (2 ^ ℓ - nPos B R.Q) ^ φ.length :=
          Nat.mul_le_mul (R.card_Ev_snoc hP φ t) le_rfl
      _ ≤ Fintype.card (Equiv.Perm (Bits (ℓ + (ℓ + c)))) := ih (t.2.val + 1) hsorted' hblk'

open Classical in
/-- **`pr_Ev`.** A block-sorted collision-free pattern of `n` predictions holds with probability at most
`(2^ℓ − nPos)^{-n}`. Under `NoColl` (the honest chain collision-free — an adversary-independent condition discharged
separately). -/
theorem pr_Ev (hP : ∀ i, (R.P i).Bounded R.D R.Q) (φ : List (R.Pos × Fin B))
    (hsorted : φ.Pairwise R.brel) :
    pr (fun π => R.bEv π φ ∧ R.NoColl π) ≤ (((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)⁻¹) ^ φ.length := by
  show pr (fun π => R.bEv π φ ∧ R.NoCollUpto π B) ≤ (((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)⁻¹) ^ φ.length
  classical
  rcases Nat.eq_zero_or_pos φ.length with hl0 | hlen
  · rw [hl0, pow_zero]; exact PousThm1Dense.pr_le_one _
  rcases Nat.eq_zero_or_pos (2 ^ ℓ - nPos B R.Q) with h0 | hpos
  · rw [h0, Nat.cast_zero, ENNReal.inv_zero, ENNReal.top_pow hlen.ne']
    exact le_top
  have hΩ0 : (Fintype.card (Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : (((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)) ^ φ.length ≠ 0 :=
    pow_ne_zero _ (by exact_mod_cast hpos.ne')
  have h2t : (((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)) ^ φ.length ≠ ⊤ :=
    ENNReal.pow_ne_top (ENNReal.natCast_ne_top _)
  rw [pr_def, ENNReal.div_le_iff hΩ0 hΩt]
  have hc : ((Finset.univ.filter (fun π => R.bEv π φ ∧ R.NoCollUpto π B)).card : ℝ≥0∞)
      * (((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)) ^ φ.length
      ≤ Fintype.card (Equiv.Perm (Bits (ℓ + (ℓ + c)))) := by
    have hnat := R.card_Ev hP φ B hsorted (fun s _ => s.2.isLt)
    calc ((Finset.univ.filter (fun π => R.bEv π φ ∧ R.NoCollUpto π B)).card : ℝ≥0∞)
          * (((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)) ^ φ.length
        = (((Finset.univ.filter (fun π => R.bEv π φ ∧ R.NoCollUpto π B)).card
            * (2 ^ ℓ - nPos B R.Q) ^ φ.length : ℕ) : ℝ≥0∞) := by push_cast; ring
      _ ≤ Fintype.card (Equiv.Perm (Bits (ℓ + (ℓ + c)))) := by exact_mod_cast hnat
  calc ((Finset.univ.filter (fun π => R.bEv π φ ∧ R.NoCollUpto π B)).card : ℝ≥0∞)
      = (Finset.univ.filter (fun π => R.bEv π φ ∧ R.NoCollUpto π B)).card
          * (((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)) ^ φ.length
          * ((((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)) ^ φ.length)⁻¹ := by
        rw [mul_assoc, ENNReal.mul_inv_cancel h2 h2t, mul_one]
    _ ≤ Fintype.card (Equiv.Perm (Bits (ℓ + (ℓ + c)))) * ((((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)) ^ φ.length)⁻¹ := by
        gcongr
    _ = (((2 ^ ℓ - nPos B R.Q : ℕ) : ℝ≥0∞)⁻¹) ^ φ.length * Fintype.card (Equiv.Perm (Bits (ℓ + (ℓ + c)))) := by
        rw [ENNReal.inv_pow, mul_comm]

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFReduce ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFactoG` — Part C: the ex-post-facto reduction into `ChainKnow`

Winning on `≥ k` blocks forces `≥ s + 1` **fresh** block keys (a key shown by an earlier position before the block's pad
query is asked), else the fresh blocks form a `ChainKnow` holding of size `≤ s` that already reaches all winning blocks in
`D` rounds — contradicting `ChainHard G`. The fresh blocks then give a block-sorted `bEv` pattern of length `s + 1`
(`exists_bEv`), fed to `pr_Ev` in the assembly.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- Block `i`'s key is **fresh**: some position shows it (as a key) by the round `i`'s pad query is asked. -/
def bfresh (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) : Prop := ∃ o : R.Pos, R.bcond π o i

/-- Adversary threads only ask before round `D`. -/
theorem askedPt_lt_D (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {z : Bits (ℓ + (ℓ + c))} {ρ : ℕ} (h : R.askedPt π z ρ) : ρ < R.D := by
  obtain ⟨i, e, he, hround, -⟩ := h
  have h1 := PousB5Chain.round_lt_depth ((idealPerm (ℓ + (ℓ + c))).answer π) (R.P i) e he
  have h2 := (hP i π).1
  omega

/-- **The guess case of freshness.** If thread `cc` computes block `cc`'s label correctly and never asks its pad input,
its guess slot shows `cc`'s key fresh — so `cc` is fresh. -/
theorem bfresh_of_run (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {cc : Fin B}
    (hcorr : (R.P cc).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG R.G (fun x => π x) R.dom R.Wb cc)
    (hfresh : ∀ ρ, ¬ R.askedPt π (R.realPt π cc) ρ) :
    R.bfresh π cc := by
  refine ⟨.inl (cc, ⟨R.Q, Nat.lt_succ_self _⟩), bxor (R.keyAt π cc) (R.Wb cc),
    (R.P cc).depth ((idealPerm (ℓ + (ℓ + c))).answer π), ?_, ?_, fun ρ _ => hfresh ρ, rfl⟩
  · rw [show R.obsKey π (.inl (cc, ⟨R.Q, Nat.lt_succ_self _⟩))
        = some ((R.P cc).run ((idealPerm (ℓ + (ℓ + c))).answer π),
            (R.P cc).depth ((idealPerm (ℓ + (ℓ + c))).answer π)) from by
      simp only [obsKey]; rw [if_neg (Nat.lt_irrefl _)]]
    rw [hcorr, labelG_pad]
    rfl
  · exact le_trans (hP cc π).1 (Nat.le_add_right _ _)

/-- **Winning splits into fresh or asked-before-`D`.** A block whose label thread `cc` computes correctly is either
`bfresh`, or its pad input is asked by an adversary thread before round `D`. The `asked ⇒ ChainKnow.reach` direction
(the remaining crux) then places the latter in reach of the fresh seeds. -/
theorem correct_bfresh_or_asked (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {cc : Fin B} (hcorr : (R.P cc).run ((idealPerm (ℓ + (ℓ + c))).answer π)
      = labelG R.G (fun x => π x) R.dom R.Wb cc) :
    R.bfresh π cc ∨ ∃ ρ < R.D, R.askedPt π (R.realPt π cc) ρ := by
  by_cases h : ∃ ρ, R.askedPt π (R.realPt π cc) ρ
  · obtain ⟨ρ, hρ⟩ := h
    exact Or.inr ⟨ρ, R.askedPt_lt_D hP hρ, hρ⟩
  · push Not at h
    exact Or.inl (R.bfresh_of_run hP hcorr h)

open Classical in
/-- **The fresh pattern.** Any set of blocks with fresh keys gives a block-sorted `bEv` pattern of that size. -/
theorem exists_bEv {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (F : Finset (Fin B)) (hF : ∀ i ∈ F, R.bfresh π i) :
    ∃ φ : List (R.Pos × Fin B), φ.length = F.card ∧ R.bEv π φ ∧ ∀ t ∈ φ, t.2 ∈ F := by
  have hF' : ∀ i : Fin B, ∃ o : R.Pos, i ∈ F → R.bcond π o i := by
    intro i
    by_cases hi : i ∈ F
    · obtain ⟨o, ho⟩ := hF i hi; exact ⟨o, fun _ => ho⟩
    · exact ⟨.inr i, fun hi' => absurd hi' hi⟩
  choose o ho using hF'
  refine ⟨(F.sort (· ≤ ·)).map (fun i => (o i, i)), ?_, ⟨?_, ?_⟩, ?_⟩
  · rw [List.length_map, Finset.length_sort]
  · intro t ht
    obtain ⟨i, hi, rfl⟩ := List.mem_map.1 ht
    exact ho i ((Finset.mem_sort _).1 hi)
  · rw [List.pairwise_map]
    have hsort : (F.sort (· ≤ ·)).Pairwise (· ≤ ·) := Finset.pairwise_sort _ _
    have hnodup : (F.sort (· ≤ ·)).Pairwise (· ≠ ·) := Finset.sort_nodup _ _
    exact (hsort.and hnodup).imp fun {a b} h => ⟨h.2, Fin.le_def.mp h.1⟩
  · intro t ht
    obtain ⟨i, hi, rfl⟩ := List.mem_map.1 ht
    exact (Finset.mem_sort _).1 hi

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFSim ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFactoG` — Part C: the `ChainKnow` simulation foundation

The fresh blocks form a `ChainKnow` holding `holdingOf F` priced `|F|`, whose labels are reached in any number of rounds.
On `¬Bad` the deterministic simulation places every winning block in `ChainKnow.reach (holdingOf F) D`, so `ChainHard G`
forces `≥ s+1` fresh blocks. This file builds the reusable reach/holding facts; the `asked ⇒ reach` step and the `Bad`
bound follow.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

/-- The `ChainKnow` holding whose only knowledge is the labels in `F` (priced `|F|`). -/
def holdingOf {B : ℕ} (F : Finset (Fin B)) : ChainKnow B := ⟨F, ∅, ∅⟩

@[simp] theorem holdingOf_labs {B : ℕ} (F : Finset (Fin B)) : (holdingOf F).labs = F := rfl

/-- The fresh-labels holding is priced exactly `|F|` (no chaining values or dropped `r`s). -/
theorem holdingOf_size {B : ℕ} (c ℓ : ℕ) (F : Finset (Fin B)) : (holdingOf F).size c ℓ = F.card := by
  simp [holdingOf, ChainKnow.size]

/-- Labels persist through `ChainKnow.reach`. -/
theorem labs_subset_reach {N : ℕ} (G : TopoDAG N) (P₀ : ChainKnow N) :
    ∀ t, P₀.labs ⊆ (ChainKnow.reach G P₀ t).labs
  | 0 => by intro v hv; rw [ChainKnow.reach, mem_read_labs]; exact Or.inl hv
  | t + 1 => (labs_subset_reach G P₀ t).trans (labs_subset_round G _)

/-- The seed labels of `holdingOf F` are reached after any number of rounds. -/
theorem holdingOf_subset_reach {B : ℕ} (G : TopoDAG B) (F : Finset (Fin B)) (t : ℕ) :
    F ⊆ (ChainKnow.reach G (holdingOf F) t).labs := by
  have h := labs_subset_reach G (holdingOf F) t
  rwa [holdingOf_labs] at h

/-- **Numeric core of the assembly, under the side condition `2·n ≤ 2^ℓ`.** A fresh item costs `2/2^ℓ` rather than
`1/(2^ℓ−n)`: the "factor 2 from resampling". (Off the side condition the collision term dominates.) -/
theorem inv_two_pow_sub_le {ℓ n : ℕ} (h : 2 * n ≤ 2 ^ ℓ) :
    (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹ ≤ 2 * ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := by
  have hnat : (2 : ℕ) ^ ℓ ≤ 2 * (2 ^ ℓ - n) := by omega
  have hpow : ((2 : ℝ≥0∞) ^ ℓ) = ((2 ^ ℓ : ℕ) : ℝ≥0∞) := by push_cast; ring
  have hcast : ((2 : ℝ≥0∞) ^ ℓ) ≤ 2 * (((2 ^ ℓ - n : ℕ) : ℝ≥0∞)) := by
    rw [hpow]
    have := (Nat.cast_le (α := ℝ≥0∞)).2 hnat
    rw [Nat.cast_mul] at this
    simpa using this
  have ha : ((2 ^ ℓ - n : ℕ) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : (2 : ℝ≥0∞) ≠ 0 := two_ne_zero
  have h2t : (2 : ℝ≥0∞) ≠ ⊤ := ENNReal.ofNat_ne_top
  have hinv : (2 * ((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹ ≤ ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := ENNReal.inv_le_inv.2 hcast
  rw [ENNReal.mul_inv (Or.inl h2) (Or.inl h2t)] at hinv
  calc (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹
      = 2 * (2⁻¹ * (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel h2 h2t, one_mul]
    _ ≤ 2 * ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := mul_le_mul' le_rfl hinv

end PousSpongeChain

end


/-! ════ ChainEPFResampleH ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFactoG` — the h-part-preserving resampling transposition (chaining-fresh layer)

`resampH π z h'` swaps `π z` with `ovR (π z) ‖ h'`: it sets the **h-part** (chaining, `ℓ+c` bits) of `π` at `z` to `h'`
while keeping the r-part. This is the chaining-value analogue of `resamp` (which moves the r-part, `ℓ` bits): a fresh
chaining value costs `2^(ℓ+c)`, a fresh key/label costs `2^ℓ`. Same mechanical facts as `resamp`, for the h-side.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge
open scoped ENNReal

variable {r c : ℕ}

/-- Resample `π` at `z`, keeping the r-part of `π z` and setting the h-part to `h'`. -/
def resampH (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (h' : Bits (r + c)) :
    Equiv.Perm (Bits (r + (r + c))) :=
  Equiv.swap (π z) (Fin.append (ovR (π z)) h') * π

theorem resampH_self (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (h' : Bits (r + c)) :
    resampH π z h' z = Fin.append (ovR (π z)) h' := by
  simp only [resampH, Equiv.Perm.mul_apply, Equiv.swap_apply_left]

@[simp] theorem ovH_resampH_self (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (h' : Bits (r + c)) :
    ovH (resampH π z h' z) = h' := by rw [resampH_self, ovH_append]

@[simp] theorem ovR_resampH_self (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (h' : Bits (r + c)) :
    ovR (resampH π z h' z) = ovR (π z) := by rw [resampH_self, ovR_append]

/-- Off `z` and the swap partner `π⁻¹ (ovR (π z) ‖ h')`, `resampH` agrees with `π`. -/
theorem resampH_apply_ne (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (h' : Bits (r + c))
    (x : Bits (r + (r + c))) (hx : x ≠ z) (hy : π x ≠ Fin.append (ovR (π z)) h') :
    resampH π z h' x = π x := by
  simp only [resampH, Equiv.Perm.mul_apply]
  exact Equiv.swap_apply_of_ne_of_ne (fun h => hx (π.injective h)) hy

/-- The inverse of `resampH` agrees with `π⁻¹` off the swap points `π z` and `ovR (π z) ‖ h'`. -/
theorem resampH_symm_apply_ne (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (h' : Bits (r + c))
    (y : Bits (r + (r + c))) (h1 : y ≠ π z) (h2 : y ≠ Fin.append (ovR (π z)) h') :
    (resampH π z h').symm y = π.symm y := by
  apply (resampH π z h').injective
  rw [Equiv.apply_symm_apply]
  symm
  simp only [resampH, Equiv.Perm.mul_apply, Equiv.apply_symm_apply]
  exact Equiv.swap_apply_of_ne_of_ne h1 h2

/-- **Undoing the h-resample.** Swapping back with the recovered `π z` (from the pin's h-part and `resampH`'s r-part)
returns `π`; the basis of injectivity of `(π, h') ↦ resampH π z h'`. -/
theorem resampH_recover (π : Equiv.Perm (Bits (r + (r + c)))) (z : Bits (r + (r + c))) (h' : Bits (r + c)) :
    Equiv.swap (π z) (resampH π z h' z) * resampH π z h' = π := by
  rw [resampH_self]
  show Equiv.swap (π z) (Fin.append (ovR (π z)) h') *
    (Equiv.swap (π z) (Fin.append (ovR (π z)) h') * π) = π
  rw [← mul_assoc, Equiv.swap_mul_self, one_mul]

end PousSpongeChain

end


/-! ════ ChainEPFItem ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFactoG` — unified item-indexed compression: the chain-position foundation

Every fresh item is a **chain position** `(v, p)` with `1 ≤ p ≤ ovCalls v`, whose point is the `p`-th chain input
`xin π v p`. The pad position `p = ovCalls v` gives the **label** item (pin the r-part `keyAt v`, width `ℓ`, `resamp`);
an earlier position `p < ovCalls v` gives a **chaining** item (pin the h-part `h_{v,p}`, width `ℓ+c`, `resampH`). This file
builds `xin`, the split `chainInputList = parentInputList ++ [realPt]`, its length `= ovCalls`, and `xin (ovCalls v) =
realPt v`.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- Block `v`'s chain inputs as a list: the parents' inputs, then the pad input. Length `ovCalls G v`. -/
noncomputable def chainInputList (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : List (Bits (ℓ + (ℓ + c))) :=
  ovInputs (fun x => π x) (fun _ => false, iv (R.dom v.val))
    (absorbedG R.G (labelG R.G (fun x => π x) R.dom R.Wb) v)

/-- Block `v`'s parent-chain inputs as a list (without the pad). -/
noncomputable def parentInputList (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : List (Bits (ℓ + (ℓ + c))) :=
  ovInputs (fun x => π x) (fun _ => false, iv (R.dom v.val))
    ((parentsDesc R.G v).map (labelG R.G (fun x => π x) R.dom R.Wb))

/-- The chain input list is the parent inputs followed by the pad input `realPt v`. -/
theorem chainInputList_eq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    R.chainInputList π v = R.parentInputList π v ++ [R.realPt π v] := by
  rw [chainInputList, parentInputList, absorbedG, ovInputs_append]
  congr 1

/-- The chain input list has length `ovCalls G v`. -/
theorem chainInputList_length (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    (R.chainInputList π v).length = ovCalls R.G v := by
  rw [chainInputList, ovInputs_length, absorbedG, List.length_append, List.length_map, List.length_singleton,
    ovCalls]

/-- The `p`-th chain input of block `v` (1-indexed); the point pinned by item `(v, p)`. -/
noncomputable def xin (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) : Bits (ℓ + (ℓ + c)) :=
  ((R.chainInputList π v)[p - 1]?).getD (fun _ => false)

/-- The pad position's input is `realPt v` (the label item's point). -/
theorem xin_pad (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    R.xin π v (ovCalls R.G v) = R.realPt π v := by
  have hlen : (R.parentInputList π v).length = ovCalls R.G v - 1 := by
    rw [parentInputList, ovInputs_length, List.length_map, ovCalls]; omega
  have hpos : 1 ≤ ovCalls R.G v := by rw [ovCalls]; omega
  rw [xin, chainInputList_eq]
  rw [List.getElem?_append_right (by omega)]
  rw [hlen]
  simp only [show ovCalls R.G v - 1 - (ovCalls R.G v - 1) = 0 from by omega]
  rfl

end ChainReplay

/-- A **fresh item** is a chain position: a block's label (pad call, r-part, width `ℓ`, `resamp`) or an intermediate
chaining value (call `p`, h-part, width `ℓ+c`, `resampH`). -/
inductive ItemKind (B : ℕ) where
  | label : Fin B → ItemKind B
  | chaining : Fin B → ℕ → ItemKind B
deriving DecidableEq

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- The block an item belongs to. -/
def itemBlock : ItemKind B → Fin B
  | .label v => v
  | .chaining v _ => v

/-- The point (chain input) an item pins: `realPt v` for a label, `xin v p` for a chaining value. -/
noncomputable def itemPoint (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ItemKind B → Bits (ℓ + (ℓ + c))
  | .label v => R.realPt π v
  | .chaining v p => R.xin π v p

/-- The width of an item's pinned value: `ℓ` for a label (r-part), `ℓ+c` for a chaining value (h-part). -/
def itemWidth (_R : ChainReplay B ℓ c) : ItemKind B → ℕ
  | .label _ => ℓ
  | .chaining _ _ => ℓ + c

/-- The item-dispatched resample: `resamp` (move the r-part) for a label, `resampH` (move the h-part) for a chaining. -/
noncomputable def itemResamp (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (k : ItemKind B) → Bits (R.itemWidth k) → Equiv.Perm (Bits (ℓ + (ℓ + c)))
  | .label v, t => resamp π (R.realPt π v) t
  | .chaining v p, t => resampH π (R.xin π v p) t

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFFresh ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFactoG` — unified fresh predicates, holding, and the bad event (contract for `mem_reach_of_asked`)

The frozen definitions the reach prover (`ChainEPFReach.lean`) and the compression build against: the unified round
`itemRound`, the chaining observation `obsKeyH`, the fresh predicates `bfreshLabel`/`bfreshChaining`, the fresh seed
holding `freshHolding`, and the honest-chain collision `NoCollU`/`Bad`. See
`internal/p3-instantiation/chain-epf-interface.md`.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

/-- The `(ℓ+c)`-bit chaining a query shows in the clear (its input h-part). π-independent. -/
def qKeyH {ℓ c : ℕ} : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + c)
  | .inl x => ovH x
  | .inr y => ovH y

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- Global round of chain position `(v, p)`: lex on `(v.val, p)`, past the `D` online rounds. Strictly monotone along the
chain and topologically, and `≥ D`. -/
def itemRound (v : Fin B) (p : ℕ) : ℕ := R.D + v.val * (B + 2) + p

/-- What a position shows as a chaining value: a query slot shows its input h-part; a guess slot shows nothing. -/
def obsKeyH (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.Pos → Option (Bits (ℓ + c) × ℕ)
  | .inl (i, k) => if k.val < R.Q then ((R.tr π i)[k.val]?).map (fun e => (qKeyH e.2, e.1)) else none
  | .inr _ => none

/-- Block `v`'s **label** is fresh (observation-round form): some position shows its label `labelG v` **or** its key
`keyAt v` no later than the first round that asks `realPt v`. (An inverse query on `π (realPt v)` shows the key.) -/
def bfreshLabel (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : Prop :=
  ∃ (o : R.Pos) (τ : ℕ) (v' : Bits ℓ), R.obsKey π o = some (v', τ) ∧
    (v' = bxor (ovR (π (R.realPt π v))) (R.Wb v) ∨ v' = ovR (π (R.realPt π v))) ∧
    (∀ ρ < τ, ¬ R.askedPt π (R.realPt π v) ρ)

/-- Chaining value `(v, p)` is fresh (observation-round form): some position shows `h_{v,p} = ovH (π (xin v p))` no
later than the first round that asks `xin v p`. -/
def bfreshChaining (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) : Prop :=
  ∃ (o : R.Pos) (τ : ℕ), R.obsKeyH π o = some (ovH (π (R.xin π v p)), τ) ∧
    (∀ ρ < τ, ¬ R.askedPt π (R.xin π v p) ρ)

open Classical in
/-- The `ChainKnow` holding of fresh seeds: label-fresh blocks in `labs`, chaining-fresh `(v,p)` in `hs`. -/
noncomputable def freshHolding (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ChainKnow B where
  labs := Finset.univ.filter (fun v => R.bfreshLabel π v)
  hs := (ovPos B).filter (fun q => 1 ≤ q.2 ∧ q.2 < ovCalls R.G q.1 ∧ R.bfreshChaining π q.1 q.2)
  rs := ∅

/-- Distinct chain positions have distinct chain inputs. The honest-chain collision (`π`-only). -/
def NoCollU (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : Prop :=
  ∀ (v : Fin B) (p : ℕ) (v' : Fin B) (p' : ℕ),
    1 ≤ p → p ≤ ovCalls R.G v → 1 ≤ p' → p' ≤ ovCalls R.G v' →
    (v ≠ v' ∨ p ≠ p') → R.xin π v p ≠ R.xin π v' p'

/-- The bad event: a chain-input collision (negation of `NoCollU`). Adversary-independent. -/
def Bad (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : Prop := ¬ R.NoCollU π

end ChainReplay

end PousSpongeChain

end


