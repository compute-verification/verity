/-!
# Satisfiability witnesses for the lucky-guess target (`ZeroAdvicePlan.md`, M6)

- `okLucky_one`: the restriction admits instances (`n = 1`, `wc = 32`, `Q = 2^15`).
- `zeroAdviceLucky_ineq_of_lt`: the target's inequality holds whenever `n < k` (no family wins, so the count is `0`).
  This is the corner that refuted `DecodeHyp`.
- `zeroAdviceLucky_ineq_of_le`: it holds whenever `k ≤ X` (the saving is `2^0` and `C(Q_tot, 10n) ≥ 1`).

None of these uses `AdaptiveMinEntropy`.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge

theorem okLucky_one : okLucky 1 32 (2 ^ 15) := by
  refine ⟨one_pos, le_rfl, ?_⟩
  norm_num

theorem winZ_card_le {n wc k : ℕ} {tag : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc}
    {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)} {ω : (p3ModelT n wc).Ω} (h : WinZ k tag G W p ω) : k ≤ n :=
  h.trans ((Finset.card_le_univ _).trans (by simp))

open Classical in
theorem zeroAdviceLucky_ineq_of_lt {n wc Q k X : ℕ} (tag : Bits 256) (G : Labelling.TopoDAG n)
    (W : Fin n → Lab n wc) (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (hk : n < k) :
    (Finset.univ.filter fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω).card * 2 ^ ((k - X) * (n * wc)) ≤
      Nat.choose (1 * (n * (Q + 1) + 2 * n)) (posLucky n) * Fintype.card (p3ModelT n wc).Ω := by
  have h0 : (Finset.univ.filter fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω) = ∅ :=
    Finset.filter_false_of_mem fun ω _ h => absurd (winZ_card_le h.1) (by omega)
  rw [h0, Finset.card_empty, zero_mul]
  exact Nat.zero_le _

open Classical in
theorem zeroAdviceLucky_ineq_of_le {n wc Q k X : ℕ} (tag : Bits 256) (G : Labelling.TopoDAG n)
    (W : Fin n → Lab n wc) (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (hok : okLucky n wc Q) (hkX : k ≤ X) :
    (Finset.univ.filter fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω).card * 2 ^ ((k - X) * (n * wc)) ≤
      Nat.choose (1 * (n * (Q + 1) + 2 * n)) (posLucky n) * Fintype.card (p3ModelT n wc).Ω := by
  obtain ⟨hn, hQ, -⟩ := hok
  have hC : 1 ≤ Nat.choose (1 * (n * (Q + 1) + 2 * n)) (posLucky n) :=
    Nat.choose_pos (by unfold posLucky; nlinarith)
  rw [show k - X = 0 by omega, zero_mul, pow_zero, mul_one]
  calc (Finset.univ.filter fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω).card
      ≤ Fintype.card (p3ModelT n wc).Ω := (Finset.card_filter_le _ _).trans (le_of_eq Finset.card_univ)
    _ = 1 * Fintype.card (p3ModelT n wc).Ω := (one_mul _).symm
    _ ≤ _ := Nat.mul_le_mul_right _ hC

/-! ### `AdaptiveMinEntropy` at `S = ∅` (red-team §32, request 1)

An empty lucky set means no honest query is asked, no hit happens and no final answer is credited. So nothing is
credited (`credUpTo3_eq_empty`) and the lucky bits are `0` (`luckyBits_eq_zero`). `AdaptiveMinEntropy`'s inequality at
`S = ∅` is then `#{ω | luckySet ω = ∅} ≤ |Ω|` (`adaptiveMinEntropy_empty`), for every instance.
-/

section Empty

variable {n wc : ℕ} (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

theorem luckySet_eq_empty_iff (D Q : ℕ) :
    luckySet p ω tag G W D Q = ∅ ↔
      (∀ h : Fin 6 × Fin n, ¬ ∃ r, Asked p ω (honestQ tag G W ω h) r) ∧ hitsBy p ω tag G W D = ∅ ∧
        creditedOut p ω tag G W D = ∅ := by
  classical
  simp only [luckySet, Finset.union_eq_empty, Finset.image_eq_empty, Finset.filter_eq_empty_iff,
    Finset.mem_univ, true_implies]
  tauto

theorem roundCred_eq_empty_of_unasked (hno : ∀ h : Fin 6 × Fin n, ¬ ∃ r, Asked p ω (honestQ tag G W ω h) r)
    (C : KState n) (r : ℕ) : roundCred p ω tag G W C r = KState.empty := by
  classical
  have hf : ∀ h : Fin 6 × Fin n, ¬ FirstAt p ω (honestQ tag G W ω h) r := fun h hf => hno h ⟨r, hf.1⟩
  have h1 : ∀ v, ¬ FirstAt p ω (qH1 tag G W ω v) r := fun v => hf (0, v)
  have h2 : ∀ v, ¬ FirstAt p ω (qH2 tag G W ω v) r := fun v => hf (1, v)
  have h3 : ∀ v, ¬ FirstAt p ω (qP1 tag G W ω v) r := fun v => hf (2, v)
  have h4 : ∀ v, ¬ FirstAt p ω (qP2 tag G W ω v) r := fun v => hf (3, v)
  have h5 : ∀ v, ¬ FirstAt p ω (qI1 tag G W ω v) r := fun v => hf (4, v)
  have h6 : ∀ v, ¬ FirstAt p ω (qI2 tag G W ω v) r := fun v => hf (5, v)
  simp [roundCred, KState.empty, h1, h2, h3, h4, h5, h6]

theorem credUpTo3_eq_empty (hno : ∀ h : Fin 6 × Fin n, ¬ ∃ r, Asked p ω (honestQ tag G W ω h) r) :
    ∀ r, credUpTo3 p ω tag G W r = KState.empty
  | 0 => rfl
  | r + 1 => by
    rw [credUpTo3, credUpTo3_eq_empty hno r, roundCred_eq_empty_of_unasked p ω tag G W hno]
    rfl

theorem luckyBits_eq_zero {D Q : ℕ} (h : luckySet p ω tag G W D Q = ∅) : luckyBits p ω tag G W D = 0 := by
  classical
  obtain ⟨hno, hhit, hout⟩ := (luckySet_eq_empty_iff p ω tag G W D Q).1 h
  have hc : cred3 p ω tag G W D =
      (credUpTo3 p ω tag G W D).union ⟨⟨∅, ∅, creditedOut p ω tag G W D⟩, ∅, ∅⟩ := rfl
  rw [hout, credUpTo3_eq_empty p ω tag G W hno D] at hc
  simp [luckyBits, hc, hhit, KState.size, ColState.size, KState.union, KState.empty]

end Empty

open Classical in
/-- **`AdaptiveMinEntropy`'s inequality holds at `S = ∅`, for every instance.** -/
theorem adaptiveMinEntropy_empty {n wc D Q : ℕ} (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) :
    (∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = ∅), 2 ^ luckyBits p ω tag G W D) *
        (2 ^ (n * wc) - 2 * (n * (Q + 1) + 2 * n)) ^ (∅ : Finset (ℕ × ℕ)).card ≤
      (2 * 2 ^ (n * wc)) ^ (∅ : Finset (ℕ × ℕ)).card * Fintype.card (p3ModelT n wc).Ω := by
  simp only [Finset.card_empty, pow_zero, mul_one, one_mul]
  calc ∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = ∅), 2 ^ luckyBits p ω tag G W D
      = ∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = ∅), 1 := by
        refine Finset.sum_congr rfl fun ω hω => ?_
        rw [luckyBits_eq_zero p ω tag G W (Finset.mem_filter.1 hω).2, pow_zero]
    _ ≤ Fintype.card (p3ModelT n wc).Ω := by
        rw [Finset.sum_const, smul_eq_mul, mul_one]
        exact (Finset.card_filter_le _ _).trans (le_of_eq Finset.card_univ)

end PousAssembly

