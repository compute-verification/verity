      · exact ⟨T, by omega, x, hx, heq⟩

/-- Every complete v6 seed has a concrete showing pointer. -/
theorem v6Seed_source {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {a : VAtom B}
    (ha : a ∈ R.seedAtoms (R.v6Seeds π)) :
    ∃ τ ≤ R.D, ∃ x ∈ R.basisAt π τ, x.atom = a := by
  have hl := R.v6SeedsThrough_labs_empty π (R.D + 1)
  have hl' : (R.v6Seeds π).labs = ∅ := by simpa [v6Seeds] using hl
  unfold seedAtoms at ha
  rw [hl', Finset.image_empty, Finset.union_empty] at ha
  rcases Finset.mem_union.1 ha with ha | ha
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.1 ha
    obtain ⟨τ, hτ, x, hx, heq⟩ := R.v6SeedsThrough_r_source π hq
    exact ⟨τ, by omega, x, hx, heq⟩
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.1 ha
    obtain ⟨τ, hτ, x, hx, heq⟩ :=
      R.v6SeedsThrough_h_source π (Finset.mem_filter.1 hq).1
    exact ⟨τ, by omega, x, hx, heq⟩

theorem recordsFold_r_source (R : ChainReplay B ℓ c)
