  card_shortRows_seg (by norm_num) (by norm_num)

theorem weighted_cert_hyp_14 :
    ((448 * 2 ^ 9 - 448 * 5 - 1 : ℕ) : ℚ) + (shortRows (bandSegDAG 448 (2 ^ 9) 12) Finset.univ 5).card <
      ((448 * 2 ^ 9 : ℕ) : ℚ) := by
  rw [shortRows_seg_14]; norm_num

