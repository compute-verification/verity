  have hhalf : (2 : ℝ≥0∞)⁻¹ = ENNReal.ofReal 2⁻¹ := by
    rw [ENNReal.ofReal_inv_of_pos (by norm_num), ENNReal.ofReal_ofNat]
  have hδ : ENNReal.ofReal (Params.δ : ℝ) < 2⁻¹ := by
    rw [hhalf]
    exact (ENNReal.ofReal_lt_ofReal_iff (by norm_num)).2 (by norm_num [Params.δ])
  calc ENNReal.ofReal (Params.δ : ℝ) + ε ≤ ENNReal.ofReal (Params.δ : ℝ) + 2⁻¹ :=
        add_le_add le_rfl hε2
    _ < 2⁻¹ + 2⁻¹ := ENNReal.add_lt_add_right (by simp) hδ
    _ = 1 := ENNReal.inv_two_add_inv_two

