/-! ════ DenseReCert ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# Dense scheme re-certificate at the 64 KB operating point, and the multi-segment lemma

Re-certifies `PousDenseChain.denseScheme` (the random-oracle dense single-layer scheme, `DenseMeets.lean`) at the point the
end-to-end memo proposes (`docs/scheme-choice-e2e.md`): **64 KB labels** (`ℓ = 524288` bits), **512 blocks per segment**
(`B = 2^9`), **D = 5** rounds, `Q = 2^20`, targeting **k = 106**. All machinery — `dense_timedINC` (generic in
`(B, ℓ, D, Q, β)`), `PousTargetsDense.theorem1_ii_seq`, `p₀`, and the certificate helpers — is reused verbatim from
`DenseMeets.lean`; only the numeric certificate lemmas are new.

Certificate at this point: `S = ⌊(18/19)·2^28⌋ = 254307274`, `β = 265783012`.
- Union term `|Hist|·π ≤ 2^-128` exactly: with `(B(Q+1)+B)^2 ≤ 2^59`, the exponent is
  `(524288−59)·507 − (9·106 + 9 + β) = 128`.
- Sampling term `p₀^106 ≤ 1%`: `p₀ = 1 − 11475226/268435456 = 256960230/268435456 ≈ 0.957252`, and `p₀^106 ≈ 0.00975`
  (while `p₀^105 ≈ 0.0102 > 1%`, so `k = 106` is tight, matching the memo).

Everything is in the random-oracle model. The multi-segment lemma (`dense_meets_multi`) composes `N` independent,
distinct-tagged segments; it is structured so the concrete overwrite-chain `H` (`ChainExPostFacto`, `sponge-dense`) can
replace the random oracle segment-by-segment without touching the composition.
-/

namespace Pous.DenseReCert

open Pous PousDenseChain Pous.Labelling
open scoped ENNReal

set_option maxRecDepth 4000

/-! ### Piece 1: the numeric re-certificate at 64 KB, B = 512, D = 5, k = 106 -/

/-- `|Hist|·π ≤ 2^-128` at `B = 2^9`, `ℓ = 524288`, `D = 5`, `Q = 2^20`, `k = 106`, `β = 265783012`. -/
theorem dense_union_term_64 :
    (∑ j ∈ Finset.range 106, ((2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) *
      (((2 ^ 9 : ℕ) : ℝ≥0∞) * 2 ^ 265783012 *
        (((((2 ^ 9) * (2 ^ 20 + 1) + 2 ^ 9) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ 524288) ^ (2 ^ 9 - 5 - 1 + 1)) ≤
      (2⁻¹ : ℝ≥0∞) ^ 128 := by
  have he : 2 ^ 9 - 5 - 1 + 1 = 507 := by norm_num
  have hsq : ((2 ^ 9) * (2 ^ 20 + 1) + 2 ^ 9) ^ 2 ≤ 2 ^ 59 := by norm_num
  have h9 : ((2 ^ 9 : ℕ) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ 9 := by norm_num
  rw [he]
  calc _ ≤ ((2 ^ 9 : ℕ) : ℝ≥0∞) ^ 106 *
        (((2 ^ 9 : ℕ) : ℝ≥0∞) * 2 ^ 265783012 * ((2⁻¹ : ℝ≥0∞) ^ (524288 - 59)) ^ 507) := by
        gcongr
        · exact sum_pow_le _ _ (by norm_num)
        · exact sq_div_two_pow_le _ 59 524288 hsq (by norm_num)
    _ = (2 : ℝ≥0∞) ^ (9 * 106) *
          ((2 : ℝ≥0∞) ^ 9 * 2 ^ 265783012 * (2⁻¹ : ℝ≥0∞) ^ ((524288 - 59) * 507)) := by
        rw [h9, ← pow_mul, ← pow_mul]
    _ = (2⁻¹ : ℝ≥0∞) ^ ((524288 - 59) * 507 - (9 * 106 + 9 + 265783012)) :=
        two_pow_combine _ _ _ _ (by norm_num)
    _ ≤ (2⁻¹ : ℝ≥0∞) ^ 128 := pow_le_pow_right_of_le_one' (by norm_num) (by norm_num)

/-- `p₀^106 ≤ 1%` at `β = 265783012`, `S = 254307274`, `B = 2^9`, `ℓ = 524288`. -/
theorem dense_sampling_term_64 :
    ENNReal.ofReal (p₀ 265783012 254307274 (2 ^ 9) 524288) ^ 106 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  have h0 : 0 ≤ p₀ 265783012 254307274 (2 ^ 9) 524288 := by unfold p₀; norm_num
  rw [← ENNReal.ofReal_pow h0]
  refine ENNReal.ofReal_le_ofReal ?_
  unfold p₀
  norm_num [Params.δ]

/-- `S = ⌊(18/19)·2^28⌋ = 254307274` at `|C| = 2^9·524288 = 2^28`. -/
theorem stateBound_dense_64 : (denseScheme (2 ^ 9) 524288).stateBound Params.ρ = 254307274 := by
  show ⌊Params.ρ * (((2 ^ 9) * 524288 : ℕ) : ℚ)⌋₊ = 254307274
  rw [Nat.floor_eq_iff (by norm_num [Params.ρ])]
  norm_num [Params.ρ]

/-- **The dense scheme meets the requirement at the 64 KB point**, random-oracle `H`, with sequential reveal, `D = 5`
rounds, `Q = 2^20`, `k = 106` challenges and `ε = 2^-128`: correct, rate 1, and every `⌊ρ|C|⌋`-bit adversary is accepted
with probability at most `1% + 2^-128`. -/
theorem dense_meets_64 :
    Pous.Meets (denseScheme (2 ^ 9) 524288) .sequential 5 (2 ^ 20) 106 ((2⁻¹ : ENNReal) ^ 128) := by
  refine ⟨le_rfl, denseScheme_correct _ _, le_rfl, ?_, ?_⟩
  · show (((2 ^ 9 * 524288 + 0 : ℕ)) : ℚ) ≤ Pous.Params.expansion * ((2 ^ 9 * 524288 : ℕ) : ℚ)
    norm_num [Pous.Params.expansion]
  · intro W A₁ A₂
    refine (PousTargetsDense.theorem1_ii_seq (denseScheme (2 ^ 9) 524288) 5 (2 ^ 20) 265783012
      ((denseScheme (2 ^ 9) 524288).stateBound Pous.Params.ρ) 106 _
      (dense_timedINC (2 ^ 9) 524288 5 (2 ^ 20) 265783012 (by norm_num)) W A₁ A₂).trans ?_
    rw [stateBound_dense_64, add_comm]
    exact add_le_add dense_sampling_term_64 dense_union_term_64

/-! ### Piece 2: the disjoint-union pebbling lemma for many segments

The 14 GB store is `N` independent segments of `B` blocks each, laid out on `Fin (N*B)` with **global** block indices, so
segment `s`'s block `i` is node `s*B + i`. Because the index is global, the random oracle's query key `(node, parents)`
already distinguishes segments — this is the "distinct segment tags" of §20, provided here by global indexing rather than
an explicit tag. `segDAG N B` is the disjoint union of `N` complete DAGs: a node's parents are the *earlier blocks of its
own segment*. The pebbling lemma below (`seg_hard`) extends `complete_hard`: since each round advances at most one node per
segment, `s` pebbles reach at most `s + N*D` nodes in `D` rounds, so the disjoint union is `(N*B − N*D − 1, D, N*B)`-hard.

This is the model half a multi-segment `Meets` needs: it plugs into `Pous.Guarantees.B5ExPostFactoBounded` (giving
`π = (N*B)·2^β·(((N*B)(Q+1)+(N*B))²/2^ℓ)^(N*B − N*D)`) exactly as `complete_hard` does for one segment, then
`PousTargetsDense.theorem1_ii_seq` and a certificate. At 14 GB the instantiation is `N = 448`, `B = 2^9`, `ℓ = 524288`
(each segment `2^28` bits = 32 MiB, `448·32 MiB = 14 GB`). Kept in the random-oracle model; the concrete overwrite-chain
`H` slots in by replacing the oracle, leaving `segDAG`/`seg_hard` untouched. -/

/-- The disjoint union of `N` complete DAGs on `B` blocks, on global indices `Fin (N*B)`: node `k`'s parents are the
earlier blocks of its own segment (`j/B = k/B` and `j < k`). -/
def segDAG (N B : ℕ) : Labelling.TopoDAG (N * B) where
  par k := Finset.univ.filter fun j => j.val / B = k.val / B ∧ j.val < k.val
  par_lt _ _ hj := (Finset.mem_filter.1 hj).2.2

/-- **Disjoint-union reach.** From `P₀` pebbles, `D` rounds pebble at most `P₀.card + N*D` nodes: each round adds at most
one node per segment (a second new node of a segment would be a parent of the later one, hence already reached). -/
theorem card_reach_seg (N B : ℕ) (P₀ : Finset (Fin (N * B))) :
    ∀ r, (reach (segDAG N B) P₀ r).card ≤ P₀.card + N * r
  | 0 => by rw [reach]; omega
  | r + 1 => by
    have ih := card_reach_seg N B P₀ r
    have hnew : ((Finset.univ.filter fun v => (segDAG N B).par v ⊆ reach (segDAG N B) P₀ r) \
        reach (segDAG N B) P₀ r).card ≤ N := by
      have hmap : Set.InjOn (fun v : Fin (N * B) => v.val / B)
          ↑((Finset.univ.filter fun v => (segDAG N B).par v ⊆ reach (segDAG N B) P₀ r) \
            reach (segDAG N B) P₀ r) := by
        intro a ha b hb hab
        simp only [Finset.coe_sdiff, Set.mem_diff, Finset.mem_coe, Finset.mem_filter] at ha hb
        by_contra hne
        rcases lt_or_gt_of_ne (fun h => hne (Fin.ext h)) with h | h
        · exact ha.2 (hb.1.2 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hab, h⟩))
        · exact hb.2 (ha.1.2 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hab.symm, h⟩))
      calc _ ≤ (Finset.image (fun v : Fin (N * B) => v.val / B)
              ((Finset.univ.filter fun v => (segDAG N B).par v ⊆ reach (segDAG N B) P₀ r) \
                reach (segDAG N B) P₀ r)).card := (Finset.card_image_of_injOn hmap).ge
        _ ≤ (Finset.range N).card := by
            apply Finset.card_le_card
            intro x hx
            simp only [Finset.mem_image] at hx
            obtain ⟨v, _, rfl⟩ := hx
            have hlt : v.val < B * N := by rw [Nat.mul_comm B N]; exact v.isLt
            exact Finset.mem_range.2 (Nat.div_lt_of_lt_mul hlt)
        _ = N := by rw [Finset.card_range]
    rw [reach, ← Finset.union_sdiff_self_eq_union]
    calc _ ≤ (reach (segDAG N B) P₀ r).card +
          ((Finset.univ.filter fun v => (segDAG N B).par v ⊆ reach (segDAG N B) P₀ r) \
            reach (segDAG N B) P₀ r).card := Finset.card_union_le _ _
      _ ≤ P₀.card + N * (r + 1) := by rw [Nat.mul_succ]; omega

/-- **The disjoint union of `N` complete DAGs on `B` blocks is `(N*B − N*D − 1, D, N*B)`-hard**, every block a challenge.
This is `complete_hard` extended to many segments; with global block indices it is the §20 distinct-tag structure. -/
theorem seg_hard (N B D : ℕ) (hN : 0 < N) (hD : D + 1 ≤ B) :
    PebblingHard (segDAG N B) Finset.univ (N * B - N * D - 1) D (N * B) := by
  intro P₀ hP₀
  have hmul : N * D + N ≤ N * B := by
    calc N * D + N = N * (D + 1) := by ring
      _ ≤ N * B := Nat.mul_le_mul (le_refl N) hD
  calc (Finset.univ.filter fun c => c ∈ reach (segDAG N B) P₀ D).card
      ≤ (reach (segDAG N B) P₀ D).card := Finset.card_le_card fun c hc => (Finset.mem_filter.1 hc).2
    _ ≤ P₀.card + N * D := card_reach_seg N B P₀ D
    _ < N * B := by omega

/-! ### Piece 2 (continued): the segmented scheme and its `Meets` at 14 GB

The disjoint-union scheme `segScheme N B ℓ` is `denseScheme` on `segDAG N B` (global block indices), so decoding a block
queries only its own segment's `≤ B` earlier blocks. `seg_timedINC` is the B5 glue with `seg_hard`, and the certificate at
`N = 448`, `B = 2^9`, `ℓ = 524288` gives **14 GB** (`448·2^28` bits) with **k = 106**, `β = 119067414778`,
`S = ⌊(18/19)·N·B·ℓ⌋ = 113929658799`. -/

/-- The dense scheme on the disjoint union of `N` complete DAGs of `B` blocks: `segDAG N B` in place of `completeDAG`. -/
def segScheme (N B ℓ : ℕ) [NeZero (N * B)] : Scheme (denseModel (N * B) ℓ) where
  n := (N * B) * ℓ
  t := 0
  B := N * B
  ℓ := ℓ
  B_pos := Nat.pos_of_ne_zero (NeZero.ne (N * B))
  Coins := Unit
  enc W H _ := (fun i => i.elim0, fun i => label (segDAG N B) (blocks (N * B) ℓ W) H i)
  dec _ C f := codeEquiv (N * B) ℓ fun i =>
    bxor (C i) (f (i, fun j => if j ∈ (segDAG N B).par i then some (C j) else none))

/-- Bit-exact public decoding for the segmented scheme. -/
theorem segScheme_correct (N B ℓ : ℕ) [NeZero (N * B)] : (segScheme N B ℓ).Correct := by
  intro (W : Bits ((N * B) * ℓ)) (H : LabelQry (N * B) ℓ → Bits ℓ) _
  show codeEquiv (N * B) ℓ (fun i => bxor (label (segDAG N B) (blocks (N * B) ℓ W) H i)
    (H (i, fun j => if j ∈ (segDAG N B).par i then some (label (segDAG N B) (blocks (N * B) ℓ W) H j)
      else none))) = W
  have h : ∀ i, bxor (label (segDAG N B) (blocks (N * B) ℓ W) H i)
      (H (i, fun j => if j ∈ (segDAG N B).par i then some (label (segDAG N B) (blocks (N * B) ℓ W) H j)
        else none)) = blocks (N * B) ℓ W i := by
    intro i
    rw [PousB5Chain.label_eq]
    exact bxor_bxor_self _ _
  rw [funext h]
  exact (codeEquiv (N * B) ℓ).apply_symm_apply W

/-- **B5 gives `TimedINC` for the segmented scheme**: `π = (N*B)·2^β·(((N*B)(Q+1)+(N*B))²/2^ℓ)^(N*B − N*D)`. -/
theorem seg_timedINC (N B ℓ D Q β : ℕ) [NeZero (N * B)] (hN : 0 < N) (hD : D + 1 ≤ B) :
    TimedINC (segScheme N B ℓ) D Q β
      (((N * B : ℕ) : ℝ≥0∞) * 2 ^ β *
        (((((N * B) * (Q + 1) + (N * B)) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ ℓ) ^ (N * B - N * D - 1 + 1)) := by
  classical
  intro W cmp exp hexp
  have hB5 := PousB5Chain.b5_ex_post_facto_bounded (N * B) ℓ β (N * B - N * D - 1) D Q (N * B)
    (segDAG N B) Finset.univ (blocks (N * B) ℓ W) (seg_hard N B D hN hD)
    (fun H => cmp W (fun i => i.elim0) (fun i => label (segDAG N B) (blocks (N * B) ℓ W) H i) H)
    (fun σ i => exp W (fun i => i.elim0) σ i) (fun σ i => hexp W _ σ i)
  rw [Finset.card_univ, Fintype.card_fin] at hB5
  refine le_trans (le_of_eq_of_le (PousThm1Dense.pr_fst (β := Unit) (fun H : LabelQry (N * B) ℓ → Bits ℓ =>
    ∀ i, (exp W (fun i => i.elim0)
      (cmp W (fun i => i.elim0) (fun i => label (segDAG N B) (blocks (N * B) ℓ W) H i) H)
      i).run H = label (segDAG N B) (blocks (N * B) ℓ W) H i)) (pr_mono fun H hH => ?_)) hB5
  refine le_trans (le_of_eq (by rw [Finset.card_univ, Fintype.card_fin]))
    (Finset.card_le_card (s := Finset.univ) fun c _ => Finset.mem_filter.2 ⟨Finset.mem_univ _, hH c⟩)

instance instNeZeroHMulOfNatHPow_pous : NeZero (448 * 2 ^ 9) := ⟨by norm_num⟩

/-- `|Hist|·π ≤ 2^-128` at `N = 448`, `B = 2^9`, `ℓ = 524288`, `D = 5`, `Q = 2^20`, `k = 106`, `β = 119067414778`.
`N*B = 229376 ≤ 2^18`, `(N*B(Q+1)+N*B)^2 ≤ 2^76`, and the exponent `(524288−76)·227136 − (18·106 + 18 + β) = 128`. -/
theorem seg_union_term_14 :
    (∑ j ∈ Finset.range 106, ((448 * 2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) *
      (((448 * 2 ^ 9 : ℕ) : ℝ≥0∞) * 2 ^ 119067414778 *
        (((((448 * 2 ^ 9) * (2 ^ 20 + 1) + 448 * 2 ^ 9) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ 524288) ^
          (448 * 2 ^ 9 - 448 * 5 - 1 + 1)) ≤
      (2⁻¹ : ℝ≥0∞) ^ 128 := by
  have he : 448 * 2 ^ 9 - 448 * 5 - 1 + 1 = 227136 := by norm_num
  have hsq : ((448 * 2 ^ 9) * (2 ^ 20 + 1) + 448 * 2 ^ 9) ^ 2 ≤ 2 ^ 76 := by norm_num
  have hNn : ((448 * 2 ^ 9 : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 18 := by norm_num
  rw [he]
  calc _ ≤ ((2 : ℝ≥0∞) ^ 18) ^ 106 *
        (((2 : ℝ≥0∞) ^ 18) * 2 ^ 119067414778 * ((2⁻¹ : ℝ≥0∞) ^ (524288 - 76)) ^ 227136) := by
        gcongr
        · exact (sum_pow_le _ _ (by norm_num)).trans (pow_le_pow_left' hNn 106)
        · exact sq_div_two_pow_le _ 76 524288 hsq (by norm_num)
    _ = (2 : ℝ≥0∞) ^ (18 * 106) *
          ((2 : ℝ≥0∞) ^ 18 * 2 ^ 119067414778 * (2⁻¹ : ℝ≥0∞) ^ ((524288 - 76) * 227136)) := by
        rw [← pow_mul, ← pow_mul]
    _ = (2⁻¹ : ℝ≥0∞) ^ ((524288 - 76) * 227136 - (18 * 106 + 18 + 119067414778)) :=
        two_pow_combine _ _ _ _ (by norm_num)
    _ ≤ (2⁻¹ : ℝ≥0∞) ^ 128 := pow_le_pow_right_of_le_one' (by norm_num) (by norm_num)

/-- `p₀^106 ≤ 1%` at `β = 119067414778`, `S = 113929658799`, `B = 448·2^9`, `ℓ = 524288`. -/
theorem seg_sampling_term_14 :
    ENNReal.ofReal (p₀ 119067414778 113929658799 (448 * 2 ^ 9) 524288) ^ 106 ≤
      ENNReal.ofReal (Params.δ : ℝ) := by
  have h0 : 0 ≤ p₀ 119067414778 113929658799 (448 * 2 ^ 9) 524288 := by unfold p₀; norm_num
  rw [← ENNReal.ofReal_pow h0]
  refine ENNReal.ofReal_le_ofReal ?_
  unfold p₀
  norm_num [Params.δ]

/-- `S = ⌊(18/19)·448·2^9·524288⌋ = 113929658799` at 14 GB. -/
theorem stateBound_seg_14 : (segScheme 448 (2 ^ 9) 524288).stateBound Params.ρ = 113929658799 := by
  show ⌊Params.ρ * (((448 * 2 ^ 9) * 524288 : ℕ) : ℚ)⌋₊ = 113929658799
  rw [Nat.floor_eq_iff (by norm_num [Params.ρ])]
  norm_num [Params.ρ]

/-- **The segmented dense scheme meets the requirement at 14 GB** (`N = 448` segments of `2^9` blocks of 64 KB),
random-oracle `H`, sequential reveal, `D = 5`, `Q = 2^20`, `k = 106`, `ε = 2^-128`. Same `k` as one segment: the audit
soundness is per-block, so it does not degrade with the number of segments. -/
theorem seg_meets_14 :
    Pous.Meets (segScheme 448 (2 ^ 9) 524288) .sequential 5 (2 ^ 20) 106 ((2⁻¹ : ENNReal) ^ 128) := by
  refine ⟨le_rfl, segScheme_correct _ _ _, le_rfl, ?_, ?_⟩
  · show ((((448 * 2 ^ 9) * 524288 + 0 : ℕ)) : ℚ) ≤ Pous.Params.expansion * (((448 * 2 ^ 9) * 524288 : ℕ) : ℚ)
    norm_num [Pous.Params.expansion]
  · intro W A₁ A₂
    have hINC := seg_timedINC 448 (2 ^ 9) 524288 5 (2 ^ 20) 119067414778 (by norm_num) (by norm_num)
    refine (PousTargetsDense.theorem1_ii_seq (segScheme 448 (2 ^ 9) 524288) 5 (2 ^ 20) 119067414778
      ((segScheme 448 (2 ^ 9) 524288).stateBound Pous.Params.ρ) 106 _ hINC W A₁ A₂).trans ?_
    rw [stateBound_seg_14, add_comm]
    exact add_le_add seg_sampling_term_14 seg_union_term_14

/-! ### Edge cases and satisfiability witnesses (the `DecodeHyp3` lesson)

P3's lesson: a hypothesis can be vacuously satisfiable (`ColumnHard` with `k > n`, premise never met) or a statement can
be false on degenerate instances (a binomial position term at `n = 0` or tiny `Q`). The dense theorems are checked here.

* **No binomial term, so no `Q`/`n` degeneracy.** The dense and segmented bounds are `(∑_{j<k} B^j)·π + p₀^k` (B5 +
  `theorem1_ii_seq`) — there is **no** `C(·,·)` position factor, so the "false at `n = 0` / tiny `Q`" failure mode does
  not exist. The collision `((B(Q+1)+B)²/2^ℓ)^(s+1)` is monotone increasing in `Q`, so a smaller `Q` only shrinks the
  union term; no lower bound on `Q` is needed (`dense_timedINC`/`seg_timedINC` are proved for every `Q`).
* **`k` vs `B` — non-vacuity of the pebbling lemma.** `PebblingHard G univ s D k` is non-vacuous only for `k ≤ |univ|`:
  if `k > N*B` the conclusion `filter.card < k` is automatic (`filter.card ≤ |univ| = N*B < k`), exactly P3's `k > n`
  vacuity. `seg_hard` uses `k = N*B` **exactly** (tight), and the audit `k = 106 < B = 512 ≤ N*B`, so neither route is
  vacuous. -/

/-- The audit `k = 106` is below one segment's block count `B = 2^9`, so no `k > B` vacuity in the audit. -/
theorem audit_k_lt_B : (106 : ℕ) < 2 ^ 9 := by norm_num

/-- **Satisfiability witness** for `seg_hard`/`seg_timedINC`'s `hN : 0 < N` and `hD : D + 1 ≤ B`, at the 14 GB point.
`k = N*B = 229376 > 0` and it equals `|univ|`, so the conclusion is a genuine (tight, non-vacuous) `PebblingHard`. -/
theorem seg_hard_14 :
    PebblingHard (segDAG 448 (2 ^ 9)) Finset.univ (448 * 2 ^ 9 - 448 * 5 - 1) 5 (448 * 2 ^ 9) :=
  seg_hard 448 (2 ^ 9) 5 (by norm_num) (by norm_num)

/-- **Satisfiability witness** for the `[NeZero (N*B)]` instance the segmented scheme takes. -/
theorem segNeZero_witness : NeZero (448 * 2 ^ 9) := inferInstance

/-- **`hN : 0 < N` is necessary, not merely convenient.** At `N = 0` the challenge count `N*B = 0`, and
`PebblingHard _ _ _ _ 0` is false: the empty holding already fails `0 < 0`. So dropping `hN` makes `seg_hard` false, not
vacuously true. -/
theorem seg_hard_needs_hN :
    ¬ PebblingHard (segDAG 0 (2 ^ 9)) Finset.univ (0 * 2 ^ 9 - 0 * 5 - 1) 5 (0 * 2 ^ 9) := by
  intro h
  have hc := h ∅ (by simp)
  simp only [Nat.zero_mul] at hc
  exact Nat.not_lt_zero _ hc

/-- **`hD : D + 1 ≤ B` is necessary.** With `D ≥ B` (here `N = B = D = 1`), one round already pebbles the whole segment
from nothing, so all `N*B` challenges are reached and `PebblingHard` fails. -/
theorem seg_hard_needs_hD :
    ¬ PebblingHard (segDAG 1 1) Finset.univ (1 * 1 - 1 * 1 - 1) 1 (1 * 1) := by
  intro h
  have hc := h ∅ (by simp)
  revert hc
  decide

/-! ### Piece 3: alignment with the implementation's per-segment tagged domains (PR #166, D1–D5)

The reference codec domain-separates each segment `s` by `tag_s = salt ‖ u64 s` — a **192-bit** salt then `u64 s`, exactly
`chainDense`'s 256-bit salt slot (`chainDense B ℓ 512 (dom tag_s)`, `PROTOCOL.md`) — whereas `segScheme` keys the oracle by
the **global** block index. These are the *same* domain separation. `segIndexEquiv` shows the global index is exactly the
`(segment, block)` pair (a bijection), and `tag_injective` shows distinct segments get distinct tags (for `N ≤ 2^64`, from
`u64` alone). Then `domainSep_equiv` shows the per-segment tagged keying `(s, i) ↦ (tag_s, i)` is the global-index keying
followed by an **injective relabeling** — so it separates the blocks exactly as global indices do. Hence `seg_meets_14`
(proved with global indices) holds verbatim for the implementation's per-segment domains, and all witnesses and necessity
proofs above are unchanged.

**Salt-entropy independence.** Nothing here needs the salt to carry more than 128 bits of entropy — in fact it needs
none. The audit bound `2^-128` in `dense_meets_64`/`seg_meets_14` comes entirely from the union term (see
`dense_union_term_64`/`seg_union_term_14`); those theorems do not mention the salt. Inter-segment separation
(`tag_injective`, `domainSep_equiv`) comes from `u64 s`, not from salt entropy — the salt enters only as the opaque first
argument of `Fin.append` and its value is never used. So any salt width (here 192 bits) works; the salt only separates
*instances*/deployments, which is outside this per-store bound. -/

/-- The global block index is exactly the `(segment, block)` pair. -/
def segIndexEquiv (N B : ℕ) : Fin N × Fin B ≃ Fin (N * B) := finProdFinEquiv



theorem u64_inj {a b : ℕ} (ha : a < 2 ^ 64) (hb : b < 2 ^ 64)
    (h : ∀ j : Fin 64, a.testBit j.val = b.testBit j.val) : a = b := by
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < 64
  · exact h ⟨i, hi⟩
  · push_neg at hi
    rw [Nat.testBit_eq_false_of_lt (lt_of_lt_of_le ha (Nat.pow_le_pow_right (by norm_num) hi)),
      Nat.testBit_eq_false_of_lt (lt_of_lt_of_le hb (Nat.pow_le_pow_right (by norm_num) hi))]

/-- **Distinct segments get distinct tags** (`N ≤ 2^64`): `salt ‖ u64 s` is injective in `s`. -/
theorem tag_injective (salt : Bits 192) {N : ℕ} (hN : N ≤ 2 ^ 64) :
    Function.Injective (fun s : Fin N => tag salt s.val) := by
  intro s t h
  refine Fin.ext (u64_inj (lt_of_lt_of_le s.isLt hN) (lt_of_lt_of_le t.isLt hN) (fun j => ?_))
  have hj := congrFun h (Fin.natAdd 192 j)
  simpa [tag, u64, Fin.append_right] using hj

/-- **Distinct tags give the same domain separation as global indices.** The per-segment tagged keying
`(s, i) ↦ (tag_s, i)` is the global-index keying (`segIndexEquiv`) composed with an injective relabeling `t`. So keying by
`tag_s = salt ‖ u64 s` separates the `N·B` blocks exactly as global indices do; `seg_meets_14` transfers verbatim. -/
theorem domainSep_equiv (N B : ℕ) (hN : N ≤ 2 ^ 64) (salt : Bits 192) :
    ∃ t : Fin (N * B) → Bits (192 + 64) × Fin B, Function.Injective t ∧
      ∀ p : Fin N × Fin B, (tag salt p.1.val, p.2) = t (segIndexEquiv N B p) := by
  refine ⟨fun g => (tag salt ((segIndexEquiv N B).symm g).1.val, ((segIndexEquiv N B).symm g).2), ?_, ?_⟩
  · intro g₁ g₂ h
    simp only [Prod.mk.injEq] at h
    exact (segIndexEquiv N B).symm.injective (Prod.ext (tag_injective salt hN h.1) h.2)
  · intro p
    simp only [Equiv.symm_apply_apply]

/-- **Satisfiability witness** at 14 GB: `N = 448 ≤ 2^64`, so the implementation's tags `salt ‖ u64 s` are distinct across
the 448 segments — the hypothesis `hN` of `domainSep_equiv`/`tag_injective` holds, and the alignment applies. -/
theorem tag_injective_14 (salt : Bits 192) : Function.Injective (fun s : Fin 448 => tag salt s.val) :=
  tag_injective salt (by norm_num)

end Pous.DenseReCert

end


/-! ════ BandMultiModel ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# The band scheme at 14 GB: many 32 MiB segments over the overwrite chain (statements)

Definitions and targets only. `BandMulti.lean` imports this file unchanged and proves the targets; `BandMultiV3.lean`
carries them to the v3 compression deliverables.

**The layout.** The store is `N` segments of `B` blocks of `ℓ` bits, on global indices `Fin (N * B)`: segment `s`'s
block `i` is node `s·B + i` (`gIdx`). `bandSegDAG N B d` is the disjoint union of `N` copies of `bandDAG B d`: a node's
parents are the at most `d` preceding blocks **of its own segment**. At `N = 448`, `B = 2^9`, `ℓ = 524288` (64 KiB
labels) each segment is `2^28` bits = 32 MiB, and the store is `448 · 32 MiB` = 14 GB.

**The scheme** is `chainScheme` (`band-chain/BandChainModel.lean`) on `bandSegDAG`: one overwrite-chain row per block,
`C_v = key_Π₂(IV(dom v); C_par(v) newest first, pad) ⊕ W_v`, over one ideal permutation shared by all segments.
- `segDom salt B` is the implementation's per-segment tagged domain: block `i` of segment `s` is keyed by
  `dom (tag_s) i`, with `tag_s = salt ‖ u64 s` (`Pous.DenseReCert.tag`, PR #166's D1–D5).
- `SegFaithful` pins that this *is* `N` independent one-segment band codes: the label of `(s, i)` is block `i` of
  `chainBand B d` on segment `s`'s data, under segment `s`'s domain.

**Why no new ex-post-facto lemma is needed.** `ChainExPostFactoG` is stated for every `B` and every `TopoDAG B`, with the
win event counted jointly over all `B` blocks of one game against one permutation. The 14 GB store is one such game,
at `B := N·B` and `G := bandSegDAG N B d`. Cross-segment queries are inside it: the adversary's programs may query any
point, and the bound charges all of them against the one union.
The two places where the `JointClassWeight` lesson bites are hypotheses here:
- **Injective domains across segments.** `ChainExPostFactoG` needs `dom` injective on all `N·B` blocks, not per
  segment. `SharedDomainBreaks` shows this is necessary: with a salt shared by all segments and local indices,
  identical segments have identical labels, one segment's labels answer every challenge, and `Meets` is false.
- **Joint hardness.** The chain game on the union must be hard at the joint storage bound. `BandSegHard`: with
  `d ≥ D` a holding priced `s` knows at most `s + N·D` labels, so the union is `(N·B − N·D − 1, D, N·B)`-hard.

**The certificate.** `theorem1_ii_seq` needs `(Σ_{j<k} (N·B)^j) · chainPiSeg ≤ 2^-128` and `p₀^k ≤ 1%`, at
`S = ⌊ρ·N·B·ℓ⌋ = 113929658799`. With `N·B = 229376 ≤ 2^18`, `nPos² · N·B · 2 ≤ 2^95` and `nPos² ≤ 2^76`, the
largest `β` at `k = 111` is `119062574832` (`p₀^111 ≈ 0.0079`); at `k = 106` it is `119062574922`
(`p₀^106 ≈ 0.0098`), and `k = 105` fails (`p₀^105 ≈ 0.0103`). One segment needs `k = 111`: its loss `s = B − D − 1`
drops a whole block per segment, which the union amortizes over 448 segments.
-/

namespace Pous.BandMulti

open Pous Pous.Labelling Pous.Sponge PousSpongeChain Pous.BandChain
open scoped ENNReal

/-! ## 1. The layout, the domains, the scheme -/


/-- The global index of segment `s`'s block `i`: `s·B + i`. -/
def gIdx {N B : ℕ} (s : Fin N) (i : Fin B) : Fin (N * B) :=
  ⟨s.val * B + i.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left i.isLt _)
    (by rw [← Nat.succ_mul]; exact Nat.mul_le_mul_right _ s.isLt)⟩

/-- Segment `s`'s data: bits `s·B·ℓ … (s + 1)·B·ℓ − 1` of `W`. -/
def segData {N B ℓ : ℕ} (W : Bits (N * B * ℓ)) (s : Fin N) : Bits (B * ℓ) :=
  fun t => W ⟨s.val * (B * ℓ) + t.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left t.isLt _)
    (by rw [← Nat.succ_mul, Nat.mul_assoc]; exact Nat.mul_le_mul_right _ s.isLt)⟩


/-- **A shared domain, for the counterexample**: every segment keyed by the same salt and its local index. -/
def sharedDom (salt : Bits 256) (B : ℕ) (v : ℕ) : Bits 512 := Pous.Sponge.dom salt (v % B)


/-! ## 2. Faithfulness: the 14 GB code is `N` one-segment band codes -/

/-- **Target: the labels of the union are the segments' band labels.** On any chain function `f`, the label of global
block `(s, i)` is the one-segment band label of block `i`, with segment `s`'s domains and blocks. -/
def SegFaithful : Prop :=
  ∀ (N B d ℓ c : ℕ) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c) (Wb : Fin (N * B) → Bits ℓ)
    (s : Fin N) (i : Fin B),
    labelG (bandSegDAG N B d) f dom Wb (gIdx s i) =
      labelG (bandDAG B d) f (fun j => dom (s.val * B + j)) (fun j => Wb (gIdx s j)) i

/-- **Target: the deployed code is the segments' `chainBand` codes.** Under the per-segment tags, block `(s, i)` of the
14 GB code of `W` is block `i` of `chainBand B d ℓ 512 (dom tag_s)` on segment `s`'s data, for every permutation. -/
def SegFaithfulCode : Prop :=
  ∀ (N B d ℓ : ℕ) [NeZero (N * B)] [NeZero B] (salt : Bits 192) (W : Bits (N * B * ℓ))
    (π : Equiv.Perm (Bits (ℓ + (ℓ + 512)))) (s : Fin N) (i : Fin B),
    ((chainBandSeg N B d ℓ 512 (segDom salt B)).enc W π ()).2 (gIdx s i) =
      ((chainBand B d ℓ 512 (Pous.Sponge.dom (Pous.DenseReCert.tag salt s.val))).enc (segData W s) π ()).2 i

/-! ## 3. Joint hardness of the union, and why each hypothesis is needed -/

/-- **Target: the union of `N` bands with in-degree `d ≥ D` is `(N·B − N·D − 1, D, N·B)`-hard** in the chain game,
every block a challenge. Its short rows are the first `D` rows of each segment. -/
def BandSegHard : Prop :=
  ∀ (N B d D c ℓ : ℕ), 0 < N → D ≤ d → D + 1 ≤ B →
    ChainHard (bandSegDAG N B d) Finset.univ c ℓ ((N * B - N * D - 1 : ℕ) : ℚ) D (N * B)

/-- **Target: `0 < N` is needed**: with no segment there is no challenge, and hardness at `k = 0` is false. -/
def BandSegNeedsN : Prop :=
  ∀ (B d D c ℓ : ℕ), ¬ ChainHard (bandSegDAG 0 B d) Finset.univ c ℓ ((0 * B - 0 * D - 1 : ℕ) : ℚ) D (0 * B)

/-- **Target: `D + 1 ≤ B` is needed**: one segment of one block is known after one round from nothing. -/
def BandSegNeedsRoom : Prop :=
  ∀ c ℓ : ℕ, ¬ ChainHard (bandSegDAG 1 1 1) Finset.univ c ℓ ((1 * 1 - 1 * 1 - 1 : ℕ) : ℚ) 1 (1 * 1)

/-- **Target: `d ≥ D` is needed (the gap attack in every segment).** With `d + 1 ≤ D`, the holding of every label
except the positive multiples of `d + 1` within each segment, priced `N·B − N·⌊(B − 1)/(d + 1)⌋`, knows all `N·B`
labels after `D` rounds. -/
def BandSegGapAttack : Prop :=
  ∀ (N B d D c ℓ : ℕ), d + 1 ≤ D →
    ¬ ChainHard (bandSegDAG N B d) Finset.univ c ℓ ((N * B - N * ((B - 1) / (d + 1)) : ℕ) : ℚ) D (N * B)

/-- **Target: the gap attack at 14 GB**: in-degree `4` at `D = 5` is not `(N·B − 5N − 1, 5, N·B)`-hard. -/
def BandSegGapAttack14 : Prop :=
  ∀ c ℓ : ℕ,
    ¬ ChainHard (bandSegDAG 448 (2 ^ 9) 4) Finset.univ c ℓ ((448 * 2 ^ 9 - 448 * 5 - 1 : ℕ) : ℚ) 5 (448 * 2 ^ 9)

/-! ## 4. Into the `Meets` chain -/

/-- The ex-post-facto `π` of the union: `ChainExPostFactoG`'s right-hand side at `N·B` blocks, preprocessor width
`β`, and loss `s = N·B − N·D − 1`. At `N = 1` it is `chainPi`. -/
noncomputable def chainPiSeg (N B ℓ c D Q β : ℕ) : ℝ≥0∞ :=
  2 ^ β * 2 * ((((nPos (N * B) Q) ^ 2 * (N * B) * 2) ^ (N * B - N * D - 1 + 1) : ℕ) : ℝ≥0∞) /
      2 ^ (ℓ * (N * B - N * D - 1)) +
    (((nPos (N * B) Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c)

/-- **Target: the glue.** `ChainExPostFactoG` at `N·B` blocks and `BandSegHard` give `TimedINC` for the 14 GB scheme
at `chainPiSeg`, for every domain injective on all `N·B` blocks. -/
def BandSegTimedINC : Prop :=
  ChainExPostFactoG → ∀ (N B d ℓ c D Q β : ℕ) [NeZero (N * B)] (dom : ℕ → Bits c),
    0 < N → D ≤ d → D + 1 ≤ B → Function.Injective (fun i : Fin (N * B) => dom i) →
    TimedINC (chainBandSeg N B d ℓ c dom) D Q β (chainPiSeg N B ℓ c D Q β)


/-- **The 14 GB band deployment under the implementation's per-segment tags**: `448` segments of `2^9` blocks of
64 KiB, in-degree `d`, capacity 512, any 192-bit salt, sequential reveal, `D = 5`, `Q = 2^20`, `k = 111`,
`ε = 2^-128`. -/
def ChainBandMeets14 (d : ℕ) : Prop :=
  ∀ salt : Bits 192,
    Pous.Meets (chainBandSeg 448 (2 ^ 9) d 524288 512 (segDom salt (2 ^ 9))) .sequential 5 (2 ^ 20) 111
      ((2⁻¹ : ℝ≥0∞) ^ 128)

/-- **The same with one global salt and global indices** (`dom salt v`, `v < 229376`). -/
def ChainBandMeets14Global (d : ℕ) : Prop :=
  ∀ salt : Bits 256,
    Pous.Meets (chainBandSeg 448 (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)) .sequential 5 (2 ^ 20) 111
      ((2⁻¹ : ℝ≥0∞) ^ 128)

/-- **Target: the 14 GB deployment, given `ChainExPostFactoG`**, for every in-degree `d ≥ D = 5`, both domain
layouts. -/
def BandMeets14 : Prop := ChainExPostFactoG → ∀ d : ℕ, 5 ≤ d → ChainBandMeets14 d ∧ ChainBandMeets14Global d

/-- **Target: `k = 106` suffices at 14 GB** (per-segment tags), below one segment's `111`. -/
def BandMeets14K106 : Prop :=
  ChainExPostFactoG → ∀ d : ℕ, 5 ≤ d → ∀ salt : Bits 192,
    Pous.Meets (chainBandSeg 448 (2 ^ 9) d 524288 512 (segDom salt (2 ^ 9))) .sequential 5 (2 ^ 20) 106
      ((2⁻¹ : ℝ≥0∞) ^ 128)

/-! ## 5. Injective domains across segments are necessary -/

/-- **Target: a shared domain breaks the 14 GB store**, for every in-degree, round budget, `k` and `ε`. With
`sharedDom`, identical segments get identical labels, so storing segment 0's labels (`2^28` bits, far below the
`⌊ρ·|C|⌋` state) answers every challenge with no query, and the audit accepts with probability 1. -/
def SharedDomainBreaks : Prop :=
  ∀ (d : ℕ) (salt : Bits 256) (D Q k : ℕ) (ε : ℝ≥0∞),
    ¬ Pous.Meets (chainBandSeg 448 (2 ^ 9) d 524288 512 (sharedDom salt (2 ^ 9))) .sequential D Q k ε

end Pous.BandMulti

end


/-! ════ BandMulti ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# The band scheme at 14 GB: proofs

Proves every target of `BandMultiModel.lean`. `BandMeets14` and `BandMeets14K106` are conditional on
`ChainExPostFactoG`, by their statements; `BandMultiV3.lean` discharges it from the v3 compression deliverables.

- §1 segment arithmetic; §2 faithfulness (`labelG_seg`); §3 joint hardness (`card_shortRows_seg`, `band_seg_hard`)
  and the necessity of each side condition; §4 the glue and the certificate; §5 the shared-domain counterexample;
  §6 satisfiability witnesses.
-/

namespace Pous.BandMulti

open Pous Pous.Labelling Pous.Sponge PousSpongeChain Pous.BandChain
open scoped ENNReal

set_option maxRecDepth 8000

/-! ## 1. Segment arithmetic -/

section Arith

theorem seg_div {s i B : ℕ} (hi : i < B) : (s * B + i) / B = s := by
  rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega : 0 < B), Nat.div_eq_of_lt hi, Nat.zero_add]

theorem seg_mod {s i B : ℕ} (hi : i < B) : (s * B + i) % B = i := by
  rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hi]

/-- Quotient and remainder determine the number. -/
theorem divmod_inj {D a a' x x' : ℕ} (hx : x < D) (hx' : x' < D) (h : a * D + x = a' * D + x') :
    a = a' ∧ x = x' := by
  have h1 := seg_div (s := a) hx
  have h2 := seg_div (s := a') hx'
  rw [h] at h1
  have ha : a = a' := h1.symm.trans h2
  subst ha
  exact ⟨rfl, by omega⟩

/-- Two numbers are in the same segment iff the first lies in the second's block range. -/
theorem same_seg {B u v : ℕ} (hB : 0 < B) : u / B = v / B ↔ v / B * B ≤ u ∧ u < v / B * B + B := by
  constructor
  · intro h
    rw [← h]
    exact ⟨Nat.div_mul_le_self u B, Nat.lt_div_mul_add hB⟩
  · rintro ⟨h1, h2⟩
    exact Nat.div_eq_of_lt_le h1 (by rw [Nat.succ_mul]; exact h2)

variable {N B : ℕ}

theorem gIdx_val (s : Fin N) (i : Fin B) : (gIdx s i).val = s.val * B + i.val := rfl

theorem gIdx_div (s : Fin N) (i : Fin B) : (gIdx s i).val / B = s.val := seg_div i.isLt

theorem gIdx_mod (s : Fin N) (i : Fin B) : (gIdx s i).val % B = i.val := seg_mod i.isLt

theorem gIdx_inj {s s' : Fin N} {i i' : Fin B} (h : gIdx s i = gIdx s' i') : s = s' ∧ i = i' := by
  have := divmod_inj i.isLt i'.isLt (congrArg Fin.val h)
  exact ⟨Fin.ext this.1, Fin.ext this.2⟩

theorem gIdx_injective (s : Fin N) : Function.Injective (gIdx (B := B) s) := fun _ _ h => (gIdx_inj h).2

theorem gIdx_le_iff (s : Fin N) {i j : Fin B} : gIdx s i ≤ gIdx s j ↔ i ≤ j := by
  simp only [Fin.le_def, gIdx_val]
  omega

theorem pos_of_fin (v : Fin (N * B)) : 0 < B := by
  have h : 0 < N * B := lt_of_le_of_lt (Nat.zero_le _) v.isLt
  exact Nat.pos_of_ne_zero fun hB => by rw [hB, Nat.mul_zero] at h; exact lt_irrefl 0 h

theorem div_lt_of_fin (v : Fin (N * B)) : v.val / B < N :=
  Nat.div_lt_of_lt_mul (lt_of_lt_of_eq v.isLt (Nat.mul_comm N B))

/-- The segment and local index of a global block. -/
def segOf (v : Fin (N * B)) : Fin N := ⟨v.val / B, div_lt_of_fin v⟩

def locOf (v : Fin (N * B)) : Fin B := ⟨v.val % B, Nat.mod_lt _ (pos_of_fin v)⟩

/-- Every global block is `gIdx` of its segment and local index. -/
theorem gIdx_segOf_locOf (v : Fin (N * B)) : gIdx (segOf v) (locOf v) = v :=
  Fin.ext (Nat.div_add_mod' v.val B)

end Arith

/-! ## 2. Faithfulness -/

section Faithful

variable {N B d : ℕ}

theorem parentsDesc_def {n : ℕ} (G : TopoDAG n) (v : Fin n) :
    parentsDesc G v = (G.par v).sort (fun a b => b ≤ a) := rfl

theorem mem_par_band {v u : Fin B} : u ∈ (bandDAG B d).par v ↔ u < v ∧ v.val ≤ u.val + d := by
  rw [show (bandDAG B d).par v = Finset.univ.filter (fun u => u < v ∧ v.val ≤ u.val + d) from rfl]
  simp

theorem mem_par_seg {v u : Fin (N * B)} :
    u ∈ (bandSegDAG N B d).par v ↔ u.val / B = v.val / B ∧ u < v ∧ v.val ≤ u.val + d := by
  simp [bandSegDAG]

/-- The parents of `(s, i)` in the union are the band parents of `i`, placed in segment `s`. -/
theorem par_seg_gIdx (s : Fin N) (i : Fin B) :
    (bandSegDAG N B d).par (gIdx s i) = ((bandDAG B d).par i).map ⟨gIdx s, gIdx_injective s⟩ := by
  ext u
  simp only [mem_par_seg, mem_par_band, Finset.mem_map, Function.Embedding.coeFn_mk, gIdx_div]
  constructor
  · rintro ⟨hseg, hlt, hle⟩
    have hB : 0 < B := by have := i.isLt; omega
    have hu := Nat.div_add_mod' u.val B
    rw [hseg] at hu
    rw [Fin.lt_def, gIdx_val] at hlt
    rw [gIdx_val] at hle
    refine ⟨⟨u.val % B, Nat.mod_lt _ hB⟩, ⟨Fin.lt_def.2 (by simp only; omega), by simp only; omega⟩,
      Fin.ext (by rw [gIdx_val]; simp only; omega)⟩
  · rintro ⟨j, ⟨hlt, hle⟩, rfl⟩
    rw [Fin.lt_def] at hlt
    refine ⟨gIdx_div s j, Fin.lt_def.2 (by rw [gIdx_val, gIdx_val]; omega), by rw [gIdx_val, gIdx_val]; omega⟩

/-- The parents newest first, likewise. -/
theorem parentsDesc_seg (s : Fin N) (i : Fin B) :
    parentsDesc (bandSegDAG N B d) (gIdx s i) = (parentsDesc (bandDAG B d) i).map (gIdx s) := by
  apply List.Perm.eq_of_pairwise' (r := fun a b : Fin (N * B) => b ≤ a)
  · exact Finset.pairwise_sort _ _
  · rw [List.pairwise_map]
    exact (Finset.pairwise_sort ((bandDAG B d).par i) (fun a b : Fin B => b ≤ a)).imp fun h => (gIdx_le_iff s).2 h
  · refine List.perm_of_nodup_nodup_toFinset_eq (Finset.sort_nodup _ _)
      ((Finset.sort_nodup _ _).map (gIdx_injective s)) ?_
    ext u
    simp only [List.mem_toFinset, List.mem_map, parentsDesc_def, Finset.mem_sort, par_seg_gIdx, Finset.mem_map,
      Function.Embedding.coeFn_mk]

/-- **The union's labels are the segments' band labels**, for any domains and blocks that agree on segment `s`. -/
theorem labelG_seg {ℓ c : ℕ} (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (Wb : Fin (N * B) → Bits ℓ) (s : Fin N) (domS : ℕ → Bits c) (WbS : Fin B → Bits ℓ)
    (hdom : ∀ j : Fin B, dom (s.val * B + j.val) = domS j.val) (hW : ∀ j, Wb (gIdx s j) = WbS j) :
    ∀ i : Fin B, labelG (bandSegDAG N B d) f dom Wb (gIdx s i) = labelG (bandDAG B d) f domS WbS i := by
  intro i
  induction i using WellFoundedLT.induction with
  | _ i ih =>
    have habs : absorbedG (bandSegDAG N B d) (labelG (bandSegDAG N B d) f dom Wb) (gIdx s i) =
        absorbedG (bandDAG B d) (labelG (bandDAG B d) f domS WbS) i := by
      unfold absorbedG
      rw [parentsDesc_seg, List.map_map]
      congr 1
      refine List.map_congr_left fun j hj => ?_
      exact ih j ((bandDAG B d).par_lt i j ((Finset.mem_sort _).1 hj))
    have hd : dom (gIdx s i).val = domS i.val := hdom i
    rw [Pous.BandChain.labelG_eq, Pous.BandChain.labelG_eq (bandDAG B d), habs, hW i, hd]

/-- **`SegFaithful`, proved.** -/
theorem segFaithful : SegFaithful := fun _ _ _ _ _ f dom Wb s i =>
  labelG_seg f dom Wb s _ _ (fun _ => rfl) (fun _ => rfl) i

/-- Block `(s, i)` of the store's data is block `i` of segment `s`'s data. -/
theorem blocks_gIdx {ℓ : ℕ} (W : Bits (N * B * ℓ)) (s : Fin N) (i : Fin B) :
    Dense.blocks (N * B) ℓ W (gIdx s i) = Dense.blocks B ℓ (segData W s) i := by
  funext t
  show W ⟨t.val + ℓ * (s.val * B + i.val), _⟩ = W ⟨s.val * (B * ℓ) + (t.val + ℓ * i.val), _⟩
  exact congrArg W (Fin.ext (by ring))

/-- **`SegFaithfulCode`, proved.** -/
theorem segFaithfulCode : SegFaithfulCode := by
  intro N B d ℓ _ _ salt W π s i
  show labelG (bandSegDAG N B d) (fun x => (idealPerm (ℓ + (ℓ + 512))).answer π (.inl x)) (segDom salt B)
      (Dense.blocks (N * B) ℓ W) (gIdx s i) =
    labelG (bandDAG B d) (fun x => (idealPerm (ℓ + (ℓ + 512))).answer π (.inl x))
      (Pous.Sponge.dom (Pous.DenseReCert.tag salt s.val)) (Dense.blocks B ℓ (segData W s)) i
  refine labelG_seg _ _ _ s _ _ (fun j => ?_) (fun j => blocks_gIdx W s j) i
  unfold segDom
  rw [seg_div j.isLt, seg_mod j.isLt]

end Faithful

/-! ## 3. Joint hardness, and the necessity of each side condition -/

section Hard

variable {N B d D : ℕ}

/-- In the union, node `v` has exactly `min(v mod B, d)` parents. -/
theorem card_par_seg (v : Fin (N * B)) : ((bandSegDAG N B d).par v).card = min (v.val % B) d := by
  have hB := pos_of_fin v
  have hv := Nat.div_add_mod' v.val B
  have hr := Nat.mod_lt v.val hB
  have hvlt := v.isLt
  refine le_antisymm ?_ ?_
  · calc ((bandSegDAG N B d).par v).card ≤ (Finset.Ico (v.val - min (v.val % B) d) v.val).card :=
          Finset.card_le_card_of_injOn (fun u => u.val)
            (fun u hu => by
              obtain ⟨hseg, hlt, hle⟩ := mem_par_seg.1 hu
              have h1 := ((same_seg hB).1 hseg).1
              rw [Fin.lt_def] at hlt
              simp only [Finset.coe_Ico, Set.mem_Ico]
              omega)
            (fun a _ b _ h => Fin.ext h)
      _ = min (v.val % B) d := by rw [Nat.card_Ico]; omega
  · refine Finset.le_card_of_inj_on_range (fun t => (⟨v.val - 1 - t, by omega⟩ : Fin (N * B)))
      (fun t ht => ?_) (fun t ht t' ht' h => ?_)
    · refine mem_par_seg.2 ⟨(same_seg hB).2 ⟨by simp only; omega, by simp only; omega⟩,
        Fin.lt_def.2 (by simp only; omega), by simp only; omega⟩
    · simp only [Fin.mk.injEq] at h
      omega

/-- With `d ≥ D`, the short rows of the union are the first `D` rows of every segment. -/
theorem shortRows_seg (hd : D ≤ d) :
    shortRows (bandSegDAG N B d) Finset.univ D = Finset.univ.filter fun v : Fin (N * B) => v.val % B < D := by
  ext v
  simp only [shortRows, Finset.mem_filter, Finset.mem_univ, true_and]
  rw [ovCalls_eq, card_par_seg]
  omega

/-- There are `N·D` blocks whose local index is below `D ≤ B`. -/
theorem card_mod_lt (hDB : D ≤ B) :
    (Finset.univ.filter fun v : Fin (N * B) => v.val % B < D).card = N * D := by
  let f : Fin N × Fin D → Fin (N * B) := fun p => gIdx p.1 ⟨p.2.val, lt_of_lt_of_le p.2.isLt hDB⟩
  have hf : Function.Injective f := fun p q h => by
    obtain ⟨h1, h2⟩ := gIdx_inj h
    exact Prod.ext h1 (Fin.ext (Fin.mk.inj_iff.1 h2))
  have himg : Finset.univ.filter (fun v : Fin (N * B) => v.val % B < D) = Finset.univ.image f := by
    ext v
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image]
    constructor
    · intro hv
      exact ⟨(segOf v, ⟨v.val % B, hv⟩), gIdx_segOf_locOf v⟩
    · rintro ⟨p, rfl⟩
      show (gIdx p.1 _).val % B < D
      rw [gIdx_mod]
      exact p.2.isLt
  rw [himg, Finset.card_image_of_injective _ hf, Finset.card_univ, Fintype.card_prod, Fintype.card_fin,
    Fintype.card_fin]

/-- **The union with `d ≥ D` has exactly `N·D` short rows**, `D` per segment. -/
theorem card_shortRows_seg (hd : D ≤ d) (hDB : D ≤ B) :
    (shortRows (bandSegDAG N B d) Finset.univ D).card = N * D := by
  rw [shortRows_seg hd, card_mod_lt hDB]

end Hard

/-- **`BandSegHard`, proved**: `weighted_chain_cert` with `N·D` short rows. -/
theorem band_seg_hard : BandSegHard := by
  intro N B d D c ℓ hN hd hB
  refine weighted_chain_cert (N * B) (bandSegDAG N B d) Finset.univ c ℓ _ D (N * B) ?_
  rw [card_shortRows_seg hd (by omega)]
  have hmul : N * D + N ≤ N * B := by
    calc N * D + N = N * (D + 1) := by ring
      _ ≤ N * B := Nat.mul_le_mul_left _ hB
  have h : N * B - N * D - 1 + N * D < N * B := by omega
  exact_mod_cast h

/-- **`BandSegNeedsN`, proved**: at `N = 0` the empty holding already fails `_ < 0`. -/
theorem band_seg_needs_N : BandSegNeedsN := by
  intro B d D c ℓ h
  have := h ⟨∅, ∅, ∅⟩ (by rw [size_labels]; simp)
  simp at this

/-- **`BandSegNeedsRoom`, proved**: the lone row has no parent and is one call. -/
theorem band_seg_needs_room : BandSegNeedsRoom := by
  intro c ℓ
  refine not_hard_of_all (bandSegDAG 1 1 1) c ℓ _ 1 ⟨∅, ∅, ∅⟩ (by rw [size_labels]; simp) ?_
  intro v
  have hpar : (bandSegDAG 1 1 1).par v ⊆ (∅ : Finset (Fin (1 * 1))) := by
    intro u hu
    have h1 := (mem_par_seg.1 hu).2.1
    rw [Fin.lt_def] at h1
    have h2 := v.isLt
    omega
  have hcalls : ovCalls (bandSegDAG 1 1 1) v ≤ 1 := by
    rw [ovCalls_eq, card_par_seg, Nat.mod_one]
    simp
  exact reach_labs_mono _ _ hcalls (row_label _ ⟨∅, ∅, ∅⟩ v hpar)

/-- **`BandSegGapAttack`, proved.** In every segment, drop the positive multiples of `d + 1`: each dropped row has its
`≤ d` parents held, so it finishes within `d + 1 ≤ D` rounds. -/
theorem band_seg_gap_attack : BandSegGapAttack := by
  intro N B d D c ℓ hdD
  classical
  rcases Nat.eq_zero_or_pos B with hB0 | hBpos
  · subst hB0
    intro h
    have := h ⟨∅, ∅, ∅⟩ (by rw [size_labels]; simp)
    simp at this
  set M := (B - 1) / (d + 1) with hM
  have hMB : (d + 1) * M ≤ B - 1 := Nat.mul_div_le _ _
  set H : Finset (Fin (N * B)) := Finset.univ.filter fun v => ¬ (0 < v.val % B ∧ (d + 1) ∣ v.val % B) with hH
  have hdrop : N * M ≤ (Finset.univ.filter fun v : Fin (N * B) => 0 < v.val % B ∧ (d + 1) ∣ v.val % B).card := by
    let f : Fin N × Fin M → Fin (N * B) := fun p => gIdx p.1 ⟨(d + 1) * (p.2.val + 1), by
      have h1 := p.2.isLt
      have h2 : (d + 1) * (p.2.val + 1) ≤ (d + 1) * M := Nat.mul_le_mul_left _ h1
      omega⟩
    have hf : Function.Injective f := fun p q h => by
      obtain ⟨h1, h2⟩ := gIdx_inj h
      have h3 := congrArg Fin.val h2
      simp only at h3
      have h4 := Nat.eq_of_mul_eq_mul_left (by omega : 0 < d + 1) h3
      exact Prod.ext h1 (Fin.ext (by omega))
    calc N * M = (Finset.univ.image f).card := by
          rw [Finset.card_image_of_injective _ hf, Finset.card_univ, Fintype.card_prod, Fintype.card_fin,
            Fintype.card_fin]
      _ ≤ _ := Finset.card_le_card fun v hv => by
          obtain ⟨p, -, rfl⟩ := Finset.mem_image.1 hv
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, f, gIdx_mod]
          exact ⟨by positivity, Dvd.intro _ rfl⟩
  have hsplit : (Finset.univ.filter fun v : Fin (N * B) => 0 < v.val % B ∧ (d + 1) ∣ v.val % B).card + H.card =
      N * B := by
    have := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset (Fin (N * B))))
      (fun v : Fin (N * B) => 0 < v.val % B ∧ (d + 1) ∣ v.val % B)
    rw [Finset.card_univ, Fintype.card_fin] at this
    rw [hH]
    convert this using 3
  have hHc : H.card ≤ N * B - N * M := by omega
  refine not_hard_of_all (bandSegDAG N B d) c ℓ _ D ⟨H, ∅, ∅⟩ ?_ ?_
  · rw [size_labels]; exact_mod_cast hHc
  · intro v
    by_cases hv : v ∈ H
    · exact held_subset_reach _ _ D hv
    · have hvm : 0 < v.val % B ∧ (d + 1) ∣ v.val % B := by simpa [hH] using hv
      have hpar : (bandSegDAG N B d).par v ⊆ H := by
        intro u hu
        obtain ⟨hseg, hlt, hle⟩ := mem_par_seg.1 hu
        rw [Fin.lt_def] at hlt
        simp only [hH, Finset.mem_filter, Finset.mem_univ, true_and]
        rintro ⟨-, hdu⟩
        have hu' := Nat.div_add_mod' u.val B
        have hv' := Nat.div_add_mod' v.val B
        rw [hseg] at hu'
        have hdvd : (d + 1) ∣ v.val % B - u.val % B := Nat.dvd_sub hvm.2 hdu
        have := Nat.le_of_dvd (by omega) hdvd
        omega
      have hcalls : ovCalls (bandSegDAG N B d) v ≤ D := by
        rw [ovCalls_eq, card_par_seg]
        omega
      exact reach_labs_mono _ _ hcalls (row_label _ ⟨H, ∅, ∅⟩ v hpar)

/-- **`BandSegGapAttack14`, proved**: the gap attack costs `448·410 = 183680` labels, below the `227135` allowed. -/
theorem band_seg_gap_attack_14 : BandSegGapAttack14 := by
  intro c ℓ h
  exact band_seg_gap_attack 448 (2 ^ 9) 4 5 c ℓ (by norm_num) (ChainHard.mono h (by norm_num))

/-! ## 4. The glue, the domains, and the certificate -/

/-- **`BandSegTimedINC`, proved** (conditional on `ChainExPostFactoG`, by its statement): `band_timedINC` at `N·B`
blocks on `bandSegDAG`, with `band_seg_hard` in place of `band_chain_hard`. -/
theorem band_seg_timedINC : BandSegTimedINC := by
  intro hepf N B d ℓ c D Q β _ dom hN hd hD hdom
  classical
  intro W cmp exp hexp
  have hE := hepf (N * B) ℓ c β (N * B - N * D - 1) D Q (N * B) (bandSegDAG N B d) dom
    (Dense.blocks (N * B) ℓ W) hdom (band_seg_hard N B d D c ℓ hN hd hD)
    (fun π => cmp W (fun i => i.elim0)
      (fun i => labelG (bandSegDAG N B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom
        (Dense.blocks (N * B) ℓ W) i) π)
    (fun σ i => exp W (fun i => i.elim0) σ i) (fun σ i => hexp W _ σ i)
  refine le_trans (le_of_eq_of_le (PousThm1Dense.pr_fst (β := Unit)
    (fun π : Equiv.Perm (Bits (ℓ + (ℓ + c))) =>
      ∀ i, (exp W (fun i => i.elim0)
        (cmp W (fun i => i.elim0)
          (fun i => labelG (bandSegDAG N B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom
            (Dense.blocks (N * B) ℓ W) i) π)
        i).run ((idealPerm (ℓ + (ℓ + c))).answer π) =
        labelG (bandSegDAG N B d) (fun x => (idealPerm (ℓ + (ℓ + c))).answer π (.inl x)) dom
          (Dense.blocks (N * B) ℓ W) i))
    (pr_mono fun π hH => ?_)) hE
  refine le_trans (le_of_eq (by rw [Finset.card_univ, Fintype.card_fin]))
    (Finset.card_le_card (s := Finset.univ) fun c _ => Finset.mem_filter.2 ⟨Finset.mem_univ _, hH c⟩)

/-- `dom a i` determines the salt `a` and, below `2^256`, the index `i`. -/
theorem dom_inj2 {a a' : Bits 256} {i i' : ℕ} (hi : i < 2 ^ 256) (hi' : i' < 2 ^ 256)
    (h : Pous.Sponge.dom a i = Pous.Sponge.dom a' i') : a = a' ∧ i = i' := by
  refine ⟨funext fun j => ?_, Nat.eq_of_testBit_eq fun n => ?_⟩
  · have hh := congrFun h (Fin.castAdd 256 j)
    simp only [Pous.Sponge.dom] at hh
    rwa [Fin.append_left, Fin.append_left] at hh
  · by_cases hn : n < 256
    · have hh := congrFun h (Fin.natAdd 256 (⟨n, hn⟩ : Fin 256))
      simp only [Pous.Sponge.dom] at hh
      rw [Fin.append_right, Fin.append_right] at hh
      simpa using hh
    · push Not at hn
      rw [Nat.testBit_eq_false_of_lt (lt_of_lt_of_le hi (Nat.pow_le_pow_right (by norm_num) hn)),
        Nat.testBit_eq_false_of_lt (lt_of_lt_of_le hi' (Nat.pow_le_pow_right (by norm_num) hn))]

/-- **The per-segment tagged domains are injective on all `N·B` blocks** (`N ≤ 2^64`, `B ≤ 2^256`):
`ChainExPostFactoG`'s domain hypothesis for the implementation's layout. -/
theorem segDom_inj (salt : Bits 192) {N B : ℕ} (hN : N ≤ 2 ^ 64) (hB : B ≤ 2 ^ 256) :
    Function.Injective (fun v : Fin (N * B) => segDom salt B v) := by
  intro v w h
  have hBpos := pos_of_fin v
  obtain ⟨h1, h2⟩ := dom_inj2 (lt_of_lt_of_le (Nat.mod_lt _ hBpos) hB) (lt_of_lt_of_le (Nat.mod_lt _ hBpos) hB) h
  have hs : segOf v = segOf w := Pous.DenseReCert.tag_injective salt hN h1
  have hs' : v.val / B = w.val / B := congrArg Fin.val hs
  have hv := Nat.div_add_mod' v.val B
  have hw := Nat.div_add_mod' w.val B
  rw [hs'] at hv
  exact Fin.ext (by omega)

/-- The state bound `⌊ρ·|C|⌋ = 113929658799` at `|C| = 448·2^9·524288` bits (14 GB). -/
theorem stateBound_seg_14 (d : ℕ) (dom : ℕ → Bits 512) :
    (chainBandSeg 448 (2 ^ 9) d 524288 512 dom).stateBound Params.ρ = 113929658799 := by
  show ⌊Params.ρ * (((448 * 2 ^ 9) * 524288 : ℕ) : ℚ)⌋₊ = 113929658799
  rw [Nat.floor_eq_iff (by norm_num [Params.ρ])]
  norm_num [Params.ρ]

/-- `Σ_{j<k} (N·B)^j ≤ 2^(18k)` at `N·B = 229376 ≤ 2^18`. -/
theorem sum_pow_seg_14 (k : ℕ) :
    (∑ j ∈ Finset.range k, ((448 * 2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) ≤ (2 : ℝ≥0∞) ^ (18 * k) := by
  refine (PousDenseChain.sum_pow_le _ _ (by norm_num)).trans ?_
  have h : ((448 * 2 ^ 9 : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 18 := by norm_num
  calc ((448 * 2 ^ 9 : ℕ) : ℝ≥0∞) ^ k ≤ ((2 : ℝ≥0∞) ^ 18) ^ k := pow_le_pow_left' h k
    _ = (2 : ℝ≥0∞) ^ (18 * k) := by rw [← pow_mul]

/-- **The union `π` at 14 GB is at most `2^-(e - β)`**: its freshness term is `2^(β + 1 + 95·227136 − 524288·227135)`
(`nPos²·N·B·2 ≤ 2^95`) and its collision term `nPos²/2^524800 ≤ 2^-524724` (`nPos² ≤ 2^76`), for any exponent `e`
with `β + 1 + 21577920 + e ≤ 119084154880`, `e ≤ 524724`. -/
theorem chainPiSeg_14_le (β e : ℕ) (hβ : β + 1 + 21577920 + e ≤ 119084154880) (he : e ≤ 524724) :
    chainPiSeg 448 (2 ^ 9) 524288 512 5 (2 ^ 20) β ≤ (2⁻¹ : ℝ≥0∞) ^ e + (2⁻¹ : ℝ≥0∞) ^ e := by
  have hβ1 : β + 1 + 21577920 ≤ 119084154880 := by omega
  have hβ2 : e ≤ 119084154880 - (β + 1 + 21577920) := by omega
  have hbase : ((nPos (448 * 2 ^ 9) (2 ^ 20)) ^ 2 * (448 * 2 ^ 9) * 2 : ℕ) ≤ 2 ^ 95 := by norm_num [nPos]
  have hnp2 : ((nPos (448 * 2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) ≤ 2 ^ 76 := by norm_num [nPos]
  have hE1 : 524288 * (448 * 2 ^ 9 - 448 * 5 - 1) = 119084154880 := by norm_num
  have hs1 : 448 * 2 ^ 9 - 448 * 5 - 1 + 1 = 227136 := by norm_num
  unfold chainPiSeg
  refine add_le_add ?_ ?_
  · rw [hs1, hE1]
    have hbase' : (((nPos (448 * 2 ^ 9) (2 ^ 20)) ^ 2 * (448 * 2 ^ 9) * 2 : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 95 := by
      have h := (Nat.cast_le (α := ℝ≥0∞)).2 hbase
      rwa [Nat.cast_pow (2 : ℕ) 95, Nat.cast_ofNat] at h
    have hb : ((((nPos (448 * 2 ^ 9) (2 ^ 20)) ^ 2 * (448 * 2 ^ 9) * 2) ^ 227136 : ℕ) : ℝ≥0∞) ≤
        (2 : ℝ≥0∞) ^ 21577920 := by
      rw [Nat.cast_pow]
      calc (((nPos (448 * 2 ^ 9) (2 ^ 20)) ^ 2 * (448 * 2 ^ 9) * 2 : ℕ) : ℝ≥0∞) ^ 227136
          ≤ ((2 : ℝ≥0∞) ^ 95) ^ 227136 := pow_le_pow_left' hbase' _
        _ = (2 : ℝ≥0∞) ^ 21577920 := by rw [← pow_mul]
    calc (2 : ℝ≥0∞) ^ β * 2 *
            ((((nPos (448 * 2 ^ 9) (2 ^ 20)) ^ 2 * (448 * 2 ^ 9) * 2) ^ 227136 : ℕ) : ℝ≥0∞) / 2 ^ 119084154880
        ≤ (2 : ℝ≥0∞) ^ β * 2 * 2 ^ 21577920 / 2 ^ 119084154880 := by gcongr
      _ = (2⁻¹ : ℝ≥0∞) ^ (119084154880 - (β + 1 + 21577920)) := by
          rw [div_eq_mul_inv, ENNReal.inv_pow, ← pow_succ, ← pow_add]
          exact PousDenseChain.two_pow_mul_inv_pow _ _ hβ1
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ e := pow_le_pow_right_of_le_one' (by norm_num) hβ2
  · have hE2 : 524288 + 512 = 524800 := by norm_num
    rw [hE2]
    have hb : (((nPos (448 * 2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 76 := by
      have h := (Nat.cast_le (α := ℝ≥0∞)).2 hnp2
      rwa [Nat.cast_pow (2 : ℕ) 76, Nat.cast_ofNat] at h
    calc (((nPos (448 * 2 ^ 9) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ 524800
        ≤ (2 : ℝ≥0∞) ^ 76 / 2 ^ 524800 := by gcongr
      _ = (2⁻¹ : ℝ≥0∞) ^ 524724 := by
          rw [div_eq_mul_inv, ENNReal.inv_pow]; exact PousDenseChain.two_pow_mul_inv_pow _ _ (by norm_num)
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ e := pow_le_pow_right_of_le_one' (by norm_num) he

/-- `2^a · (2^-e + 2^-e) = 2^-r` when `a + 1 + r = e`. -/
theorem two_pow_mul_two_inv (a e r : ℕ) (h : a + 1 + r = e) :
    (2 : ℝ≥0∞) ^ a * ((2⁻¹ : ℝ≥0∞) ^ e + (2⁻¹ : ℝ≥0∞) ^ e) = (2⁻¹ : ℝ≥0∞) ^ r := by
  rw [← two_mul, ← mul_assoc, ← pow_succ, PousDenseChain.two_pow_mul_inv_pow _ _ (by omega)]
  congr 1
  omega

/-- **The union term at 14 GB, `k = 111`**: `|Hist|·π ≤ 2^-128` at `β = 119062574832`, with exponent slack
`119084154880 − (β + 1 + 21577920) = 2127 = 18·111 + 129`. -/
theorem seg_union_term_14 :
    (∑ j ∈ Finset.range 111, ((448 * 2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) *
      chainPiSeg 448 (2 ^ 9) 524288 512 5 (2 ^ 20) 119062574832 ≤ (2⁻¹ : ℝ≥0∞) ^ 128 :=
  calc _ ≤ (2 : ℝ≥0∞) ^ (18 * 111) * ((2⁻¹ : ℝ≥0∞) ^ 2127 + (2⁻¹ : ℝ≥0∞) ^ 2127) :=
        mul_le_mul' (sum_pow_seg_14 111) (chainPiSeg_14_le _ _ (by norm_num) (by norm_num))
    _ = (2⁻¹ : ℝ≥0∞) ^ 128 := two_pow_mul_two_inv _ _ _ (by norm_num)

/-- `p₀^111 ≤ 1%` at `β = 119062574832`, `S = 113929658799`, `B = 448·2^9`, `ℓ = 524288` (`p₀ ≈ 0.957320`,
`p₀^111 ≈ 0.00789`). -/
theorem seg_sampling_term_14 :
    ENNReal.ofReal (p₀ 119062574832 113929658799 (448 * 2 ^ 9) 524288) ^ 111 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  have h0 : 0 ≤ p₀ 119062574832 113929658799 (448 * 2 ^ 9) 524288 := by unfold p₀; norm_num
  rw [← ENNReal.ofReal_pow h0]
  refine ENNReal.ofReal_le_ofReal ?_
  unfold p₀
  norm_num [Params.δ]

/-- **The union term at 14 GB, `k = 106`**: `β = 119062574922`, slack `2037 = 18·106 + 129`. -/
theorem seg_union_term_14_k106 :
    (∑ j ∈ Finset.range 106, ((448 * 2 ^ 9 : ℕ) : ℝ≥0∞) ^ j) *
      chainPiSeg 448 (2 ^ 9) 524288 512 5 (2 ^ 20) 119062574922 ≤ (2⁻¹ : ℝ≥0∞) ^ 128 :=
  calc _ ≤ (2 : ℝ≥0∞) ^ (18 * 106) * ((2⁻¹ : ℝ≥0∞) ^ 2037 + (2⁻¹ : ℝ≥0∞) ^ 2037) :=
        mul_le_mul' (sum_pow_seg_14 106) (chainPiSeg_14_le _ _ (by norm_num) (by norm_num))
    _ = (2⁻¹ : ℝ≥0∞) ^ 128 := two_pow_mul_two_inv _ _ _ (by norm_num)

/-- `p₀^106 ≤ 1%` at `β = 119062574922` (`p₀^106 ≈ 0.00982`). -/
theorem seg_sampling_term_14_k106 :
    ENNReal.ofReal (p₀ 119062574922 113929658799 (448 * 2 ^ 9) 524288) ^ 106 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  have h0 : 0 ≤ p₀ 119062574922 113929658799 (448 * 2 ^ 9) 524288 := by unfold p₀; norm_num
  rw [← ENNReal.ofReal_pow h0]
  refine ENNReal.ofReal_le_ofReal ?_
  unfold p₀
  norm_num [Params.δ]

/-- **The 14 GB band scheme meets the requirement for every domain injective on its `N·B` blocks**, given
`ChainExPostFactoG`, at `k = 111`. -/
theorem band_meets_14_dom (hepf : ChainExPostFactoG) (d : ℕ) (hd : 5 ≤ d) (dom : ℕ → Bits 512)
    (hdom : Function.Injective (fun i : Fin (448 * 2 ^ 9) => dom i)) :
