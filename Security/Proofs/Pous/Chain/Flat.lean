  · rw [form_of_pres p τ G W D ω u w (r := .ab1) h, base_coef]; simp [ev]

theorem raise_ab2 (h : ¬ fh1 p τ G W D ω u) : GRaises p τ G W D Q ω u w .ab2 := by
  refine graises_single p τ G W D Q ω u w .ab2 .b2 (fun h' => absurd h' (b2_not_sampled p τ G W D ω u w h))
    (fun r' hr' => ?_) ?_
