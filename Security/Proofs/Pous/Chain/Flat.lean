/-!
# The dense single-layer scheme meets the requirement: `PousDenseChain.dense_meets`

The first end-to-end `Pous.Meets` with no named assumption (`docs/p3-scheme.md` §4, S1). The scheme and the
statement are `DenseMeetsDraft.lean`'s, verbatim. The proof composes five pieces:

1. **Reach** (`card_reach_le`, `complete_hard`). Greedy pebbling of the complete DAG adds at most the least
   unpebbled node per round, so `B − D − 1` pebbles reach at most `B − 1` nodes in `D` rounds.
2. **B5 gives `TimedINC`** (`dense_timedINC`). Rebuilding every block is "all `B` challenges right", so
   `Pous.Guarantees.B5ExPostFactoBounded` (the `PousB5Chain` proof below) bounds it by
   `π = B·2^β·((B(Q + 1) + B)²/2^ℓ)^(B − D)`.
3. **`Pous.Guarantees.Theorem1iiSeq`** (the `thm1-family` proof, `PousTargetsDense.theorem1_ii_seq`) gives
   `Pr[pass] ≤ |Hist|·π + p₀^k`.
4. **Rate 1** (`denseScheme_correct`, `CodeHoldsW`, `SpaceBound`).
5. **The certificate at `β = 531499840`.** `|Hist|·π ≤ 2^-128` (`dense_union_term`, in exponents of 2), and
   `p₀^107 ≤ 1%` (`dense_sampling_term`, exact rationals), with `S = ⌊(18/19)·2^29⌋ = 508614548`
   (`stateBound_dense`).

The file is standalone: the `thm1-family` library (`PousThm1Dense`) with `theorem1_ii_seq`, the B5 library and proof
(`PousB5Chain`), then the scheme and the proof (`PousDenseChain`).
-/

namespace PousThm1Dense

open Pous
open scoped ENNReal

/-! ### Uniform probability -/

/-- `pr` does not depend on how the sample space is labelled. -/
theorem pr_equiv {α β : Type} [Fintype α] [Fintype β] (e : α ≃ β) (P : β → Prop) :
    pr (fun a => P (e a)) = pr P := by
  classical
  rw [pr_def, pr_def, Fintype.card_congr e]
  congr 2
  rw [← Fintype.card_subtype, ← Fintype.card_subtype]
  exact Fintype.card_congr (e.subtypeEquiv fun _ => Iff.rfl)

/-- **Conditioning on the first coordinate.** If every fibre off `E` has probability at most `c`, the product event
has probability at most `Pr[E] + c`. -/
theorem pr_prod_le {α β : Type} [Fintype α] [Fintype β] [Nonempty α] [Nonempty β]
    (P : α → β → Prop) (E : α → Prop) (c : ℝ≥0∞) (h : ∀ a, ¬ E a → pr (P a) ≤ c) :
    pr (fun x : α × β => P x.1 x.2) ≤ pr E + c := by
  classical
  have hα0 : (Fintype.card α : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hβ0 : (Fintype.card β : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hαt : (Fintype.card α : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hβt : (Fintype.card β : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hfib : ∀ a, ((Finset.univ.filter (P a)).card : ℝ≥0∞) ≤
      (if E a then 1 else 0) * Fintype.card β + c * Fintype.card β := by
    intro a
    by_cases ha : E a
    · simp only [ha, ite_true, one_mul]
      refine le_add_right ?_
      exact_mod_cast (Finset.card_filter_le _ _).trans (Finset.card_univ).le
    · simp only [ha, ite_false, zero_mul, zero_add]
      have := h a ha
      rwa [pr_def, ENNReal.div_le_iff hβ0 hβt] at this
  have hcount : ((Finset.univ.filter fun x : α × β => P x.1 x.2).card : ℝ≥0∞) =
      ∑ a, ((Finset.univ.filter (P a)).card : ℝ≥0∞) := by
    rw [Finset.natCast_card_filter, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.natCast_card_filter]
  have hE : ((Finset.univ.filter E).card : ℝ≥0∞) = ∑ a, (if E a then 1 else 0 : ℝ≥0∞) :=
    Finset.natCast_card_filter _ _
  rw [pr_def, pr_def, hcount, Fintype.card_prod, Nat.cast_mul, ENNReal.div_le_iff (mul_ne_zero hα0 hβ0)
    (ENNReal.mul_ne_top hαt hβt)]
  calc ∑ a, ((Finset.univ.filter (P a)).card : ℝ≥0∞)
      ≤ ∑ a, ((if E a then 1 else 0) * Fintype.card β + c * Fintype.card β) :=
        Finset.sum_le_sum fun a _ => hfib a
    _ = ((Finset.univ.filter E).card : ℝ≥0∞) * Fintype.card β +
          Fintype.card α * (c * Fintype.card β) := by
        rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← hE, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    _ = (((Finset.univ.filter E).card : ℝ≥0∞) / Fintype.card α + c) *
          (Fintype.card α * Fintype.card β) := by
        rw [add_mul, ← mul_assoc (_ / (Fintype.card α : ℝ≥0∞)), ENNReal.div_mul_cancel hα0 hαt]
        ring

/-- `k` indices, all in `G`: `|G|^k` of them. -/
theorem card_pi_mem (k B : ℕ) (G : Finset (Fin B)) :
    (Finset.univ.filter fun I : Fin k → Fin B => ∀ j, I j ∈ G).card = G.card ^ k := by
  have : (Finset.univ.filter fun I : Fin k → Fin B => ∀ j, I j ∈ G) = Fintype.piFinset fun _ => G := by
    ext I; simp [Fintype.mem_piFinset]
  rw [this, Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

/-! ### The threshold `p₀` -/

/-- If `g` of `B` blocks are right and the other `b` do not fit, `S + B + b·ℓ > β`, then `g ≤ p₀·B`. -/
theorem good_le_p₀ (B ℓ β S g b : ℕ) (hB : 0 < B) (hgb : g + b = B) (h : β < S + B + b * ℓ) :
    (g : ℝ) ≤ p₀ β S B ℓ * B := by
  unfold p₀
  rcases Nat.eq_zero_or_pos ℓ with rfl | hℓ
  · simp only [Nat.cast_zero, mul_zero, div_zero, sub_zero, one_mul]
    exact_mod_cast (by omega : g ≤ B)
  · have hB' : (0 : ℝ) < B := by exact_mod_cast hB
    have hℓ' : (0 : ℝ) < ℓ := by exact_mod_cast hℓ
    have hgb' : (g : ℝ) + b = B := by exact_mod_cast hgb
    have h' : (β : ℝ) < S + B + b * ℓ := by exact_mod_cast h
    have key : (1 - ((β : ℝ) - S - B) / (B * ℓ)) * B = B - ((β : ℝ) - S - B) / ℓ := by
      field_simp
    rw [key]
    have : ((β : ℝ) - S - B) / ℓ < b := by
      rw [div_lt_iff₀ hℓ']; linarith
    linarith

open Classical in
/-- **Averaging.** `k` uniform challenges all land on blocks the responder gets right with probability at most
`Pr[the wrong blocks fit in β bits] + p₀^k`. -/
theorem pr_all_good_le {Ω : Type} [Fintype Ω] [Nonempty Ω] (B ℓ β S k : ℕ) (hB : 0 < B)
    (good : Ω → Fin B → Prop) :
    pr (fun x : Ω × (Fin k → Fin B) => ∀ j, good x.1 (x.2 j)) ≤
      pr (fun a => S + B + (Finset.univ.filter fun i => ¬ good a i).card * ℓ ≤ β) +
        ENNReal.ofReal (p₀ β S B ℓ) ^ k := by
  have : Nonempty (Fin B) := ⟨⟨0, hB⟩⟩
  refine pr_prod_le (α := Ω) (β := Fin k → Fin B) (fun a I => ∀ j, good a (I j))
    (fun a => S + B + (Finset.univ.filter fun i => ¬ good a i).card * ℓ ≤ β) (ENNReal.ofReal (p₀ β S B ℓ) ^ k)
    fun a ha => ?_
  have hgb := Finset.card_filter_add_card_filter_not (s := Finset.univ) (good a)
  rw [Finset.card_univ, Fintype.card_fin] at hgb
  have hr := good_le_p₀ B ℓ β S _ _ hB hgb (by omega)
  have hB0 : ((B : ℝ≥0∞) ^ k) ≠ 0 := pow_ne_zero _ (by exact_mod_cast hB.ne')
  have hBt : ((B : ℝ≥0∞) ^ k) ≠ ⊤ := ENNReal.pow_ne_top (ENNReal.natCast_ne_top _)
  have hcard : (Finset.univ.filter fun I : Fin k → Fin B => ∀ j, good a (I j)).card =
      (Finset.univ.filter (good a)).card ^ k := by
    rw [← card_pi_mem]; congr 1; ext I; simp
  rw [pr_def, hcard, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin, Nat.cast_pow, Nat.cast_pow,
    ENNReal.div_le_iff hB0 hBt, ← mul_pow]
  gcongr
  calc ((Finset.univ.filter (good a)).card : ℝ≥0∞)
      = ENNReal.ofReal ((Finset.univ.filter (good a)).card : ℝ) := (ENNReal.ofReal_natCast _).symm
    _ ≤ ENNReal.ofReal (p₀ β S B ℓ * B) := ENNReal.ofReal_le_ofReal hr
    _ = ENNReal.ofReal (p₀ β S B ℓ) * B := by
        rw [ENNReal.ofReal_mul' (Nat.cast_nonneg _), ENNReal.ofReal_natCast]

/-! ### Compression -/

/-- **Codes from counting.** A set of at most `2^β` points has a `β`-bit code that decodes every point of it. -/
theorem exists_code {X : Type} [Fintype X] [Nonempty X] (T : Finset X) (β : ℕ) (h : T.card ≤ 2 ^ β) :
    ∃ (c : X → Bits β) (d : Bits β → X), ∀ x ∈ T, d (c x) = x := by
  classical
  obtain ⟨e⟩ := Function.Embedding.nonempty_of_card_le (α := T) (β := Bits β) (by simpa using h)
  refine ⟨fun x => if hx : x ∈ T then e ⟨x, hx⟩ else fun _ => false,
    fun w => if hw : ∃ y, e y = w then hw.choose.1 else Classical.arbitrary X, fun x hx => ?_⟩
  have hex : ∃ y, e y = e ⟨x, hx⟩ := ⟨_, rfl⟩
  simp only [hx, dite_true, hex]
  exact congrArg Subtype.val (e.injective hex.choose_spec)

/-- **Counting patches.** Assignments of an optional `ℓ`-bit block to each of `B` positions, with at most `L` bits
of blocks in total: at most `2^B · 2^L`. -/
theorem card_patches_le (B ℓ L : ℕ) :
    (Finset.univ.filter fun g : Fin B → Option (Bits ℓ) =>
      (Finset.univ.filter fun i => g i ≠ none).card * ℓ ≤ L).card ≤ 2 ^ B * 2 ^ L := by
  classical
  let t : Finset (Fin B) → (i : Fin B) → Finset (Option (Bits ℓ)) := fun D i =>
    if i ∈ D then Finset.univ.erase none else {none}
  have hsub : (Finset.univ.filter fun g : Fin B → Option (Bits ℓ) =>
      (Finset.univ.filter fun i => g i ≠ none).card * ℓ ≤ L) ⊆
      (Finset.univ.filter fun D : Finset (Fin B) => D.card * ℓ ≤ L).biUnion
        fun D => Fintype.piFinset (t D) := by
    intro g hg
    rw [Finset.mem_filter] at hg
    rw [Finset.mem_biUnion]
    refine ⟨Finset.univ.filter fun i => g i ≠ none, by simpa using hg.2, ?_⟩
    rw [Fintype.mem_piFinset]
    intro i
    by_cases hi : g i = none <;> simp [t, hi]
  refine (Finset.card_le_card hsub).trans ((Finset.card_biUnion_le).trans ?_)
  have hD : ∀ D ∈ (Finset.univ.filter fun D : Finset (Fin B) => D.card * ℓ ≤ L),
      (Fintype.piFinset (t D)).card ≤ 2 ^ L := by
    intro D hD
    rw [Finset.mem_filter] at hD
    rw [Fintype.card_piFinset]
    have : ∀ i, (t D i).card = if i ∈ D then 2 ^ ℓ else 1 := by
      intro i
      by_cases hi : i ∈ D
      · simp [t, hi, Finset.card_erase_of_mem, Fintype.card_option]
      · simp [t, hi]
    simp_rw [this]
    rw [Finset.prod_ite_mem, Finset.univ_inter, Finset.prod_const, ← pow_mul]
    exact Nat.pow_le_pow_right (by norm_num) (by rw [mul_comm]; exact hD.2)
  refine (Finset.sum_le_card_nsmul _ _ _ hD).trans ?_
  rw [smul_eq_mul]
  refine Nat.mul_le_mul_right _ ?_
  refine (Finset.card_filter_le _ _).trans ?_
  rw [Finset.card_univ, Fintype.card_finset, Fintype.card_fin]

/-- The compressor's message: the responder's state, and a replacement for each block it gets wrong. -/
abbrev Desc (S B ℓ : ℕ) : Type := Bits S × (Fin B → Option (Bits ℓ))

/-- The messages that fit in `β` bits: `S` for the state, `B` for the set of replaced blocks, `ℓ` per replaced
block. -/
def fits (S B ℓ β : ℕ) : Finset (Desc S B ℓ) :=
  Finset.univ.filter fun x => S + B + (Finset.univ.filter fun i => x.2 i ≠ none).card * ℓ ≤ β

/-- At most `2^β` messages fit: `2^S` states times `2^B·2^(β−S−B)` patches (none if `β < S + B`). -/
theorem card_fits_le (S B ℓ β : ℕ) : (fits S B ℓ β).card ≤ 2 ^ β := by
  by_cases hβ : S + B ≤ β
  · have hsub : fits S B ℓ β ⊆ Finset.univ ×ˢ (Finset.univ.filter fun g : Fin B → Option (Bits ℓ) =>
        (Finset.univ.filter fun i => g i ≠ none).card * ℓ ≤ β - S - B) := by
      intro x hx
      rw [fits, Finset.mem_filter] at hx
      rw [Finset.mem_product, Finset.mem_filter]
      exact ⟨Finset.mem_univ _, Finset.mem_univ _, by omega⟩
    refine (Finset.card_le_card hsub).trans ?_
    rw [Finset.card_product, Finset.card_univ, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
    calc 2 ^ S * _ ≤ 2 ^ S * (2 ^ B * 2 ^ (β - S - B)) := Nat.mul_le_mul_left _ (card_patches_le B ℓ _)
      _ = 2 ^ β := by rw [← pow_add, ← pow_add]; congr 1; omega
  · have : fits S B ℓ β = ∅ := by
      ext x
      rw [fits, Finset.mem_filter]
      simp only [Finset.mem_univ, true_and, Finset.notMem_empty, iff_false]
      omega
    rw [this, Finset.card_empty]
    exact Nat.zero_le _

/-- Replace every block where the prediction `P` differs from `C`. -/
def patch {B ℓ : ℕ} (P C : Fin B → Bits ℓ) : Fin B → Option (Bits ℓ) :=
  fun i => if P i = C i then none else some (C i)

/-- The patched block where there is one, else the prediction: this is `C`. -/
theorem patch_getD {B ℓ : ℕ} (P C : Fin B → Bits ℓ) (i : Fin B) : (patch P C i).getD (P i) = C i := by
  by_cases h : P i = C i <;> simp [patch, h]

/-- If the blocks where `P` differs from `C` fit (`S + B + #wrong·ℓ ≤ β`), so does the message `(σ, patch P C)`. -/
theorem mem_fits_patch {S B ℓ β : ℕ} (σ : Bits S) (P C : Fin B → Bits ℓ) {_ : DecidablePred fun i => ¬ P i = C i}
    (h : S + B + (Finset.univ.filter fun i => ¬ P i = C i).card * ℓ ≤ β) : (σ, patch P C) ∈ fits S B ℓ β := by
  rw [fits, Finset.mem_filter]
  refine ⟨Finset.mem_univ _, ?_⟩
  convert h using 4
  ext i
  by_cases hi : P i = C i <;> simp [patch, hi]

/-! ### More uniform probability -/

theorem pr_le_one {α : Type} [Fintype α] (P : α → Prop) : pr P ≤ 1 := by
  classical
  rw [pr_def]
  refine ENNReal.div_le_of_le_mul ?_
  rw [one_mul]
  exact_mod_cast (Finset.card_filter_le _ _).trans (Finset.card_univ).le

/-- An event of the first coordinate. -/
theorem pr_fst {α β : Type} [Fintype α] [Fintype β] [Nonempty β] (P : α → Prop) :
    pr (fun x : α × β => P x.1) = pr P := by
  rw [← pr_snd (α := β) P]
  exact pr_equiv (Equiv.prodComm α β) (fun x : β × α => P x.2)

/-- An event of the setup, seen on the whole outcome `Ω × Coins × I`. -/
theorem pr_le_outcome {α β γ : Type} [Fintype α] [Fintype β] [Fintype γ] [Nonempty γ]
    (E : α × β → Prop) (F : α × β × γ → Prop) (h : ∀ x : α × β × γ, E (x.1, x.2.1) → F x) : pr E ≤ pr F := by
  calc pr E = pr (fun y : (α × β) × γ => E y.1) := (pr_fst E).symm
    _ = pr (fun x : α × β × γ => E (x.1, x.2.1)) :=
        (pr_equiv (Equiv.prodAssoc α β γ).symm (fun y : (α × β) × γ => E y.1)).symm
    _ ≤ pr F := pr_mono h

/-- **Union bound.** -/
theorem pr_exists_le {α ι : Type} [Fintype α] (s : Finset ι) (P : ι → α → Prop) :
    pr (fun a => ∃ x ∈ s, P x a) ≤ ∑ x ∈ s, pr (P x) := by
  classical
  simp only [pr_def, div_eq_mul_inv]
  rw [← Finset.sum_mul]
  gcongr
  have : (Finset.univ.filter fun a => ∃ x ∈ s, P x a) = s.biUnion fun x => Finset.univ.filter (P x) := by
    ext a; simp
  rw [this]
  exact_mod_cast Finset.card_biUnion_le

/-- **Chain rule, as a bound.** A first-coordinate event of probability at most `c₁`, then a second-coordinate
event of conditional probability at most `c₂`. -/
theorem pr_and_le {α β : Type} [Fintype α] [Fintype β] [Nonempty α] [Nonempty β]
    (P : α → Prop) (R : α → β → Prop) (c₁ c₂ : ℝ≥0∞) (h₁ : pr P ≤ c₁) (h₂ : ∀ a, pr (R a) ≤ c₂) :
    pr (fun x : α × β => P x.1 ∧ R x.1 x.2) ≤ c₁ * c₂ := by
  classical
  have hα0 : (Fintype.card α : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hβ0 : (Fintype.card β : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hαt : (Fintype.card α : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hβt : (Fintype.card β : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hfib : ∀ a, ((Finset.univ.filter fun b => P a ∧ R a b).card : ℝ≥0∞) ≤
      (if P a then 1 else 0) * (c₂ * Fintype.card β) := by
    intro a
    by_cases ha : P a
    · simp only [ha, true_and, ite_true, one_mul]
      have := h₂ a
      rwa [pr_def, ENNReal.div_le_iff hβ0 hβt] at this
    · simp [ha]
  have hcount : ((Finset.univ.filter fun x : α × β => P x.1 ∧ R x.1 x.2).card : ℝ≥0∞) =
      ∑ a, ((Finset.univ.filter fun b => P a ∧ R a b).card : ℝ≥0∞) := by
    rw [Finset.natCast_card_filter, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.natCast_card_filter]
  have hP : ((Finset.univ.filter P).card : ℝ≥0∞) = ∑ a, (if P a then 1 else 0 : ℝ≥0∞) :=
    Finset.natCast_card_filter _ _
  have h1 := h₁
  rw [pr_def, ENNReal.div_le_iff hα0 hαt] at h1
  rw [pr_def, hcount, Fintype.card_prod, Nat.cast_mul, ENNReal.div_le_iff (mul_ne_zero hα0 hβ0)
    (ENNReal.mul_ne_top hαt hβt)]
  calc ∑ a, ((Finset.univ.filter fun b => P a ∧ R a b).card : ℝ≥0∞)
      ≤ ∑ a, (if P a then 1 else 0) * (c₂ * Fintype.card β) := Finset.sum_le_sum fun a _ => hfib a
    _ = ((Finset.univ.filter P).card : ℝ≥0∞) * (c₂ * Fintype.card β) := by rw [← Finset.sum_mul, ← hP]
    _ ≤ (c₁ * Fintype.card α) * (c₂ * Fintype.card β) := by gcongr
    _ = c₁ * c₂ * (Fintype.card α * Fintype.card β) := by ring

open Classical in
/-- One block: if the wrong blocks do not fit, a uniform block is right with probability at most `p₀`. -/
theorem pr_good_le_p₀ (B ℓ β S : ℕ) (hB : 0 < B) (good : Fin B → Prop)
    (h : ¬ S + B + (Finset.univ.filter fun i => ¬ good i).card * ℓ ≤ β) :
    pr good ≤ ENNReal.ofReal (p₀ β S B ℓ) := by
  have hgb := Finset.card_filter_add_card_filter_not (s := Finset.univ) good
  rw [Finset.card_univ, Fintype.card_fin] at hgb
  have hr := good_le_p₀ B ℓ β S _ _ hB hgb (by omega)
  have hB0 : (B : ℝ≥0∞) ≠ 0 := by exact_mod_cast hB.ne'
  rw [pr_def, Fintype.card_fin, ENNReal.div_le_iff hB0 (ENNReal.natCast_ne_top _)]
  calc ((Finset.univ.filter good).card : ℝ≥0∞)
      = ENNReal.ofReal ((Finset.univ.filter good).card : ℝ) := (ENNReal.ofReal_natCast _).symm
    _ ≤ ENNReal.ofReal (p₀ β S B ℓ * B) := ENNReal.ofReal_le_ofReal hr
    _ = ENNReal.ofReal (p₀ β S B ℓ) * B := by
        rw [ENNReal.ofReal_mul' (Nat.cast_nonneg _), ENNReal.ofReal_natCast]

/-! ### Programs -/

/-- Post-process a program's output; the queries are unchanged. -/
def progMap {M : IdealModel} {α β : Type} (g : α → β) : Prog M α → Prog M β
  | .ret a => .ret (g a)
  | .round qs k => .round qs fun as => progMap g (k as)

section progMap

variable {M : IdealModel} {α β : Type} (g : α → β) (f : M.Qry → M.Ans)

theorem run_progMap (p : Prog M α) : (progMap g p).run f = g (p.run f) := by
  induction p with
  | ret a => rfl
  | round qs k ih => exact ih _

theorem depth_progMap (p : Prog M α) : (progMap g p).depth f = p.depth f := by
  induction p with
  | ret a => rfl
  | round qs k ih => exact congrArg (· + 1) (ih _)

theorem work_progMap (p : Prog M α) : (progMap g p).work f = p.work f := by
  induction p with
  | ret a => rfl
  | round qs k ih => exact congrArg (qs.length + ·) (ih _)

theorem bounded_progMap {D Q : ℕ} {p : Prog M α} (h : p.Bounded D Q) : (progMap g p).Bounded D Q :=
  fun ω => by rw [depth_progMap, work_progMap]; exact h ω

end progMap

/-! ### Compression against `TimedINC` -/

open Classical in
/-- **The timed patch compressor.** Let `st` pick an `S`-bit state from the setup (any function of it) and `pred`
predict each block from `(W, pp, state)` within `(D, Q)`. Then the wrong predictions fit in `β` bits,
`S + B + #wrong·ℓ ≤ β`, with probability at most `π` under `TimedINC D Q β π`. -/
theorem pr_fits_le {M : IdealModel} (sch : Scheme M) (D Q β S : ℕ) (π : ℝ≥0∞) (hinc : TimedINC sch D Q β π)
    (W : Bits sch.n) (st : Bits sch.n → Bits sch.t → sch.Code → M.Ω → Bits S)
    (pred : Bits sch.n → Bits sch.t → Bits S → Fin sch.B → Prog M (Bits sch.ℓ))
    (hpred : ∀ W pp σ i, (pred W pp σ i).Bounded D Q) :
    pr (fun a : M.Ω × sch.Coins => S + sch.B + (Finset.univ.filter fun i =>
      ¬ (pred W (sch.enc W a.1 a.2).1 (st W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) i).run
        (M.answer a.1) = (sch.enc W a.1 a.2).2 i).card * sch.ℓ ≤ β) ≤ π := by
  obtain ⟨c, d, hcd⟩ := exists_code (fits S sch.B sch.ℓ β) β (card_fits_le S sch.B sch.ℓ β)
  let cmp : Bits sch.n → Bits sch.t → sch.Code → M.Ω → Bits β :=
    fun W pp C ω => c (st W pp C ω, patch (fun i => (pred W pp (st W pp C ω) i).run (M.answer ω)) C)
  let exp : Bits sch.n → Bits sch.t → Bits β → Fin sch.B → Prog M (Bits sch.ℓ) :=
    fun W pp w i => ((d w).2 i).elim (pred W pp (d w).1 i) Prog.ret
  have hexp : ∀ W pp w i, (exp W pp w i).Bounded D Q := by
    intro W pp w i
    cases h : (d w).2 i with
    | none => simp only [exp, h, Option.elim]; exact hpred _ _ _ _
    | some b => simp only [exp, h, Option.elim]; exact ret_bounded _ _ _
  refine le_trans (pr_mono fun a ha => ?_) (hinc W cmp exp hexp)
  have hfit := mem_fits_patch (st W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1)
    (fun i => (pred W (sch.enc W a.1 a.2).1 (st W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) i).run
      (M.answer a.1))
    (sch.enc W a.1 a.2).2 ha
  show ∀ i, (exp W _ (cmp W _ _ a.1) i).run (M.answer a.1) = _
  intro i
  simp only [exp, cmp, hcd _ hfit]
  rw [← patch_getD (fun i => (pred W (sch.enc W a.1 a.2).1
    (st W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) i).run (M.answer a.1)) (sch.enc W a.1 a.2).2 i]
  cases patch _ _ i <;> rfl

/-! ### Sequential responders -/

/-- A responder that keeps its state answers `is` by running `p σ` on each index. -/
theorem seqAnswers_keep {M : IdealModel} {ℓ S B : ℕ} (f : M.Qry → M.Ans) (p : Bits S → Fin B → Prog M (Bits ℓ)) :
    ∀ (j : ℕ) (is : List (Fin B)) (σ : Bits S),
      seqAnswers f (fun _ σ i => progMap (fun b => (b, σ)) (p σ i)) j is σ = is.map fun i => (p σ i).run f
  | _, [], _ => rfl
  | j, i :: is, σ => by
      simp only [seqAnswers, run_progMap, List.map_cons, seqAnswers_keep f p (j + 1) is σ]

/-- The state a sequential responder reaches after answering the history `h` from round `j` in state `σ`. -/
def seqState {M : IdealModel} {ℓ S B : ℕ} (f : M.Qry → M.Ans)
    (step : ℕ → Bits S → Fin B → Prog M (Bits ℓ × Bits S)) : ℕ → List (Fin B) → Bits S → Bits S
  | _, [], σ => σ
  | j, i :: is, σ => seqState f step (j + 1) is ((step j σ i).run f).2

/-- **Chain rule for sequential audits.** If after every history of fewer than `k` indices a uniform next index is
answered correctly with probability at most `c`, all `k` rounds are with probability at most `c^k`. -/
theorem pr_seq_le {M : IdealModel} {ℓ S B : ℕ} [NeZero B] (f : M.Qry → M.Ans)
    (step : ℕ → Bits S → Fin B → Prog M (Bits ℓ × Bits S)) (C : Fin B → Bits ℓ) (c : ℝ≥0∞) :
    ∀ (k j : ℕ) (σ : Bits S),
      (∀ h : List (Fin B), h.length < k →
        pr (fun i : Fin B => ((step (j + h.length) (seqState f step j h σ) i).run f).1 = C i) ≤ c) →
      pr (fun I : Fin k → Fin B => seqAnswers f step j (List.ofFn I) σ = List.ofFn fun t => C (I t)) ≤ c ^ k
  | 0, _, _, _ => by rw [pow_zero]; exact pr_le_one _
  | k + 1, j, σ, hyp => by
      rw [← pr_equiv (Fin.consEquiv fun _ : Fin (k + 1) => Fin B :
        Fin B × (Fin k → Fin B) ≃ (Fin (k + 1) → Fin B))]
      simp only [Fin.consEquiv_apply, List.ofFn_succ, Fin.cons_zero, Fin.cons_succ, seqAnswers, List.cons.injEq]
      rw [pow_succ']
      refine pr_and_le (α := Fin B) (β := Fin k → Fin B) (fun i₀ => ((step j σ i₀).run f).1 = C i₀)
        (fun i₀ I => seqAnswers f step (j + 1) (List.ofFn fun i => I i) ((step j σ i₀).run f).2 =
          List.ofFn fun i => C (I i)) c (c ^ k) ?_ fun i₀ => ?_
      · simpa [seqState] using hyp [] (Nat.succ_pos k)
      · refine pr_seq_le f step C c k (j + 1) _ fun h hh => ?_
        have := hyp (i₀ :: h) (by simp only [List.length_cons]; omega)
        simpa [seqState, Nat.add_assoc, Nat.add_comm 1] using this

end PousThm1Dense

namespace PousTargetsDense

open Pous PousThm1Dense
open scoped ENNReal

/-- Theorem 1(ii) for stateful sequential responders: one compressor per history of fewer than `k` indices, then a
union bound (the plug-in of tradeoff Theorem 1). -/
theorem theorem1_ii_seq {M : IdealModel} (sch : Scheme M) (D Q β S k : ℕ) (π : ℝ≥0∞)
    (hinc : TimedINC sch D Q β π) (W : Bits sch.n) (A₁ : Preprocessor sch S) (A₂ : SeqResponder sch S D Q) :
    pr (seqAccepts sch k W A₁ A₂) ≤
      (∑ j ∈ Finset.range k, (sch.B : ℝ≥0∞) ^ j) * π + ENNReal.ofReal (p₀ β S sch.B sch.ℓ) ^ k := by
  classical
  -- the state after history `h`, and whether round `|h|` answers block `i` correctly from it
  let st : List (Fin sch.B) → Bits sch.n → Bits sch.t → sch.Code → M.Ω → Bits S :=
    fun h W pp C ω => seqState (M.answer ω) (A₂.step W pp) 0 h (A₁ W pp C ω)
  let pred : List (Fin sch.B) → Bits sch.n → Bits sch.t → Bits S → Fin sch.B → Prog M (Bits sch.ℓ) :=
    fun h W pp σ i => progMap Prod.fst (A₂.step W pp h.length σ i)
  let good : List (Fin sch.B) → M.Ω × sch.Coins → Fin sch.B → Prop := fun h a i =>
    (pred h W (sch.enc W a.1 a.2).1 (st h W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) i).run
      (M.answer a.1) = (sch.enc W a.1 a.2).2 i
  let E : M.Ω × sch.Coins → Prop := fun a => ∃ j ∈ Finset.range k, ∃ v ∈ (Finset.univ : Finset (Fin j → Fin sch.B)),
    S + sch.B + (Finset.univ.filter fun i => ¬ good (List.ofFn v) a i).card * sch.ℓ ≤ β
  have hre : pr (seqAccepts sch k W A₁ A₂) = pr (fun x : (M.Ω × sch.Coins) × (Fin k → Fin sch.B) =>
      seqAnswers (M.answer x.1.1) (A₂.step W (sch.enc W x.1.1 x.1.2).1) 0 (List.ofFn x.2)
        (A₁ W (sch.enc W x.1.1 x.1.2).1 (sch.enc W x.1.1 x.1.2).2 x.1.1) =
      List.ofFn fun t => (sch.enc W x.1.1 x.1.2).2 (x.2 t)) :=
    pr_equiv (Equiv.prodAssoc _ _ _).symm (fun x : (M.Ω × sch.Coins) × (Fin k → Fin sch.B) =>
      seqAnswers (M.answer x.1.1) (A₂.step W (sch.enc W x.1.1 x.1.2).1) 0 (List.ofFn x.2)
        (A₁ W (sch.enc W x.1.1 x.1.2).1 (sch.enc W x.1.1 x.1.2).2 x.1.1) =
      List.ofFn fun t => (sch.enc W x.1.1 x.1.2).2 (x.2 t))
  rw [hre]
  have : Nonempty (Fin sch.B) := ⟨⟨0, sch.B_pos⟩⟩
  refine (pr_prod_le (α := M.Ω × sch.Coins) (β := Fin k → Fin sch.B)
    (fun a I => seqAnswers (M.answer a.1) (A₂.step W (sch.enc W a.1 a.2).1) 0 (List.ofFn I)
        (A₁ W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) =
      List.ofFn fun t => (sch.enc W a.1 a.2).2 (I t))
    E (ENNReal.ofReal (p₀ β S sch.B sch.ℓ) ^ k) fun a ha => ?_).trans (add_le_add ?_ le_rfl)
  · -- no history's wrong blocks fit: every round is right with probability at most `p₀`
    refine pr_seq_le _ _ _ _ k 0 _ fun h hh => ?_
    have hnf : ¬ S + sch.B + (Finset.univ.filter fun i => ¬ good h a i).card * sch.ℓ ≤ β := by
      intro hf
      refine ha ⟨h.length, Finset.mem_range.2 hh, h.get, Finset.mem_univ _, ?_⟩
      rwa [List.ofFn_get]
    have := pr_good_le_p₀ sch.B sch.ℓ β S sch.B_pos (good h a) (by convert hnf)
    simpa only [good, pred, st, run_progMap, Nat.zero_add] using this
  · -- one compressor per history, then a union bound
    calc pr E ≤ ∑ j ∈ Finset.range k, pr (fun a => ∃ v ∈ (Finset.univ : Finset (Fin j → Fin sch.B)),
          S + sch.B + (Finset.univ.filter fun i => ¬ good (List.ofFn v) a i).card * sch.ℓ ≤ β) :=
          pr_exists_le _ _
      _ ≤ ∑ j ∈ Finset.range k, ∑ _v : Fin j → Fin sch.B, π := by
          refine Finset.sum_le_sum fun j _ => (pr_exists_le _ _).trans (Finset.sum_le_sum fun v _ => ?_)
          exact pr_fits_le sch D Q β S π hinc W (st (List.ofFn v)) (pred (List.ofFn v))
            fun W pp σ i => bounded_progMap _ (A₂.bounded _ _ _ _ _)
      _ = (∑ j ∈ Finset.range k, (sch.B : ℝ≥0∞) ^ j) * π := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin,
            nsmul_eq_mul, Nat.cast_pow]

end PousTargetsDense

namespace PousB5Chain

open Pous Pous.Labelling
open scoped ENNReal

/-! ### Transcripts of a program, and what they depend on -/

section Trace

variable {M : IdealModel} {α : Type}

/-- The queries on the path taken when queries are answered by `f`, in order, each with its round (from 0). -/
def trace (f : M.Qry → M.Ans) : Prog M α → List (ℕ × M.Qry)
  | .ret _ => []
  | .round qs k => qs.map (fun x => (0, x)) ++ (trace f (k (qs.map f))).map fun e => (e.1 + 1, e.2)

theorem length_trace (f : M.Qry → M.Ans) (P : Prog M α) : (trace f P).length = P.work f := by
  induction P with
  | ret a => rfl
  | round qs k ih => simp [trace, Prog.work, ih]

theorem round_lt_depth (f : M.Qry → M.Ans) (P : Prog M α) : ∀ e ∈ trace f P, e.1 < P.depth f := by
  induction P with
  | ret a => simp [trace]
  | round qs k ih =>
    intro e he
    simp only [trace, List.mem_append, List.mem_map] at he
    simp only [Prog.depth]
    rcases he with ⟨x, _, rfl⟩ | ⟨e', he', rfl⟩
    · simp
    · have := ih _ e' he'
      simp only
      omega

/-- `f` and `g` agree on every point that `P` asks, under `f`, before round `r`. -/
def AgreeBefore (f g : M.Qry → M.Ans) (P : Prog M α) (r : ℕ) : Prop :=
  ∀ e ∈ trace f P, e.1 < r → f e.2 = g e.2

theorem mem_trace_round (f : M.Qry → M.Ans) (qs : List M.Qry) (k : List M.Ans → Prog M α) (x : M.Qry)
    (hx : x ∈ qs) : (0, x) ∈ trace f (.round qs k) := by
  simp only [trace, List.mem_append, List.mem_map]
  exact Or.inl ⟨x, hx, rfl⟩

theorem mem_trace_round_succ (f : M.Qry → M.Ans) (qs : List M.Qry) (k : List M.Ans → Prog M α)
    (e : ℕ × M.Qry) (he : e ∈ trace f (k (qs.map f))) : (e.1 + 1, e.2) ∈ trace f (.round qs k) := by
  simp only [trace, List.mem_append, List.mem_map]
  exact Or.inr ⟨e, he, rfl⟩

theorem agree_round {f g : M.Qry → M.Ans} {qs : List M.Qry} {k : List M.Ans → Prog M α} {r : ℕ}
    (h : AgreeBefore f g (.round qs k) (r + 1)) :
    qs.map f = qs.map g ∧ AgreeBefore f g (k (qs.map f)) r :=
  ⟨List.map_congr_left fun x hx => h (0, x) (mem_trace_round f qs k x hx) (Nat.succ_pos r),
    fun e he hlt => h (e.1 + 1, e.2) (mem_trace_round_succ f qs k e he) (by omega)⟩

/-- **Transcript locality.** If `f` and `g` agree on the points asked before round `r`, then the transcripts agree,
entry by entry, up to round `r`; and every entry of `g`'s transcript up to round `r` is one of `f`'s. -/
theorem trace_stable (f g : M.Qry → M.Ans) (P : Prog M α) : ∀ r : ℕ, AgreeBefore f g P r →
    (∀ (n : ℕ) (e : ℕ × M.Qry), (trace f P)[n]? = some e → e.1 ≤ r → (trace g P)[n]? = some e) ∧
    (∀ e ∈ trace g P, e.1 ≤ r → e ∈ trace f P) := by
  induction P with
  | ret a => intro r _; simp [trace]
  | round qs k ih =>
    intro r hag
    cases r with
    | zero =>
      constructor
      · intro n e hn he
        simp only [trace] at hn ⊢
        by_cases hlt : n < qs.length
        · rw [List.getElem?_append_left (by simpa using hlt)] at hn ⊢
          exact hn
        · rw [List.getElem?_append_right (by simpa using not_lt.1 hlt), List.getElem?_map,
            List.length_map] at hn
          cases hk : (trace f (k (qs.map f)))[n - qs.length]? with
          | none => rw [hk] at hn; simp at hn
          | some e' =>
            simp only [hk, Option.map_some, Option.some.injEq] at hn
            subst hn
            simp at he
      · intro e he he0
        simp only [trace, List.mem_append, List.mem_map] at he ⊢
        rcases he with ⟨x, hx, rfl⟩ | ⟨e', _, rfl⟩
        · exact Or.inl ⟨x, hx, rfl⟩
        · simp at he0
    | succ r =>
      obtain ⟨hqs, hag'⟩ := agree_round hag
      obtain ⟨ih1, ih2⟩ := ih (qs.map f) r hag'
      constructor
      · intro n e hn he
        simp only [trace] at hn ⊢
        rw [← hqs]
        by_cases hlt : n < qs.length
        · rw [List.getElem?_append_left (by simpa using hlt)] at hn ⊢
          exact hn
        · rw [List.getElem?_append_right (by simpa using not_lt.1 hlt), List.getElem?_map,
            List.length_map] at hn ⊢
          cases hk : (trace f (k (qs.map f)))[n - qs.length]? with
          | none => rw [hk] at hn; simp at hn
          | some e' =>
            simp only [hk, Option.map_some, Option.some.injEq] at hn
            subst hn
            rw [ih1 _ e' hk (by simp only at he; omega)]
            rfl
      · intro e he her
        simp only [trace, List.mem_append, List.mem_map] at he ⊢
        rw [← hqs] at he
        rcases he with ⟨x, hx, rfl⟩ | ⟨e', he', rfl⟩
        · exact Or.inl ⟨x, hx, rfl⟩
        · exact Or.inr ⟨e', ih2 e' he' (by simp only at her; omega), rfl⟩

/-- **Output locality.** A program that stops by round `r` returns the same output, at the same depth, under any
oracle that agrees with `f` on the points asked before round `r`. -/
theorem run_stable (f g : M.Qry → M.Ans) (P : Prog M α) : ∀ r : ℕ, AgreeBefore f g P r → P.depth f ≤ r →
    P.run g = P.run f ∧ P.depth g = P.depth f := by
  induction P with
  | ret a => intro _ _ _; exact ⟨rfl, rfl⟩
  | round qs k ih =>
    intro r hag hd
    cases r with
    | zero => simp [Prog.depth] at hd
    | succ r =>
      obtain ⟨hqs, hag'⟩ := agree_round hag
      have hd' : (k (qs.map f)).depth f ≤ r := by simp only [Prog.depth] at hd; omega
      obtain ⟨h1, h2⟩ := ih (qs.map f) r hag' hd'
      simp only [Prog.run, Prog.depth, ← hqs]
      exact ⟨h1, by rw [h2]⟩

theorem work_le_depth_mul_width (f : M.Qry → M.Ans) (P : Prog M α) : P.work f ≤ P.depth f * P.width f := by
  induction P with
  | ret a => simp [Prog.work]
  | round qs k ih =>
    simp only [Prog.work, Prog.depth, Prog.width]
    have h1 := ih (qs.map f)
    have h2 : (k (qs.map f)).depth f * (k (qs.map f)).width f ≤
        (k (qs.map f)).depth f * max qs.length ((k (qs.map f)).width f) :=
      Nat.mul_le_mul_left _ (le_max_right _ _)
    have h3 : qs.length ≤ max qs.length ((k (qs.map f)).width f) := le_max_left _ _
    rw [Nat.succ_mul]
    omega

end Trace

/-! ### Labels -/

section Labels

variable {N w : ℕ}

/-- The real query of node `i`: its index and its parents' labels. -/
def realQ (G : TopoDAG N) (d : Fin N → Bits w) (H : LabelQry N w → Bits w) (i : Fin N) : LabelQry N w :=
  (i, fun j => if j ∈ G.par i then some (label G d H j) else none)

theorem label_eq (G : TopoDAG N) (d : Fin N → Bits w) (H : LabelQry N w → Bits w) (i : Fin N) :
    label G d H i = bxor (H (realQ G d H i)) (d i) := by
  rw [label]
  simp only [dite_eq_ite]
  rfl

theorem bxor_cancel (a b : Bits w) : bxor (bxor a b) b = a :=
  funext fun j => by simp [bxor]

theorem eq_bxor_of_bxor_eq {a b v : Bits w} (h : bxor a b = v) : a = bxor v b := by
  rw [← h, bxor_cancel]

/-- **Label locality.** A label depends only on the oracle at the real queries of its ancestors and itself. -/
theorem label_congr (G : TopoDAG N) (d : Fin N → Bits w) {H H' : LabelQry N w → Bits w} (i : Fin N)
    (h : ∀ j ≤ i, H' (realQ G d H j) = H (realQ G d H j)) : label G d H' i = label G d H i := by
  induction i using WellFoundedLT.induction with
  | _ i ih =>
    have hq : realQ G d H' i = realQ G d H i := by
      unfold realQ
      congr 1
      funext j
      split_ifs with hj
      · rw [ih j (G.par_lt i j hj) fun j' hj' => h j' (hj'.trans (G.par_lt i j hj).le)]
      · rfl
    rw [label_eq, label_eq, hq, h i le_rfl]

theorem realQ_congr (G : TopoDAG N) (d : Fin N → Bits w) {H H' : LabelQry N w → Bits w} (i : Fin N)
    (h : ∀ j < i, H' (realQ G d H j) = H (realQ G d H j)) : realQ G d H' i = realQ G d H i := by
  unfold realQ
  congr 1
  funext j
  split_ifs with hj
  · rw [label_congr G d j fun j' hj' => h j' (lt_of_le_of_lt hj' (G.par_lt i j hj))]
  · rfl

end Labels

end PousB5Chain

namespace PousB5Chain

open Pous Pous.Labelling
open scoped ENNReal

variable {N w : ℕ}

/-- B5's oracle model. -/
abbrev RO (N w : ℕ) : IdealModel := IdealModel.randomOracle (LabelQry N w) (Bits w)

/-- One replay, for a fixed preprocessed state: the graph, the data, the challenges, the budget and the online
programs `P c = A₂(σ, c)`. -/
structure Replay (N w : ℕ) where
  G : TopoDAG N
  d : Fin N → Bits w
  VC : Finset (Fin N)
  D : ℕ
  Q : ℕ
  P : Fin N → Prog (RO N w) (Bits w)

namespace Replay

variable (R : Replay N w)

/-- Positions of the replay: slot `k < Q` of a challenge's thread is its `k`-th query and slot `Q` its guess;
`inr i` is the sequential labeller's query of node `i`. There are `|VC|·(Q + 1) + N` of them. -/
abbrev Pos : Type := ({c // c ∈ R.VC} × Fin (R.Q + 1)) ⊕ Fin N

/-- Thread `c`'s transcript, at the query type `LabelQry N w`. -/
def tr (H : LabelQry N w → Bits w) (c : Fin N) : List (ℕ × LabelQry N w) := trace H (R.P c)

/-- Some thread asks `z` in round `ρ`. -/
def askedAt (H : LabelQry N w → Bits w) (z : LabelQry N w) (ρ : ℕ) : Prop :=
  ∃ c ∈ R.VC, (ρ, z) ∈ R.tr H c

theorem tr_stable {H H' : LabelQry N w → Bits w} {c : Fin N} {κ : ℕ} (h : AgreeBefore H H' (R.P c) κ) :
    (∀ (n : ℕ) (e : ℕ × LabelQry N w), (R.tr H c)[n]? = some e → e.1 ≤ κ → (R.tr H' c)[n]? = some e) ∧
    (∀ e ∈ R.tr H' c, e.1 ≤ κ → e ∈ R.tr H c) :=
  trace_stable (M := RO N w) H H' (R.P c) κ h

theorem tr_round_lt (hP : ∀ c, (R.P c).Bounded R.D R.Q) (H : LabelQry N w → Bits w) (c : Fin N) :
    ∀ e ∈ R.tr H c, e.1 < R.D :=
  fun e he => lt_of_lt_of_le (round_lt_depth (M := RO N w) H (R.P c) e he) (hP c H).1

theorem tr_length (hP : ∀ c, (R.P c).Bounded R.D R.Q) (H : LabelQry N w → Bits w) (c : Fin N) :
    (R.tr H c).length ≤ R.Q :=
  (length_trace (M := RO N w) H (R.P c)).le.trans (hP c H).2

/-- The query at a position, as `(node, point, round)`; the labeller's queries come after every round. -/
def realAt (H : LabelQry N w → Bits w) : R.Pos → Option (Fin N × LabelQry N w × ℕ)
  | .inl (c, k) =>
      if k.val < R.Q then ((R.tr H c.1)[k.val]?).map fun e => (e.2.1, e.2, e.1) else none
  | .inr i => some (i, realQ R.G R.d H i, R.D + i.val)

/-- What a position shows about node `i`'s label, with the time it is shown: the `i`-th entry of a query's input
(at its round), or thread `i`'s guess (at its depth). -/
def obsAt (H : LabelQry N w → Bits w) (i : Fin N) : R.Pos → Option (Bits w × ℕ)
  | .inl (c, k) =>
      if k.val < R.Q then
        ((R.tr H c.1)[k.val]?).bind fun e => (e.2.2 i).map fun v => (v, e.1)
      else if c.1 = i then some ((R.P c.1).run H, (R.P c.1).depth H) else none
  | .inr _ => none

/-- A pair `(o, r)` of positions *predicts* the answer at `r`: the point asked at `r` is asked in no earlier
round, and its answer, XOR the data, is what `o` showed no later than `r`'s round. -/
def cond (H : LabelQry N w → Bits w) (p : R.Pos × R.Pos) : Prop :=
  ∃ i z κ v τ, R.realAt H p.2 = some (i, z, κ) ∧ R.obsAt H i p.1 = some (v, τ) ∧ τ ≤ κ ∧
    (∀ ρ < κ, ¬ R.askedAt H z ρ) ∧ bxor (H z) (R.d i) = v

/-- Two predicted positions concern different nodes and come in round order. -/
def rel (H : LabelQry N w → Bits w) (t t' : R.Pos × R.Pos) : Prop :=
  ∀ i z κ i' z' κ', R.realAt H t.2 = some (i, z, κ) → R.realAt H t'.2 = some (i', z', κ') → i ≠ i' ∧ κ ≤ κ'

/-- The pattern `π` of predictions holds. -/
def Ev (π : List (R.Pos × R.Pos)) (H : LabelQry N w → Bits w) : Prop :=
  (∀ t ∈ π, R.cond H t) ∧ π.Pairwise (R.rel H)

theorem Ev_take {π : List (R.Pos × R.Pos)} {H : LabelQry N w → Bits w} (n : ℕ) (h : R.Ev π H) :
    R.Ev (π.take n) H :=
  ⟨fun t ht => h.1 t (List.mem_of_mem_take ht), h.2.sublist (List.take_sublist _ _)⟩

theorem realAt_fst {H : LabelQry N w → Bits w} {p : R.Pos} {i : Fin N} {z : LabelQry N w} {κ : ℕ}
    (h : R.realAt H p = some (i, z, κ)) : z.1 = i := by
  cases p with
  | inl ck =>
    obtain ⟨c, k⟩ := ck
    simp only [realAt] at h
    split_ifs at h
    cases he : (R.tr H c.1)[k.val]? with
    | none => simp [he] at h
    | some e =>
      simp only [he, Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      rfl
  | inr j =>
    simp only [realAt, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl, rfl⟩ := h
    rfl

theorem realAt_inl_lt (hP : ∀ c, (R.P c).Bounded R.D R.Q) {H : LabelQry N w → Bits w} {c k} {i : Fin N}
    {z : LabelQry N w} {κ : ℕ} (h : R.realAt H (.inl (c, k)) = some (i, z, κ)) : κ < R.D := by
  simp only [realAt] at h
  split_ifs at h
  cases he : (R.tr H c.1)[k.val]? with
  | none => simp [he] at h
  | some e =>
    simp only [he, Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl, rfl⟩ := h
    exact R.tr_round_lt hP H c.1 e (List.mem_of_getElem? he)

section Stable

variable {H H' : LabelQry N w → Bits w} {κ : ℕ} (hag : ∀ c ∈ R.VC, AgreeBefore H H' (R.P c) κ)
include hag

theorem realAt_inl_stable {c k} {x : Fin N × LabelQry N w × ℕ} (h : R.realAt H (.inl (c, k)) = some x)
    (hx : x.2.2 ≤ κ) : R.realAt H' (.inl (c, k)) = some x := by
  simp only [realAt] at h ⊢
  split_ifs at h ⊢ with hk
  cases he : (R.tr H c.1)[k.val]? with
  | none => simp [he] at h
  | some e =>
    rw [he, Option.map_some, Option.some.injEq] at h
    subst h
    rw [(R.tr_stable (hag c.1 c.2)).1 _ e he hx, Option.map_some]

theorem obsAt_stable {i : Fin N} {o : R.Pos} {v : Bits w} {τ : ℕ} (h : R.obsAt H i o = some (v, τ))
    (hτ : τ ≤ κ) : R.obsAt H' i o = some (v, τ) := by
  cases o with
  | inl ck =>
    obtain ⟨c, k⟩ := ck
    simp only [obsAt] at h ⊢
    split_ifs at h ⊢ with hk hci
    · cases he : (R.tr H c.1)[k.val]? with
      | none => simp [he] at h
      | some e =>
        rw [he, Option.bind_some] at h
        have he1 : e.1 = τ := by
          cases hv : (e.2 : LabelQry N w).2 i with
          | none => simp [hv] at h
          | some v' =>
            simp only [hv, Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
            exact h.2
        rw [(R.tr_stable (hag c.1 c.2)).1 _ e he (he1 ▸ hτ), Option.bind_some]
        exact h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      obtain ⟨h1, h2⟩ := run_stable (M := RO N w) H H' (R.P c.1) κ (hag c.1 c.2) hτ
      rw [h1, h2]
  | inr j => simp [obsAt] at h

theorem askedAt_stable {z : LabelQry N w} {ρ : ℕ} (hρ : ρ < κ) (h : R.askedAt H' z ρ) : R.askedAt H z ρ := by
  obtain ⟨c, hc, he⟩ := h
  exact ⟨c, hc, (R.tr_stable (hag c hc)).2 _ he hρ.le⟩

end Stable

/-- **Resampling at the last prediction.** Changing the oracle at the point `z` asked at the last predicted
position keeps the other predictions, the last position's query, and what its observation showed. -/
theorem Ev_update (hP : ∀ c, (R.P c).Bounded R.D R.Q) {π : List (R.Pos × R.Pos)} {t : R.Pos × R.Pos}
    {H : LabelQry N w → Bits w} {i : Fin N} {z : LabelQry N w} {κ : ℕ} (hE : R.Ev (π ++ [t]) H)
    (hr : R.realAt H t.2 = some (i, z, κ)) (y : Bits w) :
    R.Ev π (Function.update H z y) ∧ R.realAt (Function.update H z y) t.2 = R.realAt H t.2 ∧
      ∀ v τ, R.obsAt H i t.1 = some (v, τ) → τ ≤ κ → R.obsAt (Function.update H z y) i t.1 = some (v, τ) := by
  obtain ⟨hcond, hpw⟩ := hE
  rw [List.pairwise_append] at hpw
  obtain ⟨hpw, -, hlast⟩ := hpw
  obtain ⟨i₀, z₀, κ₀, v, τ, hr₀, ho, hτ, hfresh, heq⟩ := hcond t (by simp)
  rw [hr] at hr₀
  simp only [Option.some.injEq, Prod.mk.injEq] at hr₀
  obtain ⟨rfl, rfl, rfl⟩ := hr₀
  have hag : ∀ c ∈ R.VC, AgreeBefore H (Function.update H z y : LabelQry N w → Bits w) (R.P c) κ := by
    intro c hc e he hlt
    have hne : (e.2 : LabelQry N w) ≠ z := fun h => hfresh e.1 hlt ⟨c, hc, by rw [← h]; exact he⟩
    exact (Function.update_of_ne (α := LabelQry N w) hne y H).symm
  have hzi : z.1 = i := R.realAt_fst hr
  -- the labeller's queries before the last one keep their labels
  have hinr : ∀ j : Fin N, R.D + j.val ≤ κ → ∀ j' < j,
      Function.update H z y (realQ R.G R.d H j') = H (realQ R.G R.d H j') := by
    intro j hj j' hj'
    apply Function.update_of_ne
    intro h
    cases ht : t.2 with
    | inl ck =>
      rw [ht] at hr
      have := R.realAt_inl_lt hP hr
      omega
    | inr j₀ =>
      rw [ht] at hr
      simp only [realAt, Option.some.injEq, Prod.mk.injEq] at hr
      obtain ⟨-, hz, hκ⟩ := hr
      have h1 : j' = j₀ := by
        have := congrArg Prod.fst (h.trans hz.symm)
        simpa [realQ] using this
      have h2 : (j' : ℕ) < j := hj'
      subst h1
      omega
  have hstab : ∀ (p : R.Pos) (i' : Fin N) (z' : LabelQry N w) (κ' : ℕ), R.realAt H p = some (i', z', κ') →
      κ' ≤ κ → R.realAt (Function.update H z y) p = R.realAt H p := by
    intro p i' z' κ' hp hκ'
    cases p with
    | inl ck =>
      obtain ⟨c, k⟩ := ck
      rw [hp]
      exact R.realAt_inl_stable hag hp hκ'
    | inr j =>
      have hκj : R.D + j.val = κ' := by
        simp only [realAt, Option.some.injEq, Prod.mk.injEq] at hp
        exact hp.2.2
      simp only [realAt]
      rw [realQ_congr R.G R.d j (hinr j (hκj ▸ hκ'))]
  have hRA : ∀ a ∈ π, R.realAt (Function.update H z y) a.2 = R.realAt H a.2 := by
    intro a ha
    obtain ⟨i', z', κ', -, -, hr', -⟩ := hcond a (List.mem_append_left _ ha)
    exact hstab _ _ _ _ hr' (hlast a ha t (by simp) i' z' κ' i z κ hr' hr).2
  refine ⟨⟨fun t' ht' => ?_, ?_⟩, hstab t.2 i z κ hr le_rfl, fun v' τ' ho' hτ' => R.obsAt_stable hag ho' hτ'⟩
  · obtain ⟨i', z', κ', v', τ', hr', ho', hτ', hfr', heq'⟩ := hcond t' (List.mem_append_left _ ht')
    obtain ⟨hne, hκ'⟩ := hlast t' ht' t (by simp) i' z' κ' i z κ hr' hr
    have hz' : z' ≠ z := fun h => hne (by rw [← R.realAt_fst hr', ← hzi, h])
    refine ⟨i', z', κ', v', τ', (hRA t' ht').trans hr', R.obsAt_stable hag ho' (hτ'.trans hκ'), hτ',
      fun ρ hρ ha => hfr' ρ hρ (R.askedAt_stable hag (lt_of_lt_of_le hρ hκ') ha), ?_⟩
    rw [Function.update_of_ne hz']
    exact heq'
  · refine hpw.imp_of_mem fun {a b} ha hb hab => ?_
    intro i₁ z₁ κ₁ i₂ z₂ κ₂ h₁ h₂
    rw [hRA a ha] at h₁
    rw [hRA b hb] at h₂
    exact hab i₁ z₁ κ₁ i₂ z₂ κ₂ h₁ h₂

end Replay

end PousB5Chain

namespace PousB5Chain

open Pous Pous.Labelling
open scoped ENNReal

variable {N w : ℕ}

/-- **Union bound** (from `thm1-family`). -/
theorem pr_exists_le {α ι : Type} [Fintype α] (s : Finset ι) (P : ι → α → Prop) :
    pr (fun a => ∃ x ∈ s, P x a) ≤ ∑ x ∈ s, pr (P x) := by
  classical
  simp only [pr_def, div_eq_mul_inv]
  rw [← Finset.sum_mul]
  gcongr
  have : (Finset.univ.filter fun a => ∃ x ∈ s, P x a) = s.biUnion fun x => Finset.univ.filter (P x) := by
    ext a; simp
  rw [this]
  exact_mod_cast Finset.card_biUnion_le

/-! ### Pebbling -/

theorem subset_reach (G : TopoDAG N) (P₀ : Finset (Fin N)) : ∀ r, P₀ ⊆ reach G P₀ r
  | 0 => le_rfl
  | r + 1 => (subset_reach G P₀ r).trans Finset.subset_union_left

theorem mem_reach_succ (G : TopoDAG N) (P₀ : Finset (Fin N)) (r : ℕ) (v : Fin N)
    (h : G.par v ⊆ reach G P₀ r) : v ∈ reach G P₀ (r + 1) :=
  Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩)

namespace Replay

variable (R : Replay N w)

/-! ### A prediction costs `w` bits -/

open Classical in
/-- **One prediction costs `w` bits.** Resampling the last predicted point is injective and stays in the event of
the shorter pattern, while exactly one of the `2^w` answers makes the prediction come true. -/
theorem card_Ev_snoc (hP : ∀ c, (R.P c).Bounded R.D R.Q) (π : List (R.Pos × R.Pos)) (t : R.Pos × R.Pos) :
    (Finset.univ.filter (R.Ev (π ++ [t]))).card * 2 ^ w ≤ (Finset.univ.filter (R.Ev π)).card := by
  let f : (LabelQry N w → Bits w) × Bits w → (LabelQry N w → Bits w) := fun p =>
    match R.realAt p.1 t.2 with
    | some x => Function.update p.1 x.2.1 p.2
    | none => p.1
  have hcard : ((Finset.univ.filter (R.Ev (π ++ [t]))) ×ˢ (Finset.univ : Finset (Bits w))).card =
      (Finset.univ.filter (R.Ev (π ++ [t]))).card * 2 ^ w := by
    rw [Finset.card_product, Finset.card_univ, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
  rw [← hcard]
  refine Finset.card_le_card_of_injOn f ?_ ?_
  · intro p hp
    rw [Finset.mem_coe, Finset.mem_product, Finset.mem_filter] at hp
    obtain ⟨⟨-, hE⟩, -⟩ := hp
    obtain ⟨i, z, κ, v, τ, hr, -⟩ := hE.1 t (by simp)
    rw [Finset.mem_coe, Finset.mem_filter]
    refine ⟨Finset.mem_univ _, ?_⟩
    simp only [f, hr]
    exact (R.Ev_update hP hE hr p.2).1
  · intro p₁ hp₁ p₂ hp₂ heq
    rw [Finset.mem_coe, Finset.mem_product, Finset.mem_filter] at hp₁ hp₂
    obtain ⟨⟨-, hE₁⟩, -⟩ := hp₁
    obtain ⟨⟨-, hE₂⟩, -⟩ := hp₂
    obtain ⟨i₁, z₁, κ₁, v₁, τ₁, hr₁, ho₁, hτ₁, -, heq₁⟩ := hE₁.1 t (by simp)
    obtain ⟨i₂, z₂, κ₂, v₂, τ₂, hr₂, ho₂, hτ₂, -, heq₂⟩ := hE₂.1 t (by simp)
    simp only [f, hr₁, hr₂] at heq
    obtain ⟨-, hra₁, hob₁⟩ := R.Ev_update hP hE₁ hr₁ p₁.2
    obtain ⟨-, hra₂, hob₂⟩ := R.Ev_update hP hE₂ hr₂ p₂.2
    rw [heq, hr₁] at hra₁
    rw [hra₁, hr₂, Option.some.injEq, Prod.mk.injEq, Prod.mk.injEq] at hra₂
    obtain ⟨rfl, rfl, rfl⟩ := hra₂
    have hv := (hob₁ v₁ τ₁ ho₁ hτ₁).symm.trans (heq ▸ hob₂ v₂ τ₂ ho₂ hτ₂)
    rw [Option.some.injEq, Prod.mk.injEq] at hv
    obtain ⟨rfl, -⟩ := hv
    have hz : p₁.1 z₁ = p₂.1 z₁ := by
      rw [eq_bxor_of_bxor_eq heq₁, eq_bxor_of_bxor_eq heq₂]
    have h1 : p₁.1 = p₂.1 := by
      funext x
      by_cases hx : x = z₁
      · rw [hx, hz]
      · have := congrFun heq x
        rwa [Function.update_of_ne hx, Function.update_of_ne hx] at this
    have h2 : p₁.2 = p₂.2 := by
      have := congrFun heq z₁
      rwa [Function.update_self, Function.update_self] at this
    exact Prod.ext h1 h2

open Classical in
theorem card_Ev (hP : ∀ c, (R.P c).Bounded R.D R.Q) (π : List (R.Pos × R.Pos)) :
    (Finset.univ.filter (R.Ev π)).card * (2 ^ w) ^ π.length ≤ Fintype.card (LabelQry N w → Bits w) := by
  induction π using List.reverseRecOn with
  | nil =>
    rw [List.length_nil, pow_zero, mul_one]
    exact (Finset.card_filter_le _ _).trans Finset.card_univ.le
  | append_singleton π t ih =>
    rw [List.length_append, List.length_singleton, pow_succ]
    calc (Finset.univ.filter (R.Ev (π ++ [t]))).card * ((2 ^ w) ^ π.length * 2 ^ w)
        = (Finset.univ.filter (R.Ev (π ++ [t]))).card * 2 ^ w * (2 ^ w) ^ π.length := by ring
      _ ≤ (Finset.univ.filter (R.Ev π)).card * (2 ^ w) ^ π.length :=
          Nat.mul_le_mul_right _ (R.card_Ev_snoc hP π t)
      _ ≤ _ := ih

/-- A pattern of `n` predictions holds with probability at most `2^(-w·n)`. -/
theorem pr_Ev (hP : ∀ c, (R.P c).Bounded R.D R.Q) (π : List (R.Pos × R.Pos)) :
    pr (R.Ev π) ≤ ((2 ^ w : ℝ≥0∞)⁻¹) ^ π.length := by
  classical
  have hΩ0 : (Fintype.card (LabelQry N w → Bits w) : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (LabelQry N w → Bits w) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : ((2 : ℝ≥0∞) ^ w) ^ π.length ≠ 0 := pow_ne_zero _ (pow_ne_zero _ two_ne_zero)
  have h2t : ((2 : ℝ≥0∞) ^ w) ^ π.length ≠ ⊤ := ENNReal.pow_ne_top (ENNReal.pow_ne_top ENNReal.ofNat_ne_top)
  rw [pr_def, ENNReal.div_le_iff hΩ0 hΩt]
  have hc : ((Finset.univ.filter (R.Ev π)).card : ℝ≥0∞) * ((2 : ℝ≥0∞) ^ w) ^ π.length ≤
      Fintype.card (LabelQry N w → Bits w) := by exact_mod_cast R.card_Ev hP π
  calc ((Finset.univ.filter (R.Ev π)).card : ℝ≥0∞)
      = (Finset.univ.filter (R.Ev π)).card * ((2 : ℝ≥0∞) ^ w) ^ π.length * (((2 : ℝ≥0∞) ^ w) ^ π.length)⁻¹ := by
        rw [mul_assoc, ENNReal.mul_inv_cancel h2 h2t, mul_one]
    _ ≤ Fintype.card (LabelQry N w → Bits w) * (((2 : ℝ≥0∞) ^ w) ^ π.length)⁻¹ := by gcongr
    _ = ((2 ^ w : ℝ≥0∞)⁻¹) ^ π.length * Fintype.card (LabelQry N w → Bits w) := by
        rw [ENNReal.inv_pow, mul_comm]

/-! ### Fresh labels and the ex post facto pebbling -/

/-- Node `i`'s label is *fresh*: some query's input shows it no later than the first round that asks `i`'s real
query, or thread `i` guesses it correctly before that round. -/
def fresh (H : LabelQry N w → Bits w) (i : Fin N) : Prop :=
  (∃ c ∈ R.VC, ∃ e ∈ R.tr H c, e.2.2 i = some (label R.G R.d H i) ∧
      ∀ ρ < e.1, ¬ R.askedAt H (realQ R.G R.d H i) ρ) ∨
    (i ∈ R.VC ∧ (R.P i).run H = label R.G R.d H i ∧
      ∀ ρ < (R.P i).depth H, ¬ R.askedAt H (realQ R.G R.d H i) ρ)

open Classical in
/-- **The ex post facto pebbling.** Pebbling the fresh labels first and then every node whose real query is asked
is legal: a node whose real query is asked before round `r` is pebbled within `r` rounds. -/
theorem mem_reach_of_asked (H : LabelQry N w → Bits w) :
    ∀ (r : ℕ) (i : Fin N), (∃ ρ < r, R.askedAt H (realQ R.G R.d H i) ρ) →
      i ∈ reach R.G (Finset.univ.filter (R.fresh H)) r
  | 0, _, ⟨_, hρ, _⟩ => absurd hρ (Nat.not_lt_zero _)
  | r + 1, i, ⟨ρ, hρ, c, hc, he⟩ => by
    refine mem_reach_succ _ _ r i fun j hj => ?_
    by_cases hf : R.fresh H j
    · exact subset_reach _ _ r (Finset.mem_filter.2 ⟨Finset.mem_univ _, hf⟩)
    · have hshow : (realQ R.G R.d H i).2 j = some (label R.G R.d H j) := by simp [realQ, hj]
      have : ∃ ρ' < ρ, R.askedAt H (realQ R.G R.d H j) ρ' := by
        by_contra hno
        push Not at hno
        exact hf (Or.inl ⟨c, hc, (ρ, realQ R.G R.d H i), he, hshow, fun ρ' hρ' ha => hno ρ' hρ' ha⟩)
      obtain ⟨ρ', hρ', ha⟩ := this
      exact mem_reach_of_asked H r j ⟨ρ', by omega, ha⟩

open Classical in
/-- Every correctly answered challenge is pebbled within `D` rounds from the fresh labels. -/
theorem correct_mem_reach (hP : ∀ c, (R.P c).Bounded R.D R.Q) (H : LabelQry N w → Bits w) (c : Fin N)
    (hc : c ∈ R.VC) (hcorr : (R.P c).run H = label R.G R.d H c) :
    c ∈ reach R.G (Finset.univ.filter (R.fresh H)) R.D := by
  by_cases ha : ∃ ρ < R.D, R.askedAt H (realQ R.G R.d H c) ρ
  · exact R.mem_reach_of_asked H R.D c ha
  · push Not at ha
    refine subset_reach _ _ R.D (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inr ⟨hc, hcorr, fun ρ hρ => ?_⟩⟩)
    exact ha ρ (lt_of_lt_of_le hρ (hP c H).1)

/-! ### The prediction of a fresh label -/

open Classical in
/-- The first position asking node `i`'s real query (the labeller's, if no thread does), and its round. -/
theorem exists_real (hP : ∀ c, (R.P c).Bounded R.D R.Q) (H : LabelQry N w → Bits w) (i : Fin N) :
    ∃ (r : R.Pos) (κ : ℕ), R.realAt H r = some (i, realQ R.G R.d H i, κ) ∧
      (∀ ρ < κ, ¬ R.askedAt H (realQ R.G R.d H i) ρ) ∧
      ∀ τ ≤ R.D, (∀ ρ < τ, ¬ R.askedAt H (realQ R.G R.d H i) ρ) → τ ≤ κ := by
  by_cases h : ∃ ρ, R.askedAt H (realQ R.G R.d H i) ρ
  · obtain ⟨c, hc, he⟩ := Nat.find_spec h
    obtain ⟨n, hn⟩ := List.mem_iff_getElem?.1 he
    have hnQ : n < R.Q := lt_of_lt_of_le (List.getElem?_eq_some_iff.1 hn).1 (R.tr_length hP H c)
    refine ⟨.inl (⟨c, hc⟩, ⟨n, by omega⟩), Nat.find h, ?_, fun ρ hρ => Nat.find_min h hρ, fun τ _ hτ => ?_⟩
    · simp only [realAt, hnQ, ↓reduceIte, hn, Option.map_some]
      rfl
    · by_contra hlt
      exact hτ _ (not_le.1 hlt) (Nat.find_spec h)
  · push Not at h
    refine ⟨.inr i, R.D + i.val, rfl, fun ρ _ => h ρ, fun τ hτ _ => by omega⟩

open Classical in
/-- A fresh label gives a prediction whose real position asks that node's real query. -/
theorem exists_pair (hP : ∀ c, (R.P c).Bounded R.D R.Q) (H : LabelQry N w → Bits w) (i : Fin N)
    (hi : R.fresh H i) :
    ∃ x : (R.Pos × R.Pos) × ℕ, R.realAt H x.1.2 = some (i, realQ R.G R.d H i, x.2) ∧ R.cond H x.1 := by
  obtain ⟨r, κ, hr, hfr, hle⟩ := R.exists_real hP H i
  have hobs : ∃ (o : R.Pos) (τ : ℕ), R.obsAt H i o = some (label R.G R.d H i, τ) ∧ τ ≤ κ := by
    rcases hi with ⟨c, hc, e, he, hv, hno⟩ | ⟨hiVC, hrun, hno⟩
    · obtain ⟨n, hn⟩ := List.mem_iff_getElem?.1 he
      have hnQ : n < R.Q := lt_of_lt_of_le (List.getElem?_eq_some_iff.1 hn).1 (R.tr_length hP H c)
      refine ⟨.inl (⟨c, hc⟩, ⟨n, by omega⟩), e.1, ?_, hle _ (R.tr_round_lt hP H c e he).le hno⟩
      simp only [obsAt, hnQ, ↓reduceIte, hn, Option.bind_some, hv, Option.map_some]
    · refine ⟨.inl (⟨i, hiVC⟩, ⟨R.Q, Nat.lt_succ_self _⟩), (R.P i).depth H, ?_, hle _ (hP i H).1 hno⟩
      simp only [obsAt, lt_irrefl, ↓reduceIte, hrun]
  obtain ⟨o, τ, ho, hτ⟩ := hobs
  exact ⟨((o, r), κ), hr, i, _, κ, _, τ, hr, ho, hτ, hfr, (label_eq R.G R.d H i).symm⟩

open Classical in
/-- **The fresh pattern.** Predictions for all the fresh labels, in round order, hold together. -/
theorem exists_Ev (hP : ∀ c, (R.P c).Bounded R.D R.Q) (H : LabelQry N w → Bits w) (F : Finset (Fin N))
    (hF : ∀ i ∈ F, R.fresh H i) : ∃ π : List (R.Pos × R.Pos), π.length = F.card ∧ R.Ev π H := by
  choose x hx using fun i : F => R.exists_pair hP H i.1 (hF i.1 i.2)
  let l := F.attach.toList.mergeSort fun a b => decide ((x a).2 ≤ (x b).2)
  refine ⟨l.map fun a => (x a).1, ?_, ?_, ?_⟩
  · rw [List.length_map, List.length_mergeSort, Finset.length_toList, Finset.card_attach]
  · intro t ht
    obtain ⟨a, -, rfl⟩ := List.mem_map.1 ht
    exact (hx a).2
  · rw [List.pairwise_map]
    have hs : l.Pairwise fun a b => decide ((x a).2 ≤ (x b).2) :=
      List.pairwise_mergeSort (fun a b c hab hbc => by simp only [decide_eq_true_eq] at *; omega)
        (fun a b => by simp only [Bool.or_eq_true, decide_eq_true_eq]; omega) _
    have hn : l.Nodup := (List.mergeSort_perm _ _).nodup_iff.2 (Finset.nodup_toList _)
    refine (hs.and hn).imp fun {a b} hab => ?_
    intro i₁ z₁ κ₁ i₂ z₂ κ₂ h₁ h₂
    rw [(hx a).1, Option.some.injEq, Prod.mk.injEq] at h₁
    rw [(hx b).1, Option.some.injEq, Prod.mk.injEq] at h₂
    obtain ⟨rfl, -, rfl⟩ := h₁
    obtain ⟨rfl, -, rfl⟩ := h₂
    exact ⟨fun h => hab.2 (Subtype.ext h), by simpa using hab.1⟩

end Replay

end PousB5Chain

namespace PousB5Chain

open Pous Pous.Labelling
open scoped ENNReal

/-- **B5, `(D, Q)` form** (`Pous.Guarantees.B5ExPostFactoBounded`). -/
theorem b5_ex_post_facto_bounded : Pous.Guarantees.B5ExPostFactoBounded := by
  intro N w m s D Q k G VC d hard A₁ A₂ hA₂
  classical
  -- `k ≥ 1`: from no pebbles, fewer than `k` challenges are pebbled
  have hk : 0 < k := lt_of_le_of_lt (Nat.zero_le _) (hard ∅ (Nat.zero_le _))
  rcases Nat.eq_zero_or_pos N with rfl | hN
  · -- no nodes, so no challenge is answered
    have hno : ∀ H : LabelQry 0 w → Bits w,
        ¬ k ≤ (VC.filter fun c => (A₂ (A₁ H) c).run H = label G d H c).card := by
      intro H h
      have := (Finset.card_le_univ (VC.filter fun c => (A₂ (A₁ H) c).run H = label G d H c)).trans_eq
        (Fintype.card_fin 0)
      omega
    calc pr (fun H : LabelQry 0 w → Bits w =>
          k ≤ (VC.filter fun c => (A₂ (A₁ H) c).run H = label G d H c).card)
        ≤ pr (fun _ : LabelQry 0 w → Bits w => False) := pr_mono fun H h => hno H h
      _ = 0 := by rw [pr_def]; simp
      _ ≤ _ := by simp
  -- one replay per preprocessed state
  let R : Bits m → Replay N w := fun σ => ⟨G, d, VC, D, Q, A₂ σ⟩
  have hP : ∀ σ c, ((R σ).P c).Bounded (R σ).D (R σ).Q := fun σ c => hA₂ σ c
  let Pos₀ : Type := ({c // c ∈ VC} × Fin (Q + 1)) ⊕ Fin N
  -- winning needs more than `s` fresh labels, hence `s + 1` predictions that come true
  have hwin : ∀ H : LabelQry N w → Bits w,
      k ≤ (VC.filter fun c => (A₂ (A₁ H) c).run H = label G d H c).card →
      ∃ σ ∈ (Finset.univ : Finset (Bits m)), ∃ φ ∈ (Finset.univ : Finset (Fin (s + 1) → Pos₀ × Pos₀)),
        (R σ).Ev (List.ofFn φ) H := by
    intro H hwin
    refine ⟨A₁ H, Finset.mem_univ _, ?_⟩
    have hFs : s + 1 ≤ (Finset.univ.filter ((R (A₁ H)).fresh H)).card := by
      by_contra hlt
      have h1 := hard (Finset.univ.filter ((R (A₁ H)).fresh H)) (by omega)
      have h2 : (VC.filter fun c => (A₂ (A₁ H) c).run H = label G d H c) ⊆
          VC.filter fun c => c ∈ reach G (Finset.univ.filter ((R (A₁ H)).fresh H)) D := by
        intro c hc
        rw [Finset.mem_filter] at hc ⊢
        exact ⟨hc.1, (R (A₁ H)).correct_mem_reach (hP _) H c hc.1 hc.2⟩
      have := Finset.card_le_card h2
      omega
    obtain ⟨π, hlen, hE⟩ := (R (A₁ H)).exists_Ev (hP _) H (Finset.univ.filter ((R (A₁ H)).fresh H))
      fun i hi => (Finset.mem_filter.1 hi).2
    have hlen' : (π.take (s + 1)).length = s + 1 := by rw [List.length_take]; omega
    refine ⟨fun j => (π.take (s + 1))[j.val]'(by rw [hlen']; exact j.2), Finset.mem_univ _, ?_⟩
    have hofFn : List.ofFn (fun j : Fin (s + 1) => (π.take (s + 1))[j.val]'(by rw [hlen']; exact j.2)) =
        π.take (s + 1) := by
      apply List.ext_getElem (by rw [List.length_ofFn, hlen'])
      intro n h1 h2
      rw [List.getElem_ofFn]
    rw [hofFn]
    exact (R (A₁ H)).Ev_take (s + 1) hE
  have hcardPos : Fintype.card Pos₀ = VC.card * (Q + 1) + N := by
    simp only [Pos₀, Fintype.card_sum, Fintype.card_prod, Fintype.card_coe, Fintype.card_fin]
  calc pr (fun H : LabelQry N w → Bits w =>
        k ≤ (VC.filter fun c => (A₂ (A₁ H) c).run H = label G d H c).card)
      ≤ pr (fun H => ∃ σ ∈ (Finset.univ : Finset (Bits m)),
          ∃ φ ∈ (Finset.univ : Finset (Fin (s + 1) → Pos₀ × Pos₀)), (R σ).Ev (List.ofFn φ) H) := pr_mono hwin
    _ ≤ ∑ σ : Bits m, pr (fun H => ∃ φ ∈ (Finset.univ : Finset (Fin (s + 1) → Pos₀ × Pos₀)),
          (R σ).Ev (List.ofFn φ) H) := pr_exists_le _ _
    _ ≤ ∑ σ : Bits m, ∑ φ : Fin (s + 1) → Pos₀ × Pos₀, pr ((R σ).Ev (List.ofFn φ)) :=
        Finset.sum_le_sum fun σ _ => pr_exists_le _ _
    _ ≤ ∑ _σ : Bits m, ∑ _φ : Fin (s + 1) → Pos₀ × Pos₀, ((2 ^ w : ℝ≥0∞)⁻¹) ^ (s + 1) := by
        refine Finset.sum_le_sum fun σ _ => Finset.sum_le_sum fun φ _ => ?_
        have := (R σ).pr_Ev (hP σ) (List.ofFn φ)
        rwa [List.length_ofFn] at this
    _ = 2 ^ m * ((((VC.card * (Q + 1) + N) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ w) ^ (s + 1) := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_prod, hcardPos,
          Fintype.card_fin, Fintype.card_bool, nsmul_eq_mul]
        generalize VC.card * (Q + 1) + N = T
        rw [div_eq_mul_inv, mul_pow]
        push_cast
        ring
    _ ≤ N * 2 ^ m * ((((VC.card * (Q + 1) + N) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ w) ^ (s + 1) := by
        rw [mul_assoc]
        exact le_mul_of_one_le_left' (by exact_mod_cast hN)

/-- **B5, parallel-query form** (`Pous.Guarantees.B5ExPostFacto`): `RoundBounded D q` gives work `≤ D·q`. -/
theorem b5_ex_post_facto : Pous.Guarantees.B5ExPostFacto := by
  intro N w m s D q k G VC d hard A₁ A₂ hA₂
  refine b5_ex_post_facto_bounded N w m s D (D * q) k G VC d hard A₁ A₂ fun σ c ω => ⟨(hA₂ σ c ω).1, ?_⟩
  exact (work_le_depth_mul_width _ _).trans (Nat.mul_le_mul (hA₂ σ c ω).1 (hA₂ σ c ω).2)

end PousB5Chain

/-! ## The dense single-layer scheme (S1) and its `Meets` -/

namespace PousDenseChain

open Pous Pous.Labelling
open scoped ENNReal

/-- The complete DAG on `Fin B`: every earlier node is a parent. -/
def completeDAG (B : ℕ) : TopoDAG B where
  par i := Finset.univ.filter fun j => j < i
  par_lt _ _ hj := (Finset.mem_filter.1 hj).2

/-- The dense scheme's model: B5's random oracle on label-shaped queries. -/
abbrev denseModel (B ℓ : ℕ) : IdealModel := IdealModel.randomOracle (LabelQry B ℓ) (Bits ℓ)

/-- The `B` blocks of `W`. -/
def blocks (B ℓ : ℕ) (W : Bits (B * ℓ)) : Fin B → Bits ℓ := (codeEquiv B ℓ).symm W

/-- **S1, the dense single-layer data-carrying labeling** (`docs/p3-scheme.md` §4), on one segment of `B` blocks
of `ℓ` bits. `C_i = ℓ_i = H(i, ℓ_{<i}) ⊕ W_i` over the complete DAG, with no `pp` and no coins, at rate 1.
Decoding recomputes `W_i = C_i ⊕ H(i, C_{<i})` with one query per block. -/
def denseScheme (B ℓ : ℕ) [NeZero B] : Scheme (denseModel B ℓ) where
  n := B * ℓ
  t := 0
  B := B
  ℓ := ℓ
  B_pos := Nat.pos_of_ne_zero (NeZero.ne B)
  Coins := Unit
  enc W H _ := (fun i => i.elim0, fun i => label (completeDAG B) (blocks B ℓ W) H i)
  dec _ C f := codeEquiv B ℓ fun i =>
    bxor (C i) (f (i, fun j => if j ∈ (completeDAG B).par i then some (C j) else none))

end PousDenseChain

namespace PousDenseChain

open Pous Pous.Labelling
open scoped ENNReal

/-! ### Reach on the complete DAG: `s + D` -/

/-- Greedy pebbling of the complete DAG adds at most one node per round (the least unpebbled one), so from `P₀` it
covers at most `|P₀| + r` nodes in `r` rounds. -/
theorem card_reach_le (B : ℕ) (P₀ : Finset (Fin B)) : ∀ r, (reach (completeDAG B) P₀ r).card ≤ P₀.card + r
  | 0 => by rw [reach]; omega
  | r + 1 => by
    have ih := card_reach_le B P₀ r
    have hnew : ((Finset.univ.filter fun v => (completeDAG B).par v ⊆ reach (completeDAG B) P₀ r) \
        reach (completeDAG B) P₀ r).card ≤ 1 := by
      rw [Finset.card_le_one]
      intro a ha b hb
      rw [Finset.mem_sdiff, Finset.mem_filter] at ha hb
      by_contra hab
      rcases lt_or_gt_of_ne hab with h | h
      · exact ha.2 (hb.1.2 (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩))
      · exact hb.2 (ha.1.2 (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩))
    rw [reach, ← Finset.union_sdiff_self_eq_union]
    calc _ ≤ (reach (completeDAG B) P₀ r).card + ((Finset.univ.filter fun v =>
          (completeDAG B).par v ⊆ reach (completeDAG B) P₀ r) \ reach (completeDAG B) P₀ r).card :=
          Finset.card_union_le _ _
      _ ≤ P₀.card + (r + 1) := by omega

/-- The complete DAG with every node a challenge is `(B − D − 1, D, B)`-hard: `B − D − 1` pebbles reach at most
`B − 1` nodes in `D` rounds. -/
theorem complete_hard (B D : ℕ) (hD : D + 1 ≤ B) : PebblingHard (completeDAG B) Finset.univ (B - D - 1) D B := by
  intro P₀ hP₀
  calc (Finset.univ.filter fun c => c ∈ reach (completeDAG B) P₀ D).card
      ≤ (reach (completeDAG B) P₀ D).card := Finset.card_le_card fun c hc => (Finset.mem_filter.1 hc).2
    _ ≤ P₀.card + D := card_reach_le B P₀ D
    _ < B := by omega

/-! ### Correctness and rate 1 -/

theorem bxor_bxor_self {w : ℕ} (a b : Bits w) : bxor (bxor a b) a = b := by
  funext j
  simp only [bxor]
  cases a j <;> cases b j <;> rfl

/-- Bit-exact public decoding: `C_i ⊕ H(i, C_{<i}) = W_i`. -/
theorem denseScheme_correct (B ℓ : ℕ) [NeZero B] : (denseScheme B ℓ).Correct := by
  intro (W : Bits (B * ℓ)) (H : LabelQry B ℓ → Bits ℓ) r
  show codeEquiv B ℓ (fun i => bxor (label (completeDAG B) (blocks B ℓ W) H i)
    (H (i, fun j => if j ∈ (completeDAG B).par i then some (label (completeDAG B) (blocks B ℓ W) H j) else none)))
    = W
  have h : ∀ i, bxor (label (completeDAG B) (blocks B ℓ W) H i)
      (H (i, fun j => if j ∈ (completeDAG B).par i then some (label (completeDAG B) (blocks B ℓ W) H j) else none))
      = blocks B ℓ W i := by
    intro i
    rw [PousB5Chain.label_eq]
    exact bxor_bxor_self _ _
  rw [funext h]
  exact (codeEquiv B ℓ).apply_symm_apply W

/-! ### B5 gives `TimedINC` -/

/-- **Glue.** Rebuilding every block within `(D, Q)` from a `β`-bit compression answers all `B` challenges of the
complete DAG, so B5 bounds `TimedINC` by `π = B·2^β·((B(Q + 1) + B)²/2^ℓ)^(B − D)`. -/
theorem dense_timedINC (B ℓ D Q β : ℕ) [NeZero B] (hD : D + 1 ≤ B) :
    TimedINC (denseScheme B ℓ) D Q β
      (B * 2 ^ β * ((((B * (Q + 1) + B) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ ℓ) ^ (B - D - 1 + 1)) := by
  classical
  intro W cmp exp hexp
  have hB5 := PousB5Chain.b5_ex_post_facto_bounded B ℓ β (B - D - 1) D Q B (completeDAG B) Finset.univ (blocks B ℓ W)
    (complete_hard B D hD)
    (fun H => cmp W (fun i => i.elim0) (fun i => label (completeDAG B) (blocks B ℓ W) H i) H)
    (fun σ i => exp W (fun i => i.elim0) σ i) (fun σ i => hexp W _ σ i)
  rw [Finset.card_univ, Fintype.card_fin] at hB5
  refine le_trans (le_of_eq_of_le (PousThm1Dense.pr_fst (β := Unit) (fun H : LabelQry B ℓ → Bits ℓ =>
    ∀ i, (exp W (fun i => i.elim0) (cmp W (fun i => i.elim0) (fun i => label (completeDAG B) (blocks B ℓ W) H i) H)
      i).run H = label (completeDAG B) (blocks B ℓ W) H i)) (pr_mono fun H hH => ?_)) hB5
  refine le_trans (le_of_eq (by rw [Finset.card_univ, Fintype.card_fin]))
    (Finset.card_le_card (s := Finset.univ) fun c _ => Finset.mem_filter.2 ⟨Finset.mem_univ _, hH c⟩)

/-! ### The certificate -/

theorem sum_pow_le (n t : ℕ) (hn : 2 ≤ n) : ∑ j ∈ Finset.range t, (n : ℝ≥0∞) ^ j ≤ (n : ℝ≥0∞) ^ t := by
  have h : ∑ j ∈ Finset.range t, n ^ j ≤ n ^ t := by
    induction t with
    | zero => simp
    | succ t ih =>
      rw [Finset.sum_range_succ, pow_succ]
      nlinarith [pow_pos (by omega : 0 < n) t]
  exact_mod_cast h

theorem two_pow_mul_inv_pow (a b : ℕ) (h : a ≤ b) :
    (2 : ℝ≥0∞) ^ a * (2⁻¹ : ℝ≥0∞) ^ b = (2⁻¹ : ℝ≥0∞) ^ (b - a) := by
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [pow_add, ← mul_assoc, ← mul_pow, ENNReal.mul_inv_cancel two_ne_zero ENNReal.ofNat_ne_top, one_pow, one_mul,
    Nat.add_sub_cancel_left]

theorem two_pow_combine (a b c d : ℕ) (h : a + b + c ≤ d) :
    (2 : ℝ≥0∞) ^ a * ((2 : ℝ≥0∞) ^ b * 2 ^ c * (2⁻¹ : ℝ≥0∞) ^ d) = (2⁻¹ : ℝ≥0∞) ^ (d - (a + b + c)) := by
  rw [← two_pow_mul_inv_pow _ _ h, pow_add, pow_add]
  ring

theorem sq_div_two_pow_le (x c w : ℕ) (hx : x ^ 2 ≤ 2 ^ c) (hc : c ≤ w) :
    ((x ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ w ≤ (2⁻¹ : ℝ≥0∞) ^ (w - c) := by
  calc ((x ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ w ≤ (2 : ℝ≥0∞) ^ c / 2 ^ w := by
        gcongr
        exact_mod_cast hx
    _ = (2⁻¹ : ℝ≥0∞) ^ (w - c) := by
        rw [div_eq_mul_inv, ENNReal.inv_pow, two_pow_mul_inv_pow c w hc]

/-- `|Hist|·π ≤ 2^-128` at `B = 2^16`, `ℓ = 8192`, `D = 64`, `Q = 2^20`, `k = 107`, `β = 531499840`. -/
theorem dense_union_term :
    (∑ j ∈ Finset.range 107, ((2 ^ 16 : ℕ) : ℝ≥0∞) ^ j) *
      (((2 ^ 16 : ℕ) : ℝ≥0∞) * 2 ^ 531499840 *
        (((((2 ^ 16) * (2 ^ 20 + 1) + 2 ^ 16) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ 8192) ^ (2 ^ 16 - 64 - 1 + 1)) ≤
      (2⁻¹ : ℝ≥0∞) ^ 128 := by
  have he : 2 ^ 16 - 64 - 1 + 1 = 65472 := by norm_num
  have hsq : ((2 ^ 16) * (2 ^ 20 + 1) + 2 ^ 16) ^ 2 ≤ 2 ^ 74 := by norm_num
  have h16 : ((2 ^ 16 : ℕ) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ 16 := by norm_num
  rw [he]
  calc _ ≤ ((2 ^ 16 : ℕ) : ℝ≥0∞) ^ 107 *
        (((2 ^ 16 : ℕ) : ℝ≥0∞) * 2 ^ 531499840 * ((2⁻¹ : ℝ≥0∞) ^ (8192 - 74)) ^ 65472) := by
        gcongr
        · exact sum_pow_le _ _ (by norm_num)
        · exact sq_div_two_pow_le _ 74 8192 hsq (by norm_num)
    _ = (2 : ℝ≥0∞) ^ (16 * 107) * ((2 : ℝ≥0∞) ^ 16 * 2 ^ 531499840 * (2⁻¹ : ℝ≥0∞) ^ ((8192 - 74) * 65472)) := by
        rw [h16, ← pow_mul, ← pow_mul]
    _ = (2⁻¹ : ℝ≥0∞) ^ ((8192 - 74) * 65472 - (16 * 107 + 16 + 531499840)) :=
        two_pow_combine _ _ _ _ (by norm_num)
    _ ≤ (2⁻¹ : ℝ≥0∞) ^ 128 := pow_le_pow_right_of_le_one' (by norm_num) (by norm_num)

/-- `p₀^107 ≤ 1%` at `β = 531499840`, `S = 508614548`, `B = 2^16`, `ℓ = 8192`. -/
theorem dense_sampling_term :
    ENNReal.ofReal (p₀ 531499840 508614548 (2 ^ 16) 8192) ^ 107 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  have h0 : 0 ≤ p₀ 531499840 508614548 (2 ^ 16) 8192 := by unfold p₀; norm_num
  rw [← ENNReal.ofReal_pow h0]
  refine ENNReal.ofReal_le_ofReal ?_
  unfold p₀
  norm_num [Params.δ]

/-! ### The requirement -/

theorem stateBound_dense : (denseScheme (2 ^ 16) 8192).stateBound Params.ρ = 508614548 := by
  show ⌊Params.ρ * ((2 ^ 16 * 8192 : ℕ) : ℚ)⌋₊ = 508614548
  rw [Nat.floor_eq_iff (by norm_num [Params.ρ])]
  norm_num [Params.ρ]

end PousDenseChain

/-- **The first end-to-end `Meets` with no named assumption** (`docs/p3-scheme.md` §4). The dense scheme on
`B = 2^16` blocks of 1 KB meets the requirement with sequential reveal, `D = 64` rounds and `Q = 2^20` queries per
answer, `k = 107` challenges and `ε_crypto = 2^-128`: it is correct, at rate 1, and every `⌊ρ|C|⌋`-bit adversary is
accepted with probability at most `1% + 2^-128`. -/
theorem PousDenseChain.dense_meets :
    Pous.Meets (PousDenseChain.denseScheme (2 ^ 16) 8192) .sequential 64 (2 ^ 20) 107 ((2⁻¹ : ENNReal) ^ 128) := by
  refine ⟨le_rfl, PousDenseChain.denseScheme_correct _ _, le_rfl, ?_, ?_⟩
  · show (((2 ^ 16 * 8192 + 0 : ℕ)) : ℚ) ≤ Pous.Params.expansion * ((2 ^ 16 * 8192 : ℕ) : ℚ)
    norm_num [Pous.Params.expansion]
  · intro W A₁ A₂
    refine (PousTargetsDense.theorem1_ii_seq (PousDenseChain.denseScheme (2 ^ 16) 8192) 64 (2 ^ 20) 531499840
      ((PousDenseChain.denseScheme (2 ^ 16) 8192).stateBound Pous.Params.ρ) 107 _
      (PousDenseChain.dense_timedINC (2 ^ 16) 8192 64 (2 ^ 20) 531499840 (by norm_num)) W A₁ A₂).trans ?_
    rw [PousDenseChain.stateBound_dense, add_comm]
    exact add_le_add PousDenseChain.dense_sampling_term PousDenseChain.dense_union_term

end


