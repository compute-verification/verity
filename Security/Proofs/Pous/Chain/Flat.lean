/-!
# `ChainExPostFactoG` — v5 online freshness and the fixed-σ reduction (lazy-sampling technique)

The peel-and-count `pr_EvR` (v4 `bEvR`) is false (`not_prEvR`, `ChainEPFCarryAdvCounterexample`). v5 replaces the peel
with the shared lazy-sampling technique (`internal/p3-instantiation/proof-technique-decision.md`), keeping
`ChainEPFReach`'s obs-round simulation and the V3/Final2 assembly. This file holds the shared v5 primitives and the three
client obligations of the `lazy-perm` backend; `ChainEPFExistsV5` builds `icondV5'`/`bEvV5'`/`win_to_bEvV5'` on top, and
`ChainEPFPrEvR` wires the per-σ `LazyPerm.Strategy.prob_hits_le`.

An item is a **chain position** `(v, p) ∈ posSet` (`1 ≤ p ≤ ovCalls v`): the pad `p = ovCalls v` is the **label**
(width `ℓ`, key `keyAt v`), an earlier `p` a **chaining value** (width `ℓ+c`, `h_{v,p}`). Its honest quantity is decided
by the single `Π₂` sample at its **deciding point** `xin v p` (`= realPt v` for a label).

- `decidePt`, `decidePt_inj`: the deciding point, and — the load-bearing independence claim — distinct items have
  distinct deciding points, directly from `NoCollU`. So no `Π₂` sample decides two items (client obligation 1).
- `obsFoldKey`, `pairwise_decidePt_of_noColl`: the label-form fold (inverse ⇒ key, forward/guess ⇒ label, the `·2` fold)
  and the free distinctness under `NoCollU`, reused by `ChainEPFExistsV5`.
- `card_names_v5_le`: the naming count `≤ nPos²·B` (`card_names_le`, over `Pos × posSet`).
- `fresh_of_unasked` (obligation 2, closure completeness) and `steps_le_nPos` (obligation 3, every step `< nPos`).
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-! ### The deciding point and independence -/

/-- **The deciding point** of item `(v, p)`: the one `Π₂` input whose sample decides its honest quantity, `xin v p`
(the label at `p = ovCalls v` decides `keyAt v = ovR (π (xin v (ovCalls v)))`, and `xin v (ovCalls v) = realPt v`). -/
noncomputable def decidePt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (q : Fin B × ℕ) : Bits (ℓ + (ℓ + c)) :=
  R.xin π q.1 q.2

/-- **Independence (load-bearing).** Distinct chain positions have distinct deciding points, directly from `NoCollU`. So
no single `Π₂` sample decides two fresh items, and the lazy-sampling per-item factors multiply. -/
theorem decidePt_inj {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (hnc : R.NoCollU π)
    {q q' : Fin B × ℕ} (hq : q ∈ R.posSet) (hq' : q' ∈ R.posSet) (hne : q ≠ q') :
    R.decidePt π q ≠ R.decidePt π q' := by
  obtain ⟨hp1, hp2⟩ := R.mem_posSet.1 hq
  obtain ⟨hp1', hp2'⟩ := R.mem_posSet.1 hq'
  refine hnc q.1 q.2 q'.1 q'.2 hp1 hp2 hp1' hp2' ?_
  by_cases h1 : q.1 = q'.1
  · by_cases h2 : q.2 = q'.2
    · exact absurd (Prod.ext h1 h2) hne
    · exact Or.inr h2
  · exact Or.inl h1

/-- A chaining-fresh position is a chain position. -/
theorem hs_subset_posSet {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {q : Fin B × ℕ}
    (h : q ∈ (R.freshHolding π).hs) : q ∈ R.posSet := by
  simp only [freshHolding, Finset.mem_filter] at h
  exact R.mem_posSet.2 ⟨h.2.1, le_of_lt h.2.2.1⟩

/-! ### The online-freshness fold (reused by `ChainEPFExistsV5`'s `icondV5'`/`bEvV5'`) -/

/-- **The folded key an observation commits for a label at `v`.** An inverse query `Π₂⁻¹ y` commits its dropped r-part
`ovR y` as the **key**; a forward query `Π₂ x` and a guess commit their r-part as the **label**, whose key is `⊕ Wb v`.
So one obs commits exactly one `ℓ`-bit key — no two-form disjunction — and the item needs no form bit. π-independent
given the transcript entry. -/
noncomputable def obsFoldKey (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (o : R.Pos) (v : Fin B) :
    Option (Bits ℓ × ℕ) :=
  match o with
  | .inl (i, k) =>
      if k.val < R.Q then
        ((R.tr π i)[k.val]?).map (fun e =>
          ((match e.2 with | .inl _ => bxor (qKey e.2) (R.Wb v) | .inr _ => qKey e.2), e.1))
      else some (bxor ((R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π)) (R.Wb v),
                 (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π))
  | .inr _ => none

/-- The distinct-deciding-point structure is automatic from `NoCollU`: any pattern whose items are distinct chain
positions is at distinct deciding points. -/
theorem pairwise_decidePt_of_noColl {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (hnc : R.NoCollU π)
    {φ : List (R.Pos × (Fin B × ℕ))} (hpos : ∀ t ∈ φ, t.2 ∈ R.posSet)
    (hdist : φ.Pairwise (fun t t' => t.2 ≠ t'.2)) :
    φ.Pairwise (fun t t' => R.decidePt π t.2 ≠ R.decidePt π t'.2) := by
  refine hdist.imp_of_mem ?_
  intro t t' ht ht' hne
  exact R.decidePt_inj hnc (hpos t ht) (hpos t' ht') hne

/-! ### Naming -/

/-- **Naming `≤ nPos²·B`.** A v5 name is `(o, (v,p)) : Pos × posSet` (kind read off the position, form off the obs), so
the count is `card_names_le` — the `·2` fold, inside the right-hand side's `nPos²·B`. -/
theorem card_names_v5_le : Fintype.card (R.Pos × R.posSet) ≤ nPos B R.Q ^ 2 * B :=
  R.card_names_le

/-! ### The three client obligations of the lazy-perm backend (red-team sign-off)

The library `LazyPerm.Strategy.prob_hits_le` bounds `prob (∀ j ∈ J, Hit (T j) j)` for a fixed finset `J` of step
indices, given three client facts. For the band per-σ bound these are, with items named by their global step index
(the deterministic step that first queries the deciding point `xin v p`) plus kind:
1. **distinct named steps** = independence: distinct items have distinct deciding points (`decidePt_inj`, from
   `NoCollU`), hence distinct first-query steps;
2. **`Fresh` from the online game-closed freshness** = closure completeness: an item's deciding query is genuinely
   fresh in the transcript — its point is unrevealed before its round (`fresh_of_unasked`) and no derivation was missed
   (`ChainEPFReach.mem_reach_of_asked_obs`, the whole-value reach simulation);
3. **every step is below `nPos`** (`steps_le_nPos`): the adversary queries plus the honest chain points number at most
   `nPos`, so `pin_mul_le` gives each factor `(2^w − nPos)⁻¹`. -/

/-- **Obligation 2 (closure completeness, transcript half).** A point unasked before round `κ` is revealed by no
transcript entry of round `< κ` — so at its deciding step (the first query of the point) the query is `LazyPerm.Fresh`:
the point is in neither the domain nor the range fixed by the earlier history. Combined with
`ChainEPFReach.mem_reach_of_asked_obs` (no derivation missed), this is the game-closure completeness the backend needs. -/
theorem fresh_of_unasked {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z : Bits (ℓ + (ℓ + c))} {κ : ℕ}
    (h : ∀ ρ < κ, ¬ R.askedPt π z ρ) {i : Fin B}
    {e : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))} (he : e ∈ R.tr π i) (hlt : e.1 < κ) :
    revealPt π e.2 ≠ z :=
  fun hz => h e.1 hlt ⟨i, e, he, rfl, hz⟩

/-- **Obligation 3 (every step below `nPos`).** The adversary's queries (`≤ B·Q`, each thread `(D,Q)`-bounded) plus the
honest chain points (`≤ B(B+1)/2`, `card_posSet_le_half`) number at most `nPos = B(Q+1) + B(B+1)/2`. So every named
(deciding) step index — a step of this sequence — is below `nPos`, and `pin_mul_le` applies with `k = nPos`. -/
theorem steps_le_nPos (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (∑ i : Fin B, (R.tr π i).length) + R.posSet.card ≤ nPos B R.Q := by
  have hadv : (∑ i : Fin B, (R.tr π i).length) ≤ B * R.Q := by
    calc (∑ i : Fin B, (R.tr π i).length) ≤ ∑ _i : Fin B, R.Q :=
          Finset.sum_le_sum (fun i _ => R.tr_length_le hP π i)
      _ = B * R.Q := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
  have hlab : R.posSet.card ≤ B * (B + 1) / 2 := R.card_posSet_le_half
  have hnpos : nPos B R.Q = B * (R.Q + 1) + B * (B + 1) / 2 := rfl
  have hBQ : B * (R.Q + 1) = B * R.Q + B := by ring
  omega

end ChainReplay

end PousSpongeChain

end


