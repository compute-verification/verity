/-- **P3 at 64 KB over 14 GB, at any timed depth `D`**, for any conversion `g` and any graph certified at game depth
`d ≥ g D` with `X = 3`. -/
theorem p3_meets_multi_64_at (g : ℕ → ℕ) (hM : N10primeMultiAt g) (h1 : Pous.Guarantees.Theorem1iiSeq) (D d : ℕ)
    (hd : g D ≤ d) (hard : ColumnHard Gr d 220 3) :
    Meets (p3SchemeNR 2384 Gr 971) .sequential D (2 ^ 20) 117 ((2⁻¹ : ℝ≥0∞) ^ 128) := by
  refine ⟨le_rfl, p3SchemeNR_correct _ _ _, p3SchemeNR_codeHoldsW _ _ _, p3SchemeNR_space _ _ _ (by norm_num), ?_⟩
  intro W A₁ A₂
  have hJ := jointSegBoundR_of_n10primeMultiAt 2384 Gr 971 g hM (by norm_num) D d 3 hd (by norm_num) (by norm_num)
    hard
  have hT := p3_timedINC_multiR 2384 Gr 971 (by norm_num) D (2 ^ 20) _ _ hJ 110498787949
  refine (h1 (p3SchemeNR 2384 Gr 971) D (2 ^ 20) 110498787949 ((p3SchemeNR 2384 Gr 971).stateBound Params.ρ) 117 _
    hT W A₁ A₂).trans ?_
  rw [stateBound_14GB_64, add_comm]
  exact add_le_add sampling_14GB_64 (union_termW (220 * 2384) 117 110498787949 _ 971 (971 * 220) _ 10 2072 38
    (by norm_num) hist_14GB_64 (by norm_num) (by norm_num) (by norm_num) (by norm_num))

