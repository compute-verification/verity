/-! ════ LazyPermFresh ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace LazyPerm

open scoped ENNReal

theorem prob_mono {Ω : Type} [Fintype Ω] {E F : Ω → Prop} (h : ∀ ω, E ω → F ω) : prob E ≤ prob F := by
  classical
  unfold prob
  gcongr with x
  exact h x

/-- **The union bound.** -/
theorem prob_exists_le {Ω γ : Type} [Fintype Ω] (s : Finset γ) (E : γ → Ω → Prop) :
    prob (fun ω => ∃ g ∈ s, E g ω) ≤ ∑ g ∈ s, prob (E g) := by
  classical
  unfold prob
  simp only [div_eq_mul_inv]
  rw [← Finset.sum_mul]
  gcongr
  norm_cast
  refine (Finset.card_le_card fun x hx => ?_).trans Finset.card_biUnion_le
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
  simp only [Finset.mem_biUnion, Finset.mem_filter, Finset.mem_univ, true_and]
  exact hx

section Bridge

variable {K : Type} [DecidableEq K]

/-- Names at pairwise distinct steps. -/
def DistinctSteps (P : Finset (ℕ × K)) : Prop := ∀ a ∈ P, ∀ b ∈ P, a.1 = b.1 → a = b

open Classical in
/-- All name patterns: distinct-step subsets of `range nPos ×ˢ univ` satisfying `Adm`. -/
noncomputable def patterns [Fintype K] (nPos : ℕ) (Adm : Finset (ℕ × K) → Prop) : Finset (Finset (ℕ × K)) :=
  ((Finset.range nPos ×ˢ (Finset.univ : Finset K)).powerset).filter fun P => DistinctSteps P ∧ Adm P

omit [DecidableEq K] in
theorem mem_patterns [Fintype K] {nPos : ℕ} {Adm : Finset (ℕ × K) → Prop} {P : Finset (ℕ × K)} :
    P ∈ patterns nPos Adm ↔ P ⊆ Finset.range nPos ×ˢ (Finset.univ : Finset K) ∧ DistinctSteps P ∧ Adm P := by
  classical
  unfold patterns
  rw [Finset.mem_filter, Finset.mem_powerset]

/-- At most `s + 1` names, of total width at least `W`. -/
def widthAdm (w : K → ℕ) (s W : ℕ) (P : Finset (ℕ × K)) : Prop := P.card ≤ s + 1 ∧ W ≤ ∑ a ∈ P, w a.2

variable {ι : Type} [Fintype ι] [DecidableEq ι] {α : ι → Type} [∀ i, Fintype (α i)] [∀ i, DecidableEq (α i)]

namespace Strategy

variable (S : Strategy α)

/-- **The per-advice product for one name pattern.** -/
theorem prob_pattern_le (T : K → History α → (q : Qry α) → Finset (α q.1)) (w : K → ℕ) (nPos : ℕ)
    (hT : ∀ κ h q, (T κ h q).card * (2 ^ w κ - nPos) ≤ Fintype.card (α q.1) - nPos)
    (P : Finset (ℕ × K)) (hP : DistinctSteps P) (hlt : ∀ a ∈ P, a.1 < nPos) :
    prob (fun π => ∀ a ∈ P, S.Hit (T a.2) a.1 π) ≤ ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ := by
  classical
  let kd : ℕ → Option K := fun j => if h : ∃ κ, (j, κ) ∈ P then some (Classical.choose h) else none
  have kd_spec : ∀ a ∈ P, kd a.1 = some a.2 := by
    intro a ha
    have hex : ∃ κ, (a.1, κ) ∈ P := ⟨a.2, ha⟩
    simp only [kd, hex, ↓reduceDIte, Option.some.injEq]
    exact (Prod.ext_iff.1 (hP _ (Classical.choose_spec hex) a ha rfl)).2
  by_cases hb0 : ∃ a ∈ P, 2 ^ w a.2 - nPos = 0
  · obtain ⟨a, ha, h0⟩ := hb0
    have hne : ∏ b ∈ P.erase a, (((2 ^ w b.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ ≠ 0 :=
      Finset.prod_ne_zero_iff.2 fun b _ => ENNReal.inv_ne_zero.2 (ENNReal.natCast_ne_top _)
    rw [← Finset.mul_prod_erase P _ ha, h0, Nat.cast_zero, ENNReal.inv_zero, ENNReal.top_mul hne]
    exact le_top
  · push Not at hb0
    let T' : ℕ → History α → (q : Qry α) → Finset (α q.1) := fun j h q =>
      match kd j with
      | some κ => T κ h q
      | none => ∅
    let b : ℕ → ℕ := fun j =>
      match kd j with
      | some κ => 2 ^ w κ - nPos
      | none => 1
    have hevent : (fun π => ∀ a ∈ P, S.Hit (T a.2) a.1 π) = fun π => ∀ j ∈ P.image Prod.fst, S.Hit (T' j) j π := by
      funext π
      apply propext
      constructor
      · intro h j hj
        obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hj
        have := h a ha
        simpa only [T', kd_spec a ha] using this
      · intro h a ha
        have := h a.1 (Finset.mem_image_of_mem _ ha)
        simpa only [T', kd_spec a ha] using this
    rw [hevent]
    refine (S.prob_hits_le (P.image Prod.fst) T' (fun _ => 1) b ?_ ?_).trans (le_of_eq ?_)
    · intro j hj h q
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hj
      simp only [T', b, kd_spec a ha, one_mul]
      exact (hT a.2 h q).trans (Nat.sub_le_sub_left (le_of_lt (hlt a ha)) _)
    · intro j hj
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hj
      simp only [b, kd_spec a ha]
      exact Nat.pos_of_ne_zero (hb0 a ha)
    · rw [Finset.prod_image fun a ha a' ha' h => hP a ha a' ha' h]
      refine Finset.prod_congr rfl fun a ha => ?_
      simp only [b, kd_spec a ha, Nat.cast_one, one_div]

/-- **The per-advice bound from online freshness: the union over names.** -/
theorem prob_fresh_le [Fintype K] (T : K → History α → (q : Qry α) → Finset (α q.1)) (w : K → ℕ) (nPos : ℕ)
    (hT : ∀ κ h q, (T κ h q).card * (2 ^ w κ - nPos) ≤ Fintype.card (α q.1) - nPos)
    {I : Type} (OnFresh : Oracle α → I → Prop) (name : Oracle α → I → ℕ × K)
    (h_distinct : ∀ π x y, OnFresh π x → OnFresh π y → x ≠ y → (name π x).1 ≠ (name π y).1)
    (h_fresh : ∀ π x, OnFresh π x →
      ∃ q, S.next (S.hist π (name π x).1) = some q ∧ Fresh (S.hist π (name π x).1) q)
    (h_target : ∀ π x q, OnFresh π x → S.next (S.hist π (name π x).1) = some q →
      ans π q ∈ T (name π x).2 (S.hist π (name π x).1) q)
    (h_lt : ∀ π x, OnFresh π x → (name π x).1 < nPos)
    (Adm : Finset (ℕ × K) → Prop) (Win : Oracle α → Prop)
    (hwin : ∀ π, Win π → ∃ X : Finset I, (∀ x ∈ X, OnFresh π x) ∧ Adm (X.image (name π))) :
    prob Win ≤ ∑ P ∈ patterns nPos Adm, ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ := by
  classical
  have hsub : ∀ π, Win π → ∃ P ∈ patterns nPos Adm, ∀ a ∈ P, S.Hit (T a.2) a.1 π := by
    intro π hπ
    obtain ⟨X, hX, hadm⟩ := hwin π hπ
    refine ⟨X.image (name π), ?_, ?_⟩
    · refine mem_patterns.2 ⟨fun a ha => ?_, fun a ha b hb hab => ?_, hadm⟩
      · obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 ha
        exact Finset.mem_product.2 ⟨Finset.mem_range.2 (h_lt π x (hX x hx)), Finset.mem_univ _⟩
      · obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 ha
        obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hb
        by_cases hxy : x = y
        · rw [hxy]
        · exact absurd hab (h_distinct π x y (hX x hx) (hX y hy) hxy)
    · intro a ha
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 ha
      obtain ⟨q, hq, hfr⟩ := h_fresh π x (hX x hx)
      exact ⟨q, hq, hfr, h_target π x q (hX x hx) hq⟩
  refine (prob_mono hsub).trans ((prob_exists_le _ _).trans (Finset.sum_le_sum fun P hP => ?_))
  rw [mem_patterns] at hP
  exact S.prob_pattern_le T w nPos hT P hP.2.1 fun a ha =>
    Finset.mem_range.1 (Finset.mem_product.1 (hP.1 ha)).1

end Strategy


theorem inv_sub_le (w nPos : ℕ) (h2 : 2 * nPos ≤ 2 ^ w) :
    (((2 ^ w - nPos : ℕ) : ℝ≥0∞))⁻¹ ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ w := by
  have hx : ((2 ^ w : ℕ) : ℝ≥0∞) ≤ 2 * ((2 ^ w - nPos : ℕ) : ℝ≥0∞) := by
    have : 2 ^ w ≤ 2 * (2 ^ w - nPos) := by omega
    exact_mod_cast this
  have hinv : (2 * ((2 ^ w - nPos : ℕ) : ℝ≥0∞))⁻¹ ≤ ((2 ^ w : ℕ) : ℝ≥0∞)⁻¹ := ENNReal.inv_le_inv.2 hx
  rw [ENNReal.mul_inv (Or.inl two_ne_zero) (Or.inl ENNReal.ofNat_ne_top)] at hinv
  calc (((2 ^ w - nPos : ℕ) : ℝ≥0∞))⁻¹ = 2 * (2⁻¹ * (((2 ^ w - nPos : ℕ) : ℝ≥0∞))⁻¹) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel two_ne_zero ENNReal.ofNat_ne_top, one_mul]
    _ ≤ 2 * ((2 ^ w : ℕ) : ℝ≥0∞)⁻¹ := by gcongr
    _ = 2 * (2⁻¹ : ℝ≥0∞) ^ w := by rw [Nat.cast_pow, Nat.cast_ofNat, ENNReal.inv_pow]

theorem geom_le {X : ℕ} (hX : 2 ≤ X) : ∀ k, ∑ m ∈ Finset.range (k + 1), X ^ m ≤ 2 * X ^ k
  | 0 => by simp
  | k + 1 => by
    rw [Finset.sum_range_succ]
    have ih := geom_le hX k
    have h1 : 2 * X ^ k ≤ X ^ (k + 1) := by
      rw [pow_succ, mul_comm 2]
      exact Nat.mul_le_mul_left _ hX
    calc ∑ m ∈ Finset.range (k + 1), X ^ m + X ^ (k + 1) ≤ 2 * X ^ k + X ^ (k + 1) := Nat.add_le_add_right ih _
      _ ≤ X ^ (k + 1) + X ^ (k + 1) := Nat.add_le_add_right h1 _
      _ = 2 * X ^ (k + 1) := by ring

theorem sum_range_pow_le {X : ℕ} (hX : 2 ≤ X) (s : ℕ) : ∑ m ∈ Finset.range (s + 2), X ^ m ≤ 2 * X ^ (s + 1) :=
  geom_le hX (s + 1)

/-- **The union over names, in closed form**, for `Adm = widthAdm w s W`. -/
theorem sum_patterns_le [Fintype K] (w : K → ℕ) (nPos s W : ℕ) (h2 : ∀ κ, 2 * nPos ≤ 2 ^ w κ) :
    ∑ P ∈ patterns nPos (widthAdm w s W), ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹
      ≤ ∑ m ∈ Finset.range (s + 2), (((2 * (nPos * Fintype.card K)) ^ m : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ W := by
  classical
  set U := Finset.range nPos ×ˢ (Finset.univ : Finset K) with hU
  have hUc : U.card = nPos * Fintype.card K := by simp [U, Finset.card_product]
  -- each admissible pattern weighs at most `2^|P| · 2^{-W}`
  have hpt : ∀ P ∈ patterns nPos (widthAdm w s W),
      ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ ≤ (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W := by
    intro P hP
    rw [mem_patterns] at hP
    unfold widthAdm at hP
    calc ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ ≤ ∏ a ∈ P, (2 * (2⁻¹ : ℝ≥0∞) ^ w a.2) :=
          Finset.prod_le_prod fun a _ => inv_sub_le _ _ (h2 a.2)
      _ = (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ (∑ a ∈ P, w a.2) := by
          rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.prod_pow_eq_pow_sum]
      _ ≤ (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W :=
          mul_le_mul' le_rfl (pow_le_pow_right_of_le_one' (by norm_num) hP.2.2.2)
  -- patterns sit inside the subsets of `U` of size at most `s + 1`
  have hsubset : patterns nPos (widthAdm w s W) ⊆ (Finset.range (s + 2)).biUnion fun m => U.powersetCard m := by
    intro P hP
    rw [mem_patterns] at hP
    unfold widthAdm at hP
    exact Finset.mem_biUnion.2 ⟨P.card, Finset.mem_range.2 (by omega), Finset.mem_powersetCard.2 ⟨hP.1, rfl⟩⟩
  calc ∑ P ∈ patterns nPos (widthAdm w s W), ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹
      ≤ ∑ P ∈ patterns nPos (widthAdm w s W), (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W := Finset.sum_le_sum hpt
    _ ≤ ∑ P ∈ (Finset.range (s + 2)).biUnion (fun m => U.powersetCard m),
          (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W := Finset.sum_le_sum_of_subset hsubset
    _ = ∑ m ∈ Finset.range (s + 2), ∑ P ∈ U.powersetCard m, (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W := by
        rw [Finset.sum_biUnion]
        intro m _ m' _ hmm
        refine Finset.disjoint_left.2 fun P h1 h2 => hmm ?_
        rw [← (Finset.mem_powersetCard.1 h1).2, (Finset.mem_powersetCard.1 h2).2]
    _ = ∑ m ∈ Finset.range (s + 2), ((U.card.choose m : ℕ) : ℝ≥0∞) * ((2 : ℝ≥0∞) ^ m * (2⁻¹ : ℝ≥0∞) ^ W) := by
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [Finset.sum_congr rfl fun P hP => by rw [(Finset.mem_powersetCard.1 hP).2], Finset.sum_const,
          Finset.card_powersetCard, nsmul_eq_mul]
    _ ≤ ∑ m ∈ Finset.range (s + 2), (((2 * (nPos * Fintype.card K)) ^ m : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ W := by
        refine Finset.sum_le_sum fun m _ => ?_
        rw [← mul_assoc]
        gcongr
        rw [← hUc, mul_pow]
        have : U.card.choose m ≤ U.card ^ m := Nat.choose_le_pow _ _
        calc ((U.card.choose m : ℕ) : ℝ≥0∞) * 2 ^ m ≤ ((U.card ^ m : ℕ) : ℝ≥0∞) * 2 ^ m := by gcongr
          _ = (((2 ^ m * U.card ^ m) : ℕ) : ℝ≥0∞) := by push_cast; ring

namespace Strategy

variable (S : Strategy α)

/-- **Everything at once**: the per-advice bound `2·(2·nPos·|K|)^{s+1}·2^{−W}`. -/
theorem prob_fresh_width_le [Fintype K] (T : K → History α → (q : Qry α) → Finset (α q.1)) (w : K → ℕ) (nPos : ℕ)
    (hT : ∀ κ h q, (T κ h q).card * (2 ^ w κ - nPos) ≤ Fintype.card (α q.1) - nPos)
    (h2 : ∀ κ, 2 * nPos ≤ 2 ^ w κ) (hX : 2 ≤ 2 * (nPos * Fintype.card K))
    {I : Type} (OnFresh : Oracle α → I → Prop) (name : Oracle α → I → ℕ × K)
    (h_distinct : ∀ π x y, OnFresh π x → OnFresh π y → x ≠ y → (name π x).1 ≠ (name π y).1)
    (h_fresh : ∀ π x, OnFresh π x →
      ∃ q, S.next (S.hist π (name π x).1) = some q ∧ Fresh (S.hist π (name π x).1) q)
    (h_target : ∀ π x q, OnFresh π x → S.next (S.hist π (name π x).1) = some q →
      ans π q ∈ T (name π x).2 (S.hist π (name π x).1) q)
    (h_lt : ∀ π x, OnFresh π x → (name π x).1 < nPos)
    (s W : ℕ) (Win : Oracle α → Prop)
    (hwin : ∀ π, Win π → ∃ X : Finset I, (∀ x ∈ X, OnFresh π x) ∧ X.card ≤ s + 1 ∧
      W ≤ ∑ x ∈ X, w (name π x).2) :
    prob Win ≤ 2 * (((2 * (nPos * Fintype.card K)) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ W := by
  classical
  have hwin' : ∀ π, Win π → ∃ X : Finset I, (∀ x ∈ X, OnFresh π x) ∧ widthAdm w s W (X.image (name π)) := by
    intro π hπ
    obtain ⟨X, hX, hc, hW⟩ := hwin π hπ
    have hinj : Set.InjOn (name π) X := fun x hx y hy hxy => by
      by_contra hne
      exact h_distinct π x y (hX x hx) (hX y hy) hne (congrArg Prod.fst hxy)
    refine ⟨X, hX, (Finset.card_image_le).trans hc, ?_⟩
    rw [Finset.sum_image fun x hx y hy h => hinj hx hy h]
    exact hW
  refine (S.prob_fresh_le T w nPos hT OnFresh name h_distinct h_fresh h_target h_lt _ Win hwin').trans
    ((sum_patterns_le w nPos s W h2).trans ?_)
  rw [← Finset.sum_mul]
  gcongr
  have := sum_range_pow_le hX s
  calc ∑ m ∈ Finset.range (s + 2), (((2 * (nPos * Fintype.card K)) ^ m : ℕ) : ℝ≥0∞)
      = ((∑ m ∈ Finset.range (s + 2), (2 * (nPos * Fintype.card K)) ^ m : ℕ) : ℝ≥0∞) := by push_cast; rfl
    _ ≤ ((2 * (2 * (nPos * Fintype.card K)) ^ (s + 1) : ℕ) : ℝ≥0∞) := by exact_mod_cast this
    _ = 2 * (((2 * (nPos * Fintype.card K)) ^ (s + 1) : ℕ) : ℝ≥0∞) := by push_cast; ring

end Strategy

end Bridge

end LazyPerm

