/-!
# `ChainExPostFactoG` — the collision term: `pr[Bad] ≤ nPos²/2^(ℓ+c)`

Work file of `bc-a359729a`. It edits no file of `bc-35b053cc`.

**Statement** (`ChainReplay.pr_Bad_le`). With block domains injective,
`pr[Bad] ≤ nPos²/2^(ℓ+c)`: a uniform `Π₂` makes two distinct honest chain positions share an input with probability at
most the collision term of `ChainExPostFactoG`. It does not involve the adversary.

**Proof.**
1. **Order.** Chain positions `(v, p)`, `1 ≤ p ≤ ovCalls v`, are ordered lexicographically (`posKey`). Every chain
   input depends only on `Π₂` at the inputs of earlier positions (`xin_stable`).
2. **First collision.** A collision gives a pair `a < b` that collide, with no collision among the positions before
   `b` (`exists_firstColl`).
3. **One pinned output.** Then some position `c < b` has `ovH (π (xin c))` equal to a value fixed by the positions
   before `c`, and `xin c` is new. The two inputs share their `h`-part: the previous chaining value, or a block's IV.
   Two IVs are distinct because the domains are injective.
4. **Adaptive pin** (`card_pin_le`). Resampling `π` at `xin c` (`swapTo`) injects `{event} × {good h'}` into the
   permutations, so the event has probability at most `1/(2^(ℓ+c) − M)`, where `M` is the number of positions.
5. **Sum.** At most `M²/2` pairs, `inv_two_pow_sub_le`, and `M ≤ B(B+1)/2 ≤ nPos`.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace Birthday

/-! ### The adaptive pin -/

section Pin

variable {r c : ℕ}

/-- Set `π z` to `t`, swapping with the point that `π` sent to `t`. -/
def swapTo (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) : Equiv.Perm (Bits (r + (r + c))) :=
  Equiv.swap (π z) t * π

theorem swapTo_self (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) : swapTo π z t z = t := by
  simp only [swapTo, Equiv.Perm.mul_apply, Equiv.swap_apply_left]

theorem swapTo_apply_ne (π : Equiv.Perm (Bits (r + (r + c)))) (z t x : Bits (r + (r + c))) (hx : x ≠ z)
    (hy : π x ≠ t) : swapTo π z t x = π x := by
  simp only [swapTo, Equiv.Perm.mul_apply]
  exact Equiv.swap_apply_of_ne_of_ne (fun h => hx (π.injective h)) hy

theorem swapTo_recover (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) :
    Equiv.swap (π z) (swapTo π z t z) * swapTo π z t = π := by
  rw [swapTo_self]
  show Equiv.swap (π z) t * (Equiv.swap (π z) t * π) = π
  rw [← mul_assoc, Equiv.swap_mul_self, one_mul]

theorem card_bits (n : ℕ) : Fintype.card (Bits n) = 2 ^ n := by simp [Bits]

open Classical in
/-- **Adaptive pin.** Let `z π` be a point, `T π` an `h`-value and `S π` a set of at most `n` points, where `z` and `T`
depend on `π` only through `S π`. The permutations with `ovH (π (z π)) = T π` and `z π ∉ S π`, times `2^(r+c) − n`,
number at most all permutations. -/
theorem card_pin_le (z : Equiv.Perm (Bits (r + (r + c))) → Bits (r + (r + c)))
    (T : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c))
    (S : Equiv.Perm (Bits (r + (r + c))) → Finset (Bits (r + (r + c)))) (n : ℕ)
    (hS : ∀ π, (S π).card ≤ n)
    (hstab : ∀ π π' : Equiv.Perm (Bits (r + (r + c))), (∀ x ∈ S π, π' x = π x) → z π' = z π ∧ T π' = T π)
    (E : Equiv.Perm (Bits (r + (r + c))) → Prop)
    (hE : ∀ π, E π → ovH (π (z π)) = T π ∧ z π ∉ S π) :
    (Finset.univ.filter E).card * (2 ^ (r + c) - n) ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := by
  let good : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c) → Prop :=
    fun π h' => ∀ x ∈ S π, π x ≠ Fin.append (ovR (π (z π))) h'
  have hgood_card : ∀ π, 2 ^ (r + c) - n ≤ (Finset.univ.filter (good π)).card := by
    intro π
    have hbad : (Finset.univ.filter fun h' => ¬ good π h') ⊆ (S π).image (fun x => ovH (π x)) := by
      intro h' hh
      simp only [good, Finset.mem_filter, Finset.mem_univ, true_and, not_forall, not_not] at hh
      obtain ⟨x, hx, hxe⟩ := hh
      exact Finset.mem_image.2 ⟨x, hx, by rw [hxe, ovH_append]⟩
    have hsplit := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset (Bits (r + c)))) (good π)
    rw [Finset.card_univ, card_bits] at hsplit
    have := (Finset.card_le_card hbad).trans (Finset.card_image_le.trans (hS π))
    omega
  have hpairs : (Finset.univ.filter E).card * (2 ^ (r + c) - n) ≤
      ((Finset.univ.filter E ×ˢ (Finset.univ : Finset (Bits (r + c)))).filter (fun p => good p.1 p.2)).card := by
    have hsum : ((Finset.univ.filter E ×ˢ (Finset.univ : Finset (Bits (r + c)))).filter
        (fun p => good p.1 p.2)).card = ∑ π ∈ Finset.univ.filter E, (Finset.univ.filter (good π)).card := by
      rw [Finset.card_filter, Finset.sum_product]
      exact Finset.sum_congr rfl (fun π _ => (Finset.card_filter _ _).symm)
    rw [hsum, ← smul_eq_mul]
    exact Finset.card_nsmul_le_sum _ _ _ (fun π _ => hgood_card π)
  refine hpairs.trans ((Finset.card_le_card_of_injOn
    (fun p => swapTo p.1 (z p.1) (Fin.append (ovR (p.1 (z p.1))) p.2))
    (fun _ _ => Finset.mem_coe.2 (Finset.mem_univ _)) ?_).trans Finset.card_univ.le)
  intro p₁ hp₁ p₂ hp₂ heq
  simp only [Finset.coe_filter, Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and,
    Set.mem_ofPred_eq] at hp₁ hp₂
  obtain ⟨⟨hE₁, -⟩, hg₁⟩ := hp₁
  obtain ⟨⟨hE₂, -⟩, hg₂⟩ := hp₂
  dsimp only at heq
  set π' := swapTo p₁.1 (z p₁.1) (Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2) with hπ'
  have hag₁ : ∀ x ∈ S p₁.1, π' x = p₁.1 x := fun x hx =>
    swapTo_apply_ne _ _ _ x (fun h => (hE p₁.1 hE₁).2 (h ▸ hx)) (hg₁ x hx)
  have hag₂ : ∀ x ∈ S p₂.1, π' x = p₂.1 x := fun x hx => by
    rw [heq]; exact swapTo_apply_ne _ _ _ x (fun h => (hE p₂.1 hE₂).2 (h ▸ hx)) (hg₂ x hx)
  obtain ⟨hz₁, hT₁⟩ := hstab p₁.1 π' hag₁
  obtain ⟨hz₂, hT₂⟩ := hstab p₂.1 π' hag₂
  have hzz : z p₂.1 = z p₁.1 := hz₂.symm.trans hz₁
  have hself₁ : π' (z p₁.1) = Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2 := swapTo_self _ _ _
  have hself₂ : π' (z p₁.1) = Fin.append (ovR (p₂.1 (z p₁.1))) p₂.2 := by
    rw [heq, ← hzz]; exact swapTo_self _ _ _
  have hh : p₁.2 = p₂.2 := by
    have := congrArg ovH (hself₁.symm.trans hself₂)
    simpa only [ovH_append] using this
  have hr : ovR (p₁.1 (z p₁.1)) = ovR (p₂.1 (z p₁.1)) := by
    have := congrArg ovR (hself₁.symm.trans hself₂)
    simpa only [ovR_append] using this
  have hv : p₁.1 (z p₁.1) = p₂.1 (z p₁.1) := by
    rw [← append_ovR_ovH (p₁.1 (z p₁.1)), ← append_ovR_ovH (p₂.1 (z p₁.1)), hr]
    congr 1
    rw [(hE p₁.1 hE₁).1, ← hzz, (hE p₂.1 hE₂).1, ← hT₁, hT₂]
  have hrec₁ := swapTo_recover p₁.1 (z p₁.1) (Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2)
  have hrec₂ := swapTo_recover p₂.1 (z p₂.1) (Fin.append (ovR (p₂.1 (z p₂.1))) p₂.2)
  rw [← hπ'] at hrec₁
  rw [← heq, hzz] at hrec₂
  refine Prod.ext ?_ hh
  rw [← hrec₁, ← hrec₂, hv]

open Classical in
/-- **Adaptive pin, as a probability**: the event has probability at most `1/(2^(r+c) − n)`. -/
theorem pr_pin_le (z : Equiv.Perm (Bits (r + (r + c))) → Bits (r + (r + c)))
    (T : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c))
    (S : Equiv.Perm (Bits (r + (r + c))) → Finset (Bits (r + (r + c)))) (n : ℕ)
    (hS : ∀ π, (S π).card ≤ n)
    (hstab : ∀ π π' : Equiv.Perm (Bits (r + (r + c))), (∀ x ∈ S π, π' x = π x) → z π' = z π ∧ T π' = T π)
    (E : Equiv.Perm (Bits (r + (r + c))) → Prop)
    (hE : ∀ π, E π → ovH (π (z π)) = T π ∧ z π ∉ S π) :
    pr E ≤ (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by
  have hnat := card_pin_le z T S n hS hstab E hE
  rcases Nat.eq_zero_or_pos (2 ^ (r + c) - n) with h0 | hpos
  · rw [h0, Nat.cast_zero, ENNReal.inv_zero]; exact le_top
  have hΩ0 : (Fintype.card (Equiv.Perm (Bits (r + (r + c)))) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (Equiv.Perm (Bits (r + (r + c)))) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) ≠ 0 := by exact_mod_cast hpos.ne'
  have h2t : (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) ≠ ⊤ := ENNReal.natCast_ne_top _
  rw [pr, ENNReal.div_le_iff hΩ0 hΩt]
  have hc : ((Finset.univ.filter E).card : ℝ≥0∞) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))
      ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := by exact_mod_cast hnat
  calc ((Finset.univ.filter E).card : ℝ≥0∞)
      = (Finset.univ.filter E).card * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by
        rw [mul_assoc, ENNReal.mul_inv_cancel h2 h2t, mul_one]
    _ ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by gcongr
    _ = (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ * Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := mul_comm _ _

end Pin

/-- The lexicographic key of a chain position `(v, p)`, `p < B + 2`. -/
def posKey {B : ℕ} (q : Fin B × ℕ) : ℕ := q.1.val * (B + 2) + q.2

end Birthday

namespace ChainReplay

open Reach Reach.ChainReplayR Birthday

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-! ### Chain positions and their order -/

/-- The honest chain positions `(v, p)`, `1 ≤ p ≤ ovCalls v`. -/
def posSet : Finset (Fin B × ℕ) := (ovPos B).filter (fun q => 1 ≤ q.2 ∧ q.2 ≤ ovCalls R.G q.1)

theorem mem_posSet {q : Fin B × ℕ} : q ∈ R.posSet ↔ 1 ≤ q.2 ∧ q.2 ≤ ovCalls R.G q.1 := by
  unfold posSet
  rw [Finset.mem_filter]
  refine ⟨fun h => h.2, fun h => ⟨Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 ?_⟩, h⟩⟩
  have := R.ovCalls_lt q.1
  omega

theorem posKey_inj {q q' : Fin B × ℕ} (hq : q ∈ R.posSet) (hq' : q' ∈ R.posSet) (h : posKey q = posKey q') :
    q = q' := by
  have h1 : q.2 < B + 2 := by have := R.ovCalls_lt q.1; have := (R.mem_posSet.1 hq).2; omega
  have h2 : q'.2 < B + 2 := by have := R.ovCalls_lt q'.1; have := (R.mem_posSet.1 hq').2; omega
  unfold posKey at h
  have hmod : q.2 = q'.2 := by
    have e1 : (q.1.val * (B + 2) + q.2) % (B + 2) = q.2 := by
      rw [Nat.mul_add_mod_of_lt h1]
    have e2 : (q'.1.val * (B + 2) + q'.2) % (B + 2) = q'.2 := by
      rw [Nat.mul_add_mod_of_lt h2]
    rw [← e1, ← e2, h]
  have hdiv : q.1.val = q'.1.val := by
    rw [hmod] at h
    exact Nat.eq_of_mul_eq_mul_right (by omega) (Nat.add_right_cancel h)
  exact Prod.ext (Fin.ext hdiv) hmod

/-- A parent's pad position comes before every position of its child. -/
theorem posKey_parent_lt {u v : Fin B} (huv : u < v) (p : ℕ) :
    posKey (u, ovCalls R.G u) < posKey (v, p + 1) := by
  have h1 := R.ovCalls_lt u
  have h2 : u.val + 1 ≤ v.val := huv
  have h3 : (u.val + 1) * (B + 2) ≤ v.val * (B + 2) := Nat.mul_le_mul_right _ h2
  unfold posKey
  simp only
  rw [Nat.succ_mul] at h3
  omega

/-- The number of chain positions is at most `B(B+1)/2`: block `v` has `ovCalls v ≤ v + 1` positions. -/
theorem card_posSet_le_half : R.posSet.card ≤ B * (B + 1) / 2 := by
  have hsub : R.posSet ⊆ Finset.univ.biUnion (fun v : Fin B => (Finset.Icc 1 (ovCalls R.G v)).image (fun p => (v, p))) := by
    intro q hq
    obtain ⟨h1, h2⟩ := R.mem_posSet.1 hq
    exact Finset.mem_biUnion.2 ⟨q.1, Finset.mem_univ _, Finset.mem_image.2 ⟨q.2, Finset.mem_Icc.2 ⟨h1, h2⟩, rfl⟩⟩
  refine (Finset.card_le_card hsub).trans (Finset.card_biUnion_le.trans ?_)
  calc ∑ v : Fin B, ((Finset.Icc 1 (ovCalls R.G v)).image (fun p => (v, p))).card
      ≤ ∑ v : Fin B, (v.val + 1) := Finset.sum_le_sum fun v _ => by
        refine Finset.card_image_le.trans ?_
        rw [Nat.card_Icc]
        have := parentsDesc_length_le R.G v
        unfold ovCalls; omega
    _ ≤ B * (B + 1) / 2 := by
        rw [Nat.le_div_iff_mul_le (by norm_num : (0 : ℕ) < 2)]
        have hg : (∑ j : Fin B, (j.val + 1)) * 2 = B * (B + 1) := by
          rw [Fin.sum_univ_eq_sum_range (fun i => i + 1) B, Finset.sum_add_distrib, Finset.sum_const,
            Finset.card_range, smul_eq_mul, mul_one, add_mul, Finset.sum_range_id_mul_two]
          cases B with
          | zero => rfl
          | succ n => simp only [Nat.succ_sub_one]; ring
        exact hg.le

/-- The number of chain positions is at most `nPos`. -/
theorem card_posSet_le : R.posSet.card ≤ nPos B R.Q := by
  have := R.card_posSet_le_half
  unfold nPos; omega

/-! ### Chain inputs depend only on earlier positions -/

/-- **Prefix stability.** If `π'` agrees with `π` at the chain inputs of every position before key `n`, the chain
inputs of every position up to key `n` agree. -/
theorem xin_stable {π π' : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (n : ℕ)
    (hag : ∀ q ∈ R.posSet, posKey q < n → π' (R.xin π q.1 q.2) = π (R.xin π q.1 q.2)) :
    ∀ q ∈ R.posSet, posKey q ≤ n → R.xin π' q.1 q.2 = R.xin π q.1 q.2 := by
  suffices h : ∀ m, ∀ q ∈ R.posSet, posKey q = m → m ≤ n → R.xin π' q.1 q.2 = R.xin π q.1 q.2 from
    fun q hq hn => h _ q hq rfl hn
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    rintro ⟨v, p⟩ hq rfl hn
    obtain ⟨hp1, hp⟩ := R.mem_posSet.1 hq
    simp only at hp1 hp ⊢
    obtain ⟨p', rfl⟩ : ∃ p', p = p' + 1 := ⟨p - 1, by omega⟩
    rw [xin_succ R π' v p' (by omega), xin_succ R π v p' (by omega)]
    congr 1
    · by_cases hpar : p' < (parentsDesc R.G v).length
      · rw [blks_getElem_parent R π' v p' hpar, blks_getElem_parent R π v p' hpar]
        have hu : (parentsDesc R.G v)[p'] < v := parentsDesc_lt R.G (List.getElem_mem hpar)
        rw [R.labelG_eq_realPt π' _, R.labelG_eq_realPt π _, R.realPt_eq_xin π' _, R.realPt_eq_xin π _]
        have hmem : ((parentsDesc R.G v)[p'], ovCalls R.G (parentsDesc R.G v)[p']) ∈ R.posSet :=
          R.mem_posSet.2 ⟨by unfold ovCalls; omega, le_rfl⟩
        have hkey := R.posKey_parent_lt hu p'
        have hx := ih _ hkey _ hmem rfl (by omega)
        simp only at hx
        rw [hx, hag _ hmem (by omega)]
      · have hpad : p' = (parentsDesc R.G v).length := by unfold ovCalls at hp; omega
        have e : ∀ ρ : Equiv.Perm (Bits (ℓ + (ℓ + c))),
            (blks R ρ v)[p']'(by rw [blks_length]; omega) = padBlk := by
          intro ρ
          simp only [blks, absorbedG]
          rw [List.getElem_append_right (by simp; omega)]
          simp [hpad]
        rw [e π', e π]
    · rcases Nat.eq_zero_or_pos p' with h0 | hpos
      · subst h0; rw [chainH_zero, chainH_zero]
      · obtain ⟨q', rfl⟩ : ∃ q', p' = q' + 1 := ⟨p' - 1, by omega⟩
        rw [chainH_succ R π' v q' (by omega), chainH_succ R π v q' (by omega)]
        have hmem : (v, q' + 1) ∈ R.posSet := R.mem_posSet.2 ⟨by omega, by simp only; omega⟩
        have hkey : posKey (v, q' + 1) < posKey (v, q' + 1 + 1) := by simp only [posKey]; omega
        have hx := ih _ hkey _ hmem rfl (by omega)
        simp only at hx
        rw [hx, hag _ hmem (by omega)]

/-! ### The first collision -/

/-- `a` and `b` share their chain input, and no two positions before `b` do. -/
def FirstColl (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (a b : Fin B × ℕ) : Prop :=
  R.xin π a.1 a.2 = R.xin π b.1 b.2 ∧
    ∀ q ∈ R.posSet, ∀ q' ∈ R.posSet, posKey q < posKey q' → posKey q' < posKey b →
      R.xin π q.1 q.2 ≠ R.xin π q'.1 q'.2

/-- **A collision has a first one.** -/
theorem exists_firstColl {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (h : R.Bad π) :
    ∃ a ∈ R.posSet, ∃ b ∈ R.posSet, posKey a < posKey b ∧ R.FirstColl π a b := by
  classical
  unfold Bad NoCollU at h
  push Not at h
  obtain ⟨v, p, v', p', hp1, hp, hp1', hp', hne, heq⟩ := h
  have hm : (v, p) ∈ R.posSet := R.mem_posSet.2 ⟨hp1, hp⟩
  have hm' : (v', p') ∈ R.posSet := R.mem_posSet.2 ⟨hp1', hp'⟩
  have hkne : posKey (v, p) ≠ posKey (v', p') := by
    intro hk
    have := R.posKey_inj hm hm' hk
    simp only [Prod.mk.injEq] at this
    rcases hne with h | h
    · exact h this.1
    · exact h this.2
  have hP : ∃ n, ∃ a ∈ R.posSet, ∃ b ∈ R.posSet, posKey a < posKey b ∧ posKey b = n ∧
      R.xin π a.1 a.2 = R.xin π b.1 b.2 := by
    rcases lt_or_gt_of_ne hkne with hlt | hlt
    · exact ⟨_, (v, p), hm, (v', p'), hm', hlt, rfl, heq⟩
    · exact ⟨_, (v', p'), hm', (v, p), hm, hlt, rfl, heq.symm⟩
  obtain ⟨a, ha, b, hb, hab, hbn, hxe⟩ := Nat.find_spec hP
  refine ⟨a, ha, b, hb, hab, hxe, fun q hq q' hq' hqq' hq'b hcoll => ?_⟩
  exact Nat.find_min hP (hbn ▸ hq'b) ⟨q, hq, q', hq', hqq', rfl, hcoll⟩

/-- The position whose output is pinned by a collision of `a < b`: `b`'s predecessor, or `a`'s if `b` is a first call. -/
def pinPos (a b : Fin B × ℕ) : Fin B × ℕ := if 2 ≤ b.2 then (b.1, b.2 - 1) else (a.1, a.2 - 1)

/-- The `h`-value it is pinned to: `a`'s previous chaining value, or `b`'s IV. -/
noncomputable def pinVal (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (a b : Fin B × ℕ) : Bits (ℓ + c) :=
  if 2 ≤ b.2 then chainH R π a.1 (a.2 - 1) else iv (R.dom b.1.val)

/-- The chain inputs of the positions before key `n`. -/
noncomputable def earlierPts (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (n : ℕ) : Finset (Bits (ℓ + (ℓ + c))) :=
  (R.posSet.filter (fun q => posKey q < n)).image (fun q => R.xin π q.1 q.2)

theorem card_earlierPts_le (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (n : ℕ) :
    (R.earlierPts π n).card ≤ R.posSet.card :=
  Finset.card_image_le.trans (Finset.card_filter_le _ _)

/-- A chain input's `h`-part is the previous chaining value. -/
theorem ovH_xin (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ} (hq : q ∈ R.posSet) :
    ovH (R.xin π q.1 q.2) = chainH R π q.1 (q.2 - 1) := by
  obtain ⟨h1, h2⟩ := R.mem_posSet.1 hq
  obtain ⟨p', hp'⟩ : ∃ p', q.2 = p' + 1 := ⟨q.2 - 1, by omega⟩
  rw [hp', xin_succ R π q.1 p' (by omega), ovH_append]
  simp

theorem iv_injective {d d' : Bits c} (h : iv (r := ℓ) d = iv d') : d = d' := by
  funext j
  have := congrFun h (Fin.natAdd ℓ j)
  simpa [iv, Fin.append_right] using this

/-- **A first collision pins one output.** Both inputs share their `h`-part. If `b` is a first call, `a` is not (two IVs
differ), and `a`'s predecessor's output equals `b`'s IV. Otherwise `b`'s predecessor's output equals `a`'s previous
chaining value. The pinned input is new. -/
theorem firstColl_pin (hdom : Function.Injective (fun i : Fin B => R.dom i)) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {a b : Fin B × ℕ} (ha : a ∈ R.posSet) (hb : b ∈ R.posSet) (hab : posKey a < posKey b)
    (hF : R.FirstColl π a b) :
    (2 ≤ b.2 ∨ 2 ≤ a.2) ∧
      ovH (π (R.xin π (pinPos a b).1 (pinPos a b).2)) = R.pinVal π a b ∧
      R.xin π (pinPos a b).1 (pinPos a b).2 ∉ R.earlierPts π (posKey (pinPos a b)) := by
  obtain ⟨hxe, hfirst⟩ := hF
  obtain ⟨ha1, ha2⟩ := R.mem_posSet.1 ha
  obtain ⟨hb1, hb2⟩ := R.mem_posSet.1 hb
  have hh : chainH R π a.1 (a.2 - 1) = chainH R π b.1 (b.2 - 1) := by
    rw [← R.ovH_xin π ha, ← R.ovH_xin π hb, hxe]
  -- the pinned position is in the order before `b`, and is a chain position
  have hcase : 2 ≤ b.2 ∨ 2 ≤ a.2 := by
    by_contra hno
    push Not at hno
    have hb1' : b.2 = 1 := by omega
    have ha1' : a.2 = 1 := by omega
    rw [ha1', hb1', show 1 - 1 = 0 from rfl, chainH_zero, chainH_zero] at hh
    have hd := hdom (iv_injective hh)
    have : a = b := Prod.ext hd (by omega)
    rw [this] at hab
    exact lt_irrefl _ hab
  have hpin_mem : pinPos a b ∈ R.posSet := by
    unfold pinPos
    split_ifs with h2
    · exact R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
    · exact R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
  have hpin_key : posKey (pinPos a b) < posKey b := by
    unfold pinPos posKey
    split_ifs with h2
    · simp only; omega
    · simp only; unfold posKey at hab; omega
  refine ⟨hcase, ?_, ?_⟩
  · unfold pinPos pinVal
    split_ifs with h2
    · simp only
      obtain ⟨q', hq'⟩ : ∃ q', b.2 - 1 = q' + 1 := ⟨b.2 - 2, by omega⟩
      rw [hh, hq', chainH_succ R π b.1 q' (by omega)]
    · simp only
      have hb1' : b.2 = 1 := by omega
      have ha2' : 2 ≤ a.2 := by omega
      obtain ⟨q', hq'⟩ : ∃ q', a.2 - 1 = q' + 1 := ⟨a.2 - 2, by omega⟩
      rw [hq', ← chainH_succ R π a.1 q' (by omega), ← hq', hh, hb1', show 1 - 1 = 0 from rfl, chainH_zero]
  · intro hmem
    obtain ⟨q, hq, hqx⟩ := Finset.mem_image.1 hmem
    obtain ⟨hqs, hqk⟩ := Finset.mem_filter.1 hq
    exact hfirst q hqs _ hpin_mem hqk hpin_key hqx

/-- **One pair collides first with probability at most `1/(2^(ℓ+c) − M)`.** -/
theorem pr_firstColl_le (hdom : Function.Injective (fun i : Fin B => R.dom i)) {a b : Fin B × ℕ}
    (ha : a ∈ R.posSet) (hb : b ∈ R.posSet) (hab : posKey a < posKey b) :
    pr (fun π => R.FirstColl π a b) ≤ (((2 ^ (ℓ + c) - R.posSet.card : ℕ) : ℝ≥0∞))⁻¹ := by
  by_cases hcase : 2 ≤ b.2 ∨ 2 ≤ a.2
  · obtain ⟨ha1, ha2⟩ := R.mem_posSet.1 ha
    obtain ⟨hb1, hb2⟩ := R.mem_posSet.1 hb
    have hpin_mem : pinPos a b ∈ R.posSet := by
      unfold pinPos
      split_ifs with h2
      · exact R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
      · exact R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
    refine pr_pin_le (fun π => R.xin π (pinPos a b).1 (pinPos a b).2) (fun π => R.pinVal π a b)
      (fun π => R.earlierPts π (posKey (pinPos a b))) R.posSet.card (fun π => R.card_earlierPts_le π _)
      ?_ _ (fun π hF => (R.firstColl_pin hdom ha hb hab hF).2)
    intro π π' hag
    have hag' : ∀ q ∈ R.posSet, posKey q < posKey (pinPos a b) →
        π' (R.xin π q.1 q.2) = π (R.xin π q.1 q.2) := fun q hq hk =>
      hag _ (Finset.mem_image.2 ⟨q, Finset.mem_filter.2 ⟨hq, hk⟩, rfl⟩)
    refine ⟨R.xin_stable _ hag' _ hpin_mem le_rfl, ?_⟩
    show R.pinVal π' a b = R.pinVal π a b
    unfold pinVal
    split_ifs with h2
    · rcases Nat.lt_or_ge a.2 2 with ha' | ha'
      · rw [show a.2 - 1 = 0 by omega, chainH_zero, chainH_zero]
      · obtain ⟨q', hq'⟩ : ∃ q', a.2 - 1 = q' + 1 := ⟨a.2 - 2, by omega⟩
        rw [hq', chainH_succ R π' a.1 q' (by omega), chainH_succ R π a.1 q' (by omega)]
        have hmem : (a.1, q' + 1) ∈ R.posSet := R.mem_posSet.2 ⟨by simp only; omega, by simp only; omega⟩
        have hkey : posKey (a.1, q' + 1) < posKey (pinPos a b) := by
          unfold pinPos; simp only [h2, ↓reduceIte, posKey] at hab ⊢; omega
        have hx := R.xin_stable _ hag' _ hmem hkey.le
        simp only at hx
        rw [hx, hag' _ hmem hkey]
    · rfl
  · classical
    push Not at hcase
    refine le_trans (le_of_eq ?_) zero_le
    rw [pr, ENNReal.div_eq_zero_iff]
    left
    norm_cast
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    intro π _ hF
    have := (R.firstColl_pin hdom ha hb hab hF).1
    omega

/-- **The collision term.** With injective block domains, `pr[Bad] ≤ nPos²/2^(ℓ+c)`. -/
theorem pr_Bad_le (hdom : Function.Injective (fun i : Fin B => R.dom i)) :
    pr (fun π => R.Bad π) ≤ (((nPos B R.Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c) := by
  classical
  set M := R.posSet.card with hM
  set pairs := (R.posSet ×ˢ R.posSet).filter (fun x => posKey x.1 < posKey x.2) with hpairs
  have hunion : pr (fun π => R.Bad π) ≤ ∑ x ∈ pairs, pr (fun π => R.FirstColl π x.1 x.2) := by
    refine le_trans (pr_mono fun π hπ => ?_) (PousThm1Dense.pr_exists_le pairs (fun x π => R.FirstColl π x.1 x.2))
    obtain ⟨a, ha, b, hb, hab, hF⟩ := R.exists_firstColl hπ
    exact ⟨(a, b), Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨ha, hb⟩, hab⟩, hF⟩
  have hsum : ∑ x ∈ pairs, pr (fun π => R.FirstColl π x.1 x.2)
      ≤ pairs.card * (((2 ^ (ℓ + c) - M : ℕ) : ℝ≥0∞))⁻¹ := by
    rw [← nsmul_eq_mul]
    refine Finset.sum_le_card_nsmul _ _ _ fun x hx => ?_
    obtain ⟨hx1, hx2⟩ := Finset.mem_filter.1 hx
    obtain ⟨ha, hb⟩ := Finset.mem_product.1 hx1
    exact R.pr_firstColl_le hdom ha hb hx2
  -- `2·|pairs| ≤ M²`: the pairs and their swaps are disjoint within `posSet²`
  have hpairs2 : 2 * pairs.card ≤ M ^ 2 := by
    set pairs' := (R.posSet ×ˢ R.posSet).filter (fun x => posKey x.2 < posKey x.1)
    have hcard' : pairs'.card = pairs.card := by
      refine Finset.card_bij (fun x _ => x.swap) (fun x hx => ?_) (fun x _ y _ h => ?_) (fun y hy => ?_)
      · obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hx
        obtain ⟨ha, hb⟩ := Finset.mem_product.1 h1
        exact Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨hb, ha⟩, h2⟩
      · simpa using h
      · obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hy
        obtain ⟨ha, hb⟩ := Finset.mem_product.1 h1
        exact ⟨y.swap, Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨hb, ha⟩, h2⟩, by simp⟩
    have hdisj : Disjoint pairs pairs' := by
      rw [Finset.disjoint_filter]
      intro x _ h1 h2
      omega
    have hsub : pairs ∪ pairs' ⊆ R.posSet ×ˢ R.posSet :=
      Finset.union_subset (Finset.filter_subset _ _) (Finset.filter_subset _ _)
    have := Finset.card_le_card hsub
    rw [Finset.card_union_of_disjoint hdisj, Finset.card_product, hcard'] at this
    rw [sq, hM]; omega
  have hMn : M ≤ nPos B R.Q := R.card_posSet_le
  by_cases h2M : 2 * M ≤ 2 ^ (ℓ + c)
  · have hinv := inv_two_pow_sub_le (ℓ := ℓ + c) h2M
    calc pr (fun π => R.Bad π)
        ≤ pairs.card * (((2 ^ (ℓ + c) - M : ℕ) : ℝ≥0∞))⁻¹ := hunion.trans hsum
      _ ≤ pairs.card * (2 * ((2 : ℝ≥0∞) ^ (ℓ + c))⁻¹) := by gcongr
      _ = ((2 * pairs.card : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c) := by
          rw [div_eq_mul_inv]; push_cast; ring
      _ ≤ (((nPos B R.Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c) := by
          gcongr
          exact hpairs2.trans (Nat.pow_le_pow_left hMn 2)
  · push Not at h2M
    have hbig : 2 ^ (ℓ + c) ≤ (nPos B R.Q) ^ 2 := by
      have hM1 : 1 ≤ M := by
        rcases Nat.eq_zero_or_pos M with h | h
        · rw [h] at h2M; simp at h2M
        · exact h
      have hMM : 2 ^ (ℓ + c) ≤ M ^ 2 := by
        rcases Nat.lt_or_ge M 2 with hM2 | hM2
        · have hM1' : M = 1 := by omega
          rw [hM1'] at h2M ⊢
          have : 2 ^ (ℓ + c) ≤ 1 := by omega
          simpa using this
        · calc 2 ^ (ℓ + c) ≤ 2 * M := h2M.le
            _ ≤ M * M := Nat.mul_le_mul_right _ hM2
            _ = M ^ 2 := (sq M).symm
      exact hMM.trans (Nat.pow_le_pow_left hMn 2)
    refine (PousThm1Dense.pr_le_one _).trans ?_
    rw [ENNReal.le_div_iff_mul_le (Or.inl (by positivity)) (Or.inl (by simp)), one_mul]
    exact_mod_cast hbig

end ChainReplay

end PousSpongeChain

end


