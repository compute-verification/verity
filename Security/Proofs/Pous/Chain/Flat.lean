    have hrecL : rec ∈ l := by
      rw [heq]
      exact List.mem_append_right _ (List.mem_cons_self)
    have hrecShow : rec ∈ R.showRecords π :=
      hlShow.subset hrecL
    unfold showRecords at hrecShow
    obtain ⟨τ, hτ, hx⟩ := List.mem_flatMap.1 hrecShow
