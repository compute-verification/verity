/-! ════ Freshness.JointClassWeightFalse ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousJointRefute

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds PousKnowledge
  PousAssembly


/-- `okLuckyMulti` (`P3MeetsLucky.lean`). -/
def okLuckyMulti (N n wc Q : ℕ) : Prop :=
  0 < n ∧ 2 ^ 15 ≤ Q ∧ 64 * (N * n) * (N * (n * (Q + 1) + 2 * n)) ≤ 2 ^ (n * wc)

/-- Segment `s`'s slot `(c, r)`, placed as the joint slot `(s·n + c, r)`. -/
def jointSlot (n s : ℕ) (x : ℕ × ℕ) : ℕ × ℕ := (s * n + x.1, x.2)

open Classical in
/-- The joint lucky set: every segment's lucky slots, placed by `jointSlot`. -/
noncomputable def jointLuckySet {N n wc : ℕ} (p : Fin N → Fin n → OracleProg (p3ModelT n wc) (Lab n wc))
    (ω : (p3ModelT n wc).Ω) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (D Q : ℕ) : Finset (ℕ × ℕ) :=
  Finset.univ.biUnion fun s : Fin N => (luckySet (p s) ω (tags s) G (W s) D Q).image (jointSlot n s)

/-- The joint lucky bits: the sum of the segments' lucky bits. -/
noncomputable def jointLuckyBits {N n wc : ℕ} (p : Fin N → Fin n → OracleProg (p3ModelT n wc) (Lab n wc))
    (ω : (p3ModelT n wc).Ω) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (D : ℕ) : ℕ :=
  ∑ s : Fin N, luckyBits (p s) ω (tags s) G (W s) D

open Classical in
/-- `JointClassWeight` (`P3MeetsFinal.lean`), verbatim. -/
def JointClassWeight : Prop :=
  ∀ (N n wc D Q : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (p : Fin N → Fin n → OracleProg (p3ModelT n wc) (Lab n wc)),
    okLuckyMulti N n wc Q → 1 ≤ N → Function.Injective tags → (∀ s c, (p s c).Bounded D Q) →
    ∀ S : Finset (ℕ × ℕ),
      ∑ ω ∈ Finset.univ.filter (fun ω => jointLuckySet p ω tags G W D Q = S), 2 ^ jointLuckyBits p ω tags G W D ≤
        2 ^ (S.card + 1) * Fintype.card (p3ModelT n wc).Ω


section Count

variable {n wc : ℕ}

/-- XOR by `d`, as a permutation of labels. -/
def xorPerm (d : Lab n wc) : Equiv.Perm (Lab n wc) where
  toFun y := labXor y d
  invFun y := labXor y d
  left_inv y := by funext v j; simp [labXor, Labelling.bxor]
  right_inv y := by funext v j; simp [labXor, Labelling.bxor]

open Classical in
/-- Post-compose `P_t` with XOR by `d`. -/
noncomputable def shiftΩ (t : Tweak n) (d : Lab n wc) (ω : (p3ModelT n wc).Ω) : (p3ModelT n wc).Ω :=
  (ω.1, Function.update ω.2 t (xorPerm d * ω.2 t))

theorem shiftΩ_ne {t t' : Tweak n} (h : t' ≠ t) (d : Lab n wc) (ω : (p3ModelT n wc).Ω) :
    (shiftΩ t d ω).2 t' = ω.2 t' := by
  classical
  simp only [shiftΩ]
  exact Function.update_of_ne h _ _

theorem shiftΩ_self (t : Tweak n) (d y : Lab n wc) (ω : (p3ModelT n wc).Ω) :
    (shiftΩ t d ω).2 t y = labXor (ω.2 t y) d := by
  classical
  simp only [shiftΩ, Function.update_self]
  rfl

theorem shiftΩ_shiftΩ (t : Tweak n) (d : Lab n wc) (ω : (p3ModelT n wc).Ω) : shiftΩ t d (shiftΩ t d ω) = ω := by
  classical
  refine Prod.ext rfl (funext fun t' => ?_)
  by_cases ht : t' = t
  · subst ht
    ext y
    rw [shiftΩ_self, shiftΩ_self]
    simp [labXor, Labelling.bxor]
  · rw [shiftΩ_ne ht, shiftΩ_ne ht]

theorem labXor_eq_iff {a b v : Lab n wc} : labXor a b = v ↔ labXor a v = b := by
  constructor <;> rintro rfl <;> funext i j <;> simp [labXor, Labelling.bxor]

/-- **The shift count.** For `x`, `b` and `C` invariant under the shifts of `P_t`, the event `P_t(x) = b` is exactly a
`1/M` share of `C`. -/
theorem shift_count (t : Tweak n) (x b : (p3ModelT n wc).Ω → Lab n wc) (C : Finset (p3ModelT n wc).Ω)
    (hx : ∀ d ω, x (shiftΩ t d ω) = x ω) (hb : ∀ d ω, b (shiftΩ t d ω) = b ω)
    (hC : ∀ d ω, ω ∈ C → shiftΩ t d ω ∈ C) :
    2 ^ (n * wc) * (C.filter fun ω => ω.2 t (x ω) = b ω).card = C.card := by
  classical
  have hfib : ∀ v : Lab n wc, (C.filter fun ω => labXor (ω.2 t (x ω)) (b ω) = v).card =
      (C.filter fun ω => ω.2 t (x ω) = b ω).card := by
    intro v
    refine Finset.card_bij' (fun ω _ => shiftΩ t v ω) (fun ω _ => shiftΩ t v ω) ?_ ?_ ?_ ?_
    · intro ω hω
      obtain ⟨hC', hv⟩ := Finset.mem_filter.1 hω
      refine Finset.mem_filter.2 ⟨hC v ω hC', ?_⟩
      rw [hx, hb, shiftΩ_self]
      exact labXor_eq_iff.1 hv
    · intro ω hω
      obtain ⟨hC', hv⟩ := Finset.mem_filter.1 hω
      refine Finset.mem_filter.2 ⟨hC v ω hC', ?_⟩
      rw [hx, hb, shiftΩ_self, hv]
      funext i j
      simp only [labXor, Labelling.bxor]
      generalize b ω i j = p
      generalize v i j = q
      cases p <;> cases q <;> rfl
    · intro ω _; exact shiftΩ_shiftΩ t v ω
    · intro ω _; exact shiftΩ_shiftΩ t v ω
  have hsum := Finset.card_eq_sum_card_fiberwise (s := C) (t := Finset.univ)
    (f := fun ω : (p3ModelT n wc).Ω => labXor (ω.2 t (x ω)) (b ω)) fun _ _ => Finset.mem_univ _
  rw [hsum, Finset.sum_congr rfl fun v _ => hfib v, Finset.sum_const, Finset.card_univ, PousKnowledge.card_lab, smul_eq_mul]

end Count


section Instance

variable {wc : ℕ}

/-- The two tags. -/
def tagOf (s : Fin 2) : Bits 256 := fun _ => decide (s = 1)

theorem tagOf_injective : Function.Injective tagOf := by
  intro a b h
  have := congrFun h 0
  fin_cases a <;> fin_cases b <;> simp_all [tagOf]

/-- The other segment. -/
def other (s : Fin 2) : Fin 2 := if s = 0 then 1 else 0

theorem tagOf_other_ne (s : Fin 2) : tagOf (other s) ≠ tagOf s := fun h => by
  have := tagOf_injective h
  fin_cases s <;> simp [other] at this

/-- One node, no edges. -/
def G1 : Labelling.TopoDAG 1 := ⟨fun _ => ∅, fun _ _ h => absurd h (Finset.notMem_empty _)⟩

/-- The all-false label. -/
def zeroL : Lab 1 wc := fun _ _ => false

/-- `W = 0`. -/
def W1 : Fin 2 → Fin 1 → Lab 1 wc := fun _ _ => zeroL

/-- The source key of a segment. -/
def key (τ : Bits 256) : KQ' 1 wc := (τ, 0, 0, fun _ => none)

/-- Round 1: `H` at the other segment's source key. -/
def q1 (s : Fin 2) : (p3ModelT 1 wc).Qry := Sum.inl (key (tagOf (other s)))

/-- Round 2: `P⁻¹` at the other segment's honest input `W ⊕ κ¹ = 0 ⊕ a`. -/
def q2 (s : Fin 2) (a : Lab 1 wc) : (p3ModelT 1 wc).Qry :=
  Sum.inr (Sum.inr ((tagOf (other s), 0, 0), labXor zeroL a))

/-- Round 3: `P` forward at the own tweak and the point `b`. -/
def q3 (s : Fin 2) (b : Lab 1 wc) : (p3ModelT 1 wc).Qry := Sum.inr (Sum.inl ((tagOf s, 0, 0), b))

/-- Segment `s`'s program. -/
def prog (s : Fin 2) : OracleProg (p3ModelT 1 wc) (Lab 1 wc) :=
  .round [q1 s] fun a => .round [q2 s (a.headD zeroL)] fun b => .round [q3 s (b.headD zeroL)] fun _ => .ret zeroL

/-- The family. -/
def pJ : Fin 2 → Fin 1 → OracleProg (p3ModelT 1 wc) (Lab 1 wc) := fun s _ => prog s

/-- Segment `s`'s honest input `x_s = 0 ⊕ κ¹_s`. -/
def Hn (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : Lab 1 wc := labXor zeroL (ω.1 (key (tagOf s)))

/-- Segment `s`'s `z0_s = P_s⁻¹(x_s)`. -/
noncomputable def Z (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : Lab 1 wc := (ω.2 (tagOf s, 0, 0)).symm (Hn s ω)

theorem rounds_prog (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) :
    rounds ((p3ModelT 1 wc).answer ω) (prog s) =
      [[q1 s], [q2 s (ω.1 (key (tagOf (other s))))], [q3 s (Z (other s) ω)]] := rfl

theorem hk1_J (τ : Bits 256) (W : Fin 1 → Lab 1 wc) (ω : (p3ModelT 1 wc).Ω) (w : Fin 1) :
    hk1 τ G1 W ω w = key τ := by
  rw [Fin.fin_one_eq_zero w]
  simp [hk1, key, G1]

theorem hin_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : hin (tagOf s) G1 (W1 s) ω (0, 0) = Hn s ω := by
  simp only [hin, ↓reduceIte]
  unfold in1
  rw [hk1_J]
  rfl

theorem z0_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : z0 (tagOf s) G1 (W1 s) ω (0, 0) = Z s ω := by
  unfold z0
  rw [hin_J]
  rfl

theorem qHit_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) :
    qHit (tagOf s) G1 (W1 s) ω (0, 0) = Sum.inr (Sum.inl ((tagOf s, 0, 0), Z s ω)) := by
  unfold qHit
  rw [z0_J]
  rfl

theorem qInvIn_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) :
    qInvIn (tagOf s) G1 (W1 s) ω (0, 0) = Sum.inr (Sum.inr ((tagOf s, 0, 0), Hn s ω)) := by
  unfold qInvIn
  rw [hin_J]
  rfl


theorem trace_J (s : Fin 2) (c : Fin 1) (ω : (p3ModelT 1 wc).Ω) :
    progTrace ((p3ModelT 1 wc).answer ω) (pJ s c) =
      [q1 s, q2 s (ω.1 (key (tagOf (other s)))), q3 s (Z (other s) ω)] := by
  rw [progTrace_eq_flatten]
  change (rounds _ (prog s)).flatten = _
  rw [rounds_prog]
  rfl

theorem asked_J {s : Fin 2} {ω : (p3ModelT 1 wc).Ω} {q : (p3ModelT 1 wc).Qry} {r : ℕ} (h : Asked (pJ s) ω q r) :
    q = q1 s ∨ q = q2 s (ω.1 (key (tagOf (other s)))) ∨ q = q3 s (Z (other s) ω) := by
  obtain ⟨c, hc⟩ := h
  have hm := mem_progTrace_of_mem_upTo hc
  rw [trace_J] at hm
  simpa using hm

theorem asked_two_J {s : Fin 2} {ω : (p3ModelT 1 wc).Ω} {q : (p3ModelT 1 wc).Qry} (h : Asked (pJ s) ω q 2) :
    q = q1 s ∨ q = q2 s (ω.1 (key (tagOf (other s)))) := by
  obtain ⟨c, hc⟩ := h
  change q ∈ ((rounds _ (prog s)).take 2).flatten at hc
  rw [rounds_prog] at hc
  simpa using hc


/-- **The good event**: the two `z0`s coincide, and neither is its segment's honest input. -/
def Good (ω : (p3ModelT 1 wc).Ω) : Prop := Z 0 ω = Z 1 ω ∧ Z 0 ω ≠ Hn 0 ω ∧ Z 1 ω ≠ Hn 1 ω

theorem good_s {ω : (p3ModelT 1 wc).Ω} (h : Good ω) (s : Fin 2) : Z (other s) ω = Z s ω ∧ Z s ω ≠ Hn s ω := by
  fin_cases s
  · exact ⟨h.1.symm, h.2.1⟩
  · exact ⟨h.1, h.2.2⟩

theorem tweak_tag {τ τ' : Bits 256} {i j : Fin 2} {v v' : Fin 1} (h : ((τ, i, v) : Tweak 1) = (τ', j, v')) :
    τ = τ' ∧ i = j := by
  injection h with h1 h2
  injection h2 with h2
  exact ⟨h1, h2⟩

theorem inl_inj' {k k' : KQ' 1 wc} (h : (Sum.inl k : (p3ModelT 1 wc).Qry) = Sum.inl k') : k = k' := by
  injection h

theorem inl_ne_inr' {k : KQ' 1 wc} {y : (Tweak 1 × Lab 1 wc) ⊕ (Tweak 1 × Lab 1 wc)} :
    (Sum.inl k : (p3ModelT 1 wc).Qry) ≠ Sum.inr y := fun h => by cases h

theorem fwd_ne_inv' {a b : Tweak 1 × Lab 1 wc} :
    (Sum.inr (Sum.inl a) : (p3ModelT 1 wc).Qry) ≠ Sum.inr (Sum.inr b) := fun h => by
  injection h with h; cases h

theorem fwd_inj' {t t' : Tweak 1} {x x' : Lab 1 wc}
    (h : (Sum.inr (Sum.inl (t, x)) : (p3ModelT 1 wc).Qry) = Sum.inr (Sum.inl (t', x'))) : t = t' ∧ x = x' := by
  injection h with h; injection h with h; injection h with h1 h2; exact ⟨h1, h2⟩

theorem inv_inj' {t t' : Tweak 1} {x x' : Lab 1 wc}
    (h : (Sum.inr (Sum.inr (t, x)) : (p3ModelT 1 wc).Qry) = Sum.inr (Sum.inr (t', x'))) : t = t' ∧ x = x' := by
  injection h with h; injection h with h; injection h with h1 h2; exact ⟨h1, h2⟩

/-- No honest query of segment `s` is asked on the good event. -/
theorem no_honest {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) (h : Fin 6 × Fin 1) :
    ¬ ∃ r, Asked (pJ s) ω (honestQ (tagOf s) G1 (W1 s) ω h) r := by
  rintro ⟨r, hr⟩
  obtain ⟨k, v⟩ := h
  have hne := tagOf_other_ne s
  obtain ⟨hZ, hZH⟩ := good_s hg s
  fin_cases k
  · change Asked (pJ s) ω (qH1 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · have := congrArg Prod.fst (inl_inj' e)
      rw [hk1_J] at this
      exact hne this.symm
    · exact inl_ne_inr' e
    · exact inl_ne_inr' e
  · change Asked (pJ s) ω (qH2 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact hne (congrArg Prod.fst (inl_inj' e)).symm
    · exact inl_ne_inr' e
    · exact inl_ne_inr' e
  · change Asked (pJ s) ω (qP1 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact inl_ne_inr' e.symm
    · exact fwd_ne_inv' e
    · have e2 := (fwd_inj' e).2
      unfold in1 at e2
      rw [hk1_J, hZ] at e2
      exact hZH e2.symm
  · change Asked (pJ s) ω (qP2 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact inl_ne_inr' e.symm
    · exact fwd_ne_inv' e
    · exact absurd (tweak_tag (fwd_inj' e).1).2 (by decide)
  · change Asked (pJ s) ω (qI1 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact inl_ne_inr' e.symm
    · exact hne (tweak_tag (inv_inj' e).1).1.symm
    · exact fwd_ne_inv' e.symm
  · change Asked (pJ s) ω (qI2 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact inl_ne_inr' e.symm
    · exact hne (tweak_tag (inv_inj' e).1).1.symm
    · exact fwd_ne_inv' e.symm

/-- Top `0` is in the game at round `3`, from any credits. -/
theorem top_in_game (C : KState 1) : (0 : Fin 1) ∈ (timedReachK G1 C 3).topWhole := by
  have h2 : (0 : Fin 1) ∈ (timedReachK G1 C 2).lowerWhole := by
    show (0 : Fin 1) ∈ (promote (stepTwoK G1 C (timedReachK G1 C 0) (timedReachK G1 C 1))).lowerWhole
    rw [mem_promote_lowerWhole]
    left
    simp [stepTwoK, G1]
  show (0 : Fin 1) ∈ (stepTwoK G1 C (timedReachK G1 C 1) (timedReachK G1 C 2)).topWhole
  simp only [stepTwoK]
  refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, fun w => ?_, Or.inl (by simp [G1])⟩)
  rw [Fin.fin_one_eq_zero w]
  exact Or.inl h2

theorem creditedOut_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : creditedOut (pJ s) ω (tagOf s) G1 (W1 s) 3 = ∅ := by
  classical
  ext u
  simp only [creditedOut, Finset.mem_filter, Finset.mem_univ, true_and, Finset.notMem_empty, iff_false, not_and,
    not_not]
  intro _
  rw [Fin.fin_one_eq_zero u]
  exact top_in_game _

theorem hitsBy_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) :
    hitsBy (pJ s) ω (tagOf s) G1 (W1 s) 3 = {((0 : Fin 2), (0 : Fin 1))} := by
  classical
  obtain ⟨hZ, hZH⟩ := good_s hg s
  have hne := tagOf_other_ne s
  ext ⟨i, v⟩
  rw [Fin.fin_one_eq_zero v]
  simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton, Prod.mk.injEq, and_true]
  fin_cases i
  · simp only [Fin.zero_eta, Fin.isValue, iff_true]
    refine ⟨3, le_rfl, ⟨⟨0, ?_⟩, fun h => ?_⟩, ?_, fun h => ?_⟩
    · rw [qHit_J, ← hZ]
      change _ ∈ ([[q1 s], [q2 s (ω.1 (key (tagOf (other s))))], [q3 s (Z (other s) ω)]].take 3).flatten
      exact List.mem_flatten.2 ⟨[q3 s (Z (other s) ω)], by simp, List.mem_singleton_self _⟩
    · rw [qHit_J] at h
      rcases asked_two_J h with e | e
      · exact inl_ne_inr' e.symm
      · exact fwd_ne_inv' e
    · rw [z0_J, hin_J]; exact hZH
    · rw [qInvIn_J] at h
      rcases asked_two_J h with e | e
      · exact inl_ne_inr' e.symm
      · exact hne (tweak_tag (inv_inj' e).1).1.symm
  · simp only [Fin.mk_one, Fin.isValue, one_ne_zero, iff_false, not_exists, not_and]
    intro r _ hf
    have ha := hf.1.1
    unfold qHit twk at ha
    rcases asked_J ha with e | e | e
    · exact inl_ne_inr' e.symm
    · exact fwd_ne_inv' e
    · exact absurd (tweak_tag (fwd_inj' e).1).2 (by decide)

theorem slot_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) :
    slotOf (pJ s) ω (qHit (tagOf s) G1 (W1 s) ω (0, 0)) = (0, 2) := by
  classical
  have hmem := hitsBy_J hg s
  have ht : ((0 : Fin 2), (0 : Fin 1)) ∈ hitsBy (pJ s) ω (tagOf s) G1 (W1 s) 3 := by rw [hmem]; simp
  have hask : ∃ r, Asked (pJ s) ω (qHit (tagOf s) G1 (W1 s) ω (0, 0)) r := by
    simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht
    obtain ⟨r, -, hr⟩ := ht
    exact ⟨r, hr.1.1⟩
  obtain ⟨c, hc, -⟩ := slotOf_spec (p := pJ s) hask
  rw [hc, Fin.fin_one_eq_zero c, trace_J, qHit_J, ← (good_s hg s).1]
  have h1 : q3 s (Z (other s) ω) ≠ q1 s := fun e => inl_ne_inr' e.symm
  have h2 : q3 s (Z (other s) ω) ≠ q2 s (ω.1 (key (tagOf (other s)))) := fwd_ne_inv'
  refine Prod.ext rfl ?_
  change List.idxOf (q3 s (Z (other s) ω)) [q1 s, q2 s (ω.1 (key (tagOf (other s)))), q3 s (Z (other s) ω)] = 2
  rw [List.idxOf_cons_ne _ h1.symm, List.idxOf_cons_ne _ h2.symm, List.idxOf_cons_self]

theorem luckySet_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) (Q : ℕ) :
    luckySet (pJ s) ω (tagOf s) G1 (W1 s) 3 Q = {(0, 2)} := by
  classical
  have hh : (Finset.univ.filter fun h : Fin 6 × Fin 1 =>
      ∃ r, Asked (pJ s) ω (honestQ (tagOf s) G1 (W1 s) ω h) r) = ∅ :=
    Finset.filter_false_of_mem fun h _ => no_honest hg s h
  unfold luckySet
  rw [hh, hitsBy_J hg s, creditedOut_J, Finset.image_singleton, slot_J hg s]
  simp

theorem luckyBits_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) :
    wc ≤ luckyBits (pJ s) ω (tagOf s) G1 (W1 s) 3 := by
  unfold luckyBits
  rw [hitsBy_J hg s, Finset.card_singleton]
  omega

theorem jointLuckySet_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (Q : ℕ) :
    jointLuckySet pJ ω tagOf G1 W1 3 Q = {(0, 2), (1, 2)} := by
  classical
  unfold jointLuckySet
  simp only [luckySet_J hg, Finset.image_singleton]
  ext x
  simp [jointSlot, Fin.exists_fin_two]

theorem jointLuckyBits_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) : 2 * wc ≤ jointLuckyBits pJ ω tagOf G1 W1 3 := by
  unfold jointLuckyBits
  rw [Fin.sum_univ_two]
  have := luckyBits_J hg 0
  have := luckyBits_J hg 1
  omega

theorem bounded_J (s : Fin 2) (c : Fin 1) : (pJ (wc := wc) s c).Bounded 3 (2 ^ 15) := fun ω =>
  ⟨le_of_eq (show OracleProg.depth ((p3ModelT 1 wc).answer ω) (prog s) = 3 from rfl),
    (show OracleProg.work ((p3ModelT 1 wc).answer ω) (prog s) = 3 from rfl).trans_le (by norm_num)⟩


theorem tweak0_ne : ((tagOf 1, 0, 0) : Tweak 1) ≠ (tagOf 0, 0, 0) := fun h =>
  absurd (tagOf_injective (tweak_tag h).1) (by decide)

theorem Hn_shift (t : Tweak 1) (s : Fin 2) (d : Lab 1 wc) (ω : (p3ModelT 1 wc).Ω) : Hn s (shiftΩ t d ω) = Hn s ω :=
  rfl

theorem Z1_shift0 (d : Lab 1 wc) (ω : (p3ModelT 1 wc).Ω) : Z 1 (shiftΩ (tagOf 0, 0, 0) d ω) = Z 1 ω := by
  unfold Z
  rw [Hn_shift, shiftΩ_ne tweak0_ne]

/-- `Z 1 = y` is a `1/M` share of `Ω`, for `y` not reading `P_{t_1}`. -/
theorem card_Z1_eq (y : (p3ModelT 1 wc).Ω → Lab 1 wc) (hy : ∀ d ω, y (shiftΩ (tagOf 1, 0, 0) d ω) = y ω) :
    2 ^ (1 * wc) * (Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => Z 1 ω = y ω).card =
      Fintype.card (p3ModelT 1 wc).Ω := by
  classical
  have := shift_count (tagOf 1, 0, 0) y (Hn 1) Finset.univ hy (fun d ω => Hn_shift _ 1 d ω)
    (fun _ _ _ => Finset.mem_univ _)
  rw [Finset.card_univ] at this
  have hc : (Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => Z 1 ω = y ω) =
      Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => ω.2 (tagOf 1, 0, 0) (y ω) = Hn 1 ω :=
    Finset.filter_congr fun ω _ => by
      unfold Z
      rw [Equiv.symm_apply_eq]
      exact eq_comm
  rw [hc]
  exact this

/-- **The good event is large**: `M²·|E| ≥ (M − 2)·|Ω|`. -/
theorem card_good :
    ∃ E : Finset (p3ModelT 1 wc).Ω, (∀ ω ∈ E, Good ω) ∧
      (2 ^ (1 * wc) - 2) * Fintype.card (p3ModelT 1 wc).Ω ≤ 2 ^ (1 * wc) * 2 ^ (1 * wc) * E.card := by
  classical
  set M := 2 ^ (1 * wc) with hM
  set Gs : Finset (p3ModelT 1 wc).Ω := Finset.univ.filter fun ω => Z 1 ω ≠ Hn 0 ω ∧ Z 1 ω ≠ Hn 1 ω with hGs
  refine ⟨Gs.filter fun ω => ω.2 (tagOf 0, 0, 0) (Z 1 ω) = Hn 0 ω, ?_, ?_⟩
  · intro ω hω
    obtain ⟨hG, hB⟩ := Finset.mem_filter.1 hω
    obtain ⟨h0, h1⟩ := (Finset.mem_filter.1 hG).2
    have hZ : Z 0 ω = Z 1 ω := by
      unfold Z
      rw [Equiv.symm_apply_eq]
      exact hB.symm
    exact ⟨hZ, hZ ▸ h0, h1⟩
  · have hcount := shift_count (tagOf 0, 0, 0) (Z 1) (Hn 0) Gs (fun d ω => Z1_shift0 d ω)
      (fun d ω => Hn_shift _ 0 d ω) (fun d ω hω => by
        simp only [hGs, Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
        rw [Z1_shift0, Hn_shift, Hn_shift]
        exact hω)
    have hb0 := card_Z1_eq (wc := wc) (Hn 0) (fun d ω => Hn_shift _ 0 d ω)
    have hb1 := card_Z1_eq (wc := wc) (Hn 1) (fun d ω => Hn_shift _ 1 d ω)
    have hcov : Fintype.card (p3ModelT 1 wc).Ω ≤ Gs.card +
        (Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => Z 1 ω = Hn 0 ω).card +
          (Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => Z 1 ω = Hn 1 ω).card := by
      rw [← Finset.card_univ]
      refine (Finset.card_le_card fun ω _ => ?_).trans
        ((Finset.card_union_le _ _).trans (Nat.add_le_add_right (Finset.card_union_le _ _) _))
      by_cases h0 : Z 1 ω = Hn 0 ω
      · exact Finset.mem_union_left _ (Finset.mem_union_right _ (by simp [h0]))
      · by_cases h1 : Z 1 ω = Hn 1 ω
        · exact Finset.mem_union_right _ (by simp [h1])
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ (by simp [hGs, h0, h1]))
    rw [mul_assoc, hcount]
    have := Nat.mul_le_mul_left M hcov
    rw [mul_add, mul_add, hb0, hb1] at this
    rw [Nat.sub_mul]
    omega


/-- **`JointClassWeight` is false**, at `N = 2`, `n = 1`, `wc = 24`, `D = 3`, `Q = 2^15`. -/
theorem not_jointClassWeight : ¬ JointClassWeight := by
  classical
  intro h
