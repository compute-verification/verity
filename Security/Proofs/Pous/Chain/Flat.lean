/-! ════ P3ConcreteMulti.JointCharges ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete LazyPerm
open scoped ENNReal

noncomputable section

variable {N n wc : ℕ}


/-- **The joint strategy truncated after `c` schedule steps**: the joint schedule's first `c` queries, then all `N`
labellers (`stratC`'s joint counterpart). -/
def jointStratC (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D c : ℕ) : Strategy (P3Alpha n wc) where
  next h := if h.length < c then (jointStrategy A tags G W D).next h else tailOf (labProgJ tags G W) h

/-- **A strategy that switches to `tailOf p` at length `c`** holds at most `c + work(p)` entries: past `c`, each step
adds a new query of `p`'s true trace. -/
theorem tailOf_length_le (S : Strategy (P3Alpha n wc)) (p : OracleProg (p3ChainModel n wc) Unit) (c : ℕ)
    (hS : ∀ h : History (P3Alpha n wc), c ≤ h.length → S.next h = tailOf p h) (π : Oracle (P3Alpha n wc)) (j : ℕ) :
    (S.hist π j).length ≤ c + p.work (trueAns π) := by
  classical
  set T := (Tr.trace (trueAns π) p).map Prod.snd
  have hinv : ∀ j, (S.hist π j).length ≤ c ∨ ∃ (pre : History (P3Alpha n wc)) (tq : List (p3ChainModel n wc).Qry),
      S.hist π j = pre ++ tq.map (qEntry π (enc n wc)) ∧ pre.length = c ∧ tq.Nodup ∧ ∀ q ∈ tq, q ∈ T := by
    intro j
    induction j with
    | zero => exact Or.inl (by simp [Strategy.hist])
    | succ j ih =>
      cases hnext : S.next (S.hist π j) with
      | none => rw [S.hist_succ_of_none hnext]; exact ih
      | some x =>
        rw [S.hist_succ_of_some hnext]
        by_cases hlt : (S.hist π j).length < c
        · left
          rw [List.length_append, List.length_singleton]
          omega
        right
        obtain ⟨pre, tq, hh, hpre, hnd, hsub⟩ : ∃ (pre : History (P3Alpha n wc)) (tq : List (p3ChainModel n wc).Qry),
            S.hist π j = pre ++ tq.map (qEntry π (enc n wc)) ∧ pre.length = c ∧ tq.Nodup ∧ ∀ q ∈ tq, q ∈ T := by
          rcases ih with h | h
          · exact ⟨S.hist π j, [], by simp, by omega, List.nodup_nil, fun q hq => absurd hq List.not_mem_nil⟩
          · exact h
        rw [hS _ (by omega)] at hnext
        obtain ⟨q, rfl, hqT, hnew⟩ := tailOf_some p (S.hist π j) (fun e he => S.mem_hist he) hnext
        have hqtq : q ∉ tq := by
          intro hq
          have hmem : qEntry π (enc n wc) q ∈ S.hist π j := by
            rw [hh]
            exact List.mem_append_right _ (List.mem_map_of_mem hq)
          exact (histAns_none_iff _ _).1 hnew _ hmem rfl
        refine ⟨pre, tq ++ [q], ?_, hpre, hnd.append (List.nodup_singleton q) (List.disjoint_singleton.2 hqtq),
          fun q' hq' => ?_⟩
        · rw [hh]
          simp only [List.map_append, List.map_cons, List.map_nil, List.append_assoc]
          rfl
        · rcases List.mem_append.1 hq' with h1 | h1
          · exact hsub q' h1
          · rw [List.mem_singleton.1 h1]; exact hqT
  rcases hinv j with h | ⟨pre, tq, hh, hpre, hnd, hsub⟩
  · omega
  · rw [hh, List.length_append, List.length_map, hpre]
    have hle : tq.length ≤ T.length := by
      rw [← List.toFinset_card_of_nodup hnd]
      exact (Finset.card_le_card fun q hq => List.mem_toFinset.2 (hsub q (List.mem_toFinset.1 hq))).trans
        (List.toFinset_card_le _)
    have hT : T.length = p.work (trueAns π) := by rw [List.length_map, Tr.length_trace]
    omega

/-- **The truncated joint strategy holds at most `N·nPosC` entries** for `c ≤ N·n·Q`. -/
theorem jointStratC_length_le (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q c : ℕ) (hc : c ≤ N * n * Q) (π : Oracle (P3Alpha n wc))
    (j : ℕ) : ((jointStratC A tags G W D c).hist π j).length ≤ N * nPosC n Q := by
  refine (tailOf_length_le _ (labProgJ tags G W) c (fun h hh => ?_) π j).trans ?_
  · show (if h.length < c then _ else _) = _
    simp only [show ¬ h.length < c by omega, ↓reduceIte]
  · have h2 := work_labProgJ (trueAns π) tags G W
    unfold nPosC
    have : N * n * Q ≤ N * (n * (Q + 1)) := by
      rw [Nat.mul_assoc]; exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
    have e : N * (n * (Q + 1) + n * (n + 1) + 2 * n) = N * (n * (Q + 1)) + N * (n * (n + 1) + 2 * n) := by ring
    omega

/-- **`h_lt` for the truncated joint strategy**: every step that asks a query is below `N·nPosC`. -/
theorem jointStratC_step_lt (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q c : ℕ) (hc : c ≤ N * n * Q) {π : Oracle (P3Alpha n wc)}
    {j : ℕ} {q : Qry (P3Alpha n wc)} (h : (jointStratC A tags G W D c).next ((jointStratC A tags G W D c).hist π j) = some q) :
    j < N * nPosC n Q :=
  step_lt_of_length_le _ π _ (jointStratC_length_le A tags G W D Q c hc π) h


/-- **The joint compression under (C1) and the multi (C2)**: `JointFreshTail` with `(2·N·nPosC)^40 ≤ 2^wc`. -/
def JointFreshTail2 : Prop :=
  ∀ (N n wc D Q s : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → (2 * (N * nPosC n Q)) ^ 40 ≤ 2 ^ wc → 1 ≤ N →
    Function.Injective tags → (∀ t v, (A t v).Bounded D Q) → s ≤ n →
    pr (fun ω => (∀ t : Fin N, (s : ℚ) * n ≤ ((segReplay A tags G W D Q t).onlineH ω (D + 1)).size 512 wc) ∧
        ¬ JBad tags G W ω)
      ≤ (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (s - 1) * (n * wc))

/-- **What the one-segment count must deliver for each segment of the joint run.**

For a fixed family and saving `s ≤ n`, with the cut `c` and the segment `t` as parameters, on the truncated joint
strategy `jointStratC A tags G W D c`:
- **Tables** `Sig` (finite), each with its number `whole σ` of whole credits. A table lists every credit of its
  segment up to the cut: at most `3n` thin groups and `whole σ` whole credits, each slot a slot name
  (`4n² + 12n + 4` of them) and a step `≤ N·nPosC`. So at most
  `((4n²+12n+4)·(N·nPosC+1))^{3n+k}` tables have `whole σ = k`.
- **Kinds** `K`, with `0 < |K| ≤ 16n³ + 16`, and widths `w κ ≥ wc` (so `h2` is (C1)).
- **Uniform targets** `T c t σ κ h q` in `pin_mul_le` form at `nPos = N·nPosC` (`card_agreeSet`).
- **Charged steps** `I`, with `OnFresh c t σ` and `name c t σ`:
  - distinct steps within a segment, and across segments off `JBad`;
  - `h_fresh` and `h_target` on `jointStratC c`, at the named step.
- **The win.** Every segment priced at least `s·n` off `JBad` gives **one cut `c ≤ N·n·Q` for all segments**
  (where the last one crosses). Each segment then has its realized table `σ` and at most `4n + 3·whole σ` charged
  steps, of total width at least `wc·n·max(s, whole σ)`. `ι` charges every credit of the table, and every whole
  credit is at least `n` columns.

`h_lt` is not asked: it is `jointStratC_step_lt`. The segment is carried in the joint kind, and the cut union, the
class union and the arithmetic are done here (`jointFreshTail2_of_segCharges`). -/
def P3SegCharges : Prop :=
  ∀ (N n wc D Q s : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → (2 * (N * nPosC n Q)) ^ 40 ≤ 2 ^ wc → 1 ≤ N →
    Function.Injective tags → (∀ t v, (A t v).Bounded D Q) → s ≤ n →
    ∃ (Sig : Type) (_ : Fintype Sig) (whole : Sig → ℕ) (K : Type) (_ : Fintype K) (_ : DecidableEq K) (w : K → ℕ)
      (I : Type)
      (T : ℕ → Fin N → Sig → K → History (P3Alpha n wc) → (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1))
      (OnFresh : ℕ → Fin N → Sig → Oracle (P3Alpha n wc) → I → Prop)
      (name : ℕ → Fin N → Sig → Oracle (P3Alpha n wc) → I → ℕ × K),
      -- the tables, per whole-credit count
      (∀ k, (Finset.univ.filter fun σ => whole σ = k).card ≤
        ((4 * n ^ 2 + 12 * n + 4) * (N * nPosC n Q + 1)) ^ (3 * n + k)) ∧
      -- the kinds and widths
      0 < Fintype.card K ∧ Fintype.card K ≤ 16 * n ^ 3 + 16 ∧ (∀ κ, wc ≤ w κ) ∧
      -- `hT`, at `nPos = N·nPosC`
      (∀ c t σ κ h q, (T c t σ κ h q).card * (2 ^ w κ - N * nPosC n Q) ≤
        Fintype.card (P3Alpha n wc q.1) - N * nPosC n Q) ∧
      -- distinct steps within a segment
      (∀ c t σ π x y, OnFresh c t σ π x → OnFresh c t σ π y → x ≠ y → (name c t σ π x).1 ≠ (name c t σ π y).1) ∧
      -- distinct steps across segments, off `JBad`
      (∀ c t t' σ σ' π x y, t ≠ t' → ¬ JBad tags G W ((omegaEquiv n wc).symm π) → OnFresh c t σ π x →
        OnFresh c t' σ' π y → (name c t σ π x).1 ≠ (name c t' σ' π y).1) ∧
      -- `h_fresh`
      (∀ c t σ π x, OnFresh c t σ π x →
        ∃ q, (jointStratC A tags G W D c).next ((jointStratC A tags G W D c).hist π (name c t σ π x).1) = some q ∧
          Fresh ((jointStratC A tags G W D c).hist π (name c t σ π x).1) q) ∧
      -- `h_target`
      (∀ c t σ π x q, OnFresh c t σ π x →
        (jointStratC A tags G W D c).next ((jointStratC A tags G W D c).hist π (name c t σ π x).1) = some q →
          ans π q ∈ T c t σ (name c t σ π x).2 ((jointStratC A tags G W D c).hist π (name c t σ π x).1) q) ∧
      -- the win: one cut for all segments, and each segment's charged steps
      (∀ π, ((∀ t : Fin N, (s : ℚ) * n ≤
            ((segReplay A tags G W D Q t).onlineH ((omegaEquiv n wc).symm π) (D + 1)).size 512 wc) ∧
          ¬ JBad tags G W ((omegaEquiv n wc).symm π)) →
        ∃ c ≤ N * n * Q, ∀ t, ∃ σ, ∃ X : Finset I, (∀ x ∈ X, OnFresh c t σ π x) ∧
          X.card ≤ 4 * n + 3 * whole σ ∧ wc * n * max s (whole σ) ≤ ∑ x ∈ X, w (name c t σ π x).2)


section Tables

variable {Sig : Type} (whole : Sig → ℕ)

/-- The joint tables of a class profile `p`: one table per segment, segment `t`'s with `p t` whole credits. -/
def SigP (p : Fin N → ℕ) : Type := {σ : Fin N → Sig // ∀ t, whole (σ t) = p t}

noncomputable instance instFintypeSigP [Fintype Sig] (p : Fin N → ℕ) : Fintype (SigP whole p) := by
  classical
  unfold SigP
  infer_instance

theorem card_sigP_le [Fintype Sig] (p : Fin N → ℕ) (Z n : ℕ)
    (hZ : ∀ k, (Finset.univ.filter fun σ => whole σ = k).card ≤ Z ^ (3 * n + k)) :
    Fintype.card (SigP whole p) ≤ ∏ t, Z ^ (3 * n + p t) := by
  classical
  have e : Fintype.card (SigP whole p) = ∏ t, (Finset.univ.filter fun σ => whole σ = p t).card := by
    unfold SigP
    rw [Fintype.card_congr (Equiv.subtypePiEquivPi (p := fun t σ => whole σ = p t)), Fintype.card_pi]
    exact Finset.prod_congr rfl fun t _ => Fintype.card_subtype _
  rw [e]
  exact Finset.prod_le_prod fun t _ => hZ (p t)

end Tables


section Arith

theorem pow_15_le {n B : ℕ} (hn : 1 ≤ n) (hB : 10 ≤ B) : 2 ^ (15 * n + 2) ≤ B ^ (6 * n) := by
  have h30 : 4 ≤ 30 ^ n := le_trans (by norm_num) (Nat.pow_le_pow_right (by norm_num) hn : 30 ^ 1 ≤ 30 ^ n)
  calc 2 ^ (15 * n + 2) = 4 * 32768 ^ n := by rw [pow_add, pow_mul]; norm_num [mul_comm]
    _ ≤ 30 ^ n * 32768 ^ n := Nat.mul_le_mul_right _ h30
    _ = (30 * 32768) ^ n := (mul_pow _ _ _).symm
    _ ≤ (10 ^ 6) ^ n := Nat.pow_le_pow_left (by norm_num) _
    _ = 10 ^ (6 * n) := by rw [← pow_mul]
    _ ≤ B ^ (6 * n) := Nat.pow_le_pow_left hB _

theorem one_le_two_pow_mul_inv (a b : ℕ) (h : b ≤ a) : (1 : ℝ≥0∞) ≤ 2 ^ a * (2⁻¹ : ℝ≥0∞) ^ b := by
  calc (1 : ℝ≥0∞) = 2 ^ b * (2⁻¹ : ℝ≥0∞) ^ b := by rw [PousP3Base.two_pow_mul_inv_pow b b le_rfl, Nat.sub_self, pow_zero]
    _ ≤ 2 ^ a * (2⁻¹ : ℝ≥0∞) ^ b := by gcongr; norm_num

/-- **One class term.** -/
theorem term_le {n s wc Z Y B : ℕ} (k : ℕ) (hZ : Z ≤ B ^ 3) (hY : Y ≤ B ^ 5) (hB : 1 ≤ B)
    (hr : 2 * B ^ 18 ≤ 2 ^ (wc * n)) :
    ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s k) ≤
      ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * (2⁻¹ : ℝ≥0∞) ^ (k + 1) := by
  have hZY : ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) ≤
      ((B ^ (29 * n + 18 * k) : ℕ) : ℝ≥0∞) := by
    have : Z ^ (3 * n + k) * Y ^ (4 * n + 3 * k) ≤ B ^ (29 * n + 18 * k) :=
      calc Z ^ (3 * n + k) * Y ^ (4 * n + 3 * k) ≤ (B ^ 3) ^ (3 * n + k) * (B ^ 5) ^ (4 * n + 3 * k) :=
            Nat.mul_le_mul (Nat.pow_le_pow_left hZ _) (Nat.pow_le_pow_left hY _)
        _ = B ^ (29 * n + 18 * k) := by rw [← pow_mul, ← pow_mul, ← pow_add]; ring_nf
    exact_mod_cast this
  rcases le_or_gt k s with hks | hks
  · rw [max_eq_left hks]
    have hB' : ((B ^ (29 * n + 18 * k) : ℕ) : ℝ≥0∞) ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) := by
      exact_mod_cast Nat.pow_le_pow_right hB (by omega)
    calc ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)
        ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * 1 := by
          rw [mul_one]; gcongr; exact hZY.trans hB'
      _ ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) *
            (2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (k + 1)) := by
          gcongr; exact one_le_two_pow_mul_inv _ _ (by omega)
      _ = _ := by ring
  · rw [max_eq_right hks.le]
    obtain ⟨d, rfl⟩ : ∃ d, k = s + d + 1 := ⟨k - s - 1, by omega⟩
    have hq : ((B ^ 18 : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n) ≤ 2⁻¹ := by
      have h1 : ((B ^ 18 : ℕ) : ℝ≥0∞) ≤ 2⁻¹ * 2 ^ (wc * n) := by
        have : ((2 * B ^ 18 : ℕ) : ℝ≥0∞) ≤ 2 ^ (wc * n) := by exact_mod_cast hr
        calc ((B ^ 18 : ℕ) : ℝ≥0∞) = 2⁻¹ * ((2 * B ^ 18 : ℕ) : ℝ≥0∞) := by
              push_cast
              rw [← mul_assoc, ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top, one_mul]
          _ ≤ 2⁻¹ * 2 ^ (wc * n) := by gcongr
      calc ((B ^ 18 : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n) ≤ 2⁻¹ * 2 ^ (wc * n) * (2⁻¹ : ℝ≥0∞) ^ (wc * n) := by
            gcongr
        _ = 2⁻¹ := by
            rw [mul_assoc, PousP3Base.two_pow_mul_inv_pow _ _ le_rfl, Nat.sub_self, pow_zero, mul_one]
    have hsplit : ((B ^ (29 * n + 18 * (s + d + 1)) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * (s + d + 1)) =
        ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) *
          (((B ^ 18 : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n)) ^ (d + 1) := by
      push_cast
      rw [mul_pow, ← pow_mul, ← pow_mul]
      rw [show 29 * n + 18 * (s + d + 1) = (29 * n + 18 * s) + 18 * (d + 1) by ring,
        show wc * n * (s + d + 1) = wc * n * s + wc * n * (d + 1) by ring, pow_add, pow_add]
      ring
    have hrhs : (2 : ℝ≥0∞) ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (s + d + 1 + 1) = (2⁻¹ : ℝ≥0∞) ^ (d + 1) := by
      rw [PousP3Base.two_pow_mul_inv_pow _ _ (by omega)]
      congr 1
      omega
    calc ((Z ^ (3 * n + (s + d + 1)) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * (s + d + 1)) : ℕ) : ℝ≥0∞) *
          (2⁻¹ : ℝ≥0∞) ^ (wc * n * (s + d + 1))
        ≤ ((B ^ (29 * n + 18 * (s + d + 1)) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * (s + d + 1)) := by gcongr
      _ = ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) *
            (((B ^ 18 : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n)) ^ (d + 1) := hsplit
      _ ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * (2⁻¹ : ℝ≥0∞) ^ (d + 1) := by
          gcongr
      _ = _ := by rw [← hrhs]; ring

theorem sum_inv_two_succ_le (m : ℕ) : ∑ k ∈ Finset.range m, (2⁻¹ : ℝ≥0∞) ^ (k + 1) ≤ 1 := by
  calc ∑ k ∈ Finset.range m, (2⁻¹ : ℝ≥0∞) ^ (k + 1) = 2⁻¹ * ∑ k ∈ Finset.range m, (2⁻¹ : ℝ≥0∞) ^ k := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun k _ => by ring
    _ ≤ 2⁻¹ * ∑' k, (2⁻¹ : ℝ≥0∞) ^ k := by gcongr; exact ENNReal.sum_le_tsum _
    _ = 1 := by
        rw [ENNReal.tsum_geometric, ENNReal.one_sub_inv_two, inv_inv,
          ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top]

/-- **One segment's sum over the classes.** -/
theorem seg_sum_le {n s wc Z Y B : ℕ} (Kmax : ℕ) (hZ : Z ≤ B ^ 3) (hY : Y ≤ B ^ 5) (hB : 1 ≤ B)
    (hr : 2 * B ^ 18 ≤ 2 ^ (wc * n)) :
    ∑ k ∈ Finset.range (Kmax + 1),
        ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s k) ≤
      ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) := by
  calc _ ≤ ∑ k ∈ Finset.range (Kmax + 1), ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) *
          (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * (2⁻¹ : ℝ≥0∞) ^ (k + 1) :=
        Finset.sum_le_sum fun k _ => term_le k hZ hY hB hr
    _ = ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) *
          ∑ k ∈ Finset.range (Kmax + 1), (2⁻¹ : ℝ≥0∞) ^ (k + 1) := by rw [Finset.mul_sum]
    _ ≤ _ := by
        calc _ ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * 1 := by
              gcongr; exact sum_inv_two_succ_le _
          _ = _ := mul_one _

/-- **The ℕ core of the fit**: `(C+1)·2·(B^{47n}·2^{n+1})^N ≤ N·P^{14nN}·2^{N·n·wc}` with `B = 2P`. -/
theorem joint_final_nat {N n wc P Cmax : ℕ} (hN : 1 ≤ N) (hn : 1 ≤ n) (hB : 10 ≤ 2 * P) (hC : Cmax + 1 ≤ 2 * P)
    (hC2 : (2 * P) ^ 40 ≤ 2 ^ wc) :
    (Cmax + 1) * 2 * ((2 * P) ^ (47 * n) * 2 ^ (n + 1)) ^ N ≤ N * P ^ (14 * n * N) * 2 ^ (N * (n * wc)) := by
  have hPB : P ^ (14 * n * N) * 2 ^ (14 * n * N) = (2 * P) ^ (14 * n * N) := by rw [mul_pow]; ring
  generalize hBdef : 2 * P = B at hB hC hC2 hPB ⊢
  have hB1 : 1 ≤ B := by omega
  have h15 := pow_15_le hn hB
  have hnN : 1 ≤ n * N := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
  refine le_of_mul_le_mul_right ?_ (by positivity : 0 < 2 ^ (14 * n * N))
  have e1 : (2 : ℕ) ^ (15 * n + 1) = 2 ^ (n + 1) * 2 ^ (14 * n) := by rw [← pow_add]; ring_nf
  have hL : (Cmax + 1) * 2 * (B ^ (47 * n) * 2 ^ (n + 1)) ^ N * 2 ^ (14 * n * N) ≤ B ^ (54 * n * N) :=
    calc (Cmax + 1) * 2 * (B ^ (47 * n) * 2 ^ (n + 1)) ^ N * 2 ^ (14 * n * N)
        = (Cmax + 1) * B ^ (47 * n * N) * (2 * (2 ^ (15 * n + 1)) ^ N) := by
          rw [e1, mul_pow (2 ^ (n + 1)) (2 ^ (14 * n)) N, ← pow_mul 2 (14 * n) N, mul_pow (B ^ (47 * n)) (2 ^ (n + 1)) N,
            ← pow_mul B (47 * n) N]
          ring
      _ ≤ B * B ^ (47 * n * N) * (2 ^ (15 * n + 2)) ^ N := by
          gcongr
          calc 2 * (2 ^ (15 * n + 1)) ^ N ≤ 2 ^ N * (2 ^ (15 * n + 1)) ^ N :=
                Nat.mul_le_mul_right _ (by calc 2 = 2 ^ 1 := rfl
                                              _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN)
            _ = (2 ^ (15 * n + 2)) ^ N := by rw [← mul_pow, ← pow_succ']
      _ ≤ B ^ (n * N) * B ^ (47 * n * N) * (B ^ (6 * n)) ^ N := by
          gcongr
          calc B = B ^ 1 := (pow_one B).symm
            _ ≤ B ^ (n * N) := Nat.pow_le_pow_right hB1 hnN
      _ = B ^ (54 * n * N) := by rw [← pow_mul, ← pow_add, ← pow_add]; ring_nf
  have hR : B ^ (54 * n * N) ≤ N * P ^ (14 * n * N) * 2 ^ (N * (n * wc)) * 2 ^ (14 * n * N) :=
    calc B ^ (54 * n * N) = 1 * (B ^ (14 * n * N) * (B ^ 40) ^ (n * N)) := by
          rw [one_mul, ← pow_mul, ← pow_add]; ring_nf
      _ ≤ N * (B ^ (14 * n * N) * (2 ^ wc) ^ (n * N)) := by gcongr
      _ = N * P ^ (14 * n * N) * 2 ^ (N * (n * wc)) * 2 ^ (14 * n * N) := by
          rw [← hPB, ← pow_mul]; ring_nf
  exact hL.trans hR

/-- **The fit in `ℝ≥0∞`**: the cut union of the product of the segment sums is within the joint target. -/
theorem joint_final {N n wc s P Cmax : ℕ} (hN : 1 ≤ N) (hn : 1 ≤ n) (hs : 1 ≤ s) (hsn : s ≤ n) (hB : 10 ≤ 2 * P)
    (hC : Cmax + 1 ≤ 2 * P) (hC2 : (2 * P) ^ 40 ≤ 2 ^ wc) :
    ((Cmax + 1 : ℕ) : ℝ≥0∞) * (2 * (((2 * P) ^ (29 * n + 18 * s) : ℕ) * 2 ^ (s + 1) *
        (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)) ^ N) ≤
      (N : ℝ≥0∞) * ((P ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (s - 1) * (n * wc)) := by
  have hX : (((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) ≤
      (((2 * P) ^ (47 * n) * 2 ^ (n + 1) : ℕ) : ℝ≥0∞) := by
    have : (2 * P) ^ (29 * n + 18 * s) * 2 ^ (s + 1) ≤ (2 * P) ^ (47 * n) * 2 ^ (n + 1) :=
      Nat.mul_le_mul (Nat.pow_le_pow_right (by omega) (by omega)) (Nat.pow_le_pow_right (by norm_num) (by omega))
    exact_mod_cast this
  have hnat := joint_final_nat (Cmax := Cmax) hN hn hB hC hC2
  have hnat' : ((((Cmax + 1) * 2 * ((2 * P) ^ (47 * n) * 2 ^ (n + 1)) ^ N : ℕ)) : ℝ≥0∞) ≤
      (N : ℝ≥0∞) * ((P ^ (14 * n * N) : ℕ) : ℝ≥0∞) * 2 ^ (N * (n * wc)) := by exact_mod_cast hnat
  have hexp : wc * n * s * N = N * (n * wc) + N * (s - 1) * (n * wc) := by
    obtain ⟨s', rfl⟩ : ∃ s', s = s' + 1 := ⟨s - 1, by omega⟩
    rw [Nat.add_sub_cancel]; ring
  calc ((Cmax + 1 : ℕ) : ℝ≥0∞) * (2 * (((2 * P) ^ (29 * n + 18 * s) : ℕ) * 2 ^ (s + 1) *
        (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)) ^ N)
      = ((Cmax + 1 : ℕ) : ℝ≥0∞) * 2 * ((((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1)) ^ N *
          (2⁻¹ : ℝ≥0∞) ^ (wc * n * s * N) := by rw [mul_pow, pow_mul]; ring
    _ ≤ ((Cmax + 1 : ℕ) : ℝ≥0∞) * 2 * ((((2 * P) ^ (47 * n) * 2 ^ (n + 1) : ℕ) : ℝ≥0∞)) ^ N *
          (2⁻¹ : ℝ≥0∞) ^ (wc * n * s * N) := by gcongr
    _ = ((((Cmax + 1) * 2 * ((2 * P) ^ (47 * n) * 2 ^ (n + 1)) ^ N : ℕ)) : ℝ≥0∞) *
          ((2⁻¹ : ℝ≥0∞) ^ (N * (n * wc)) * (2⁻¹ : ℝ≥0∞) ^ (N * (s - 1) * (n * wc))) := by
          rw [hexp, pow_add]; push_cast; ring
    _ ≤ (N : ℝ≥0∞) * ((P ^ (14 * n * N) : ℕ) : ℝ≥0∞) * 2 ^ (N * (n * wc)) *
          ((2⁻¹ : ℝ≥0∞) ^ (N * (n * wc)) * (2⁻¹ : ℝ≥0∞) ^ (N * (s - 1) * (n * wc))) := by gcongr
    _ = (N : ℝ≥0∞) * ((P ^ (14 * n * N) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (N * (s - 1) * (n * wc)) := by
          rw [← mul_assoc, mul_assoc _ (2 ^ (N * (n * wc))), PousP3Base.two_pow_mul_inv_pow _ _ le_rfl, Nat.sub_self,
            pow_zero, mul_one]
    _ = _ := by rw [div_eq_mul_inv, ENNReal.inv_pow]

end Arith


/-- **`JointFreshTail2` from `P3SegCharges`.** A union over the joint cut `c ≤ N·n·Q` and over the class profile
`p` (each segment's number of whole credits), then `Strategy.prob_fresh_slots_le` on `jointStratC c` for the joint
tables of class `p`, then the arithmetic (`seg_sum_le`, `joint_final`). -/
theorem jointFreshTail2_of_segCharges (h : P3SegCharges) : JointFreshTail2 := by
  classical
  intro N n wc D Q s tags G W A hn hwc hn255 hC1 hC2 hN htags hA hsn
  rcases Nat.eq_zero_or_pos s with rfl | hs
  · rw [pr_eq_prob]
    refine (prob_le_one' _).trans ?_
    rw [show N * (0 - 1) * (n * wc) = 0 by simp, pow_zero, div_one]
    have h1 : (1 : ℝ≥0∞) ≤ (N : ℝ≥0∞) := by exact_mod_cast hN
    have h2 : (1 : ℝ≥0∞) ≤ (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) := by
      exact_mod_cast Nat.one_le_pow _ _ (nPosCJ_pos hN hn)
    calc (1 : ℝ≥0∞) = 1 * 1 := (one_mul 1).symm
      _ ≤ _ := mul_le_mul' h1 h2
  obtain ⟨Sig, hSf, whole, K, hKf, hKd, w, I, T, OnFresh, name, hZ, hK0, hK, hw, hT, hdist, hcross, hfresh,
    htarget, hwin⟩ := h N n wc D Q s tags G W A hn hwc hn255 hC1 hC2 hN htags hA hsn
  let _ := hSf
  let _ := hKf
  let _ := hKd
  set P := N * nPosC n Q with hPdef
  -- sizes
  have hnP : n * n + 4 * n ≤ nPosC n Q := by unfold nPosC; nlinarith
  have hPn : n * (Q + 1) + 1 ≤ nPosC n Q := by unfold nPosC; nlinarith
  have hNP : N ≤ P := Nat.le_mul_of_pos_right _ (by omega)
  have hP1 : n * n ≤ P := (by omega : n * n ≤ nPosC n Q).trans (Nat.le_mul_of_pos_left _ (by omega))
  have hPn1 : n ≤ P := (by nlinarith : n ≤ n * n).trans hP1
  have hB10 : 10 ≤ 2 * P := by
    have : 5 ≤ nPosC n Q := by nlinarith
    have : nPosC n Q ≤ P := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have hCmax : N * n * Q + 1 ≤ 2 * P := by
    have : N * n * Q + 1 ≤ P := by
      rw [hPdef]
      nlinarith
    omega
  have hcardK : Fintype.card (Fin N × K) = N * Fintype.card K := by rw [Fintype.card_prod, Fintype.card_fin]
  set Z := (4 * n ^ 2 + 12 * n + 4) * (P + 1) with hZdef
  set Y := 2 * (P * Fintype.card (Fin N × K)) with hYdef
  have hZB : Z ≤ (2 * P) ^ 3 := by
    have h20 : 4 * n ^ 2 + 12 * n + 4 ≤ 20 * P := by nlinarith
    calc Z ≤ 20 * P * (2 * P) := Nat.mul_le_mul h20 (by omega)
      _ = 10 * (2 * P) ^ 2 := by ring
      _ ≤ (2 * P) * (2 * P) ^ 2 := Nat.mul_le_mul_right _ hB10
      _ = (2 * P) ^ 3 := by ring
  have hYB : Y ≤ (2 * P) ^ 5 := by
    have hn3 : n ^ 3 ≤ P ^ 2 := by
      calc n ^ 3 = n * (n * n) := by ring
        _ ≤ P * P := Nat.mul_le_mul hPn1 hP1
        _ = P ^ 2 := by ring
    have hK' : Fintype.card K ≤ 32 * P ^ 2 := by
      have : 1 ≤ P ^ 2 := Nat.one_le_pow _ _ (by omega)
      omega
    calc Y = 2 * (P * (N * Fintype.card K)) := by rw [hYdef, hcardK]
      _ ≤ 2 * (P * (P * (32 * P ^ 2))) := by gcongr
      _ = 4 * (2 * P) ^ 4 := by ring
      _ ≤ (2 * P) * (2 * P) ^ 4 := Nat.mul_le_mul_right _ (by omega)
      _ = (2 * P) ^ 5 := by ring
  have hr : 2 * (2 * P) ^ 18 ≤ 2 ^ (wc * n) :=
    calc 2 * (2 * P) ^ 18 ≤ (2 * P) * (2 * P) ^ 18 := Nat.mul_le_mul_right _ (by omega)
      _ = (2 * P) ^ 19 := by ring
      _ ≤ (2 * P) ^ 40 := Nat.pow_le_pow_right (by omega) (by norm_num)
      _ ≤ 2 ^ wc := hC2
      _ ≤ 2 ^ (wc * n) := Nat.pow_le_pow_right (by norm_num) (Nat.le_mul_of_pos_right _ hn)
  -- the joint objects of a cut `c` and a class profile `p`
  set Kmax := Finset.univ.sup whole
  let IJ : Type := Σ _ : Fin N, I
  let OnJ : ℕ → (p : Fin N → ℕ) → SigP whole p → Oracle (P3Alpha n wc) → IJ → Prop := fun c _ σ π x =>
    OnFresh c x.1 (σ.1 x.1) π x.2 ∧ ¬ JBad tags G W ((omegaEquiv n wc).symm π)
  let nameJ : ℕ → (p : Fin N → ℕ) → SigP whole p → Oracle (P3Alpha n wc) → IJ → ℕ × (Fin N × K) :=
    fun c _ σ π x => ((name c x.1 (σ.1 x.1) π x.2).1, (x.1, (name c x.1 (σ.1 x.1) π x.2).2))
  let TJ : ℕ → (p : Fin N → ℕ) → SigP whole p → Fin N × K → History (P3Alpha n wc) →
      (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1) := fun c _ σ κ hh q => T c κ.1 (σ.1 κ.1) κ.2 hh q
  let wJ : Fin N × K → ℕ := fun κ => w κ.2
  let items : (Fin N → ℕ) → ℕ := fun p => ∑ t, (4 * n + 3 * p t)
  let Wp : (Fin N → ℕ) → ℕ := fun p => ∑ t, wc * n * max s (p t)
  let WinE : ℕ → (Fin N → ℕ) → Oracle (P3Alpha n wc) → Prop := fun c p π =>
    ∃ σ : SigP whole p, ∃ X : Finset IJ, (∀ x ∈ X, OnJ c p σ π x) ∧ X.card ≤ (items p - 1) + 1 ∧
      Wp p ≤ ∑ x ∈ X, wJ (nameJ c p σ π x).2
  have hitems : ∀ p, 1 ≤ items p := fun p =>
    le_trans (by omega : 1 ≤ 4 * n + 3 * p ⟨0, hN⟩)
      (Finset.single_le_sum (f := fun t => 4 * n + 3 * p t) (fun _ _ => Nat.zero_le _) (Finset.mem_univ _))
  -- one cut and one class profile per win
  have hcov : ∀ π, ((∀ t : Fin N, (s : ℚ) * n ≤
        ((segReplay A tags G W D Q t).onlineH ((omegaEquiv n wc).symm π) (D + 1)).size 512 wc) ∧
        ¬ JBad tags G W ((omegaEquiv n wc).symm π)) →
      ∃ c ∈ Finset.range (N * n * Q + 1), ∃ p ∈ Fintype.piFinset fun _ : Fin N => Finset.range (Kmax + 1),
        WinE c p π := by
    intro π hπ
    obtain ⟨c, hc, hall⟩ := hwin π hπ
    choose σt X hXf hXc hXw using hall
    refine ⟨c, Finset.mem_range.2 (by omega), fun t => whole (σt t),
      Fintype.mem_piFinset.2 fun t => Finset.mem_range.2 (Nat.lt_succ_of_le
        (Finset.le_sup (f := whole) (Finset.mem_univ _))), ⟨fun t => σt t, fun t => rfl⟩, Finset.univ.sigma X,
      fun x hx => ⟨hXf x.1 x.2 (Finset.mem_sigma.1 hx).2, hπ.2⟩, ?_, ?_⟩
    · rw [Nat.sub_add_cancel (hitems _), Finset.card_sigma]
      exact Finset.sum_le_sum fun t _ => hXc t
    · show ∑ t, wc * n * max s (whole (σt t)) ≤ ∑ x ∈ Finset.univ.sigma X, w (name c x.1 (σt x.1) π x.2).2
      rw [Finset.sum_sigma]
      exact Finset.sum_le_sum fun t _ => hXw t
  -- the bridge, per cut and class profile
  have hcp : ∀ c ∈ Finset.range (N * n * Q + 1), ∀ p : Fin N → ℕ, prob (WinE c p) ≤
      (Fintype.card (SigP whole p) : ℝ≥0∞) *
        (2 * (((2 * (P * Fintype.card (Fin N × K))) ^ ((items p - 1) + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (Wp p)) := by
    intro c hc p
    have hc' : c ≤ N * n * Q := Nat.lt_succ_iff.1 (Finset.mem_range.1 hc)
    refine (jointStratC A tags G W D c).prob_fresh_slots_le (Sig := SigP whole p) (TJ c p) wJ P
      (fun σ κ hh q => hT c κ.1 (σ.1 κ.1) κ.2 hh q)
      (fun κ => hC1.trans (Nat.pow_le_pow_right (by norm_num) (hw κ.2))) ?_ (OnJ c p) (nameJ c p) ?_
      (fun σ π x hx => hfresh c x.1 (σ.1 x.1) π x.2 hx.1)
      (fun σ π x q hx hq => htarget c x.1 (σ.1 x.1) π x.2 q hx.1 hq)
      (fun σ π x hx => by
        obtain ⟨q, hq, -⟩ := hfresh c x.1 (σ.1 x.1) π x.2 hx.1
        exact jointStratC_step_lt A tags G W D Q c hc' hq)
      (items p - 1) (Wp p) (WinE c p) (fun π hπ => hπ)
    · have : 1 ≤ P * Fintype.card (Fin N × K) :=
        Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by rw [hcardK]; exact Nat.mul_ne_zero (by omega) (by omega)))
      omega
    · rintro σ π ⟨t, x⟩ ⟨t', y⟩ hx hy hne
      by_cases htt : t = t'
      · subst htt
        exact hdist c t (σ.1 t) π x y hx.1 hy.1 fun hxy => hne (by rw [hxy])
      · exact hcross c t t' (σ.1 t) (σ.1 t') π x y htt hx.2 hx.1 hy.1
  -- per class profile, the terms factor over the segments
  let f : ℕ → ℝ≥0∞ := fun k => ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) *
    (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s k)
  have hterm : ∀ p : Fin N → ℕ, (Fintype.card (SigP whole p) : ℝ≥0∞) *
      (2 * (((2 * (P * Fintype.card (Fin N × K))) ^ ((items p - 1) + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (Wp p)) ≤
      2 * ∏ t, f (p t) := by
    intro p
    have hcard : (Fintype.card (SigP whole p) : ℝ≥0∞) ≤ ∏ t, ((Z ^ (3 * n + p t) : ℕ) : ℝ≥0∞) := by
      have := card_sigP_le whole p Z n hZ
      rw [← Nat.cast_prod]
      exact_mod_cast this
    rw [Nat.sub_add_cancel (hitems p), ← hYdef]
    have hY : ((Y ^ items p : ℕ) : ℝ≥0∞) = ∏ t, ((Y ^ (4 * n + 3 * p t) : ℕ) : ℝ≥0∞) := by
      rw [← Nat.cast_prod, Finset.prod_pow_eq_pow_sum]
    have hW : (2⁻¹ : ℝ≥0∞) ^ (Wp p) = ∏ t, (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s (p t)) := by
      rw [Finset.prod_pow_eq_pow_sum]
    rw [hY, hW]
    calc (Fintype.card (SigP whole p) : ℝ≥0∞) * (2 * (∏ t, ((Y ^ (4 * n + 3 * p t) : ℕ) : ℝ≥0∞)) *
          ∏ t, (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s (p t)))
        ≤ (∏ t, ((Z ^ (3 * n + p t) : ℕ) : ℝ≥0∞)) * (2 * (∏ t, ((Y ^ (4 * n + 3 * p t) : ℕ) : ℝ≥0∞)) *
          ∏ t, (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s (p t))) := by gcongr
      _ = 2 * ∏ t, f (p t) := by
          simp only [f, Finset.prod_mul_distrib]
          ring
  have hseg : ∑ k ∈ Finset.range (Kmax + 1), f k ≤
      (((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) :=
    seg_sum_le Kmax hZB hYB (by omega) hr
  have hprof : ∑ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), 2 * ∏ t, f (p t) =
      2 * (∑ k ∈ Finset.range (Kmax + 1), f k) ^ N := by
    rw [← Finset.mul_sum, ← Finset.prod_univ_sum (fun _ : Fin N => Finset.range (Kmax + 1)) (fun _ k => f k),
      Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  -- assemble
  rw [pr_transport' n wc]
  calc prob (fun π => (∀ t : Fin N, (s : ℚ) * n ≤
          ((segReplay A tags G W D Q t).onlineH ((omegaEquiv n wc).symm π) (D + 1)).size 512 wc) ∧
          ¬ JBad tags G W ((omegaEquiv n wc).symm π))
      ≤ prob (fun π => ∃ c ∈ Finset.range (N * n * Q + 1),
          ∃ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), WinE c p π) := prob_mono hcov
    _ ≤ ∑ c ∈ Finset.range (N * n * Q + 1),
          prob (fun π => ∃ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), WinE c p π) :=
        prob_exists_le _ _
    _ ≤ ∑ c ∈ Finset.range (N * n * Q + 1),
          ∑ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), prob (WinE c p) :=
        Finset.sum_le_sum fun c _ => prob_exists_le _ _
    _ ≤ ∑ c ∈ Finset.range (N * n * Q + 1),
          ∑ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), 2 * ∏ t, f (p t) :=
        Finset.sum_le_sum fun c hc => Finset.sum_le_sum fun p _ => (hcp c hc p).trans (hterm p)
    _ = ∑ _c ∈ Finset.range (N * n * Q + 1), 2 * (∑ k ∈ Finset.range (Kmax + 1), f k) ^ N :=
        Finset.sum_congr rfl fun _ _ => hprof
    _ ≤ ∑ _c ∈ Finset.range (N * n * Q + 1),
          2 * ((((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)) ^ N :=
        Finset.sum_le_sum fun _ _ => by gcongr
    _ = ((N * n * Q + 1 : ℕ) : ℝ≥0∞) *
          (2 * ((((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)) ^ N) := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    _ ≤ _ := joint_final hN hn hs hsn hB10 hCmax hC2


open PousAssembly PousForwardCore

open Classical in
/-- **The joint count under (C1) and the multi (C2)**: `P3ChainCountMulti` with `(2·N·nPosC)^40 ≤ 2^wc`. -/
def P3ChainCountMulti2 : Prop :=
  ∀ (N n wc D Q k X : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → (2 * (N * nPosC n Q)) ^ 40 ≤ 2 ^ wc → 1 ≤ N →
    X + 1 ≤ k → Function.Injective tags → P3ChainHard G 512 wc D k X →
    ∀ A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc), (∀ s v, (A s v).Bounded D Q) →
      (Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card * 2 ^ (N * (k - X - 1) * (n * wc)) ≤
        N * (N * nPosC n Q) ^ (14 * n * N) * Fintype.card (P3COmega n wc)

/-- **`P3ChainEPFMulti` with the multi (C2)** right after (C1), where the one-segment prover adds it. -/
def P3ChainEPFMulti2 : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → (2 * (N * nPosC n Q)) ^ 40 ≤ 2 ^ wc → 1 ≤ N →
    X + 1 ≤ k → Function.Injective tags → P3ChainHard G 512 wc D k X →
    ∀ (A₁ : P3COmega n wc → Bits m) (A₂ : Bits m → Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)),
      (∀ σ s v, (A₂ σ s v).Bounded D Q) →
      pr (JointEventC G tags W A₁ A₂ k) ≤
        (N : ℝ≥0∞) * 2 ^ m * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (k - X - 1) * (n * wc)) +
          (((N * nPosC n Q) ^ 2 + (2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

/-- A joint win prices every segment at `(k − X)·n` (`joint_win_price`); the compression bounds that, as a count. -/
theorem p3ChainCountMulti2_of_tail2 (h : JointFreshTail2) : P3ChainCountMulti2 := by
  classical
  intro N n wc D Q k X tags G W hn hwc hn255 hC1 hC2 hN hXk htags hard A hA
  by_cases hkn : k ≤ n
  swap
  · have hempty : (Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω) = ∅ := by
      refine Finset.filter_eq_empty_iff.2 fun ω _ hω => hkn ?_
      exact (hω.1 ⟨0, hN⟩).trans ((Finset.card_filter_le _ _).trans (by rw [Finset.card_univ, Fintype.card_fin]))
    rw [hempty, Finset.card_empty, zero_mul]
    exact Nat.zero_le _
  have hpr := h N n wc D Q (k - X) tags G W A hn hwc hn255 hC1 hC2 hN htags hA (by omega)
  have hsub : pr (fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω) ≤
      (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (k - X - 1) * (n * wc)) :=
    (pr_mono fun ω hω => ⟨fun t => joint_win_price A tags G W D Q ω hA hard hω.1 t, hω.2⟩).trans hpr
  set E := N * (k - X - 1) * (n * wc)
  set C := N * (N * nPosC n Q) ^ (14 * n * N)
  have hΩ0 : (Fintype.card (P3COmega n wc) : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (P3COmega n wc) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2E0 : (2 : ℝ≥0∞) ^ E ≠ 0 := pow_ne_zero _ two_ne_zero
  have h2Et : (2 : ℝ≥0∞) ^ E ≠ ⊤ := ENNReal.pow_ne_top ENNReal.ofNat_ne_top
  rw [pr_def, ENNReal.div_le_iff hΩ0 hΩt] at hsub
  have hC' : (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) = ((C : ℕ) : ℝ≥0∞) := by
    simp only [C, Nat.cast_mul]
  rw [hC'] at hsub
  have hmul : ((Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card : ℝ≥0∞) * 2 ^ E ≤
      (C : ℝ≥0∞) * Fintype.card (P3COmega n wc) :=
    calc ((Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card : ℝ≥0∞) * 2 ^ E
        ≤ ((C : ℝ≥0∞) / 2 ^ E * Fintype.card (P3COmega n wc)) * 2 ^ E := by gcongr
      _ = (C : ℝ≥0∞) * Fintype.card (P3COmega n wc) := by rw [mul_right_comm, ENNReal.div_mul_cancel h2E0 h2Et]
  have : ((((Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card * 2 ^ E : ℕ)) : ℝ≥0∞) ≤
      ((C * Fintype.card (P3COmega n wc) : ℕ) : ℝ≥0∞) := by
    push_cast
    exact hmul
  exact_mod_cast this

/-- **The target from the count**: the union over advice (`pr_le_of_advice`) and `jointBirthday` for `JBad`. -/
theorem p3ChainEPFMulti2_of_count2 (h : P3ChainCountMulti2) : P3ChainEPFMulti2 := by
  classical
  intro N n wc m D Q k X tags G W hn hwc hn255 hC1 hC2 hN hXk htags hard A₁ A₂ hA
  have hcount := h N n wc D Q k X tags G W hn hwc hn255 hC1 hC2 hN hXk htags hard
  rw [pr_partition (JointEventC G tags W A₁ A₂ k) (JBad tags G W)]
  refine add_le_add ?_ ((pr_mono fun ω h => h.2).trans (jointBirthday N n wc Q tags G W htags hn255))
  refine (pr_le_of_advice A₁ (fun ω => JointEventC G tags W A₁ A₂ k ω ∧ ¬ JBad tags G W ω)
    (N * (N * nPosC n Q) ^ (14 * n * N)) (2 ^ (N * (k - X - 1) * (n * wc))) (by positivity)
    fun σ => ?_).trans (le_of_eq ?_)
  · refine le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card fun ω hω => ?_)) (hcount (A₂ σ) (hA σ))
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
    obtain ⟨hσ, hwin, hbad⟩ := hω
    refine ⟨fun s => ?_, hbad⟩
    have hs := hwin s
    rw [hσ] at hs
    exact hs
  · simp only [Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat, div_eq_mul_inv]
    ring

/-- **The 14 GB target, with the multi (C2), from the per-segment charges.** -/
theorem p3ChainEPFMulti2_of_segCharges (h : P3SegCharges) : P3ChainEPFMulti2 :=
  p3ChainEPFMulti2_of_count2 (p3ChainCountMulti2_of_tail2 (jointFreshTail2_of_segCharges h))


/-- **The 14 GB target from the per-segment charges.** -/
theorem p3ChainEPFMulti_of_segCharges (h : P3SegCharges) : P3ChainEPFMulti := p3ChainEPFMulti2_of_segCharges h

/-- **The one-segment target from the per-segment charges** (`N = 1`, `p3ChainEPF_of_multi`). -/
theorem p3ChainEPF_of_segCharges (h : P3SegCharges) : P3ChainEPF := p3ChainEPF_of_multi (p3ChainEPFMulti_of_segCharges h)


end

end PousP3ConcreteMulti

