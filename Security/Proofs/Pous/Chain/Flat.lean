/-! ════ LazyPerm ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


open scoped ENNReal

namespace LazyPerm


section Counting

variable {β : Type} [DecidableEq β]

/-- **Uniform fibers.** If `g` maps `s` into `A` and all fibers of `s` over `A` have one size, then
`|{x ∈ s | g x ∈ T}| · |A| ≤ |T| · |s|`. -/
theorem card_filter_mem_mul_le {γ : Type} (s : Finset γ) (g : γ → β) (A T : Finset β)
    (hA : ∀ x ∈ s, g x ∈ A)
    (heq : ∀ a ∈ A, ∀ a' ∈ A, (s.filter (fun x => g x = a)).card = (s.filter (fun x => g x = a')).card) :
    (s.filter (fun x => g x ∈ T)).card * A.card ≤ T.card * s.card := by
  rcases A.eq_empty_or_nonempty with hA0 | ⟨a₀, ha₀⟩
  · rw [hA0, Finset.card_empty, Nat.mul_zero]; exact Nat.zero_le _
  set f := (s.filter (fun x => g x = a₀)).card
  have hs : s.card = A.card * f := by
    rw [Finset.card_eq_sum_card_fiberwise (f := g) (t := A) (fun x hx => hA x hx),
      Finset.sum_congr rfl (fun a ha => heq a ha a₀ ha₀), Finset.sum_const, smul_eq_mul]
  have hT : (s.filter (fun x => g x ∈ T)).card = (A ∩ T).card * f := by
    rw [Finset.card_eq_sum_card_fiberwise (f := g) (t := A ∩ T) (fun x hx => by
      rw [Finset.mem_coe, Finset.mem_filter] at hx
      exact Finset.mem_inter.2 ⟨hA x hx.1, hx.2⟩)]
    rw [Finset.sum_congr rfl (fun a ha => ?_), Finset.sum_const, smul_eq_mul]
    rw [Finset.filter_filter]
    refine Eq.trans ?_ (heq a (Finset.mem_inter.1 ha).1 a₀ ha₀)
    congr 1
    exact Finset.filter_congr (fun x _ => ⟨fun h => h.2, fun h => ⟨h ▸ (Finset.mem_inter.1 ha).2, h⟩⟩)
  rw [hT, hs]
  calc (A ∩ T).card * f * A.card ≤ T.card * f * A.card := by
        gcongr; exact Finset.inter_subset_right
    _ = T.card * (A.card * f) := by ring


/-- Two fibers have one size when an involution of `s` exchanges them. -/
theorem card_fiber_eq_of_invol {γ : Type} (s : Finset γ) (g : γ → β) {a a' : β} (φ : γ → γ)
    (hs : ∀ x ∈ s, φ x ∈ s) (hφ : ∀ x, φ (φ x) = x)
    (h₁ : ∀ x ∈ s, g x = a → g (φ x) = a') (h₂ : ∀ x ∈ s, g x = a' → g (φ x) = a) :
    (s.filter (fun x => g x = a)).card = (s.filter (fun x => g x = a')).card := by
  refine Finset.card_nbij' φ φ ?_ ?_ (fun x _ => hφ x) (fun x _ => hφ x)
  · intro x hx
    rw [Finset.mem_coe, Finset.mem_filter] at hx ⊢
    exact ⟨hs x hx.1, h₁ x hx.1 hx.2⟩
  · intro x hx
    rw [Finset.mem_coe, Finset.mem_filter] at hx ⊢
    exact ⟨hs x hx.1, h₂ x hx.1 hx.2⟩

variable [Fintype β]


end Counting


open Classical in
/-- The probability that a uniform `ω : Ω` satisfies `E` (the same body as `Pous.pr`). -/
noncomputable def prob {Ω : Type} [Fintype Ω] (E : Ω → Prop) : ℝ≥0∞ :=
  ((Finset.univ.filter E).card : ℝ≥0∞) / Fintype.card Ω

/-- Probabilities transfer along an equivalence. -/
theorem prob_congr {Ω Ω' : Type} [Fintype Ω] [Fintype Ω'] (e : Ω ≃ Ω') (E : Ω' → Prop) :
    prob (fun ω => E (e ω)) = prob E := by
  classical
  unfold prob
  rw [Fintype.card_congr e]
  congr 2
  refine Finset.card_nbij' e e.symm ?_ ?_ (fun x _ => e.symm_apply_apply x) (fun x _ => e.apply_symm_apply x)
  · intro x hx
    rw [Finset.mem_coe, Finset.mem_filter] at hx ⊢
    exact ⟨Finset.mem_univ _, hx.2⟩
  · intro x hx
    rw [Finset.mem_coe, Finset.mem_filter] at hx ⊢
    exact ⟨Finset.mem_univ _, by rw [e.apply_symm_apply]; exact hx.2⟩

/-- **Pinning.** A target of `t` points among `N = t·M`, with `j ≤ k` values used: `t·(M − k) ≤ N − j`. -/
theorem pin_mul_le {t M N k j : ℕ} (hN : t * M = N) (ht : 1 ≤ t) (hj : j ≤ k) : t * (M - k) ≤ N - j := by
  rcases le_or_gt k M with hk | hk
  · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
    rw [Nat.add_sub_cancel_left, ← hN, Nat.mul_add]
    have : k ≤ t * k := Nat.le_mul_of_pos_left k ht
    omega
  · rw [Nat.sub_eq_zero_of_le hk.le, Nat.mul_zero]; exact Nat.zero_le _


section Oracle

variable {ι : Type} {α : ι → Type}

/-- A family of permutations, one per component. -/
abbrev Oracle (α : ι → Type) : Type := (i : ι) → Equiv.Perm (α i)

/-- A query: `⟨i, inl x⟩` asks `π i x`, and `⟨i, inr y⟩` asks `(π i)⁻¹ y`. -/
abbrev Qry (α : ι → Type) : Type := Σ i, α i ⊕ α i

/-- The answer to a query. -/
def ans (π : Oracle α) : (q : Qry α) → α q.1
  | ⟨i, .inl x⟩ => π i x
  | ⟨i, .inr y⟩ => (π i).symm y

/-- A query with its answer. -/
abbrev Entry (α : ι → Type) : Type := Σ q : Qry α, α q.1

/-- A history, oldest entry first. -/
abbrev History (α : ι → Type) : Type := List (Entry α)

/-- The input an entry fixes: the forward query's point, or the inverse query's answer. -/
def Entry.inp : (e : Entry α) → α e.1.1
  | ⟨⟨_, .inl x⟩, _⟩ => x
  | ⟨⟨_, .inr _⟩, a⟩ => a

/-- The output an entry fixes: the forward query's answer, or the inverse query's point. -/
def Entry.out : (e : Entry α) → α e.1.1
  | ⟨⟨_, .inl _⟩, a⟩ => a
  | ⟨⟨_, .inr y⟩, _⟩ => y

section Dec

variable [DecidableEq ι]

/-- The input an entry fixes in component `i`, if it is in component `i`. -/
def Entry.inpAt (i : ι) (e : Entry α) : Option (α i) :=
  if h : e.1.1 = i then some (h ▸ e.inp) else none

/-- The output an entry fixes in component `i`, if it is in component `i`. -/
def Entry.outAt (i : ι) (e : Entry α) : Option (α i) :=
  if h : e.1.1 = i then some (h ▸ e.out) else none

variable [∀ i, DecidableEq (α i)]

/-- The inputs a history fixes in component `i`. -/
def History.dom (h : History α) (i : ι) : Finset (α i) := (h.filterMap (Entry.inpAt i)).toFinset

/-- The outputs a history fixes in component `i`. -/
def History.rng (h : History α) (i : ι) : Finset (α i) := (h.filterMap (Entry.outAt i)).toFinset

/-- A query is **fresh** when the history does not fix its answer. -/
def Fresh (h : History α) : Qry α → Prop
  | ⟨i, .inl x⟩ => x ∉ h.dom i
  | ⟨i, .inr y⟩ => y ∉ h.rng i

end Dec

/-- A deterministic adaptive algorithm: the next query from the history, or `none` to stop. -/
structure Strategy (α : ι → Type) where
  next : History α → Option (Qry α)

/-- The history after `n` steps against `π`. A stopped strategy stays stopped. -/
def Strategy.hist (S : Strategy α) (π : Oracle α) : ℕ → History α
  | 0 => []
  | n + 1 =>
    match S.next (S.hist π n) with
    | none => S.hist π n
    | some q => S.hist π n ++ [⟨q, ans π q⟩]

/-- Step `j` is a fresh query whose answer lands in the target `T (history before j) q`. -/
def Strategy.Hit [DecidableEq ι] [∀ i, DecidableEq (α i)] (S : Strategy α)
    (T : History α → (q : Qry α) → Finset (α q.1)) (j : ℕ) (π : Oracle α) : Prop :=
  ∃ q, S.next (S.hist π j) = some q ∧ Fresh (S.hist π j) q ∧ ans π q ∈ T (S.hist π j) q


section Entries

variable [DecidableEq ι] [∀ i, DecidableEq (α i)]

theorem History.mem_dom {h : History α} {i : ι} {x : α i} : x ∈ h.dom i ↔ ∃ e ∈ h, e.inpAt i = some x := by
  simp only [History.dom, List.mem_toFinset, List.mem_filterMap]

theorem History.mem_rng {h : History α} {i : ι} {y : α i} : y ∈ h.rng i ↔ ∃ e ∈ h, e.outAt i = some y := by
  simp only [History.rng, List.mem_toFinset, List.mem_filterMap]

theorem History.card_dom_le (h : History α) (i : ι) : (h.dom i).card ≤ h.length :=
  (List.toFinset_card_le _).trans (List.length_filterMap_le _ _)

theorem History.card_rng_le (h : History α) (i : ι) : (h.rng i).card ≤ h.length :=
  (List.toFinset_card_le _).trans (List.length_filterMap_le _ _)

omit [∀ i, DecidableEq (α i)] in
/-- A consistent entry fixes `π i inp = out` in its component. -/
theorem Entry.outAt_eq_map {π : Oracle α} {e : Entry α} (he : e.2 = ans π e.1) (i : ι) :
    e.outAt i = (e.inpAt i).map (π i) := by
  rcases e with ⟨⟨j, d⟩, a⟩
  by_cases hj : j = i
  · subst hj
    cases d with
    | inl x =>
      simp only [Entry.outAt, Entry.inpAt, dite_true, Option.map_some, Entry.out, Entry.inp]
      exact congrArg some he
    | inr y =>
      simp only [Entry.outAt, Entry.inpAt, dite_true, Option.map_some, Entry.out, Entry.inp]
      change a = (π j).symm y at he
      rw [he, Equiv.apply_symm_apply]
  · simp only [Entry.outAt, Entry.inpAt, hj, dite_false, Option.map_none]

end Entries


namespace Strategy

variable (S : Strategy α)

theorem hist_succ_of_none {π : Oracle α} {n : ℕ} (h : S.next (S.hist π n) = none) :
    S.hist π (n + 1) = S.hist π n := by
  simp only [hist, h]

theorem hist_succ_of_some {π : Oracle α} {n : ℕ} {q : Qry α} (h : S.next (S.hist π n) = some q) :
    S.hist π (n + 1) = S.hist π n ++ [⟨q, ans π q⟩] := by
  simp only [hist, h]

theorem hist_prefix_succ (π : Oracle α) (n : ℕ) : S.hist π n <+: S.hist π (n + 1) := by
  cases h : S.next (S.hist π n) with
  | none => rw [S.hist_succ_of_none h]
  | some q => rw [S.hist_succ_of_some h]; exact List.prefix_append _ _

theorem hist_prefix (π : Oracle α) {m n : ℕ} (h : m ≤ n) : S.hist π m <+: S.hist π n := by
  induction n, h using Nat.le_induction with
  | base => exact List.prefix_refl _
  | succ n _ ih => exact ih.trans (S.hist_prefix_succ π n)

theorem hist_length_le (π : Oracle α) (n : ℕ) : (S.hist π n).length ≤ n := by
  induction n with
  | zero => simp [hist]
  | succ n ih =>
    cases h : S.next (S.hist π n) with
    | none => rw [S.hist_succ_of_none h]; omega
    | some q => rw [S.hist_succ_of_some h, List.length_append, List.length_singleton]; omega

theorem mem_hist {π : Oracle α} {n : ℕ} {e : Entry α} (he : e ∈ S.hist π n) : e.2 = ans π e.1 := by
  induction n with
  | zero => simp [hist] at he
  | succ n ih =>
    cases h : S.next (S.hist π n) with
    | none => rw [S.hist_succ_of_none h] at he; exact ih he
    | some q =>
      rw [S.hist_succ_of_some h, List.mem_append, List.mem_singleton] at he
      rcases he with he | rfl
      · exact ih he
      · rfl

/-- If `π'` agrees with `π` on every entry of the history at `n`, the histories agree up to `n`. -/
theorem hist_congr {π π' : Oracle α} {n : ℕ} (h : ∀ e ∈ S.hist π n, ans π' e.1 = e.2) {m : ℕ} (hm : m ≤ n) :
    S.hist π' m = S.hist π m := by
  induction m with
  | zero => rfl
  | succ m ih =>
    have ih := ih (Nat.le_of_succ_le hm)
    cases hq : S.next (S.hist π m) with
    | none =>
      rw [S.hist_succ_of_none hq, S.hist_succ_of_none (by rw [ih]; exact hq), ih]
    | some q =>
      rw [S.hist_succ_of_some hq, S.hist_succ_of_some (by rw [ih]; exact hq), ih]
      have hmem : (⟨q, ans π q⟩ : Entry α) ∈ S.hist π n :=
        (S.hist_prefix π hm).subset (by rw [S.hist_succ_of_some hq]; simp)
      rw [h _ hmem]

variable [DecidableEq ι] [∀ i, DecidableEq (α i)]

/-- Whether step `j < n` hits is fixed by the history at `n`. -/
theorem hit_congr (T : History α → (q : Qry α) → Finset (α q.1)) {π π' : Oracle α} {j n : ℕ} (hj : j < n)
    (h : S.hist π n = S.hist π' n) : S.Hit T j π ↔ S.Hit T j π' := by
  have key : ∀ {π π' : Oracle α}, S.hist π n = S.hist π' n → S.Hit T j π → S.Hit T j π' := by
    intro π π' h ⟨q, hq, hfr, hmem⟩
    have hag : ∀ e ∈ S.hist π n, ans π' e.1 = e.2 := fun e he => by
      rw [h] at he; exact (S.mem_hist he).symm
    have hj' : S.hist π' j = S.hist π j := S.hist_congr hag hj.le
    have hstep : (⟨q, ans π q⟩ : Entry α) ∈ S.hist π n :=
      (S.hist_prefix π (Nat.succ_le_of_lt hj)).subset (by rw [S.hist_succ_of_some hq]; simp)
    have hans : ans π' q = ans π q := hag _ hstep
    exact ⟨q, by rw [hj']; exact hq, by rw [hj']; exact hfr, by rw [hj', hans]; exact hmem⟩
  exact ⟨key h, key h.symm⟩


/-- Arithmetic of one step: from the uniform-fiber count `X·A ≤ t·Y` and the target ratio `t·b ≤ a·N'` with
`N' ≤ A`, get `X·b ≤ a·Y`. -/
private theorem step_arith {X Y A t a b N' : ℕ} (h1 : X * A ≤ t * Y) (h2 : t * b ≤ a * N') (h3 : N' ≤ A)
    (h4 : X ≤ Y) (h5 : A = 0 → Y = 0) : X * b ≤ a * Y := by
  rcases Nat.eq_zero_or_pos A with h0 | hpos
  · have hY := h5 h0
    have hX : X = 0 := Nat.le_zero.1 (hY ▸ h4)
    rw [hX, Nat.zero_mul]; exact Nat.zero_le _
  refine Nat.le_of_mul_le_mul_right ?_ hpos
  calc X * b * A = (X * A) * b := by ring
    _ ≤ (t * Y) * b := Nat.mul_le_mul_right _ h1
    _ = (t * b) * Y := by ring
    _ ≤ (a * N') * Y := Nat.mul_le_mul_right _ h2
    _ ≤ (a * A) * Y := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ h3)
    _ = a * Y * A := by ring

section Swap

variable {π : Oracle α} {h : History α}

/-- Swapping two outputs outside `h.rng i` keeps every consistent entry of `h`. -/
theorem ans_update_swap_out {i : ι} {a a' : α i} (ha : a ∉ h.rng i) (ha' : a' ∉ h.rng i)
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) :
    ∀ e ∈ h, ans (Function.update π i (Equiv.swap a a' * π i)) e.1 = e.2 := by
  intro e he
  have hout : e.outAt i = (e.inpAt i).map (π i) := Entry.outAt_eq_map (hcons e he) i
  rcases e with ⟨⟨j, d⟩, c⟩
  have hc := hcons _ he
  by_cases hj : j = i
  · subst hj
    have hmem : Entry.out (⟨⟨j, d⟩, c⟩ : Entry α) ∈ h.rng j :=
      History.mem_rng.2 ⟨_, he, by simp [Entry.outAt]⟩
    cases d with
    | inl x =>
      change c = π j x at hc
      change (Function.update π j (Equiv.swap a a' * π j)) j x = c
      rw [Function.update_self, Equiv.Perm.mul_apply, ← hc]
      change c ∈ h.rng j at hmem
      exact Equiv.swap_apply_of_ne_of_ne (ne_of_mem_of_not_mem hmem ha) (ne_of_mem_of_not_mem hmem ha')
    | inr y =>
      change c = (π j).symm y at hc
      change ((Function.update π j (Equiv.swap a a' * π j)) j).symm y = c
      change y ∈ h.rng j at hmem
      rw [Function.update_self, hc, Equiv.Perm.mul_def, Equiv.symm_trans_apply, Equiv.symm_swap,
        Equiv.swap_apply_of_ne_of_ne (ne_of_mem_of_not_mem hmem ha) (ne_of_mem_of_not_mem hmem ha')]
  · cases d with
    | inl x =>
      change (Function.update π i (Equiv.swap a a' * π i)) j x = c
      rw [Function.update_of_ne hj]; exact hc.symm
    | inr y =>
      change ((Function.update π i (Equiv.swap a a' * π i)) j).symm y = c
      rw [Function.update_of_ne hj]; exact hc.symm

/-- Swapping two inputs outside `h.dom i` keeps every consistent entry of `h`. -/
theorem ans_update_swap_in {i : ι} {b b' : α i} (hb : b ∉ h.dom i) (hb' : b' ∉ h.dom i)
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) :
    ∀ e ∈ h, ans (Function.update π i (π i * Equiv.swap b b')) e.1 = e.2 := by
  intro e he
  rcases e with ⟨⟨j, d⟩, c⟩
  have hc := hcons _ he
  by_cases hj : j = i
  · subst hj
    have hmem : Entry.inp (⟨⟨j, d⟩, c⟩ : Entry α) ∈ h.dom j :=
      History.mem_dom.2 ⟨_, he, by simp [Entry.inpAt]⟩
    cases d with
    | inl x =>
      change c = π j x at hc
      change (Function.update π j (π j * Equiv.swap b b')) j x = c
      change x ∈ h.dom j at hmem
      rw [Function.update_self, Equiv.Perm.mul_apply,
        Equiv.swap_apply_of_ne_of_ne (ne_of_mem_of_not_mem hmem hb) (ne_of_mem_of_not_mem hmem hb'), hc]
    | inr y =>
      change c = (π j).symm y at hc
      change ((Function.update π j (π j * Equiv.swap b b')) j).symm y = c
      change c ∈ h.dom j at hmem
      rw [Function.update_self, Equiv.Perm.mul_def, Equiv.symm_trans_apply, Equiv.symm_swap, ← hc,
        Equiv.swap_apply_of_ne_of_ne (ne_of_mem_of_not_mem hmem hb) (ne_of_mem_of_not_mem hmem hb')]
  · cases d with
    | inl x =>
      change (Function.update π i (π i * Equiv.swap b b')) j x = c
      rw [Function.update_of_ne hj]; exact hc.symm
    | inr y =>
      change ((Function.update π i (π i * Equiv.swap b b')) j).symm y = c
      rw [Function.update_of_ne hj]; exact hc.symm

/-- A fresh forward answer avoids the fixed outputs. -/
theorem apply_notMem_rng {i : ι} {x : α i} (hx : x ∉ h.dom i) (hcons : ∀ e ∈ h, e.2 = ans π e.1) :
    π i x ∉ h.rng i := by
  intro hm
  obtain ⟨e, he, hout⟩ := History.mem_rng.1 hm
  rw [Entry.outAt_eq_map (hcons e he)] at hout
  obtain ⟨x', hx', hxx'⟩ := Option.map_eq_some_iff.1 hout
  exact hx (History.mem_dom.2 ⟨e, he, by rw [hx', (π i).injective hxx']⟩)

/-- A fresh inverse answer avoids the fixed inputs. -/
theorem symm_apply_notMem_dom {i : ι} {y : α i} (hy : y ∉ h.rng i) (hcons : ∀ e ∈ h, e.2 = ans π e.1) :
    (π i).symm y ∉ h.dom i := by
  intro hm
  obtain ⟨e, he, hin⟩ := History.mem_dom.1 hm
  exact hy (History.mem_rng.2 ⟨e, he, by rw [Entry.outAt_eq_map (hcons e he), hin, Option.map_some,
    Equiv.apply_symm_apply]⟩)

end Swap

theorem update_update_swap_out (π : Oracle α) (i : ι) (a a' : α i) :
    Function.update (Function.update π i (Equiv.swap a a' * π i)) i
      (Equiv.swap a a' * (Function.update π i (Equiv.swap a a' * π i)) i) = π := by
  funext j
  by_cases hj : j = i
  · subst hj; rw [Function.update_self, Function.update_self, Equiv.swap_mul_self_mul]
  · rw [Function.update_of_ne hj, Function.update_of_ne hj]

theorem update_update_swap_in (π : Oracle α) (i : ι) (b b' : α i) :
    Function.update (Function.update π i (π i * Equiv.swap b b')) i
      ((Function.update π i (π i * Equiv.swap b b')) i * Equiv.swap b b') = π := by
  funext j
  by_cases hj : j = i
  · subst hj; rw [Function.update_self, Function.update_self, mul_assoc, Equiv.swap_mul_self, mul_one]
  · rw [Function.update_of_ne hj, Function.update_of_ne hj]

variable [Fintype ι] [∀ i, Fintype (α i)]

open Classical in
/-- **The per-answer bound in one fiber** of the history at step `n`. -/
theorem card_step_fiber (n : ℕ) (F : Oracle α → Prop) (hF : ∀ π π', S.hist π n = S.hist π' n → F π → F π')
    (T : History α → (q : Qry α) → Finset (α q.1)) (a b : ℕ)
    (hT : ∀ h q, (T h q).card * b ≤ a * (Fintype.card (α q.1) - n)) (h : History α) :
    (Finset.univ.filter (fun π => (F π ∧ S.Hit T n π) ∧ S.hist π n = h)).card * b
      ≤ a * (Finset.univ.filter (fun π => F π ∧ S.hist π n = h)).card := by
  set s := Finset.univ.filter (fun π => F π ∧ S.hist π n = h) with hs_def
  have hmem_s : ∀ π, π ∈ s ↔ F π ∧ S.hist π n = h := fun π => by simp [s]
  -- `s` is closed under any `π'` agreeing with `π` on `h`
  have hclosed : ∀ π ∈ s, ∀ π', (∀ e ∈ h, ans π' e.1 = e.2) → π' ∈ s := by
    intro π hπ π' hag
    obtain ⟨hFπ, hπh⟩ := (hmem_s π).1 hπ
    have hh : S.hist π' n = S.hist π n := S.hist_congr (by rw [hπh]; exact hag) le_rfl
    exact (hmem_s π').2 ⟨hF π π' hh.symm hFπ, hh.trans hπh⟩
  have hcons : ∀ π ∈ s, ∀ e ∈ h, e.2 = ans π e.1 := fun π hπ e he => by
    rw [← ((hmem_s π).1 hπ).2] at he; exact S.mem_hist he
  have hlen : s.Nonempty → h.length ≤ n := fun ⟨π, hπ⟩ => ((hmem_s π).1 hπ).2 ▸ S.hist_length_le π n
  cases hq : S.next h with
  | none =>
    have : Finset.univ.filter (fun π => (F π ∧ S.Hit T n π) ∧ S.hist π n = h) = ∅ := by
      refine Finset.filter_false_of_mem (fun π _ ⟨⟨_, q, hq', _⟩, hπh⟩ => ?_)
      rw [hπh, hq] at hq'; exact absurd hq' (by simp)
    rw [this, Finset.card_empty, Nat.zero_mul]; exact Nat.zero_le _
  | some q =>
    by_cases hfr : Fresh h q
    swap
    · have : Finset.univ.filter (fun π => (F π ∧ S.Hit T n π) ∧ S.hist π n = h) = ∅ := by
        refine Finset.filter_false_of_mem (fun π _ ⟨⟨_, q', hq', hfr', _⟩, hπh⟩ => ?_)
        rw [hπh] at hq' hfr'
        rw [hq] at hq'
        rw [Option.some_inj.1 hq'] at hfr
        exact hfr hfr'
      rw [this, Finset.card_empty, Nat.zero_mul]; exact Nat.zero_le _
    have hset : Finset.univ.filter (fun π => (F π ∧ S.Hit T n π) ∧ S.hist π n = h)
        = s.filter (fun π => ans π q ∈ T h q) := by
      ext π
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, s]
      constructor
      · rintro ⟨⟨hFπ, q', hq', _, hmem⟩, hπh⟩
        rw [hπh, hq] at hq'
        rw [hπh, ← Option.some_inj.1 hq'] at hmem
        exact ⟨⟨hFπ, hπh⟩, hmem⟩
      · rintro ⟨⟨hFπ, hπh⟩, hmem⟩
        exact ⟨⟨hFπ, q, by rw [hπh, hq], by rw [hπh]; exact hfr, by rw [hπh]; exact hmem⟩, hπh⟩
    rw [hset]
    rcases s.eq_empty_or_nonempty with hs0 | hne
    · rw [hs0, Finset.filter_empty, Finset.card_empty, Nat.zero_mul]; exact Nat.zero_le _
    have hlen' := hlen hne
    rcases q with ⟨i, x | y⟩
    · -- forward: the answer `π i x` is uniform over the outputs not yet fixed
      change x ∉ h.dom i at hfr
      have hA : ∀ π ∈ s, π i x ∈ (h.rng i)ᶜ := fun π hπ =>
        Finset.mem_compl.2 (apply_notMem_rng hfr (hcons π hπ))
      have heq : ∀ c ∈ (h.rng i)ᶜ, ∀ c' ∈ (h.rng i)ᶜ,
          (s.filter (fun π => π i x = c)).card = (s.filter (fun π => π i x = c')).card := by
        intro c hc c' hc'
        rw [Finset.mem_compl] at hc hc'
        refine card_fiber_eq_of_invol s (fun π => π i x) (fun π => Function.update π i (Equiv.swap c c' * π i))
          (fun π hπ => hclosed π hπ _ (ans_update_swap_out hc hc' (hcons π hπ)))
          (fun π => update_update_swap_out π i c c') ?_ ?_
        · intro π _ h'
          simp only [Function.update_self, Equiv.Perm.mul_apply, h', Equiv.swap_apply_left]
        · intro π _ h'
          simp only [Function.update_self, Equiv.Perm.mul_apply, h', Equiv.swap_apply_right]
      have h1 := card_filter_mem_mul_le s (fun π => π i x) _ (T h ⟨i, .inl x⟩) hA heq
      refine step_arith h1 (hT h ⟨i, .inl x⟩) ?_ (Finset.card_filter_le _ _) ?_
      · rw [Finset.card_compl]
        exact Nat.sub_le_sub_left ((History.card_rng_le h i).trans hlen') _
      · intro h0
        obtain ⟨π, hπ⟩ := hne
        exact absurd (hA π hπ) (by rw [Finset.card_eq_zero.1 h0]; simp)
    · -- inverse: the answer `(π i)⁻¹ y` is uniform over the inputs not yet fixed
      change y ∉ h.rng i at hfr
      have hA : ∀ π ∈ s, (π i).symm y ∈ (h.dom i)ᶜ := fun π hπ =>
        Finset.mem_compl.2 (symm_apply_notMem_dom hfr (hcons π hπ))
      have heq : ∀ c ∈ (h.dom i)ᶜ, ∀ c' ∈ (h.dom i)ᶜ,
          (s.filter (fun π => (π i).symm y = c)).card = (s.filter (fun π => (π i).symm y = c')).card := by
        intro c hc c' hc'
        rw [Finset.mem_compl] at hc hc'
        refine card_fiber_eq_of_invol s (fun π => (π i).symm y) (fun π => Function.update π i (π i * Equiv.swap c c'))
          (fun π hπ => hclosed π hπ _ (ans_update_swap_in hc hc' (hcons π hπ)))
          (fun π => update_update_swap_in π i c c') ?_ ?_
        · intro π _ h'
          simp only [Function.update_self, Equiv.Perm.mul_def, Equiv.symm_trans_apply, Equiv.symm_swap, h',
            Equiv.swap_apply_left]
        · intro π _ h'
          simp only [Function.update_self, Equiv.Perm.mul_def, Equiv.symm_trans_apply, Equiv.symm_swap, h',
            Equiv.swap_apply_right]
      have h1 := card_filter_mem_mul_le s (fun π => (π i).symm y) _ (T h ⟨i, .inr y⟩) hA heq
      refine step_arith h1 (hT h ⟨i, .inr y⟩) ?_ (Finset.card_filter_le _ _) ?_
      · rw [Finset.card_compl]
        exact Nat.sub_le_sub_left ((History.card_dom_le h i).trans hlen') _
      · intro h0
        obtain ⟨π, hπ⟩ := hne
        exact absurd (hA π hπ) (by rw [Finset.card_eq_zero.1 h0]; simp)

open Classical in
/-- **The per-answer bound at step `n`.** For any event `F` fixed by the history at `n`, if every target satisfies
`|T|·b ≤ a·(N_i − n)`, then `|{F ∧ step n hits}|·b ≤ a·|{F}|`. -/
theorem card_step_le (n : ℕ) (F : Oracle α → Prop) (hF : ∀ π π', S.hist π n = S.hist π' n → F π → F π')
    (T : History α → (q : Qry α) → Finset (α q.1)) (a b : ℕ)
    (hT : ∀ h q, (T h q).card * b ≤ a * (Fintype.card (α q.1) - n)) :
    (Finset.univ.filter (fun π => F π ∧ S.Hit T n π)).card * b ≤ a * (Finset.univ.filter F).card := by
  rw [Finset.card_eq_sum_card_fiberwise (s := Finset.univ.filter (fun π => F π ∧ S.Hit T n π))
      (f := fun π => S.hist π n) (t := Finset.univ.image (fun π => S.hist π n))
      (fun π _ => Finset.mem_coe.2 (Finset.mem_image_of_mem _ (Finset.mem_univ _))),
    Finset.card_eq_sum_card_fiberwise (s := Finset.univ.filter F)
      (f := fun π => S.hist π n) (t := Finset.univ.image (fun π => S.hist π n))
      (fun π _ => Finset.mem_coe.2 (Finset.mem_image_of_mem _ (Finset.mem_univ _))),
    Finset.sum_mul, Finset.mul_sum]
  refine Finset.sum_le_sum (fun h _ => ?_)
  rw [Finset.filter_filter, Finset.filter_filter]
  convert S.card_step_fiber n F hF T a b hT h using 3

open Classical in
/-- **The product along the transcript** over a fixed set `J` of named steps: if each step `j ∈ J` has targets with
`|T j|·b j ≤ a j·(N_i − j)`, then `|{every j ∈ J hits}|·∏ b ≤ ∏ a·|Ω|`. -/
theorem card_hits_le (J : Finset ℕ) (T : ℕ → History α → (q : Qry α) → Finset (α q.1)) (a b : ℕ → ℕ)
    (hT : ∀ j ∈ J, ∀ h q, (T j h q).card * b j ≤ a j * (Fintype.card (α q.1) - j)) :
    (Finset.univ.filter (fun π => ∀ j ∈ J, S.Hit (T j) j π)).card * ∏ j ∈ J, b j
      ≤ (∏ j ∈ J, a j) * Fintype.card (Oracle α) := by
  have key : ∀ n, (Finset.univ.filter (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π)).card
      * ∏ j ∈ J.filter (· < n), b j ≤ (∏ j ∈ J.filter (· < n), a j) * Fintype.card (Oracle α) := by
    intro n
    induction n with
    | zero =>
      have h0 : J.filter (· < 0) = ∅ := Finset.filter_false_of_mem (fun j _ => Nat.not_lt_zero j)
      rw [h0, Finset.prod_empty, Finset.prod_empty, Nat.mul_one, Nat.one_mul]
      exact (Finset.card_le_univ _)
    | succ n ih =>
      by_cases hn : n ∈ J
      · have hJ : J.filter (· < n + 1) = insert n (J.filter (· < n)) := by
          ext j
          simp only [Finset.mem_filter, Finset.mem_insert]
          constructor
          · rintro ⟨hj, hlt⟩
            rcases Nat.lt_succ_iff_lt_or_eq.1 hlt with h | h
            · exact Or.inr ⟨hj, h⟩
            · exact Or.inl h
          · rintro (rfl | ⟨hj, hlt⟩)
            · exact ⟨hn, Nat.lt_succ_self _⟩
            · exact ⟨hj, Nat.lt_succ_of_lt hlt⟩
        have hnot : n ∉ J.filter (· < n) := fun h => lt_irrefl n (Finset.mem_filter.1 h).2
        rw [hJ, Finset.prod_insert hnot, Finset.prod_insert hnot]
        have hset : Finset.univ.filter (fun π => ∀ j ∈ J, j < n + 1 → S.Hit (T j) j π)
            = Finset.univ.filter (fun π => (∀ j ∈ J, j < n → S.Hit (T j) j π) ∧ S.Hit (T n) n π) := by
          refine Finset.filter_congr (fun π _ => ⟨fun h => ⟨fun j hj hlt => h j hj (Nat.lt_succ_of_lt hlt),
            h n hn (Nat.lt_succ_self n)⟩, fun ⟨h, hn'⟩ j hj hlt => ?_⟩)
          rcases Nat.lt_succ_iff_lt_or_eq.1 hlt with hlt | rfl
          · exact h j hj hlt
          · exact hn'
        rw [hset]
        have hstep := S.card_step_le n (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π)
          (fun π π' h hF j hj hlt => (S.hit_congr (T j) hlt h).1 (hF j hj hlt)) (T n) (a n) (b n) (hT n hn)
        have hstep' : (Finset.univ.filter (fun π => (∀ j ∈ J, j < n → S.Hit (T j) j π) ∧ S.Hit (T n) n π)).card
            * b n ≤ a n * (Finset.univ.filter (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π)).card := by
          convert hstep using 3 <;> ext <;> simp
        set X := (Finset.univ.filter (fun π => (∀ j ∈ J, j < n → S.Hit (T j) j π) ∧ S.Hit (T n) n π)).card
        set Y := (Finset.univ.filter (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π)).card
        calc X * (b n * ∏ j ∈ J.filter (· < n), b j) = (X * b n) * ∏ j ∈ J.filter (· < n), b j := by ring
          _ ≤ (a n * Y) * ∏ j ∈ J.filter (· < n), b j := Nat.mul_le_mul_right _ hstep'
          _ = a n * (Y * ∏ j ∈ J.filter (· < n), b j) := by ring
          _ ≤ a n * ((∏ j ∈ J.filter (· < n), a j) * Fintype.card (Oracle α)) := Nat.mul_le_mul_left _ ih
          _ = (a n * ∏ j ∈ J.filter (· < n), a j) * Fintype.card (Oracle α) := by ring
      · have hJ : J.filter (· < n + 1) = J.filter (· < n) := by
          refine Finset.filter_congr (fun j hj => ⟨fun hlt => ?_, fun hlt => Nat.lt_succ_of_lt hlt⟩)
          rcases Nat.lt_succ_iff_lt_or_eq.1 hlt with hlt | rfl
          · exact hlt
          · exact absurd hj hn
        have hset : Finset.univ.filter (fun π => ∀ j ∈ J, j < n + 1 → S.Hit (T j) j π)
            = Finset.univ.filter (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π) := by
          refine Finset.filter_congr (fun π _ => ⟨fun h j hj hlt => h j hj (Nat.lt_succ_of_lt hlt),
            fun h j hj hlt => ?_⟩)
          rcases Nat.lt_succ_iff_lt_or_eq.1 hlt with hlt | rfl
          · exact h j hj hlt
          · exact absurd hj hn
        rw [hJ, hset]
        exact ih
  have hN : ∀ j ∈ J, j < J.sup id + 1 := fun j hj => Nat.lt_succ_of_le (Finset.le_sup (f := id) hj)
  have hJ : J.filter (· < J.sup id + 1) = J := Finset.filter_true_of_mem hN
  have hset : Finset.univ.filter (fun π => ∀ j ∈ J, j < J.sup id + 1 → S.Hit (T j) j π)
      = Finset.univ.filter (fun π => ∀ j ∈ J, S.Hit (T j) j π) :=
    Finset.filter_congr (fun π _ => ⟨fun h j hj => h j hj (hN j hj), fun h j hj _ => h j hj⟩)
  have := key (J.sup id + 1)
  rwa [hJ, hset] at this

/-- **The product bound as a probability**: `prob (every j ∈ J hits) ≤ ∏ a j / b j` (each `b j > 0`). -/
theorem prob_hits_le (J : Finset ℕ) (T : ℕ → History α → (q : Qry α) → Finset (α q.1)) (a b : ℕ → ℕ)
    (hT : ∀ j ∈ J, ∀ h q, (T j h q).card * b j ≤ a j * (Fintype.card (α q.1) - j))
    (hb : ∀ j ∈ J, 0 < b j) :
    prob (fun π => ∀ j ∈ J, S.Hit (T j) j π) ≤ ∏ j ∈ J, ((a j : ℝ≥0∞) / b j) := by
  classical
  have hc := S.card_hits_le J T a b hT
  set X := (Finset.univ.filter (fun π => ∀ j ∈ J, S.Hit (T j) j π)).card
  have hX : prob (fun π => ∀ j ∈ J, S.Hit (T j) j π) = (X : ℝ≥0∞) / Fintype.card (Oracle α) := by
    unfold prob; congr 3; ext π; simp
  rw [hX]
  have hΩ0 : (Fintype.card (Oracle α) : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (Oracle α) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hB0 : ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast (Finset.prod_pos hb).ne'
  have hBt : ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hprod : ∏ j ∈ J, ((a j : ℝ≥0∞) / b j) = ((∏ j ∈ J, a j : ℕ) : ℝ≥0∞) / ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) := by
    simp only [div_eq_mul_inv, Finset.prod_mul_distrib, Nat.cast_prod]
    rw [ENNReal.prod_inv_distrib]
    intro i _ j _ _
    exact Or.inr (ENNReal.natCast_ne_top _)
  rw [hprod, ENNReal.div_le_iff hΩ0 hΩt]
  rw [show ((∏ j ∈ J, a j : ℕ) : ℝ≥0∞) / ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) * (Fintype.card (Oracle α) : ℝ≥0∞)
      = ((∏ j ∈ J, a j : ℕ) : ℝ≥0∞) * (Fintype.card (Oracle α) : ℝ≥0∞) / ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) by
    rw [div_eq_mul_inv, div_eq_mul_inv]; ring]
  rw [ENNReal.le_div_iff_mul_le (Or.inl hB0) (Or.inl hBt)]
  exact_mod_cast hc

end Strategy

end Oracle

end LazyPerm

end


/-! ════ LazyPermRounds ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace LazyPerm

/-- A parallel round program over queries `Q` and answers `A`: Pous's `OracleProg` with `M.Qry = Q`, `M.Ans = A`. -/
inductive RProg (Q A X : Type) where
  | ret : X → RProg Q A X
  | round : List Q → (List A → RProg Q A X) → RProg Q A X

namespace RProg

variable {Q A X : Type}

/-- The queries on the path taken when queries are answered by `f`, each with its round (from 0). -/
def trace (f : Q → A) : RProg Q A X → List (ℕ × Q)
  | ret _ => []
  | round qs k => qs.map (fun x => (0, x)) ++ (trace f (k (qs.map f))).map fun e => (e.1 + 1, e.2)

/-- The current round's queries. -/
def qs : RProg Q A X → List Q
  | ret _ => []
  | round qs _ => qs

/-- Continue on one round of answers. -/
def feed : RProg Q A X → List A → RProg Q A X
  | ret x, _ => ret x
  | round _ k, as => k as

/-- The program after `ρ` rounds answered by `f`. -/
def after (f : Q → A) : ℕ → RProg Q A X → RProg Q A X
  | 0, P => P
  | ρ + 1, P => after f ρ (P.feed (P.qs.map f))

/-- The queries of round `ρ` when queries are answered by `f`. -/
def roundQs (f : Q → A) (P : RProg Q A X) (ρ : ℕ) : List Q := (P.after f ρ).qs


theorem roundQs_succ (f : Q → A) (P : RProg Q A X) (ρ : ℕ) :
    P.roundQs f (ρ + 1) = (P.feed (P.qs.map f)).roundQs f ρ := rfl

/-- **A thread's round-`ρ` queries are its `trace` entries at round `ρ`**, in order. -/
theorem roundQs_eq_trace (f : Q → A) (P : RProg Q A X) (ρ : ℕ) :
    P.roundQs f ρ = (P.trace f).filterMap (fun e => if e.1 = ρ then some e.2 else none) := by
  induction P generalizing ρ with
  | ret x =>
    have h : ∀ ρ, (ret x : RProg Q A X).roundQs f ρ = [] := by
      intro ρ
      induction ρ with
      | zero => rfl
      | succ ρ ih => exact ih
    rw [h]; rfl
  | round qs k ih =>
    cases ρ with
    | zero =>
      simp only [roundQs, after, RProg.qs, trace, List.filterMap_append, List.filterMap_map]
      have h1 : List.filterMap ((fun e : ℕ × Q => if e.1 = 0 then some e.2 else none) ∘ fun x => (0, x)) qs = qs := by
        rw [show ((fun e : ℕ × Q => if e.1 = 0 then some e.2 else none) ∘ fun x => (0, x)) = some from rfl,
          List.filterMap_some]
      have h2 : List.filterMap ((fun e : ℕ × Q => if e.1 = 0 then some e.2 else none) ∘ fun e => (e.1 + 1, e.2))
          (trace f (k (qs.map f))) = [] := by
        rw [List.filterMap_eq_nil_iff]
        intro e _
        simp
      rw [h1, h2, List.append_nil]
    | succ ρ =>
      rw [roundQs_succ]
      simp only [RProg.qs, feed, trace, List.filterMap_append, List.filterMap_map]
      have h1 : List.filterMap ((fun e : ℕ × Q => if e.1 = ρ + 1 then some e.2 else none) ∘ fun x => (0, x)) qs
          = [] := by
        rw [List.filterMap_eq_nil_iff]
        intro e _
        simp
      rw [h1, List.nil_append, ih]
      congr 1
      funext e
      simp only [Function.comp_apply, Nat.add_right_cancel_iff]

end RProg

section Rounds

variable {θ Q A X : Type} [DecidableEq θ]

/-- One global round: every thread's current queries, threads in `ths` order. -/
def roundList (ths : List θ) (cur : θ → RProg Q A X) : List Q := ths.flatMap fun t => (cur t).qs

/-- Feed a flat list of answers, given in `roundList` order: each thread continues on its own chunk. -/
def feedAll : List θ → (θ → RProg Q A X) → List A → (θ → RProg Q A X)
  | [], cur, _ => cur
  | t :: ts, cur, as =>
    feedAll ts (Function.update cur t ((cur t).feed (as.take (cur t).qs.length))) (as.drop (cur t).qs.length)

/-- The next thread query, given the answers so far (flat, in schedule order), within `D` rounds. -/
def schedNext (ths : List θ) : ℕ → (θ → RProg Q A X) → List A → Option Q
  | 0, _, _ => none
  | D + 1, cur, as =>
    if as.length < (roundList ths cur).length then (roundList ths cur)[as.length]?
    else schedNext ths D (feedAll ths cur (as.take (roundList ths cur).length))
      (as.drop (roundList ths cur).length)

/-- The thread queries of `D` rounds when queries are answered by `f`, in schedule order. -/
def roundsSeq (ths : List θ) (f : Q → A) : ℕ → (θ → RProg Q A X) → List Q
  | 0, _ => []
  | D + 1, cur => roundList ths cur ++ roundsSeq ths f D (feedAll ths cur ((roundList ths cur).map f))

variable {ι : Type} {α : ι → Type}

/-- **Round-by-round strategy.** The threads `P t` (`t ∈ ths`) run for `D` rounds. Each query `q : Q` is asked as
`enc q`, and each answer is read back through `dec`. Then `tail` chooses the queries. -/
def Strategy.ofRounds (ths : List θ) (D : ℕ) (P : θ → RProg Q A X) (enc : Q → Qry α) (dec : Entry α → A)
    (tail : History α → Option (Qry α)) : Strategy α where
  next h := match schedNext ths D P (h.map dec) with
    | some q => some (enc q)
    | none => tail h


theorem feedAll_apply {ths : List θ} (hnd : ths.Nodup) (cur : θ → RProg Q A X) (f : Q → A) (t : θ) :
    feedAll ths cur ((roundList ths cur).map f) t
      = if t ∈ ths then (cur t).feed ((cur t).qs.map f) else cur t := by
  induction ths generalizing cur with
  | nil => simp [feedAll]
  | cons u us ih =>
    rw [List.nodup_cons] at hnd
    simp only [feedAll, roundList, List.flatMap_cons, List.map_append]
    rw [List.take_left' (by rw [List.length_map]), List.drop_left' (by rw [List.length_map])]
    have hrl : us.flatMap (fun t => (Function.update cur u ((cur u).feed ((cur u).qs.map f)) t).qs)
        = us.flatMap (fun t => (cur t).qs) :=
      List.flatMap_congr (fun t ht => by rw [Function.update_of_ne (ne_of_mem_of_not_mem ht hnd.1)])
    have := ih hnd.2 (Function.update cur u ((cur u).feed ((cur u).qs.map f)))
    simp only [roundList] at this
    rw [hrl] at this
    rw [this]
    by_cases htu : t = u
    · subst htu
      simp [hnd.1]
    · simp only [Function.update_of_ne htu, List.mem_cons, htu, false_or]

theorem schedNext_roundsSeq (ths : List θ) (f : Q → A) :
    ∀ (D : ℕ) (cur : θ → RProg Q A X) (n : ℕ), n < (roundsSeq ths f D cur).length →
      schedNext ths D cur (((roundsSeq ths f D cur).take n).map f) = (roundsSeq ths f D cur)[n]? := by
  intro D
  induction D with
  | zero => intro cur n hn; simp [roundsSeq] at hn
  | succ D ih =>
    intro cur n hn
    simp only [roundsSeq] at hn ⊢
    rw [schedNext]
    have ih' := ih (feedAll ths cur ((roundList ths cur).map f))
    generalize roundsSeq ths f D (feedAll ths cur ((roundList ths cur).map f)) = rest at hn ih' ⊢
    generalize roundList ths cur = L at hn ih' ⊢
    rw [List.length_append] at hn
    by_cases hnL : n < L.length
    · have hlen : (((L ++ rest).take n).map f).length = n := by
        rw [List.length_map, List.length_take, List.length_append]; omega
      rw [ite_eq_left (by rw [hlen]; exact hnL), hlen, List.getElem?_append_left hnL]
    · push Not at hnL
      have hlen : (((L ++ rest).take n).map f).length = n := by
        rw [List.length_map, List.length_take, List.length_append]; omega
      rw [ite_eq_right (by rw [hlen]; omega)]
      have htake : (((L ++ rest).take n).map f).take L.length = L.map f := by
        rw [← List.map_take, List.take_take, min_eq_left hnL, List.take_left' rfl]
      have hdrop : (((L ++ rest).take n).map f).drop L.length = (rest.take (n - L.length)).map f := by
        rw [← List.map_drop, List.drop_take, List.drop_left' rfl]
      rw [htake, hdrop, ih' (n - L.length) (by omega), List.getElem?_append_right hnL]


/-- The entry a query makes against `π`. -/
def qEntry (π : Oracle α) (enc : Q → Qry α) (q : Q) : Entry α := ⟨enc q, ans π (enc q)⟩

namespace Strategy

variable (ths : List θ) (D : ℕ) (P : θ → RProg Q A X) (enc : Q → Qry α) (dec : Entry α → A)
  (tail : History α → Option (Qry α))

/-- **The thread phase.** With `f q = dec (enc q, its answer)`, the history after `n` steps, for `n` up to the length
of `roundsSeq`, is the first `n` queries of `roundsSeq`, each with its answer. -/
theorem ofRounds_hist (π : Oracle α) :
    ∀ n ≤ (roundsSeq ths (fun q => dec (qEntry π enc q)) D P).length,
      (ofRounds ths D P enc dec tail).hist π n
        = ((roundsSeq ths (fun q => dec (qEntry π enc q)) D P).take n).map (qEntry π enc) := by
  intro n
  induction n with
  | zero => intro _; rfl
  | succ n ih =>
    intro hn
    set R := roundsSeq ths (fun q => dec (qEntry π enc q)) D P
    have ihn := ih (Nat.le_of_succ_le hn)
    have hnext : (ofRounds ths D P enc dec tail).next ((ofRounds ths D P enc dec tail).hist π n)
        = some (enc R[n]) := by
      rw [ihn]
      show (match schedNext ths D P (((R.take n).map (qEntry π enc)).map dec) with
        | some q => some (enc q) | none => tail _) = _
      rw [List.map_map]
      have := schedNext_roundsSeq ths (fun q => dec (qEntry π enc q)) D P n hn
      rw [show (dec ∘ qEntry π enc) = (fun q => dec (qEntry π enc q)) from rfl, this, List.getElem?_eq_getElem hn]
    rw [hist_succ_of_some _ hnext, ihn, List.take_add_one, List.map_append, List.getElem?_eq_getElem hn]
    rfl

/-- The strategy's query at step `n` of the thread phase is `enc` of the `n`-th query of `roundsSeq`. -/
theorem ofRounds_next (π : Oracle α) {n : ℕ} (hn : n < (roundsSeq ths (fun q => dec (qEntry π enc q)) D P).length) :
    (ofRounds ths D P enc dec tail).next ((ofRounds ths D P enc dec tail).hist π n)
      = some (enc (roundsSeq ths (fun q => dec (qEntry π enc q)) D P)[n]) := by
  rw [ofRounds_hist ths D P enc dec tail π n hn.le]
  show (match schedNext ths D P ((((roundsSeq ths _ D P).take n).map (qEntry π enc)).map dec) with
    | some q => some (enc q) | none => tail _) = _
  rw [List.map_map]
  rw [show (dec ∘ qEntry π enc) = (fun q => dec (qEntry π enc q)) from rfl,
    schedNext_roundsSeq ths (fun q => dec (qEntry π enc q)) D P n hn, List.getElem?_eq_getElem hn]


end Strategy

/-- **Where each thread's round-`ρ` queries sit.** `roundsSeq` lists, for `ρ = 0, …, D−1` and within a round for `t`
in `ths` order, thread `t`'s round-`ρ` queries (`RProg.roundQs_eq_trace`: its trace entries at round `ρ`). -/
theorem roundsSeq_eq {ths : List θ} (hnd : ths.Nodup) (f : Q → A) :
    ∀ (D : ℕ) (cur : θ → RProg Q A X),
      roundsSeq ths f D cur = (List.range D).flatMap (fun ρ => ths.flatMap (fun t => (cur t).roundQs f ρ)) := by
  intro D
  induction D with
  | zero => intro cur; rfl
  | succ D ih =>
    intro cur
    rw [roundsSeq, ih, List.range_succ_eq_map, List.flatMap_cons, List.flatMap_map]
    congr 1
    refine List.flatMap_congr (fun ρ _ => List.flatMap_congr (fun t ht => ?_))
    rw [feedAll_apply hnd cur f t, ite_eq_left ht]
    rfl

end Rounds

end LazyPerm

end


/-! ════ P3Concrete.P3ChainLazy ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge
open scoped ENNReal

noncomputable section


section Family

variable (n wc : ℕ)

/-- The component index: `P`'s tweaks, and `Π₂`. -/
abbrev P3Idx : Type := Tweak n ⊕ Unit

/-- The component types: labels for a tweak, `Π₂` states for `()`. -/
abbrev P3Alpha : P3Idx n → Type :=
  fun i => Sum.elim (fun _ => Lab n wc) (fun _ => Bits (n * wc + (n * wc + 512))) i

instance instFintypeAlpha (i : P3Idx n) : Fintype (P3Alpha n wc i) :=
  match i with
  | .inl _ => inferInstanceAs (Fintype (Lab n wc))
  | .inr _ => inferInstanceAs (Fintype (Bits (n * wc + (n * wc + 512))))

instance instDecEqAlpha (i : P3Idx n) : DecidableEq (P3Alpha n wc i) :=
  match i with
  | .inl _ => inferInstanceAs (DecidableEq (Lab n wc))
  | .inr _ => inferInstanceAs (DecidableEq (Bits (n * wc + (n * wc + 512))))

instance instInhabitedAlpha (i : P3Idx n) : Inhabited (P3Alpha n wc i) :=
  match i with
  | .inl _ => ⟨fun _ _ => false⟩
  | .inr _ => ⟨fun _ => false⟩

/-- **The primitives as a family of permutations.** -/
def omegaEquiv : P3COmega n wc ≃ LazyPerm.Oracle (P3Alpha n wc) where
  toFun ω := fun i => match i with
    | .inl T => ω.1 T
    | .inr () => ω.2
  invFun o := (fun T => o (.inl T), o (.inr ()))
  left_inv _ := rfl
  right_inv o := by
    funext i
    rcases i with T | ⟨⟩ <;> rfl

theorem pr_eq_prob {Ω : Type} [Fintype Ω] (E : Ω → Prop) : pr E = LazyPerm.prob E := rfl

/-- **Probabilities move to the lazy family.** -/
theorem pr_transport (E : LazyPerm.Oracle (P3Alpha n wc) → Prop) :
    pr (fun ω : P3COmega n wc => E (omegaEquiv n wc ω)) = LazyPerm.prob E := by
  rw [pr_eq_prob]
  exact LazyPerm.prob_congr (omegaEquiv n wc) E

/-- **Probabilities over `P3COmega` are probabilities over the lazy family.** -/
theorem pr_transport' (F : P3COmega n wc → Prop) :
    pr F = LazyPerm.prob fun o => F ((omegaEquiv n wc).symm o) := by
  rw [← pr_transport]
  simp only [Equiv.symm_apply_apply]

end Family


section Queries

variable (n wc : ℕ)

/-- `p3ChainModel`'s queries in the family. -/
def enc : (p3ChainModel n wc).Qry → LazyPerm.Qry (P3Alpha n wc)
  | .inl (.inl x) => ⟨.inr (), .inl x⟩
  | .inl (.inr y) => ⟨.inr (), .inr y⟩
  | .inr (T, .inl a) => ⟨.inl T, .inl a⟩
  | .inr (T, .inr z) => ⟨.inl T, .inr z⟩

/-- A lazy answer, back in `p3ChainModel`'s answer type. -/
def dec : LazyPerm.Entry (P3Alpha n wc) → (p3ChainModel n wc).Ans
  | ⟨⟨.inl _, _⟩, a⟩ => .inr a
  | ⟨⟨.inr _, _⟩, a⟩ => .inl a

/-- **Decoding the lazy answer is the model's answer.** -/
theorem dec_qEntry (ω : P3COmega n wc) (q : (p3ChainModel n wc).Qry) :
    dec n wc (LazyPerm.qEntry (omegaEquiv n wc ω) (enc n wc) q) = (p3ChainModel n wc).answer ω q := by
  rcases q with (x | y) | ⟨T, a | z⟩ <;> rfl

end Queries


/-- An `OracleProg` as a lazy round program. -/
def toRProg {M : IdealModel} {X : Type} : OracleProg M X → LazyPerm.RProg M.Qry M.Ans X
  | .ret x => .ret x
  | .round qs k => .round qs (fun as => toRProg (k as))

theorem trace_toRProg {M : IdealModel} {X : Type} (f : M.Qry → M.Ans) (P : OracleProg M X) :
    (toRProg P).trace f = Tr.trace f P := by
  induction P with
  | ret x => rfl
  | round qs k ih => simp [toRProg, LazyPerm.RProg.trace, Tr.trace, ih]


section Labeller

variable {n wc : ℕ}

/-- Sequencing programs. -/
def pbind {M : IdealModel} {X Y : Type} : OracleProg M X → (X → OracleProg M Y) → OracleProg M Y
  | .ret x, g => g x
  | .round qs k, g => .round qs fun as => pbind (k as) g

/-- One forward `Π₂` query. -/
def p2Fwd (x : Bits (n * wc + (n * wc + 512))) : OracleProg (p3ChainModel n wc) (Bits (n * wc + (n * wc + 512))) :=
  .round [.inl (.inl x)] fun as => .ret (match as.headD (.inl x) with
    | .inl y => y
    | .inr _ => x)

/-- One forward `P_T` query. -/
def pFwd (T : Tweak n) (a : Lab n wc) : OracleProg (p3ChainModel n wc) (Lab n wc) :=
  .round [.inr (T, .inl a)] fun as => .ret (match as.headD (.inr a) with
    | .inr c => c
    | .inl _ => a)

/-- An overwrite chain from `h`, one forward `Π₂` query per block; returns the last dropped part (the key). -/
def chainProg (h : Bits (n * wc + 512)) (r : Bits (n * wc)) :
    List (Bits (n * wc)) → OracleProg (p3ChainModel n wc) (Bits (n * wc))
  | [] => .ret r
  | b :: bs => pbind (p2Fwd (Fin.append b h)) fun y => chainProg (ovH y) (ovR y) bs

/-- A row: its chain from its IV over `labs`' parents, then the forward `P` query on `pinOf key`. -/
def rowProg (tag : Bits 256) (G : TopoDAG n) (L : Fin 2) (v : Fin n) (labs : Fin n → Lab n wc)
    (pinOf : Lab n wc → Lab n wc) : OracleProg (p3ChainModel n wc) (Lab n wc) :=
  pbind (chainProg (iv (domP3 tag L v)) (fun _ => false) (rowBlocks labs G v)) fun r =>
    pFwd (tag, L, v) (pinOf ((codeEquiv n wc).symm r))

/-- A layer, rows `k, k+1, …, n − 1` in order, accumulating the labels. -/
def layerProg (tag : Bits 256) (G : TopoDAG n) (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc) :
    (k : ℕ) → (Fin n → Lab n wc) → OracleProg (p3ChainModel n wc) (Fin n → Lab n wc)
  | k, acc =>
    if hk : k < n then
      pbind (rowProg tag G L ⟨k, hk⟩ acc (pinOf ⟨k, hk⟩)) fun c =>
        layerProg tag G L pinOf (k + 1) (Function.update acc ⟨k, hk⟩ c)
    else .ret acc
  termination_by k => n - k

/-- **`layerProg`'s unfolding equation.** Stating it here generates `layerProg.eq_1` and `layerProg.eq_def` in this
module, so modules that import it and `rw [layerProg]` reuse them instead of generating their own. -/
theorem layerProg_eq (tag : Bits 256) (G : TopoDAG n) (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc) (k : ℕ)
    (acc : Fin n → Lab n wc) :
    layerProg tag G L pinOf k acc =
      if hk : k < n then
        pbind (rowProg tag G L ⟨k, hk⟩ acc (pinOf ⟨k, hk⟩)) fun c =>
          layerProg tag G L pinOf (k + 1) (Function.update acc ⟨k, hk⟩ c)
      else .ret acc :=
  layerProg.eq_1 tag G L pinOf k acc


/-- **The honest labeller**: the lower layer (`pin1 = W ⊕ key¹`), then the top layer (`pin2 = transpose(c¹) ⊕ key²`). -/
def labProg (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc) : OracleProg (p3ChainModel n wc) Unit :=
  pbind (layerProg tag G 0 (fun v key => labXor (W v) key) 0 fun _ _ _ => false) fun c1 =>
    pbind (layerProg tag G 1 (fun v key => labXor (transpose c1 v) key) 0 fun _ _ _ => false) fun _ => .ret ()

end Labeller


section Strategy

variable {n wc : ℕ}

/-- The answer the history gives to a query, if it holds that query. -/
def histAns (h : LazyPerm.History (P3Alpha n wc)) (q : LazyPerm.Qry (P3Alpha n wc)) : Option (P3Alpha n wc q.1) :=
  h.findSome? fun e => if hq : e.1 = q then some (hq ▸ e.2) else none

/-- A model answer read off the history (a default when absent). -/
def ansOf (h : LazyPerm.History (P3Alpha n wc)) (q : (p3ChainModel n wc).Qry) : (p3ChainModel n wc).Ans :=
  dec n wc ⟨enc n wc q, (histAns h (enc n wc q)).getD default⟩


end Strategy

end

end Pous.P3Concrete

end


/-! ════ P3ConcreteMulti.JointLazy ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

noncomputable section

variable {N n wc : ℕ}

/-- The labellers of the segments in `ss`, in order. -/
def segsProg (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) :
    List (Fin N) → OracleProg (p3ChainModel n wc) Unit
  | [] => .ret ()
  | s :: ss => pbind (labProg (tags s) G (W s)) fun _ => segsProg tags G W ss

/-- **All segments' honest labellers**, in segment order. -/
def labProgJ (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) : OracleProg (p3ChainModel n wc) Unit :=
  segsProg tags G W (List.finRange N)

/-- **A labeller tail for any program**: replay `p` against the history, and ask its first query the history lacks. -/
def tailOf (p : OracleProg (p3ChainModel n wc) Unit) (h : LazyPerm.History (P3Alpha n wc)) :
    Option (LazyPerm.Qry (P3Alpha n wc)) :=
  (((Tr.trace (ansOf h) p).map Prod.snd).find? fun q => (histAns h (enc n wc q)).isNone).map (enc n wc)


/-- **The joint threads**: every program `(s, v)`, segment by segment. -/
def jointThreads (N n : ℕ) : List (Fin N × Fin n) := List.finRange N ×ˢ List.finRange n

theorem jointThreads_nodup : (jointThreads N n).Nodup :=
  (List.nodup_finRange N).product (List.nodup_finRange n)

theorem mem_jointThreads (i : Fin N × Fin n) : i ∈ jointThreads N n :=
  List.mem_product.2 ⟨List.mem_finRange _, List.mem_finRange _⟩

/-- **The 14 GB store's lazy strategy**: the `N·n` programs round by round for `D` rounds, then all `N` labellers. -/
def jointStrategy (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D : ℕ) : LazyPerm.Strategy (P3Alpha n wc) :=
  LazyPerm.Strategy.ofRounds (jointThreads N n) D (fun i => toRProg (A i.1 i.2)) (enc n wc) (dec n wc)
    (tailOf (labProgJ tags G W))


end

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.JointSteps ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete LazyPerm
open scoped ENNReal

noncomputable section


section Steps

variable {ι : Type} {α : ι → Type} (S : Strategy α) (π : Oracle α)

/-- Once the strategy stops, its history stays. -/
theorem hist_stuck {k : ℕ} (h : S.next (S.hist π k) = none) : ∀ j, k ≤ j → S.hist π j = S.hist π k := by
  intro j hj
  induction j, hj using Nat.le_induction with
  | base => rfl
  | succ j _ ih => rw [S.hist_succ_of_none (by rw [ih]; exact h), ih]

/-- **If step `j` asks a query, the history at `j` has length `j`.** -/
theorem hist_length_of_next {j : ℕ} {q : Qry α} (h : S.next (S.hist π j) = some q) : (S.hist π j).length = j := by
  have hall : ∀ k < j, ∃ q', S.next (S.hist π k) = some q' := by
    intro k hk
    cases hq : S.next (S.hist π k) with
    | none =>
      rw [hist_stuck S π hq j hk.le, hq] at h
      exact absurd h (by simp)
    | some q' => exact ⟨q', rfl⟩
  have : ∀ k ≤ j, (S.hist π k).length = k := by
    intro k hk
    induction k with
    | zero => rfl
    | succ k ih =>
      obtain ⟨q', hq'⟩ := hall k (by omega)
      rw [S.hist_succ_of_some hq', List.length_append, ih (by omega)]
      rfl
  exact this j le_rfl

/-- **A history-length bound bounds the steps that ask a query.** -/
theorem step_lt_of_length_le (L : ℕ) (hL : ∀ j, (S.hist π j).length ≤ L) {j : ℕ} {q : Qry α}
    (h : S.next (S.hist π j) = some q) : j < L := by
  have h1 := hist_length_of_next S π h
  have h2 := hL (j + 1)
  rw [S.hist_succ_of_some h, List.length_append, h1] at h2
  simp only [List.length_singleton] at h2
  omega

end Steps


theorem trace_pairwise {M : IdealModel} {X : Type} (f : M.Qry → M.Ans) (P : OracleProg M X) :
    (Tr.trace f P).Pairwise (fun a b => a.1 ≤ b.1) := by
  induction P with
  | ret a => simp [Tr.trace]
  | round qs k ih =>
    simp only [Tr.trace]
    refine List.pairwise_append.2 ⟨?_, ?_, ?_⟩
    · rw [List.pairwise_map]
      exact List.pairwise_of_forall fun _ _ => le_rfl
    · rw [List.pairwise_map]
      exact (ih (qs.map f)).imp fun h => Nat.succ_le_succ h
    · intro a ha b _
      obtain ⟨x, _, rfl⟩ := List.mem_map.1 ha
      exact Nat.zero_le _


section Tail

variable {n wc : ℕ}

/-- The model's true answers, read off the lazy oracle. -/
def trueAns (π : Oracle (P3Alpha n wc)) : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans :=
  fun q => dec n wc (qEntry π (enc n wc) q)

theorem trueAns_eq (ω : P3COmega n wc) : trueAns (omegaEquiv n wc ω) = (p3ChainModel n wc).answer ω :=
  funext (dec_qEntry n wc ω)

theorem histAns_none_iff (h : History (P3Alpha n wc)) (x : Qry (P3Alpha n wc)) :
    histAns h x = none ↔ ∀ e ∈ h, e.1 ≠ x := by
  unfold histAns
  rw [List.findSome?_eq_none_iff]
  refine forall₂_congr fun e _ => ?_
  constructor
  · intro he hx
    simp [hx] at he
  · intro hx
    simp [hx]

theorem histAns_some_eq {π : Oracle (P3Alpha n wc)} (h : History (P3Alpha n wc)) (hcons : ∀ e ∈ h, e.2 = ans π e.1)
    {x : Qry (P3Alpha n wc)} {a : P3Alpha n wc x.1} (ha : histAns h x = some a) : a = ans π x := by
  unfold histAns at ha
  obtain ⟨e, he, hfe⟩ := List.exists_of_findSome?_eq_some ha
  split at hfe
  · rename_i hq
    obtain ⟨q, b⟩ := e
    subst hq
    simp only [Option.some.injEq] at hfe
    rw [← hfe]
    exact hcons _ he
  · exact absurd hfe (by simp)

/-- A query the history answers is answered truly by `ansOf`. -/
theorem ansOf_eq {π : Oracle (P3Alpha n wc)} (h : History (P3Alpha n wc)) (hcons : ∀ e ∈ h, e.2 = ans π e.1)
    {q : (p3ChainModel n wc).Qry} (hq : (histAns h (enc n wc q)).isNone = false) : ansOf h q = trueAns π q := by
  cases ha : histAns h (enc n wc q) with
  | none => rw [ha] at hq; simp at hq
  | some a =>
    have := histAns_some_eq h hcons ha
    unfold ansOf trueAns qEntry
    rw [ha, Option.getD_some, this]

/-- **The tail's query is a new query on `p`'s true trace.** -/
theorem tailOf_some {π : Oracle (P3Alpha n wc)} (p : OracleProg (p3ChainModel n wc) Unit) (h : History (P3Alpha n wc))
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) {x : Qry (P3Alpha n wc)} (hx : tailOf p h = some x) :
    ∃ q, x = enc n wc q ∧ q ∈ (Tr.trace (trueAns π) p).map Prod.snd ∧ histAns h (enc n wc q) = none := by
  unfold tailOf at hx
  obtain ⟨q, hfind, rfl⟩ := Option.map_eq_some_iff.1 hx
  obtain ⟨hpq, as, bs, hl, hbefore⟩ := List.find?_eq_some_iff_append.1 hfind
  refine ⟨q, rfl, ?_, Option.isNone_iff_eq_none.1 hpq⟩
  obtain ⟨l1, l2, htr, hl1, hl2⟩ := List.map_eq_append_iff.1 hl
  obtain ⟨e, l3, rfl, he, -⟩ := List.map_eq_cons_iff.1 hl2
  have hsorted := trace_pairwise (ansOf h) p
  rw [htr] at hsorted
  have hagree : Tr.AgreeBefore (ansOf h) (trueAns π) p e.1 := by
    intro e' he' hlt
    rw [htr] at he'
    rcases List.mem_append.1 he' with h1 | h1
    · have hmem : e'.2 ∈ as := hl1 ▸ List.mem_map_of_mem h1
      have := hbefore _ hmem
      simp only [Bool.not_eq_true'] at this
      exact ansOf_eq h hcons this
    · rcases List.mem_cons.1 h1 with h2 | h2
      · subst h2; exact absurd hlt (lt_irrefl _)
      · have := (List.pairwise_append.1 hsorted).2.1
        exact absurd ((List.pairwise_cons.1 this).1 e' h2) (not_le.2 hlt)
  have hidx : (Tr.trace (ansOf h) p)[l1.length]? = some e := by
    rw [htr, List.getElem?_append_right le_rfl, Nat.sub_self]
    rfl
  have := (Tr.trace_stable (ansOf h) (trueAns π) p e.1 hagree).1 l1.length e hidx le_rfl
  rw [← he]
  exact List.mem_map_of_mem (List.mem_of_getElem? this)

variable {θ X : Type} [DecidableEq θ]


end Tail


section Threads

theorem list_sum_range (g : ℕ → ℕ) (D : ℕ) : ((List.range D).map g).sum = ∑ ρ ∈ Finset.range D, g ρ := by
  rw [← List.sum_toFinset _ (List.nodup_range), List.toFinset_range]

theorem sum_filterMap_round_le {Q : Type} (l : List (ℕ × Q)) (D : ℕ) :
    ∑ ρ ∈ Finset.range D, (l.filterMap fun e => if e.1 = ρ then some e.2 else none).length ≤ l.length := by
  induction l with
  | nil => simp
  | cons e l ih =>
    have hsplit : ∀ ρ, ((e :: l).filterMap fun e => if e.1 = ρ then some e.2 else none).length =
        (if e.1 = ρ then 1 else 0) + (l.filterMap fun e => if e.1 = ρ then some e.2 else none).length := by
      intro ρ
      by_cases h : e.1 = ρ
      · simp only [List.filterMap_cons, h, ↓reduceIte, List.length_cons]; omega
      · simp only [List.filterMap_cons, h, ↓reduceIte, zero_add]
    rw [Finset.sum_congr rfl fun ρ _ => hsplit ρ, Finset.sum_add_distrib, Finset.sum_ite_eq, List.length_cons]
    split_ifs <;> omega

theorem list_sum_comm {α β : Type} (L1 : List α) (L2 : List β) (g : β → α → ℕ) :
    (L1.map fun a => (L2.map fun b => g b a).sum).sum = (L2.map fun b => (L1.map fun a => g b a).sum).sum := by
  induction L1 with
  | nil => simp
  | cons a L1 ih =>
    simp only [List.map_cons, List.sum_cons, ih]
    rw [← List.sum_map_add]

variable {θ Q A X : Type} [DecidableEq θ]

/-- **The thread phase has at most the threads' total work.** -/
theorem roundsSeq_length_le (ths : List θ) (hnd : ths.Nodup) (f : Q → A) (D : ℕ) (P : θ → RProg Q A X) :
    (roundsSeq ths f D P).length ≤ (ths.map fun t => ((P t).trace f).length).sum := by
  rw [roundsSeq_eq hnd f D P, List.length_flatMap]
  simp only [List.length_flatMap, RProg.roundQs_eq_trace]
  rw [list_sum_comm]
  refine List.sum_le_sum fun t _ => ?_
  rw [list_sum_range]
  exact sum_filterMap_round_le _ D

end Threads


section Labeller

variable {n wc : ℕ}

theorem work_pbind {M : IdealModel} {X Y : Type} (f : M.Qry → M.Ans) (p : OracleProg M X) (g : X → OracleProg M Y) :
    (pbind p g).work f = p.work f + (g (p.run f)).work f := by
  induction p with
  | ret x => show (g x).work f = 0 + (g x).work f; omega
  | round qs k ih =>
    show qs.length + (pbind (k (qs.map f)) g).work f = (qs.length + (k (qs.map f)).work f) + _
    rw [ih]
    show _ = _ + (g ((k (qs.map f)).run f)).work f
    omega

theorem work_p2Fwd (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (x : Bits (n * wc + (n * wc + 512))) :
    (p2Fwd x).work f = 1 := rfl

theorem work_pFwd (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (T : Tweak n) (a : Lab n wc) :
    (pFwd T a).work f = 1 := rfl

theorem work_chainProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) :
    ∀ (bs : List (Bits (n * wc))) (h : Bits (n * wc + 512)) (r : Bits (n * wc)), (chainProg h r bs).work f = bs.length
  | [], _, _ => rfl
  | b :: bs, h, r => by
    show (pbind (p2Fwd (Fin.append b h)) fun y => chainProg (ovH y) (ovR y) bs).work f = _
    rw [work_pbind, work_p2Fwd, work_chainProg f bs, List.length_cons]
    omega

theorem work_rowProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tag : Bits 256) (G : TopoDAG n)
    (L : Fin 2) (v : Fin n) (labs : Fin n → Lab n wc) (pinOf : Lab n wc → Lab n wc) :
    (rowProg tag G L v labs pinOf).work f = ovCalls G v + 1 := by
  show (pbind (chainProg (iv (domP3 tag L v)) (fun _ => false) (rowBlocks labs G v)) fun r =>
    pFwd (tag, L, v) (pinOf ((codeEquiv n wc).symm r))).work f = _
  rw [work_pbind, work_chainProg, work_pFwd, rowBlocks_length]

theorem ovCalls_le_succ (G : TopoDAG n) (v : Fin n) : ovCalls G v ≤ v.val + 1 := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]
  have : (G.par v).card ≤ v.val :=
    calc (G.par v).card ≤ (Finset.range v.val).card :=
          Finset.card_le_card_of_injOn (fun u => u.val)
            (fun u hu => Finset.mem_range.2 (Fin.lt_def.1 (G.par_lt v u hu))) (fun a _ b _ h => Fin.ext h)
      _ = v.val := Finset.card_range _
  omega

theorem work_layerProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tag : Bits 256) (G : TopoDAG n)
    (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc) :
    ∀ (k : ℕ) (acc : Fin n → Lab n wc), (layerProg tag G L pinOf k acc).work f ≤ ∑ v ∈ Finset.Ico k n, (v + 2) := by
  intro k
  induction h : n - k generalizing k with
  | zero =>
    intro acc
    rw [layerProg_eq]
    split_ifs with hk
    · omega
    · exact Nat.zero_le _
  | succ d ih =>
    intro acc
    have hk : k < n := by omega
    rw [layerProg_eq]
    split_ifs
    rw [work_pbind, work_rowProg, Finset.sum_eq_sum_Ico_succ_bot hk]
    have h1 := ovCalls_le_succ G ⟨k, hk⟩
    have h2 := ih (k + 1) (by omega) (Function.update acc ⟨k, hk⟩
      ((rowProg tag G L ⟨k, hk⟩ acc (pinOf ⟨k, hk⟩)).run f))
    simp only at h1
    omega

theorem sum_Ico_two (n : ℕ) : (∑ v ∈ Finset.Ico 0 n, (v + 2)) * 2 = n * (n + 1) + 2 * n := by
  rw [Nat.Ico_zero_eq_range, Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul, add_mul,
    Finset.sum_range_id_mul_two]
  cases n with
  | zero => rfl
  | succ k => simp only [Nat.succ_sub_one]; ring

/-- **One segment's labeller asks at most `n(n+1) + 2n` queries.** -/
theorem work_labProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tag : Bits 256) (G : TopoDAG n)
    (W : Fin n → Lab n wc) : (labProg tag G W).work f ≤ n * (n + 1) + 2 * n := by
  show (pbind (layerProg tag G 0 (fun v key => labXor (W v) key) 0 fun _ _ _ => false) fun c1 =>
    pbind (layerProg tag G 1 (fun v key => labXor (transpose c1 v) key) 0 fun _ _ _ => false)
      fun _ => .ret ()).work f ≤ _
  rw [work_pbind, work_pbind]
  have h1 := work_layerProg f tag G 0 (fun v key => labXor (W v) key) 0 fun _ _ _ => false
  have h2 := work_layerProg f tag G 1
    (fun v key => labXor (transpose ((layerProg tag G 0 (fun v key => labXor (W v) key) 0 fun _ _ _ => false).run f)
      v) key) 0 fun _ _ _ => false
  have h3 := sum_Ico_two n
  have h4 : (OracleProg.ret () : OracleProg (p3ChainModel n wc) Unit).work f = 0 := rfl
  rw [h4]
  omega

variable {N : ℕ}

theorem work_segsProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) :
    ∀ ss : List (Fin N), (segsProg tags G W ss).work f ≤ ss.length * (n * (n + 1) + 2 * n)
  | [] => Nat.zero_le _
  | s :: ss => by
    show (pbind (labProg (tags s) G (W s)) fun _ => segsProg tags G W ss).work f ≤ _
    rw [work_pbind, List.length_cons, Nat.add_mul, one_mul]
    have := work_labProg f (tags s) G (W s)
    have := work_segsProg f tags G W ss
    omega

/-- **All `N` labellers ask at most `N·(n(n+1) + 2n)` queries.** -/
theorem work_labProgJ (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) : (labProgJ tags G W).work f ≤ N * (n * (n + 1) + 2 * n) := by
  have := work_segsProg f tags G W (List.finRange N)
  rwa [List.length_finRange] at this

end Labeller


end

