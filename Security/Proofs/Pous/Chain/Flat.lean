namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open Pous.BandChain.KeyRule
open scoped ENNReal

/-- The one fixed-advice probability statement proved by the v6 attribution. -/
def BandFreshTail : Prop :=
  ∀ (B ℓ c s : ℕ) (R : ChainReplay B ℓ c), (∀ i, (R.P i).Bounded R.D R.Q) →
    pr (fun π => (s : ℚ) < (R.v6Seeds π).size c ℓ ∧ R.NoCollU π) ≤
      2 * (((nPos B R.Q ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * s)

theorem v6_tail_rhs_ge_one {M ℓ s : ℕ} (hM : 1 ≤ M) (h : 2 ^ ℓ ≤ M) :
    1 ≤ 2 * ((M ^ (s + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * s) := by
  have hp : 2 ^ (ℓ * s) ≤ M ^ (s + 1) := by
    calc
      2 ^ (ℓ * s) = (2 ^ ℓ) ^ s := by rw [pow_mul]
      _ ≤ M ^ s := Nat.pow_le_pow_left h s
      _ ≤ M ^ (s + 1) := Nat.pow_le_pow_right hM (Nat.le_succ s)
  rw [ENNReal.le_div_iff_mul_le (Or.inl (by positivity)) (Or.inl (by simp)), one_mul]
  calc
    (2 : ℝ≥0∞) ^ (ℓ * s) = ((2 ^ (ℓ * s) : ℕ) : ℝ≥0∞) := by push_cast; ring
    _ ≤ ((M ^ (s + 1) : ℕ) : ℝ≥0∞) := by exact_mod_cast hp
    _ ≤ 2 * ((M ^ (s + 1) : ℕ) : ℝ≥0∞) :=
      le_mul_of_one_le_left' (by norm_num)

theorem v6Seeds_size_zero (R : ChainReplay 0 ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (R.v6Seeds π).size c ℓ = 0 := by
  have hv := R.v6SeedsThrough_valid π (R.D + 1)
  have hl := R.v6SeedsThrough_labs_empty π (R.D + 1)
  have hh : (R.v6Seeds π).hs = ∅ := by
    ext q
    simp only [Finset.notMem_empty, iff_false]
    exact fun _ => q.1.elim0
  have hr : (R.v6Seeds π).rs = ∅ := by
    ext q
    simp only [Finset.notMem_empty, iff_false]
    exact fun _ => q.1.elim0
  unfold ChainReplay.v6Seeds at hh hr ⊢
  unfold ChainKnow.size
  rw [hl, hh, hr]
  simp

/-- Everything after charge-pin attribution: G1 coding, G3 all-size summation, and the
trivial branch produce the fixed-advice tail. -/
theorem bandFreshTail_v6_of_pattern_fibers (hF : V6PatternFibers) : BandFreshTail := by
  intro B ℓ c s R hP
  rcases Nat.eq_zero_or_pos B with rfl | hB
  · refine (pr_mono (Q := fun _ => False) fun π h => ?_).trans (le_of_eq_of_le (by rw [pr_def]; simp) zero_le)
    have hs := v6Seeds_size_zero R π
    linarith
  let M := R.v6M
  have hn : 1 ≤ nPos B R.Q := by
    unfold nPos
    have : 1 ≤ B * (R.Q + 1) :=
      Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
    omega
  have hM2 : 2 ≤ M := by
    unfold M ChainReplay.v6M
    have hprod : 0 < nPos B R.Q ^ 2 * B :=
      Nat.mul_pos (pow_pos (by omega) 2) hB
    omega
  have hn2 : 2 ≤ nPos B R.Q := by
    unfold nPos
    have h1 : 1 ≤ B * (R.Q + 1) :=
      Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
    have h2 : 1 ≤ B * (B + 1) / 2 := by
      rw [Nat.le_div_iff_mul_le (by norm_num : 0 < 2)]
      nlinarith
    omega
  have hM4 : 4 ≤ M := by
    unfold M ChainReplay.v6M
    nlinarith
  by_cases htriv : 2 ^ ℓ ≤ M
  · exact (PousThm1Dense.pr_le_one _).trans
      (by simpa [M, ChainReplay.v6M, pow_mul] using
        (v6_tail_rhs_ge_one (M := M) (ℓ := ℓ) (s := s)
          (by omega) htriv))
  · push Not at htriv
    obtain ⟨K, E, hcover, hsmall, hlarge⟩ := hF B ℓ c s R hP hB htriv
    have hℓ : 1 ≤ ℓ := by
      by_contra h
      have : ℓ = 0 := by omega
      subst ℓ
      simp at htriv
      omega
    have hMeven : Even M := by
      refine ⟨nPos B R.Q ^ 2 * B, ?_⟩
      simp [M, ChainReplay.v6M]
      ring
    have hPeven : Even (2 ^ ℓ) := by
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hℓ
      refine ⟨2 ^ k, ?_⟩
      rw [show 1 + k = k + 1 by omega, pow_succ]
      ring
    have hgap : M + 2 ≤ 2 ^ ℓ := by
      rcases hMeven with ⟨m, hm⟩
      rcases hPeven with ⟨p, hp⟩
      omega
    have hb := band_tail_of_pattern_fibers M (2 ^ ℓ) s K hM4
      (by positivity) hgap E
      (fun π => (s : ℚ) < (R.v6Seeds π).size c ℓ ∧ R.NoCollU π)
      hcover hsmall hlarge
    calc
      _ ≤ 2 * (((M : ℕ) : ℝ≥0∞) ^ (s + 1) / ((2 ^ ℓ : ℕ) : ℝ≥0∞) ^ s) := hb
      _ = _ := by
        rw [← mul_div_assoc]
        congr 1
        · simp [M, ChainReplay.v6M]
        · push_cast
          rw [pow_mul]

/-- **The v6 per-advice tail**, from the (c′) fixed-pattern fibers. -/
theorem bandFreshTail_v6 : BandFreshTail :=
  bandFreshTail_v6_of_pattern_fibers v6_pattern_fibers

/-- The fixed-advice v6 tail gives the exact key-rule ex-post-facto statement. -/
theorem chainExPostFactoG'_of_v6_tail (hT : BandFreshTail) : ChainExPostFactoG' := by
  intro B ℓ c m s D Q k G dom Wb hdom hard A₁ A₂ hA
  classical
  let R : Bits m → ChainReplay B ℓ c := fun σ => ⟨G, dom, Wb, D, Q, A₂ σ⟩
  let σ₀ : Bits m := fun _ => false
  let win : Equiv.Perm (Bits (ℓ + (ℓ + c))) → Prop := fun π =>
    k ≤ (Finset.univ.filter fun i =>
      (A₂ (A₁ π) i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG G π dom Wb i).card
  have hsub : ∀ π, win π →
      (R σ₀).Bad π ∨ ∃ σ : Bits m,
        ((s : ℚ) < ((R σ).v6Seeds π).size c ℓ ∧ (R σ).NoCollU π) := by
    intro π hw
    by_cases hnc : (R σ₀).NoCollU π
    · right
      refine ⟨A₁ π, (R (A₁ π)).size_v6Seeds_gt (fun i => hA (A₁ π) i) hard hw, ?_⟩
      simpa [R, ChainReplay.NoCollU, ChainReplay.xin, ChainReplay.chainInputList] using hnc
    · exact Or.inl hnc
  have hsplit : pr win ≤ pr (fun π => ∃ σ : Bits m,
      ((s : ℚ) < ((R σ).v6Seeds π).size c ℓ ∧ (R σ).NoCollU π)) +
      pr (fun π => (R σ₀).Bad π) := by
    refine (pr_mono hsub).trans ?_
    simpa [add_comm] using pr_or_le
      (fun π => (R σ₀).Bad π)
      (fun π => ∃ σ : Bits m,
        ((s : ℚ) < ((R σ).v6Seeds π).size c ℓ ∧ (R σ).NoCollU π))
  have htail : pr (fun π => ∃ σ : Bits m,
      ((s : ℚ) < ((R σ).v6Seeds π).size c ℓ ∧ (R σ).NoCollU π)) ≤
      2 ^ m * (2 * (((nPos B Q ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) /
        2 ^ (ℓ * s)) := by
    rw [show (fun π => ∃ σ : Bits m,
        ((s : ℚ) < ((R σ).v6Seeds π).size c ℓ ∧ (R σ).NoCollU π)) =
      (fun π => ∃ σ ∈ (Finset.univ : Finset (Bits m)),
        ((s : ℚ) < ((R σ).v6Seeds π).size c ℓ ∧ (R σ).NoCollU π)) by
          funext π; apply propext; simp]
    refine (PousThm1Dense.pr_exists_le (Finset.univ : Finset (Bits m))
      (fun σ π => (s : ℚ) < ((R σ).v6Seeds π).size c ℓ ∧ (R σ).NoCollU π)).trans ?_
    calc
      ∑ σ ∈ (Finset.univ : Finset (Bits m)),
          pr (fun π => (s : ℚ) < ((R σ).v6Seeds π).size c ℓ ∧ (R σ).NoCollU π)
        ≤ ∑ _σ ∈ (Finset.univ : Finset (Bits m)),
          (2 * (((nPos B Q ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) /
            2 ^ (ℓ * s)) :=
          Finset.sum_le_sum fun σ _ => hT B ℓ c s (R σ) (fun i => hA σ i)
      _ = _ := by
        rw [Finset.sum_const, Finset.card_univ, Birthday.card_bits, nsmul_eq_mul]
        push_cast
        rfl
  have hcoll : pr (fun π => (R σ₀).Bad π) ≤
      (((nPos B Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c) :=
    (R σ₀).pr_Bad_le hdom
  refine (hsplit.trans (add_le_add htail hcoll)).trans (le_of_eq ?_)
  have heq :
      2 ^ m * (2 * (((nPos B Q ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) /
        2 ^ (ℓ * s)) =
      2 ^ m * 2 * (((nPos B Q ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) /
        2 ^ (ℓ * s) := by
    rw [← mul_div_assoc]
    congr 1
    ring
  rw [heq]

theorem chainExPostFactoG_of_v6_tail (hT : BandFreshTail) : ChainExPostFactoG :=
  chainExPostFactoG_of_chainExPostFactoG' (chainExPostFactoG'_of_v6_tail hT)

theorem chainExPostFactoG'_v6 : ChainExPostFactoG' :=
  chainExPostFactoG'_of_v6_tail bandFreshTail_v6

theorem chainExPostFactoG_v6 : ChainExPostFactoG :=
  chainExPostFactoG_of_v6_tail bandFreshTail_v6

end PousSpongeChain

end


