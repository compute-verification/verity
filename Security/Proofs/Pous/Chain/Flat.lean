      obtain ⟨hkQ, te, hte, hteτ, hv⟩ := R.commit_h_obs hsrc
      have hk' : ¬ ob.2.val = R.Q := by omega
      obtain ⟨hsf, hsq⟩ := R.slotFwd_of_tr hte
      have hacc : ∀ ins : V6Instr B, ins.src ≠ .run → ¬ NeedsAns ins.src te.2 →
