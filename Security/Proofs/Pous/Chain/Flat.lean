/-! ════ ChainEPFV6Round ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm
open Pous.BandChain.KeyRule

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- A seed atom's coordinate in a holding. -/
def AtomIn : VAtom B → ChainKnow B → Prop
  | .r q, K => q ∈ K.rs
  | .h q, K => q ∈ K.hs

theorem atomIn_mono {a : VAtom B} {K K' : ChainKnow B} (h : Le K K')
    (ha : AtomIn a K) : AtomIn a K' := by
  cases a with
  | r q => exact h.2.2 ha
  | h q => exact h.2.1 ha

theorem atomIn_of_mem_seedAtoms {H : ChainKnow B} (hlab : H.labs = ∅) {a : VAtom B}
    (ha : a ∈ R.seedAtoms H) : AtomIn a H := by
  classical
  unfold seedAtoms at ha
  rw [hlab, Finset.image_empty, Finset.union_empty] at ha
  rcases Finset.mem_union.1 ha with ha | ha
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.1 ha
    exact hq
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.1 ha
    exact (Finset.mem_filter.1 hq).1

theorem mem_seedAtoms_of_atomIn {H : ChainKnow B} {a : VAtom B} (hv : R.atomValid a)
    (ha : AtomIn a H) : a ∈ R.seedAtoms H := by
  classical
  unfold seedAtoms
  rcases a with ⟨q⟩ | ⟨q⟩
  · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_image.2 ⟨q, ha, rfl⟩))
  · have hq1 := (R.mem_posSet.1 hv).1
    exact Finset.mem_union_right _
      (Finset.mem_image.2 ⟨q, Finset.mem_filter.2 ⟨ha, by omega⟩, rfl⟩)


theorem le_read'_v6 (K : ChainKnow B) : Le K (read' R.G K) :=
  ⟨Finset.subset_union_left, subset_rfl, Finset.subset_union_left⟩

theorem read'_pad_lab (K : ChainKnow B) {u : Fin B}
    (hu : (u, ovCalls R.G u) ∈ (read' R.G K).rs) : u ∈ (read' R.G K).labs := by
  rw [mem_read'_rs] at hu
  rw [mem_read'_labs]
  rcases hu with hu | ⟨v, hv, heq⟩
  · exact Or.inr hu
  · have huv : u = v := congrArg Prod.fst heq
    subst huv
    exact Or.inl hv

theorem le_vcStepAt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ρ : ℕ) (K : ChainKnow B) :
    Le K (R.vcStepAt π ρ K) :=
  ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left⟩

theorem vcStepAt_mono (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ρ : ℕ) {K K' : ChainKnow B}
    (h : Le K K') : Le (R.vcStepAt π ρ K) (R.vcStepAt π ρ K') := by
  classical
  refine ⟨fun u hu => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · simp only [vcStepAt, Finset.mem_union, Finset.mem_filter, Finset.mem_univ,
      true_and] at hu ⊢
    rcases hu with hu | ⟨q, hqh, hqr, hq⟩
    · exact Or.inl (h.1 hu)
    · exact Or.inr ⟨q, h.2.1 hqh, h.2.2 hqr, hq⟩
  · simp only [vcStepAt, Finset.mem_union, Finset.mem_filter] at hq ⊢
    rcases hq with hq | ⟨hpos, hq⟩
    · exact Or.inl (h.2.1 hq)
    · refine Or.inr ⟨hpos, ?_⟩
      rcases hq with ⟨hrev, hc⟩ | ⟨hn, hrev, hh, hr⟩
      · exact Or.inl ⟨hrev, canCall_mono h hc⟩
      · exact Or.inr ⟨hn, hrev, h.2.1 hh, h.2.2 hr⟩
  · simp only [vcStepAt, Finset.mem_union, Finset.mem_filter] at hq ⊢
    rcases hq with hq | ⟨hpos, hrev, hc⟩
    · exact Or.inl (h.2.2 hq)
    · exact Or.inr ⟨hpos, hrev, canCall_mono h hc⟩

theorem vcCredit_mono_H (R : ChainReplay B ℓ c) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ τ {H H' : ChainKnow B}, Le H H' → Le (R.vcCredit π τ H) (R.vcCredit π τ H')
  | 0, _, _, h => read'_mono R.G h
  | τ + 1, _, _, h => read'_mono R.G (R.vcStepAt_mono π τ (R.vcCredit_mono_H π τ h))

theorem le_vcCredit (R : ChainReplay B ℓ c) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (H : ChainKnow B) :
    ∀ τ, Le H (R.vcCredit π τ H)
  | 0 => R.le_read'_v6 H
  | τ + 1 => (R.le_vcCredit π H τ).trans ((R.le_vcStepAt π τ _).trans (R.le_read'_v6 _))

theorem vcCredit_mono_round (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (H : ChainKnow B)
    {ρ τ : ℕ} (h : ρ ≤ τ) : Le (R.vcCredit π ρ H) (R.vcCredit π τ H) := by
  induction h with
  | refl => exact Le.rfl' _
  | step _ ih => exact ih.trans ((R.le_vcStepAt π _ _).trans (R.le_read'_v6 _))

theorem vcCredit_pad_lab (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (H : ChainKnow B) :
    ∀ τ {u : Fin B}, (u, ovCalls R.G u) ∈ (R.vcCredit π τ H).rs →
      u ∈ (R.vcCredit π τ H).labs
  | 0, _, hu => R.read'_pad_lab H hu
  | _ + 1, _, hu => R.read'_pad_lab _ hu


theorem atomIn_seedBasisStep_self (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ)
    (H : ChainKnow B) (x : VCommit B R.Q) :
    AtomIn x.atom (R.vcCredit π τ (R.seedBasisStep π τ H x)) := by
  classical
  have hle : Le H (R.seedBasisStep π τ H x) := le_union_left _ _
  rcases x with ⟨o, ⟨q⟩ | ⟨q⟩⟩
  · show q ∈ (R.vcCredit π τ (R.seedBasisStep π τ H ⟨o, .r q⟩)).rs
    by_cases hq : q ∈ (R.vcCredit π τ H).rs
    · exact (R.vcCredit_mono_H π τ hle).2.2 hq
    · apply (R.le_vcCredit π _ τ).2.2
      simp [seedBasisStep, PousSpongeChain.ChainKnow.union,
        PousSpongeChain.ChainKnow.fresh, shownCommit, hq]
  · show q ∈ (R.vcCredit π τ (R.seedBasisStep π τ H ⟨o, .h q⟩)).hs
    by_cases hq : q ∈ (R.vcCredit π τ H).hs
    · exact (R.vcCredit_mono_H π τ hle).2.1 hq
    · apply (R.le_vcCredit π _ τ).2.1
      simp [seedBasisStep, PousSpongeChain.ChainKnow.union,
        PousSpongeChain.ChainKnow.fresh, shownCommit, hq]

theorem atomIn_seedBasisStep {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {τ : ℕ}
    {H : ChainKnow B} {x : VCommit B R.Q} {a : VAtom B}
    (h : AtomIn a (R.seedBasisStep π τ H x)) :
    AtomIn a H ∨ (x.atom = a ∧ ¬ AtomIn a (R.vcCredit π τ H)) := by
  classical
  rcases x with ⟨o, ⟨qx⟩ | ⟨qx⟩⟩ <;> rcases a with ⟨q⟩ | ⟨q⟩ <;>
    simp [AtomIn, seedBasisStep, PousSpongeChain.ChainKnow.union,
      PousSpongeChain.ChainKnow.fresh, shownCommit] at h ⊢
  · rcases h with h | ⟨rfl, h⟩
    · exact Or.inl h
    · exact Or.inr ⟨rfl, h⟩
  · exact h
  · exact h
  · rcases h with h | ⟨rfl, h⟩
    · exact Or.inl h
    · exact Or.inr ⟨rfl, h⟩

theorem atomIn_vcCredit_recordsFold (R : ChainReplay B ℓ c) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ (l : List (ℕ × (ℕ × VCommit B R.Q))) (H : ChainKnow B),
      ∀ rec ∈ l, AtomIn rec.2.2.atom (R.vcCredit π rec.2.1
        (l.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2) H))
  | [], _, _, h => absurd h List.not_mem_nil
  | y :: l, H, rec, hrec => by
      rw [List.foldl_cons]
      rcases List.mem_cons.1 hrec with rfl | hrec
      · exact atomIn_mono (R.vcCredit_mono_H π _ (R.le_recordsFold π l _))
          (R.atomIn_seedBasisStep_self π _ H _)
      · exact R.atomIn_vcCredit_recordsFold π l _ rec hrec

/-- The record that first adds an atom, with the credit it was fresh against. -/
theorem recordsFold_fresh (R : ChainReplay B ℓ c) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ (l : List (ℕ × (ℕ × VCommit B R.Q))) (H : ChainKnow B) {a : VAtom B},
      AtomIn a (l.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2) H) →
      AtomIn a H ∨ ∃ pre rec post, l = pre ++ rec :: post ∧ rec.2.2.atom = a ∧
        ¬ AtomIn a (R.vcCredit π rec.2.1
          (pre.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2) H)) ∧
        AtomIn a ((pre ++ [rec]).foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2) H)
  | [], _, _, h => Or.inl h
  | rec :: l, H, a, h => by
      rw [List.foldl_cons] at h
      rcases R.recordsFold_fresh π l _ h with h | ⟨pre, src, post, heq, hatom, hfresh, hmem⟩
      · rcases R.atomIn_seedBasisStep h with h | ⟨hatom, hfresh⟩
        · exact Or.inl h
        · exact Or.inr ⟨[], rec, l, rfl, hatom, by simpa using hfresh, by simpa using h⟩
      · exact Or.inr ⟨rec :: pre, src, post, by simp [heq], hatom,
          by simpa using hfresh, by simpa using hmem⟩

theorem showRecords_round_pairwise (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (R.showRecords π).Pairwise (fun x y => x.2.1 ≤ y.2.1) := by
  unfold showRecords
  rw [List.pairwise_flatMap]
  constructor
  · intro τ _
    rw [List.pairwise_map]
    exact List.pairwise_of_forall fun _ _ => le_rfl
  · rw [List.pairwise_iff_getElem]
    intro i j hi hj hij
    simp only [List.length_range, List.getElem_range] at hi hj ⊢
    intro x hx y hy
    obtain ⟨x, _, rfl⟩ := List.mem_map.1 hx
    obtain ⟨y, _, rfl⟩ := List.mem_map.1 hy
    simp only
    omega

theorem mem_showRecords_of {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {τ : ℕ} (hτ : τ ≤ R.D)
    {x : VCommit B R.Q} (hx : x ∈ R.basisAt π τ) :
    (R.commitCut π τ x, (τ, x)) ∈ R.showRecords π :=
  List.mem_flatMap.2 ⟨τ, List.mem_range.2 (by omega), List.mem_map.2 ⟨x, hx, rfl⟩⟩

/-- A show from an earlier round is already in the credit the later record was fresh against. -/
theorem atomIn_pre_of_shown {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {pre post : List (ℕ × (ℕ × VCommit B R.Q))} {rec : ℕ × (ℕ × VCommit B R.Q)}
    (heq : R.showRecords π = pre ++ rec :: post)
    {ρ : ℕ} (hρ : ρ ≤ R.D) (hlt : ρ < rec.2.1) {x : VCommit B R.Q}
    (hx : x ∈ R.basisAt π ρ) :
    AtomIn x.atom (R.vcCredit π ρ
      (pre.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2)
        PousSpongeChain.ChainKnow.empty)) := by
  have hmem := R.mem_showRecords_of hρ hx
  have hs := R.showRecords_round_pairwise π
  rw [heq] at hs hmem
  have hpre : (R.commitCut π ρ x, (ρ, x)) ∈ pre := by
    rcases List.mem_append.1 hmem with h | h
    · exact h
    · exfalso
      have hs' := (List.pairwise_append.1 hs).2.1
      rcases List.mem_cons.1 h with h | h
      · rw [← h] at hlt
        exact lt_irrefl _ hlt
      · have := (List.pairwise_cons.1 hs').1 _ h
        simp only at this
        omega
  exact R.atomIn_vcCredit_recordsFold π pre _ _ hpre


theorem advThenLab_hist_roundStart_src (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {τ : ℕ} (hτ : τ ≤ R.D)
    (hm : R.roundStart π τ ≤ R.programSteps π)
    {e : Entry (BandAlpha ℓ c)}
    (he : e ∈ R.advThenLab.hist (fun _ : Unit => π) (R.roundStart π τ)) :
    ∃ i, ∃ te ∈ R.tr π i, te.1 < τ ∧ e = qEntry (fun _ : Unit => π) bandEnc te.2 := by
  let pre := (List.range τ).flatMap fun ρ =>
    (List.finRange B).flatMap fun i =>
      (toRProgI (R.P i)).roundQs (bandAnswer π) ρ
  have hprelen : pre.length = R.roundStart π τ :=
    (R.sc_roundStart_eq_advPrefix hP π τ).symm
  have hseq : R.advSeq π = pre ++
      ((List.range (R.D - τ)).map (τ + ·)).flatMap (fun ρ =>
        (List.finRange B).flatMap fun i =>
          (toRProgI (R.P i)).roundQs (bandAnswer π) ρ) := by
    unfold advSeq pre
    conv_lhs =>
      rw [show R.D = τ + (R.D - τ) by omega,
        List.range_add, List.flatMap_append]
  unfold advThenLab at he
  rw [Strategy.ofRounds_hist _ _ _ _ _ _ _ _ (by
    simpa [programSteps] using hm)] at he
  change e ∈ ((R.advSched (fun _ : Unit => π)).take (R.roundStart π τ)).map
      (qEntry (fun _ : Unit => π) bandEnc) at he
  rw [R.advSched_eq_advSeq, hseq, ← hprelen, List.take_left] at he
  obtain ⟨d, hd, rfl⟩ := List.mem_map.1 he
  obtain ⟨ρ, hρ, hd⟩ := List.mem_flatMap.1 hd
  obtain ⟨i, -, hd⟩ := List.mem_flatMap.1 hd
  rw [LazyPerm.RProg.roundQs_eq_trace, R.advTrace_eq] at hd
  obtain ⟨te, hte, hsome⟩ := List.mem_filterMap.1 hd
  split at hsome
  · rename_i hteρ
    obtain rfl := Option.some.inj hsome
    exact ⟨i, te, hte, by rw [hteρ]; exact List.mem_range.1 hρ, rfl⟩
  · simp at hsome

theorem qEntry_inpAt_eq {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {d : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))} {X : Bits (ℓ + (ℓ + c))}
    (h : (qEntry (fun _ : Unit => π) bandEnc d).inpAt () = some X) :
    d = .inl X ∨ d = .inr (π X) := by
  rcases d with x | y
  · left
    simp [qEntry, bandEnc, Entry.inpAt, Entry.inp] at h
    rw [h]
  · right
    simp [qEntry, bandEnc, Entry.inpAt, Entry.inp, ans] at h
    rw [← h]
    simp

theorem mem_queryBasisAt_of_tr (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {i : Fin B} {k : ℕ}
    {te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))}
    (hk : (R.tr π i)[k]? = some te) :
    ∃ hkQ : k < R.Q,
      (.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩) : R.Pos) ∈ R.queryBasisAt π te.1 := by
  have hklen : k < (R.tr π i).length := (List.getElem?_eq_some_iff.1 hk).1
  have hkQ : k < R.Q := lt_of_lt_of_le hklen (R.tr_length_le hP π i)
  refine ⟨hkQ, ?_⟩
  unfold queryBasisAt
  refine List.mem_flatMap.2 ⟨i, List.mem_finRange _, List.mem_filterMap.2 ⟨(te, k), ?_, ?_⟩⟩
  · exact List.mem_zipIdx_iff_getElem?.2 hk
  · simp [hkQ]

theorem commit_mem_basisAt {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {τ : ℕ} {o : R.Pos}
    (ho : o ∈ R.queryBasisAt π τ) {b : VAtom B} (hb : R.atomValid b)
    (hm : R.commitMatches π τ ⟨o, b⟩) :
    (⟨o, b⟩ : VCommit B R.Q) ∈ R.basisAt π τ := by
  classical
  unfold basisAt
  refine List.mem_flatMap.2 ⟨o, List.mem_append_left _ ho,
    List.mem_filterMap.2 ⟨b, ?_, by simp [hm]⟩⟩
  unfold atomBasis
  rcases b with ⟨q⟩ | ⟨q⟩ <;>
    exact List.mem_flatMap.2 ⟨q, Finset.mem_toList.2 hb, by simp⟩


/-- Any causal source is in a round no earlier than the selected one. -/
theorem sourceCommitRound_le_of_causal
    (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)
    (a : {a // a ∈ R.realizedSeeds s π}) {d τ : ℕ} {x : VCommit B R.Q}
    (hx : R.CausalSource hP s π hcross a d τ x) :
    R.sourceCommitRound hP s π hcross a ≤ τ := by
  have hd := R.firstSourceCut_min hP s π hcross a hx
  have hs := R.sourceCommit_full_spec hP s π hcross a
  by_contra hlt
  have hlt' : τ + 1 ≤ R.sourceCommitRound hP s π hcross a := by omega
  have h0 : R.commitCut π (R.sourceCommitRound hP s π hcross a)
      (R.sourceCommit hP s π hcross a) = R.firstSourceCut hP s π hcross a := hs.2.2.2.1
  have h1 : R.commitCut π τ x = d := hx.2.2.2.1
  have e0 := R.sc_roundStart_succ π (R.sourceCommitRound hP s π hcross a)
  have e1 := R.sc_roundStart_succ π τ
  unfold commitCut at h0 h1
  have m1 := R.sc_roundStart_mono π hlt'
  have m2 := R.sc_roundStart_mono π (Nat.le_succ (R.sourceCommitRound hP s π hcross a))
  have hdd : d = R.firstSourceCut hP s π hcross a := by omega
  have hmin := R.sourceCommitRound_min hP s π hcross a (x := x) (τ := τ) (by rw [← hdd]; exact hx)
  omega

set_option maxHeartbeats 2000000 in
/-- **`sourceRound ≤ chargeRound`, home-pair form.** The selected crediting show's round starts
no later than the first fresh step of the seed's home pair in the truncated run. -/
theorem v6_source_round_le_home_step
    (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)
    (a : {a // a ∈ R.realizedSeeds s π}) :
    R.roundStart π (R.sourceCommitRound hP s π hcross a) ≤
      R.pairStep (R.firstCrossing s π) π a.1.pair := by
  classical
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  have hsrc := R.sourceCommitRound_spec hP s π hcross a
  have hτ₀D : R.sourceCommitRound hP s π hcross a ≤ R.D := hsrc.1
  have hstart : R.roundStart π (R.sourceCommitRound hP s π hcross a) ≤ R.firstCrossing s π := by
    have h := hsrc.2.2.2
    unfold commitCut at h
    omega
  have hva : R.atomValid a.1 := R.realized_atom_valid s π a.2
  have hq : a.1.pair ∈ R.posSet := R.atomValid_pair hva
  by_contra hlt
  have hlt' : R.pairStep (R.firstCrossing s π) π a.1.pair + 1 ≤
      R.roundStart π (R.sourceCommitRound hP s π hcross a) := by omega
  -- The home pair is fixed within the program prefix of the rounds before the source round.
  have hps := R.pairStep_spec π hcut hq
  have hfix : R.xin π a.1.pair.1 a.1.pair.2 ∈
      ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π)
        (R.roundStart π (R.sourceCommitRound hP s π hcross a))).dom () :=
    (R.stratC (R.firstCrossing s π)).dom_mono _ hlt' () hps.2.2
  have hhist := R.sc_stratC_take_eq_advThenLab_hist π hcut hstart
    (le_refl (R.roundStart π (R.sourceCommitRound hP s π hcross a)))
  rw [List.take_of_length_le ((R.stratC _).hist_length_le _ _)] at hhist
  rw [hhist] at hfix
  obtain ⟨e, he, hex⟩ := History.mem_dom.1 hfix
  obtain ⟨i, te, hte, hteρ, rfl⟩ :=
    R.advThenLab_hist_roundStart_src hP π hτ₀D (hstart.trans hcut) he
  have hdir := qEntry_inpAt_eq hex
  obtain ⟨k, hk⟩ : ∃ k, (R.tr π i)[k]? = some te := List.mem_iff_getElem?.1 hte
  obtain ⟨hkQ, hkb⟩ := R.mem_queryBasisAt_of_tr hP π hk
  have hρD : te.1 ≤ R.D := by omega
  have hrev : R.revealedAt π te.1 a.1.pair := by
    refine ⟨i, te, hte, rfl, ?_⟩
    rcases hdir with hd | hd <;> rw [hd] <;> simp [revealPt]
  -- The record that first adds `a`, and its round.
  have hfull : R.seedsAtCut π (R.programSteps π) =
      (R.showRecords π).foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2)
        PousSpongeChain.ChainKnow.empty := by
    unfold seedsAtCut
    rw [if_pos (le_refl _)]
    exact (R.showRecords_fold_eq_v6SeedsThrough π).symm
  have hAin : AtomIn a.1 ((R.showRecords π).foldl
      (fun K x => R.seedBasisStep π x.2.1 K x.2.2) PousSpongeChain.ChainKnow.empty) := by
    rw [← hfull]
    apply R.atomIn_of_mem_seedAtoms (R.seedsAtCut_labs_empty π _)
    exact R.sc_seedAtoms_mono (R.sc_seedsAtCut_mono hP π hcut le_rfl) a.2
  rcases R.recordsFold_fresh π _ _ hAin with h0 | ⟨pre, rec, post, heq, hatom, hfresh, hmem⟩
  · rcases a with ⟨⟨q'⟩ | ⟨q'⟩, _⟩ <;>
      simp [AtomIn, PousSpongeChain.ChainKnow.empty] at h0
  have hrecShow : rec ∈ R.showRecords π := by
    rw [heq]
    exact List.mem_append_right _ List.mem_cons_self
  have hpShow : pre ++ [rec] <+: R.showRecords π := ⟨post, by rw [heq]; simp⟩
  have hpCut : pre ++ [rec] <+:
      (R.showRecords π).filter (fun x => x.1 ≤ rec.1) :=
    R.prefix_filter_of_prefix hpShow (R.prefix_through_le (R.showRecords_pairwise π) heq)
  have hle : Le ((pre ++ [rec]).foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2)
      PousSpongeChain.ChainKnow.empty) (R.seedsAtCut π rec.1) := by
    unfold seedsAtCut
    split
    · rw [← R.showRecords_fold_eq_v6SeedsThrough π]
      exact R.recordsFold_le_of_prefix π hpShow _
    · exact R.recordsFold_le_of_prefix π hpCut _
  unfold showRecords at hrecShow
  obtain ⟨τ₁, hτ₁, hx⟩ := List.mem_flatMap.1 hrecShow
  obtain ⟨x₁, hx₁, hrec⟩ := List.mem_map.1 hx
  subst hrec
  have hτ₁D : τ₁ ≤ R.D := by simp at hτ₁; omega
  have hcs : R.CausalSource hP s π hcross a (R.commitCut π τ₁ x₁) τ₁ x₁ :=
    ⟨hτ₁D, hx₁, hatom, rfl, R.mem_seedAtoms_of_atomIn hva (atomIn_mono hle hmem)⟩
  have hτ₀τ₁ := R.sourceCommitRound_le_of_causal hP s π hcross a hcs
  have hρτ₁ : te.1 < τ₁ := by omega
  -- Round `te.1` already credits `a` before round `τ₁`.
  set Hp := pre.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2)
    PousSpongeChain.ChainKnow.empty with hHp
  have hshown : ∀ b : VAtom B, R.atomValid b →
      R.commitMatches π te.1 ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), b⟩ →
      AtomIn b (R.vcCredit π te.1 Hp) := fun b hb hm =>
    R.atomIn_pre_of_shown (x := ⟨_, b⟩) heq hρD hρτ₁ (R.commit_mem_basisAt hkb hb hm)
  have hcredit : AtomIn a.1 (R.vcCredit π τ₁ Hp) := by
    obtain ⟨hp1, hp⟩ := R.mem_posSet.1 hq
    rcases hdir with hd | hd
    · -- A forward query shows the pair's input atoms; the pair is then credited next round.
      have hcan : (R.vcCredit π te.1 Hp).canCall R.G a.1.pair.1 a.1.pair.2 := by
        refine ⟨hp1, hp, fun u hu => ?_, ?_⟩
        · obtain ⟨p, hpq⟩ : ∃ p, a.1.pair.2 = p + 1 := ⟨a.1.pair.2 - 1, by omega⟩
          have hb := hu
          rw [hpq] at hb
          unfold ovBlock at hb
          simp only [Nat.add_sub_cancel] at hb
          obtain ⟨hpi, hget⟩ := List.getElem?_eq_some_iff.1 hb
          have hovR : ovR (R.xin π a.1.pair.1 a.1.pair.2) =
              labelG R.G (fun x => π x) R.dom R.Wb u := by
            rw [hpq, Reach.ChainReplayR.xin_succ R π a.1.pair.1 p (by omega), ovR_append,
              Reach.ChainReplayR.blks_getElem_parent R π a.1.pair.1 p hpi, hget]
          have hupos : (u, ovCalls R.G u) ∈ R.posSet :=
            R.mem_posSet.2 ⟨by unfold ovCalls; omega, le_rfl⟩
          have hm : R.commitMatches π te.1
              ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), .r (u, ovCalls R.G u)⟩ := by
            unfold commitMatches obsR obsFoldKey
            simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKey]
            rw [hovR, R.label_eq_pad_r π u, PousB5Chain.bxor_cancel]
          exact R.vcCredit_pad_lab π Hp te.1 (hshown (.r (u, ovCalls R.G u)) hupos hm)
        · by_cases h1 : a.1.pair.2 = 1
          · exact Or.inl h1
          · refine Or.inr ?_
            have hprev : (a.1.pair.1, a.1.pair.2 - 1) ∈ R.posSet :=
              R.mem_posSet.2 ⟨by omega, by
                change a.1.pair.2 - 1 ≤ ovCalls R.G a.1.pair.1
                omega⟩
            have hovH : ovH (R.xin π a.1.pair.1 a.1.pair.2) =
                R.hVal π (a.1.pair.1, a.1.pair.2 - 1) := by
              have hxs := Reach.ChainReplayR.xin_succ R π a.1.pair.1 (a.1.pair.2 - 1)
                (by omega)
              rw [Nat.sub_add_cancel hp1] at hxs
              rw [hxs, ovH_append]
              have hs := Reach.ChainReplayR.chainH_succ R π a.1.pair.1 (a.1.pair.2 - 2)
                (by omega)
              have hsEq : a.1.pair.2 - 2 + 1 = a.1.pair.2 - 1 := by omega
              rw [hsEq] at hs
              simpa [hVal] using hs
            have hm : R.commitMatches π te.1
                ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), .h (a.1.pair.1, a.1.pair.2 - 1)⟩ := by
              unfold commitMatches obsKeyH
              simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKeyH]
              rw [hovH]
            exact hshown (.h (a.1.pair.1, a.1.pair.2 - 1)) hprev hm
      have hc := (R.vc_band_complete π te.1 Hp hq hrev).1 hcan
      have hin : AtomIn a.1 (R.vcCredit π (te.1 + 1) Hp) := by
        rcases a with ⟨⟨q'⟩ | ⟨q'⟩, _⟩
        · exact hc.2
        · exact hc.1
      exact atomIn_mono (R.vcCredit_mono_round π Hp hρτ₁) hin
    · -- An inverse query on the pair's output shows the seed itself.
      have hm : R.commitMatches π te.1 ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), a.1⟩ := by
        rcases a with ⟨⟨q'⟩ | ⟨q'⟩, ha⟩
        · unfold commitMatches obsR
          by_cases hpad : q'.2 = ovCalls R.G q'.1
          · simp only [hpad, ↓reduceIte]
            unfold obsFoldKey
            simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKey]
            rfl
          · simp only [hpad, ↓reduceIte, hkQ]
            unfold obsKey
            simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKey]
            rfl
        · unfold commitMatches obsKeyH
          simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKeyH]
          rfl
      exact atomIn_mono (R.vcCredit_mono_round π Hp hρτ₁.le) (hshown _ hva hm)
  exact hfresh hcredit


end ChainReplay

end PousSpongeChain

end


