/-- **Inverse stops with no partner** pin a public constant: `padBlk` or `IV`. -/
theorem sound_stop0 (a : {a // a ∈ R.realizedSeeds s π})
    (hf : R.pairForward (R.firstCrossing s π) π
      (R.pinCell (R.firstCrossing s π) π a.1).pair = false)
    (hpp : R.pinPartner (R.pinCell (R.firstCrossing s π) π a.1) = none) :
    R.SeedSound (R.firstCrossing s π)
      (R.pairStep (R.firstCrossing s π) π (R.pinCell (R.firstCrossing s π) π a.1).pair) π
      (R.v6Code hP s π hcross a) (R.v6Ptr hP s π hcross a) a.1.part := by
  classical
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  have hev := R.realizedSeed_cell_valid s π a
  obtain ⟨q, hq, hfr, hcase, hdir⟩ := R.charge_query π hcut (R.atomValid_pair hev)
  have hqF : qFwd q = false := by rw [← hdir]; exact hf
  have hqi : q = ⟨(), .inr (π (R.xin π (R.pinCell (R.firstCrossing s π) π a.1).pair.1
      (R.pinCell (R.firstCrossing s π) π a.1).pair.2))⟩ := by
    rcases hcase with h | h
    · rw [h] at hqF; simp [qFwd] at hqF
    · exact h
  have hpartE : (R.pinCell (R.firstCrossing s π) π a.1).part = a.1.part := R.pinCell_part _ π a.1
  set e := R.pinCell (R.firstCrossing s π) π a.1 with he_def
  have hptr : R.v6Ptr hP s π hcross a = .inr ⟨e.pair, R.atomValid_pair hev⟩ := by
    simp only [v6Ptr, ← he_def, hf, hpp, Bool.false_eq_true, ↓reduceIte]
  have hcode : R.v6Code hP s π hcross a = (e.part, row0 a.1.pair.1) := by
    simp only [v6Code, ← he_def, hf, hpp, Bool.false_eq_true, ↓reduceIte]
  rw [hptr, hcode]
  have hans : ans (fun _ : Unit => π) q = R.xin π e.pair.1 e.pair.2 := by
    rw [hqi]; exact ans_charge_inv π _
  have hacc : ∀ ins : V6Instr B, R.SlotAccess π 0 ((R.stratC (R.firstCrossing s π)).hist
      (fun _ : Unit => π) (R.pairStep (R.firstCrossing s π) π e.pair)) ins
      (.inr ⟨e.pair, R.atomValid_pair hev⟩) := fun _ => trivial
  have h0 : R.roundStart π 0 = 0 := rfl
  have key : (∃ qe, e = .r qe ∧ qe ∈ R.posSet ∧ ovBlock R.G qe.1 qe.2 = none) ∨
      (∃ qe, e = .h qe ∧ qe ∈ R.posSet ∧ qe.2 = 1) := by
    rcases hec : e with ⟨qe⟩ | ⟨qe⟩
    · have hqe : qe ∈ R.posSet := by rw [hec] at hev; exact hev
      refine Or.inl ⟨qe, rfl, hqe, ?_⟩
      rw [hec] at hpp
      simp only [pinPartner, hqe, if_true] at hpp
      cases hb : ovBlock R.G qe.1 qe.2 with
      | none => rfl
      | some u => rw [hb] at hpp; simp at hpp
    · have hqe : qe ∈ R.posSet := by rw [hec] at hev; exact hev
      refine Or.inr ⟨qe, rfl, hqe, ?_⟩
      rw [hec] at hpp
      simp only [pinPartner] at hpp
      split at hpp
      · simp at hpp
      · rename_i h
        have := (R.mem_posSet.1 hqe).1
        by_contra hne
        exact h ⟨hqe, by omega⟩
  rcases key with ⟨qe, hec, hqe, hb⟩ | ⟨qe, hec, hqe, h1⟩
  · have hep : e.part = .r := by rw [hec]; rfl
    refine R.seedSound_intro hq hfr ⟨.padC, .r, none⟩ ?_ ?_ ?_ 0 (Nat.zero_le _) (by omega)
      (by omega) (hacc _)
    · simp only [v6Decode, hep]
    · rw [← hpartE, hep]
    · simp only [PinReads, readR, hans]
      rw [hec]
      exact R.ovR_xin_pad π hqe hb
  · have hep : e.part = .h := by rw [hec]; rfl
    refine R.seedSound_intro hq hfr ⟨.ivC, .h, none⟩ ?_ ?_ ?_ 0 (Nat.zero_le _) (by omega)
      (by omega) (hacc _)
    · simp only [v6Decode, hep]
    · rw [← hpartE, hep]
    · simp only [PinReads, readH, hans]
      rw [hec]
      exact R.ovH_xin_first π hqe h1

