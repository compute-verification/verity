theorem prefix_filter_of_prefix
    {l pre : List (ℕ × (ℕ × VCommit B R.Q))} {cut : ℕ}
    (hp : pre <+: l) (hall : ∀ x ∈ pre, x.1 ≤ cut) :
    pre <+: l.filter (fun x => x.1 ≤ cut) := by
  obtain ⟨tail, htail⟩ := hp
  rw [← htail, List.filter_append,
    List.filter_eq_self.2 (by
      intro x hx
      simpa using hall x hx)]
  exact List.prefix_append _ _

theorem prefix_through_le
    {l pre post : List (ℕ × (ℕ × VCommit B R.Q))}
    {rec : ℕ × (ℕ × VCommit B R.Q)}
    (hs : l.Pairwise (fun x y => x.1 ≤ y.1))
    (heq : l = pre ++ rec :: post) :
    ∀ x ∈ pre ++ [rec], x.1 ≤ rec.1 := by
  subst l
  have hs' := List.pairwise_append.1 hs
  intro x hx
  rcases List.mem_append.1 hx with hx | hx
  · exact hs'.2.2 x hx rec (List.mem_cons_self)
  · simp only [List.mem_singleton] at hx
    subst x
    exact le_rfl

theorem seedAtCut_r_causal
    (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    {cut : ℕ} (hcut : cut ≤ R.programSteps π) {q : Fin B × ℕ}
    (hq : q ∈ (R.seedsAtCut π cut).rs) :
    ∃ τ ≤ R.D, ∃ x ∈ R.basisAt π τ,
      x.atom = .r q ∧ R.commitCut π τ x ≤ cut ∧
      q ∈ (R.seedsAtCut π (R.commitCut π τ x)).rs := by
  classical
  let l :=
    if R.programSteps π ≤ cut then R.showRecords π
    else (R.showRecords π).filter fun x => x.1 ≤ cut
  have hl :
      R.seedsAtCut π cut =
        l.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2)
          PousSpongeChain.ChainKnow.empty := by
    unfold seedsAtCut l
    split
    · exact (R.showRecords_fold_eq_v6SeedsThrough π).symm
    · rfl
  have hqFold : q ∈
      (l.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2)
        PousSpongeChain.ChainKnow.empty).rs := by
    rwa [← hl]
  rcases R.recordsFold_r_causal π l PousSpongeChain.ChainKnow.empty
      hqFold with hq0 | ⟨pre, rec, post, heq, hatom, hmem⟩
  · simp [PousSpongeChain.ChainKnow.empty] at hq0
  · have hlShow : l <+: R.showRecords π := by
      unfold l
      split
      · exact ⟨[], by simp⟩
      · exact R.sorted_filter_prefix_self (R.showRecords_pairwise π) cut
    have hlSorted : l.Pairwise (fun x y => x.1 ≤ y.1) := by
      obtain ⟨tail, htail⟩ := hlShow
      have hs := R.showRecords_pairwise π
      rw [← htail] at hs
      exact (List.pairwise_append.1 hs).1
    have hpL : pre ++ [rec] <+: l := by
      refine ⟨post, ?_⟩
      rw [heq]
      simp [List.append_assoc]
    have hpShow : pre ++ [rec] <+: R.showRecords π := hpL.trans hlShow
    have hpCut :
        pre ++ [rec] <+:
          (R.showRecords π).filter (fun x => x.1 ≤ rec.1) :=
      R.prefix_filter_of_prefix hpShow (R.prefix_through_le hlSorted heq)
    have hrecL : rec ∈ l := by
      rw [heq]
      exact List.mem_append_right _ (List.mem_cons_self)
    have hrecShow : rec ∈ R.showRecords π :=
      hlShow.subset hrecL
    unfold showRecords at hrecShow
    obtain ⟨τ, hτ, hx⟩ := List.mem_flatMap.1 hrecShow
    obtain ⟨x, hxb, hrec⟩ := List.mem_map.1 hx
    subst rec
    have hτD : τ ≤ R.D := by simp at hτ; omega
    have hsourceCut : R.commitCut π τ x ≤ cut := by
      by_cases hfull : R.programSteps π ≤ cut
      · exact (R.commitCut_le_programSteps hP π hτD hxb).trans (by omega)
      · have hrecFilter :
            (R.commitCut π τ x, (τ, x)) ∈
              (R.showRecords π).filter (fun y => y.1 ≤ cut) := by
          simpa [l, hfull] using hrecL
        exact of_decide_eq_true (List.mem_filter.1 hrecFilter).2
    have hsourceMem :
        q ∈ (R.seedsAtCut π (R.commitCut π τ x)).rs := by
      by_cases hfull : R.programSteps π ≤ R.commitCut π τ x
      · have heqSource : R.commitCut π τ x = cut := by
          have hp := R.commitCut_le_programSteps hP π hτD hxb
          omega
        simpa [heqSource] using hq
      · unfold seedsAtCut
        rw [if_neg hfull]
        exact (R.recordsFold_le_of_prefix π hpCut
          PousSpongeChain.ChainKnow.empty).2.2 hmem
    exact ⟨τ, hτD, x, hxb, hatom, hsourceCut, hsourceMem⟩

