theorem chain_union_term_pinned :
    (∑ j ∈ Finset.range 111, ((2 ^ 16 : ℕ) : ℝ≥0∞) ^ j) *
        chainPi (2 ^ 16) 8192 512 64 (2 ^ 20) 530500000 ≤ (2⁻¹ : ℝ≥0∞) ^ 128 := by
  have hsum : (∑ j ∈ Finset.range 111, ((2 ^ 16 : ℕ) : ℝ≥0∞) ^ j) ≤ (2 : ℝ≥0∞) ^ 1776 := by
    refine (PousDenseChain.sum_pow_le _ _ (by norm_num)).trans (le_of_eq ?_)
    rw [show ((2 ^ 16 : ℕ) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ 16 by norm_num, ← pow_mul]
  have hnp2 : ((Pous.Sponge.nPos (2 ^ 16) (2 ^ 20)) ^ 2 : ℕ) ≤ 2 ^ 73 := by
    norm_num [Pous.Sponge.nPos]
  have hE1 : 8192 * (2 ^ 16 - 64 - 1) = 536338432 := by norm_num
  have ht1 : (2 : ℝ≥0∞) ^ 530500000 * 2 *
      ((((Pous.Sponge.nPos (2 ^ 16) (2 ^ 20)) ^ 2 * 2 ^ 16 * 2) ^ (2 ^ 16 - 64 - 1 + 1) : ℕ) : ℝ≥0∞) /
        2 ^ (8192 * (2 ^ 16 - 64 - 1)) ≤ (2⁻¹ : ℝ≥0∞) ^ 1905 := by
    rw [hE1]
    have hb : ((((Pous.Sponge.nPos (2 ^ 16) (2 ^ 20)) ^ 2 * 2 ^ 16 * 2) ^ (2 ^ 16 - 64 - 1 + 1) : ℕ) :
        ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 5832901 := by
      have hmid : (((2 ^ 5832901 : ℕ)) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ 5832901 := by
        rw [Nat.cast_pow, Nat.cast_ofNat]
      rw [← hmid]
      exact Nat.cast_le.2 chain_base_pinned_pow
    calc (2 : ℝ≥0∞) ^ 530500000 * 2 *
            ((((Pous.Sponge.nPos (2 ^ 16) (2 ^ 20)) ^ 2 * 2 ^ 16 * 2) ^ (2 ^ 16 - 64 - 1 + 1) : ℕ) : ℝ≥0∞) /
              2 ^ 536338432
        ≤ (2 : ℝ≥0∞) ^ 530500000 * 2 * 2 ^ 5832901 / 2 ^ 536338432 := by gcongr
      _ = (2⁻¹ : ℝ≥0∞) ^ 5530 := by
          rw [div_eq_mul_inv, ENNReal.inv_pow, ← pow_succ, ← pow_add]
          exact PousDenseChain.two_pow_mul_inv_pow _ _ (by norm_num)
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ 1905 := pow_le_pow_right_of_le_one' (by norm_num) (by norm_num)
  have hE2 : 8192 + 512 = 8704 := by norm_num
  have ht2 : ((((Pous.Sponge.nPos (2 ^ 16) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞)) / 2 ^ (8192 + 512)
      ≤ (2⁻¹ : ℝ≥0∞) ^ 1905 := by
    rw [hE2]
    have hb : (((Pous.Sponge.nPos (2 ^ 16) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 73 := by
      have hmid : (((2 ^ 73 : ℕ)) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ 73 := by rw [Nat.cast_pow, Nat.cast_ofNat]
      rw [← hmid]
      exact Nat.cast_le.2 hnp2
    calc (((Pous.Sponge.nPos (2 ^ 16) (2 ^ 20)) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ 8704
        ≤ (2 : ℝ≥0∞) ^ 73 / 2 ^ 8704 := by gcongr
      _ = (2⁻¹ : ℝ≥0∞) ^ 8631 := by
          rw [div_eq_mul_inv, ENNReal.inv_pow]; exact PousDenseChain.two_pow_mul_inv_pow _ _ (by norm_num)
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ 1905 := pow_le_pow_right_of_le_one' (by norm_num) (by norm_num)
  have hhalf : (2⁻¹ : ℝ≥0∞) ^ 129 + (2⁻¹ : ℝ≥0∞) ^ 129 = (2⁻¹ : ℝ≥0∞) ^ 128 := by
    have key : (2 : ℝ≥0∞) * 2⁻¹ = 1 := ENNReal.mul_inv_cancel (by norm_num) (by norm_num)
    calc (2⁻¹ : ℝ≥0∞) ^ 129 + (2⁻¹ : ℝ≥0∞) ^ 129 = 2 * (2⁻¹ : ℝ≥0∞) ^ 129 := (two_mul _).symm
      _ = 2 * (2⁻¹ * (2⁻¹ : ℝ≥0∞) ^ 128) := by rw [pow_succ']
