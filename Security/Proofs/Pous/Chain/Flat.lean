/-- `p₀^117 ≤ 1%` at `β = 110498787949`, via `p₀ ≤ 0.96113`. -/
theorem sampling_14GB_64 :
    ENNReal.ofReal (p₀ 110498787949 106142606147 (971 * 220) (220 * 2384)) ^ 117 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  have h0 : 0 ≤ p₀ 110498787949 106142606147 (971 * 220) (220 * 2384) := by unfold p₀; norm_num
  have hq : p₀ 110498787949 106142606147 (971 * 220) (220 * 2384) ≤ 96113 / 100000 := by unfold p₀; norm_num
  rw [← ENNReal.ofReal_pow h0]
