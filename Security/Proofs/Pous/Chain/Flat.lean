theorem delta_add_lt_one {ε : ℝ≥0∞} (hε : ε ≤ Params.εMax) : ENNReal.ofReal (Params.δ : ℝ) + ε < 1 := by
  have hε2 : ε ≤ 2⁻¹ := by
