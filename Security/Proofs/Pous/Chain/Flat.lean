section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The pair group `G(u, w)`: atoms, tokens, relations (`credit-resolved.md` §11.4, §11.9)

For a top `u` and a lower `w`, the group's atoms are:

| atom | source component | sampled when |
| --- | --- | --- |
| `p1` | `P1[w][u]`: `c¹_w(u)`, or `x¹_w(u)` for type I | always |
| `k1` | `K1[w][u] = κ¹_w(u)` | always |
| `b1` | `B1[w][u]`, the hit answer of `(0, w)` | `(0, w)` hit |
| `k2` | `K2[u][w] = κ²_u(w)` | always |
| `b2` | `B2[u][w]`, the hit answer of `(1, u)` | `(1, u)` hit |
| `p2` | `P2[u][w] = x²_u(w)` | `P²_u` of type I |
| `vY` | `c¹_w(u)` | never (virtual when `P¹_w` is I) |
| `vY2` | `c²_u(w)` | never (virtual when `P²_u` is I) |

The relations (§11.3), each present or not:
- the token relations:
  - `rc1` (`Rc1`, the column by C1/C2);
  - `rx2` (`Rx2`, the one `qP2` rule among T3, KT, C3);
  - `rc2` (`Rc2` on `vY2`, a type-I top);
  - `rx1` (`Rx1`, the lower key);
  - `rh0`, `rh1` (the hits);
- the attached `rIw`, `rIu`;
- one fixing relation per absent or non-virtual unsampled atom.

`c1a` is the atom carrying `c¹_w(u)`: `vY` for type I, else `p1`.

`raises_of_functional`: a relation raises if a linear functional kills every earlier event and not it.
-/

namespace PousRank

/-- **Separation.** If a linear functional vanishes on every earlier event's vector but not on `e`'s, `e` raises. -/
theorem raises_of_functional {E A : Type} [Fintype A] (vec : E → (A → ZMod 2)) (key : E → ℕ ×ₗ ℕ) (e : E)
    (φ : A → ZMod 2) (h0 : ∀ e', key e' < key e → ∑ a, φ a * vec e' a = 0) (h1 : ∑ a, φ a * vec e a ≠ 0) :
    Raises (K := ZMod 2) vec key e := by
  intro hmem
  let L : (A → ZMod 2) →ₗ[ZMod 2] ZMod 2 := ∑ a, φ a • LinearMap.proj a
  have hL : ∀ x, L x = ∑ a, φ a * x a := fun x => by simp [L]
  have hle : Submodule.span (ZMod 2) (vec '' {e' | key e' < key e}) ≤ LinearMap.ker L := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨e', he', rfl⟩
    simp only [SetLike.mem_coe, LinearMap.mem_ker, hL]
    exact h0 e' he'
  have := hle hmem
  rw [LinearMap.mem_ker, hL] at this
  exact h1 this

end PousRank

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

/-! ### Membership in the credits -/

section Cred

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

theorem mem_credUpTo3 (x : KState n → Prop) (hx0 : x KState.empty = False)
    (hxu : ∀ a b, x (a.union b) ↔ x a ∨ x b) :
    ∀ r, x (credUpTo3 ps ω τ G W r) ↔ ∃ r' < r, x (roundCred ps ω τ G W (Cg ps ω τ G W r') (r' + 1))
  | 0 => by simp [credUpTo3, hx0]
  | r + 1 => by
    rw [credUpTo3_succ, hxu, mem_credUpTo3 x hx0 hxu r]
    constructor
    · rintro (⟨r', hr', h⟩ | h)
      · exact ⟨r', by omega, h⟩
      · exact ⟨r, by omega, h⟩
    · rintro ⟨r', hr', h⟩
      rcases Nat.lt_succ_iff_lt_or_eq.1 hr' with hlt | rfl
      · exact Or.inl ⟨r', hlt, h⟩
      · exact Or.inr h

theorem mem_cred3_lowerCol {D : ℕ} {c : Fin n × Fin n} :
    c ∈ (cred3 ps ω τ G W D).hold.lowerCol ↔
      ∃ r < D, c ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).hold.lowerCol := by
  have := mem_credUpTo3 ps ω τ G W (fun k => c ∈ k.hold.lowerCol) (by simp [KState.empty])
    (fun a b => by simp [KState.union]) D
  rw [← this]
  simp [cred3, KState.union]

theorem mem_cred3_lowerKey {D : ℕ} {w : Fin n} :
    w ∈ (cred3 ps ω τ G W D).lowerKey ↔ ∃ r < D, w ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).lowerKey := by
  have := mem_credUpTo3 ps ω τ G W (fun k => w ∈ k.lowerKey) (by simp [KState.empty])
    (fun a b => by simp [KState.union]) D
  rw [← this]
  simp [cred3, KState.union]

theorem mem_cred3_topKey {D : ℕ} {u : Fin n} :
    u ∈ (cred3 ps ω τ G W D).topKey ↔ ∃ r < D, u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).topKey := by
  have := mem_credUpTo3 ps ω τ G W (fun k => u ∈ k.topKey) (by simp [KState.empty])
    (fun a b => by simp [KState.union]) D
  rw [← this]
  simp [cred3, KState.union]

theorem mem_cred3_topWhole {D : ℕ} {u : Fin n} :
    u ∈ (cred3 ps ω τ G W D).hold.topWhole ↔
      (∃ r < D, u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).hold.topWhole) ∨
        u ∈ creditedOut ps ω τ G W D := by
  have := mem_credUpTo3 ps ω τ G W (fun k => u ∈ k.hold.topWhole) (by simp [KState.empty])
    (fun a b => by simp [KState.union]) D
  rw [← this]
  simp [cred3, KState.union, creditedOut]

end Cred

/-! ### The group's labels -/

/-- The atoms of a pair group. -/
inductive GA
  | p1 | k1 | b1 | k2 | b2 | p2 | vY | vY2
  deriving DecidableEq

instance instFintypeGA : Fintype GA :=
  ⟨{.p1, .k1, .b1, .k2, .b2, .p2, .vY, .vY2}, fun x => by cases x <;> simp⟩

/-- The relations of a pair group. -/
inductive GR
  | rc1 | rx2 | rc2 | rx1 | rh0 | rh1 | rIw | rIu | ab1 | ab2 | ap2 | aY | aY2
  deriving DecidableEq

instance instFintypeGR : Fintype GR :=
  ⟨{.rc1, .rx2, .rc2, .rx1, .rh0, .rh1, .rIw, .rIu, .ab1, .ab2, .ap2, .aY, .aY2}, fun x => by cases x <;> simp⟩

/-- A relation's priority among relations at the same index (`< 13`). -/
def GR.prio : GR → ℕ
  | .rc1 => 0 | .rx2 => 1 | .rc2 => 2 | .rx1 => 3 | .rh0 => 4 | .rh1 => 5 | .rIw => 6 | .rIu => 7
  | .ab1 => 8 | .ab2 => 9 | .ap2 => 10 | .aY => 11 | .aY2 => 12

theorem GR.prio_injective : Function.Injective GR.prio := by
  intro a b h; cases a <;> cases b <;> simp_all [GR.prio]

theorem GR.prio_lt (r : GR) : r.prio < 13 := by cases r <;> simp [GR.prio]

/-- The coordinate vector of an atom. -/
abbrev ev (a : GA) : GA → ZMod 2 := Pi.single a 1

/-! ### The group of `(u, w)` for one class member `ω` -/

section Group

variable (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (τ : Bits 256) (G : Labelling.TopoDAG n)
  (W : Fin n → Lab n wc) (D Q : ℕ) (ω : (p3ModelT n wc).Ω) (u w : Fin n)

/-- `P¹_w` has type I. -/
def fI1 : Prop := TypI p ω (qP1 τ G W ω w) (qI1 τ G W ω w)
/-- `P²_u` has type I. -/
def fI2 : Prop := TypI p ω (qP2 τ G W ω u) (qI2 τ G W ω u)
/-- `(0, w)` is hit. -/
def fh0 : Prop := ((0 : Fin 2), w) ∈ hitsBy p ω τ G W D
/-- `(1, u)` is hit. -/
def fh1 : Prop := ((1 : Fin 2), u) ∈ hitsBy p ω τ G W D

/-- The column `(w, u)` is credited. -/
def tCol : Prop := (w, u) ∈ (cred3 p ω τ G W D).hold.lowerCol

/-- The column `(w, u)` is credited by C1 or C2 in some round. -/
def colC12 : Prop :=
  ∃ r < D, (w, u) ∈ (roundCred p ω τ G W (Cg p ω τ G W r) (r + 1)).hold.lowerCol ∧
    ((∃ v, w ∈ G.par v ∧ FirstAt p ω (qH1 τ G W ω v) (r + 1)) ∨ FirstAt p ω (qI1 τ G W ω w) (r + 1))

/-- Top `u` is credited by a `c²`-rule: T1 or T2 in some round, or as an output. -/
def c2rule : Prop :=
  (∃ r < D, u ∈ (roundCred p ω τ G W (Cg p ω τ G W r) (r + 1)).hold.topWhole ∧
    ((∃ v, u ∈ G.par v ∧ FirstAt p ω (qH2 τ G W ω v) (r + 1)) ∨ FirstAt p ω (qI2 τ G W ω u) (r + 1))) ∨
  u ∈ creditedOut p ω τ G W D

/-- Top `u`'s token of component `w` lies in this group: credited, and not a `c²`-rule on a type F/Y top. -/
def tTop : Prop := u ∈ (cred3 p ω τ G W D).hold.topWhole ∧ ¬ (¬ fI2 p τ G W ω u ∧ c2rule p τ G W D ω u)

/-- Top `u`'s key is credited. -/
def tKey : Prop := u ∈ (cred3 p ω τ G W D).topKey

/-- Lower `w`'s key is credited. -/
def tLkey : Prop := w ∈ (cred3 p ω τ G W D).lowerKey

open Classical in
/-- The number of tokens in the group. -/
noncomputable def tokG : ℕ :=
  (if tCol p τ G W D ω u w then 1 else 0) + (if tTop p τ G W D ω u then 1 else 0) +
    (if tKey p τ G W D ω u then 1 else 0) + (if tLkey p τ G W D ω w then 1 else 0) +
    (if fh0 p τ G W D ω w then 1 else 0) + (if fh1 p τ G W D ω u then 1 else 0)

/-- Whether a relation is present. -/
def pres : GR → Prop
  | .rc1 => tCol p τ G W D ω u w ∧ colC12 p τ G W D ω u w
  | .rx2 => (tCol p τ G W D ω u w ∧ ¬ colC12 p τ G W D ω u w) ∨ (tTop p τ G W D ω u ∧ ¬ fI2 p τ G W ω u) ∨
      tKey p τ G W D ω u
  | .rc2 => tTop p τ G W D ω u ∧ fI2 p τ G W ω u
  | .rx1 => tLkey p τ G W D ω w
  | .rh0 => fh0 p τ G W D ω w
  | .rh1 => fh1 p τ G W D ω u
  | .rIw => fI1 p τ G W ω w
  | .rIu => fI2 p τ G W ω u
  | .ab1 => ¬ fh0 p τ G W D ω w
  | .ab2 => ¬ fh1 p τ G W D ω u
  | .ap2 => ¬ fI2 p τ G W ω u
  | .aY => ¬ fI1 p τ G W ω w
  | .aY2 => ¬ fI2 p τ G W ω u

open Classical in
/-- The atom carrying `c¹_w(u)`. -/
noncomputable def c1a : GA := if fI1 p τ G W ω w then .vY else .p1

/-- A relation's form, when present. -/
noncomputable def baseForm : GR → GA → ZMod 2
  | .rc1 => ev (c1a p τ G W ω w)
  | .rx2 => ev (c1a p τ G W ω w) + ev .k2
  | .rc2 => ev .vY2
  | .rx1 => ev .k1
  | .rh0 => ev .b1 + ev .k1
  | .rh1 => ev .b2 + ev (c1a p τ G W ω w) + ev .k2
  | .rIw => ev .p1 + ev .k1
  | .rIu => ev .p2 + ev (c1a p τ G W ω w) + ev .k2
  | .ab1 => ev .b1
  | .ab2 => ev .b2
  | .ap2 => ev .p2
  | .aY => ev .vY
  | .aY2 => ev .vY2

open Classical in
/-- A relation's form: its base form if present, else `0`. -/
noncomputable def form (r : GR) : GA → ZMod 2 := if pres p τ G W D ω u w r then baseForm p τ G W ω w r else 0

open Classical in
/-- The sampled atoms. -/
noncomputable def sampled : Finset GA :=
  {.p1, .k1, .k2} ∪ (if fh0 p τ G W D ω w then {.b1} else ∅) ∪ (if fh1 p τ G W D ω u then {.b2} else ∅) ∪
    (if fI2 p τ G W ω u then {.p2} else ∅)

/-- An atom's realization index. -/
noncomputable def ka : GA → ℕ
  | .p1 => RP1 p τ G W D Q ω w
  | .k1 => RK1 p τ G W D Q ω w
  | .b1 => RB p τ G W D Q ω ((0 : Fin 2), w)
  | .k2 => RK2 p τ G W D Q ω u
  | .b2 => RB p τ G W D Q ω ((1 : Fin 2), u)
  | .p2 => RP2 p τ G W D Q ω u
  | .vY => 0
  | .vY2 => 0

open Classical in
/-- The round of the C1/C2 credit of column `(w, u)`. -/
noncomputable def colRound : ℕ := if h : colC12 p τ G W D ω u w then Nat.find h + 1 else 0

open Classical in
/-- The round of top `u`'s credit (by `roundCred`). -/
noncomputable def topRound : ℕ :=
  if h : ∃ r < D, u ∈ (roundCred p ω τ G W (Cg p ω τ G W r) (r + 1)).hold.topWhole then Nat.find h + 1 else 0

/-- A relation's effective index. -/
noncomputable def eIdx : GR → ℕ
  | .rc1 => eR n Q (colRound p τ G W D ω u w)
  | .rx2 => eR n Q (firstRound p ω (qP2 τ G W ω u))
  | .rc2 => eR n Q (topRound p τ G W D ω u)
  | .rx1 => eR n Q (firstRound p ω (qP1 τ G W ω w))
  | .rh0 => RB p τ G W D Q ω ((0 : Fin 2), w)
  | .rh1 => RB p τ G W D Q ω ((1 : Fin 2), u)
  | .rIw => RP1 p τ G W D Q ω w
  | .rIu => RP2 p τ G W D Q ω u
  | _ => 0

/-- A relation's key: its effective index, then its priority. -/
noncomputable def kr (r : GR) : ℕ ×ₗ ℕ := toLex (eIdx p τ G W D Q ω u w r, r.prio)

theorem kr_injective : Function.Injective (kr p τ G W D Q ω u w) := by
  intro a b h
  have := congrArg (fun x => (ofLex x).2) h
  simp only [kr, ofLex_toLex] at this
  exact GR.prio_injective this

theorem kr_prio_lt (r : GR) : (ofLex (kr p τ G W D Q ω u w r)).2 < 13 := by
  simp only [kr, ofLex_toLex]; exact r.prio_lt

end Group

end PousKnowledge

end


/-! ════ Freshness.LuckyGroupRaise ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Every present relation of a pair group raises (`credit-resolved.md` §11.6, in Lean)

Each proof names a functional `φ` (one or two atoms) that vanishes on every earlier event and not on the relation.
For the attached relations, the hits, `rc2` and the fixing relations the functional is the relation's own new atom:
no earlier event mentions it. For `rc1`, `rx2` and `rx1` an earlier event that mentions the atom is excluded by the
game: E1–E9, E10.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

/-- The pairing of a functional with a form. -/
def dotF (φ x : GA → ZMod 2) : ZMod 2 := ∑ a, φ a * x a

theorem dotF_ev (a₀ : GA) (x : GA → ZMod 2) : dotF (ev a₀) x = x a₀ := by
  unfold dotF
  rw [Finset.sum_eq_single a₀]
  · simp
  · intro b _ hb; simp [ev, Pi.single_apply, hb]
  · intro h; exact absurd (Finset.mem_univ a₀) h

theorem dotF_add_left (φ ψ x : GA → ZMod 2) : dotF (φ + ψ) x = dotF φ x + dotF ψ x := by
  simp [dotF, add_mul, Finset.sum_add_distrib]

section Raise

variable (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (τ : Bits 256) (G : Labelling.TopoDAG n)
  (W : Fin n → Lab n wc) (D Q : ℕ) (ω : (p3ModelT n wc).Ω) (u w : Fin n)

/-- A relation raises in the group. -/
abbrev GRaises (r : GR) : Prop :=
  PousRank.RelRaises (sampled p τ G W D ω u w) 13 (ka p τ G W D Q ω u w) (form p τ G W D ω u w)
    (kr p τ G W D Q ω u w) r

theorem kr_lt_iff {r r' : GR} :
    kr p τ G W D Q ω u w r' < kr p τ G W D Q ω u w r ↔
      eIdx p τ G W D Q ω u w r' < eIdx p τ G W D Q ω u w r ∨
        (eIdx p τ G W D Q ω u w r' = eIdx p τ G W D Q ω u w r ∧ r'.prio < r.prio) := by
  unfold kr
  exact Prod.Lex.lt_iff

/-- **Raising from a functional**: it kills the earlier sampled atoms and the earlier relations, and not `r`. -/
theorem graises_of (r : GR) (φ : GA → ZMod 2)
    (hA : ∀ a ∈ sampled p τ G W D ω u w, ka p τ G W D Q ω u w a < eIdx p τ G W D Q ω u w r → φ a = 0)
    (hR : ∀ r', kr p τ G W D Q ω u w r' < kr p τ G W D Q ω u w r → dotF φ (form p τ G W D ω u w r') = 0)
    (h1 : dotF φ (form p τ G W D ω u w r) ≠ 0) : GRaises p τ G W D Q ω u w r := by
  refine PousRank.raises_of_functional _ _ _ φ (fun e' he' => ?_) h1
  rcases e' with a | r'
  · have hlt : ka p τ G W D Q ω u w a.1 < eIdx p τ G W D Q ω u w r := by
      simp only [PousRank.evKey, kr] at he'
      rcases Prod.Lex.lt_iff.1 he' with h | ⟨-, h⟩
      · simpa using h
      · have := r.prio_lt; simp at h; omega
    simp only [PousRank.evVec]
    have e : ∑ b, φ b * (Pi.single a.1 (1 : ZMod 2) : GA → ZMod 2) b = φ a.1 := by
      rw [Finset.sum_eq_single a.1]
      · simp
      · intro b _ hb; simp [Pi.single_apply, hb]
      · intro h; exact absurd (Finset.mem_univ _) h
    rw [e]
    exact hA a.1 a.2 hlt
  · exact hR r' he'

theorem form_of_pres {r : GR} (h : pres p τ G W D ω u w r) :
    form p τ G W D ω u w r = baseForm p τ G W ω w r := by
  classical
  unfold form; rw [if_pos h]

theorem form_of_not_pres {r : GR} (h : ¬ pres p τ G W D ω u w r) : form p τ G W D ω u w r = 0 := by
  classical
  unfold form; rw [if_neg h]

theorem c1a_cases : c1a p τ G W ω w = .vY ∧ fI1 p τ G W ω w ∨ c1a p τ G W ω w = .p1 ∧ ¬ fI1 p τ G W ω w := by
  classical
  unfold c1a
  by_cases h : fI1 p τ G W ω w
  · exact Or.inl ⟨by rw [if_pos h], h⟩
  · exact Or.inr ⟨by rw [if_neg h], h⟩

/-! ### The relations that need no exclusion -/

theorem vY_not_sampled : GA.vY ∉ sampled p τ G W D ω u w := by
  classical
  unfold sampled; split_ifs <;> simp

theorem vY2_not_sampled : GA.vY2 ∉ sampled p τ G W D ω u w := by
  classical
  unfold sampled; split_ifs <;> simp

theorem b1_not_sampled (h : ¬ fh0 p τ G W D ω w) : GA.b1 ∉ sampled p τ G W D ω u w := by
  classical
  unfold sampled; rw [if_neg h]; split_ifs <;> simp

theorem b2_not_sampled (h : ¬ fh1 p τ G W D ω u) : GA.b2 ∉ sampled p τ G W D ω u w := by
  classical
  unfold sampled; rw [if_neg h]; split_ifs <;> simp

theorem p2_not_sampled (h : ¬ fI2 p τ G W ω u) : GA.p2 ∉ sampled p τ G W D ω u w := by
  classical
  unfold sampled; rw [if_neg h]; split_ifs <;> simp

/-- A raise whose new atom `a₀` is unsampled, or sampled exactly at `r`'s index, and occurs in no other present
relation. -/
theorem graises_single (r : GR) (a₀ : GA)
    (hA : a₀ ∈ sampled p τ G W D ω u w → ¬ ka p τ G W D Q ω u w a₀ < eIdx p τ G W D Q ω u w r)
    (hR : ∀ r', r' ≠ r → form p τ G W D ω u w r' a₀ = 0) (h1 : form p τ G W D ω u w r a₀ = 1) :
    GRaises p τ G W D Q ω u w r := by
  refine graises_of p τ G W D Q ω u w r (ev a₀) (fun a ha hlt => ?_) (fun r' hr' => ?_) ?_
  · by_cases hae : a = a₀
    · subst hae; exact absurd hlt (hA ha)
    · simp [ev, Pi.single_apply, hae]
  · rw [dotF_ev]
    exact hR r' fun h => by subst h; exact lt_irrefl _ hr'
  · rw [dotF_ev, h1]; exact one_ne_zero

/-- Coefficients of the base forms at a given atom, by relation. -/
theorem base_coef (r : GR) (a : GA) : baseForm p τ G W ω w r a =
    match r with
    | .rc1 => ev (c1a p τ G W ω w) a
    | .rx2 => ev (c1a p τ G W ω w) a + ev .k2 a
    | .rc2 => ev .vY2 a
    | .rx1 => ev .k1 a
    | .rh0 => ev .b1 a + ev .k1 a
    | .rh1 => ev .b2 a + ev (c1a p τ G W ω w) a + ev .k2 a
    | .rIw => ev .p1 a + ev .k1 a
    | .rIu => ev .p2 a + ev (c1a p τ G W ω w) a + ev .k2 a
    | .ab1 => ev .b1 a
    | .ab2 => ev .b2 a
    | .ap2 => ev .p2 a
    | .aY => ev .vY a
    | .aY2 => ev .vY2 a := by
  cases r <;> rfl

theorem raise_rh0 (h : fh0 p τ G W D ω w) : GRaises p τ G W D Q ω u w .rh0 := by
  refine graises_single p τ G W D Q ω u w .rh0 .b1 (fun _ hlt => lt_irrefl _ hlt) (fun r' hr' => ?_) ?_
  · by_cases hp : pres p τ G W D ω u w r'
    · rw [form_of_pres p τ G W D ω u w hp, base_coef]
      rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;>
        cases r' <;> simp_all [pres, ev]
    · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
  · rw [form_of_pres p τ G W D ω u w (r := .rh0) h, base_coef]; simp [ev]

theorem raise_rh1 (h : fh1 p τ G W D ω u) : GRaises p τ G W D Q ω u w .rh1 := by
  refine graises_single p τ G W D Q ω u w .rh1 .b2 (fun _ hlt => lt_irrefl _ hlt) (fun r' hr' => ?_) ?_
  · by_cases hp : pres p τ G W D ω u w r'
    · rw [form_of_pres p τ G W D ω u w hp, base_coef]
      rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;>
        cases r' <;> simp_all [pres, ev]
    · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
  · rw [form_of_pres p τ G W D ω u w (r := .rh1) h, base_coef]
    rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;> simp [hc, ev]

theorem raise_rIw (h : fI1 p τ G W ω w) : GRaises p τ G W D Q ω u w .rIw := by
  have hc : c1a p τ G W ω w = .vY := by classical unfold c1a; rw [if_pos h]
  refine graises_single p τ G W D Q ω u w .rIw .p1 (fun _ hlt => lt_irrefl _ hlt) (fun r' hr' => ?_) ?_
  · by_cases hp : pres p τ G W D ω u w r'
    · rw [form_of_pres p τ G W D ω u w hp, base_coef]
      cases r' <;> simp_all [pres, ev]
    · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
  · rw [form_of_pres p τ G W D ω u w (r := .rIw) h, base_coef]; simp [ev]

theorem raise_rIu (h : fI2 p τ G W ω u) : GRaises p τ G W D Q ω u w .rIu := by
  refine graises_single p τ G W D Q ω u w .rIu .p2 (fun _ hlt => lt_irrefl _ hlt) (fun r' hr' => ?_) ?_
  · by_cases hp : pres p τ G W D ω u w r'
    · rw [form_of_pres p τ G W D ω u w hp, base_coef]
      rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;>
        cases r' <;> simp_all [pres, ev]
    · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
  · rw [form_of_pres p τ G W D ω u w (r := .rIu) h, base_coef]
    rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;> simp [hc, ev]

theorem raise_rc2 (h : pres p τ G W D ω u w .rc2) : GRaises p τ G W D Q ω u w .rc2 := by
  refine graises_single p τ G W D Q ω u w .rc2 .vY2 (fun h' => absurd h' (vY2_not_sampled p τ G W D ω u w))
    (fun r' hr' => ?_) ?_
  · by_cases hp : pres p τ G W D ω u w r'
    · rw [form_of_pres p τ G W D ω u w hp, base_coef]
      have hI : fI2 p τ G W ω u := h.2
      rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;>
        cases r' <;> simp_all [pres, ev]
    · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
  · rw [form_of_pres p τ G W D ω u w (r := .rc2) h, base_coef]; simp [ev]

theorem raise_ab1 (h : ¬ fh0 p τ G W D ω w) : GRaises p τ G W D Q ω u w .ab1 := by
  refine graises_single p τ G W D Q ω u w .ab1 .b1 (fun h' => absurd h' (b1_not_sampled p τ G W D ω u w h))
    (fun r' hr' => ?_) ?_
  · by_cases hp : pres p τ G W D ω u w r'
