section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace LazyPerm

open scoped ENNReal

variable {ι : Type} {α : ι → Type}

namespace Strategy

variable (S : Strategy α)

/-- **At a step that asks a query, the history has one entry per earlier step.** -/
theorem length_hist_or_stop (π : Oracle α) (j : ℕ) :
    (S.hist π j).length = j ∨ S.next (S.hist π j) = none := by
  induction j with
  | zero => exact Or.inl rfl
  | succ j ih =>
    cases hq : S.next (S.hist π j) with
    | none =>
      rw [S.hist_succ_of_none hq]
      exact Or.inr hq
    | some q =>
      rw [S.hist_succ_of_some hq, List.length_append, List.length_singleton]
      rcases ih with ih | ih
      · exact Or.inl (by rw [ih])
      · rw [hq] at ih; cases ih

theorem length_hist_of_next {π : Oracle α} {j : ℕ} {q : Qry α} (h : S.next (S.hist π j) = some q) :
    (S.hist π j).length = j :=
  (S.length_hist_or_stop π j).resolve_right (by rw [h]; simp)

/-- **An equal history at step `j` means equal histories at every earlier step** (the prefix corollary; for
labeller-phase steps it gives the whole thread phase). -/
theorem hist_eq_of_le {π π' : Oracle α} {j m : ℕ} (h : S.hist π' j = S.hist π j) (hm : m ≤ j) :
    S.hist π' m = S.hist π m :=
  S.hist_congr (fun e he => (S.mem_hist (h ▸ he : e ∈ S.hist π' j)).symm) hm

variable [DecidableEq ι] [∀ i, DecidableEq (α i)]

theorem dom_mono (π : Oracle α) {m n : ℕ} (h : m ≤ n) (i : ι) : (S.hist π m).dom i ⊆ (S.hist π n).dom i := by
  intro x hx
  obtain ⟨e, he, hx⟩ := History.mem_dom.1 hx
  exact History.mem_dom.2 ⟨e, (S.hist_prefix π h).subset he, hx⟩

/-- **In a consistent history, a point is fixed iff its image is.** -/
theorem mem_dom_iff_mem_rng (π : Oracle α) (j : ℕ) (i : ι) (x : α i) :
    x ∈ (S.hist π j).dom i ↔ π i x ∈ (S.hist π j).rng i := by
  constructor
  · intro hx
    obtain ⟨e, he, hx⟩ := History.mem_dom.1 hx
    refine History.mem_rng.2 ⟨e, he, ?_⟩
    rw [Entry.outAt_eq_map (S.mem_hist he), hx, Option.map_some]
  · intro hy
    obtain ⟨e, he, hy⟩ := History.mem_rng.1 hy
    rw [Entry.outAt_eq_map (S.mem_hist he)] at hy
    obtain ⟨x', hx', hxx⟩ := Option.map_eq_some_iff.1 hy
    rw [(π i).injective hxx] at hx'
    exact History.mem_dom.2 ⟨e, he, hx'⟩

/-- **The deciding step.** The first step whose history fixes `x` asks `x` forward or `π i x` inverse, freshly. -/
theorem first_fix {π : Oracle α} {j : ℕ} {i : ι} {x : α i} (h0 : x ∉ (S.hist π j).dom i)
    (h1 : x ∈ (S.hist π (j + 1)).dom i) :
    ∃ q, S.next (S.hist π j) = some q ∧ Fresh (S.hist π j) q ∧
      (q = ⟨i, .inl x⟩ ∨ q = ⟨i, .inr (π i x)⟩) := by
  cases hq : S.next (S.hist π j) with
  | none => rw [S.hist_succ_of_none hq] at h1; exact absurd h1 h0
  | some q =>
    rw [S.hist_succ_of_some hq] at h1
    obtain ⟨e, he, hx⟩ := History.mem_dom.1 h1
    rcases List.mem_append.1 he with he | he
    · exact absurd (History.mem_dom.2 ⟨e, he, hx⟩) h0
    rw [List.mem_singleton] at he
    subst he
    obtain ⟨k, d⟩ := q
    unfold Entry.inpAt at hx
    split_ifs at hx with hk
    subst hk
    simp only [Option.some_inj] at hx
    refine ⟨_, rfl, ?_, ?_⟩
    · cases d with
      | inl x' =>
        simp only [Entry.inp] at hx
        subst hx
        exact h0
      | inr y =>
        simp only [Entry.inp, ans] at hx
        have hy : y = π k x := by rw [← hx, Equiv.apply_symm_apply]
        show y ∉ (S.hist π j).rng k
        rw [hy, ← S.mem_dom_iff_mem_rng]
        exact h0
    · cases d with
      | inl x' =>
        simp only [Entry.inp] at hx
        exact Or.inl (by rw [hx])
      | inr y =>
        simp only [Entry.inp, ans] at hx
        exact Or.inr (by rw [← hx, Equiv.apply_symm_apply])

/-- **Every point fixed by step `N` has a deciding step before `N`.** -/
theorem exists_first_fix {π : Oracle α} {N : ℕ} {i : ι} {x : α i} (hN : x ∈ (S.hist π N).dom i) :
    ∃ j < N, x ∉ (S.hist π j).dom i ∧ x ∈ (S.hist π (j + 1)).dom i := by
  classical
  have hex : ∃ j, x ∈ (S.hist π (j + 1)).dom i := by
    rcases N with _ | N
    · simp [hist, History.dom] at hN
    · exact ⟨N, hN⟩
  obtain ⟨j, hj, hmin⟩ : ∃ j, x ∈ (S.hist π (j + 1)).dom i ∧ ∀ j' < j, x ∉ (S.hist π (j' + 1)).dom i :=
    ⟨Nat.find hex, Nat.find_spec hex, fun _ h => Nat.find_min hex h⟩
  have h0 : x ∉ (S.hist π j).dom i := by
    rcases j with _ | j'
    · simp [hist, History.dom]
    · exact hmin j' (by omega)
  refine ⟨j, ?_, h0, hj⟩
  by_contra hlt
  exact h0 (S.dom_mono π (by omega) i hN)

end Strategy


section Read

variable (S : Strategy α)


open Classical in
/-- **A semantic read restricted to the oracles satisfying `P`** (for instance, those that realize a slot table):
the value of `F` under some such oracle whose history at step `|h|` is `h`. -/
noncomputable def readAtP {β : Type} [Inhabited β] (h : History α) (P : Oracle α → Prop) (F : Oracle α → β) : β :=
  if hex : ∃ π, S.hist π h.length = h ∧ P π then F (Classical.choose hex) else default

/-- **A restricted read is exact** when the history at its step, together with `P`, determines `F`. -/
theorem readAtP_eq {β : Type} [Inhabited β] (P : Oracle α → Prop) (F : Oracle α → β) {π : Oracle α} {j : ℕ}
    (hP : P π) (hdet : ∀ π', S.hist π' j = S.hist π j → P π' → F π' = F π) (hlen : (S.hist π j).length = j) :
    readAtP S (S.hist π j) P F = F π := by
  classical
  unfold readAtP
  split_ifs with hex
  · have hs := Classical.choose_spec hex
    exact hdet _ ((congrArg (S.hist (Classical.choose hex)) hlen.symm).trans hs.1) hs.2
  · exact absurd ⟨π, congrArg (S.hist π) hlen, hP⟩ hex

end Read


namespace RProg

variable {Q A X : Type}

theorem roundQs_ret (f : Q → A) (x : X) : ∀ ρ, (ret x : RProg Q A X).roundQs f ρ = []
  | 0 => rfl
  | ρ + 1 => roundQs_ret f x ρ

/-- **Round `ρ`'s queries depend only on the answers to the trace entries of rounds `< ρ`.** -/
theorem roundQs_congr (f f' : Q → A) :
    ∀ (P : RProg Q A X) (ρ : ℕ), (∀ e ∈ P.trace f, e.1 < ρ → f e.2 = f' e.2) → P.roundQs f ρ = P.roundQs f' ρ
  | ret x, ρ, _ => by rw [roundQs_ret, roundQs_ret]
  | round qs k, 0, _ => rfl
  | round qs k, ρ + 1, h => by
    have hqs : qs.map f = qs.map f' := List.map_congr_left fun q hq =>
      h (0, q) (List.mem_append_left _ (List.mem_map.2 ⟨q, hq, rfl⟩)) (Nat.succ_pos ρ)
    rw [roundQs_succ, roundQs_succ]
    simp only [RProg.qs, feed]
    rw [← hqs]
    refine roundQs_congr f f' (k (qs.map f)) ρ fun e he hlt => ?_
    exact h (e.1 + 1, e.2) (List.mem_append_right _ (List.mem_map.2 ⟨e, he, rfl⟩)) (by omega)

/-- **A trace's entries up to round `τ` depend only on the answers to its entries of rounds `< τ`.** -/
theorem trace_le_congr (f f' : Q → A) :
    ∀ (P : RProg Q A X) (τ : ℕ), (∀ e ∈ P.trace f, e.1 < τ → f e.2 = f' e.2) →
      (P.trace f).filter (fun e => e.1 ≤ τ) = (P.trace f').filter (fun e => e.1 ≤ τ)
  | ret _, _, _ => rfl
  | round qs k, 0, _ => by
    simp only [trace, List.filter_append, List.filter_map]
    congr 1
    · rw [List.filter_eq_nil_iff.2 (fun e _ => by simp), List.filter_eq_nil_iff.2 (fun e _ => by simp)]
  | round qs k, τ + 1, h => by
    have hqs : qs.map f = qs.map f' := List.map_congr_left fun q hq =>
      h (0, q) (List.mem_append_left _ (List.mem_map.2 ⟨q, hq, rfl⟩)) (Nat.succ_pos τ)
    simp only [trace, List.filter_append, List.filter_map]
    rw [← hqs]
    congr 1
    have ih := trace_le_congr f f' (k (qs.map f)) τ fun e he hlt =>
      h (e.1 + 1, e.2) (List.mem_append_right _ (List.mem_map.2 ⟨e, he, rfl⟩)) (by omega)
    have hc : ((fun e : ℕ × Q => decide (e.1 ≤ τ + 1)) ∘ fun e : ℕ × Q => (e.1 + 1, e.2)) =
        fun e : ℕ × Q => decide (e.1 ≤ τ) := by
      funext e; simp
    rw [hc, ih]

end RProg

section OfRoundsDet

variable {θ Q A X : Type} [DecidableEq θ]

/-- **Round `ρ`'s queries are fixed by the history at any step past the earlier rounds.** Under a second oracle
with the same history at step `j`, every thread asks the same round-`ρ` queries, provided `j` lies past the
queries of rounds `< ρ` and within the thread phase. -/
theorem ofRounds_roundQs_det {ths : List θ} (hnd : ths.Nodup) {D : ℕ} {P : θ → RProg Q A X} {enc : Q → Qry α}
    {dec : Entry α → A} {tail : History α → Option (Qry α)} {π π' : Oracle α} {j ρ : ℕ} (hρ : ρ ≤ D)
    (hj : ((List.range ρ).flatMap fun ρ' => ths.flatMap fun t => (P t).roundQs (fun q => dec (qEntry π enc q)) ρ').length
      ≤ j)
    (hjR : j ≤ (roundsSeq ths (fun q => dec (qEntry π enc q)) D P).length)
    (hh : (Strategy.ofRounds ths D P enc dec tail).hist π' j = (Strategy.ofRounds ths D P enc dec tail).hist π j)
    {t : θ} (ht : t ∈ ths) :
    (P t).roundQs (fun q => dec (qEntry π' enc q)) ρ = (P t).roundQs (fun q => dec (qEntry π enc q)) ρ := by
  set f : Q → A := fun q => dec (qEntry π enc q)
  set S := Strategy.ofRounds ths D P enc dec tail
  refine (RProg.roundQs_congr f _ (P t) ρ fun e he hlt => ?_).symm
  have hq : e.2 ∈ (P t).roundQs f e.1 := by
    rw [RProg.roundQs_eq_trace]
    exact List.mem_filterMap.2 ⟨e, he, by simp⟩
  let g : ℕ → List Q := fun ρ' => ths.flatMap fun t => (P t).roundQs f ρ'
  have hpre : e.2 ∈ (List.range ρ).flatMap g :=
    List.mem_flatMap.2 ⟨e.1, List.mem_range.2 hlt, List.mem_flatMap.2 ⟨t, ht, hq⟩⟩
  have hR : roundsSeq ths f D P = (List.range ρ).flatMap g ++ ((List.range (D - ρ)).map (ρ + ·)).flatMap g := by
    rw [roundsSeq_eq hnd f D P]
    conv_lhs => rw [show D = ρ + (D - ρ) by omega, List.range_add, List.flatMap_append]
  have htake : e.2 ∈ (roundsSeq ths f D P).take j := by
    rw [hR, List.take_append, List.take_of_length_le hj]
    exact List.mem_append_left _ hpre
  have hmem : qEntry π enc e.2 ∈ S.hist π' j := by
    rw [hh, Strategy.ofRounds_hist ths D P enc dec tail π j hjR]
    exact List.mem_map.2 ⟨e.2, htake, rfl⟩
  have hans : ans π (enc e.2) = ans π' (enc e.2) := S.mem_hist hmem
  show dec ⟨enc e.2, ans π (enc e.2)⟩ = dec ⟨enc e.2, ans π' (enc e.2)⟩
  rw [hans]

end OfRoundsDet


section Pin

/-- The functions that agree with `c` on `S`. -/
def agreeSet {X : Type} [Fintype X] [DecidableEq X] (S : Finset X) (c : X → Bool) : Finset (X → Bool) :=
  Finset.univ.filter fun f => ∀ x ∈ S, f x = c x

/-- **Agreeing on `S` fixes `|S|` bits**: `2^{|X| − |S|}` functions. -/
theorem card_agreeSet {X : Type} [Fintype X] [DecidableEq X] (S : Finset X) (c : X → Bool) :
    (agreeSet S c).card = 2 ^ (Fintype.card X - S.card) := by
  classical
  let e : {f : X → Bool // ∀ x ∈ S, f x = c x} ≃ ({x // x ∉ S} → Bool) :=
    { toFun := fun f x => f.1 x.1
      invFun := fun g => ⟨fun x => if hx : x ∈ S then c x else g ⟨x, hx⟩, fun x hx => by simp [hx]⟩
      left_inv := fun f => by
        apply Subtype.ext
        funext x
        by_cases hx : x ∈ S
        · simp [hx, f.2 x hx]
        · simp [hx]
      right_inv := fun g => by
        funext x
        simp [x.2] }
  have h1 : (agreeSet S c).card = Fintype.card {f : X → Bool // ∀ x ∈ S, f x = c x} := by
    rw [Fintype.card_subtype]
    rfl
  rw [h1, Fintype.card_congr e, Fintype.card_fun, Fintype.card_bool, Fintype.card_subtype_compl,
    Fintype.card_coe]

/-- **The target condition for a pinned target** (`pin_mul_le`): a target of at most `2^{B − w}` points among
`2^B`, with `w ≤ B`, satisfies the bridge's `hT`. -/
theorem pin_target_le {B w nPos t : ℕ} (hw : w ≤ B) (ht : t ≤ 2 ^ (B - w)) :
    t * (2 ^ w - nPos) ≤ 2 ^ B - nPos := by
  have hN : 2 ^ (B - w) * 2 ^ w = 2 ^ B := by rw [← pow_add, Nat.sub_add_cancel hw]
  exact (Nat.mul_le_mul_right _ ht).trans (pin_mul_le hN (Nat.one_le_two_pow) le_rfl)

end Pin


section Slots

variable {K : Type} [DecidableEq K] [Fintype K] [Fintype ι] [DecidableEq ι] [∀ i, Fintype (α i)] [∀ i, DecidableEq (α i)]
  (S : Strategy α)

/-- **The bridge over a slot table**: targets, freshness and names indexed by `σ : Sig`, each satisfying the
bridge's hypotheses, and a win that supplies some `σ` with its items. The union over `σ` costs `|Sig|`. -/
theorem Strategy.prob_fresh_slots_le {Sig : Type} [Fintype Sig]
    (T : Sig → K → History α → (q : Qry α) → Finset (α q.1)) (w : K → ℕ) (nPos : ℕ)
    (hT : ∀ σ κ h q, (T σ κ h q).card * (2 ^ w κ - nPos) ≤ Fintype.card (α q.1) - nPos)
    (h2 : ∀ κ, 2 * nPos ≤ 2 ^ w κ) (hX : 2 ≤ 2 * (nPos * Fintype.card K))
    {I : Type} (OnFresh : Sig → Oracle α → I → Prop) (name : Sig → Oracle α → I → ℕ × K)
    (h_distinct : ∀ σ π x y, OnFresh σ π x → OnFresh σ π y → x ≠ y → (name σ π x).1 ≠ (name σ π y).1)
    (h_fresh : ∀ σ π x, OnFresh σ π x →
      ∃ q, S.next (S.hist π (name σ π x).1) = some q ∧ Fresh (S.hist π (name σ π x).1) q)
    (h_target : ∀ σ π x q, OnFresh σ π x → S.next (S.hist π (name σ π x).1) = some q →
      ans π q ∈ T σ (name σ π x).2 (S.hist π (name σ π x).1) q)
    (h_lt : ∀ σ π x, OnFresh σ π x → (name σ π x).1 < nPos)
    (s W : ℕ) (Win : Oracle α → Prop)
    (hwin : ∀ π, Win π → ∃ σ, ∃ X : Finset I, (∀ x ∈ X, OnFresh σ π x) ∧ X.card ≤ s + 1 ∧
      W ≤ ∑ x ∈ X, w (name σ π x).2) :
    prob Win ≤ (Fintype.card Sig : ℝ≥0∞) *
      (2 * (((2 * (nPos * Fintype.card K)) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ W) := by
  classical
  let WinS : Sig → Oracle α → Prop := fun σ π => ∃ X : Finset I, (∀ x ∈ X, OnFresh σ π x) ∧ X.card ≤ s + 1 ∧
    W ≤ ∑ x ∈ X, w (name σ π x).2
  refine (prob_mono (F := fun π => ∃ σ ∈ (Finset.univ : Finset Sig), WinS σ π) fun π hπ => ?_).trans
    ((prob_exists_le _ WinS).trans ?_)
  · obtain ⟨σ, hσ⟩ := hwin π hπ
    exact ⟨σ, Finset.mem_univ _, hσ⟩
  · refine (Finset.sum_le_sum fun σ _ => S.prob_fresh_width_le (T σ) w nPos (hT σ) h2 hX (OnFresh σ) (name σ)
      (h_distinct σ) (h_fresh σ) (h_target σ) (h_lt σ) s W (WinS σ) fun π h => h).trans (le_of_eq ?_)
    rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

end Slots

end LazyPerm

end


