/-! ## 5. Injective domains across segments are necessary -/

/-- The blocks of all-zero data are zero. -/
theorem blocks_zero (n ℓ : ℕ) (v : Fin n) : Dense.blocks n ℓ (fun _ => false) v = fun _ => false := rfl

theorem locOf_gIdx {N B : ℕ} (s : Fin N) (i : Fin B) : locOf (gIdx s i) = i := Fin.ext (gIdx_mod s i)

/-- **Under a shared domain, zero data gives every segment the same labels**: global block `v`'s label is the band
label of its local index, whatever its segment. -/
theorem sharedDom_label {N B d ℓ : ℕ} (f : Bits (ℓ + (ℓ + 512)) → Bits (ℓ + (ℓ + 512))) (salt : Bits 256)
    (v : Fin (N * B)) :
    labelG (bandSegDAG N B d) f (sharedDom salt B) (Dense.blocks (N * B) ℓ (fun _ => false)) v =
      labelG (bandDAG B d) f (Pous.Sponge.dom salt) (fun _ _ => false) (locOf v) := by
  have h := labelG_seg (d := d) f (sharedDom salt B) (Dense.blocks (N * B) ℓ (fun _ => false)) (segOf v)
    (Pous.Sponge.dom salt) (fun _ _ => false) (fun j => by unfold sharedDom; rw [seg_mod j.isLt]) (fun j => rfl)
    (locOf v)
  rwa [gIdx_segOf_locOf] at h

/-- A responder that returns `g σ i` without querying, and keeps its state, returns `g σ` of every index. -/
theorem seqAnswers_ret {M : IdealModel} {ℓ S B : ℕ} (f : M.Qry → M.Ans) (g : Bits S → Fin B → Bits ℓ)
    (σ : Bits S) : ∀ (j : ℕ) (is : List (Fin B)),
    seqAnswers f (fun _ σ i => (Prog.ret (g σ i, σ) : Prog M (Bits ℓ × Bits S))) j is σ = is.map (g σ)
  | _, [] => rfl
  | j, i :: is => by
    show g σ i :: seqAnswers f _ (j + 1) is σ = g σ i :: is.map (g σ)
    rw [seqAnswers_ret f g σ (j + 1) is]

theorem seqAnswers_ret_ofFn {M : IdealModel} {ℓ S B k : ℕ} (f : M.Qry → M.Ans) (g : Bits S → Fin B → Bits ℓ)
    (σ : Bits S) (I : Fin k → Fin B) :
    seqAnswers f (fun _ σ i => (Prog.ret (g σ i, σ) : Prog M (Bits ℓ × Bits S))) 0 (List.ofFn I) σ =
      List.ofFn fun t => g σ (I t) := by
  rw [seqAnswers_ret, List.map_ofFn]
  rfl

/-- `δ + ε < 1` for every admissible `ε`: an adversary accepted with probability 1 refutes `AuditSecure`. -/
theorem delta_add_lt_one {ε : ℝ≥0∞} (hε : ε ≤ Params.εMax) : ENNReal.ofReal (Params.δ : ℝ) + ε < 1 := by
  have hε2 : ε ≤ 2⁻¹ := by
    refine hε.trans ?_
    unfold Params.εMax Params.secParam
    exact (pow_le_pow_right_of_le_one' (a := (2⁻¹ : ℝ≥0∞)) (by norm_num) (by norm_num : 1 ≤ 128)).trans
      (pow_one _).le
  have hhalf : (2 : ℝ≥0∞)⁻¹ = ENNReal.ofReal 2⁻¹ := by
    rw [ENNReal.ofReal_inv_of_pos (by norm_num), ENNReal.ofReal_ofNat]
  have hδ : ENNReal.ofReal (Params.δ : ℝ) < 2⁻¹ := by
    rw [hhalf]
    exact (ENNReal.ofReal_lt_ofReal_iff (by norm_num)).2 (by norm_num [Params.δ])
  calc ENNReal.ofReal (Params.δ : ℝ) + ε ≤ ENNReal.ofReal (Params.δ : ℝ) + 2⁻¹ :=
        add_le_add le_rfl hε2
    _ < 2⁻¹ + 2⁻¹ := ENNReal.add_lt_add_right (by simp) hδ
    _ = 1 := ENNReal.inv_two_add_inv_two

/-- **`SharedDomainBreaks`, proved.** For zero data, the preprocessor keeps segment 0's `2^28`-bit labels, and the
responder answers block `v` with the stored label of `v mod 2^9`, with no query. Every audit accepts. -/
theorem shared_domain_breaks : SharedDomainBreaks := by
  intro d salt D Q k ε hM
  obtain ⟨hε, -, -, -, hsec⟩ := hM
  rw [stateBound_seg_14] at hsec
  have hLS : 2 ^ 9 * 524288 ≤ 113929658799 := by norm_num
  let enc0 : (Fin (2 ^ 9) → Bits 524288) → Bits 113929658799 := fun y t =>
    if h : t.val < 2 ^ 9 * 524288 then codeEquiv (2 ^ 9) 524288 y ⟨t.val, h⟩ else false
  let dec0 : Bits 113929658799 → Fin (2 ^ 9) → Bits 524288 := fun σ =>
    (codeEquiv (2 ^ 9) 524288).symm (fun t => σ ⟨t.val, lt_of_lt_of_le t.isLt hLS⟩)
  have hdec : ∀ y, dec0 (enc0 y) = y := by
    intro y
    have : (fun t : Fin (2 ^ 9 * 524288) => enc0 y ⟨t.val, lt_of_lt_of_le t.isLt hLS⟩) =
        codeEquiv (2 ^ 9) 524288 y := by
      funext t
      simp only [enc0, t.isLt, ↓reduceDIte]
    show (codeEquiv (2 ^ 9) 524288).symm _ = y
    rw [this, Equiv.symm_apply_apply]
  let s0 : Fin 448 := ⟨0, by norm_num⟩
  let sch := chainBandSeg 448 (2 ^ 9) d 524288 512 (sharedDom salt (2 ^ 9))
  let A₁ : Preprocessor sch 113929658799 := fun _ _ C _ => enc0 fun i => C (gIdx s0 i)
  let A₂ : SeqResponder sch 113929658799 D Q :=
    { step := fun _ _ _ σ i => Prog.ret (dec0 σ (locOf (N := 448) (B := 2 ^ 9) i), σ)
      bounded := fun _ _ _ _ _ _ => ⟨Nat.zero_le _, Nat.zero_le _⟩ }
  have hacc : ∀ x, seqAccepts sch k (fun _ => false) A₁ A₂ x := by
    intro x
    let f : Bits (524288 + (524288 + 512)) → Bits (524288 + (524288 + 512)) := fun y =>
      (idealPerm (524288 + (524288 + 512))).answer x.1 (.inl y)
    let C := labelG (bandSegDAG 448 (2 ^ 9) d) f (sharedDom salt (2 ^ 9))
      (Dense.blocks (448 * 2 ^ 9) 524288 (fun _ => false))
    show seqAnswers ((idealPerm (524288 + (524288 + 512))).answer x.1)
        (fun _ σ i => Prog.ret (dec0 σ (locOf (N := 448) (B := 2 ^ 9) i), σ)) 0 (List.ofFn x.2.2)
        (enc0 fun i => C (gIdx s0 i)) = List.ofFn fun j => C (x.2.2 j)
    refine (seqAnswers_ret_ofFn _ _ _ x.2.2).trans ?_
    congr 1
    funext j
    show dec0 (enc0 fun i => C (gIdx s0 i)) (locOf (x.2.2 j)) = C (x.2.2 j)
    rw [hdec]
    show C (gIdx s0 (locOf (x.2.2 j))) = C (x.2.2 j)
    exact (sharedDom_label (N := 448) (B := 2 ^ 9) (d := d) f salt (gIdx s0 (locOf (x.2.2 j)))).trans
      ((congrArg _ (locOf_gIdx s0 _)).trans (sharedDom_label (N := 448) (B := 2 ^ 9) (d := d) f salt _).symm)
  have h2 := hsec (fun _ => false) A₁ A₂
  rw [pr_eq_one hacc] at h2
  exact absurd h2 (not_le.2 (delta_add_lt_one hε))

/-! ## 6. Satisfiability witnesses, the margin, and the certificate's tightness -/

/-- **Witness for `BandSegHard`'s hypotheses** at 14 GB, `d = D = 5`. The conclusion is tight: `k = N·B = |univ|`. -/
theorem band_seg_hard_14 (c ℓ : ℕ) :
    ChainHard (bandSegDAG 448 (2 ^ 9) 5) Finset.univ c ℓ ((448 * 2 ^ 9 - 448 * 5 - 1 : ℕ) : ℚ) 5 (448 * 2 ^ 9) :=
  band_seg_hard 448 (2 ^ 9) 5 5 c ℓ (by norm_num) le_rfl (by norm_num)

/-- The recommended in-degree `d = 12` at `D = 5`. -/
theorem band_seg_hard_14_d12 (c ℓ : ℕ) :
    ChainHard (bandSegDAG 448 (2 ^ 9) 12) Finset.univ c ℓ ((448 * 2 ^ 9 - 448 * 5 - 1 : ℕ) : ℚ) 5 (448 * 2 ^ 9) :=
  band_seg_hard 448 (2 ^ 9) 12 5 c ℓ (by norm_num) (by norm_num) (by norm_num)

