        ((2 : ℝ≥0∞) ^ 530500000 * 2 *
            ((((Pous.Sponge.nPos (2 ^ 16) (2 ^ 20)) ^ 2 * 2 ^ 16 * 2) ^ (2 ^ 16 - 64 - 1 + 1) : ℕ) : ℝ≥0∞) /
