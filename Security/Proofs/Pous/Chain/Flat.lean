theorem recordsFold_r_causal
    (R : ChainReplay B ℓ c)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ (l : List (ℕ × (ℕ × VCommit B R.Q))) (H : ChainKnow B)
      {q : Fin B × ℕ},
      q ∈ (l.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2) H).rs →
      q ∈ H.rs ∨
        ∃ pre rec post,
          l = pre ++ rec :: post ∧ rec.2.2.atom = .r q ∧
          q ∈ ((pre ++ [rec]).foldl
            (fun K x => R.seedBasisStep π x.2.1 K x.2.2) H).rs
  | [], H, q, h => Or.inl h
  | rec :: l, H, q, h => by
      rw [List.foldl_cons] at h
      rcases R.recordsFold_r_causal π l
          (R.seedBasisStep π rec.2.1 H rec.2.2) h with
        h | ⟨pre, source, post, heq, hatom, hmem⟩
      · rcases R.seedBasisStep_rs_origin h with h | hatom
        · exact Or.inl h
        · exact Or.inr ⟨[], rec, l, rfl, hatom, by simpa using h⟩
      · exact Or.inr ⟨rec :: pre, source, post, by simp [heq],
          hatom, by simpa using hmem⟩

