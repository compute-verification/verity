    · rw [form_of_pres p τ G W D ω u w hp, base_coef]
      rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;>
        cases r' <;> simp_all [pres, ev]
    · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
  · rw [form_of_pres p τ G W D ω u w (r := .aY2) h, base_coef]; simp [ev]

/-! ### The relations whose raising needs the game -/

theorem graises_single' (r : GR) (a₀ : GA)
    (hA : a₀ ∈ sampled p τ G W D ω u w → ¬ ka p τ G W D Q ω u w a₀ < eIdx p τ G W D Q ω u w r)
    (hR : ∀ r', kr p τ G W D Q ω u w r' < kr p τ G W D Q ω u w r → form p τ G W D ω u w r' a₀ = 0)
    (h1 : form p τ G W D ω u w r a₀ = 1) : GRaises p τ G W D Q ω u w r := by
  refine graises_of p τ G W D Q ω u w r (ev a₀) (fun a ha hlt => ?_) (fun r' hr' => ?_) ?_
  · by_cases hae : a = a₀
    · subst hae; exact absurd hlt (hA ha)
    · simp [ev, Pi.single_apply, hae]
  · rw [dotF_ev]; exact hR r' hr'
  · rw [dotF_ev, h1]; exact one_ne_zero

theorem pos_nQ_of_lt_eR {ℓ r : ℕ} (h : ℓ < eR n Q r) : 0 < n * Q := by
  unfold eR at h
  rcases Nat.eq_zero_or_pos (n * Q) with h0 | h0
  · rw [h0, mul_zero] at h; omega
  · exact h0

/-- **`rx1`, the lower key, raises**: its key `κ¹_w(u)` is not sampled before the key's round (E1), and an earlier
hit on `(0, w)` would make `w` whole (E3); `rIw` is absent since the pair has type F (E10). -/
theorem raise_rx1 (hb : ∀ c, (p c).Bounded D Q) (h : pres p τ G W D ω u w .rx1) :
    GRaises p τ G W D Q ω u w .rx1 := by
  classical
  obtain ⟨r, hrD, hk⟩ := (mem_cred3_lowerKey p ω τ G W).1 h
  have hF := typF1_of_lowerKey p ω τ G W hk
  have hk' := hk
  simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at hk'
  obtain ⟨hf, hw, hkl⟩ := hk'
  have heI : eIdx p τ G W D Q ω u w .rx1 = eR n Q (r + 1) := by
    simp only [eIdx, firstRound_eq p ω hf]
  have hnI1 : ¬ fI1 p τ G W ω w := fun hI => not_typF_typI p ω _ _ ⟨hF, hI⟩
  refine graises_single' p τ G W D Q ω u w .rx1 .k1 (fun _ hlt => ?_) (fun r' hr' => ?_) ?_
  · rw [heI] at hlt
    have hq := asked_of_RK1_lt hb (r := r + 1) (by omega) hlt
    rcases Nat.eq_zero_or_pos r with rfl | hr
    · simp [eR] at hlt
    · exact hkl (keyLow_of_asked_qH1 p ω τ G W hr hq)
  · by_cases hp : pres p τ G W D ω u w r'
    · rw [form_of_pres p τ G W D ω u w hp, base_coef]
      cases r' with
      | rh0 =>
        exfalso
        rw [kr_lt_iff, heI] at hr'
        have hlt : RB p τ G W D Q ω ((0 : Fin 2), w) < eR n Q (r + 1) := by
          rcases hr' with h' | ⟨-, h'⟩
          · exact h'
          · simp [GR.prio] at h'
        have hhit := hit_of_RB_lt hb hp hlt
        rcases Nat.eq_zero_or_pos r with rfl | hr
        · simp [eR] at hlt
        · exact hw (lowerWhole_of_hit p ω τ G W hr hhit)
      | rIw => exact absurd hp hnI1
      | rx1 => exact absurd hr' (lt_irrefl _)
      | _ =>
        rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;> simp_all [ev]
    · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
  · rw [form_of_pres p τ G W D ω u w (r := .rx1) h, base_coef]; simp [ev]

/-- **What `rx2` records.** Its token is the one `qP2` rule on top `u`, fired at the first ask of `qP2 u` in round
`r + 1` with `u` outside the game. Either the key is unavailable (T3, KT), or it is available and column `(w, u)` was
not (C3, with no C1/C2 credit of the column). -/
theorem rx2_cases (h : pres p τ G W D ω u w .rx2) :
    ∃ r < D, FirstAt p ω (qP2 τ G W ω u) (r + 1) ∧ u ∉ (timedReachK G (Cg p ω τ G W r) r).topWhole ∧
      (¬ keyTop G (Cg p ω τ G W r) (r + 1) u ∨
        (¬ avail (timedReachK G (Cg p ω τ G W r) r) w u ∧ ¬ colC12 p τ G W D ω u w)) := by
  classical
  rcases h with ⟨hc, hnc⟩ | ⟨ht, hnI⟩ | hk
  · obtain ⟨s, hs, hsm⟩ := (mem_cred3_lowerCol p ω τ G W).1 hc
    have hsm' := hsm
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at hsm'
    rcases hsm'.2 with h12 | h12 | ⟨hv, hu, -⟩
    · exact absurd ⟨s, hs, hsm, Or.inl h12⟩ hnc
    · exact absurd ⟨s, hs, hsm, Or.inr h12⟩ hnc
    · exact ⟨s, hs, hv, hu, Or.inr ⟨hsm'.1, hnc⟩⟩
  · rcases (mem_cred3_topWhole p ω τ G W).1 ht.1 with ⟨s, hs, hsm⟩ | hs
    · have hsm' := hsm
      simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at hsm'
      rcases hsm'.2 with h12 | h12 | ⟨hv, hk, -⟩
      · exact absurd ⟨hnI, Or.inl ⟨s, hs, hsm, Or.inl h12⟩⟩ ht.2
      · exact absurd ⟨hnI, Or.inl ⟨s, hs, hsm, Or.inr h12⟩⟩ ht.2
      · exact ⟨s, hs, hv, hsm'.1, Or.inl hk⟩
    · exact absurd ⟨hnI, Or.inr hs⟩ ht.2
  · obtain ⟨s, hs, hsm⟩ := (mem_cred3_topKey p ω τ G W).1 hk
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at hsm
    exact ⟨s, hs, hsm.1, hsm.2.1, Or.inl hsm.2.2.1⟩

/-- An earlier `rx2`, `rh1` or `rIu` means top `u` was known by round `r`. -/
theorem known_of_earlier (hb : ∀ c, (p c).Bounded D Q) {r : ℕ} (hrD : r + 1 ≤ D) {r' : GR}
    (hp : pres p τ G W D ω u w r') (hlt : eIdx p τ G W D Q ω u w r' < eR n Q (r + 1))
    (hr' : r' = .rx2 ∨ r' = .rh1 ∨ r' = .rIu) :
    Asked p ω (qP2 τ G W ω u) r ∨ ((1 : Fin 2), u) ∈ hitsBy p ω τ G W r ∨ Asked p ω (qI2 τ G W ω u) r := by
  classical
  have hnQ := pos_nQ_of_lt_eR Q hlt
  rcases hr' with rfl | rfl | rfl
  · obtain ⟨s, -, hf, -, -⟩ := rx2_cases p τ G W D ω u w hp
    have hask : ∃ s, Asked p ω (qP2 τ G W ω u) s := ⟨_, hf.1⟩
    left
    have heq : eIdx p τ G W D Q ω u w .rx2 = eR n Q (firstRound p ω (qP2 τ G W ω u)) := rfl
    rw [heq] at hlt
    have hr := eR_lt_eR hnQ (firstRound_pos (p := p) hask) hlt
    exact asked_mono (by omega) (asked_firstRound p ω hask)
  · exact Or.inr (Or.inl (by simpa using hit_of_RB_lt hb hp hlt))
  · rcases asked_of_RP2_lt hb (r := r + 1) hrD hlt with h | h
    · exact Or.inl (by simpa using h)
    · exact Or.inr (Or.inr (by simpa using h))

theorem strict_of_kr_lt {r r' : GR} {e : ℕ} (he : eIdx p τ G W D Q ω u w r = e) (hpr : r.prio < r'.prio)
    (h : kr p τ G W D Q ω u w r' < kr p τ G W D Q ω u w r) : eIdx p τ G W D Q ω u w r' < e := by
  rw [kr_lt_iff, he] at h
  rcases h with h | ⟨-, h⟩
  · exact h
  · omega

/-- **`rc1`, a column by C1/C2, raises.**
- If `κ²_u` is sampled before the column's round, the functional is `c¹_w(u)`'s atom. An earlier `rx2`, `rh1` or
  `rIu` would make top `u` known with its parents in the game, so the column would be available (E7).
- Otherwise it is `c¹_w(u) + κ²_u(w)`, which every other relation meets evenly.
- The atom of `c¹_w(u)` is not sampled before the round: `qP1 w` or `qI1 w` asked earlier would make `w` whole (E2). -/
theorem raise_rc1 (hb : ∀ c, (p c).Bounded D Q) (h : pres p τ G W D ω u w .rc1) :
    GRaises p τ G W D Q ω u w .rc1 := by
  classical
  have hC : colC12 p τ G W D ω u w := h.2
  obtain ⟨hrD, hmem, -⟩ := Nat.find_spec hC
  set r := Nat.find hC with hrdef
  have heI : eIdx p τ G W D Q ω u w .rc1 = eR n Q (r + 1) := by
    simp only [eIdx, colRound, dif_pos hC, hrdef]
  have hnav : ¬ avail (timedReachK G (Cg p ω τ G W r) r) w u := by
    have := hmem
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at this
    exact this.1
  have hp1 : ¬ fI1 p τ G W ω w → ¬ RP1 p τ G W D Q ω w < eR n Q (r + 1) := fun _ hlt => by
    rcases asked_of_RP1_lt hb (r := r + 1) (by omega) hlt with hq | hq
    · exact hnav (Or.inl (lowerWhole_of_asked_qP1 p ω τ G W (by simpa using hq)))
    · exact hnav (Or.inl (lowerWhole_of_asked_qI1 p ω τ G W (by simpa using hq)))
  have hc1a : c1a p τ G W ω w ∈ sampled p τ G W D ω u w →
      ¬ ka p τ G W D Q ω u w (c1a p τ G W ω w) < eR n Q (r + 1) := by
    rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, hI⟩
    · rw [hc]; intro hs; exact absurd hs (vY_not_sampled p τ G W D ω u w)
    · rw [hc]; intro _; exact hp1 hI
  by_cases hK2 : RK2 p τ G W D Q ω u < eR n Q (r + 1)
  · have hK := asked_of_RK2_lt hb (r := r + 1) (by omega) hK2
    simp only [Nat.add_sub_cancel] at hK
    refine graises_single' p τ G W D Q ω u w .rc1 (c1a p τ G W ω w) (by rw [heI]; exact hc1a)
      (fun r' hr' => ?_) ?_
    · by_cases hp : pres p τ G W D ω u w r'
      · rw [form_of_pres p τ G W D ω u w hp, base_coef]
        cases r' with
        | rx2 => exact absurd (cols_avail_of_top p ω τ G W hK (known_of_earlier p τ G W D Q ω u w hb (by omega)
            hp (strict_of_kr_lt p τ G W D Q ω u w heI (by simp [GR.prio]) hr') (Or.inl rfl)) w) hnav
        | rh1 => exact absurd (cols_avail_of_top p ω τ G W hK (known_of_earlier p τ G W D Q ω u w hb (by omega)
            hp (strict_of_kr_lt p τ G W D Q ω u w heI (by simp [GR.prio]) hr') (Or.inr (Or.inl rfl))) w) hnav
        | rIu => exact absurd (cols_avail_of_top p ω τ G W hK (known_of_earlier p τ G W D Q ω u w hb (by omega)
            hp (strict_of_kr_lt p τ G W D Q ω u w heI (by simp [GR.prio]) hr') (Or.inr (Or.inr rfl))) w) hnav
        | rc1 => exact absurd hr' (lt_irrefl _)
        | _ => rcases c1a_cases p τ G W ω w with ⟨hc, hI⟩ | ⟨hc, hI⟩ <;> simp_all [ev, pres]
      · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
    · rw [form_of_pres p τ G W D ω u w (r := .rc1) h, base_coef]; simp [ev]
  · refine graises_of p τ G W D Q ω u w .rc1 (ev (c1a p τ G W ω w) + ev .k2) (fun a ha hlt => ?_)
      (fun r' _ => ?_) ?_
    · rw [heI] at hlt
      by_cases hac : a = c1a p τ G W ω w
      · subst hac; exact absurd hlt (hc1a ha)
      · by_cases hak : a = .k2
        · subst hak; exact absurd hlt hK2
        · simp [ev, Pi.single_apply, hac, hak]
    · rw [dotF_add_left, dotF_ev, dotF_ev]
      by_cases hp : pres p τ G W D ω u w r'
      · rw [form_of_pres p τ G W D ω u w hp, base_coef, base_coef]
        rcases c1a_cases p τ G W ω w with ⟨hc, hI⟩ | ⟨hc, hI⟩ <;> cases r' <;> simp_all [ev, pres] <;> decide
      · rw [form_of_not_pres p τ G W D ω u w hp]; simp
    · rw [dotF_add_left, dotF_ev, dotF_ev, form_of_pres p τ G W D ω u w (r := .rc1) h, base_coef, base_coef]
      rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;> simp [hc, ev]

/-- **`rx2`, the one `qP2` rule, raises.**
- For T3 and KT the key is not available, so `κ²_u` is not sampled before the round (E4). The functional is
  `κ²_u(w)`: an earlier hit on `(1, u)` would put `u` in the game (E6), and `rIu` is absent since the pair has type F
  (E10).
- For C3 with `κ²_u` sampled earlier, the functional is `c¹_w(u)`: `rc1` is absent (no C1/C2 credit), and the atom is
  not sampled before the round, since the column was not available (E2). -/
theorem raise_rx2 (hb : ∀ c, (p c).Bounded D Q) (h : pres p τ G W D ω u w .rx2) :
    GRaises p τ G W D Q ω u w .rx2 := by
  classical
  obtain ⟨r, hrD, hf, hu, hcase⟩ := rx2_cases p τ G W D ω u w h
  have heI : eIdx p τ G W D Q ω u w .rx2 = eR n Q (r + 1) := by
    simp only [eIdx, firstRound_eq p ω hf]
  have hF2 := typF2_of_qP2 p ω τ G W hf hu
  have hnI2 : ¬ fI2 p τ G W ω u := fun hI => not_typF_typI p ω _ _ ⟨hF2, hI⟩
  have hnoh1 : pres p τ G W D ω u w .rh1 → ¬ eIdx p τ G W D Q ω u w .rh1 < eR n Q (r + 1) := fun hp hlt => by
    have hhit := hit_of_RB_lt hb hp hlt
    simp only [Nat.add_sub_cancel] at hhit
    exact hu (topWhole_of_hit p ω τ G W hhit)
  have hk2fun : ¬ RK2 p τ G W D Q ω u < eR n Q (r + 1) → GRaises p τ G W D Q ω u w .rx2 := fun hK2 => by
    refine graises_single' p τ G W D Q ω u w .rx2 .k2 (fun _ hlt => by rw [heI] at hlt; exact hK2 hlt)
      (fun r' hr' => ?_) ?_
    · by_cases hp : pres p τ G W D ω u w r'
      · rw [form_of_pres p τ G W D ω u w hp, base_coef]
        cases r' with
        | rh1 => exact absurd (strict_of_kr_lt p τ G W D Q ω u w heI (by simp [GR.prio]) hr') (hnoh1 hp)
        | rIu => exact absurd hp hnI2
        | rx2 => exact absurd hr' (lt_irrefl _)
        | _ => rcases c1a_cases p τ G W ω w with ⟨hc, hI⟩ | ⟨hc, hI⟩ <;> simp_all [ev, pres]
      · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
    · rw [form_of_pres p τ G W D ω u w (r := .rx2) h, base_coef]
      rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;> simp [hc, ev]
  rcases hcase with hnk | ⟨hnav, hnc⟩
  · refine hk2fun fun hK2 => ?_
    have hK := asked_of_RK2_lt hb (r := r + 1) (by omega) hK2
    simp only [Nat.add_sub_cancel] at hK
    rcases Nat.eq_zero_or_pos r with h0 | hr
    · rw [h0] at hK2; simp [eR] at hK2
    · exact hnk (keyTop_of_asked_qH2 p ω τ G W hr hK)
  · by_cases hK2 : RK2 p τ G W D Q ω u < eR n Q (r + 1)
    · have hp1 : ¬ fI1 p τ G W ω w → ¬ RP1 p τ G W D Q ω w < eR n Q (r + 1) := fun _ hlt => by
        rcases asked_of_RP1_lt hb (r := r + 1) (by omega) hlt with hq | hq
        · exact hnav (Or.inl (lowerWhole_of_asked_qP1 p ω τ G W (by simpa using hq)))
        · exact hnav (Or.inl (lowerWhole_of_asked_qI1 p ω τ G W (by simpa using hq)))
      have hc1a : c1a p τ G W ω w ∈ sampled p τ G W D ω u w →
          ¬ ka p τ G W D Q ω u w (c1a p τ G W ω w) < eIdx p τ G W D Q ω u w .rx2 := by
        rw [heI]
        rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, hI⟩
        · rw [hc]; intro hs; exact absurd hs (vY_not_sampled p τ G W D ω u w)
        · rw [hc]; intro _; exact hp1 hI
      refine graises_single' p τ G W D Q ω u w .rx2 (c1a p τ G W ω w) hc1a (fun r' hr' => ?_) ?_
      · by_cases hp : pres p τ G W D ω u w r'
        · rw [form_of_pres p τ G W D ω u w hp, base_coef]
          cases r' with
          | rc1 => exact absurd hp.2 hnc
          | rh1 => exact absurd (strict_of_kr_lt p τ G W D Q ω u w heI (by simp [GR.prio]) hr') (hnoh1 hp)
          | rIu => exact absurd hp hnI2
          | rx2 => exact absurd hr' (lt_irrefl _)
          | _ => rcases c1a_cases p τ G W ω w with ⟨hc, hI⟩ | ⟨hc, hI⟩ <;> simp_all [ev, pres]
        · rw [form_of_not_pres p τ G W D ω u w hp]; rfl
      · rw [form_of_pres p τ G W D ω u w (r := .rx2) h, base_coef]
        rcases c1a_cases p τ G W ω w with ⟨hc, -⟩ | ⟨hc, -⟩ <;> simp [hc, ev]
    · exact hk2fun hK2

/-- **Every present relation of the group raises** (§11.6, the whole enumeration). -/
theorem all_raise (hb : ∀ c, (p c).Bounded D Q) (r : GR) (h : pres p τ G W D ω u w r) :
    GRaises p τ G W D Q ω u w r := by
  cases r with
  | rc1 => exact raise_rc1 p τ G W D Q ω u w hb h
  | rx2 => exact raise_rx2 p τ G W D Q ω u w hb h
  | rc2 => exact raise_rc2 p τ G W D Q ω u w h
  | rx1 => exact raise_rx1 p τ G W D Q ω u w hb h
  | rh0 => exact raise_rh0 p τ G W D Q ω u w h
  | rh1 => exact raise_rh1 p τ G W D Q ω u w h
  | rIw => exact raise_rIw p τ G W D Q ω u w h
  | rIu => exact raise_rIu p τ G W D Q ω u w h
  | ab1 => exact raise_ab1 p τ G W D Q ω u w h
  | ab2 => exact raise_ab2 p τ G W D Q ω u w h
  | ap2 => exact raise_ap2 p τ G W D Q ω u w h
  | aY => exact raise_aY p τ G W D Q ω u w h
  | aY2 => exact raise_aY2 p τ G W D Q ω u w h

end Raise

end PousKnowledge

end


/-! ════ Freshness.LuckySources ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Distinct sources have distinct realizations (`credit-resolved.md` §11.2)

The sources are `K1 w`, `P1 w`, `K2 u`, `P2 u` and, for each hit `t`, `Bh t`. `Rsrc σ` is the realization index.
- **Decoding.** A Part A realization is the first ask of a query `q`, and `srcOf q` recovers the source. A hit's
  forward query differs from the honest one at the same tweak, since `z₀ ≠ x_t`.
- **Part B.** A Part B realization sits at its own offset.
- `Rsrc_injOn`: so `Rsrc` is injective on the present sources.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

/-- The sources of a segment. -/
inductive Src (n : ℕ)
  | K1 (w : Fin n) | P1 (w : Fin n) | K2 (u : Fin n) | P2 (u : Fin n) | Bh (t : Fin 2 × Fin n)
  deriving DecidableEq

section Sources

variable (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (τ : Bits 256) (G : Labelling.TopoDAG n)
  (W : Fin n → Lab n wc) (D Q : ℕ) (ω : (p3ModelT n wc).Ω)

/-- A source's realization index. -/
noncomputable def Rsrc : Src n → ℕ
  | .K1 w => RK1 p τ G W D Q ω w
  | .P1 w => RP1 p τ G W D Q ω w
  | .K2 u => RK2 p τ G W D Q ω u
  | .P2 u => RP2 p τ G W D Q ω u
  | .Bh t => RB p τ G W D Q ω t

/-- A source is present: every source but a hit pair, which is present when hit. -/
def SrcPresent : Src n → Prop
  | .Bh t => t ∈ hitsBy p ω τ G W D
  | _ => True

open Classical in
/-- The source a query realizes. -/
noncomputable def srcOf : (p3ModelT n wc).Qry → Src n
  | Sum.inl k => if k.2.1 = 0 then .K1 k.2.2.1 else .K2 k.2.2.1
  | Sum.inr (Sum.inl ty) =>
      if ty.2 = hin τ G W ω (ty.1.2.1, ty.1.2.2) then (if ty.1.2.1 = 0 then .P1 ty.1.2.2 else .P2 ty.1.2.2)
      else .Bh (ty.1.2.1, ty.1.2.2)
  | Sum.inr (Sum.inr tz) => if tz.1.2.1 = 0 then .P1 tz.1.2.2 else .P2 tz.1.2.2

/-- The Part B offset of a non-hit source. -/
def offB : Src n → ℕ
  | .K1 w => 2 * w
  | .P1 w => 2 * w + 1
  | .K2 u => 2 * n + 2 * u
  | .P2 u => 2 * n + 2 * u + 1
  | .Bh _ => 0

variable {p τ G W D Q ω}

theorem srcOf_qH1 (w : Fin n) : srcOf τ G W ω (qH1 τ G W ω w) = .K1 w := by
  classical
  simp [srcOf, qH1, hk1]

theorem srcOf_qH2 (u : Fin n) : srcOf τ G W ω (qH2 τ G W ω u) = .K2 u := by
  classical
  simp [srcOf, qH2, hk2]

theorem srcOf_qP1 (w : Fin n) : srcOf τ G W ω (qP1 τ G W ω w) = .P1 w := by
  classical
  simp [srcOf, qP1, hin]

theorem srcOf_qP2 (u : Fin n) : srcOf τ G W ω (qP2 τ G W ω u) = .P2 u := by
  classical
  simp [srcOf, qP2, hin]

theorem srcOf_qI1 (w : Fin n) : srcOf τ G W ω (qI1 τ G W ω w) = .P1 w := by
  classical
  simp [srcOf, qI1]

theorem srcOf_qI2 (u : Fin n) : srcOf τ G W ω (qI2 τ G W ω u) = .P2 u := by
  classical
  simp [srcOf, qI2]

theorem srcOf_qHit {t : Fin 2 × Fin n} (ht : t ∈ hitsBy p ω τ G W D) : srcOf τ G W ω (qHit τ G W ω t) = .Bh t := by
  classical
  simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht
  obtain ⟨r, -, -, hz, -⟩ := ht
  simp only [srcOf, qHit, twk]
  rw [if_neg hz]

/-- **A realization is a first ask decoding to its source, or its own Part B index.** -/
theorem Rsrc_spec (hb : ∀ c, (p c).Bounded D Q) {σ : Src n} (hσ : SrcPresent p τ G W D ω σ) :
    (∃ q, qIdx (splitFam p) (2 * D) Q ω (Rsrc p τ G W D Q ω σ) = some q ∧ srcOf τ G W ω q = σ ∧
      Rsrc p τ G W D Q ω σ < 2 * D * (n * Q)) ∨
      ((∀ t, σ ≠ .Bh t) ∧ Rsrc p τ G W D Q ω σ = 2 * D * (n * Q) + offB σ) := by
  classical
  have partA : ∀ {q : (p3ModelT n wc).Qry}, (∃ r, Asked p ω q r) →
      qIdx (splitFam p) (2 * D) Q ω (fA (splitFam p) (2 * D) Q ω q) = some q ∧
        fA (splitFam p) (2 * D) Q ω q < 2 * D * (n * Q) := fun h =>
    ⟨qIdx_fA ((exists_qIdx_iff (bounded_splitFam hb)).2 ((asked_splitFam_even ω _ D).2 (asked_D hb h.choose_spec)
      |> fun h' => ⟨_, h'⟩)), fA_lt_partB hb h⟩
  cases σ with
  | K1 w =>
    by_cases hq : ∃ r, Asked p ω (qH1 τ G W ω w) r
    · have := partA hq
      refine Or.inl ⟨_, ?_, srcOf_qH1 w, ?_⟩
      · simp only [Rsrc, RK1, if_pos hq]; exact this.1
      · simp only [Rsrc, RK1, if_pos hq]; exact this.2
    · exact Or.inr ⟨(fun t h => by cases h), by simp [Rsrc, RK1, if_neg hq, offB]⟩
  | K2 u =>
    by_cases hq : ∃ r, Asked p ω (qH2 τ G W ω u) r
    · have := partA hq
      refine Or.inl ⟨_, ?_, srcOf_qH2 u, ?_⟩
      · simp only [Rsrc, RK2, if_pos hq]; exact this.1
      · simp only [Rsrc, RK2, if_pos hq]; exact this.2
    · exact Or.inr ⟨(fun t h => by cases h), by simp [Rsrc, RK2, if_neg hq, offB]⟩
  | P1 w =>
    by_cases hF : TypF p ω (qP1 τ G W ω w) (qI1 τ G W ω w)
    · have := partA hF.1
      refine Or.inl ⟨_, ?_, srcOf_qP1 w, ?_⟩
      · simp only [Rsrc, RP1, if_pos hF]; exact this.1
      · simp only [Rsrc, RP1, if_pos hF]; exact this.2
    · by_cases hI : TypI p ω (qP1 τ G W ω w) (qI1 τ G W ω w)
      · have := partA hI.1
        refine Or.inl ⟨_, ?_, srcOf_qI1 w, ?_⟩
        · simp only [Rsrc, RP1, if_neg hF, if_pos hI]; exact this.1
        · simp only [Rsrc, RP1, if_neg hF, if_pos hI]; exact this.2
      · exact Or.inr ⟨(fun t h => by cases h), by simp [Rsrc, RP1, if_neg hF, if_neg hI, offB]⟩
  | P2 u =>
    by_cases hF : TypF p ω (qP2 τ G W ω u) (qI2 τ G W ω u)
    · have := partA hF.1
      refine Or.inl ⟨_, ?_, srcOf_qP2 u, ?_⟩
      · simp only [Rsrc, RP2, if_pos hF]; exact this.1
      · simp only [Rsrc, RP2, if_pos hF]; exact this.2
    · by_cases hI : TypI p ω (qP2 τ G W ω u) (qI2 τ G W ω u)
      · have := partA hI.1
        refine Or.inl ⟨_, ?_, srcOf_qI2 u, ?_⟩
        · simp only [Rsrc, RP2, if_neg hF, if_pos hI]; exact this.1
        · simp only [Rsrc, RP2, if_neg hF, if_pos hI]; exact this.2
      · exact Or.inr ⟨(fun t h => by cases h), by simp [Rsrc, RP2, if_neg hF, if_neg hI, offB]⟩
  | Bh t =>
    have ht : t ∈ hitsBy p ω τ G W D := hσ
    have hask : ∃ r, Asked p ω (qHit τ G W ω t) r := by
      simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht
      obtain ⟨r, -, hr⟩ := ht
      exact ⟨r, hr.1.1⟩
    have := partA hask
    exact Or.inl ⟨_, this.1, srcOf_qHit ht, this.2⟩

theorem offB_injOn {σ σ' : Src n} (hσ : ∀ t, σ ≠ .Bh t) (hσ' : ∀ t, σ' ≠ .Bh t) (h : offB σ = offB σ') :
    σ = σ' := by
  cases σ with
  | Bh t => exact absurd rfl (hσ t)
  | K1 w => cases σ' with
    | Bh t => exact absurd rfl (hσ' t)
    | K1 w' => simp only [offB] at h; exact congrArg _ (Fin.ext (by omega))
    | P1 w' => simp only [offB] at h; omega
    | K2 u' => simp only [offB] at h; have := w.isLt; omega
    | P2 u' => simp only [offB] at h; omega
  | P1 w => cases σ' with
    | Bh t => exact absurd rfl (hσ' t)
    | K1 w' => simp only [offB] at h; omega
    | P1 w' => simp only [offB] at h; exact congrArg _ (Fin.ext (by omega))
    | K2 u' => simp only [offB] at h; omega
    | P2 u' => simp only [offB] at h; have := w.isLt; omega
  | K2 u => cases σ' with
    | Bh t => exact absurd rfl (hσ' t)
    | K1 w' => simp only [offB] at h; have := w'.isLt; omega
    | P1 w' => simp only [offB] at h; omega
    | K2 u' => simp only [offB] at h; exact congrArg _ (Fin.ext (by omega))
    | P2 u' => simp only [offB] at h; omega
  | P2 u => cases σ' with
    | Bh t => exact absurd rfl (hσ' t)
    | K1 w' => simp only [offB] at h; omega
    | P1 w' => simp only [offB] at h; have := w'.isLt; omega
    | K2 u' => simp only [offB] at h; omega
    | P2 u' => simp only [offB] at h; exact congrArg _ (Fin.ext (by omega))

/-- **Distinct present sources have distinct realization indices.** -/
theorem Rsrc_injOn (hb : ∀ c, (p c).Bounded D Q) {σ σ' : Src n} (hσ : SrcPresent p τ G W D ω σ)
    (hσ' : SrcPresent p τ G W D ω σ') (h : Rsrc p τ G W D Q ω σ = Rsrc p τ G W D Q ω σ') : σ = σ' := by
  rcases Rsrc_spec hb hσ with ⟨q, hq, hs, hlt⟩ | ⟨hnb, he⟩ <;>
    rcases Rsrc_spec hb hσ' with ⟨q', hq', hs', hlt'⟩ | ⟨hnb', he'⟩
  · rw [h, hq'] at hq
    rw [← hs, ← hs', Option.some_inj.1 hq]
  · omega
  · omega
  · exact offB_injOn hnb hnb' (by omega)

end Sources

end PousKnowledge

end


/-! ════ Freshness.LuckyGroupCount ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The count in a pair group: `tokens ≤ atoms in the span when sampled` (`credit-resolved.md` §11.5)

- **Tokens and relations.** The token relations number the tokens (`tok_part`). The three `qP2` rules share `rx2`,
  and at most one of them fires (E8, `rx2_exclusive`).
- **Unsampled atoms.** Each unsampled atom (virtual or absent) has its own raising relation (`comp_part`): `rIw`/`aY`
  for `vY`, `rIu` or `ap2`, `aY2` for `p2`, `vY2`, and `ab1`, `ab2`.
- **The count.** Every present relation raises (`all_raise`) and the atoms have distinct realizations
  (`ka_injOn`). So `pinned_count` gives `group_count`: `tokG ≤ #(sampled atoms in the span when sampled)`.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

theorem sum_GR (f : GR → ℕ) : ∑ r, f r = f .rc1 + (f .rx2 + (f .rc2 + (f .rx1 + (f .rh0 + (f .rh1 + (f .rIw +
    (f .rIu + (f .ab1 + (f .ab2 + (f .ap2 + (f .aY + f .aY2))))))))))) := by
  simp [Finset.sum, Finset.univ, Fintype.elems]

section Count

variable (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (τ : Bits 256) (G : Labelling.TopoDAG n)
  (W : Fin n → Lab n wc) (D Q : ℕ) (ω : (p3ModelT n wc).Ω) (u w : Fin n)

/-- The C3 credit of the column gives the C3 rule. -/
theorem c3rule_of (h : tCol p τ G W D ω u w ∧ ¬ colC12 p τ G W D ω u w) : ∃ r, C3rule p ω τ G W r u := by
  classical
  obtain ⟨s, hs, hsm⟩ := (mem_cred3_lowerCol p ω τ G W).1 h.1
  have hsm' := hsm
  simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at hsm'
  rcases hsm'.2 with h12 | h12 | h3
  · exact absurd ⟨s, hs, hsm, Or.inl h12⟩ h.2
  · exact absurd ⟨s, hs, hsm, Or.inr h12⟩ h.2
  · exact ⟨s, h3⟩

/-- A top credit that is no `c²`-rule is the T3 rule. -/
theorem t3rule_of (h : tTop p τ G W D ω u ∧ ¬ fI2 p τ G W ω u) : ∃ r, T3rule p ω τ G W r u := by
  classical
  rcases (mem_cred3_topWhole p ω τ G W).1 h.1.1 with ⟨s, hs, hsm⟩ | hs
  · have hsm' := hsm
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at hsm'
    rcases hsm'.2 with h12 | h12 | h3
    · exact absurd ⟨h.2, Or.inl ⟨s, hs, hsm, Or.inl h12⟩⟩ h.1.2
    · exact absurd ⟨h.2, Or.inl ⟨s, hs, hsm, Or.inr h12⟩⟩ h.1.2
    · exact ⟨s, h3⟩
  · exact absurd ⟨h.2, Or.inr hs⟩ h.1.2

theorem ktrule_of (h : tKey p τ G W D ω u) : ∃ r, KTrule p ω τ G W r u := by
  classical
  obtain ⟨s, -, hsm⟩ := (mem_cred3_topKey p ω τ G W).1 h
  simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at hsm
  exact ⟨s, hsm⟩

open Classical in
/-- **At most one `qP2` rule uses `rx2`** (E8). -/
theorem rx2_exclusive :
    (if tCol p τ G W D ω u w ∧ ¬ colC12 p τ G W D ω u w then 1 else 0) +
      (if tTop p τ G W D ω u ∧ ¬ fI2 p τ G W ω u then 1 else 0) + (if tKey p τ G W D ω u then 1 else 0) ≤ 1 := by
  have t3kt : ∀ {r r'}, T3rule p ω τ G W r u → KTrule p ω τ G W r' u → False := fun h3 hk =>
    ((qP2rule_exclusive p ω τ G W).1 h3).1 hk
  have t3c3 : ∀ {r r'}, T3rule p ω τ G W r u → C3rule p ω τ G W r' u → False := fun h3 hc =>
    ((qP2rule_exclusive p ω τ G W).1 h3).2 hc
  have ktc3 : ∀ {r r'}, KTrule p ω τ G W r u → C3rule p ω τ G W r' u → False := fun hk hc =>
    (qP2rule_exclusive p ω τ G W).2 hk hc
  by_cases hC : tCol p τ G W D ω u w ∧ ¬ colC12 p τ G W D ω u w
  · obtain ⟨rc, hc⟩ := c3rule_of p τ G W D ω u w hC
    have hT : ¬ (tTop p τ G W D ω u ∧ ¬ fI2 p τ G W ω u) := fun hT =>
      let ⟨r3, h3⟩ := t3rule_of p τ G W D ω u hT; t3c3 h3 hc
    have hK : ¬ tKey p τ G W D ω u := fun hK => let ⟨rk, hk⟩ := ktrule_of p τ G W D ω u hK; ktc3 hk hc
    rw [if_pos hC, if_neg hT, if_neg hK]
  · by_cases hT : tTop p τ G W D ω u ∧ ¬ fI2 p τ G W ω u
    · obtain ⟨r3, h3⟩ := t3rule_of p τ G W D ω u hT
      have hK : ¬ tKey p τ G W D ω u := fun hK => let ⟨rk, hk⟩ := ktrule_of p τ G W D ω u hK; t3kt h3 hk
      rw [if_neg hC, if_pos hT, if_neg hK]
    · by_cases hK : tKey p τ G W D ω u
      · rw [if_neg hC, if_neg hT, if_pos hK]
      · rw [if_neg hC, if_neg hT, if_neg hK]; omega

open Classical in
/-- **The token relations number the tokens.** -/
theorem tok_part :
    (if tCol p τ G W D ω u w then 1 else 0) + (if tTop p τ G W D ω u then 1 else 0) +
        (if tKey p τ G W D ω u then 1 else 0) ≤
      (if pres p τ G W D ω u w .rc1 then 1 else 0) + (if pres p τ G W D ω u w .rx2 then 1 else 0) +
        (if pres p τ G W D ω u w .rc2 then 1 else 0) := by
  have hx := rx2_exclusive p τ G W D ω u w
  simp only [pres]
  by_cases hC : tCol p τ G W D ω u w <;> by_cases h12 : colC12 p τ G W D ω u w <;>
    by_cases hT : tTop p τ G W D ω u <;> by_cases hI : fI2 p τ G W ω u <;> by_cases hK : tKey p τ G W D ω u <;>
    simp only [hC, h12, hT, hI, hK, if_true, if_false, true_and, and_true, not_true, not_false_eq_true,
      and_false, false_and, or_true, true_or, or_false, false_or, and_self] at hx ⊢ <;> omega

open Classical in
theorem card_sampled : (sampled p τ G W D ω u w).card =
    3 + (if fh0 p τ G W D ω w then 1 else 0) + (if fh1 p τ G W D ω u then 1 else 0) +
      (if fI2 p τ G W ω u then 1 else 0) := by
  unfold sampled
  by_cases h0 : fh0 p τ G W D ω w <;> by_cases h1 : fh1 p τ G W D ω u <;> by_cases hI : fI2 p τ G W ω u <;>
    simp only [h0, h1, hI, if_true, if_false] <;> decide

open Classical in
/-- **Each unsampled atom has its own raising relation.** -/
theorem comp_part :
    (if pres p τ G W D ω u w .rIw then 1 else 0) + (if pres p τ G W D ω u w .rIu then 1 else 0) +
        (if pres p τ G W D ω u w .ab1 then 1 else 0) + (if pres p τ G W D ω u w .ab2 then 1 else 0) +
        (if pres p τ G W D ω u w .ap2 then 1 else 0) + (if pres p τ G W D ω u w .aY then 1 else 0) +
        (if pres p τ G W D ω u w .aY2 then 1 else 0) + (sampled p τ G W D ω u w).card = 8 := by
  rw [card_sampled]
  simp only [pres]
  by_cases h0 : fh0 p τ G W D ω w <;> by_cases h1 : fh1 p τ G W D ω u <;> by_cases hI : fI2 p τ G W ω u <;>
    by_cases hI1 : fI1 p τ G W ω w <;> simp [h0, h1, hI, hI1]

open Classical in
theorem card_pres_ge :
    tokG p τ G W D ω u w + 8 ≤ (Finset.univ.filter (pres p τ G W D ω u w)).card + (sampled p τ G W D ω u w).card := by
  have ht := tok_part p τ G W D ω u w
  have hc := comp_part p τ G W D ω u w
  rw [Finset.card_filter, sum_GR]
  unfold tokG
  have e1 : (if pres p τ G W D ω u w .rx1 then 1 else 0) = (if tLkey p τ G W D ω w then 1 else 0) := by
    unfold pres; congr
  have e2 : (if pres p τ G W D ω u w .rh0 then 1 else 0) = (if fh0 p τ G W D ω w then 1 else 0) := by
    unfold pres; congr
  have e3 : (if pres p τ G W D ω u w .rh1 then 1 else 0) = (if fh1 p τ G W D ω u then 1 else 0) := by
    unfold pres; congr
  omega

/-- The source of a sampled atom. -/
def gsrc : GA → Src n
  | .p1 => .P1 w | .k1 => .K1 w | .b1 => .Bh ((0 : Fin 2), w) | .k2 => .K2 u | .b2 => .Bh ((1 : Fin 2), u)
  | .p2 => .P2 u | .vY => .P1 w | .vY2 => .P2 u

theorem ka_eq_Rsrc {a : GA} (ha : a ∈ sampled p τ G W D ω u w) :
    ka p τ G W D Q ω u w a = Rsrc p τ G W D Q ω (gsrc u w a) := by
  cases a <;> first | rfl | exact absurd ha (vY_not_sampled p τ G W D ω u w) |
    exact absurd ha (vY2_not_sampled p τ G W D ω u w)

theorem gsrc_present {a : GA} (ha : a ∈ sampled p τ G W D ω u w) :
    SrcPresent p τ G W D ω (gsrc u w a) := by
  classical
  cases a with
  | b1 => by_contra h; exact b1_not_sampled p τ G W D ω u w h ha
  | b2 => by_contra h; exact b2_not_sampled p τ G W D ω u w h ha
  | vY => exact absurd ha (vY_not_sampled p τ G W D ω u w)
  | vY2 => exact absurd ha (vY2_not_sampled p τ G W D ω u w)
  | _ => trivial

theorem gsrc_injOn {a b : GA} (ha : a ∈ sampled p τ G W D ω u w) (hb' : b ∈ sampled p τ G W D ω u w)
    (h : gsrc u w a = gsrc u w b) : a = b := by
  cases a <;> cases b <;> simp_all [gsrc] <;>
    first
      | exact absurd ha (vY_not_sampled p τ G W D ω u w)
      | exact absurd hb' (vY_not_sampled p τ G W D ω u w)
      | exact absurd ha (vY2_not_sampled p τ G W D ω u w)
      | exact absurd hb' (vY2_not_sampled p τ G W D ω u w)
      | skip

/-- **The group's atoms have distinct realizations.** -/
theorem ka_injOn (hb : ∀ c, (p c).Bounded D Q) :
    Set.InjOn (ka p τ G W D Q ω u w) (sampled p τ G W D ω u w) := by
  intro a ha b hb' h
  have ha' : a ∈ sampled p τ G W D ω u w := ha
  have hb'' : b ∈ sampled p τ G W D ω u w := hb'
  rw [ka_eq_Rsrc p τ G W D Q ω u w ha', ka_eq_Rsrc p τ G W D Q ω u w hb''] at h
  exact gsrc_injOn p τ G W D ω u w ha' hb''
    (Rsrc_injOn hb (gsrc_present p τ G W D ω u w ha') (gsrc_present p τ G W D ω u w hb'') h)

open Classical in
/-- **The group count.** Its tokens number at most its sampled atoms in the span when sampled. -/
theorem group_count (hb : ∀ c, (p c).Bounded D Q) :
    tokG p τ G W D ω u w ≤
      (Finset.univ.filter (PousRank.InSpan (sampled p τ G W D ω u w) 13 (ka p τ G W D Q ω u w)
        (form p τ G W D ω u w) (kr p τ G W D Q ω u w))).card := by
  have hP := PousRank.pinned_count (sampled p τ G W D ω u w) 13 (ka p τ G W D Q ω u w) (form p τ G W D ω u w)
    (kr p τ G W D Q ω u w) (ka_injOn p τ G W D Q ω u w hb) (kr_injective p τ G W D Q ω u w)
    (kr_prio_lt p τ G W D Q ω u w)
  have hr : (Finset.univ.filter (pres p τ G W D ω u w)).card ≤
      (Finset.univ.filter (PousRank.RelRaises (sampled p τ G W D ω u w) 13 (ka p τ G W D Q ω u w)
        (form p τ G W D ω u w) (kr p τ G W D Q ω u w))).card :=
    Finset.card_le_card fun r hr => Finset.mem_filter.2 ⟨Finset.mem_univ _,
      all_raise p τ G W D Q ω u w hb r (Finset.mem_filter.1 hr).2⟩
  have hc := card_pres_ge p τ G W D ω u w
  have : Fintype.card GA = 8 := rfl
  omega

/-- **The §28 double: a same-round `top` and `tkey` land on distinct atoms (`Rc2` against `Rx2`).** If top `u` and
its key are both credited, then:
- the pair `P²_u` has type F (E10);
- the top was credited by T1 or T2 in the KT round, so it is a `c²`-rule (E8);
- the top's tokens are therefore in the groups `C(u, ·)`, via `Rc2` on `P2[u][·]`, and not in any `G(u, w)`;
- no `G(u, w)` samples `P2[u][w]`, so the key's `Rx2` tokens are pinned on other atoms. -/
theorem double_top_tkey (hb : ∀ c, (p c).Bounded D Q) (hk : tKey p τ G W D ω u)
    (ht : u ∈ (cred3 p ω τ G W D).hold.topWhole) :
    TypF p ω (qP2 τ G W ω u) (qI2 τ G W ω u) ∧ c2rule p τ G W D ω u ∧ ¬ tTop p τ G W D ω u ∧
      ∀ w, GA.p2 ∉ sampled p τ G W D ω u w := by
  classical
  obtain ⟨r, hr, hkr⟩ := (mem_cred3_topKey p ω τ G W).1 hk
  have hkt := hkr
  simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at hkt
  have hF := typF2_of_qP2 p ω τ G W hkt.1 hkt.2.1
  have hnI : ¬ fI2 p τ G W ω u := fun hI => not_typF_typI p ω _ _ ⟨hF, hI⟩
  have hg := inGame_of_key_credit p ω τ G W hkr
  have hc2 : c2rule p τ G W D ω u := by
    rcases (mem_cred3_topWhole p ω τ G W).1 ht with ⟨s, hs, hsm⟩ | hout
    · have hsr : s = r := by
        rcases Nat.lt_trichotomy s r with hlt | heq | hlt
        · exfalso
          have := inGame_mono p ω τ G W (by omega : s + 1 ≤ r) (inGame_of_top_credit p ω τ G W hsm)
          exact hkt.2.1 this
        · exact heq
        · exact absurd (key_credit_round p ω τ G W hkr (Or.inl hsm)) (by omega)
      subst hsr
      have hsm' := hsm
      simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at hsm'
      rcases hsm'.2 with h1 | h2 | ⟨-, hnk, hnc⟩
      · exact Or.inl ⟨s, hs, hsm, Or.inl h1⟩
      · exact Or.inl ⟨s, hs, hsm, Or.inr h2⟩
      · exact absurd hkt.2.2.2 hnc
    · exfalso
      simp only [creditedOut, Finset.mem_filter, Finset.mem_univ, true_and] at hout
      exact hout.2 (inGame_mono p ω τ G W (by omega : r + 1 ≤ D) hg)
  exact ⟨hF, hc2, fun h => h.2 ⟨hnI, hc2⟩, fun w => p2_not_sampled p τ G W D ω u w hnI⟩

end Count

end PousKnowledge

end


/-! ════ Freshness.LuckySem ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The class, honest values, and atoms at their realization (`credit-resolved.md` §11.2)

- `Cls ℓ`: the members of `ω`'s typed class sharing its split-chain prefix below `ℓ`. It shrinks as `ℓ` grows
  (`Cls_anti`), and contains `ω` itself (`self_mem_Cls`, the witness that class-fixedness is not vacuous).
- `zw`: a word as a vector over GF(2). It is injective and turns XOR into `+`.
- `hv σ`: the honest value source `σ` takes: `κ¹_w`; `x¹_w` or `c¹_w` (type I or not); `κ²_u`; `x²_u` or `c²_u`;
  a hit's `x_t`.
- **`realize_eq`**: at and after a source's realization, every class member sharing the prefix has chain variable =
  its own honest value there. It uses the transfer of the realizing query:
  - `transfer_honest_split` for the honest queries (their slots are not hit slots, `honest_not_hitSlot`);
  - `transfer_hit` for a hit;
  - the definitions for Part B.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

/-- A word as a GF(2) vector. -/
def zw (b : Bits wc) : Fin wc → ZMod 2 := fun i => if b i then 1 else 0

theorem zw_injective : Function.Injective (zw (wc := wc)) := by
  intro a b h
  funext i
  have := congrFun h i
  simp only [zw] at this
  by_cases ha : a i <;> by_cases hb : b i <;> simp_all

theorem zw_bxor (a b : Bits wc) : zw (Labelling.bxor a b) = zw a + zw b := by
  funext i
  simp only [zw, Labelling.bxor, Pi.add_apply]
  rcases Bool.eq_false_or_eq_true (a i) with ha | ha <;> rcases Bool.eq_false_or_eq_true (b i) with hb | hb <;>
    simp [ha, hb] <;> decide

section Sem

variable (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (τ : Bits 256) (G : Labelling.TopoDAG n)
  (W : Fin n → Lab n wc) (D Q : ℕ) (S H : Finset (ℕ × ℕ)) (ω : (p3ModelT n wc).Ω)

/-- The members of `ω`'s typed class `(S, H)` sharing its prefix below `ℓ`. -/
def Cls (ℓ : ℕ) : Set (p3ModelT n wc).Ω :=
  {ω'' | PousLuckyChain.PrefixEq (chainX (splitFam p) τ G W (2 * D) Q) ℓ ω ω'' ∧
    luckySet p ω'' τ G W D Q = S ∧ hitSlotSet p ω'' τ G W D = H}

theorem Cls_anti : Antitone (Cls p τ G W D Q S H ω) := fun _ _ hle _ h =>
  ⟨fun i hi => h.1 i (lt_of_lt_of_le hi hle), h.2⟩

/-- **The witness**: `ω` is in its own class at every index. -/
theorem self_mem_Cls (hS : luckySet p ω τ G W D Q = S) (hH : hitSlotSet p ω τ G W D = H) (ℓ : ℕ) :
    ω ∈ Cls p τ G W D Q S H ω ℓ :=
  ⟨fun _ _ => rfl, hS, hH⟩

open Classical in
/-- The honest value a source takes. -/
noncomputable def hv : Src n → (p3ModelT n wc).Ω → Lab n wc
  | .K1 w => fun ω'' => ω''.1 (hk1 τ G W ω'' w)
  | .P1 w => fun ω'' => if fI1 p τ G W ω w then in1 τ G W ω'' w else c1 τ G W ω'' w
  | .K2 u => fun ω'' => ω''.1 (hk2 τ G W ω'' u)
  | .P2 u => fun ω'' => if fI2 p τ G W ω u then in2 τ G W ω'' u else c2 τ G W ω'' u
  | .Bh t => fun ω'' => hin τ G W ω'' t

variable {p τ G W D Q S H ω}

theorem srcOf_honest_ne (k : Fin 6) (v : Fin n) (t : Fin 2 × Fin n) :
    srcOf τ G W ω (honestQ τ G W ω (k, v)) ≠ .Bh t := by
  fin_cases k
  · show srcOf τ G W ω (qH1 τ G W ω v) ≠ _; rw [srcOf_qH1]; exact fun h => by cases h
  · show srcOf τ G W ω (qH2 τ G W ω v) ≠ _; rw [srcOf_qH2]; exact fun h => by cases h
  · show srcOf τ G W ω (qP1 τ G W ω v) ≠ _; rw [srcOf_qP1]; exact fun h => by cases h
  · show srcOf τ G W ω (qP2 τ G W ω v) ≠ _; rw [srcOf_qP2]; exact fun h => by cases h
  · show srcOf τ G W ω (qI1 τ G W ω v) ≠ _; rw [srcOf_qI1]; exact fun h => by cases h
  · show srcOf τ G W ω (qI2 τ G W ω v) ≠ _; rw [srcOf_qI2]; exact fun h => by cases h

/-- An asked honest query's slot is no hit slot. -/
theorem honest_not_hitSlot {k : Fin 6} {v : Fin n} (hask : ∃ r, Asked p ω (honestQ τ G W ω (k, v)) r) :
    slotOf p ω (honestQ τ G W ω (k, v)) ∉ hitSlotSet p ω τ G W D := by
  classical
  intro hm
  obtain ⟨t, ht, hs⟩ := Finset.mem_image.1 hm
  have hq : ∃ r, Asked p ω (qHit τ G W ω t) r := by
    simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht
    obtain ⟨r, -, hr⟩ := ht
    exact ⟨r, hr.1.1⟩
  have he := slot_transfer (ω := ω) (ω'' := ω) hask hq hs fun _ => rfl
  have := srcOf_honest_ne (τ := τ) (G := G) (W := W) (ω := ω) k v t
  rw [← he, srcOf_qHit ht] at this
  exact this rfl

/-- **Honest transfer into the class.** -/
theorem honest_eq (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S)
    (hH : hitSlotSet p ω τ G W D = H) {k : Fin 6} {v : Fin n}
    (hask : ∃ r, Asked p ω (honestQ τ G W ω (k, v)) r) {ℓ : ℕ}
    (hℓ : eR n Q (firstRound p ω (honestQ τ G W ω (k, v))) ≤ ℓ) {ω'' : (p3ModelT n wc).Ω}
    (h'' : ω'' ∈ Cls p τ G W D Q S H ω ℓ) : honestQ τ G W ω'' (k, v) = honestQ τ G W ω (k, v) :=
  transfer_honest_split hb (hS.trans h''.2.1.symm) (hH.trans h''.2.2.symm) hask (honest_not_hitSlot hask)
    (prefixEq_mono hℓ h''.1)

/-- The chain variable at a Part A index is the answer to `ω`'s query there. -/
theorem X_eq_answer (hb : ∀ c, (p c).Bounded D Q) {ℓ ℓ' : ℕ} (hA : ℓ < 2 * D * (n * Q)) (hle : ℓ ≤ ℓ')
    {q : (p3ModelT n wc).Qry} (hq : qIdx (splitFam p) (2 * D) Q ω ℓ = some q) {ω'' : (p3ModelT n wc).Ω}
    (h'' : ω'' ∈ Cls p τ G W D Q S H ω ℓ') :
    chainX (splitFam p) τ G W (2 * D) Q ℓ ω'' = (p3ModelT n wc).answer ω'' q := by
  have hq'' : qIdx (splitFam p) (2 * D) Q ω'' ℓ = some q := by
    rw [← qIdx_eq_of_prefix (splitFam p) τ G W (2 * D) Q (bounded_splitFam hb) (prefixEq_mono hle h''.1)]
    exact hq
  exact chainX_of_qIdx hA hq''

theorem qIdx_fA_of_asked (hb : ∀ c, (p c).Bounded D Q) {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked p ω q r) :
    qIdx (splitFam p) (2 * D) Q ω (fA (splitFam p) (2 * D) Q ω q) = some q := by
  obtain ⟨r, hr⟩ := h
  exact qIdx_fA ((exists_qIdx_iff (bounded_splitFam hb)).2 ⟨2 * r, (asked_splitFam_even ω q r).2 hr⟩)

/-- **The chain variable at a realization is the honest value**, for every class member sharing the prefix at or
beyond it. -/
theorem realize_eq (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S)
    (hH : hitSlotSet p ω τ G W D = H) {σ : Src n} (hσ : SrcPresent p τ G W D ω σ) {ℓ : ℕ}
    (hℓ : Rsrc p τ G W D Q ω σ ≤ ℓ) {ω'' : (p3ModelT n wc).Ω} (h'' : ω'' ∈ Cls p τ G W D Q S H ω ℓ) :
    chainX (splitFam p) τ G W (2 * D) Q (Rsrc p τ G W D Q ω σ) ω'' = hv p τ G W ω σ ω'' := by
  classical
  -- a Part A realization by an asked honest query `honestQ (k, v)`
  have viaHonest : ∀ {k : Fin 6} {v : Fin n}, (∃ r, Asked p ω (honestQ τ G W ω (k, v)) r) →
      Rsrc p τ G W D Q ω σ = fA (splitFam p) (2 * D) Q ω (honestQ τ G W ω (k, v)) →
      chainX (splitFam p) τ G W (2 * D) Q (Rsrc p τ G W D Q ω σ) ω'' =
        (p3ModelT n wc).answer ω'' (honestQ τ G W ω'' (k, v)) := fun hask he => by
    rw [he] at hℓ ⊢
    rw [X_eq_answer hb (fA_lt_partB hb hask) hℓ (qIdx_fA_of_asked hb hask) h'']
    rw [honest_eq hb hS hH hask ((eR_le_fA hb hask).trans hℓ) h'']
  cases σ with
  | K1 w =>
    by_cases hq : ∃ r, Asked p ω (qH1 τ G W ω w) r
    · have := viaHonest (k := 0) (v := w) hq (by simp only [Rsrc, RK1, if_pos hq]; rfl)
      rw [this]; rfl
    · have he : Rsrc p τ G W D Q ω (.K1 w) = 2 * D * (n * Q) + 2 * w := by simp [Rsrc, RK1, if_neg hq]
      rw [he, chainX_K1]; rfl
  | K2 u =>
    by_cases hq : ∃ r, Asked p ω (qH2 τ G W ω u) r
    · have := viaHonest (k := 1) (v := u) hq (by simp only [Rsrc, RK2, if_pos hq]; rfl)
      rw [this]; rfl
    · have he : Rsrc p τ G W D Q ω (.K2 u) = 2 * D * (n * Q) + (2 * n + 2 * u) := by
        simp [Rsrc, RK2, if_neg hq]
      rw [he, chainX_K2]; rfl
  | P1 w =>
    by_cases hF : TypF p ω (qP1 τ G W ω w) (qI1 τ G W ω w)
    · have hnI : ¬ fI1 p τ G W ω w := fun hI => not_typF_typI p ω _ _ ⟨hF, hI⟩
      have := viaHonest (k := 2) (v := w) hF.1 (by simp only [Rsrc, RP1, if_pos hF]; rfl)
      rw [this]
      simp only [hv, if_neg hnI]
      exact (c1_eq ω'' w).symm
    · by_cases hI : TypI p ω (qP1 τ G W ω w) (qI1 τ G W ω w)
      · have := viaHonest (k := 4) (v := w) hI.1 (by simp only [Rsrc, RP1, if_neg hF, if_pos hI]; rfl)
        rw [this]
        have hI' : fI1 p τ G W ω w := hI
        simp only [hv, if_pos hI']
        show (ω''.2 (τ, 0, w)).symm (c1 τ G W ω'' w) = _
        rw [c1_eq]
        exact Equiv.symm_apply_apply _ _
      · have hnI : ¬ fI1 p τ G W ω w := hI
        have he : Rsrc p τ G W D Q ω (.P1 w) = 2 * D * (n * Q) + (2 * w + 1) := by
          simp [Rsrc, RP1, if_neg hF, if_neg hI]
        rw [he, chainX_Y1]
        simp only [hv, if_neg hnI]
  | P2 u =>
    by_cases hF : TypF p ω (qP2 τ G W ω u) (qI2 τ G W ω u)
    · have hnI : ¬ fI2 p τ G W ω u := fun hI => not_typF_typI p ω _ _ ⟨hF, hI⟩
      have := viaHonest (k := 3) (v := u) hF.1 (by simp only [Rsrc, RP2, if_pos hF]; rfl)
      rw [this]
      simp only [hv, if_neg hnI]
      exact (c2_eq τ G W ω'' u).symm
    · by_cases hI : TypI p ω (qP2 τ G W ω u) (qI2 τ G W ω u)
      · have := viaHonest (k := 5) (v := u) hI.1 (by simp only [Rsrc, RP2, if_neg hF, if_pos hI]; rfl)
        rw [this]
        have hI' : fI2 p τ G W ω u := hI
        simp only [hv, if_pos hI']
        show (ω''.2 (τ, 1, u)).symm (c2 τ G W ω'' u) = _
        rw [c2_eq]
        exact Equiv.symm_apply_apply _ _
      · have hnI : ¬ fI2 p τ G W ω u := hI
        have he : Rsrc p τ G W D Q ω (.P2 u) = 2 * D * (n * Q) + (2 * n + 2 * u + 1) := by
          simp [Rsrc, RP2, if_neg hF, if_neg hI]
        rw [he, chainX_Y2]
        simp only [hv, if_neg hnI]
  | Bh t =>
    have ht : t ∈ hitsBy p ω τ G W D := hσ
    have hask : ∃ r, Asked p ω (qHit τ G W ω t) r := by
      simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht
      obtain ⟨r, -, hr⟩ := ht
      exact ⟨r, hr.1.1⟩
    have hR : Rsrc p τ G W D Q ω (.Bh t) = fA (splitFam p) (2 * D) Q ω (qHit τ G W ω t) := rfl
    rw [hR] at hℓ ⊢
    rw [X_eq_answer hb (fA_lt_partB hb hask) hℓ (qIdx_fA_of_asked hb hask) h'']
    have h1 := firstRound_pos (p := p) hask
    have hD := firstRound_le_D hb hask
    have hrounds := fun c => rounds_take_eq_of_splitPrefix hb (i := firstRound p ω (qHit τ G W ω t) - 1)
      (by omega) (prefixEq_mono ((eR_le_fA hb hask).trans hℓ) h''.1) c
    rw [Nat.sub_add_cancel h1] at hrounds
    obtain ⟨-, hq⟩ := transfer_hit (hH.trans h''.2.2.symm) ht hrounds
    show ω''.2 (twk τ t) (z0 τ G W ω t) = _
    exact hit_answer_eq hq

end Sem

end PousKnowledge

end


/-! ════ Freshness.LuckyGroupSem ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The semantic hypotheses of a pair group (`credit-resolved.md` §11.5)

- `valG`: the atoms' honest values, as GF(2) words (`0` for an absent or non-virtual unsampled atom).
- **`group_hat`**: a sampled atom is class-fixed after its realization (`realize_eq`).
- **`group_hrel`**: every relation is class-fixed from its effective index.
  - `rc1`, `rx2`, `rc2`, `rx1`: by the honest transfer of the query that credited the token.
  - The hits and the attached relations are XOR identities of honest values.
  - The fixing relations and the absent relations are `0`.
- **`group_pins`**: so `cf_of_inSpan` turns `group_count` into `tokG ≤ #(sampled atoms class-fixed at their
  realization)`. `pin_of_cf` reads such an atom as a fixed component of its chain variable.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

section GSem

variable (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (τ : Bits 256) (G : Labelling.TopoDAG n)
  (W : Fin n → Lab n wc) (D Q : ℕ) (S H : Finset (ℕ × ℕ)) (ω : (p3ModelT n wc).Ω) (u w : Fin n)

/-- The component an atom pins. -/
def gcomp : GA → Fin n
  | .p1 | .k1 | .b1 | .vY => u
  | .k2 | .b2 | .p2 | .vY2 => w

open Classical in
/-- The atoms' honest values. -/
noncomputable def valG : GA → (p3ModelT n wc).Ω → (Fin wc → ZMod 2)
  | .p1 => fun ω'' => zw (hv p τ G W ω (.P1 w) ω'' u)
  | .k1 => fun ω'' => zw (hv p τ G W ω (.K1 w) ω'' u)
  | .b1 => fun ω'' => if fh0 p τ G W D ω w then zw (hv p τ G W ω (.Bh ((0 : Fin 2), w)) ω'' u) else 0
  | .k2 => fun ω'' => zw (hv p τ G W ω (.K2 u) ω'' w)
  | .b2 => fun ω'' => if fh1 p τ G W D ω u then zw (hv p τ G W ω (.Bh ((1 : Fin 2), u)) ω'' w) else 0
  | .p2 => fun ω'' => if fI2 p τ G W ω u then zw (hv p τ G W ω (.P2 u) ω'' w) else 0
  | .vY => fun ω'' => if fI1 p τ G W ω w then zw (c1 τ G W ω'' w u) else 0
  | .vY2 => fun ω'' => if fI2 p τ G W ω u then zw (c2 τ G W ω'' u w) else 0

variable {p τ G W D Q S H ω u w}

theorem valG_sampled {a : GA} (ha : a ∈ sampled p τ G W D ω u w) :
    valG p τ G W D ω u w a = fun ω'' => zw (hv p τ G W ω (gsrc u w a) ω'' (gcomp u w a)) := by
  classical
  cases a with
  | b1 =>
    have h : fh0 p τ G W D ω w := by by_contra h; exact b1_not_sampled p τ G W D ω u w h ha
    funext ω''; simp only [valG, if_pos h]; rfl
  | b2 =>
    have h : fh1 p τ G W D ω u := by by_contra h; exact b2_not_sampled p τ G W D ω u w h ha
    funext ω''; simp only [valG, if_pos h]; rfl
  | p2 =>
    have h : fI2 p τ G W ω u := by by_contra h; exact p2_not_sampled p τ G W D ω u w h ha
    funext ω''; simp only [valG, if_pos h]; rfl
  | vY => exact absurd ha (vY_not_sampled p τ G W D ω u w)
  | vY2 => exact absurd ha (vY2_not_sampled p τ G W D ω u w)
  | _ => rfl

/-- **Hypothesis `hat`**: a sampled atom is class-fixed after its realization. -/
theorem group_hat (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S)
    (hH : hitSlotSet p ω τ G W D = H) :
    ∀ a ∈ sampled p τ G W D ω u w, ∀ ℓ, ka p τ G W D Q ω u w a < ℓ →
      PousRank.CF (Cls p τ G W D Q S H ω) ω ℓ (valG p τ G W D ω u w a) := by
  intro a ha ℓ hlt ω'' h''
  rw [valG_sampled ha]
  simp only
  rw [ka_eq_Rsrc p τ G W D Q ω u w ha] at hlt
  have hσ := gsrc_present p τ G W D ω u w ha
  have e1 := realize_eq hb hS hH hσ hlt.le h''
  have e2 := realize_eq hb hS hH hσ hlt.le (self_mem_Cls p τ G W D Q S H ω hS hH ℓ)
  have e3 := h''.1 _ hlt
  rw [← e1, ← e2, e3]

/-! ### Evaluating forms -/

theorem eval_ev (f : GA → (p3ModelT n wc).Ω → (Fin wc → ZMod 2)) (a : GA) :
    PousRank.eval f (ev a) = f a := by
  funext ω''; exact PousRank.eval_single f a ω''

theorem eval_add (f : GA → (p3ModelT n wc).Ω → (Fin wc → ZMod 2)) (x y : GA → ZMod 2) :
    PousRank.eval f (x + y) = fun ω'' => PousRank.eval f x ω'' + PousRank.eval f y ω'' := by
  funext ω''
  simp only [PousRank.eval, Pi.add_apply, add_smul, Finset.sum_add_distrib]

theorem eval_zero (f : GA → (p3ModelT n wc).Ω → (Fin wc → ZMod 2)) : PousRank.eval f 0 = fun _ => 0 := by
  funext ω''; simp [PousRank.eval]

theorem cf_const {ℓ : ℕ} (c : Fin wc → ZMod 2) :
    PousRank.CF (Cls p τ G W D Q S H ω) ω ℓ (fun _ => c) := fun _ _ => rfl

theorem valG_c1a (ω'' : (p3ModelT n wc).Ω) :
    valG p τ G W D ω u w (c1a p τ G W ω w) ω'' = zw (c1 τ G W ω'' w u) := by
  classical
  rcases c1a_cases p τ G W ω w with ⟨hc, hI⟩ | ⟨hc, hI⟩
  · rw [hc]; simp only [valG, if_pos hI]
  · rw [hc]; simp only [valG, hv, if_neg hI]

theorem in2_comp (ω'' : (p3ModelT n wc).Ω) :
    zw (c1 τ G W ω'' w u) + zw (ω''.1 (hk2 τ G W ω'' u) w) = zw (in2 τ G W ω'' u w) := by
  rw [← zw_bxor]; rfl

theorem in1_comp (ω'' : (p3ModelT n wc).Ω) :
    zw (in1 τ G W ω'' w u) + zw (ω''.1 (hk1 τ G W ω'' w) u) = zw (W w u) := by
  rw [← zw_bxor]
  congr 1
  show Labelling.bxor (Labelling.bxor (W w u) (ω''.1 (hk1 τ G W ω'' w) u)) (ω''.1 (hk1 τ G W ω'' w) u) = W w u
  funext i; simp [Labelling.bxor]

theorem zero_comp (ω'' : (p3ModelT n wc).Ω) :
    zw (in2 τ G W ω'' u w) + zw (c1 τ G W ω'' w u) + zw (ω''.1 (hk2 τ G W ω'' u) w) = 0 := by
  rw [add_assoc, in2_comp]
  funext i; simp only [Pi.add_apply, Pi.zero_apply]
  exact CharTwo.add_self_eq_zero _

/-! ### The relations are class-fixed -/

theorem cf_c1 (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S) (hH : hitSlotSet p ω τ G W D = H)
    {r : ℕ} (hq : (∃ v, w ∈ G.par v ∧ FirstAt p ω (qH1 τ G W ω v) (r + 1)) ∨ FirstAt p ω (qI1 τ G W ω w) (r + 1))
    {ω'' : (p3ModelT n wc).Ω} (h'' : ω'' ∈ Cls p τ G W D Q S H ω (eR n Q (r + 1))) :
    c1 τ G W ω'' w = c1 τ G W ω w := by
  classical
  rcases hq with ⟨v, hv, hf⟩ | hf
  · have he := honest_eq (k := 0) (v := v) hb hS hH ⟨_, hf.1⟩ (by simp only [honestQ]; rw [firstRound_eq p ω hf]) h''
    have hk : hk1 τ G W ω'' v = hk1 τ G W ω v := Sum.inl.inj he
    have := congrFun (congrArg (fun k : KQ' n wc => k.2.2.2) hk) w
    simp only [hk1, dif_pos hv, Option.some.injEq] at this
    exact this
  · have he := honest_eq (k := 4) (v := w) hb hS hH ⟨_, hf.1⟩ (by simp only [honestQ]; rw [firstRound_eq p ω hf]) h''
    have := (inv_eq_gen he).2
    exact this
where
  inv_eq_gen {t t' : Tweak n} {x x' : Lab n wc}
      (h : (Sum.inr (Sum.inr (t, x)) : (p3ModelT n wc).Qry) = Sum.inr (Sum.inr (t', x'))) : t = t' ∧ x = x' := by
    injection h with h; injection h with h; injection h with h1 h2; exact ⟨h1, h2⟩

theorem cf_c2 (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S) (hH : hitSlotSet p ω τ G W D = H)
    {r : ℕ} (hq : (∃ v, u ∈ G.par v ∧ FirstAt p ω (qH2 τ G W ω v) (r + 1)) ∨ FirstAt p ω (qI2 τ G W ω u) (r + 1))
    {ω'' : (p3ModelT n wc).Ω} (h'' : ω'' ∈ Cls p τ G W D Q S H ω (eR n Q (r + 1))) :
    c2 τ G W ω'' u = c2 τ G W ω u := by
  classical
  rcases hq with ⟨v, hv, hf⟩ | hf
  · have he := honest_eq (k := 1) (v := v) hb hS hH ⟨_, hf.1⟩ (by simp only [honestQ]; rw [firstRound_eq p ω hf]) h''
    have hk : hk2 τ G W ω'' v = hk2 τ G W ω v := Sum.inl.inj he
    have := congrFun (congrArg (fun k : KQ' n wc => k.2.2.2) hk) u
    simp only [hk2, dif_pos hv, Option.some.injEq] at this
    exact this
  · have he := honest_eq (k := 5) (v := u) hb hS hH ⟨_, hf.1⟩ (by simp only [honestQ]; rw [firstRound_eq p ω hf]) h''
    exact (cf_c1.inv_eq_gen he).2

/-- A type-I top credited in the group was credited by T1 or T2 at `topRound`. -/
theorem top_c2rule_of_I (hb : ∀ c, (p c).Bounded D Q) (h : pres p τ G W D ω u w .rc2) :
    ∃ r < D, topRound p τ G W D ω u = r + 1 ∧
      ((∃ v, u ∈ G.par v ∧ FirstAt p ω (qH2 τ G W ω v) (r + 1)) ∨ FirstAt p ω (qI2 τ G W ω u) (r + 1)) := by
  classical
  obtain ⟨ht, hI⟩ := h
  have hex : ∃ r < D, u ∈ (roundCred p ω τ G W (Cg p ω τ G W r) (r + 1)).hold.topWhole := by
    rcases (mem_cred3_topWhole p ω τ G W).1 ht.1 with h' | hout
    · exact h'
    · simp only [creditedOut, Finset.mem_filter, Finset.mem_univ, true_and] at hout
      exact absurd hI.1 (typY2_of_output p ω τ G W hb hout.2).2
  have htr : topRound p τ G W D ω u = Nat.find hex + 1 := by simp only [topRound, dif_pos hex]
  obtain ⟨hrD, hmem⟩ := Nat.find_spec hex
  generalize Nat.find hex = r at htr hrD hmem
  refine ⟨r, hrD, htr, ?_⟩
  have hmem' := hmem
  simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, Nat.add_sub_cancel] at hmem'
  rcases hmem'.2 with h1 | h2 | ⟨h3, -⟩
  · exact Or.inl h1
  · exact Or.inr h2
  · exact absurd hI (fun hI' => not_typF_typI p ω _ _ ⟨typF2_of_qP2 p ω τ G W h3 hmem'.1, hI'⟩)

/-- **Hypothesis `hrel`**: every relation is class-fixed from its effective index. -/
theorem group_hrel (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S)
    (hH : hitSlotSet p ω τ G W D = H) (r : GR) :
    PousRank.CF (Cls p τ G W D Q S H ω) ω (ofLex (kr p τ G W D Q ω u w r)).1
      (PousRank.eval (valG p τ G W D ω u w) (form p τ G W D ω u w r)) := by
  classical
  simp only [kr, ofLex_toLex]
  by_cases hp : pres p τ G W D ω u w r
  swap
  · rw [form_of_not_pres p τ G W D ω u w hp, eval_zero]; exact cf_const _
  rw [form_of_pres p τ G W D ω u w hp]
  intro ω'' h''
  cases r with
  | rc1 =>
    obtain ⟨hrD, -, hq⟩ := Nat.find_spec hp.2
    have heI : eIdx p τ G W D Q ω u w .rc1 = eR n Q (Nat.find hp.2 + 1) := by
      simp only [eIdx, colRound, dif_pos hp.2]
    rw [heI] at h''
    simp only [baseForm, eval_ev, valG_c1a]
    rw [cf_c1 hb hS hH hq h'']
  | rx2 =>
    obtain ⟨r, -, hf, -, -⟩ := rx2_cases p τ G W D ω u w hp
    have heI : eIdx p τ G W D Q ω u w .rx2 = eR n Q (r + 1) := by simp only [eIdx, firstRound_eq p ω hf]
    rw [heI] at h''
    simp only [baseForm, eval_add, eval_ev, valG_c1a]
    simp only [valG, hv]
    rw [in2_comp, in2_comp]
    have he := honest_eq (k := 3) (v := u) hb hS hH ⟨_, hf.1⟩ (by simp only [honestQ]; rw [firstRound_eq p ω hf]) h''
    have : in2 τ G W ω'' u = in2 τ G W ω u := by
      injection he with h; injection h with h; injection h with h1 h2
    rw [this]
  | rc2 =>
    obtain ⟨r, -, hr, hq⟩ := top_c2rule_of_I hb hp
    have heI : eIdx p τ G W D Q ω u w .rc2 = eR n Q (r + 1) := by simp only [eIdx, hr]
    rw [heI] at h''
    simp only [baseForm, eval_ev, valG, if_pos hp.2]
    rw [cf_c2 hb hS hH hq h'']
  | rx1 =>
    obtain ⟨r, -, hk⟩ := (mem_cred3_lowerKey p ω τ G W).1 hp
    have hk' := hk
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at hk'
    have hf := hk'.1
    have heI : eIdx p τ G W D Q ω u w .rx1 = eR n Q (r + 1) := by simp only [eIdx, firstRound_eq p ω hf]
    rw [heI] at h''
    simp only [baseForm, eval_ev, valG, hv]
    have he := honest_eq (k := 2) (v := w) hb hS hH ⟨_, hf.1⟩ (by simp only [honestQ]; rw [firstRound_eq p ω hf]) h''
    have hin : in1 τ G W ω'' w = in1 τ G W ω w := by
      injection he with h; injection h with h; injection h with h1 h2
    have key : ∀ ω₁ : (p3ModelT n wc).Ω, ω₁.1 (hk1 τ G W ω₁ w) u = Labelling.bxor (W w u) (in1 τ G W ω₁ w u) := by
      intro ω₁; funext i; simp [in1, labXor, Labelling.bxor]
    rw [key, key, hin]
  | rh0 =>
    have h0 : fh0 p τ G W D ω w := hp
    simp only [baseForm, eval_add, eval_ev]
    simp only [valG, hv, if_pos h0]
    show zw (in1 τ G W ω'' w u) + zw (ω''.1 (hk1 τ G W ω'' w) u) = zw (in1 τ G W ω w u) + zw (ω.1 (hk1 τ G W ω w) u)
    rw [in1_comp, in1_comp]
  | rh1 =>
    have h1 : fh1 p τ G W D ω u := hp
    simp only [baseForm, eval_add, eval_ev]
    rw [valG_c1a, valG_c1a]
    simp only [valG, hv, if_pos h1]
    show zw (in2 τ G W ω'' u w) + zw (c1 τ G W ω'' w u) + zw (ω''.1 (hk2 τ G W ω'' u) w) =
      zw (in2 τ G W ω u w) + zw (c1 τ G W ω w u) + zw (ω.1 (hk2 τ G W ω u) w)
    rw [zero_comp, zero_comp]
  | rIw =>
    have hI : fI1 p τ G W ω w := hp
    simp only [baseForm, eval_add, eval_ev, valG, hv, if_pos hI]
    rw [in1_comp, in1_comp]
  | rIu =>
    have hI : fI2 p τ G W ω u := hp
    simp only [baseForm, eval_add, eval_ev]
    rw [valG_c1a, valG_c1a]
    simp only [valG, hv, if_pos hI]
    rw [zero_comp, zero_comp]
  | ab1 => have h0 : ¬ fh0 p τ G W D ω w := hp; simp only [baseForm, eval_ev, valG, if_neg h0]
  | ab2 => have h0 : ¬ fh1 p τ G W D ω u := hp; simp only [baseForm, eval_ev, valG, if_neg h0]
  | ap2 => have h0 : ¬ fI2 p τ G W ω u := hp; simp only [baseForm, eval_ev, valG, if_neg h0]
  | aY => have h0 : ¬ fI1 p τ G W ω w := hp; simp only [baseForm, eval_ev, valG, if_neg h0]
  | aY2 => have h0 : ¬ fI2 p τ G W ω u := hp; simp only [baseForm, eval_ev, valG, if_neg h0]

open Classical in
/-- **The group's pins.** Its tokens number at most its sampled atoms class-fixed at their realization. -/
theorem group_pins (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S)
    (hH : hitSlotSet p ω τ G W D = H) :
    tokG p τ G W D ω u w ≤ ((sampled p τ G W D ω u w).filter fun a =>
      PousRank.CF (Cls p τ G W D Q S H ω) ω (ka p τ G W D Q ω u w a) (valG p τ G W D ω u w a)).card := by
  refine (group_count p τ G W D Q ω u w hb).trans ?_
  have hsub : ((Finset.univ.filter (PousRank.InSpan (sampled p τ G W D ω u w) 13 (ka p τ G W D Q ω u w)
      (form p τ G W D ω u w) (kr p τ G W D Q ω u w))).map (Function.Embedding.subtype _)) ⊆
      (sampled p τ G W D ω u w).filter fun a =>
        PousRank.CF (Cls p τ G W D Q S H ω) ω (ka p τ G W D Q ω u w a) (valG p τ G W D ω u w a) := by
    intro a ha
    obtain ⟨a', ha', rfl⟩ := Finset.mem_map.1 ha
    refine Finset.mem_filter.2 ⟨a'.2, ?_⟩
    exact PousRank.cf_of_inSpan (Cls_anti p τ G W D Q S H ω) _ 13 _ _ _ (group_hat hb hS hH)
      (group_hrel hb hS hH) (Finset.mem_filter.1 ha').2
  have := Finset.card_le_card hsub
  rwa [Finset.card_map] at this

/-- **A class-fixed atom is a fixed component of its chain variable.** -/
theorem pin_of_cf (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S)
    (hH : hitSlotSet p ω τ G W D = H) {a : GA} (ha : a ∈ sampled p τ G W D ω u w)
    (hcf : PousRank.CF (Cls p τ G W D Q S H ω) ω (ka p τ G W D Q ω u w a) (valG p τ G W D ω u w a))
    {ω'' : (p3ModelT n wc).Ω} (h'' : ω'' ∈ Cls p τ G W D Q S H ω (ka p τ G W D Q ω u w a)) :
    chainX (splitFam p) τ G W (2 * D) Q (ka p τ G W D Q ω u w a) ω'' (gcomp u w a) =
      chainX (splitFam p) τ G W (2 * D) Q (ka p τ G W D Q ω u w a) ω (gcomp u w a) := by
  have hka := ka_eq_Rsrc p τ G W D Q ω u w ha
  have hσ := gsrc_present p τ G W D ω u w ha
  have e := hcf ω'' h''
  rw [valG_sampled ha] at e
  simp only at e
  rw [hka] at h'' ⊢
  rw [realize_eq hb hS hH hσ le_rfl h'', realize_eq hb hS hH hσ le_rfl (self_mem_Cls p τ G W D Q S H ω hS hH _)]
  exact zw_injective e

end GSem

end PousKnowledge

end


/-! ════ Freshness.LuckyGroupC ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The single-atom groups `C(u, i)`, and freshness at every realization (`credit-resolved.md` §11.3, §11.7)

- **`c_pin`**: a top `u` whose token lies in `C(u, ·)` (`tokC u`) pins every component of its pair variable `P2[u]` at
  its realization `RP2 u`. Such a top is credited by a `c²`-rule (T1/T2, or an output) with type F/Y, so the value
  there is `c²_u`.
  - That `c²_u` is class-fixed from the credit round (`cf_c2`, `c2_eq_of_output`).
  - The credit round comes no later than the realization: `qP2 u` is not asked before the credit (the top would
    already be in the game, E8), and an output's top is type Y (Part B).
- **`pool_Rsrc`**: every present source's realization is fresh, `Pool ≥ M − n·Q`. A first `H` point, a
  forward/inverse first ask whose partner came later (F, I, a hit), or Part B.
- **`Rsrc_lt_m`**: realizations lie below `m = 2D·n·Q + 4n`.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

section CGroup

variable {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)} {τ : Bits 256} {G : Labelling.TopoDAG n}
  {W : Fin n → Lab n wc} {D Q : ℕ} {S H : Finset (ℕ × ℕ)} {ω : (p3ModelT n wc).Ω}

theorem firstAt_firstRound {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked p ω q r) :
    FirstAt p ω q (firstRound p ω q) := by
  classical
  refine ⟨asked_firstRound p ω h, fun h' => ?_⟩
  have h1 := firstRound_pos (p := p) h
  have hmin : firstRound p ω q ≤ firstRound p ω q - 1 := by
    have e : firstRound p ω q = Nat.find h := by unfold firstRound; rw [dif_pos h]
    rw [e] at h' ⊢
    exact Nat.find_min' h h'
  omega

theorem firstRound_le_of_asked {q : (p3ModelT n wc).Qry} {r : ℕ} (h : Asked p ω q r) : firstRound p ω q ≤ r := by
  classical
  unfold firstRound
  rw [dif_pos ⟨r, h⟩]
  exact Nat.find_min' _ h

theorem asked_of_qIdx (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} {q : (p3ModelT n wc).Qry}
    (h : qIdx (splitFam p) (2 * D) Q ω ℓ = some q) : ∃ r, Asked p ω q r := by
  obtain ⟨r, hr⟩ := (exists_qIdx_iff (bounded_splitFam hb)).1 ⟨ℓ, h⟩
  exact ⟨r, (asked_splitFam_even ω q r).1 (asked_mono (by omega) hr)⟩

theorem eR_mono {r r' : ℕ} (h : r ≤ r') : eR n Q r ≤ eR n Q r' := Nat.mul_le_mul_right _ (by omega)

/-- The first ask of a forward query lies in the first half-round of its first round. -/
theorem fA_fwd (hb : ∀ c, (p c).Bounded D Q) {q : (p3ModelT n wc).Qry} (hq : isInvQ q = false)
    (h : ∃ r, Asked p ω q r) : fA (splitFam p) (2 * D) Q ω q < (2 * (firstRound p ω q - 1) + 1) * (n * Q) :=
  (fA_split_fwd hb hq (firstAt_firstRound h)).2

/-- The first ask of an inverse query lies in the second half-round of its first round. -/
theorem fA_inv (hb : ∀ c, (p c).Bounded D Q) {q : (p3ModelT n wc).Qry} (hq : isInvQ q = true)
    (h : ∃ r, Asked p ω q r) :
    (2 * (firstRound p ω q - 1) + 1) * (n * Q) ≤ fA (splitFam p) (2 * D) Q ω q ∧
      fA (splitFam p) (2 * D) Q ω q < (2 * (firstRound p ω q - 1) + 2) * (n * Q) :=
  fA_split_inv hb hq (firstAt_firstRound h)

/-- A forward query first asked no later than its partner inverse query precedes it in the split chain. -/
theorem fwd_before_inv (hb : ∀ c, (p c).Bounded D Q) {qF qI : (p3ModelT n wc).Qry} (hF : isInvQ qF = false)
    (hI : isInvQ qI = true) (haF : ∃ r, Asked p ω qF r) (haI : ∃ r, Asked p ω qI r)
    (hle : firstRound p ω qF ≤ firstRound p ω qI) :
    fA (splitFam p) (2 * D) Q ω qF < fA (splitFam p) (2 * D) Q ω qI := by
  have h1 := fA_fwd hb hF haF
  have h2 := (fA_inv hb hI haI).1
  have h3 : (2 * (firstRound p ω qF - 1) + 1) * (n * Q) ≤ (2 * (firstRound p ω qI - 1) + 1) * (n * Q) :=
    Nat.mul_le_mul_right _ (by omega)
  omega

/-- An inverse query first asked strictly before its partner forward query precedes it in the split chain. -/
theorem inv_before_fwd (hb : ∀ c, (p c).Bounded D Q) {qF qI : (p3ModelT n wc).Qry} (hF : isInvQ qF = false)
    (hI : isInvQ qI = true) (haF : ∃ r, Asked p ω qF r) (haI : ∃ r, Asked p ω qI r)
    (hlt : firstRound p ω qI < firstRound p ω qF) :
    fA (splitFam p) (2 * D) Q ω qI < fA (splitFam p) (2 * D) Q ω qF := by
  have h1 := (fA_inv hb hI haI).2
  have h2 := (fA_split_fwd hb hF (firstAt_firstRound haF)).1
  have h0 := firstRound_pos (p := p) haI
  have h3 : (2 * (firstRound p ω qI - 1) + 2) * (n * Q) ≤ (2 * (firstRound p ω qF - 1)) * (n * Q) :=
    Nat.mul_le_mul_right _ (by omega)
  omega

/-- A query not asked before its first index. -/
theorem not_before (hb : ∀ c, (p c).Bounded D Q) {q q' : (p3ModelT n wc).Qry}
    (hlt : ∀ (_ : ∃ r, Asked p ω q' r), fA (splitFam p) (2 * D) Q ω q < fA (splitFam p) (2 * D) Q ω q') :
    ∀ ℓ' < fA (splitFam p) (2 * D) Q ω q, qIdx (splitFam p) (2 * D) Q ω ℓ' ≠ some q' := by
  intro ℓ' hℓ' h
  have := hlt (asked_of_qIdx hb h)
  have := fA_le h
  omega

theorem not_partA (hb : ∀ c, (p c).Bounded D Q) {q : (p3ModelT n wc).Qry} (h : ¬ ∃ r, Asked p ω q r) :
    ∀ ℓ' < 2 * D * (n * Q), qIdx (splitFam p) (2 * D) Q ω ℓ' ≠ some q :=
  fun _ _ h' => h (asked_of_qIdx hb h')

/-- **Every present source's realization is fresh.** -/
theorem pool_Rsrc (hb : ∀ c, (p c).Bounded D Q) {σ : Src n} (hσ : SrcPresent p τ G W D ω σ) :
    2 ^ (n * wc) - n * Q ≤ Pool (splitFam p) τ G W (2 * D) Q (Rsrc p τ G W D Q ω σ) ω := by
  classical
  have hb' := bounded_splitFam hb
  have hH : ∀ {q : (p3ModelT n wc).Qry} {h : KQ' n wc}, q = Sum.inl h → (∃ r, Asked p ω q r) →
      2 ^ (n * wc) - n * Q ≤ Pool (splitFam p) τ G W (2 * D) Q (fA (splitFam p) (2 * D) Q ω q) ω := by
    rintro q h rfl ha
    rw [pool_fresh_H (fA_lt_partB hb ha) (qIdx_fA_of_asked hb ha) (fun ℓ' hℓ' => not_qIdx_of_lt_fA hℓ')]
    exact Nat.sub_le _ _
  cases σ with
  | K1 w =>
    by_cases hq : ∃ r, Asked p ω (qH1 τ G W ω w) r
    · have e : Rsrc p τ G W D Q ω (.K1 w) = fA (splitFam p) (2 * D) Q ω (qH1 τ G W ω w) := by
        simp only [Rsrc, RK1, if_pos hq]
      rw [e]; exact hH rfl hq
    · have e : Rsrc p τ G W D Q ω (.K1 w) = 2 * D * (n * Q) + 2 * w := by simp only [Rsrc, RK1, if_neg hq]
      rw [e, pool_fresh_K1 w (not_partA hb hq)]; exact Nat.sub_le _ _
  | K2 u =>
    by_cases hq : ∃ r, Asked p ω (qH2 τ G W ω u) r
    · have e : Rsrc p τ G W D Q ω (.K2 u) = fA (splitFam p) (2 * D) Q ω (qH2 τ G W ω u) := by
        simp only [Rsrc, RK2, if_pos hq]
      rw [e]; exact hH rfl hq
    · have e : Rsrc p τ G W D Q ω (.K2 u) = 2 * D * (n * Q) + (2 * n + 2 * u) := by
        simp only [Rsrc, RK2, if_neg hq]
      rw [e, pool_fresh_K2 u (not_partA hb hq)]; exact Nat.sub_le _ _
  | P1 w =>
    by_cases hF : TypF p ω (qP1 τ G W ω w) (qI1 τ G W ω w)
    · have e : Rsrc p τ G W D Q ω (.P1 w) = fA (splitFam p) (2 * D) Q ω (qP1 τ G W ω w) := by
        simp only [Rsrc, RP1, if_pos hF]
      rw [e]
      refine pool_fresh_fwd hb' (fA_lt_partB hb hF.1) (qIdx_fA_of_asked hb hF.1) (fun ℓ' hℓ' => not_qIdx_of_lt_fA hℓ')
        ?_
      have := not_before hb (q := qP1 τ G W ω w) (q' := qI1 τ G W ω w)
        (fun hI => fwd_before_inv hb rfl rfl hF.1 hI (hF.2 hI))
      intro ℓ' hℓ' h
      exact this ℓ' hℓ' (by rw [h]; show _ = some (Sum.inr (Sum.inr (_, c1 τ G W ω w))); rw [c1_eq])
    · by_cases hI : TypI p ω (qP1 τ G W ω w) (qI1 τ G W ω w)
      · have e : Rsrc p τ G W D Q ω (.P1 w) = fA (splitFam p) (2 * D) Q ω (qI1 τ G W ω w) := by
          simp only [Rsrc, RP1, if_neg hF, if_pos hI]
        rw [e]
        refine pool_fresh_inv hb' (fA_lt_partB hb hI.1) (qIdx_fA_of_asked hb hI.1)
          (fun ℓ' hℓ' => not_qIdx_of_lt_fA hℓ') ?_
        have := not_before hb (q := qI1 τ G W ω w) (q' := qP1 τ G W ω w)
          (fun hP => inv_before_fwd hb rfl rfl hP hI.1 (hI.2 hP))
        intro ℓ' hℓ' h
        refine this ℓ' hℓ' (by rw [h]; show _ = some (Sum.inr (Sum.inl (_, in1 τ G W ω w))); rw [c1_eq]; simp)
      · have hY : TypY p ω (qP1 τ G W ω w) (qI1 τ G W ω w) := by
          rcases typ_cases p ω (qP1 τ G W ω w) (qI1 τ G W ω w) with h | h | h
          · exact absurd h hF
          · exact absurd h hI
          · exact h
        have e : Rsrc p τ G W D Q ω (.P1 w) = 2 * D * (n * Q) + (2 * w + 1) := by
          simp only [Rsrc, RP1, if_neg hF, if_neg hI]
        rw [e]; exact pool_fresh_Y1 hb' w (not_partA hb hY.1) (not_partA hb hY.2)
  | P2 u =>
    by_cases hF : TypF p ω (qP2 τ G W ω u) (qI2 τ G W ω u)
    · have e : Rsrc p τ G W D Q ω (.P2 u) = fA (splitFam p) (2 * D) Q ω (qP2 τ G W ω u) := by
        simp only [Rsrc, RP2, if_pos hF]
      rw [e]
      refine pool_fresh_fwd hb' (fA_lt_partB hb hF.1) (qIdx_fA_of_asked hb hF.1) (fun ℓ' hℓ' => not_qIdx_of_lt_fA hℓ')
        ?_
      have := not_before hb (q := qP2 τ G W ω u) (q' := qI2 τ G W ω u)
        (fun hI => fwd_before_inv hb rfl rfl hF.1 hI (hF.2 hI))
      intro ℓ' hℓ' h
      exact this ℓ' hℓ' (by rw [h]; show _ = some (Sum.inr (Sum.inr (_, c2 τ G W ω u))); rw [c2_eq])
    · by_cases hI : TypI p ω (qP2 τ G W ω u) (qI2 τ G W ω u)
      · have e : Rsrc p τ G W D Q ω (.P2 u) = fA (splitFam p) (2 * D) Q ω (qI2 τ G W ω u) := by
          simp only [Rsrc, RP2, if_neg hF, if_pos hI]
        rw [e]
        refine pool_fresh_inv hb' (fA_lt_partB hb hI.1) (qIdx_fA_of_asked hb hI.1)
          (fun ℓ' hℓ' => not_qIdx_of_lt_fA hℓ') ?_
        have := not_before hb (q := qI2 τ G W ω u) (q' := qP2 τ G W ω u)
          (fun hP => inv_before_fwd hb rfl rfl hP hI.1 (hI.2 hP))
        intro ℓ' hℓ' h
        refine this ℓ' hℓ' (by rw [h]; show _ = some (Sum.inr (Sum.inl (_, in2 τ G W ω u))); rw [c2_eq]; simp)
      · have hY : TypY p ω (qP2 τ G W ω u) (qI2 τ G W ω u) := by
          rcases typ_cases p ω (qP2 τ G W ω u) (qI2 τ G W ω u) with h | h | h
          · exact absurd h hF
          · exact absurd h hI
          · exact h
        have e : Rsrc p τ G W D Q ω (.P2 u) = 2 * D * (n * Q) + (2 * n + 2 * u + 1) := by
          simp only [Rsrc, RP2, if_neg hF, if_neg hI]
        rw [e]; exact pool_fresh_Y2 hb' u (not_partA hb hY.1) (not_partA hb hY.2)
  | Bh t =>
    have ht : t ∈ hitsBy p ω τ G W D := hσ
    have ht' := ht
    simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht'
    obtain ⟨rh, -, hf, -, hnI⟩ := ht'
    have hask : ∃ r, Asked p ω (qHit τ G W ω t) r := ⟨rh, hf.1⟩
    show 2 ^ (n * wc) - n * Q ≤ Pool (splitFam p) τ G W (2 * D) Q (fA (splitFam p) (2 * D) Q ω (qHit τ G W ω t)) ω
    refine pool_fresh_fwd hb' (fA_lt_partB hb hask) (qIdx_fA_of_asked hb hask) (fun ℓ' hℓ' => not_qIdx_of_lt_fA hℓ')
      ?_
    have := not_before hb (q := qHit τ G W ω t) (q' := qInvIn τ G W ω t) fun hI => by
      have hr := firstRound_eq p ω hf
      have hge : rh ≤ firstRound p ω (qInvIn τ G W ω t) := by
        by_contra hlt
        exact hnI (asked_mono (by omega) (asked_firstRound p ω hI))
      exact fwd_before_inv hb rfl rfl hask hI (by omega)
    intro ℓ' hℓ' h
    refine this ℓ' hℓ' (by rw [h]; show _ = some (Sum.inr (Sum.inr (_, hin τ G W ω t))); simp [z0])

theorem offB_lt {σ : Src n} (hσ : ∀ t, σ ≠ .Bh t) : offB σ < 4 * n := by
  cases σ with
  | K1 w => simp only [offB]; omega
  | P1 w => simp only [offB]; omega
  | K2 u => simp only [offB]; omega
  | P2 u => simp only [offB]; omega
  | Bh t => exact absurd rfl (hσ t)

theorem Rsrc_lt_m (hb : ∀ c, (p c).Bounded D Q) {σ : Src n} (hσ : SrcPresent p τ G W D ω σ) :
    Rsrc p τ G W D Q ω σ < 2 * D * (n * Q) + 4 * n := by
  rcases Rsrc_spec hb hσ with ⟨-, -, -, hlt⟩ | ⟨hnb, he⟩
  · omega
  · have := offB_lt hnb; omega

/-! ### The groups `C(u, i)` -/

open Classical in
/-- Top `u`'s tokens lie in `C(u, ·)`: credited by a `c²`-rule, with type F/Y. -/
def tokC (u : Fin n) : Prop :=
  u ∈ (cred3 p ω τ G W D).hold.topWhole ∧ ¬ fI2 p τ G W ω u ∧ c2rule p τ G W D ω u

/-- **The `C(u, i)` pin**: the pair variable `P2[u]` is fixed, every component, at its realization. -/
theorem c_pin (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S) (hH : hitSlotSet p ω τ G W D = H)
    {u : Fin n} (htok : tokC (p := p) (ω := ω) (τ := τ) (G := G) (W := W) (D := D) u) {ω'' : (p3ModelT n wc).Ω}
    (h'' : ω'' ∈ Cls p τ G W D Q S H ω (RP2 p τ G W D Q ω u)) (i : Fin n) :
    chainX (splitFam p) τ G W (2 * D) Q (RP2 p τ G W D Q ω u) ω'' i =
      chainX (splitFam p) τ G W (2 * D) Q (RP2 p τ G W D Q ω u) ω i := by
  classical
  obtain ⟨-, hnI, hrule⟩ := htok
  have hR : RP2 p τ G W D Q ω u = Rsrc p τ G W D Q ω (.P2 u) := rfl
  have e1 := realize_eq (σ := .P2 u) hb hS hH trivial le_rfl (by rw [← hR]; exact h'')
  have e2 := realize_eq (σ := .P2 u) hb hS hH trivial le_rfl (self_mem_Cls p τ G W D Q S H ω hS hH _)
  rw [← hR] at e1 e2
  rw [e1, e2]
  simp only [hv, if_neg hnI]
  have hB : ¬ TypF p ω (qP2 τ G W ω u) (qI2 τ G W ω u) → 2 * D * (n * Q) ≤ RP2 p τ G W D Q ω u := by
    intro hF
    have hnI' : ¬ TypI p ω (qP2 τ G W ω u) (qI2 τ G W ω u) := hnI
    simp only [RP2, if_neg hF, if_neg hnI']
    omega
  rcases hrule with ⟨r, hrD, hmem, hq⟩ | hout
  · have hle : eR n Q (r + 1) ≤ RP2 p τ G W D Q ω u := by
      by_cases hF : TypF p ω (qP2 τ G W ω u) (qI2 τ G W ω u)
      · have hge : r + 1 ≤ firstRound p ω (qP2 τ G W ω u) := by
          by_contra hlt
          have ha : Asked p ω (qP2 τ G W ω u) r := asked_mono (by omega) (asked_firstRound p ω hF.1)
          exact (not_credit_of_inGame p ω τ G W (topWhole_of_asked_qP2 p ω τ G W ha)).1 hmem
        have e : RP2 p τ G W D Q ω u = fA (splitFam p) (2 * D) Q ω (qP2 τ G W ω u) := by
          simp only [RP2, if_pos hF]
        rw [e]
        exact (eR_mono hge).trans (eR_le_fA hb hF.1)
      · exact (eR_le_partB (by omega)).trans (hB hF)
    rw [cf_c2 hb hS hH hq (Cls_anti p τ G W D Q S H ω hle h'')]
  · have hout' := hout
    simp only [creditedOut, Finset.mem_filter, Finset.mem_univ, true_and] at hout'
    have hY := typY2_of_output p ω τ G W hb hout'.2
    have hF : ¬ TypF p ω (qP2 τ G W ω u) (qI2 τ G W ω u) := fun hF => hY.1 hF.1
    rw [c2_eq_of_output hb (hS.trans h''.2.1.symm) hout (prefixEq_mono (hB hF) h''.1)]

end CGroup

end PousKnowledge

end


/-! ════ Freshness.LuckyCover ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `PinFamily` (`credit-resolved.md` §11.7): the token identity, the injection, the assembly

- **`tokens_eq`**: `ω`'s lucky units are exactly the tokens of its groups: `Σ_{u,w} tokG(u,w) + Σ_{u,i} tokC(u)`.
  Each lower column is one token of its `G(u, w)`, and each top whole label `n` tokens: in `G(u, ·)`, or in
  `C(u, ·)` when a `c²`-rule on a type F/Y top credited it. Each key, and each hit, is `n` tokens.
- **The injection** `φ`. A pinned atom `a` of `G(u, w)` goes to `(ka a, gcomp a)`, and `C(u, i)` goes to
  `(RP2 u, i)`. It is injective on the pinned atoms, because realizations of distinct present sources differ
  (`Rsrc_injOn`). The one clash of kinds, `P2[u]` in both `G(u, ·)` and `C(u, ·)`, is excluded: `G` samples it
  only for type I, `C` only for type F/Y.
- **`J ℓ`**: the components of `φ`'s image at `ℓ`.
  - *fixed*: `pin_of_cf`, `c_pin`;
  - *fresh*: `pool_Rsrc`;
  - *few*: the image lies in the `≤ 6n` present sources' realizations;
  - *cover*: `luckyUnits = #tokens ≤ #pinned atoms = Σ |J ℓ|` (`group_pins`, the injection).
- **`pinFamily : PinFamily`**, hence `CreditResolvedTyped` (`creditResolvedTyped_of_pinFamily`), `ZeroAdviceLucky`
  (`zeroAdviceLucky_of_creditResolvedTyped`) and `N10′` at the lucky instances.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

section Cover

variable {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)} {τ : Bits 256} {G : Labelling.TopoDAG n}
  {W : Fin n → Lab n wc} {D Q : ℕ} {S H : Finset (ℕ × ℕ)} {ω : (p3ModelT n wc).Ω}

/-! ### The token identity -/

theorem cred3_lowerWhole : (cred3 p ω τ G W D).hold.lowerWhole = ∅ := by
  ext w
  simp only [Finset.notMem_empty, iff_false]
  intro hw
  have := mem_credUpTo3 p ω τ G W (fun k => w ∈ k.hold.lowerWhole) (by simp [KState.empty])
    (fun a b => by simp [KState.union]) D
  have hw' : w ∈ (credUpTo3 p ω τ G W D).hold.lowerWhole := by simpa [cred3, KState.union] using hw
  obtain ⟨r, -, hr⟩ := this.1 hw'
  simp [roundCred] at hr

theorem sum_ind_card {α : Type} [Fintype α] (s : Finset α) (P : α → Prop) [DecidablePred P]
    (h : ∀ x, P x ↔ x ∈ s) : ∑ x, (if P x then 1 else 0) = s.card := by
  rw [Finset.sum_boole]
  simp only [Nat.cast_id]
  congr 1
  ext x
  simp [h]

open Classical in
/-- **Tokens = lucky units.** -/
theorem tokens_eq : PousAssembly.luckyUnits p ω τ G W D =
    ∑ u, ∑ w, tokG p τ G W D ω u w +
      ∑ u, ∑ _i : Fin n, (if tokC (p := p) (ω := ω) (τ := τ) (G := G) (W := W) (D := D) u then 1 else 0) := by
  have hc : ∀ f : Fin n → ℕ, ∑ u, ∑ _w : Fin n, f u = n * ∑ u, f u := fun f => by
    simp [Finset.mul_sum]
  have hc' : ∀ f : Fin n → ℕ, ∑ _u : Fin n, ∑ w, f w = n * ∑ w, f w := fun f => by
    simp
  have hA : ∑ u, ∑ w, (if tCol p τ G W D ω u w then 1 else 0) = (cred3 p ω τ G W D).hold.lowerCol.card := by
    rw [Finset.sum_comm, ← Fintype.sum_prod_type']
    exact sum_ind_card _ _ fun x => Iff.rfl
  have hB : ∀ u, (if tTop p τ G W D ω u then 1 else 0) +
      (if tokC (p := p) (ω := ω) (τ := τ) (G := G) (W := W) (D := D) u then 1 else 0) =
        if u ∈ (cred3 p ω τ G W D).hold.topWhole then 1 else 0 := fun u => by
    by_cases h1 : u ∈ (cred3 p ω τ G W D).hold.topWhole <;>
      by_cases h2 : ¬ fI2 p τ G W ω u ∧ c2rule p τ G W D ω u <;> simp_all [tTop, tokC]
  have hTW : ∑ u, (if u ∈ (cred3 p ω τ G W D).hold.topWhole then 1 else 0) =
      (cred3 p ω τ G W D).hold.topWhole.card := sum_ind_card _ _ fun _ => Iff.rfl
  have hTK : ∑ u, (if tKey p τ G W D ω u then 1 else 0) = (cred3 p ω τ G W D).topKey.card :=
    sum_ind_card _ _ fun _ => Iff.rfl
  have hLK : ∑ w, (if tLkey p τ G W D ω w then 1 else 0) = (cred3 p ω τ G W D).lowerKey.card :=
    sum_ind_card _ _ fun _ => Iff.rfl
  have hHits : (hitsBy p ω τ G W D).card = ∑ w, (if fh0 p τ G W D ω w then 1 else 0) +
      ∑ u, (if fh1 p τ G W D ω u then 1 else 0) := by
    rw [← sum_ind_card (hitsBy p ω τ G W D) (fun t => t ∈ hitsBy p ω τ G W D) fun _ => Iff.rfl,
      Fintype.sum_prod_type, Fin.sum_univ_two]
    congr 1 <;> refine Finset.sum_congr rfl fun _ _ => ?_ <;> congr
  have e1 : ∑ u, ∑ w, tokG p τ G W D ω u w =
      ∑ u, ∑ w, (if tCol p τ G W D ω u w then 1 else 0) + n * ∑ u, (if tTop p τ G W D ω u then 1 else 0) +
        n * ∑ u, (if tKey p τ G W D ω u then 1 else 0) + n * ∑ w, (if tLkey p τ G W D ω w then 1 else 0) +
        n * ∑ w, (if fh0 p τ G W D ω w then 1 else 0) + n * ∑ u, (if fh1 p τ G W D ω u then 1 else 0) := by
    simp only [tokG, Finset.sum_add_distrib]
    rw [hc, hc, hc', hc', hc]
  have e2 : ∑ u, (if tTop p τ G W D ω u then 1 else 0) +
      ∑ u, (if tokC (p := p) (ω := ω) (τ := τ) (G := G) (W := W) (D := D) u then 1 else 0) =
        (cred3 p ω τ G W D).hold.topWhole.card := by
    rw [← Finset.sum_add_distrib, ← hTW]
    exact Finset.sum_congr rfl fun u _ => hB u
  rw [e1, hc]
  unfold PousAssembly.luckyUnits KState.size ColState.size
  rw [cred3_lowerWhole, hTK, hLK, hHits, hA, ← e2]
  simp only [Finset.card_empty, mul_zero, zero_add]
  ring

/-! ### The pinned atoms and the injection -/

variable (p τ G W D Q S H ω)

open Classical in
/-- The pinned atoms of `G(u, w)`. -/
noncomputable def PG (u w : Fin n) : Finset GA :=
  (sampled p τ G W D ω u w).filter fun a =>
    PousRank.CF (Cls p τ G W D Q S H ω) ω (ka p τ G W D Q ω u w a) (valG p τ G W D ω u w a)

/-- The pinned atoms of all pair groups. -/
noncomputable def DG : Finset (Σ _ : Fin n × Fin n, GA) :=
  (Finset.univ : Finset (Fin n × Fin n)).sigma fun x => PG p τ G W D Q S H ω x.1 x.2

open Classical in
/-- The pinned atoms of all `C(u, i)`. -/
noncomputable def DC : Finset (Fin n × Fin n) :=
  Finset.univ.filter fun x => tokC (p := p) (ω := ω) (τ := τ) (G := G) (W := W) (D := D) x.1

/-- **The injection**: a pinned atom to its (variable, component). -/
noncomputable def φ : (Σ _ : Fin n × Fin n, GA) ⊕ (Fin n × Fin n) → ℕ × Fin n
  | Sum.inl x => (ka p τ G W D Q ω x.1.1 x.1.2 x.2, gcomp x.1.1 x.1.2 x.2)
  | Sum.inr x => (RP2 p τ G W D Q ω x.1, x.2)

/-- The pinned (variable, component) pairs. -/
noncomputable def Pset : Finset (ℕ × Fin n) :=
  ((DG p τ G W D Q S H ω).disjSum (DC p τ G W D ω)).image (φ p τ G W D Q ω)

open Classical in
/-- **`J ℓ`**: the pinned components of variable `ℓ`. -/
noncomputable def Jf (ℓ : ℕ) : Finset (Fin n) :=
  Finset.univ.filter fun j => (ℓ, j) ∈ Pset p τ G W D Q S H ω

variable {p τ G W D Q S H ω}

theorem mem_PG {u w : Fin n} {a : GA} :
    a ∈ PG p τ G W D Q S H ω u w ↔ a ∈ sampled p τ G W D ω u w ∧
      PousRank.CF (Cls p τ G W D Q S H ω) ω (ka p τ G W D Q ω u w a) (valG p τ G W D ω u w a) := by
  classical
  simp only [PG, Finset.mem_filter]

theorem gsrc_inj {u w u' w' : Fin n} {a a' : GA} (ha : a ∈ sampled p τ G W D ω u w)
    (ha' : a' ∈ sampled p τ G W D ω u' w') (hs : gsrc u w a = gsrc u' w' a')
    (hc : gcomp u w a = gcomp u' w' a') : u = u' ∧ w = w' ∧ a = a' := by
  have nY := vY_not_sampled p τ G W D ω u w
  have nY2 := vY2_not_sampled p τ G W D ω u w
  have nY' := vY_not_sampled p τ G W D ω u' w'
  have nY2' := vY2_not_sampled p τ G W D ω u' w'
  cases a <;> cases a' <;> simp_all [gsrc, gcomp]

/-- The realization of the source of a pinned pair. -/
theorem Pset_src (hb : ∀ c, (p c).Bounded D Q) {x : ℕ × Fin n} (hx : x ∈ Pset p τ G W D Q S H ω) :
    ∃ σ, SrcPresent p τ G W D ω σ ∧ Rsrc p τ G W D Q ω σ = x.1 := by
  classical
  obtain ⟨d, hd, rfl⟩ := Finset.mem_image.1 hx
  rcases d with ⟨⟨u, w⟩, a⟩ | ⟨u, i⟩
  · have ha := (mem_PG.1 (Finset.mem_sigma.1 (Finset.inl_mem_disjSum.1 hd)).2).1
    exact ⟨gsrc u w a, gsrc_present p τ G W D ω u w ha, (ka_eq_Rsrc p τ G W D Q ω u w ha).symm⟩
  · exact ⟨.P2 u, trivial, rfl⟩

theorem φ_injOn (hb : ∀ c, (p c).Bounded D Q) :
    Set.InjOn (φ p τ G W D Q ω) ((DG p τ G W D Q S H ω).disjSum (DC p τ G W D ω) : Set _) := by
  classical
  intro d hd d' hd' he
  rcases d with ⟨⟨u, w⟩, a⟩ | ⟨u, i⟩ <;> rcases d' with ⟨⟨u', w'⟩, a'⟩ | ⟨u', i'⟩
  · have ha := (mem_PG.1 (Finset.mem_sigma.1 (Finset.inl_mem_disjSum.1 hd)).2).1
    have ha' := (mem_PG.1 (Finset.mem_sigma.1 (Finset.inl_mem_disjSum.1 hd')).2).1
    simp only [φ, Prod.mk.injEq] at he
    rw [ka_eq_Rsrc p τ G W D Q ω u w ha, ka_eq_Rsrc p τ G W D Q ω u' w' ha'] at he
    have hs := Rsrc_injOn hb (gsrc_present p τ G W D ω u w ha) (gsrc_present p τ G W D ω u' w' ha') he.1
    obtain ⟨rfl, rfl, rfl⟩ := gsrc_inj ha ha' hs he.2
    rfl
  · have ha := (mem_PG.1 (Finset.mem_sigma.1 (Finset.inl_mem_disjSum.1 hd)).2).1
    have ht : tokC (p := p) (ω := ω) (τ := τ) (G := G) (W := W) (D := D) u' := by
      have := Finset.inr_mem_disjSum.1 hd'
      simp only [DC, Finset.mem_filter, Finset.mem_univ, true_and] at this
      exact this
    simp only [φ, Prod.mk.injEq] at he
    rw [ka_eq_Rsrc p τ G W D Q ω u w ha] at he
    have hs := Rsrc_injOn (σ' := .P2 u') hb (gsrc_present p τ G W D ω u w ha) trivial he.1
    cases a <;> simp [gsrc] at hs
    · subst hs
      exact absurd ha (p2_not_sampled p τ G W D ω u w ht.2.1)
    · exact absurd ha (vY2_not_sampled p τ G W D ω u w)
  · have ha' := (mem_PG.1 (Finset.mem_sigma.1 (Finset.inl_mem_disjSum.1 hd')).2).1
    have ht : tokC (p := p) (ω := ω) (τ := τ) (G := G) (W := W) (D := D) u := by
      have := Finset.inr_mem_disjSum.1 hd
      simp only [DC, Finset.mem_filter, Finset.mem_univ, true_and] at this
      exact this
    simp only [φ, Prod.mk.injEq] at he
    rw [ka_eq_Rsrc p τ G W D Q ω u' w' ha'] at he
    have hs := Rsrc_injOn (σ := .P2 u) hb trivial (gsrc_present p τ G W D ω u' w' ha') he.1
    cases a' <;> simp [gsrc] at hs
    · subst hs
      exact absurd ha' (p2_not_sampled p τ G W D ω u w' ht.2.1)
    · exact absurd ha' (vY2_not_sampled p τ G W D ω u' w')
  · simp only [φ, Prod.mk.injEq] at he
    have hs := Rsrc_injOn (σ := .P2 u) (σ' := .P2 u') hb trivial trivial he.1
    cases hs
    rw [he.2]

/-! ### `PinsAt` -/

theorem Pset_lt (hb : ∀ c, (p c).Bounded D Q) {x : ℕ × Fin n} (hx : x ∈ Pset p τ G W D Q S H ω) :
    x.1 < 2 * D * (n * Q) + 4 * n := by
  obtain ⟨σ, hσ, he⟩ := Pset_src hb hx
  rw [← he]; exact Rsrc_lt_m hb hσ

/-- **fixed** -/
theorem Jf_fixed (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S) (hH : hitSlotSet p ω τ G W D = H)
    {ℓ : ℕ} {ω'' : (p3ModelT n wc).Ω} (h'' : ω'' ∈ Cls p τ G W D Q S H ω ℓ) {j : Fin n}
    (hj : j ∈ Jf p τ G W D Q S H ω ℓ) :
    chainX (splitFam p) τ G W (2 * D) Q ℓ ω'' j = chainX (splitFam p) τ G W (2 * D) Q ℓ ω j := by
  classical
  have hx : (ℓ, j) ∈ Pset p τ G W D Q S H ω := by simpa [Jf] using hj
  obtain ⟨d, hd, he⟩ := Finset.mem_image.1 hx
  rcases d with ⟨⟨u, w⟩, a⟩ | ⟨u, i⟩
  · obtain ⟨ha, hcf⟩ := mem_PG.1 (Finset.mem_sigma.1 (Finset.inl_mem_disjSum.1 hd)).2
    simp only [φ, Prod.mk.injEq] at he
    obtain ⟨rfl, rfl⟩ := he
    exact pin_of_cf hb hS hH ha hcf h''
  · have ht : tokC (p := p) (ω := ω) (τ := τ) (G := G) (W := W) (D := D) u := by
      have := Finset.inr_mem_disjSum.1 hd
      simp only [DC, Finset.mem_filter, Finset.mem_univ, true_and] at this
      exact this
    simp only [φ, Prod.mk.injEq] at he
    obtain ⟨rfl, rfl⟩ := he
    exact c_pin hb hS hH ht h'' i

/-- **fresh** -/
theorem Jf_fresh (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} (hne : (Jf p τ G W D Q S H ω ℓ).Nonempty) :
    2 ^ (n * wc) - n * Q ≤ Pool (splitFam p) τ G W (2 * D) Q ℓ ω := by
  classical
  obtain ⟨j, hj⟩ := hne
  have hx : (ℓ, j) ∈ Pset p τ G W D Q S H ω := by simpa [Jf] using hj
  obtain ⟨σ, hσ, he⟩ := Pset_src hb hx
  rw [← show Rsrc p τ G W D Q ω σ = ℓ from he]
  exact pool_Rsrc hb hσ

/-- The present sources. -/
noncomputable def srcAll (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (τ : Bits 256) (G : Labelling.TopoDAG n)
    (W : Fin n → Lab n wc) (D : ℕ) (ω : (p3ModelT n wc).Ω) : Finset (Src n) :=
  Finset.univ.image Src.K1 ∪ Finset.univ.image Src.P1 ∪ Finset.univ.image Src.K2 ∪ Finset.univ.image Src.P2 ∪
    (hitsBy p ω τ G W D).image Src.Bh

theorem card_srcAll : (srcAll p τ G W D ω).card ≤ 6 * n := by
  have h1 : ∀ f : Fin n → Src n, (Finset.univ.image f).card ≤ n := fun f =>
    (Finset.card_image_le).trans (by simp)
  have h2 : ((hitsBy p ω τ G W D).image Src.Bh).card ≤ 2 * n :=
    Finset.card_image_le.trans ((Finset.card_le_univ _).trans (by simp))
  unfold srcAll
  have := Finset.card_union_le (Finset.univ.image Src.K1 ∪ Finset.univ.image Src.P1 ∪ Finset.univ.image Src.K2 ∪
    Finset.univ.image Src.P2) ((hitsBy p ω τ G W D).image Src.Bh)
  have := Finset.card_union_le (Finset.univ.image Src.K1 ∪ Finset.univ.image Src.P1 ∪ Finset.univ.image Src.K2)
    (Finset.univ.image (Src.P2 (n := n)))
  have := Finset.card_union_le (Finset.univ.image Src.K1 ∪ Finset.univ.image Src.P1)
    (Finset.univ.image (Src.K2 (n := n)))
  have := Finset.card_union_le (Finset.univ.image (Src.K1 (n := n))) (Finset.univ.image (Src.P1 (n := n)))
  have := h1 Src.K1; have := h1 Src.P1; have := h1 Src.K2; have := h1 Src.P2
  omega

theorem mem_srcAll {σ : Src n} (hσ : SrcPresent p τ G W D ω σ) : σ ∈ srcAll p τ G W D ω := by
  classical
  cases σ <;> simp_all [srcAll, SrcPresent]

/-- **few** -/
theorem Jf_few (hb : ∀ c, (p c).Bounded D Q) (m : ℕ) :
    ((Finset.range m).filter fun ℓ => (Jf p τ G W D Q S H ω ℓ).Nonempty).card ≤ 32 * n := by
  classical
  have hsub : ((Finset.range m).filter fun ℓ => (Jf p τ G W D Q S H ω ℓ).Nonempty) ⊆
      (srcAll p τ G W D ω).image (Rsrc p τ G W D Q ω) := by
    intro ℓ hℓ
    obtain ⟨j, hj⟩ := (Finset.mem_filter.1 hℓ).2
    have hx : (ℓ, j) ∈ Pset p τ G W D Q S H ω := by simpa [Jf] using hj
    obtain ⟨σ, hσ, he⟩ := Pset_src hb hx
    exact Finset.mem_image.2 ⟨σ, mem_srcAll hσ, he⟩
  have := (Finset.card_le_card hsub).trans (Finset.card_image_le.trans card_srcAll)
  omega

/-- **cover** -/
theorem Jf_cover (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S)
    (hH : hitSlotSet p ω τ G W D = H) :
    PousAssembly.luckyUnits p ω τ G W D ≤
      ∑ ℓ ∈ Finset.range (2 * D * (n * Q) + 4 * n), (Jf p τ G W D Q S H ω ℓ).card := by
  classical
  have hG : ∑ u, ∑ w, tokG p τ G W D ω u w ≤ (DG p τ G W D Q S H ω).card := by
    rw [DG, Finset.card_sigma, Fintype.sum_prod_type]
    refine Finset.sum_le_sum fun u _ => Finset.sum_le_sum fun w _ => ?_
    exact group_pins hb hS hH
  have hC : ∑ u, ∑ _i : Fin n, (if tokC (p := p) (ω := ω) (τ := τ) (G := G) (W := W) (D := D) u then 1 else 0) =
      (DC p τ G W D ω).card := by
    rw [DC, Finset.card_filter, Fintype.sum_prod_type]
  have hP : (Pset p τ G W D Q S H ω).card = (DG p τ G W D Q S H ω).card + (DC p τ G W D ω).card := by
    rw [Pset, Finset.card_image_of_injOn (φ_injOn hb), Finset.card_disjSum]
  have hJ : (Pset p τ G W D Q S H ω).card =
      ∑ ℓ ∈ Finset.range (2 * D * (n * Q) + 4 * n), (Jf p τ G W D Q S H ω ℓ).card := by
    rw [Finset.card_eq_sum_card_fiberwise (f := Prod.fst) fun x hx => Finset.mem_range.2 (Pset_lt hb hx)]
    refine Finset.sum_congr rfl fun ℓ _ => ?_
    have : (Pset p τ G W D Q S H ω).filter (fun x => x.1 = ℓ) =
        (Jf p τ G W D Q S H ω ℓ).image fun j => (ℓ, j) := by
      ext ⟨a, b⟩
      simp only [Finset.mem_filter, Finset.mem_image, Jf, Finset.mem_univ, true_and, Prod.mk.injEq]
      constructor
      · rintro ⟨h, rfl⟩; exact ⟨b, h, rfl, rfl⟩
      · rintro ⟨j, h, rfl, rfl⟩; exact ⟨h, rfl⟩
    rw [this, Finset.card_image_of_injective _ fun a b h => (Prod.mk.inj h).2]
  rw [tokens_eq, ← hJ, hP, ← hC]
  omega

/-- **`PinsAt`** for every member of every typed class. -/
theorem pinsAt (hb : ∀ c, (p c).Bounded D Q) (hS : luckySet p ω τ G W D Q = S)
    (hH : hitSlotSet p ω τ G W D = H) : PousAssembly.PinsAt D Q τ G W p S H ω := by
  refine ⟨Jf p τ G W D Q S H ω, ?_, ?_, Jf_few hb _, Jf_cover hb hS hH⟩
  · intro ℓ _ ω'' hω'' hS'' hH'' j hj
    exact Jf_fixed hb hS hH ⟨PousLuckyChain.mem_cls.1 hω'', hS'', hH''⟩ hj
  · intro ℓ _ hne
    have hle : n * Q ≤ n * (Q + 1) + 2 * n := by
      have := Nat.mul_le_mul_left n (Nat.le_add_right Q 1); omega
    exact (Nat.sub_le_sub_left hle _).trans (Jf_fresh hb hne)

end Cover

/-- **`PinFamily`** holds. -/
theorem pinFamily : PousAssembly.PinFamily := by
  intro n wc D Q tag G W p _ _ hb S H ω hS hH
  exact pinsAt hb hS hH

end PousKnowledge

namespace PousAssembly

/-- **`CreditResolvedTyped`**, unconditionally. -/
theorem creditResolvedTyped : CreditResolvedTyped := creditResolvedTyped_of_pinFamily PousKnowledge.pinFamily

/-- **`ZeroAdviceLucky`**, unconditionally. -/
theorem zeroAdviceLucky : ZeroAdviceLucky := zeroAdviceLucky_of_creditResolvedTyped creditResolvedTyped

/-- **`N10′`** at the lucky instances, unconditionally. -/
theorem n10prime_lucky : N10primeAtIf okLucky posLucky := n10prime_of_pinFamily PousKnowledge.pinFamily

end PousAssembly

end


/-! ════ Freshness.JointClassWeightFalse ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `JointClassWeight` is false (`internal/p3-decode/joint-class-weight-counterexample.md`)

`JointClassWeight` (`p3-meets/P3MeetsFinal.lean`) is restated here verbatim, with `okLuckyMulti`, `jointSlot`,
`jointLuckySet` and `jointLuckyBits` (`P3MeetsLucky.lean`, `P3MeetsFinal.lean`). This package cannot import p3-meets,
which imports it. `not_jointClassWeight` refutes it.

**The instance.**
- Parameters: `N = 2`, `n = 1`, `wc = 24`, `D = 3`, `Q = 2^15`. The tags differ, and `G` has no edges.
- Segment `s`'s one program, with `s'` the other segment:
  1. asks `H` at `s'`'s source key;
  2. asks `P⁻¹` at `s'`'s honest input `x_{s'}`, getting `z0_{s'} = P_{s'}⁻¹(x_{s'})`;
  3. asks `P` forward at its own tweak and the point `z0_{s'}`.

**The event.** On the good event `z0_0 = z0_1` (with `z0_s ≠ x_s`), segment `s`'s round-3 query is its hit query
`qHit_s`.
- `hitAt` only checks that segment `s`'s own programs never asked `P_s⁻¹(x_s)`, and they didn't: segment `s'`'s
  program did.
- No honest query is asked, and top `0` is in the game by round `3` (`top_in_game`), so nothing else is credited.
- So `luckySet = {(0, 2)}` per segment, `jointLuckySet = {(0, 2), (1, 2)}`, and `jointLuckyBits ≥ 2·wc = 48`.

**The count** (`shift_count`). Post-composing `P_t` with a XOR shift is a bijection of `Ω` that leaves the functions
not reading `P_t` unchanged. So an event `P_t(x) = b`, with `x` and `b` not reading `P_t`, takes exactly a `1/M` share
of any shift-invariant set. The good event therefore has `M²·|E| ≥ (M − 2)·|Ω|`, and the class weight is
`≥ 2^{48}·|E| ≥ (2^{24} − 2)·|Ω| > 2^{|S|+1}·|Ω| = 8·|Ω|`.
-/

namespace PousJointRefute

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds PousKnowledge
  PousAssembly

/-! ### The statement, verbatim -/

/-- `okLuckyMulti` (`P3MeetsLucky.lean`). -/
def okLuckyMulti (N n wc Q : ℕ) : Prop :=
  0 < n ∧ 2 ^ 15 ≤ Q ∧ 64 * (N * n) * (N * (n * (Q + 1) + 2 * n)) ≤ 2 ^ (n * wc)

/-- Segment `s`'s slot `(c, r)`, placed as the joint slot `(s·n + c, r)`. -/
def jointSlot (n s : ℕ) (x : ℕ × ℕ) : ℕ × ℕ := (s * n + x.1, x.2)

open Classical in
/-- The joint lucky set: every segment's lucky slots, placed by `jointSlot`. -/
noncomputable def jointLuckySet {N n wc : ℕ} (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc))
    (ω : (p3ModelT n wc).Ω) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (D Q : ℕ) : Finset (ℕ × ℕ) :=
  Finset.univ.biUnion fun s : Fin N => (luckySet (p s) ω (tags s) G (W s) D Q).image (jointSlot n s)

/-- The joint lucky bits: the sum of the segments' lucky bits. -/
noncomputable def jointLuckyBits {N n wc : ℕ} (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc))
    (ω : (p3ModelT n wc).Ω) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (D : ℕ) : ℕ :=
  ∑ s : Fin N, luckyBits (p s) ω (tags s) G (W s) D

open Classical in
/-- `JointClassWeight` (`P3MeetsFinal.lean`), verbatim. -/
def JointClassWeight : Prop :=
  ∀ (N n wc D Q : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    okLuckyMulti N n wc Q → 1 ≤ N → Function.Injective tags → (∀ s c, (p s c).Bounded D Q) →
    ∀ S : Finset (ℕ × ℕ),
      ∑ ω ∈ Finset.univ.filter (fun ω => jointLuckySet p ω tags G W D Q = S), 2 ^ jointLuckyBits p ω tags G W D ≤
        2 ^ (S.card + 1) * Fintype.card (p3ModelT n wc).Ω

/-- **`JointClassWeight` is refuted.** -/
def JointClassWeightRefuted : Prop := ¬ JointClassWeight

/-! ### Counting: a XOR shift of one permutation -/

section Count

variable {n wc : ℕ}

/-- XOR by `d`, as a permutation of labels. -/
def xorPerm (d : Lab n wc) : Equiv.Perm (Lab n wc) where
  toFun y := labXor y d
  invFun y := labXor y d
  left_inv y := by funext v j; simp [labXor, Labelling.bxor]
  right_inv y := by funext v j; simp [labXor, Labelling.bxor]

open Classical in
/-- Post-compose `P_t` with XOR by `d`. -/
noncomputable def shiftΩ (t : Tweak n) (d : Lab n wc) (ω : (p3ModelT n wc).Ω) : (p3ModelT n wc).Ω :=
  (ω.1, Function.update ω.2 t (xorPerm d * ω.2 t))

theorem shiftΩ_ne {t t' : Tweak n} (h : t' ≠ t) (d : Lab n wc) (ω : (p3ModelT n wc).Ω) :
    (shiftΩ t d ω).2 t' = ω.2 t' := by
  classical
  simp only [shiftΩ]
  exact Function.update_of_ne h _ _

theorem shiftΩ_self (t : Tweak n) (d y : Lab n wc) (ω : (p3ModelT n wc).Ω) :
    (shiftΩ t d ω).2 t y = labXor (ω.2 t y) d := by
  classical
  simp only [shiftΩ, Function.update_self]
  rfl

theorem shiftΩ_shiftΩ (t : Tweak n) (d : Lab n wc) (ω : (p3ModelT n wc).Ω) : shiftΩ t d (shiftΩ t d ω) = ω := by
  classical
  refine Prod.ext rfl (funext fun t' => ?_)
  by_cases ht : t' = t
  · subst ht
    ext y
    rw [shiftΩ_self, shiftΩ_self]
    simp [labXor, Labelling.bxor]
  · rw [shiftΩ_ne ht, shiftΩ_ne ht]

theorem labXor_eq_iff {a b v : Lab n wc} : labXor a b = v ↔ labXor a v = b := by
  constructor <;> rintro rfl <;> funext i j <;> simp [labXor, Labelling.bxor]

/-- **The shift count.** For `x`, `b` and `C` invariant under the shifts of `P_t`, the event `P_t(x) = b` is exactly a
`1/M` share of `C`. -/
theorem shift_count (t : Tweak n) (x b : (p3ModelT n wc).Ω → Lab n wc) (C : Finset (p3ModelT n wc).Ω)
    (hx : ∀ d ω, x (shiftΩ t d ω) = x ω) (hb : ∀ d ω, b (shiftΩ t d ω) = b ω)
    (hC : ∀ d ω, ω ∈ C → shiftΩ t d ω ∈ C) :
    2 ^ (n * wc) * (C.filter fun ω => ω.2 t (x ω) = b ω).card = C.card := by
  classical
  have hfib : ∀ v : Lab n wc, (C.filter fun ω => labXor (ω.2 t (x ω)) (b ω) = v).card =
      (C.filter fun ω => ω.2 t (x ω) = b ω).card := by
    intro v
    refine Finset.card_bij' (fun ω _ => shiftΩ t v ω) (fun ω _ => shiftΩ t v ω) ?_ ?_ ?_ ?_
    · intro ω hω
      obtain ⟨hC', hv⟩ := Finset.mem_filter.1 hω
      refine Finset.mem_filter.2 ⟨hC v ω hC', ?_⟩
      rw [hx, hb, shiftΩ_self]
      exact labXor_eq_iff.1 hv
    · intro ω hω
      obtain ⟨hC', hv⟩ := Finset.mem_filter.1 hω
      refine Finset.mem_filter.2 ⟨hC v ω hC', ?_⟩
      rw [hx, hb, shiftΩ_self, hv]
      funext i j
      simp only [labXor, Labelling.bxor]
      generalize b ω i j = p
      generalize v i j = q
      cases p <;> cases q <;> rfl
    · intro ω _; exact shiftΩ_shiftΩ t v ω
    · intro ω _; exact shiftΩ_shiftΩ t v ω
  have hsum := Finset.card_eq_sum_card_fiberwise (s := C) (t := Finset.univ)
    (f := fun ω : (p3ModelT n wc).Ω => labXor (ω.2 t (x ω)) (b ω)) fun _ _ => Finset.mem_univ _
  rw [hsum, Finset.sum_congr rfl fun v _ => hfib v, Finset.sum_const, Finset.card_univ, PousKnowledge.card_lab, smul_eq_mul]

end Count

/-! ### The instance -/

section Instance

variable {wc : ℕ}

/-- The two tags. -/
def tagOf (s : Fin 2) : Bits 256 := fun _ => decide (s = 1)

theorem tagOf_injective : Function.Injective tagOf := by
  intro a b h
  have := congrFun h 0
  fin_cases a <;> fin_cases b <;> simp_all [tagOf]

/-- The other segment. -/
def other (s : Fin 2) : Fin 2 := if s = 0 then 1 else 0

theorem tagOf_other_ne (s : Fin 2) : tagOf (other s) ≠ tagOf s := fun h => by
  have := tagOf_injective h
  fin_cases s <;> simp [other] at this

/-- One node, no edges. -/
def G1 : Labelling.TopoDAG 1 := ⟨fun _ => ∅, fun _ _ h => absurd h (Finset.notMem_empty _)⟩

/-- The all-false label. -/
def zeroL : Lab 1 wc := fun _ _ => false

/-- `W = 0`. -/
def W1 : Fin 2 → Fin 1 → Lab 1 wc := fun _ _ => zeroL

/-- The source key of a segment. -/
def key (τ : Bits 256) : KQ' 1 wc := (τ, 0, 0, fun _ => none)

/-- Round 1: `H` at the other segment's source key. -/
def q1 (s : Fin 2) : (p3ModelT 1 wc).Qry := Sum.inl (key (tagOf (other s)))

/-- Round 2: `P⁻¹` at the other segment's honest input `W ⊕ κ¹ = 0 ⊕ a`. -/
def q2 (s : Fin 2) (a : Lab 1 wc) : (p3ModelT 1 wc).Qry :=
  Sum.inr (Sum.inr ((tagOf (other s), 0, 0), labXor zeroL a))

/-- Round 3: `P` forward at the own tweak and the point `b`. -/
def q3 (s : Fin 2) (b : Lab 1 wc) : (p3ModelT 1 wc).Qry := Sum.inr (Sum.inl ((tagOf s, 0, 0), b))

/-- Segment `s`'s program. -/
def prog (s : Fin 2) : Prog (p3ModelT 1 wc) (Lab 1 wc) :=
  .round [q1 s] fun a => .round [q2 s (a.headD zeroL)] fun b => .round [q3 s (b.headD zeroL)] fun _ => .ret zeroL

/-- The family. -/
def pJ : Fin 2 → Fin 1 → Prog (p3ModelT 1 wc) (Lab 1 wc) := fun s _ => prog s

/-- Segment `s`'s honest input `x_s = 0 ⊕ κ¹_s`. -/
def Hn (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : Lab 1 wc := labXor zeroL (ω.1 (key (tagOf s)))

/-- Segment `s`'s `z0_s = P_s⁻¹(x_s)`. -/
noncomputable def Z (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : Lab 1 wc := (ω.2 (tagOf s, 0, 0)).symm (Hn s ω)

theorem rounds_prog (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) :
    rounds ((p3ModelT 1 wc).answer ω) (prog s) =
      [[q1 s], [q2 s (ω.1 (key (tagOf (other s))))], [q3 s (Z (other s) ω)]] := rfl

theorem hk1_J (τ : Bits 256) (W : Fin 1 → Lab 1 wc) (ω : (p3ModelT 1 wc).Ω) (w : Fin 1) :
    hk1 τ G1 W ω w = key τ := by
  rw [Fin.fin_one_eq_zero w]
  simp [hk1, key, G1]

theorem hin_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : hin (tagOf s) G1 (W1 s) ω (0, 0) = Hn s ω := by
  simp only [hin, ↓reduceIte]
  unfold in1
  rw [hk1_J]
  rfl

theorem z0_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : z0 (tagOf s) G1 (W1 s) ω (0, 0) = Z s ω := by
  unfold z0
  rw [hin_J]
  rfl

theorem qHit_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) :
    qHit (tagOf s) G1 (W1 s) ω (0, 0) = Sum.inr (Sum.inl ((tagOf s, 0, 0), Z s ω)) := by
  unfold qHit
  rw [z0_J]
  rfl

theorem qInvIn_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) :
    qInvIn (tagOf s) G1 (W1 s) ω (0, 0) = Sum.inr (Sum.inr ((tagOf s, 0, 0), Hn s ω)) := by
  unfold qInvIn
  rw [hin_J]
  rfl

/-! ### What the programs ask -/

theorem trace_J (s : Fin 2) (c : Fin 1) (ω : (p3ModelT 1 wc).Ω) :
    progTrace ((p3ModelT 1 wc).answer ω) (pJ s c) =
      [q1 s, q2 s (ω.1 (key (tagOf (other s)))), q3 s (Z (other s) ω)] := by
  rw [progTrace_eq_flatten]
  change (rounds _ (prog s)).flatten = _
  rw [rounds_prog]
  rfl

theorem asked_J {s : Fin 2} {ω : (p3ModelT 1 wc).Ω} {q : (p3ModelT 1 wc).Qry} {r : ℕ} (h : Asked (pJ s) ω q r) :
    q = q1 s ∨ q = q2 s (ω.1 (key (tagOf (other s)))) ∨ q = q3 s (Z (other s) ω) := by
  obtain ⟨c, hc⟩ := h
  have hm := mem_progTrace_of_mem_upTo hc
  rw [trace_J] at hm
  simpa using hm

theorem asked_two_J {s : Fin 2} {ω : (p3ModelT 1 wc).Ω} {q : (p3ModelT 1 wc).Qry} (h : Asked (pJ s) ω q 2) :
    q = q1 s ∨ q = q2 s (ω.1 (key (tagOf (other s)))) := by
  obtain ⟨c, hc⟩ := h
  change q ∈ ((rounds _ (prog s)).take 2).flatten at hc
  rw [rounds_prog] at hc
  simpa using hc

/-! ### The good event -/

/-- **The good event**: the two `z0`s coincide, and neither is its segment's honest input. -/
def Good (ω : (p3ModelT 1 wc).Ω) : Prop := Z 0 ω = Z 1 ω ∧ Z 0 ω ≠ Hn 0 ω ∧ Z 1 ω ≠ Hn 1 ω

theorem good_s {ω : (p3ModelT 1 wc).Ω} (h : Good ω) (s : Fin 2) : Z (other s) ω = Z s ω ∧ Z s ω ≠ Hn s ω := by
  fin_cases s
  · exact ⟨h.1.symm, h.2.1⟩
  · exact ⟨h.1, h.2.2⟩

theorem tweak_tag {τ τ' : Bits 256} {i j : Fin 2} {v v' : Fin 1} (h : ((τ, i, v) : Tweak 1) = (τ', j, v')) :
    τ = τ' ∧ i = j := by
  injection h with h1 h2
  injection h2 with h2
  exact ⟨h1, h2⟩

theorem inl_inj' {k k' : KQ' 1 wc} (h : (Sum.inl k : (p3ModelT 1 wc).Qry) = Sum.inl k') : k = k' := by
  injection h

theorem inl_ne_inr' {k : KQ' 1 wc} {y : (Tweak 1 × Lab 1 wc) ⊕ (Tweak 1 × Lab 1 wc)} :
    (Sum.inl k : (p3ModelT 1 wc).Qry) ≠ Sum.inr y := fun h => by cases h

theorem fwd_ne_inv' {a b : Tweak 1 × Lab 1 wc} :
    (Sum.inr (Sum.inl a) : (p3ModelT 1 wc).Qry) ≠ Sum.inr (Sum.inr b) := fun h => by
  injection h with h; cases h

theorem fwd_inj' {t t' : Tweak 1} {x x' : Lab 1 wc}
    (h : (Sum.inr (Sum.inl (t, x)) : (p3ModelT 1 wc).Qry) = Sum.inr (Sum.inl (t', x'))) : t = t' ∧ x = x' := by
  injection h with h; injection h with h; injection h with h1 h2; exact ⟨h1, h2⟩

theorem inv_inj' {t t' : Tweak 1} {x x' : Lab 1 wc}
    (h : (Sum.inr (Sum.inr (t, x)) : (p3ModelT 1 wc).Qry) = Sum.inr (Sum.inr (t', x'))) : t = t' ∧ x = x' := by
  injection h with h; injection h with h; injection h with h1 h2; exact ⟨h1, h2⟩

/-- No honest query of segment `s` is asked on the good event. -/
theorem no_honest {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) (h : Fin 6 × Fin 1) :
    ¬ ∃ r, Asked (pJ s) ω (honestQ (tagOf s) G1 (W1 s) ω h) r := by
  rintro ⟨r, hr⟩
  obtain ⟨k, v⟩ := h
  have hne := tagOf_other_ne s
  obtain ⟨hZ, hZH⟩ := good_s hg s
  fin_cases k
  · change Asked (pJ s) ω (qH1 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · have := congrArg Prod.fst (inl_inj' e)
      rw [hk1_J] at this
      exact hne this.symm
    · exact inl_ne_inr' e
    · exact inl_ne_inr' e
  · change Asked (pJ s) ω (qH2 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact hne (congrArg Prod.fst (inl_inj' e)).symm
    · exact inl_ne_inr' e
    · exact inl_ne_inr' e
  · change Asked (pJ s) ω (qP1 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact inl_ne_inr' e.symm
    · exact fwd_ne_inv' e
    · have e2 := (fwd_inj' e).2
      unfold in1 at e2
      rw [hk1_J, hZ] at e2
      exact hZH e2.symm
  · change Asked (pJ s) ω (qP2 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact inl_ne_inr' e.symm
    · exact fwd_ne_inv' e
    · exact absurd (tweak_tag (fwd_inj' e).1).2 (by decide)
  · change Asked (pJ s) ω (qI1 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact inl_ne_inr' e.symm
    · exact hne (tweak_tag (inv_inj' e).1).1.symm
    · exact fwd_ne_inv' e.symm
  · change Asked (pJ s) ω (qI2 (tagOf s) G1 (W1 s) ω v) r at hr
    rcases asked_J hr with e | e | e
    · exact inl_ne_inr' e.symm
    · exact hne (tweak_tag (inv_inj' e).1).1.symm
    · exact fwd_ne_inv' e.symm

/-- Top `0` is in the game at round `3`, from any credits. -/
theorem top_in_game (C : KState 1) : (0 : Fin 1) ∈ (timedReachK G1 C 3).topWhole := by
  have h2 : (0 : Fin 1) ∈ (timedReachK G1 C 2).lowerWhole := by
    show (0 : Fin 1) ∈ (promote (stepTwoK G1 C (timedReachK G1 C 0) (timedReachK G1 C 1))).lowerWhole
    rw [mem_promote_lowerWhole]
    left
    simp [stepTwoK, G1]
  show (0 : Fin 1) ∈ (stepTwoK G1 C (timedReachK G1 C 1) (timedReachK G1 C 2)).topWhole
  simp only [stepTwoK]
  refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, fun w => ?_, Or.inl (by simp [G1])⟩)
  rw [Fin.fin_one_eq_zero w]
  exact Or.inl h2

theorem creditedOut_J (s : Fin 2) (ω : (p3ModelT 1 wc).Ω) : creditedOut (pJ s) ω (tagOf s) G1 (W1 s) 3 = ∅ := by
  classical
  ext u
  simp only [creditedOut, Finset.mem_filter, Finset.mem_univ, true_and, Finset.notMem_empty, iff_false, not_and,
    not_not]
  intro _
  rw [Fin.fin_one_eq_zero u]
  exact top_in_game _

theorem hitsBy_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) :
    hitsBy (pJ s) ω (tagOf s) G1 (W1 s) 3 = {((0 : Fin 2), (0 : Fin 1))} := by
  classical
  obtain ⟨hZ, hZH⟩ := good_s hg s
  have hne := tagOf_other_ne s
  ext ⟨i, v⟩
  rw [Fin.fin_one_eq_zero v]
  simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton, Prod.mk.injEq, and_true]
  fin_cases i
  · simp only [Fin.zero_eta, Fin.isValue, iff_true]
    refine ⟨3, le_rfl, ⟨⟨0, ?_⟩, fun h => ?_⟩, ?_, fun h => ?_⟩
    · rw [qHit_J, ← hZ]
      change _ ∈ ([[q1 s], [q2 s (ω.1 (key (tagOf (other s))))], [q3 s (Z (other s) ω)]].take 3).flatten
      exact List.mem_flatten.2 ⟨[q3 s (Z (other s) ω)], by simp, List.mem_singleton_self _⟩
    · rw [qHit_J] at h
      rcases asked_two_J h with e | e
      · exact inl_ne_inr' e.symm
      · exact fwd_ne_inv' e
    · rw [z0_J, hin_J]; exact hZH
    · rw [qInvIn_J] at h
      rcases asked_two_J h with e | e
      · exact inl_ne_inr' e.symm
      · exact hne (tweak_tag (inv_inj' e).1).1.symm
  · simp only [Fin.mk_one, Fin.isValue, one_ne_zero, iff_false, not_exists, not_and]
    intro r _ hf
    have ha := hf.1.1
    unfold qHit twk at ha
    rcases asked_J ha with e | e | e
    · exact inl_ne_inr' e.symm
    · exact fwd_ne_inv' e
    · exact absurd (tweak_tag (fwd_inj' e).1).2 (by decide)

theorem slot_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) :
    slotOf (pJ s) ω (qHit (tagOf s) G1 (W1 s) ω (0, 0)) = (0, 2) := by
  classical
  have hmem := hitsBy_J hg s
  have ht : ((0 : Fin 2), (0 : Fin 1)) ∈ hitsBy (pJ s) ω (tagOf s) G1 (W1 s) 3 := by rw [hmem]; simp
  have hask : ∃ r, Asked (pJ s) ω (qHit (tagOf s) G1 (W1 s) ω (0, 0)) r := by
    simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht
    obtain ⟨r, -, hr⟩ := ht
    exact ⟨r, hr.1.1⟩
  obtain ⟨c, hc, -⟩ := slotOf_spec (p := pJ s) hask
  rw [hc, Fin.fin_one_eq_zero c, trace_J, qHit_J, ← (good_s hg s).1]
  have h1 : q3 s (Z (other s) ω) ≠ q1 s := fun e => inl_ne_inr' e.symm
  have h2 : q3 s (Z (other s) ω) ≠ q2 s (ω.1 (key (tagOf (other s)))) := fwd_ne_inv'
  refine Prod.ext rfl ?_
  change List.idxOf (q3 s (Z (other s) ω)) [q1 s, q2 s (ω.1 (key (tagOf (other s)))), q3 s (Z (other s) ω)] = 2
  rw [List.idxOf_cons_ne _ h1.symm, List.idxOf_cons_ne _ h2.symm, List.idxOf_cons_self]

theorem luckySet_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) (Q : ℕ) :
    luckySet (pJ s) ω (tagOf s) G1 (W1 s) 3 Q = {(0, 2)} := by
  classical
  have hh : (Finset.univ.filter fun h : Fin 6 × Fin 1 =>
      ∃ r, Asked (pJ s) ω (honestQ (tagOf s) G1 (W1 s) ω h) r) = ∅ :=
    Finset.filter_false_of_mem fun h _ => no_honest hg s h
  unfold luckySet
  rw [hh, hitsBy_J hg s, creditedOut_J, Finset.image_singleton, slot_J hg s]
  simp

theorem luckyBits_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (s : Fin 2) :
    wc ≤ luckyBits (pJ s) ω (tagOf s) G1 (W1 s) 3 := by
  unfold luckyBits
  rw [hitsBy_J hg s, Finset.card_singleton]
  omega

theorem jointLuckySet_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) (Q : ℕ) :
    jointLuckySet pJ ω tagOf G1 W1 3 Q = {(0, 2), (1, 2)} := by
  classical
  unfold jointLuckySet
  simp only [luckySet_J hg, Finset.image_singleton]
  ext x
  simp [jointSlot, Fin.exists_fin_two]

theorem jointLuckyBits_J {ω : (p3ModelT 1 wc).Ω} (hg : Good ω) : 2 * wc ≤ jointLuckyBits pJ ω tagOf G1 W1 3 := by
  unfold jointLuckyBits
  rw [Fin.sum_univ_two]
  have := luckyBits_J hg 0
  have := luckyBits_J hg 1
  omega

theorem bounded_J (s : Fin 2) (c : Fin 1) : (pJ (wc := wc) s c).Bounded 3 (2 ^ 15) := fun ω =>
  ⟨le_of_eq (show Prog.depth ((p3ModelT 1 wc).answer ω) (prog s) = 3 from rfl),
    (show Prog.work ((p3ModelT 1 wc).answer ω) (prog s) = 3 from rfl).trans_le (by norm_num)⟩

/-! ### The count of the good event -/

theorem tweak0_ne : ((tagOf 1, 0, 0) : Tweak 1) ≠ (tagOf 0, 0, 0) := fun h =>
  absurd (tagOf_injective (tweak_tag h).1) (by decide)

theorem Hn_shift (t : Tweak 1) (s : Fin 2) (d : Lab 1 wc) (ω : (p3ModelT 1 wc).Ω) : Hn s (shiftΩ t d ω) = Hn s ω :=
  rfl

theorem Z1_shift0 (d : Lab 1 wc) (ω : (p3ModelT 1 wc).Ω) : Z 1 (shiftΩ (tagOf 0, 0, 0) d ω) = Z 1 ω := by
  unfold Z
  rw [Hn_shift, shiftΩ_ne tweak0_ne]

/-- `Z 1 = y` is a `1/M` share of `Ω`, for `y` not reading `P_{t_1}`. -/
theorem card_Z1_eq (y : (p3ModelT 1 wc).Ω → Lab 1 wc) (hy : ∀ d ω, y (shiftΩ (tagOf 1, 0, 0) d ω) = y ω) :
    2 ^ (1 * wc) * (Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => Z 1 ω = y ω).card =
      Fintype.card (p3ModelT 1 wc).Ω := by
  classical
  have := shift_count (tagOf 1, 0, 0) y (Hn 1) Finset.univ hy (fun d ω => Hn_shift _ 1 d ω)
    (fun _ _ _ => Finset.mem_univ _)
  rw [Finset.card_univ] at this
  have hc : (Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => Z 1 ω = y ω) =
      Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => ω.2 (tagOf 1, 0, 0) (y ω) = Hn 1 ω :=
    Finset.filter_congr fun ω _ => by
      unfold Z
      rw [Equiv.symm_apply_eq]
      exact eq_comm
  rw [hc]
  exact this

/-- **The good event is large**: `M²·|E| ≥ (M − 2)·|Ω|`. -/
theorem card_good :
    ∃ E : Finset (p3ModelT 1 wc).Ω, (∀ ω ∈ E, Good ω) ∧
      (2 ^ (1 * wc) - 2) * Fintype.card (p3ModelT 1 wc).Ω ≤ 2 ^ (1 * wc) * 2 ^ (1 * wc) * E.card := by
  classical
  set M := 2 ^ (1 * wc) with hM
  set Gs : Finset (p3ModelT 1 wc).Ω := Finset.univ.filter fun ω => Z 1 ω ≠ Hn 0 ω ∧ Z 1 ω ≠ Hn 1 ω with hGs
  refine ⟨Gs.filter fun ω => ω.2 (tagOf 0, 0, 0) (Z 1 ω) = Hn 0 ω, ?_, ?_⟩
  · intro ω hω
    obtain ⟨hG, hB⟩ := Finset.mem_filter.1 hω
    obtain ⟨h0, h1⟩ := (Finset.mem_filter.1 hG).2
    have hZ : Z 0 ω = Z 1 ω := by
      unfold Z
      rw [Equiv.symm_apply_eq]
      exact hB.symm
    exact ⟨hZ, hZ ▸ h0, h1⟩
  · have hcount := shift_count (tagOf 0, 0, 0) (Z 1) (Hn 0) Gs (fun d ω => Z1_shift0 d ω)
      (fun d ω => Hn_shift _ 0 d ω) (fun d ω hω => by
        simp only [hGs, Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
        rw [Z1_shift0, Hn_shift, Hn_shift]
        exact hω)
    have hb0 := card_Z1_eq (wc := wc) (Hn 0) (fun d ω => Hn_shift _ 0 d ω)
    have hb1 := card_Z1_eq (wc := wc) (Hn 1) (fun d ω => Hn_shift _ 1 d ω)
    have hcov : Fintype.card (p3ModelT 1 wc).Ω ≤ Gs.card +
        (Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => Z 1 ω = Hn 0 ω).card +
          (Finset.univ.filter fun ω : (p3ModelT 1 wc).Ω => Z 1 ω = Hn 1 ω).card := by
      rw [← Finset.card_univ]
      refine (Finset.card_le_card fun ω _ => ?_).trans
        ((Finset.card_union_le _ _).trans (Nat.add_le_add_right (Finset.card_union_le _ _) _))
      by_cases h0 : Z 1 ω = Hn 0 ω
      · exact Finset.mem_union_left _ (Finset.mem_union_right _ (by simp [h0]))
      · by_cases h1 : Z 1 ω = Hn 1 ω
        · exact Finset.mem_union_right _ (by simp [h1])
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ (by simp [hGs, h0, h1]))
    rw [mul_assoc, hcount]
    have := Nat.mul_le_mul_left M hcov
    rw [mul_add, mul_add, hb0, hb1] at this
    rw [Nat.sub_mul]
    omega

/-! ### The refutation -/

/-- **`JointClassWeight` is false**, at `N = 2`, `n = 1`, `wc = 24`, `D = 3`, `Q = 2^15`. -/
theorem not_jointClassWeight : ¬ JointClassWeight := by
  classical
  intro h
  have hok : okLuckyMulti 2 1 24 (2 ^ 15) := ⟨by norm_num, le_rfl, by norm_num⟩
  have hS := h 2 1 24 3 (2 ^ 15) tagOf G1 W1 pJ hok (by norm_num) tagOf_injective (fun s c => bounded_J s c)
    {(0, 2), (1, 2)}
  have hcard : ({(0, 2), (1, 2)} : Finset (ℕ × ℕ)).card = 2 := by decide
  rw [hcard] at hS
  obtain ⟨E, hE, hEc⟩ := card_good (wc := 24)
  have hsub : E ⊆ Finset.univ.filter fun ω => jointLuckySet pJ ω tagOf G1 W1 3 (2 ^ 15) = {(0, 2), (1, 2)} :=
    fun ω hω => Finset.mem_filter.2 ⟨Finset.mem_univ _, jointLuckySet_J (hE ω hω) _⟩
  have hlow : E.card * 2 ^ (2 * 24) ≤
      ∑ ω ∈ Finset.univ.filter (fun ω : (p3ModelT 1 24).Ω =>
          jointLuckySet pJ ω tagOf G1 W1 3 (2 ^ 15) = {(0, 2), (1, 2)}),
        2 ^ jointLuckyBits pJ ω tagOf G1 W1 3 := by
    calc E.card * 2 ^ (2 * 24) = ∑ _ω ∈ E, 2 ^ (2 * 24) := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ ∑ ω ∈ E, 2 ^ jointLuckyBits pJ ω tagOf G1 W1 3 :=
          Finset.sum_le_sum fun ω hω => Nat.pow_le_pow_right (by norm_num) (jointLuckyBits_J (hE ω hω))
      _ ≤ _ := Finset.sum_le_sum_of_subset hsub
  have hpos : 0 < Fintype.card (p3ModelT 1 24).Ω := Fintype.card_pos
  have hfin := hlow.trans hS
  norm_num at hEc hfin
  omega

theorem jointClassWeightRefuted : JointClassWeightRefuted := not_jointClassWeight

end Instance

end PousJointRefute

end


/-! ════ Freshness.JointAccountingDefs ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The joint accounting: proposed definitions (`internal/p3-decode/joint-accounting-proposal.md`)

Definitions only, for red-team review (§42) before the p3-meets glue adopts them. No theorem here is claimed.

`JointClassWeight` fails (`not_jointClassWeight`): a hit is credited against the segment's own programs' inverse
queries only. In the joint accounting, segment `s`'s credits, hits and slots are those of `psJ p s`:
- program `c` of `psJ p s` runs every segment's program `c` in lock-step (`parFam`), with segment `s`'s output;
- so "asked" means asked by **any** segment's program, and a hit counts only if **no** program asked `P_t⁻¹(x_t)`
  before.

The class is typed by the **union** of the segments' honest and hit slots, in the common slot space of the composed
programs. Output slots are placed per segment, at index `N·Q + 1 + s`.
-/

namespace PousJointAccounting

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds PousKnowledge
  PousAssembly

/-! ### Lock-step parallel composition -/

section Par

variable {M : IdealModel}

/-- Change a program's output. -/
def mapOut {α β : Type} (f : α → β) : Prog M α → Prog M β
  | .ret a => .ret (f a)
  | .round qs k => .round qs fun as => mapOut f (k as)

/-- **Lock-step parallel composition**: each round asks `p`'s queries, then `q`'s; each continues on its own answers.
A program that has stopped asks nothing. -/
def par2 {α β : Type} : Prog M α → Prog M β → Prog M (α × β)
  | .ret a, q => mapOut (fun b => (a, b)) q
  | .round qs k, .ret b => mapOut (fun a => (a, b)) (.round qs k)
  | .round qs k, .round qs' k' =>
      .round (qs ++ qs') fun as => par2 (k (as.take qs.length)) (k' (as.drop qs.length))

/-- A list of programs in lock-step, queries in list order. -/
def parList {α : Type} : List (Prog M α) → Prog M (List α)
  | [] => .ret []
  | p :: ps => mapOut (fun x => x.1 :: x.2) (par2 p (parList ps))

/-- **All of `ps` in lock-step, with `ps i`'s output.** -/
def parFam {α : Type} [Inhabited α] {N : ℕ} (ps : Fin N → Prog M α) (i : Fin N) : Prog M α :=
  mapOut (fun as => as.getD i default) (parList (List.ofFn ps))

end Par

/-! ### The joint accounting -/

section Joint

variable {N n wc : ℕ}

/-- **Segment `s`'s joint family**: its program `c` runs every segment's program `c` in lock-step (segment order),
with segment `s`'s output. Its queries do not depend on `s`. -/
noncomputable def psJ (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)) (s : Fin N) : Fin n → Prog (p3ModelT n wc) (Lab n wc) :=
  fun c => parFam (fun s' => p s' c) s

open Classical in
/-- The first-ask slots of the honest queries asked (`luckySet`'s first part). -/
noncomputable def honestSlots (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω) (τ : Bits 256)
    (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) : Finset (ℕ × ℕ) :=
  (Finset.univ.filter fun h : Fin 6 × Fin n => ∃ r, Asked ps ω (honestQ τ G W ω h) r).image
    fun h => slotOf ps ω (honestQ τ G W ω h)

theorem luckySet_eq_parts (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω) (τ : Bits 256)
    (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (D Q : ℕ) :
    luckySet ps ω τ G W D Q = honestSlots ps ω τ G W ∪ hitSlotSet ps ω τ G W D ∪
      (creditedOut ps ω τ G W D).image (fun c : Fin n => ((c : ℕ), Q)) := rfl

open Classical in
/-- **The joint lucky set** (union typing). It contains:
- every segment's honest and hit slots, in the composed programs' common slot space `Fin n × [0, N·Q)`;
- every segment's output slots, at `(c, N·Q + 1 + s)`. -/
noncomputable def jointLuckySetJ (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
    (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q : ℕ) :
    Finset (ℕ × ℕ) :=
  Finset.univ.biUnion fun s : Fin N =>
    honestSlots (psJ p s) ω (tags s) G (W s) ∪ hitSlotSet (psJ p s) ω (tags s) G (W s) D ∪
      (creditedOut (psJ p s) ω (tags s) G (W s) D).image fun c : Fin n => ((c : ℕ), N * Q + 1 + (s : ℕ))

open Classical in
/-- The joint hit slots (the typing refinement the proof uses). -/
noncomputable def jointHitSlotSetJ (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
    (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D : ℕ) : Finset (ℕ × ℕ) :=
  Finset.univ.biUnion fun s : Fin N => hitSlotSet (psJ p s) ω (tags s) G (W s) D

/-- **The joint lucky bits**: each segment's lucky bits, for its joint family. -/
noncomputable def jointLuckyBitsJ (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
    (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D : ℕ) : ℕ :=
  ∑ s : Fin N, luckyBits (psJ p s) ω (tags s) G (W s) D

end Joint

open Classical in
/-- **The proposed `JointClassWeight`**, on the joint accounting. -/
def JointClassWeightJ : Prop :=
  ∀ (N n wc D Q : ℕ) (tags : Fin N → Bits 256) (G : Labelling.TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc)),
    PousJointRefute.okLuckyMulti N n wc Q → 1 ≤ N → Function.Injective tags → (∀ s c, (p s c).Bounded D Q) →
    ∀ S : Finset (ℕ × ℕ),
      ∑ ω ∈ Finset.univ.filter (fun ω => jointLuckySetJ p ω tags G W D Q = S), 2 ^ jointLuckyBitsJ p ω tags G W D ≤
        2 ^ (S.card + 1) * Fintype.card (p3ModelT n wc).Ω

end PousJointAccounting

end


/-! ════ Freshness.JointCompose ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Lock-step composition: rounds, runs, bounds, asks (`joint-accounting-proposal.md` §4, step 1)

The load-bearing facts about `psJ p s` (red-team §43, condition 2):
- `rounds_psJ`: its rounds are the round-wise concatenation (`zipAll`) of every segment's program `c`. They do not
  depend on `s`, and agree with the output-free composed family `pQ p` (`rounds_psJ_pQ`).
- `run_psJ`: its output is `p s c`'s. The ideal oracle is stateless, so running in lock-step changes no program's view.
- `bounded_psJ`: it is `(D, N·Q)`-bounded.
- `asked_psJ`: `Asked (psJ p s) ω q r ↔ ∃ s', Asked (p s') ω q r`.
- `slotOf_congr`: first-ask slots, first rounds and traces depend only on the rounds, so they agree across `s`.
-/

namespace PousJointAccounting

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds PousKnowledge
  PousAssembly

/-! ### Round-wise concatenation -/

section Zip

variable {β : Type}

/-- Round-wise concatenation of two round lists; the longer one's tail is kept. -/
def zipR : List (List β) → List (List β) → List (List β)
  | [], l => l
  | a :: as, [] => a :: as
  | a :: as, b :: bs => (a ++ b) :: zipR as bs

@[simp] theorem zipR_nil_left (l : List (List β)) : zipR [] l = l := by cases l <;> rfl

@[simp] theorem zipR_nil_right (l : List (List β)) : zipR l [] = l := by cases l <;> rfl

@[simp] theorem zipR_cons_cons (a b : List β) (as bs : List (List β)) :
    zipR (a :: as) (b :: bs) = (a ++ b) :: zipR as bs := rfl

theorem length_zipR : ∀ a b : List (List β), (zipR a b).length = max a.length b.length
  | [], b => by simp
  | a :: as, [] => by simp
  | a :: as, b :: bs => by simp [length_zipR as bs, Nat.succ_max_succ]

theorem take_zipR : ∀ (t : ℕ) (a b : List (List β)), (zipR a b).take t = zipR (a.take t) (b.take t)
  | 0, a, b => by simp
  | t + 1, [], b => by simp
  | t + 1, a :: as, [] => by simp
  | t + 1, a :: as, b :: bs => by simp [take_zipR t as bs]

theorem mem_flatten_zipR {q : β} : ∀ a b : List (List β), q ∈ (zipR a b).flatten ↔ q ∈ a.flatten ∨ q ∈ b.flatten
  | [], b => by simp
  | a :: as, [] => by simp
  | a :: as, b :: bs => by
    simp only [zipR_cons_cons, List.flatten_cons, List.mem_append, mem_flatten_zipR as bs]
    tauto

theorem length_flatten_zipR : ∀ a b : List (List β),
    (zipR a b).flatten.length = a.flatten.length + b.flatten.length
  | [], b => by simp
  | a :: as, [] => by simp
  | a :: as, b :: bs => by
    simp only [zipR_cons_cons, List.flatten_cons, List.length_append, length_flatten_zipR as bs]
    ring

/-- The round-wise concatenation of several round lists. -/
def zipAll (L : List (List (List β))) : List (List β) := L.foldr zipR []

@[simp] theorem zipAll_nil : zipAll ([] : List (List (List β))) = [] := rfl

@[simp] theorem zipAll_cons (l : List (List β)) (L : List (List (List β))) : zipAll (l :: L) = zipR l (zipAll L) := rfl

theorem length_zipAll_le {D : ℕ} : ∀ L : List (List (List β)), (∀ l ∈ L, l.length ≤ D) → (zipAll L).length ≤ D
  | [], _ => by simp
  | l :: L, h => by
    rw [zipAll_cons, length_zipR]
    exact max_le (h l List.mem_cons_self) (length_zipAll_le L fun l' hl' => h l' (List.mem_cons_of_mem _ hl'))

theorem take_zipAll (t : ℕ) : ∀ L : List (List (List β)), (zipAll L).take t = zipAll (L.map fun l => l.take t)
  | [] => by simp
  | l :: L => by rw [zipAll_cons, take_zipR, take_zipAll t L]; rfl

theorem mem_flatten_zipAll {q : β} : ∀ L : List (List (List β)), q ∈ (zipAll L).flatten ↔ ∃ l ∈ L, q ∈ l.flatten
  | [] => by simp
  | l :: L => by
    rw [zipAll_cons, mem_flatten_zipR, mem_flatten_zipAll L]
    simp

theorem length_flatten_zipAll : ∀ L : List (List (List β)),
    (zipAll L).flatten.length = (L.map fun l => l.flatten.length).sum
  | [] => by simp
  | l :: L => by rw [zipAll_cons, length_flatten_zipR, length_flatten_zipAll L]; simp

end Zip

/-! ### Rounds and runs of the combinators -/

section Prog

variable {M : IdealModel}

theorem rounds_mapOut {α β : Type} (f : M.Qry → M.Ans) (g : α → β) (p : Prog M α) :
    rounds f (mapOut g p) = rounds f p := by
  induction p with
  | ret a => rfl
  | round qs k ih => simp only [mapOut, rounds, ih]

theorem run_mapOut {α β : Type} (f : M.Qry → M.Ans) (g : α → β) (p : Prog M α) :
    (mapOut g p).run f = g (p.run f) := by
  induction p with
  | ret a => rfl
  | round qs k ih => simp only [mapOut, Prog.run, ih]

theorem take_map_append {γ δ : Type} (f : γ → δ) (qs qs' : List γ) :
    ((qs ++ qs').map f).take qs.length = qs.map f := by
  rw [List.map_append]; exact List.take_left' (by simp)

theorem drop_map_append {γ δ : Type} (f : γ → δ) (qs qs' : List γ) :
    ((qs ++ qs').map f).drop qs.length = qs'.map f := by
  rw [List.map_append]; exact List.drop_left' (by simp)

theorem rounds_par2 {α β : Type} (f : M.Qry → M.Ans) (p : Prog M α) :
    ∀ q : Prog M β, rounds f (par2 p q) = zipR (rounds f p) (rounds f q) := by
  induction p with
  | ret a => intro q; simp only [par2, rounds_mapOut, rounds, zipR_nil_left]
  | round qs k ih =>
    intro q
    cases q with
    | ret b =>
      simp only [par2, rounds_mapOut, rounds, zipR_nil_right]
    | round qs' k' =>
      simp only [par2, rounds]
      rw [take_map_append, drop_map_append, ih]
      rfl

theorem run_par2 {α β : Type} (f : M.Qry → M.Ans) (p : Prog M α) :
    ∀ q : Prog M β, (par2 p q).run f = (p.run f, q.run f) := by
  induction p with
  | ret a => intro q; simp only [par2, run_mapOut, Prog.run]
  | round qs k ih =>
    intro q
    cases q with
    | ret b => simp only [par2, run_mapOut, Prog.run]
    | round qs' k' =>
      simp only [par2, Prog.run]
      rw [take_map_append, drop_map_append, ih]

theorem rounds_parList {α : Type} (f : M.Qry → M.Ans) :
    ∀ ps : List (Prog M α), rounds f (parList ps) = zipAll (ps.map (rounds f))
  | [] => rfl
  | p :: ps => by
    simp only [parList, rounds_mapOut, rounds_par2, rounds_parList f ps, List.map_cons, zipAll_cons]

theorem run_parList {α : Type} (f : M.Qry → M.Ans) : ∀ ps : List (Prog M α), (parList ps).run f = ps.map (·.run f)
  | [] => rfl
  | p :: ps => by simp only [parList, run_mapOut, run_par2, run_parList f ps, List.map_cons]

theorem rounds_parFam {α : Type} [Inhabited α] {N : ℕ} (f : M.Qry → M.Ans) (ps : Fin N → Prog M α) (i : Fin N) :
    rounds f (parFam ps i) = zipAll (List.ofFn fun s => rounds f (ps s)) := by
  rw [parFam, rounds_mapOut, rounds_parList, List.map_ofFn]
  rfl

theorem run_parFam {α : Type} [Inhabited α] {N : ℕ} (f : M.Qry → M.Ans) (ps : Fin N → Prog M α) (i : Fin N) :
    (parFam ps i).run f = (ps i).run f := by
  rw [parFam, run_mapOut, run_parList, List.map_ofFn]
  simp [List.getD_eq_getElem?_getD]

end Prog

/-! ### The joint family -/

section Joint

variable {N n wc : ℕ} (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc))

/-- **The composed query family** (output-free): every segment's program `c` in lock-step. Part A of the joint chain
is its split chain. -/
noncomputable def pQ : Fin n → Prog (p3ModelT n wc) (Lab n wc) :=
  fun c => mapOut (fun _ => default) (parList (List.ofFn fun s' => p s' c))

theorem rounds_psJ (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) (s : Fin N) (c : Fin n) :
    rounds f (psJ p s c) = zipAll (List.ofFn fun s' => rounds f (p s' c)) :=
  rounds_parFam f _ s

theorem rounds_pQ (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) (c : Fin n) :
    rounds f (pQ p c) = zipAll (List.ofFn fun s' => rounds f (p s' c)) := by
  rw [pQ, rounds_mapOut, rounds_parList, List.map_ofFn]
  rfl

/-- **The rounds of `psJ p s` do not depend on `s`.** -/
theorem rounds_psJ_pQ (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) (s : Fin N) (c : Fin n) :
    rounds f (psJ p s c) = rounds f (pQ p c) := by
  rw [rounds_psJ, rounds_pQ]

/-- **The output of `psJ p s c` is `p s c`'s.** -/
theorem run_psJ (ω : (p3ModelT n wc).Ω) (s : Fin N) (c : Fin n) :
    (psJ p s c).run ((p3ModelT n wc).answer ω) = (p s c).run ((p3ModelT n wc).answer ω) :=
  run_parFam _ _ s

theorem upTo_psJ_pQ (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) (s : Fin N) (c : Fin n) (r : ℕ) :
    upTo f (psJ p s c) r = upTo f (pQ p c) r := by
  unfold upTo; rw [rounds_psJ_pQ]

theorem mem_upTo_pQ {f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans} {c : Fin n} {r : ℕ} {q : (p3ModelT n wc).Qry} :
    q ∈ upTo f (pQ p c) r ↔ ∃ s', q ∈ upTo f (p s' c) r := by
  unfold upTo
  rw [rounds_pQ, take_zipAll, mem_flatten_zipAll]
  simp only [List.map_ofFn, List.mem_ofFn, Function.comp]
  constructor
  · rintro ⟨l, ⟨s', rfl⟩, hq⟩; exact ⟨s', hq⟩
  · rintro ⟨s', hq⟩; exact ⟨_, ⟨s', rfl⟩, hq⟩

/-- **Asked by the joint family** iff asked by some segment's program. -/
theorem asked_psJ {ω : (p3ModelT n wc).Ω} {s : Fin N} {q : (p3ModelT n wc).Qry} {r : ℕ} :
    Asked (psJ p s) ω q r ↔ ∃ s', Asked (p s') ω q r := by
  constructor
  · rintro ⟨c, hc⟩
    rw [upTo_psJ_pQ, mem_upTo_pQ] at hc
    obtain ⟨s', hs'⟩ := hc
    exact ⟨s', c, hs'⟩
  · rintro ⟨s', c, hc⟩
    refine ⟨c, ?_⟩
    rw [upTo_psJ_pQ, mem_upTo_pQ]
    exact ⟨s', hc⟩

theorem asked_psJ_pQ {ω : (p3ModelT n wc).Ω} {s : Fin N} {q : (p3ModelT n wc).Qry} {r : ℕ} :
    Asked (psJ p s) ω q r ↔ Asked (pQ p) ω q r := by
  unfold Asked; simp only [upTo_psJ_pQ]

theorem work_eq_flatten {α : Type} (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans)
    (pr : Prog (p3ModelT n wc) α) : pr.work f = (rounds f pr).flatten.length := by
  rw [← progTrace_eq_flatten, progTrace_length]

theorem bounded_of_rounds {α : Type} {pr : Prog (p3ModelT n wc) α} {D Q : ℕ}
    (h : ∀ ω, (rounds ((p3ModelT n wc).answer ω) pr).length ≤ D ∧
      (rounds ((p3ModelT n wc).answer ω) pr).flatten.length ≤ Q) : pr.Bounded D Q := fun ω =>
  ⟨(length_rounds _ pr).symm.trans_le (h ω).1, (work_eq_flatten _ pr).trans_le (h ω).2⟩

theorem zipAll_bounds {D Q : ℕ} (hb : ∀ s c, (p s c).Bounded D Q) (ω : (p3ModelT n wc).Ω) (c : Fin n) :
    (zipAll (List.ofFn fun s' => rounds ((p3ModelT n wc).answer ω) (p s' c))).length ≤ D ∧
      (zipAll (List.ofFn fun s' => rounds ((p3ModelT n wc).answer ω) (p s' c))).flatten.length ≤ N * Q := by
  refine ⟨length_zipAll_le _ fun l hl => ?_, ?_⟩
  · obtain ⟨s', rfl⟩ := List.mem_ofFn.1 hl
    exact length_rounds_le (hb s' c) ω
  · rw [length_flatten_zipAll, List.map_ofFn, List.sum_ofFn]
    calc ∑ i : Fin N, ((fun l : List (List (p3ModelT n wc).Qry) => l.flatten.length) ∘
          fun s' => rounds ((p3ModelT n wc).answer ω) (p s' c)) i
        ≤ ∑ _i : Fin N, Q := Finset.sum_le_sum fun i _ => by
          simp only [Function.comp]
          rw [← work_eq_flatten]
          exact (hb i c ω).2
      _ = N * Q := by simp

/-- **`psJ p s` is `(D, N·Q)`-bounded.** -/
theorem bounded_psJ {D Q : ℕ} (hb : ∀ s c, (p s c).Bounded D Q) (s : Fin N) (c : Fin n) :
    (psJ p s c).Bounded D (N * Q) :=
  bounded_of_rounds fun ω => by rw [rounds_psJ]; exact zipAll_bounds p hb ω c

theorem bounded_pQ {D Q : ℕ} (hb : ∀ s c, (p s c).Bounded D Q) (c : Fin n) : (pQ p c).Bounded D (N * Q) :=
  bounded_of_rounds fun ω => by rw [rounds_pQ]; exact zipAll_bounds p hb ω c

end Joint

/-! ### Everything slot-level depends only on the rounds -/

section Congr

variable {n wc : ℕ} {ps ps' : Fin n → Prog (p3ModelT n wc) (Lab n wc)}

theorem asked_eq_of_rounds (h : ∀ ω c, rounds ((p3ModelT n wc).answer ω) (ps c) = rounds ((p3ModelT n wc).answer ω) (ps' c)) :
    Asked ps = Asked ps' := by
  funext ω q r
  unfold Asked upTo
  simp only [h]

theorem firstRound_eq_of_rounds
    (h : ∀ ω c, rounds ((p3ModelT n wc).answer ω) (ps c) = rounds ((p3ModelT n wc).answer ω) (ps' c)) :
    firstRound ps = firstRound ps' := by
  funext ω q
  unfold firstRound
  rw [asked_eq_of_rounds h]

theorem askers_eq_of_rounds
    (h : ∀ ω c, rounds ((p3ModelT n wc).answer ω) (ps c) = rounds ((p3ModelT n wc).answer ω) (ps' c)) :
    askers ps = askers ps' := by
  classical
  funext ω q r
  ext c
  simp only [askers, Finset.mem_filter, Finset.mem_univ, true_and]
  unfold upTo
  rw [h]

theorem progTrace_eq_of_rounds
    (h : ∀ ω c, rounds ((p3ModelT n wc).answer ω) (ps c) = rounds ((p3ModelT n wc).answer ω) (ps' c))
    (ω : (p3ModelT n wc).Ω) (c : Fin n) :
    progTrace ((p3ModelT n wc).answer ω) (ps c) = progTrace ((p3ModelT n wc).answer ω) (ps' c) := by
  rw [progTrace_eq_flatten, progTrace_eq_flatten, h]

/-- **First-ask slots depend only on the rounds.** -/
theorem slotOf_eq_of_rounds
    (h : ∀ ω c, rounds ((p3ModelT n wc).answer ω) (ps c) = rounds ((p3ModelT n wc).answer ω) (ps' c)) :
    slotOf ps = slotOf ps' := by
  funext ω q
  unfold slotOf
  rw [askers_eq_of_rounds h, firstRound_eq_of_rounds h]
  simp only [progTrace_eq_of_rounds h]

end Congr

section JointCongr

variable {N n wc : ℕ} (p : Fin N → Fin n → Prog (p3ModelT n wc) (Lab n wc))

theorem asked_psJ_eq (s : Fin N) : Asked (psJ p s) = Asked (pQ p) :=
  asked_eq_of_rounds fun _ c => rounds_psJ_pQ p _ s c

theorem firstRound_psJ_eq (s : Fin N) : firstRound (psJ p s) = firstRound (pQ p) :=
  firstRound_eq_of_rounds fun _ c => rounds_psJ_pQ p _ s c

theorem slotOf_psJ_eq (s : Fin N) : slotOf (psJ p s) = slotOf (pQ p) :=
  slotOf_eq_of_rounds fun _ c => rounds_psJ_pQ p _ s c

theorem progTrace_psJ_eq (s : Fin N) (ω : (p3ModelT n wc).Ω) (c : Fin n) :
    progTrace ((p3ModelT n wc).answer ω) (psJ p s c) = progTrace ((p3ModelT n wc).answer ω) (pQ p c) :=
  progTrace_eq_of_rounds (fun _ c => rounds_psJ_pQ p _ s c) ω c

end JointCongr

end PousJointAccounting

end


/-! ════ P3ConcreteMulti.Compose ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Lock-step composition over the chain, and the segment replays of a joint family

The random-oracle joint accounting credits segment `s` against `psJ p s`: every segment's program `c` in lock-step,
with segment `s`'s output (`freshness/JointAccountingDefs.lean`). The combinators (`mapOut`, `par2`, `parList`,
`parFam`) are model-generic, so the same composition runs over `p3ChainModel`.

- `mem_trace_parFam`: the composed program's transcript is the union of the components' transcripts, round for round
  (`Tr.trace`, the transcript `P3Replay` reads).
- `run_psJC` and `bounded_psJC`: segment `s`'s output, and `(D, N·Q)`-bounded.
- `segReplay`: segment `s`'s replay of the joint family: its tag and data, and **all** `N·n` programs, indexed by
  `Fin N × Fin n` (bc-58ec406e's (A′) `P3Replay n wc ι`). Its reveals are every segment's reveals
  (`askedS_segReplay`, `askedP_segReplay`), whatever `s` is; its answer map is `v ↦ (s, v)`.
- `joint_win_price`: bc-58ec406e's `win_price_on` on each segment replay. A joint win forces every segment's online
  holding, against all segments' reveals, to cost `(k − X)·n` columns, so `N·(k − X)·n` in all.
- The lock-step composition `psJC` is kept for program-level composition; the segment replays no longer need it.
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete PousRounds PousJointAccounting

/-! ## Transcripts and rounds -/

section Trace

variable {M : IdealModel} {α : Type}

/-- A transcript entry is a query of its round's batch. -/
theorem mem_trace_iff (f : M.Qry → M.Ans) (p : Prog M α) (e : ℕ × M.Qry) :
    e ∈ Tr.trace f p ↔ e.2 ∈ (rounds f p).getD e.1 [] := by
  induction p generalizing e with
  | ret a => simp [Tr.trace, rounds]
  | round qs k ih =>
    obtain ⟨t, q⟩ := e
    simp only [Tr.trace, rounds, List.mem_append, List.mem_map]
    cases t with
    | zero =>
      simp only [List.getD_cons_zero]
      constructor
      · rintro (⟨x, hx, h⟩ | ⟨e', _, h⟩)
        · cases h; exact hx
        · cases h
      · intro hq; exact Or.inl ⟨q, hq, rfl⟩
    | succ t =>
      simp only [List.getD_cons_succ]
      constructor
      · rintro (⟨x, _, h⟩ | ⟨e', he', h⟩)
        · cases h
        · cases h
          exact (ih _ e').1 he'
      · intro hq
        exact Or.inr ⟨(t, q), (ih _ (t, q)).2 hq, rfl⟩

variable {β : Type}

theorem getD_zipR : ∀ (a b : List (List β)) (t : ℕ), (zipR a b).getD t [] = a.getD t [] ++ b.getD t []
  | [], b, t => by simp
  | a :: as, [], t => by simp
  | a :: as, b :: bs, 0 => by simp
  | a :: as, b :: bs, t + 1 => by
    simp only [zipR_cons_cons, List.getD_cons_succ]
    exact getD_zipR as bs t

theorem mem_getD_zipAll {q : β} (t : ℕ) :
    ∀ L : List (List (List β)), q ∈ (zipAll L).getD t [] ↔ ∃ l ∈ L, q ∈ l.getD t []
  | [] => by simp
  | l :: L => by
    rw [zipAll_cons, getD_zipR, List.mem_append, mem_getD_zipAll t L]
    simp

/-- **The composed program's transcript is the union of its components'**, round for round. -/
theorem mem_trace_parFam [Inhabited α] {N : ℕ} (f : M.Qry → M.Ans) (ps : Fin N → Prog M α) (i : Fin N)
    (e : ℕ × M.Qry) : e ∈ Tr.trace f (parFam ps i) ↔ ∃ s, e ∈ Tr.trace f (ps s) := by
  rw [mem_trace_iff, rounds_parFam, mem_getD_zipAll]
  simp only [List.mem_ofFn, mem_trace_iff]
  constructor
  · rintro ⟨l, ⟨s, rfl⟩, hq⟩; exact ⟨s, hq⟩
  · rintro ⟨s, hq⟩; exact ⟨_, ⟨s, rfl⟩, hq⟩

theorem work_eq_flatten' (f : M.Qry → M.Ans) (p : Prog M α) : p.work f = (rounds f p).flatten.length := by
  rw [← progTrace_eq_flatten, PousForwardCore.progTrace_length]

/-- **The composed program of `(D, Q)`-bounded programs is `(D, N·Q)`-bounded.** -/
theorem bounded_parFam [Inhabited α] {N D Q : ℕ} (ps : Fin N → Prog M α) (hb : ∀ s, (ps s).Bounded D Q)
    (i : Fin N) : (parFam ps i).Bounded D (N * Q) := by
  intro ω
  refine ⟨?_, ?_⟩
  · rw [← length_rounds, rounds_parFam]
    refine length_zipAll_le _ fun l hl => ?_
    obtain ⟨s, rfl⟩ := List.mem_ofFn.1 hl
    exact length_rounds_le (hb s) ω
  · rw [work_eq_flatten', rounds_parFam, length_flatten_zipAll, List.map_ofFn, List.sum_ofFn]
    calc ∑ s : Fin N, ((fun l : List (List M.Qry) => l.flatten.length) ∘ fun s' => rounds (M.answer ω) (ps s')) s
        ≤ ∑ _s : Fin N, Q := Finset.sum_le_sum fun s _ => by
          simp only [Function.comp]
          rw [← work_eq_flatten']
          exact (hb s ω).2
      _ = N * Q := by simp

end Trace

/-! ## The joint family over the chain -/

section Joint

variable {N n wc : ℕ} (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc))

/-- **Segment `s`'s composed family over the chain**: its program `v` runs every segment's program `v` in lock-step,
with segment `s`'s output. -/
noncomputable def psJC (s : Fin N) : Fin n → Prog (p3ChainModel n wc) (Lab n wc) :=
  fun v => parFam (fun s' => A s' v) s

theorem run_psJC (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (s : Fin N) (v : Fin n) :
    (psJC A s v).run f = (A s v).run f :=
  run_parFam f _ s

theorem mem_trace_psJC (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (s : Fin N) (v : Fin n)
    (e : ℕ × (p3ChainModel n wc).Qry) : e ∈ Tr.trace f (psJC A s v) ↔ ∃ s', e ∈ Tr.trace f (A s' v) :=
  mem_trace_parFam f _ s e

theorem bounded_psJC {D Q : ℕ} (hb : ∀ s v, (A s v).Bounded D Q) (s : Fin N) (v : Fin n) :
    (psJC A s v).Bounded D (N * Q) :=
  bounded_parFam _ (fun s' => hb s' v) s

/-- **Segment `s`'s replay of the joint family**: segment `s`'s tag and data, and all `N·n` programs. -/
def segReplay (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q : ℕ) (s : Fin N) :
    P3Replay n wc (Fin N × Fin n) :=
  ⟨tags s, G, W s, D, Q, fun i => A i.1 i.2⟩

variable (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q : ℕ) (ω : P3COmega n wc)

/-- Some program of the joint family reveals `Π₂` point `z` at round `ρ`. -/
def askedSJ (z : Bits (n * wc + (n * wc + 512))) (ρ : ℕ) : Prop :=
  ∃ s v, ∃ e ∈ Tr.trace ((p3ChainModel n wc).answer ω) (A s v), e.1 = ρ ∧ P3Replay.revS ω e.2 = some z

/-- Some program of the joint family reveals `P` point `(T, a)` at round `ρ`. -/
def askedPJ (T : Tweak n) (a : Lab n wc) (ρ : ℕ) : Prop :=
  ∃ s v, ∃ e ∈ Tr.trace ((p3ChainModel n wc).answer ω) (A s v), e.1 = ρ ∧ P3Replay.revP ω e.2 = some (T, a)

/-- **Every segment replay sees every segment's `Π₂` reveals.** -/
theorem askedS_segReplay (s : Fin N) (z : Bits (n * wc + (n * wc + 512))) (ρ : ℕ) :
    (segReplay A tags G W D Q s).askedS ω z ρ ↔ askedSJ A ω z ρ := by
  unfold P3Replay.askedS askedSJ
  exact ⟨fun ⟨i, h⟩ => ⟨i.1, i.2, h⟩, fun ⟨s', v, h⟩ => ⟨(s', v), h⟩⟩

/-- **Every segment replay sees every segment's `P` reveals.** -/
theorem askedP_segReplay (s : Fin N) (T : Tweak n) (a : Lab n wc) (ρ : ℕ) :
    (segReplay A tags G W D Q s).askedP ω T a ρ ↔ askedPJ A ω T a ρ := by
  unfold P3Replay.askedP askedPJ
  exact ⟨fun ⟨i, h⟩ => ⟨i.1, i.2, h⟩, fun ⟨s', v, h⟩ => ⟨(s', v), h⟩⟩

/-- Segment `s`'s top labels in its replay are the scheme's. -/
theorem c2_segReplay (s : Fin N) : (segReplay A tags G W D Q s).c2 ω = topLabelC (tags s) G (W s) ω := rfl

/-- **Every segment wins**: at least `k` of segment `s`'s programs return their top label, for every `s`. -/
def WinC (k : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (ω : P3COmega n wc) : Prop :=
  ∀ s : Fin N, k ≤ (Finset.univ.filter fun v =>
    (A s v).run ((p3ChainModel n wc).answer ω) = topLabelC (tags s) G (W s) ω v).card

/-- **The joint price.** A joint win forces, in every segment, an online holding (against all segments' reveals)
priced at least `(k − X)·n` columns: `win_price_on` on the segment replays, answer map `v ↦ (s, v)`. -/
theorem joint_win_price (hA : ∀ s v, (A s v).Bounded D Q) {c k X : ℕ} (hard : P3ChainHard G c wc D k X)
    (hw : WinC k tags G W A ω) (s : Fin N) :
    (((k - X : ℕ) : ℚ) * n) ≤ ((segReplay A tags G W D Q s).onlineH ω (D + 1)).size c wc := by
  classical
  refine (segReplay A tags G W D Q s).win_price_on ω (fun i => hA i.1 i.2) (fun v => (s, v)) hard
    ((hw s).trans ?_)
  refine Finset.card_le_card fun v hv => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv ⊢
  exact hv

/-- **Summed over the segments**: `N·(k − X)·n` columns in all. -/
theorem joint_win_price_sum (hA : ∀ s v, (A s v).Bounded D Q) {c k X : ℕ} (hard : P3ChainHard G c wc D k X)
    (hw : WinC k tags G W A ω) :
    ((N * (k - X) : ℕ) : ℚ) * n ≤ ∑ s : Fin N, ((segReplay A tags G W D Q s).onlineH ω (D + 1)).size c wc := by
  calc ((N * (k - X) : ℕ) : ℚ) * n = ∑ _s : Fin N, (((k - X : ℕ) : ℚ) * n) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        push_cast
        ring
    _ ≤ _ := Finset.sum_le_sum fun s _ => joint_win_price A tags G W D Q ω hA hard hw s

end Joint

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.Core ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The joint core for P3 over the chain at 14 GB, and its glue

`P3ChainEPFMulti` is split the way the fixed-advice technique needs (`internal/p3-instantiation/
proof-technique-decision.md`, step 1: a union over `σ`, then one fixed adaptive family against a uniform `ω`):

- **`P3ChainCoreMulti`, the joint core.** For each `(tags, G, W, Q)` there is an advice-independent bad event
  (honest-point coincidences, which depend on `ω` alone) of probability at most the target's collision term, such
  that every **fixed** `(D, Q)`-bounded family over all `N` segments wins every segment, off the bad event, on at most
  `N·(N·nPosC)^{14nN}·|Ω| / 2^{N(k−X−1)·n·wc}` primitives. The family is one algorithm over one shared `Π₂` and the
  per-tweak `P`: cross-segment queries are just more of its queries. This is the random-oracle `ZeroAdviceLuckyMulti`
  in the chain model, at the target's positions and one-label slack.
- **`p3ChainEPFMulti_of_core`**: the core gives the target: split off the bad event, then sum over the `2^m` advice
  strings (`pr_le_of_advice`).
- **`p3ChainEPF_of_multi`**: the target at `N = 1` is `P3ChainEPF` exactly. So the one-segment proof is the `N = 1`
  case of the joint one, and `p3ChainEPF_of_core` gives it from the core.

**Side conditions.** `1 ≤ N` is necessary for both the core and the target (`not_core_N0`, `not_epfMulti_N0`): with
no segment the joint event always holds and both right-hand sides are `0`. The other side conditions are the
target's; the deployment meets them (`p3ChainCoreMulti_hyps_64`).
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete PousAssembly PousForwardCore
open scoped ENNReal

open Classical in
/-- **The joint core.** An advice-independent bad event within the target's collision term, off which every fixed
`(D, Q)`-bounded family over the `N` segments wins every segment on at most
`N·(N·nPosC)^{14nN}·|Ω| / 2^{N(k−X−1)·n·wc}` primitives. -/
def P3ChainCoreMulti : Prop :=
  ∀ (N n wc D Q k X : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → 1 ≤ N → X + 1 ≤ k → Function.Injective tags → P3ChainHard G 512 wc D k X →
    ∃ Bad : P3COmega n wc → Prop,
      pr Bad ≤ (((N * nPosC n Q) ^ 2 + (2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) ∧
      ∀ A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc), (∀ s v, (A s v).Bounded D Q) →
        (Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ Bad ω).card * 2 ^ (N * (k - X - 1) * (n * wc)) ≤
          N * (N * nPosC n Q) ^ (14 * n * N) * Fintype.card (P3COmega n wc)

/-- **The glue**: the joint core gives `P3ChainEPFMulti`. -/
theorem p3ChainEPFMulti_of_core (h : P3ChainCoreMulti) : P3ChainEPFMulti := by
  classical
  intro N n wc m D Q k X tags G W hn hwc hn255 hC1 _ hN hXk htags hard A₁ A₂ hA
  obtain ⟨Bad, hBad, hcount⟩ := h N n wc D Q k X tags G W hn hwc hn255 hC1 hN hXk htags hard
  rw [pr_partition (JointEventC G tags W A₁ A₂ k) Bad]
  refine add_le_add ?_ ((pr_mono fun ω h => h.2).trans hBad)
  refine (pr_le_of_advice A₁ (fun ω => JointEventC G tags W A₁ A₂ k ω ∧ ¬ Bad ω)
    (N * (N * nPosC n Q) ^ (14 * n * N)) (2 ^ (N * (k - X - 1) * (n * wc))) (by positivity)
    fun σ => ?_).trans (le_of_eq ?_)
  · refine le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card fun ω hω => ?_)) (hcount (A₂ σ) (hA σ))
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
    obtain ⟨hσ, hwin, hbad⟩ := hω
    refine ⟨fun s => ?_, hbad⟩
    have hs := hwin s
    rw [hσ] at hs
    exact hs
  · simp only [Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat, div_eq_mul_inv]
    ring

/-- **The target at `N = 1` is `P3ChainEPF`.** -/
theorem p3ChainEPF_of_multi (h : P3ChainEPFMulti) : P3ChainEPF := by
  intro n wc m D Q k X tag G W hn hwc hn255 hC1 hC2 hXk hard A₁ A₂ hA
  have h1 := h 1 n wc m D Q k X (fun _ => tag) G (fun _ => W) hn hwc hn255 (by rwa [one_mul]) (by rwa [one_mul])
    le_rfl hXk
    (fun a b _ => Subsingleton.elim a b) hard A₁ (fun σ _ v => A₂ σ v) (fun σ _ v => hA σ v)
  have hev : JointEventC (N := 1) G (fun _ : Fin 1 => tag) (fun _ : Fin 1 => W) A₁ (fun σ (_ : Fin 1) v => A₂ σ v) k =
      fun ω : P3COmega n wc => k ≤ (Finset.univ.filter fun v =>
        (A₂ (A₁ ω) v).run ((p3ChainModel n wc).answer ω) = topLabelC tag G W ω v).card := by
    funext ω
    exact propext ⟨fun hj => hj 0, fun hj _ => hj⟩
  rw [hev] at h1
  refine h1.trans (le_of_eq ?_)
  simp only [Nat.cast_one, one_mul, Nat.mul_one]

/-- **The one-segment target from the joint core.** -/
theorem p3ChainEPF_of_core (h : P3ChainCoreMulti) : P3ChainEPF := p3ChainEPF_of_multi (p3ChainEPFMulti_of_core h)

/-! ## Side conditions -/

/-- **`1 ≤ N` is necessary for the target**: with no segment the joint event always holds, and the right-hand side
is `0`. -/
theorem not_epfMulti_N0 (n wc m Q k X : ℕ) (tags : Fin 0 → Bits 256) (G : TopoDAG n)
    (W : Fin 0 → Fin n → Lab n wc) (A₁ : P3COmega n wc → Bits m)
    (A₂ : Bits m → Fin 0 → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) :
    ¬ pr (JointEventC G tags W A₁ A₂ k) ≤
        ((0 : ℕ) : ℝ≥0∞) * 2 ^ m * (((0 * nPosC n Q) ^ (14 * n * 0) : ℕ) : ℝ≥0∞) /
            2 ^ (0 * (k - X - 1) * (n * wc)) +
          (((0 * nPosC n Q) ^ 2 + (2 * 0 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
  have h1 : pr (JointEventC G tags W A₁ A₂ k) = 1 := pr_eq_one fun ω s => s.elim0
  rw [h1]
  simp

open Classical in
/-- **`1 ≤ N` is necessary for the core**: no bad event of probability `0` leaves the vacuous joint win below `0`. -/
theorem not_core_N0 (n wc D Q k X : ℕ) (tags : Fin 0 → Bits 256) (G : TopoDAG n) (W : Fin 0 → Fin n → Lab n wc) :
    ¬ ∃ Bad : P3COmega n wc → Prop,
      pr Bad ≤ (((0 * nPosC n Q) ^ 2 + (2 * 0 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) ∧
      ∀ A : Fin 0 → Fin n → Prog (p3ChainModel n wc) (Lab n wc), (∀ s v, (A s v).Bounded D Q) →
        (Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ Bad ω).card * 2 ^ (0 * (k - X - 1) * (n * wc)) ≤
          0 * (0 * nPosC n Q) ^ (14 * n * 0) * Fintype.card (P3COmega n wc) := by
  rintro ⟨Bad, hBad, hcount⟩
  have h0 : pr Bad = 0 := le_antisymm (by simpa using hBad) bot_le
  have hc := hcount (fun s => s.elim0) (fun s => s.elim0)
  simp only [Nat.zero_mul, pow_zero, Nat.mul_one, nonpos_iff_eq_zero, Finset.card_eq_zero,
    Finset.filter_eq_empty_iff, Finset.mem_univ, true_implies, not_and, not_not] at hc
  have hall : ∀ ω, Bad ω := fun ω => hc (fun s => s.elim0)
  rw [pr_eq_one hall] at h0
  exact one_ne_zero h0

/-- **The core's side conditions at the deployment point** (`B(220, 12)`, 64 KB labels, `N = 971`, `Q = 2^20`,
`D = 10`, `k = 106`, `X = 1`), with (C1) from bc-58ec406e's `c1_multi_64` and the proved certificate `p3ChainCert`
at `k = 220`. -/
theorem p3ChainCoreMulti_hyps_64 (salt : Bits 192) :
    0 < 220 ∧ 0 < 2384 ∧ 220 ≤ 2 ^ 255 ∧ 2 * (971 * nPosC 220 (2 ^ 20)) ≤ 2 ^ 2384 ∧ 1 ≤ 971 ∧ 1 + 1 ≤ 106 ∧
      Function.Injective (fun s : Fin 971 => Pous.P3Meets.tagR salt s.val) ∧
      P3ChainHard (Pous.P3Column.bandGraph 220 12) 512 2384 10 220 1 :=
  ⟨by norm_num, by norm_num, by norm_num, c1_multi_64 (by norm_num), by norm_num, by norm_num,
    Pous.P3Meets.tagR_injective 971 (by norm_num) salt, p3ChainCert⟩

/-! ## The count form: the bad event is `JBad`, bounded by `jointBirthday` -/

open Classical in
/-- **The joint count off `JBad`**: every fixed `(D, Q)`-bounded family over the `N` segments wins every segment,
outside the joint bad event, on at most `N·(N·nPosC)^{14nN}·|Ω| / 2^{N(k−X−1)·n·wc}` primitives. The collision half
of the core is `jointBirthday`, so this is what remains. -/
def P3ChainCountMulti : Prop :=
  ∀ (N n wc D Q k X : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → 1 ≤ N → X + 1 ≤ k → Function.Injective tags → P3ChainHard G 512 wc D k X →
    ∀ A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc), (∀ s v, (A s v).Bounded D Q) →
      (Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card * 2 ^ (N * (k - X - 1) * (n * wc)) ≤
        N * (N * nPosC n Q) ^ (14 * n * N) * Fintype.card (P3COmega n wc)

/-- **The count form gives the core**, with `Bad := JBad` and its bound from `jointBirthday`. -/
theorem p3ChainCoreMulti_of_count (h : P3ChainCountMulti) : P3ChainCoreMulti := by
  intro N n wc D Q k X tags G W hn hwc hn255 hC1 hN hXk htags hard
  exact ⟨JBad tags G W, jointBirthday N n wc Q tags G W htags hn255,
    h N n wc D Q k X tags G W hn hwc hn255 hC1 hN hXk htags hard⟩

/-- **The 14 GB target from the count form.** -/
theorem p3ChainEPFMulti_of_count (h : P3ChainCountMulti) : P3ChainEPFMulti :=
  p3ChainEPFMulti_of_core (p3ChainCoreMulti_of_count h)

/-- **The one-segment target from the count form at `N = 1`.** -/
theorem p3ChainEPF_of_count (h : P3ChainCountMulti) : P3ChainEPF :=
  p3ChainEPF_of_core (p3ChainCoreMulti_of_count h)

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.NonInterference ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Injective tags and non-interference across segments

In the lazy-sampling technique, cross-segment queries are just more queries against the shared primitives. What makes
the segments separate is where their honest points sit, and that is what this file proves:

- **`P` is disjoint across segments.** Segment `s` uses only the tweaks `(tags s, L, v)`. With injective tags these
  are other segments' tweaks never (`tweak_ne`), so they are different permutations of the tweakable family, sampled
  independently.
- **A segment's labels read `P` only at its own tweaks** (`c1c_congr`, `c2c_congr`, `topLabelC_congr`). Resampling,
  or lazily deciding, another segment's `P` points does not move them.
- **`Π₂` rows start apart.** First calls of distinct rows are distinct points (`Honest.lean`: `domP3_inj`,
  `xin_one_ne`), here across the segment replays of a joint family (`segReplay_xin_one_ne`). Later calls differ unless
  two chaining values coincide, which is the joint collision event's job (`JBad`, `jointBirthday`).
- **The game is a product.** Segment `s`'s items enter only segment `s`'s chain-column game, so the joint game is the
  product `JKnow N n` of `N` copies of `P3ChainKnow n`, priced by the sum. Per-segment `P3ChainHard` gives the joint
  hardness `N·(k − X)·n` (`jointHard`).
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

section Rows

variable {n wc : ℕ}

/-- **Across the segment replays of a joint family** with injective tags, first calls of distinct rows are distinct. -/
theorem segReplay_xin_one_ne {N : ℕ} (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc))
    (tags : Fin N → Bits 256) (htags : Function.Injective tags) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (D Q : ℕ) (ω : P3COmega n wc) (hn : n ≤ 2 ^ 255) {s s' : Fin N} {L L' : Fin 2} {v v' : Fin n}
    (hne : (s, L, v) ≠ (s', L', v')) :
    (segReplay A tags G W D Q s).xin ω L v 1 ≠ (segReplay A tags G W D Q s').xin ω L' v' 1 := by
  refine xin_one_ne _ _ ω ω hn fun h => hne ?_
  simp only [segReplay, Prod.mk.injEq] at h
  rw [htags h.1, h.2.1, h.2.2]

/-! ## `P` -/

/-- **Segments use disjoint tweaks.** -/
theorem tweak_ne {N : ℕ} (tags : Fin N → Bits 256) (htags : Function.Injective tags) {s s' : Fin N} (hs : s ≠ s')
    (L L' : Fin 2) (v v' : Fin n) : ((tags s, L, v) : Tweak n) ≠ (tags s', L', v') :=
  fun h => hs (htags (congrArg Prod.fst h))

/-- **Lower labels read `P` only at their tag's tweaks**, and `Π₂` only through `ω.2`. -/
theorem c1c_congr (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc) {ω ω' : P3COmega n wc}
    (h2 : ω.2 = ω'.2) (hP : ∀ (L : Fin 2) (v : Fin n), ω.1 (tag, L, v) = ω'.1 (tag, L, v)) :
    c1c tag G ω.2 ω.1 W = c1c tag G ω'.2 ω'.1 W := by
  funext u
  induction u using WellFoundedLT.induction with
  | _ u ih =>
    rw [c1c_eq, c1c_eq, hP 0 u, h2]
    congr 3
    refine List.map_congr_left fun w hw => ?_
    have hw' := ih w (G.par_lt u w ((Finset.mem_sort _).1 hw))
    rwa [h2] at hw'

/-- **Top labels read `P` only at their tag's tweaks.** -/
theorem c2c_congr (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc) {ω ω' : P3COmega n wc}
    (h2 : ω.2 = ω'.2) (hP : ∀ (L : Fin 2) (v : Fin n), ω.1 (tag, L, v) = ω'.1 (tag, L, v)) :
    c2c tag G ω.2 ω.1 W = c2c tag G ω'.2 ω'.1 W := by
  have h1 := c1c_congr tag G W h2 hP
  funext u
  induction u using WellFoundedLT.induction with
  | _ u ih =>
    rw [c2c_eq, c2c_eq, hP 1 u, h1, h2]
    congr 3
    refine List.map_congr_left fun w hw => ?_
    have hw' := ih w (G.par_lt u w ((Finset.mem_sort _).1 hw))
    rwa [h2] at hw'

/-- **A segment's top labels are untouched by the other segments' `P` permutations**: they agree whenever `Π₂` and
`P` at the segment's own tweaks agree. -/
theorem topLabelC_congr (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc) {ω ω' : P3COmega n wc}
    (h2 : ω.2 = ω'.2) (hP : ∀ (L : Fin 2) (v : Fin n), ω.1 (tag, L, v) = ω'.1 (tag, L, v)) :
    topLabelC tag G W ω = topLabelC tag G W ω' :=
  c2c_congr tag G W h2 hP

/-- **Segment `s`'s top labels ignore every other segment's permutations**, with injective tags. -/
theorem topLabelC_congr_seg {N : ℕ} (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (s : Fin N) {ω ω' : P3COmega n wc} (h2 : ω.2 = ω'.2)
    (hP : ∀ (L : Fin 2) (v : Fin n), ω.1 (tags s, L, v) = ω'.1 (tags s, L, v)) :
    topLabelC (tags s) G (W s) ω = topLabelC (tags s) G (W s) ω' :=
  topLabelC_congr _ G _ h2 hP

end Rows

/-! ## The product game -/

/-- **The joint chain-column game**: one `P3ChainKnow` per segment. -/
abbrev JKnow (N n : ℕ) : Type := Fin N → P3ChainKnow n

namespace JKnow

variable {N n : ℕ} (G : TopoDAG n)

/-- The joint knowledge after `t` rounds: every segment's game runs on its own items. -/
noncomputable def reach (K₀ : JKnow N n) (t : ℕ) : JKnow N n := fun s => P3ChainKnow.reach G (K₀ s) t

/-- The joint price: the sum of the segments' prices. -/
noncomputable def size (c wc : ℕ) (K : JKnow N n) : ℚ := ∑ s, (K s).size c wc

/-- **Joint hardness from per-segment hardness**: a joint holding that knows `k` tops of every segment after `D`
rounds is priced at least `N·(k − X)·n` columns. -/
theorem jointHard {c wc D k X : ℕ} (hard : P3ChainHard G c wc D k X) (K₀ : JKnow N n)
    (hk : ∀ s, k ≤ ((reach G K₀ D) s).tops.card) : ((N * (k - X) : ℕ) : ℚ) * n ≤ size c wc K₀ := by
  calc ((N * (k - X) : ℕ) : ℚ) * n = ∑ _s : Fin N, (((k - X : ℕ) : ℚ) * n) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        push_cast
        ring
    _ ≤ size c wc K₀ := Finset.sum_le_sum fun s _ => hard (K₀ s) (hk s)

/-- The segment replays' online holdings, as one joint holding. -/
noncomputable def ofFamily {wc : ℕ} (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc))
    (tags : Fin N → Bits 256) (W : Fin N → Fin n → Lab n wc) (D Q : ℕ) (ω : P3COmega n wc) : JKnow N n :=
  fun s => (segReplay A tags G W D Q s).onlineH ω (D + 1)

/-- **A joint win prices the joint online holding at `N·(k − X)·n`**: `joint_win_price_sum` in the product game. -/
theorem size_ofFamily {wc D Q : ℕ} (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc))
    (tags : Fin N → Bits 256) (W : Fin N → Fin n → Lab n wc) (ω : P3COmega n wc) (hA : ∀ s v, (A s v).Bounded D Q)
    {c k X : ℕ} (hard : P3ChainHard G c wc D k X) (hw : WinC k tags G W A ω) :
    ((N * (k - X) : ℕ) : ℚ) * n ≤ size c wc (ofFamily G A tags W D Q ω) :=
  joint_win_price_sum A tags G W D Q ω hA hard hw

end JKnow

end PousP3ConcreteMulti

end


/-! ════ LazyPerm ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Lazy sampling of ideal permutations

Shared library of `bc-a359729a` (`internal/p3-instantiation/proof-technique-decision.md`, API section 06:05Z). Mathlib
only.

A uniform family of permutations `π : (i : ι) → Perm (α i)` is queried adaptively, forward (`π i x`) and inverse
(`(π i)⁻¹ y`), by a deterministic `Strategy`. A query is **fresh** when the history does not already fix its answer.
The answer to a fresh query is uniform over the values not yet used. So it lands in a target set `T` of size `t` with
probability at most `t/(N − k)`, where `k ≤ n` values are used after `n` steps. These bounds multiply along the
transcript.

- `card_filter_mem_mul_le`: uniform fibers, the counting core.
- `card_perm_extending`: permutations extending a partial bijection of size `k` number `(N − k)!`.
- `Strategy.card_step_le`: the per-answer bound at one step, conditioned on any event fixed by the history.
- `Strategy.card_hits_le` and `Strategy.prob_hits_le`: the product over a fixed set of named steps.
-/

open scoped ENNReal

namespace LazyPerm

/-! ### Counting -/

section Counting

variable {β : Type} [DecidableEq β]

/-- **Uniform fibers.** If `g` maps `s` into `A` and all fibers of `s` over `A` have one size, then
`|{x ∈ s | g x ∈ T}| · |A| ≤ |T| · |s|`. -/
theorem card_filter_mem_mul_le {γ : Type} (s : Finset γ) (g : γ → β) (A T : Finset β)
    (hA : ∀ x ∈ s, g x ∈ A)
    (heq : ∀ a ∈ A, ∀ a' ∈ A, (s.filter (fun x => g x = a)).card = (s.filter (fun x => g x = a')).card) :
    (s.filter (fun x => g x ∈ T)).card * A.card ≤ T.card * s.card := by
  rcases A.eq_empty_or_nonempty with hA0 | ⟨a₀, ha₀⟩
  · rw [hA0, Finset.card_empty, Nat.mul_zero]; exact Nat.zero_le _
  set f := (s.filter (fun x => g x = a₀)).card
  have hs : s.card = A.card * f := by
    rw [Finset.card_eq_sum_card_fiberwise (f := g) (t := A) (fun x hx => hA x hx),
      Finset.sum_congr rfl (fun a ha => heq a ha a₀ ha₀), Finset.sum_const, smul_eq_mul]
  have hT : (s.filter (fun x => g x ∈ T)).card = (A ∩ T).card * f := by
    rw [Finset.card_eq_sum_card_fiberwise (f := g) (t := A ∩ T) (fun x hx => by
      rw [Finset.mem_coe, Finset.mem_filter] at hx
      exact Finset.mem_inter.2 ⟨hA x hx.1, hx.2⟩)]
    rw [Finset.sum_congr rfl (fun a ha => ?_), Finset.sum_const, smul_eq_mul]
    rw [Finset.filter_filter]
    refine Eq.trans ?_ (heq a (Finset.mem_inter.1 ha).1 a₀ ha₀)
    congr 1
    exact Finset.filter_congr (fun x _ => ⟨fun h => h.2, fun h => ⟨h ▸ (Finset.mem_inter.1 ha).2, h⟩⟩)
  rw [hT, hs]
  calc (A ∩ T).card * f * A.card ≤ T.card * f * A.card := by
        gcongr; exact Finset.inter_subset_right
    _ = T.card * (A.card * f) := by ring

/-- **The exact fiber size.** Under the same hypotheses, each fiber over `A` has `|s| / |A|` elements. -/
theorem card_fiber_mul_eq {γ : Type} (s : Finset γ) (g : γ → β) (A : Finset β) (hA : ∀ x ∈ s, g x ∈ A)
    (heq : ∀ a ∈ A, ∀ a' ∈ A, (s.filter (fun x => g x = a)).card = (s.filter (fun x => g x = a')).card)
    {a : β} (ha : a ∈ A) :
    (s.filter (fun x => g x = a)).card * A.card = s.card := by
  rw [Finset.card_eq_sum_card_fiberwise (s := s) (f := g) (t := A) (fun x hx => hA x hx),
    Finset.sum_congr rfl (fun a' ha' => heq a' ha' a ha), Finset.sum_const, smul_eq_mul, Nat.mul_comm]

/-- Two fibers have one size when an involution of `s` exchanges them. -/
theorem card_fiber_eq_of_invol {γ : Type} (s : Finset γ) (g : γ → β) {a a' : β} (φ : γ → γ)
    (hs : ∀ x ∈ s, φ x ∈ s) (hφ : ∀ x, φ (φ x) = x)
    (h₁ : ∀ x ∈ s, g x = a → g (φ x) = a') (h₂ : ∀ x ∈ s, g x = a' → g (φ x) = a) :
    (s.filter (fun x => g x = a)).card = (s.filter (fun x => g x = a')).card := by
  refine Finset.card_nbij' φ φ ?_ ?_ (fun x _ => hφ x) (fun x _ => hφ x)
  · intro x hx
    rw [Finset.mem_coe, Finset.mem_filter] at hx ⊢
    exact ⟨hs x hx.1, h₁ x hx.1 hx.2⟩
  · intro x hx
    rw [Finset.mem_coe, Finset.mem_filter] at hx ⊢
    exact ⟨hs x hx.1, h₂ x hx.1 hx.2⟩

variable [Fintype β]

/-- **Extension count.** The permutations of `β` extending a partial bijection `K` number `(N − |K|)!`. -/
theorem card_perm_extending (K : Finset (β × β)) (hK : ∀ p ∈ K, ∀ p' ∈ K, p.1 = p'.1 ↔ p.2 = p'.2) :
    (Finset.univ.filter (fun σ : Equiv.Perm β => ∀ p ∈ K, σ p.1 = p.2)).card
      = (Fintype.card β - K.card).factorial := by
  induction K using Finset.induction_on with
  | empty =>
    rw [Finset.filter_true_of_mem (fun σ _ p hp => absurd hp (Finset.notMem_empty p)), Finset.card_univ,
      Fintype.card_perm, Finset.card_empty, Nat.sub_zero]
  | insert p K hp ih =>
    have hK' : ∀ q ∈ K, ∀ q' ∈ K, q.1 = q'.1 ↔ q.2 = q'.2 := fun q hq q' hq' =>
      hK q (Finset.mem_insert_of_mem hq) q' (Finset.mem_insert_of_mem hq')
    have hp2 : p.2 ∉ K.image Prod.snd := by
      intro h
      obtain ⟨q, hq, hq2⟩ := Finset.mem_image.1 h
      have h1 := (hK p (Finset.mem_insert_self _ _) q (Finset.mem_insert_of_mem hq)).2 hq2.symm
      exact hp (by rw [show p = q from Prod.ext h1 hq2.symm]; exact hq)
    have hinj : (K.image Prod.snd).card = K.card :=
      Finset.card_image_of_injOn fun q hq q' hq' h => Prod.ext ((hK' q hq q' hq').2 h) h
    set s := Finset.univ.filter (fun σ : Equiv.Perm β => ∀ q ∈ K, σ q.1 = q.2)
    set A := (K.image Prod.snd)ᶜ
    have hA : ∀ σ ∈ s, σ p.1 ∈ A := by
      intro σ hσ
      rw [Finset.mem_compl]
      intro h
      rw [Finset.mem_filter] at hσ
      obtain ⟨q, hq, hq2⟩ := Finset.mem_image.1 h
      have hσq := hσ.2 q hq
      have h1 : p.1 = q.1 := σ.injective (by rw [hσq, hq2])
      have h2 := (hK p (Finset.mem_insert_self _ _) q (Finset.mem_insert_of_mem hq)).1 h1
      exact hp (by rw [show p = q from Prod.ext h1 h2]; exact hq)
    have heq : ∀ a ∈ A, ∀ a' ∈ A, (s.filter (fun σ => σ p.1 = a)).card = (s.filter (fun σ => σ p.1 = a')).card := by
      intro a ha a' ha'
      refine card_fiber_eq_of_invol s _ (fun σ => Equiv.swap a a' * σ) ?_ (fun σ => Equiv.swap_mul_self_mul a a' σ)
        (fun σ _ h => by simp only [Equiv.Perm.mul_apply, h, Equiv.swap_apply_left])
        (fun σ _ h => by simp only [Equiv.Perm.mul_apply, h, Equiv.swap_apply_right])
      intro σ hσ
      rw [Finset.mem_filter] at hσ ⊢
      refine ⟨Finset.mem_univ _, fun q hq => ?_⟩
      have hq2 : q.2 ∈ K.image Prod.snd := Finset.mem_image_of_mem _ hq
      rw [Equiv.Perm.mul_apply, hσ.2 q hq]
      exact Equiv.swap_apply_of_ne_of_ne (fun h => Finset.mem_compl.1 ha (h ▸ hq2))
        (fun h => Finset.mem_compl.1 ha' (h ▸ hq2))
    have hpA : p.2 ∈ A := Finset.mem_compl.2 hp2
    have hfib := card_fiber_mul_eq s _ A hA heq hpA
    have hext : Finset.univ.filter (fun σ : Equiv.Perm β => ∀ q ∈ insert p K, σ q.1 = q.2)
        = s.filter (fun σ => σ p.1 = p.2) := by
      ext σ
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.forall_mem_insert, s]
      exact ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩
    rw [hext]
    have hAc : A.card = Fintype.card β - K.card := by rw [Finset.card_compl, hinj]
    have hpos : 0 < A.card := Finset.card_pos.2 ⟨_, hpA⟩
    rw [ih hK', hAc] at hfib
    rw [hAc] at hpos
    rw [Finset.card_insert_of_notMem hp]
    obtain ⟨m, hm⟩ : ∃ m, Fintype.card β - K.card = m + 1 := ⟨_, (Nat.succ_pred_eq_of_pos hpos).symm⟩
    rw [hm, Nat.factorial_succ] at hfib
    rw [show Fintype.card β - (K.card + 1) = m by omega]
    exact Nat.eq_of_mul_eq_mul_right (Nat.succ_pos m) (hfib.trans (Nat.mul_comm _ _))

end Counting

/-! ### Probability -/

open Classical in
/-- The probability that a uniform `ω : Ω` satisfies `E` (the same body as `Pous.pr`). -/
noncomputable def prob {Ω : Type} [Fintype Ω] (E : Ω → Prop) : ℝ≥0∞ :=
  ((Finset.univ.filter E).card : ℝ≥0∞) / Fintype.card Ω

/-- Probabilities transfer along an equivalence. -/
theorem prob_congr {Ω Ω' : Type} [Fintype Ω] [Fintype Ω'] (e : Ω ≃ Ω') (E : Ω' → Prop) :
    prob (fun ω => E (e ω)) = prob E := by
  classical
  unfold prob
  rw [Fintype.card_congr e]
  congr 2
  refine Finset.card_nbij' e e.symm ?_ ?_ (fun x _ => e.symm_apply_apply x) (fun x _ => e.apply_symm_apply x)
  · intro x hx
    rw [Finset.mem_coe, Finset.mem_filter] at hx ⊢
    exact ⟨Finset.mem_univ _, hx.2⟩
  · intro x hx
    rw [Finset.mem_coe, Finset.mem_filter] at hx ⊢
    exact ⟨Finset.mem_univ _, by rw [e.apply_symm_apply]; exact hx.2⟩

/-- **Pinning.** A target of `t` points among `N = t·M`, with `j ≤ k` values used: `t·(M − k) ≤ N − j`. -/
theorem pin_mul_le {t M N k j : ℕ} (hN : t * M = N) (ht : 1 ≤ t) (hj : j ≤ k) : t * (M - k) ≤ N - j := by
  rcases le_or_gt k M with hk | hk
  · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
    rw [Nat.add_sub_cancel_left, ← hN, Nat.mul_add]
    have : k ≤ t * k := Nat.le_mul_of_pos_left k ht
    omega
  · rw [Nat.sub_eq_zero_of_le hk.le, Nat.mul_zero]; exact Nat.zero_le _

/-! ### Oracles, queries and histories -/

section Oracle

variable {ι : Type} {α : ι → Type}

/-- A family of permutations, one per component. -/
abbrev Oracle (α : ι → Type) : Type := (i : ι) → Equiv.Perm (α i)

/-- A query: `⟨i, inl x⟩` asks `π i x`, and `⟨i, inr y⟩` asks `(π i)⁻¹ y`. -/
abbrev Qry (α : ι → Type) : Type := Σ i, α i ⊕ α i

/-- The answer to a query. -/
def ans (π : Oracle α) : (q : Qry α) → α q.1
  | ⟨i, .inl x⟩ => π i x
  | ⟨i, .inr y⟩ => (π i).symm y

/-- A query with its answer. -/
abbrev Entry (α : ι → Type) : Type := Σ q : Qry α, α q.1

/-- A history, oldest entry first. -/
abbrev History (α : ι → Type) : Type := List (Entry α)

/-- The input an entry fixes: the forward query's point, or the inverse query's answer. -/
def Entry.inp : (e : Entry α) → α e.1.1
  | ⟨⟨_, .inl x⟩, _⟩ => x
  | ⟨⟨_, .inr _⟩, a⟩ => a

/-- The output an entry fixes: the forward query's answer, or the inverse query's point. -/
def Entry.out : (e : Entry α) → α e.1.1
  | ⟨⟨_, .inl _⟩, a⟩ => a
  | ⟨⟨_, .inr y⟩, _⟩ => y

section Dec

variable [DecidableEq ι]

/-- The input an entry fixes in component `i`, if it is in component `i`. -/
def Entry.inpAt (i : ι) (e : Entry α) : Option (α i) :=
  if h : e.1.1 = i then some (h ▸ e.inp) else none

/-- The output an entry fixes in component `i`, if it is in component `i`. -/
def Entry.outAt (i : ι) (e : Entry α) : Option (α i) :=
  if h : e.1.1 = i then some (h ▸ e.out) else none

variable [∀ i, DecidableEq (α i)]

/-- The inputs a history fixes in component `i`. -/
def History.dom (h : History α) (i : ι) : Finset (α i) := (h.filterMap (Entry.inpAt i)).toFinset

/-- The outputs a history fixes in component `i`. -/
def History.rng (h : History α) (i : ι) : Finset (α i) := (h.filterMap (Entry.outAt i)).toFinset

/-- A query is **fresh** when the history does not fix its answer. -/
def Fresh (h : History α) : Qry α → Prop
  | ⟨i, .inl x⟩ => x ∉ h.dom i
  | ⟨i, .inr y⟩ => y ∉ h.rng i

end Dec

/-- A deterministic adaptive algorithm: the next query from the history, or `none` to stop. -/
structure Strategy (α : ι → Type) where
  next : History α → Option (Qry α)

/-- The history after `n` steps against `π`. A stopped strategy stays stopped. -/
def Strategy.hist (S : Strategy α) (π : Oracle α) : ℕ → History α
  | 0 => []
  | n + 1 =>
    match S.next (S.hist π n) with
    | none => S.hist π n
    | some q => S.hist π n ++ [⟨q, ans π q⟩]

/-- Step `j` is a fresh query whose answer lands in the target `T (history before j) q`. -/
def Strategy.Hit [DecidableEq ι] [∀ i, DecidableEq (α i)] (S : Strategy α)
    (T : History α → (q : Qry α) → Finset (α q.1)) (j : ℕ) (π : Oracle α) : Prop :=
  ∃ q, S.next (S.hist π j) = some q ∧ Fresh (S.hist π j) q ∧ ans π q ∈ T (S.hist π j) q

/-! #### Entries -/

section Entries

variable [DecidableEq ι] [∀ i, DecidableEq (α i)]

theorem History.mem_dom {h : History α} {i : ι} {x : α i} : x ∈ h.dom i ↔ ∃ e ∈ h, e.inpAt i = some x := by
  simp only [History.dom, List.mem_toFinset, List.mem_filterMap]

theorem History.mem_rng {h : History α} {i : ι} {y : α i} : y ∈ h.rng i ↔ ∃ e ∈ h, e.outAt i = some y := by
  simp only [History.rng, List.mem_toFinset, List.mem_filterMap]

theorem History.card_dom_le (h : History α) (i : ι) : (h.dom i).card ≤ h.length :=
  (List.toFinset_card_le _).trans (List.length_filterMap_le _ _)

theorem History.card_rng_le (h : History α) (i : ι) : (h.rng i).card ≤ h.length :=
  (List.toFinset_card_le _).trans (List.length_filterMap_le _ _)

omit [∀ i, DecidableEq (α i)] in
/-- A consistent entry fixes `π i inp = out` in its component. -/
theorem Entry.outAt_eq_map {π : Oracle α} {e : Entry α} (he : e.2 = ans π e.1) (i : ι) :
    e.outAt i = (e.inpAt i).map (π i) := by
  rcases e with ⟨⟨j, d⟩, a⟩
  by_cases hj : j = i
  · subst hj
    cases d with
    | inl x =>
      simp only [Entry.outAt, Entry.inpAt, dite_true, Option.map_some, Entry.out, Entry.inp]
      exact congrArg some he
    | inr y =>
      simp only [Entry.outAt, Entry.inpAt, dite_true, Option.map_some, Entry.out, Entry.inp]
      change a = (π j).symm y at he
      rw [he, Equiv.apply_symm_apply]
  · simp only [Entry.outAt, Entry.inpAt, hj, dite_false, Option.map_none]

end Entries

/-! #### Histories -/

namespace Strategy

variable (S : Strategy α)

theorem hist_succ_of_none {π : Oracle α} {n : ℕ} (h : S.next (S.hist π n) = none) :
    S.hist π (n + 1) = S.hist π n := by
  simp only [hist, h]

theorem hist_succ_of_some {π : Oracle α} {n : ℕ} {q : Qry α} (h : S.next (S.hist π n) = some q) :
    S.hist π (n + 1) = S.hist π n ++ [⟨q, ans π q⟩] := by
  simp only [hist, h]

theorem hist_prefix_succ (π : Oracle α) (n : ℕ) : S.hist π n <+: S.hist π (n + 1) := by
  cases h : S.next (S.hist π n) with
  | none => rw [S.hist_succ_of_none h]
  | some q => rw [S.hist_succ_of_some h]; exact List.prefix_append _ _

theorem hist_prefix (π : Oracle α) {m n : ℕ} (h : m ≤ n) : S.hist π m <+: S.hist π n := by
  induction n, h using Nat.le_induction with
  | base => exact List.prefix_refl _
  | succ n _ ih => exact ih.trans (S.hist_prefix_succ π n)

theorem hist_length_le (π : Oracle α) (n : ℕ) : (S.hist π n).length ≤ n := by
  induction n with
  | zero => simp [hist]
  | succ n ih =>
    cases h : S.next (S.hist π n) with
    | none => rw [S.hist_succ_of_none h]; omega
    | some q => rw [S.hist_succ_of_some h, List.length_append, List.length_singleton]; omega

theorem mem_hist {π : Oracle α} {n : ℕ} {e : Entry α} (he : e ∈ S.hist π n) : e.2 = ans π e.1 := by
  induction n with
  | zero => simp [hist] at he
  | succ n ih =>
    cases h : S.next (S.hist π n) with
    | none => rw [S.hist_succ_of_none h] at he; exact ih he
    | some q =>
      rw [S.hist_succ_of_some h, List.mem_append, List.mem_singleton] at he
      rcases he with he | rfl
      · exact ih he
      · rfl

/-- If `π'` agrees with `π` on every entry of the history at `n`, the histories agree up to `n`. -/
theorem hist_congr {π π' : Oracle α} {n : ℕ} (h : ∀ e ∈ S.hist π n, ans π' e.1 = e.2) {m : ℕ} (hm : m ≤ n) :
    S.hist π' m = S.hist π m := by
  induction m with
  | zero => rfl
  | succ m ih =>
    have ih := ih (Nat.le_of_succ_le hm)
    cases hq : S.next (S.hist π m) with
    | none =>
      rw [S.hist_succ_of_none hq, S.hist_succ_of_none (by rw [ih]; exact hq), ih]
    | some q =>
      rw [S.hist_succ_of_some hq, S.hist_succ_of_some (by rw [ih]; exact hq), ih]
      have hmem : (⟨q, ans π q⟩ : Entry α) ∈ S.hist π n :=
        (S.hist_prefix π hm).subset (by rw [S.hist_succ_of_some hq]; simp)
      rw [h _ hmem]

variable [DecidableEq ι] [∀ i, DecidableEq (α i)]

/-- Whether step `j < n` hits is fixed by the history at `n`. -/
theorem hit_congr (T : History α → (q : Qry α) → Finset (α q.1)) {π π' : Oracle α} {j n : ℕ} (hj : j < n)
    (h : S.hist π n = S.hist π' n) : S.Hit T j π ↔ S.Hit T j π' := by
  have key : ∀ {π π' : Oracle α}, S.hist π n = S.hist π' n → S.Hit T j π → S.Hit T j π' := by
    intro π π' h ⟨q, hq, hfr, hmem⟩
    have hag : ∀ e ∈ S.hist π n, ans π' e.1 = e.2 := fun e he => by
      rw [h] at he; exact (S.mem_hist he).symm
    have hj' : S.hist π' j = S.hist π j := S.hist_congr hag hj.le
    have hstep : (⟨q, ans π q⟩ : Entry α) ∈ S.hist π n :=
      (S.hist_prefix π (Nat.succ_le_of_lt hj)).subset (by rw [S.hist_succ_of_some hq]; simp)
    have hans : ans π' q = ans π q := hag _ hstep
    exact ⟨q, by rw [hj']; exact hq, by rw [hj']; exact hfr, by rw [hj', hans]; exact hmem⟩
  exact ⟨key h, key h.symm⟩

/-! #### The per-answer bound -/

/-- Arithmetic of one step: from the uniform-fiber count `X·A ≤ t·Y` and the target ratio `t·b ≤ a·N'` with
`N' ≤ A`, get `X·b ≤ a·Y`. -/
private theorem step_arith {X Y A t a b N' : ℕ} (h1 : X * A ≤ t * Y) (h2 : t * b ≤ a * N') (h3 : N' ≤ A)
    (h4 : X ≤ Y) (h5 : A = 0 → Y = 0) : X * b ≤ a * Y := by
  rcases Nat.eq_zero_or_pos A with h0 | hpos
  · have hY := h5 h0
    have hX : X = 0 := Nat.le_zero.1 (hY ▸ h4)
    rw [hX, Nat.zero_mul]; exact Nat.zero_le _
  refine Nat.le_of_mul_le_mul_right ?_ hpos
  calc X * b * A = (X * A) * b := by ring
    _ ≤ (t * Y) * b := Nat.mul_le_mul_right _ h1
    _ = (t * b) * Y := by ring
    _ ≤ (a * N') * Y := Nat.mul_le_mul_right _ h2
    _ ≤ (a * A) * Y := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ h3)
    _ = a * Y * A := by ring

section Swap

variable {π : Oracle α} {h : History α}

/-- Swapping two outputs outside `h.rng i` keeps every consistent entry of `h`. -/
theorem ans_update_swap_out {i : ι} {a a' : α i} (ha : a ∉ h.rng i) (ha' : a' ∉ h.rng i)
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) :
    ∀ e ∈ h, ans (Function.update π i (Equiv.swap a a' * π i)) e.1 = e.2 := by
  intro e he
  have hout : e.outAt i = (e.inpAt i).map (π i) := Entry.outAt_eq_map (hcons e he) i
  rcases e with ⟨⟨j, d⟩, c⟩
  have hc := hcons _ he
  by_cases hj : j = i
  · subst hj
    have hmem : Entry.out (⟨⟨j, d⟩, c⟩ : Entry α) ∈ h.rng j :=
      History.mem_rng.2 ⟨_, he, by simp [Entry.outAt]⟩
    cases d with
    | inl x =>
      change c = π j x at hc
      change (Function.update π j (Equiv.swap a a' * π j)) j x = c
      rw [Function.update_self, Equiv.Perm.mul_apply, ← hc]
      change c ∈ h.rng j at hmem
      exact Equiv.swap_apply_of_ne_of_ne (ne_of_mem_of_not_mem hmem ha) (ne_of_mem_of_not_mem hmem ha')
    | inr y =>
      change c = (π j).symm y at hc
      change ((Function.update π j (Equiv.swap a a' * π j)) j).symm y = c
      change y ∈ h.rng j at hmem
      rw [Function.update_self, hc, Equiv.Perm.mul_def, Equiv.symm_trans_apply, Equiv.symm_swap,
        Equiv.swap_apply_of_ne_of_ne (ne_of_mem_of_not_mem hmem ha) (ne_of_mem_of_not_mem hmem ha')]
  · cases d with
    | inl x =>
      change (Function.update π i (Equiv.swap a a' * π i)) j x = c
      rw [Function.update_of_ne hj]; exact hc.symm
    | inr y =>
      change ((Function.update π i (Equiv.swap a a' * π i)) j).symm y = c
      rw [Function.update_of_ne hj]; exact hc.symm

/-- Swapping two inputs outside `h.dom i` keeps every consistent entry of `h`. -/
theorem ans_update_swap_in {i : ι} {b b' : α i} (hb : b ∉ h.dom i) (hb' : b' ∉ h.dom i)
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) :
    ∀ e ∈ h, ans (Function.update π i (π i * Equiv.swap b b')) e.1 = e.2 := by
  intro e he
  rcases e with ⟨⟨j, d⟩, c⟩
  have hc := hcons _ he
  by_cases hj : j = i
  · subst hj
    have hmem : Entry.inp (⟨⟨j, d⟩, c⟩ : Entry α) ∈ h.dom j :=
      History.mem_dom.2 ⟨_, he, by simp [Entry.inpAt]⟩
    cases d with
    | inl x =>
      change c = π j x at hc
      change (Function.update π j (π j * Equiv.swap b b')) j x = c
      change x ∈ h.dom j at hmem
      rw [Function.update_self, Equiv.Perm.mul_apply,
        Equiv.swap_apply_of_ne_of_ne (ne_of_mem_of_not_mem hmem hb) (ne_of_mem_of_not_mem hmem hb'), hc]
    | inr y =>
      change c = (π j).symm y at hc
      change ((Function.update π j (π j * Equiv.swap b b')) j).symm y = c
      change c ∈ h.dom j at hmem
      rw [Function.update_self, Equiv.Perm.mul_def, Equiv.symm_trans_apply, Equiv.symm_swap, ← hc,
        Equiv.swap_apply_of_ne_of_ne (ne_of_mem_of_not_mem hmem hb) (ne_of_mem_of_not_mem hmem hb')]
  · cases d with
    | inl x =>
      change (Function.update π i (π i * Equiv.swap b b')) j x = c
      rw [Function.update_of_ne hj]; exact hc.symm
    | inr y =>
      change ((Function.update π i (π i * Equiv.swap b b')) j).symm y = c
      rw [Function.update_of_ne hj]; exact hc.symm

/-- A fresh forward answer avoids the fixed outputs. -/
theorem apply_notMem_rng {i : ι} {x : α i} (hx : x ∉ h.dom i) (hcons : ∀ e ∈ h, e.2 = ans π e.1) :
    π i x ∉ h.rng i := by
  intro hm
  obtain ⟨e, he, hout⟩ := History.mem_rng.1 hm
  rw [Entry.outAt_eq_map (hcons e he)] at hout
  obtain ⟨x', hx', hxx'⟩ := Option.map_eq_some_iff.1 hout
  exact hx (History.mem_dom.2 ⟨e, he, by rw [hx', (π i).injective hxx']⟩)

/-- A fresh inverse answer avoids the fixed inputs. -/
theorem symm_apply_notMem_dom {i : ι} {y : α i} (hy : y ∉ h.rng i) (hcons : ∀ e ∈ h, e.2 = ans π e.1) :
    (π i).symm y ∉ h.dom i := by
  intro hm
  obtain ⟨e, he, hin⟩ := History.mem_dom.1 hm
  exact hy (History.mem_rng.2 ⟨e, he, by rw [Entry.outAt_eq_map (hcons e he), hin, Option.map_some,
    Equiv.apply_symm_apply]⟩)

end Swap

theorem update_update_swap_out (π : Oracle α) (i : ι) (a a' : α i) :
    Function.update (Function.update π i (Equiv.swap a a' * π i)) i
      (Equiv.swap a a' * (Function.update π i (Equiv.swap a a' * π i)) i) = π := by
  funext j
  by_cases hj : j = i
  · subst hj; rw [Function.update_self, Function.update_self, Equiv.swap_mul_self_mul]
  · rw [Function.update_of_ne hj, Function.update_of_ne hj]

theorem update_update_swap_in (π : Oracle α) (i : ι) (b b' : α i) :
    Function.update (Function.update π i (π i * Equiv.swap b b')) i
      ((Function.update π i (π i * Equiv.swap b b')) i * Equiv.swap b b') = π := by
  funext j
  by_cases hj : j = i
  · subst hj; rw [Function.update_self, Function.update_self, mul_assoc, Equiv.swap_mul_self, mul_one]
  · rw [Function.update_of_ne hj, Function.update_of_ne hj]

variable [Fintype ι] [∀ i, Fintype (α i)]

open Classical in
/-- **The per-answer bound in one fiber** of the history at step `n`. -/
theorem card_step_fiber (n : ℕ) (F : Oracle α → Prop) (hF : ∀ π π', S.hist π n = S.hist π' n → F π → F π')
    (T : History α → (q : Qry α) → Finset (α q.1)) (a b : ℕ)
    (hT : ∀ h q, (T h q).card * b ≤ a * (Fintype.card (α q.1) - n)) (h : History α) :
    (Finset.univ.filter (fun π => (F π ∧ S.Hit T n π) ∧ S.hist π n = h)).card * b
      ≤ a * (Finset.univ.filter (fun π => F π ∧ S.hist π n = h)).card := by
  set s := Finset.univ.filter (fun π => F π ∧ S.hist π n = h) with hs_def
  have hmem_s : ∀ π, π ∈ s ↔ F π ∧ S.hist π n = h := fun π => by simp [s]
  -- `s` is closed under any `π'` agreeing with `π` on `h`
  have hclosed : ∀ π ∈ s, ∀ π', (∀ e ∈ h, ans π' e.1 = e.2) → π' ∈ s := by
    intro π hπ π' hag
    obtain ⟨hFπ, hπh⟩ := (hmem_s π).1 hπ
    have hh : S.hist π' n = S.hist π n := S.hist_congr (by rw [hπh]; exact hag) le_rfl
    exact (hmem_s π').2 ⟨hF π π' hh.symm hFπ, hh.trans hπh⟩
  have hcons : ∀ π ∈ s, ∀ e ∈ h, e.2 = ans π e.1 := fun π hπ e he => by
    rw [← ((hmem_s π).1 hπ).2] at he; exact S.mem_hist he
  have hlen : s.Nonempty → h.length ≤ n := fun ⟨π, hπ⟩ => ((hmem_s π).1 hπ).2 ▸ S.hist_length_le π n
  cases hq : S.next h with
  | none =>
    have : Finset.univ.filter (fun π => (F π ∧ S.Hit T n π) ∧ S.hist π n = h) = ∅ := by
      refine Finset.filter_false_of_mem (fun π _ ⟨⟨_, q, hq', _⟩, hπh⟩ => ?_)
      rw [hπh, hq] at hq'; exact absurd hq' (by simp)
    rw [this, Finset.card_empty, Nat.zero_mul]; exact Nat.zero_le _
  | some q =>
    by_cases hfr : Fresh h q
    swap
    · have : Finset.univ.filter (fun π => (F π ∧ S.Hit T n π) ∧ S.hist π n = h) = ∅ := by
        refine Finset.filter_false_of_mem (fun π _ ⟨⟨_, q', hq', hfr', _⟩, hπh⟩ => ?_)
        rw [hπh] at hq' hfr'
        rw [hq] at hq'
        rw [Option.some_inj.1 hq'] at hfr
        exact hfr hfr'
      rw [this, Finset.card_empty, Nat.zero_mul]; exact Nat.zero_le _
    have hset : Finset.univ.filter (fun π => (F π ∧ S.Hit T n π) ∧ S.hist π n = h)
        = s.filter (fun π => ans π q ∈ T h q) := by
      ext π
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, s]
      constructor
      · rintro ⟨⟨hFπ, q', hq', _, hmem⟩, hπh⟩
        rw [hπh, hq] at hq'
        rw [hπh, ← Option.some_inj.1 hq'] at hmem
        exact ⟨⟨hFπ, hπh⟩, hmem⟩
      · rintro ⟨⟨hFπ, hπh⟩, hmem⟩
        exact ⟨⟨hFπ, q, by rw [hπh, hq], by rw [hπh]; exact hfr, by rw [hπh]; exact hmem⟩, hπh⟩
    rw [hset]
    rcases s.eq_empty_or_nonempty with hs0 | hne
    · rw [hs0, Finset.filter_empty, Finset.card_empty, Nat.zero_mul]; exact Nat.zero_le _
    have hlen' := hlen hne
    rcases q with ⟨i, x | y⟩
    · -- forward: the answer `π i x` is uniform over the outputs not yet fixed
      change x ∉ h.dom i at hfr
      have hA : ∀ π ∈ s, π i x ∈ (h.rng i)ᶜ := fun π hπ =>
        Finset.mem_compl.2 (apply_notMem_rng hfr (hcons π hπ))
      have heq : ∀ c ∈ (h.rng i)ᶜ, ∀ c' ∈ (h.rng i)ᶜ,
          (s.filter (fun π => π i x = c)).card = (s.filter (fun π => π i x = c')).card := by
        intro c hc c' hc'
        rw [Finset.mem_compl] at hc hc'
        refine card_fiber_eq_of_invol s (fun π => π i x) (fun π => Function.update π i (Equiv.swap c c' * π i))
          (fun π hπ => hclosed π hπ _ (ans_update_swap_out hc hc' (hcons π hπ)))
          (fun π => update_update_swap_out π i c c') ?_ ?_
        · intro π _ h'
          simp only [Function.update_self, Equiv.Perm.mul_apply, h', Equiv.swap_apply_left]
        · intro π _ h'
          simp only [Function.update_self, Equiv.Perm.mul_apply, h', Equiv.swap_apply_right]
      have h1 := card_filter_mem_mul_le s (fun π => π i x) _ (T h ⟨i, .inl x⟩) hA heq
      refine step_arith h1 (hT h ⟨i, .inl x⟩) ?_ (Finset.card_filter_le _ _) ?_
      · rw [Finset.card_compl]
        exact Nat.sub_le_sub_left ((History.card_rng_le h i).trans hlen') _
      · intro h0
        obtain ⟨π, hπ⟩ := hne
        exact absurd (hA π hπ) (by rw [Finset.card_eq_zero.1 h0]; simp)
    · -- inverse: the answer `(π i)⁻¹ y` is uniform over the inputs not yet fixed
      change y ∉ h.rng i at hfr
      have hA : ∀ π ∈ s, (π i).symm y ∈ (h.dom i)ᶜ := fun π hπ =>
        Finset.mem_compl.2 (symm_apply_notMem_dom hfr (hcons π hπ))
      have heq : ∀ c ∈ (h.dom i)ᶜ, ∀ c' ∈ (h.dom i)ᶜ,
          (s.filter (fun π => (π i).symm y = c)).card = (s.filter (fun π => (π i).symm y = c')).card := by
        intro c hc c' hc'
        rw [Finset.mem_compl] at hc hc'
        refine card_fiber_eq_of_invol s (fun π => (π i).symm y) (fun π => Function.update π i (π i * Equiv.swap c c'))
          (fun π hπ => hclosed π hπ _ (ans_update_swap_in hc hc' (hcons π hπ)))
          (fun π => update_update_swap_in π i c c') ?_ ?_
        · intro π _ h'
          simp only [Function.update_self, Equiv.Perm.mul_def, Equiv.symm_trans_apply, Equiv.symm_swap, h',
            Equiv.swap_apply_left]
        · intro π _ h'
          simp only [Function.update_self, Equiv.Perm.mul_def, Equiv.symm_trans_apply, Equiv.symm_swap, h',
            Equiv.swap_apply_right]
      have h1 := card_filter_mem_mul_le s (fun π => (π i).symm y) _ (T h ⟨i, .inr y⟩) hA heq
      refine step_arith h1 (hT h ⟨i, .inr y⟩) ?_ (Finset.card_filter_le _ _) ?_
      · rw [Finset.card_compl]
        exact Nat.sub_le_sub_left ((History.card_dom_le h i).trans hlen') _
      · intro h0
        obtain ⟨π, hπ⟩ := hne
        exact absurd (hA π hπ) (by rw [Finset.card_eq_zero.1 h0]; simp)

open Classical in
/-- **The per-answer bound at step `n`.** For any event `F` fixed by the history at `n`, if every target satisfies
`|T|·b ≤ a·(N_i − n)`, then `|{F ∧ step n hits}|·b ≤ a·|{F}|`. -/
theorem card_step_le (n : ℕ) (F : Oracle α → Prop) (hF : ∀ π π', S.hist π n = S.hist π' n → F π → F π')
    (T : History α → (q : Qry α) → Finset (α q.1)) (a b : ℕ)
    (hT : ∀ h q, (T h q).card * b ≤ a * (Fintype.card (α q.1) - n)) :
    (Finset.univ.filter (fun π => F π ∧ S.Hit T n π)).card * b ≤ a * (Finset.univ.filter F).card := by
  rw [Finset.card_eq_sum_card_fiberwise (s := Finset.univ.filter (fun π => F π ∧ S.Hit T n π))
      (f := fun π => S.hist π n) (t := Finset.univ.image (fun π => S.hist π n))
      (fun π _ => Finset.mem_coe.2 (Finset.mem_image_of_mem _ (Finset.mem_univ _))),
    Finset.card_eq_sum_card_fiberwise (s := Finset.univ.filter F)
      (f := fun π => S.hist π n) (t := Finset.univ.image (fun π => S.hist π n))
      (fun π _ => Finset.mem_coe.2 (Finset.mem_image_of_mem _ (Finset.mem_univ _))),
    Finset.sum_mul, Finset.mul_sum]
  refine Finset.sum_le_sum (fun h _ => ?_)
  rw [Finset.filter_filter, Finset.filter_filter]
  convert S.card_step_fiber n F hF T a b hT h using 3

open Classical in
/-- **The product along the transcript** over a fixed set `J` of named steps: if each step `j ∈ J` has targets with
`|T j|·b j ≤ a j·(N_i − j)`, then `|{every j ∈ J hits}|·∏ b ≤ ∏ a·|Ω|`. -/
theorem card_hits_le (J : Finset ℕ) (T : ℕ → History α → (q : Qry α) → Finset (α q.1)) (a b : ℕ → ℕ)
    (hT : ∀ j ∈ J, ∀ h q, (T j h q).card * b j ≤ a j * (Fintype.card (α q.1) - j)) :
    (Finset.univ.filter (fun π => ∀ j ∈ J, S.Hit (T j) j π)).card * ∏ j ∈ J, b j
      ≤ (∏ j ∈ J, a j) * Fintype.card (Oracle α) := by
  have key : ∀ n, (Finset.univ.filter (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π)).card
      * ∏ j ∈ J.filter (· < n), b j ≤ (∏ j ∈ J.filter (· < n), a j) * Fintype.card (Oracle α) := by
    intro n
    induction n with
    | zero =>
      have h0 : J.filter (· < 0) = ∅ := Finset.filter_false_of_mem (fun j _ => Nat.not_lt_zero j)
      rw [h0, Finset.prod_empty, Finset.prod_empty, Nat.mul_one, Nat.one_mul]
      exact (Finset.card_le_univ _)
    | succ n ih =>
      by_cases hn : n ∈ J
      · have hJ : J.filter (· < n + 1) = insert n (J.filter (· < n)) := by
          ext j
          simp only [Finset.mem_filter, Finset.mem_insert]
          constructor
          · rintro ⟨hj, hlt⟩
            rcases Nat.lt_succ_iff_lt_or_eq.1 hlt with h | h
            · exact Or.inr ⟨hj, h⟩
            · exact Or.inl h
          · rintro (rfl | ⟨hj, hlt⟩)
            · exact ⟨hn, Nat.lt_succ_self _⟩
            · exact ⟨hj, Nat.lt_succ_of_lt hlt⟩
        have hnot : n ∉ J.filter (· < n) := fun h => lt_irrefl n (Finset.mem_filter.1 h).2
        rw [hJ, Finset.prod_insert hnot, Finset.prod_insert hnot]
        have hset : Finset.univ.filter (fun π => ∀ j ∈ J, j < n + 1 → S.Hit (T j) j π)
            = Finset.univ.filter (fun π => (∀ j ∈ J, j < n → S.Hit (T j) j π) ∧ S.Hit (T n) n π) := by
          refine Finset.filter_congr (fun π _ => ⟨fun h => ⟨fun j hj hlt => h j hj (Nat.lt_succ_of_lt hlt),
            h n hn (Nat.lt_succ_self n)⟩, fun ⟨h, hn'⟩ j hj hlt => ?_⟩)
          rcases Nat.lt_succ_iff_lt_or_eq.1 hlt with hlt | rfl
          · exact h j hj hlt
          · exact hn'
        rw [hset]
        have hstep := S.card_step_le n (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π)
          (fun π π' h hF j hj hlt => (S.hit_congr (T j) hlt h).1 (hF j hj hlt)) (T n) (a n) (b n) (hT n hn)
        have hstep' : (Finset.univ.filter (fun π => (∀ j ∈ J, j < n → S.Hit (T j) j π) ∧ S.Hit (T n) n π)).card
            * b n ≤ a n * (Finset.univ.filter (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π)).card := by
          convert hstep using 3 <;> ext <;> simp
        set X := (Finset.univ.filter (fun π => (∀ j ∈ J, j < n → S.Hit (T j) j π) ∧ S.Hit (T n) n π)).card
        set Y := (Finset.univ.filter (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π)).card
        calc X * (b n * ∏ j ∈ J.filter (· < n), b j) = (X * b n) * ∏ j ∈ J.filter (· < n), b j := by ring
          _ ≤ (a n * Y) * ∏ j ∈ J.filter (· < n), b j := Nat.mul_le_mul_right _ hstep'
          _ = a n * (Y * ∏ j ∈ J.filter (· < n), b j) := by ring
          _ ≤ a n * ((∏ j ∈ J.filter (· < n), a j) * Fintype.card (Oracle α)) := Nat.mul_le_mul_left _ ih
          _ = (a n * ∏ j ∈ J.filter (· < n), a j) * Fintype.card (Oracle α) := by ring
      · have hJ : J.filter (· < n + 1) = J.filter (· < n) := by
          refine Finset.filter_congr (fun j hj => ⟨fun hlt => ?_, fun hlt => Nat.lt_succ_of_lt hlt⟩)
          rcases Nat.lt_succ_iff_lt_or_eq.1 hlt with hlt | rfl
          · exact hlt
          · exact absurd hj hn
        have hset : Finset.univ.filter (fun π => ∀ j ∈ J, j < n + 1 → S.Hit (T j) j π)
            = Finset.univ.filter (fun π => ∀ j ∈ J, j < n → S.Hit (T j) j π) := by
          refine Finset.filter_congr (fun π _ => ⟨fun h j hj hlt => h j hj (Nat.lt_succ_of_lt hlt),
            fun h j hj hlt => ?_⟩)
          rcases Nat.lt_succ_iff_lt_or_eq.1 hlt with hlt | rfl
          · exact h j hj hlt
          · exact absurd hj hn
        rw [hJ, hset]
        exact ih
  have hN : ∀ j ∈ J, j < J.sup id + 1 := fun j hj => Nat.lt_succ_of_le (Finset.le_sup (f := id) hj)
  have hJ : J.filter (· < J.sup id + 1) = J := Finset.filter_true_of_mem hN
  have hset : Finset.univ.filter (fun π => ∀ j ∈ J, j < J.sup id + 1 → S.Hit (T j) j π)
      = Finset.univ.filter (fun π => ∀ j ∈ J, S.Hit (T j) j π) :=
    Finset.filter_congr (fun π _ => ⟨fun h j hj => h j hj (hN j hj), fun h j hj _ => h j hj⟩)
  have := key (J.sup id + 1)
  rwa [hJ, hset] at this

/-- **The product bound as a probability**: `prob (every j ∈ J hits) ≤ ∏ a j / b j` (each `b j > 0`). -/
theorem prob_hits_le (J : Finset ℕ) (T : ℕ → History α → (q : Qry α) → Finset (α q.1)) (a b : ℕ → ℕ)
    (hT : ∀ j ∈ J, ∀ h q, (T j h q).card * b j ≤ a j * (Fintype.card (α q.1) - j))
    (hb : ∀ j ∈ J, 0 < b j) :
    prob (fun π => ∀ j ∈ J, S.Hit (T j) j π) ≤ ∏ j ∈ J, ((a j : ℝ≥0∞) / b j) := by
  classical
  have hc := S.card_hits_le J T a b hT
  set X := (Finset.univ.filter (fun π => ∀ j ∈ J, S.Hit (T j) j π)).card
  have hX : prob (fun π => ∀ j ∈ J, S.Hit (T j) j π) = (X : ℝ≥0∞) / Fintype.card (Oracle α) := by
    unfold prob; congr 3; ext π; simp
  rw [hX]
  have hΩ0 : (Fintype.card (Oracle α) : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (Oracle α) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hB0 : ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast (Finset.prod_pos hb).ne'
  have hBt : ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hprod : ∏ j ∈ J, ((a j : ℝ≥0∞) / b j) = ((∏ j ∈ J, a j : ℕ) : ℝ≥0∞) / ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) := by
    simp only [div_eq_mul_inv, Finset.prod_mul_distrib, Nat.cast_prod]
    rw [ENNReal.prod_inv_distrib]
    intro i _ j _ _
    exact Or.inr (ENNReal.natCast_ne_top _)
  rw [hprod, ENNReal.div_le_iff hΩ0 hΩt]
  rw [show ((∏ j ∈ J, a j : ℕ) : ℝ≥0∞) / ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) * (Fintype.card (Oracle α) : ℝ≥0∞)
      = ((∏ j ∈ J, a j : ℕ) : ℝ≥0∞) * (Fintype.card (Oracle α) : ℝ≥0∞) / ((∏ j ∈ J, b j : ℕ) : ℝ≥0∞) by
    rw [div_eq_mul_inv, div_eq_mul_inv]; ring]
  rw [ENNReal.le_div_iff_mul_le (Or.inl hB0) (Or.inl hBt)]
  exact_mod_cast hc

end Strategy

end Oracle

end LazyPerm

end


/-! ════ LazyPermRounds ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Round-by-round strategies (`Strategy.ofRounds`)

Shared library of `bc-a359729a`, requested by `bc-4b3abaed` (`internal/p3-instantiation/proof-technique-decision.md`).
Mathlib only.

Several threads, each a parallel round program (`RProg`, the shape of Pous's `Prog`), run in lockstep for `D` rounds.
In each round every thread's queries are asked, threads in the order of the list `ths`. Then an arbitrary `tail` takes
over (for example the honest labellers). The thread index is any type with decidable equality, such as
`Fin N × Fin n`.

- `ofRounds_next` and `ofRounds_hist`: over the thread phase, the history is the round-by-round sequence `roundsSeq`,
  each query paired with its answer. After it, the tail chooses the queries.
- `roundsSeq_eq`: `roundsSeq` is, round by round and thread by thread, each thread's round-`ρ` queries.
- `RProg.roundQs_eq_trace`: a thread's round-`ρ` queries are its `trace` entries at round `ρ`.
-/

namespace LazyPerm

/-- A parallel round program over queries `Q` and answers `A`: Pous's `Prog` with `M.Qry = Q`, `M.Ans = A`. -/
inductive RProg (Q A X : Type) where
  | ret : X → RProg Q A X
  | round : List Q → (List A → RProg Q A X) → RProg Q A X

namespace RProg

variable {Q A X : Type}

/-- The queries on the path taken when queries are answered by `f`, each with its round (from 0). -/
def trace (f : Q → A) : RProg Q A X → List (ℕ × Q)
  | ret _ => []
  | round qs k => qs.map (fun x => (0, x)) ++ (trace f (k (qs.map f))).map fun e => (e.1 + 1, e.2)

/-- The current round's queries. -/
def qs : RProg Q A X → List Q
  | ret _ => []
  | round qs _ => qs

/-- Continue on one round of answers. -/
def feed : RProg Q A X → List A → RProg Q A X
  | ret x, _ => ret x
  | round _ k, as => k as

/-- The program after `ρ` rounds answered by `f`. -/
def after (f : Q → A) : ℕ → RProg Q A X → RProg Q A X
  | 0, P => P
  | ρ + 1, P => after f ρ (P.feed (P.qs.map f))

/-- The queries of round `ρ` when queries are answered by `f`. -/
def roundQs (f : Q → A) (P : RProg Q A X) (ρ : ℕ) : List Q := (P.after f ρ).qs

theorem roundQs_zero (f : Q → A) (P : RProg Q A X) : P.roundQs f 0 = P.qs := rfl

theorem roundQs_succ (f : Q → A) (P : RProg Q A X) (ρ : ℕ) :
    P.roundQs f (ρ + 1) = (P.feed (P.qs.map f)).roundQs f ρ := rfl

/-- **A thread's round-`ρ` queries are its `trace` entries at round `ρ`**, in order. -/
theorem roundQs_eq_trace (f : Q → A) (P : RProg Q A X) (ρ : ℕ) :
    P.roundQs f ρ = (P.trace f).filterMap (fun e => if e.1 = ρ then some e.2 else none) := by
  induction P generalizing ρ with
  | ret x =>
    have h : ∀ ρ, (ret x : RProg Q A X).roundQs f ρ = [] := by
      intro ρ
      induction ρ with
      | zero => rfl
      | succ ρ ih => exact ih
    rw [h]; rfl
  | round qs k ih =>
    cases ρ with
    | zero =>
      simp only [roundQs, after, RProg.qs, trace, List.filterMap_append, List.filterMap_map]
      have h1 : List.filterMap ((fun e : ℕ × Q => if e.1 = 0 then some e.2 else none) ∘ fun x => (0, x)) qs = qs := by
        rw [show ((fun e : ℕ × Q => if e.1 = 0 then some e.2 else none) ∘ fun x => (0, x)) = some from rfl,
          List.filterMap_some]
      have h2 : List.filterMap ((fun e : ℕ × Q => if e.1 = 0 then some e.2 else none) ∘ fun e => (e.1 + 1, e.2))
          (trace f (k (qs.map f))) = [] := by
        rw [List.filterMap_eq_nil_iff]
        intro e _
        simp
      rw [h1, h2, List.append_nil]
    | succ ρ =>
      rw [roundQs_succ]
      simp only [RProg.qs, feed, trace, List.filterMap_append, List.filterMap_map]
      have h1 : List.filterMap ((fun e : ℕ × Q => if e.1 = ρ + 1 then some e.2 else none) ∘ fun x => (0, x)) qs
          = [] := by
        rw [List.filterMap_eq_nil_iff]
        intro e _
        simp
      rw [h1, List.nil_append, ih]
      congr 1
      funext e
      simp only [Function.comp_apply, Nat.add_right_cancel_iff]

end RProg

section Rounds

variable {θ Q A X : Type} [DecidableEq θ]

/-- One global round: every thread's current queries, threads in `ths` order. -/
def roundList (ths : List θ) (cur : θ → RProg Q A X) : List Q := ths.flatMap fun t => (cur t).qs

/-- Feed a flat list of answers, given in `roundList` order: each thread continues on its own chunk. -/
def feedAll : List θ → (θ → RProg Q A X) → List A → (θ → RProg Q A X)
  | [], cur, _ => cur
  | t :: ts, cur, as =>
    feedAll ts (Function.update cur t ((cur t).feed (as.take (cur t).qs.length))) (as.drop (cur t).qs.length)

/-- The next thread query, given the answers so far (flat, in schedule order), within `D` rounds. -/
def schedNext (ths : List θ) : ℕ → (θ → RProg Q A X) → List A → Option Q
  | 0, _, _ => none
  | D + 1, cur, as =>
    if as.length < (roundList ths cur).length then (roundList ths cur)[as.length]?
    else schedNext ths D (feedAll ths cur (as.take (roundList ths cur).length))
      (as.drop (roundList ths cur).length)

/-- The thread queries of `D` rounds when queries are answered by `f`, in schedule order. -/
def roundsSeq (ths : List θ) (f : Q → A) : ℕ → (θ → RProg Q A X) → List Q
  | 0, _ => []
  | D + 1, cur => roundList ths cur ++ roundsSeq ths f D (feedAll ths cur ((roundList ths cur).map f))

variable {ι : Type} {α : ι → Type}

/-- **Round-by-round strategy.** The threads `P t` (`t ∈ ths`) run for `D` rounds. Each query `q : Q` is asked as
`enc q`, and each answer is read back through `dec`. Then `tail` chooses the queries. -/
def Strategy.ofRounds (ths : List θ) (D : ℕ) (P : θ → RProg Q A X) (enc : Q → Qry α) (dec : Entry α → A)
    (tail : History α → Option (Qry α)) : Strategy α where
  next h := match schedNext ths D P (h.map dec) with
    | some q => some (enc q)
    | none => tail h

/-! #### The schedule follows `roundsSeq` -/

theorem feedAll_apply {ths : List θ} (hnd : ths.Nodup) (cur : θ → RProg Q A X) (f : Q → A) (t : θ) :
    feedAll ths cur ((roundList ths cur).map f) t
      = if t ∈ ths then (cur t).feed ((cur t).qs.map f) else cur t := by
  induction ths generalizing cur with
  | nil => simp [feedAll]
  | cons u us ih =>
    rw [List.nodup_cons] at hnd
    simp only [feedAll, roundList, List.flatMap_cons, List.map_append]
    rw [List.take_left' (by rw [List.length_map]), List.drop_left' (by rw [List.length_map])]
    have hrl : us.flatMap (fun t => (Function.update cur u ((cur u).feed ((cur u).qs.map f)) t).qs)
        = us.flatMap (fun t => (cur t).qs) :=
      List.flatMap_congr (fun t ht => by rw [Function.update_of_ne (ne_of_mem_of_not_mem ht hnd.1)])
    have := ih hnd.2 (Function.update cur u ((cur u).feed ((cur u).qs.map f)))
    simp only [roundList] at this
    rw [hrl] at this
    rw [this]
    by_cases htu : t = u
    · subst htu
      simp [hnd.1]
    · simp only [Function.update_of_ne htu, List.mem_cons, htu, false_or]

theorem schedNext_roundsSeq (ths : List θ) (f : Q → A) :
    ∀ (D : ℕ) (cur : θ → RProg Q A X) (n : ℕ), n < (roundsSeq ths f D cur).length →
      schedNext ths D cur (((roundsSeq ths f D cur).take n).map f) = (roundsSeq ths f D cur)[n]? := by
  intro D
  induction D with
  | zero => intro cur n hn; simp [roundsSeq] at hn
  | succ D ih =>
    intro cur n hn
    simp only [roundsSeq] at hn ⊢
    rw [schedNext]
    have ih' := ih (feedAll ths cur ((roundList ths cur).map f))
    generalize roundsSeq ths f D (feedAll ths cur ((roundList ths cur).map f)) = rest at hn ih' ⊢
    generalize roundList ths cur = L at hn ih' ⊢
    rw [List.length_append] at hn
    by_cases hnL : n < L.length
    · have hlen : (((L ++ rest).take n).map f).length = n := by
        rw [List.length_map, List.length_take, List.length_append]; omega
      rw [ite_eq_left (by rw [hlen]; exact hnL), hlen, List.getElem?_append_left hnL]
    · push Not at hnL
      have hlen : (((L ++ rest).take n).map f).length = n := by
        rw [List.length_map, List.length_take, List.length_append]; omega
      rw [ite_eq_right (by rw [hlen]; omega)]
      have htake : (((L ++ rest).take n).map f).take L.length = L.map f := by
        rw [← List.map_take, List.take_take, min_eq_left hnL, List.take_left' rfl]
      have hdrop : (((L ++ rest).take n).map f).drop L.length = (rest.take (n - L.length)).map f := by
        rw [← List.map_drop, List.drop_take, List.drop_left' rfl]
      rw [htake, hdrop, ih' (n - L.length) (by omega), List.getElem?_append_right hnL]

theorem schedNext_roundsSeq_append (ths : List θ) (f : Q → A) :
    ∀ (D : ℕ) (cur : θ → RProg Q A X) (extra : List A),
      schedNext ths D cur ((roundsSeq ths f D cur).map f ++ extra) = none := by
  intro D
  induction D with
  | zero => intro cur extra; rfl
  | succ D ih =>
    intro cur extra
    simp only [roundsSeq]
    rw [schedNext]
    set L := roundList ths cur
    set rest := roundsSeq ths f D (feedAll ths cur (L.map f))
    have hlen : L.length ≤ ((L ++ rest).map f ++ extra).length := by
      simp only [List.length_append, List.length_map]; omega
    rw [ite_eq_right (by omega)]
    have htake : ((L ++ rest).map f ++ extra).take L.length = L.map f := by
      rw [List.map_append, List.append_assoc, List.take_left' (List.length_map _)]
    have hdrop : ((L ++ rest).map f ++ extra).drop L.length = rest.map f ++ extra := by
      rw [List.map_append, List.append_assoc, List.drop_left' (List.length_map _)]
    rw [htake, hdrop]
    exact ih _ extra

/-- The entry a query makes against `π`. -/
def qEntry (π : Oracle α) (enc : Q → Qry α) (q : Q) : Entry α := ⟨enc q, ans π (enc q)⟩

namespace Strategy

variable (ths : List θ) (D : ℕ) (P : θ → RProg Q A X) (enc : Q → Qry α) (dec : Entry α → A)
  (tail : History α → Option (Qry α))

/-- **The thread phase.** With `f q = dec (enc q, its answer)`, the history after `n` steps, for `n` up to the length
of `roundsSeq`, is the first `n` queries of `roundsSeq`, each with its answer. -/
theorem ofRounds_hist (π : Oracle α) :
    ∀ n ≤ (roundsSeq ths (fun q => dec (qEntry π enc q)) D P).length,
      (ofRounds ths D P enc dec tail).hist π n
        = ((roundsSeq ths (fun q => dec (qEntry π enc q)) D P).take n).map (qEntry π enc) := by
  intro n
  induction n with
  | zero => intro _; rfl
  | succ n ih =>
    intro hn
    set R := roundsSeq ths (fun q => dec (qEntry π enc q)) D P
    have ihn := ih (Nat.le_of_succ_le hn)
    have hnext : (ofRounds ths D P enc dec tail).next ((ofRounds ths D P enc dec tail).hist π n)
        = some (enc R[n]) := by
      rw [ihn]
      show (match schedNext ths D P (((R.take n).map (qEntry π enc)).map dec) with
        | some q => some (enc q) | none => tail _) = _
      rw [List.map_map]
      have := schedNext_roundsSeq ths (fun q => dec (qEntry π enc q)) D P n hn
      rw [show (dec ∘ qEntry π enc) = (fun q => dec (qEntry π enc q)) from rfl, this, List.getElem?_eq_getElem hn]
    rw [hist_succ_of_some _ hnext, ihn, List.take_add_one, List.map_append, List.getElem?_eq_getElem hn]
    rfl

/-- The strategy's query at step `n` of the thread phase is `enc` of the `n`-th query of `roundsSeq`. -/
theorem ofRounds_next (π : Oracle α) {n : ℕ} (hn : n < (roundsSeq ths (fun q => dec (qEntry π enc q)) D P).length) :
    (ofRounds ths D P enc dec tail).next ((ofRounds ths D P enc dec tail).hist π n)
      = some (enc (roundsSeq ths (fun q => dec (qEntry π enc q)) D P)[n]) := by
  rw [ofRounds_hist ths D P enc dec tail π n hn.le]
  show (match schedNext ths D P ((((roundsSeq ths _ D P).take n).map (qEntry π enc)).map dec) with
    | some q => some (enc q) | none => tail _) = _
  rw [List.map_map]
  rw [show (dec ∘ qEntry π enc) = (fun q => dec (qEntry π enc q)) from rfl,
    schedNext_roundsSeq ths (fun q => dec (qEntry π enc q)) D P n hn, List.getElem?_eq_getElem hn]

/-- **After the thread phase** the tail chooses the queries, whatever it has added. -/
theorem ofRounds_next_tail (π : Oracle α) (h : History α)
    (hpre : (roundsSeq ths (fun q => dec (qEntry π enc q)) D P).map (qEntry π enc) <+: h) :
    (ofRounds ths D P enc dec tail).next h = tail h := by
  obtain ⟨extra, rfl⟩ := hpre
  show (match schedNext ths D P ((((roundsSeq ths _ D P).map (qEntry π enc)) ++ extra).map dec) with
    | some q => some (enc q) | none => tail _) = _
  rw [List.map_append, List.map_map,
    show (dec ∘ qEntry π enc) = (fun q => dec (qEntry π enc q)) from rfl,
    schedNext_roundsSeq_append ths (fun q => dec (qEntry π enc q)) D P]

end Strategy

/-- **Where each thread's round-`ρ` queries sit.** `roundsSeq` lists, for `ρ = 0, …, D−1` and within a round for `t`
in `ths` order, thread `t`'s round-`ρ` queries (`RProg.roundQs_eq_trace`: its trace entries at round `ρ`). -/
theorem roundsSeq_eq {ths : List θ} (hnd : ths.Nodup) (f : Q → A) :
    ∀ (D : ℕ) (cur : θ → RProg Q A X),
      roundsSeq ths f D cur = (List.range D).flatMap (fun ρ => ths.flatMap (fun t => (cur t).roundQs f ρ)) := by
  intro D
  induction D with
  | zero => intro cur; rfl
  | succ D ih =>
    intro cur
    rw [roundsSeq, ih, List.range_succ_eq_map, List.flatMap_cons, List.flatMap_map]
    congr 1
    refine List.flatMap_congr (fun ρ _ => List.flatMap_congr (fun t ht => ?_))
    rw [feedAll_apply hnd cur f t, ite_eq_left ht]
    rfl

end Rounds

end LazyPerm

end


/-! ════ P3Concrete.P3ChainLazy ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# P3's chain model as a `lazy-perm` strategy

The one-segment adversary and the honest labeller, as one `LazyPerm.Strategy` over a family of permutations. This is
the P3 side of `proof-technique-decision.md`; it does not depend on the bridge's signature.

**The family** (`P3Idx`, `P3Alpha`). The components are indexed by `Tweak n ⊕ Unit`: `P_T` on labels at `inl T`, and
`Π₂` on states at `inr ()`. `omegaEquiv : P3COmega ≃ Oracle P3Alpha`, and `pr_transport` / `pr_transport'` move
probabilities across it (`prob_congr`).

**Queries** (`enc`, `dec`). `enc` sends `p3ChainModel`'s four query forms to the family, and `dec` puts an answer back
into `Bits ⊕ Lab`. `dec_qEntry`: decoding the lazy answer is the model's answer.

**The threads.** `toRProg` converts a `Prog`, and `trace_toRProg` says its trace is `P3Trace`'s. So `tr_lazy`: under the
equivalence, a thread's lazy trace is `P3Replay.tr`.

**The labeller tail** (`labProg`, `tail`). The honest computation is a program: lower rows in order, each one chain of
forward `Π₂` queries (its parents newest first, then the pad) and one forward `P` query; then the top rows, on the
lower labels.
- The tail replays `labProg` against the history's answers (`ansOf`), and asks the first query the history has not
  answered.
- So after the threads, the strategy asks the labeller's queries in order. The later answers extend the replay.

**The strategy** (`strategy`). `Strategy.ofRounds` over the given threads, for `D` rounds, with `enc`/`dec`, and then
the labeller tail. The program index is any type (`Fin n` for one segment, `Fin N × Fin n` in lock-step).
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge
open scoped ENNReal

noncomputable section

/-! ## The family of permutations -/

section Family

variable (n wc : ℕ)

/-- The component index: `P`'s tweaks, and `Π₂`. -/
abbrev P3Idx : Type := Tweak n ⊕ Unit

/-- The component types: labels for a tweak, `Π₂` states for `()`. -/
abbrev P3Alpha : P3Idx n → Type :=
  fun i => Sum.elim (fun _ => Lab n wc) (fun _ => Bits (n * wc + (n * wc + 512))) i

instance instFintypeAlpha (i : P3Idx n) : Fintype (P3Alpha n wc i) :=
  match i with
  | .inl _ => inferInstanceAs (Fintype (Lab n wc))
  | .inr _ => inferInstanceAs (Fintype (Bits (n * wc + (n * wc + 512))))

instance instDecEqAlpha (i : P3Idx n) : DecidableEq (P3Alpha n wc i) :=
  match i with
  | .inl _ => inferInstanceAs (DecidableEq (Lab n wc))
  | .inr _ => inferInstanceAs (DecidableEq (Bits (n * wc + (n * wc + 512))))

instance instInhabitedAlpha (i : P3Idx n) : Inhabited (P3Alpha n wc i) :=
  match i with
  | .inl _ => ⟨fun _ _ => false⟩
  | .inr _ => ⟨fun _ => false⟩

/-- **The primitives as a family of permutations.** -/
def omegaEquiv : P3COmega n wc ≃ LazyPerm.Oracle (P3Alpha n wc) where
  toFun ω := fun i => match i with
    | .inl T => ω.1 T
    | .inr () => ω.2
  invFun o := (fun T => o (.inl T), o (.inr ()))
  left_inv _ := rfl
  right_inv o := by
    funext i
    rcases i with T | ⟨⟩ <;> rfl

theorem pr_eq_prob {Ω : Type} [Fintype Ω] (E : Ω → Prop) : pr E = LazyPerm.prob E := rfl

/-- **Probabilities move to the lazy family.** -/
theorem pr_transport (E : LazyPerm.Oracle (P3Alpha n wc) → Prop) :
    pr (fun ω : P3COmega n wc => E (omegaEquiv n wc ω)) = LazyPerm.prob E := by
  rw [pr_eq_prob]
  exact LazyPerm.prob_congr (omegaEquiv n wc) E

/-- **Probabilities over `P3COmega` are probabilities over the lazy family.** -/
theorem pr_transport' (F : P3COmega n wc → Prop) :
    pr F = LazyPerm.prob fun o => F ((omegaEquiv n wc).symm o) := by
  rw [← pr_transport]
  simp only [Equiv.symm_apply_apply]

end Family

/-! ## Queries -/

section Queries

variable (n wc : ℕ)

/-- `p3ChainModel`'s queries in the family. -/
def enc : (p3ChainModel n wc).Qry → LazyPerm.Qry (P3Alpha n wc)
  | .inl (.inl x) => ⟨.inr (), .inl x⟩
  | .inl (.inr y) => ⟨.inr (), .inr y⟩
  | .inr (T, .inl a) => ⟨.inl T, .inl a⟩
  | .inr (T, .inr z) => ⟨.inl T, .inr z⟩

/-- A lazy answer, back in `p3ChainModel`'s answer type. -/
def dec : LazyPerm.Entry (P3Alpha n wc) → (p3ChainModel n wc).Ans
  | ⟨⟨.inl _, _⟩, a⟩ => .inr a
  | ⟨⟨.inr _, _⟩, a⟩ => .inl a

/-- **Decoding the lazy answer is the model's answer.** -/
theorem dec_qEntry (ω : P3COmega n wc) (q : (p3ChainModel n wc).Qry) :
    dec n wc (LazyPerm.qEntry (omegaEquiv n wc ω) (enc n wc) q) = (p3ChainModel n wc).answer ω q := by
  rcases q with (x | y) | ⟨T, a | z⟩ <;> rfl

end Queries

/-! ## Threads -/

/-- A `Prog` as a lazy round program. -/
def toRProg {M : IdealModel} {X : Type} : Prog M X → LazyPerm.RProg M.Qry M.Ans X
  | .ret x => .ret x
  | .round qs k => .round qs (fun as => toRProg (k as))

theorem trace_toRProg {M : IdealModel} {X : Type} (f : M.Qry → M.Ans) (P : Prog M X) :
    (toRProg P).trace f = Tr.trace f P := by
  induction P with
  | ret x => rfl
  | round qs k ih => simp [toRProg, LazyPerm.RProg.trace, Tr.trace, ih]

/-- **Under the equivalence, a thread's lazy trace is its transcript.** -/
theorem tr_lazy {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) (ω : P3COmega n wc) (i : ι) :
    (toRProg (R.A i)).trace (fun q => dec n wc (LazyPerm.qEntry (omegaEquiv n wc ω) (enc n wc) q)) = R.tr ω i := by
  rw [trace_toRProg]
  have : (fun q => dec n wc (LazyPerm.qEntry (omegaEquiv n wc ω) (enc n wc) q)) = (p3ChainModel n wc).answer ω :=
    funext (dec_qEntry n wc ω)
  rw [this]
  rfl

/-! ## The honest labeller as a program -/

section Labeller

variable {n wc : ℕ}

/-- Sequencing programs. -/
def pbind {M : IdealModel} {X Y : Type} : Prog M X → (X → Prog M Y) → Prog M Y
  | .ret x, g => g x
  | .round qs k, g => .round qs fun as => pbind (k as) g

/-- One forward `Π₂` query. -/
def p2Fwd (x : Bits (n * wc + (n * wc + 512))) : Prog (p3ChainModel n wc) (Bits (n * wc + (n * wc + 512))) :=
  .round [.inl (.inl x)] fun as => .ret (match as.headD (.inl x) with
    | .inl y => y
    | .inr _ => x)

/-- One forward `P_T` query. -/
def pFwd (T : Tweak n) (a : Lab n wc) : Prog (p3ChainModel n wc) (Lab n wc) :=
  .round [.inr (T, .inl a)] fun as => .ret (match as.headD (.inr a) with
    | .inr c => c
    | .inl _ => a)

/-- An overwrite chain from `h`, one forward `Π₂` query per block; returns the last dropped part (the key). -/
def chainProg (h : Bits (n * wc + 512)) (r : Bits (n * wc)) :
    List (Bits (n * wc)) → Prog (p3ChainModel n wc) (Bits (n * wc))
  | [] => .ret r
  | b :: bs => pbind (p2Fwd (Fin.append b h)) fun y => chainProg (ovH y) (ovR y) bs

/-- A row: its chain from its IV over `labs`' parents, then the forward `P` query on `pinOf key`. -/
def rowProg (tag : Bits 256) (G : TopoDAG n) (L : Fin 2) (v : Fin n) (labs : Fin n → Lab n wc)
    (pinOf : Lab n wc → Lab n wc) : Prog (p3ChainModel n wc) (Lab n wc) :=
  pbind (chainProg (iv (domP3 tag L v)) (fun _ => false) (rowBlocks labs G v)) fun r =>
    pFwd (tag, L, v) (pinOf ((codeEquiv n wc).symm r))

/-- A layer, rows `k, k+1, …, n − 1` in order, accumulating the labels. -/
def layerProg (tag : Bits 256) (G : TopoDAG n) (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc) :
    (k : ℕ) → (Fin n → Lab n wc) → Prog (p3ChainModel n wc) (Fin n → Lab n wc)
  | k, acc =>
    if hk : k < n then
      pbind (rowProg tag G L ⟨k, hk⟩ acc (pinOf ⟨k, hk⟩)) fun c =>
        layerProg tag G L pinOf (k + 1) (Function.update acc ⟨k, hk⟩ c)
    else .ret acc
  termination_by k => n - k

/-- **`layerProg`'s unfolding equation.** Stating it here generates `layerProg.eq_1` and `layerProg.eq_def` in this
module, so modules that import it and `rw [layerProg]` reuse them instead of generating their own. -/
theorem layerProg_eq (tag : Bits 256) (G : TopoDAG n) (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc) (k : ℕ)
    (acc : Fin n → Lab n wc) :
    layerProg tag G L pinOf k acc =
      if hk : k < n then
        pbind (rowProg tag G L ⟨k, hk⟩ acc (pinOf ⟨k, hk⟩)) fun c =>
          layerProg tag G L pinOf (k + 1) (Function.update acc ⟨k, hk⟩ c)
      else .ret acc :=
  layerProg.eq_1 tag G L pinOf k acc

theorem layerProg_eq_def (tag : Bits 256) (G : TopoDAG n) (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc)
    (k : ℕ) (acc : Fin n → Lab n wc) :
    layerProg tag G L pinOf k acc =
      if hk : k < n then
        pbind (rowProg tag G L ⟨k, hk⟩ acc (pinOf ⟨k, hk⟩)) fun c =>
          layerProg tag G L pinOf (k + 1) (Function.update acc ⟨k, hk⟩ c)
      else .ret acc :=
  layerProg.eq_def tag G L pinOf k acc

/-- **The honest labeller**: the lower layer (`pin1 = W ⊕ key¹`), then the top layer (`pin2 = transpose(c¹) ⊕ key²`). -/
def labProg (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc) : Prog (p3ChainModel n wc) Unit :=
  pbind (layerProg tag G 0 (fun v key => labXor (W v) key) 0 fun _ _ _ => false) fun c1 =>
    pbind (layerProg tag G 1 (fun v key => labXor (transpose c1 v) key) 0 fun _ _ _ => false) fun _ => .ret ()

end Labeller

/-! ## The tail and the strategy -/

section Strategy

variable {n wc : ℕ}

/-- The answer the history gives to a query, if it holds that query. -/
def histAns (h : LazyPerm.History (P3Alpha n wc)) (q : LazyPerm.Qry (P3Alpha n wc)) : Option (P3Alpha n wc q.1) :=
  h.findSome? fun e => if hq : e.1 = q then some (hq ▸ e.2) else none

/-- A model answer read off the history (a default when absent). -/
def ansOf (h : LazyPerm.History (P3Alpha n wc)) (q : (p3ChainModel n wc).Qry) : (p3ChainModel n wc).Ans :=
  dec n wc ⟨enc n wc q, (histAns h (enc n wc q)).getD default⟩

/-- **The labeller tail**: replay the labeller against the history, and ask its first query the history lacks. -/
def tail (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc) (h : LazyPerm.History (P3Alpha n wc)) :
    Option (LazyPerm.Qry (P3Alpha n wc)) :=
  (((Tr.trace (ansOf h) (labProg tag G W)).map Prod.snd).find? fun q => (histAns h (enc n wc q)).isNone).map
    (enc n wc)

/-- **One segment's lazy strategy**: the threads `ths` round by round for `D` rounds, then the labeller. -/
def strategy {ι : Type} [DecidableEq ι] (R : P3Replay n wc ι) (ths : List ι) : LazyPerm.Strategy (P3Alpha n wc) :=
  LazyPerm.Strategy.ofRounds ths R.D (fun i => toRProg (R.A i)) (enc n wc) (dec n wc) (tail R.tag R.G R.W)

end Strategy

end

end Pous.P3Concrete

end


/-! ════ P3ConcreteMulti.JointLazy ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The 14 GB store as one lazy-perm strategy

The joint counterpart of bc-58ec406e's `P3ChainLazy.strategy`: one fixed family of `N·n` programs, then all `N`
segments' honest labellers, as one `LazyPerm.Strategy` over the same family of permutations (`P3Alpha`: `P` per tweak,
and `Π₂`). Cross-segment queries are just more of the strategy's queries.

- **The threads** (`jointThreads`): every program `(s, v)`, segment by segment, run round by round for `D` rounds by
  `Strategy.ofRounds` (`Fin N × Fin n` is the thread index).
- **The labeller tail** (`tailOf (labProgJ tags G W)`): the `N` segments' labellers `labProg (tags s) G (W s)` in
  segment order, replayed against the history's answers. `tailOf` is bc-58ec406e's `tail` for any program
  (`tail_eq_tailOf`, `rfl`).
- **At `N = 1`** the joint strategy is the one-segment strategy's shape: one segment's threads, then its labeller.
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

noncomputable section

variable {N n wc : ℕ}

/-- The labellers of the segments in `ss`, in order. -/
def segsProg (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) :
    List (Fin N) → Prog (p3ChainModel n wc) Unit
  | [] => .ret ()
  | s :: ss => pbind (labProg (tags s) G (W s)) fun _ => segsProg tags G W ss

/-- **All segments' honest labellers**, in segment order. -/
def labProgJ (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) : Prog (p3ChainModel n wc) Unit :=
  segsProg tags G W (List.finRange N)

/-- **A labeller tail for any program**: replay `p` against the history, and ask its first query the history lacks. -/
def tailOf (p : Prog (p3ChainModel n wc) Unit) (h : LazyPerm.History (P3Alpha n wc)) :
    Option (LazyPerm.Qry (P3Alpha n wc)) :=
  (((Tr.trace (ansOf h) p).map Prod.snd).find? fun q => (histAns h (enc n wc q)).isNone).map (enc n wc)

/-- bc-58ec406e's one-segment tail is `tailOf` of its labeller. -/
theorem tail_eq_tailOf (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc) :
    tail tag G W = tailOf (labProg tag G W) := rfl

/-- **The joint threads**: every program `(s, v)`, segment by segment. -/
def jointThreads (N n : ℕ) : List (Fin N × Fin n) := List.finRange N ×ˢ List.finRange n

theorem jointThreads_nodup : (jointThreads N n).Nodup :=
  (List.nodup_finRange N).product (List.nodup_finRange n)

theorem mem_jointThreads (i : Fin N × Fin n) : i ∈ jointThreads N n :=
  List.mem_product.2 ⟨List.mem_finRange _, List.mem_finRange _⟩

/-- **The 14 GB store's lazy strategy**: the `N·n` programs round by round for `D` rounds, then all `N` labellers. -/
def jointStrategy (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D : ℕ) : LazyPerm.Strategy (P3Alpha n wc) :=
  LazyPerm.Strategy.ofRounds (jointThreads N n) D (fun i => toRProg (A i.1 i.2)) (enc n wc) (dec n wc)
    (tailOf (labProgJ tags G W))

/-- **The thread phase**: the history is the programs' queries round by round, each with its answer. -/
theorem jointStrategy_hist (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D : ℕ) (π : LazyPerm.Oracle (P3Alpha n wc)) (k : ℕ)
    (hk : k ≤ (LazyPerm.roundsSeq (jointThreads N n) (fun q => dec n wc (LazyPerm.qEntry π (enc n wc) q)) D
      (fun i => toRProg (A i.1 i.2))).length) :
    (jointStrategy A tags G W D).hist π k =
      ((LazyPerm.roundsSeq (jointThreads N n) (fun q => dec n wc (LazyPerm.qEntry π (enc n wc) q)) D
        (fun i => toRProg (A i.1 i.2))).take k).map (LazyPerm.qEntry π (enc n wc)) :=
  LazyPerm.Strategy.ofRounds_hist _ _ _ _ _ _ π k hk

/-- **Where each program's round-`ρ` queries sit** in the thread phase: round by round, and within a round segment
by segment, program by program. -/
theorem jointStrategy_roundsSeq (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (D : ℕ)
    (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) :
    LazyPerm.roundsSeq (jointThreads N n) f D (fun i => toRProg (A i.1 i.2)) =
      (List.range D).flatMap fun ρ => (jointThreads N n).flatMap fun i => (toRProg (A i.1 i.2)).roundQs f ρ :=
  LazyPerm.roundsSeq_eq jointThreads_nodup f D _

end

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.JointSteps ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Every named step is below `N·nPosC`: the step count of the joint strategy

The client obligation `h_lt` of the bridge, for **any** item design: a named step is one where the strategy asks a
query (`h_fresh`), and the joint strategy asks at most `N·nPosC` queries in all.

- **Strategies** (`hist_length_of_next`, `step_lt_of_length_le`): if step `j` asks a query, the history at `j` has
  length `j`; so a bound on the history's length bounds the named steps.
- **The labeller tail, for any program `p`** (`tailOf_some`, `ofRounds_tailOf_length_le`). The tail asks the first
  query of `p`'s replay that the history lacks. By transcript stability (`Tr.trace_stable`) that query is on `p`'s
  **true** trace, and it is new. So after the thread phase the tail adds distinct true-trace queries, and the history
  has at most `|roundsSeq| + work(p)` entries. This covers bc-58ec406e's one-segment tail (`tail = tailOf (labProg …)`).
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete LazyPerm
open scoped ENNReal

noncomputable section

/-! ## Strategies: steps and history lengths -/

section Steps

variable {ι : Type} {α : ι → Type} (S : Strategy α) (π : Oracle α)

/-- Once the strategy stops, its history stays. -/
theorem hist_stuck {k : ℕ} (h : S.next (S.hist π k) = none) : ∀ j, k ≤ j → S.hist π j = S.hist π k := by
  intro j hj
  induction j, hj using Nat.le_induction with
  | base => rfl
  | succ j _ ih => rw [S.hist_succ_of_none (by rw [ih]; exact h), ih]

/-- **If step `j` asks a query, the history at `j` has length `j`.** -/
theorem hist_length_of_next {j : ℕ} {q : Qry α} (h : S.next (S.hist π j) = some q) : (S.hist π j).length = j := by
  have hall : ∀ k < j, ∃ q', S.next (S.hist π k) = some q' := by
    intro k hk
    cases hq : S.next (S.hist π k) with
    | none =>
      rw [hist_stuck S π hq j hk.le, hq] at h
      exact absurd h (by simp)
    | some q' => exact ⟨q', rfl⟩
  have : ∀ k ≤ j, (S.hist π k).length = k := by
    intro k hk
    induction k with
    | zero => rfl
    | succ k ih =>
      obtain ⟨q', hq'⟩ := hall k (by omega)
      rw [S.hist_succ_of_some hq', List.length_append, ih (by omega)]
      rfl
  exact this j le_rfl

/-- **A history-length bound bounds the steps that ask a query.** -/
theorem step_lt_of_length_le (L : ℕ) (hL : ∀ j, (S.hist π j).length ≤ L) {j : ℕ} {q : Qry α}
    (h : S.next (S.hist π j) = some q) : j < L := by
  have h1 := hist_length_of_next S π h
  have h2 := hL (j + 1)
  rw [S.hist_succ_of_some h, List.length_append, h1] at h2
  simp only [List.length_singleton] at h2
  omega

end Steps

/-! ## Transcripts are sorted by round -/

theorem trace_pairwise {M : IdealModel} {X : Type} (f : M.Qry → M.Ans) (P : Prog M X) :
    (Tr.trace f P).Pairwise (fun a b => a.1 ≤ b.1) := by
  induction P with
  | ret a => simp [Tr.trace]
  | round qs k ih =>
    simp only [Tr.trace]
    refine List.pairwise_append.2 ⟨?_, ?_, ?_⟩
    · rw [List.pairwise_map]
      exact List.pairwise_of_forall fun _ _ => le_rfl
    · rw [List.pairwise_map]
      exact (ih (qs.map f)).imp fun h => Nat.succ_le_succ h
    · intro a ha b _
      obtain ⟨x, _, rfl⟩ := List.mem_map.1 ha
      exact Nat.zero_le _

/-! ## The labeller tail, for any program -/

section Tail

variable {n wc : ℕ}

/-- The model's true answers, read off the lazy oracle. -/
def trueAns (π : Oracle (P3Alpha n wc)) : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans :=
  fun q => dec n wc (qEntry π (enc n wc) q)

theorem trueAns_eq (ω : P3COmega n wc) : trueAns (omegaEquiv n wc ω) = (p3ChainModel n wc).answer ω :=
  funext (dec_qEntry n wc ω)

theorem histAns_none_iff (h : History (P3Alpha n wc)) (x : Qry (P3Alpha n wc)) :
    histAns h x = none ↔ ∀ e ∈ h, e.1 ≠ x := by
  unfold histAns
  rw [List.findSome?_eq_none_iff]
  refine forall₂_congr fun e _ => ?_
  constructor
  · intro he hx
    simp [hx] at he
  · intro hx
    simp [hx]

theorem histAns_some_eq {π : Oracle (P3Alpha n wc)} (h : History (P3Alpha n wc)) (hcons : ∀ e ∈ h, e.2 = ans π e.1)
    {x : Qry (P3Alpha n wc)} {a : P3Alpha n wc x.1} (ha : histAns h x = some a) : a = ans π x := by
  unfold histAns at ha
  obtain ⟨e, he, hfe⟩ := List.exists_of_findSome?_eq_some ha
  split at hfe
  · rename_i hq
    obtain ⟨q, b⟩ := e
    subst hq
    simp only [Option.some.injEq] at hfe
    rw [← hfe]
    exact hcons _ he
  · exact absurd hfe (by simp)

/-- A query the history answers is answered truly by `ansOf`. -/
theorem ansOf_eq {π : Oracle (P3Alpha n wc)} (h : History (P3Alpha n wc)) (hcons : ∀ e ∈ h, e.2 = ans π e.1)
    {q : (p3ChainModel n wc).Qry} (hq : (histAns h (enc n wc q)).isNone = false) : ansOf h q = trueAns π q := by
  cases ha : histAns h (enc n wc q) with
  | none => rw [ha] at hq; simp at hq
  | some a =>
    have := histAns_some_eq h hcons ha
    unfold ansOf trueAns qEntry
    rw [ha, Option.getD_some, this]

/-- **The tail's query is a new query on `p`'s true trace.** -/
theorem tailOf_some {π : Oracle (P3Alpha n wc)} (p : Prog (p3ChainModel n wc) Unit) (h : History (P3Alpha n wc))
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) {x : Qry (P3Alpha n wc)} (hx : tailOf p h = some x) :
    ∃ q, x = enc n wc q ∧ q ∈ (Tr.trace (trueAns π) p).map Prod.snd ∧ histAns h (enc n wc q) = none := by
  unfold tailOf at hx
  obtain ⟨q, hfind, rfl⟩ := Option.map_eq_some_iff.1 hx
  obtain ⟨hpq, as, bs, hl, hbefore⟩ := List.find?_eq_some_iff_append.1 hfind
  refine ⟨q, rfl, ?_, Option.isNone_iff_eq_none.1 hpq⟩
  obtain ⟨l1, l2, htr, hl1, hl2⟩ := List.map_eq_append_iff.1 hl
  obtain ⟨e, l3, rfl, he, -⟩ := List.map_eq_cons_iff.1 hl2
  have hsorted := trace_pairwise (ansOf h) p
  rw [htr] at hsorted
  have hagree : Tr.AgreeBefore (ansOf h) (trueAns π) p e.1 := by
    intro e' he' hlt
    rw [htr] at he'
    rcases List.mem_append.1 he' with h1 | h1
    · have hmem : e'.2 ∈ as := hl1 ▸ List.mem_map_of_mem h1
      have := hbefore _ hmem
      simp only [Bool.not_eq_true'] at this
      exact ansOf_eq h hcons this
    · rcases List.mem_cons.1 h1 with h2 | h2
      · subst h2; exact absurd hlt (lt_irrefl _)
      · have := (List.pairwise_append.1 hsorted).2.1
        exact absurd ((List.pairwise_cons.1 this).1 e' h2) (not_le.2 hlt)
  have hidx : (Tr.trace (ansOf h) p)[l1.length]? = some e := by
    rw [htr, List.getElem?_append_right le_rfl, Nat.sub_self]
    rfl
  have := (Tr.trace_stable (ansOf h) (trueAns π) p e.1 hagree).1 l1.length e hidx le_rfl
  rw [← he]
  exact List.mem_map_of_mem (List.mem_of_getElem? this)

variable {θ X : Type} [DecidableEq θ]

/-- **The history of an `ofRounds` strategy with a `tailOf p` tail has at most `|roundsSeq| + work(p)` entries.** -/
theorem ofRounds_tailOf_length_le (ths : List θ) (D : ℕ)
    (P : θ → RProg (p3ChainModel n wc).Qry (p3ChainModel n wc).Ans X) (p : Prog (p3ChainModel n wc) Unit)
    (π : Oracle (P3Alpha n wc)) (j : ℕ) :
    ((Strategy.ofRounds ths D P (enc n wc) (dec n wc) (tailOf p)).hist π j).length ≤
      (roundsSeq ths (trueAns π) D P).length + p.work (trueAns π) := by
  classical
  set S := Strategy.ofRounds ths D P (enc n wc) (dec n wc) (tailOf p)
  set R := roundsSeq ths (trueAns π) D P
  set T := (Tr.trace (trueAns π) p).map Prod.snd
  rcases Nat.lt_or_ge j R.length with hj | hj
  · exact (S.hist_length_le π j).trans (by omega)
  have hinv : ∀ j, R.length ≤ j → ∃ tq : List (p3ChainModel n wc).Qry, tq.Nodup ∧ (∀ q ∈ tq, q ∈ T) ∧
      S.hist π j = (R ++ tq).map (qEntry π (enc n wc)) := by
    intro j hj
    induction j, hj using Nat.le_induction with
    | base =>
      refine ⟨[], List.nodup_nil, fun q hq => absurd hq (List.not_mem_nil), ?_⟩
      rw [List.append_nil, Strategy.ofRounds_hist ths D P (enc n wc) (dec n wc) (tailOf p) π R.length le_rfl]
      change List.map (qEntry π (enc n wc)) (List.take R.length R) = List.map (qEntry π (enc n wc)) R
      rw [List.take_length]
    | succ j _ ih =>
      obtain ⟨tq, hnd, hsub, hh⟩ := ih
      cases hnext : S.next (S.hist π j) with
      | none => exact ⟨tq, hnd, hsub, by rw [S.hist_succ_of_none hnext, hh]⟩
      | some x =>
        have hpre : R.map (qEntry π (enc n wc)) <+: S.hist π j := by
          rw [hh, List.map_append]
          exact List.prefix_append _ _
        have htail := Strategy.ofRounds_next_tail ths D P (enc n wc) (dec n wc) (tailOf p) π (S.hist π j) hpre
        rw [htail] at hnext
        obtain ⟨q, rfl, hqT, hnew⟩ := tailOf_some p (S.hist π j) (fun e he => S.mem_hist he) hnext
        have hqtq : q ∉ tq := by
          intro hq
          have hmem : qEntry π (enc n wc) q ∈ S.hist π j := by
            rw [hh, List.map_append]
            exact List.mem_append_right _ (List.mem_map_of_mem hq)
          exact (histAns_none_iff _ _).1 hnew _ hmem rfl
        refine ⟨tq ++ [q], hnd.append (List.nodup_singleton q) (List.disjoint_singleton.2 hqtq), fun q' hq' => ?_, ?_⟩
        · rcases List.mem_append.1 hq' with h1 | h1
          · exact hsub q' h1
          · rw [List.mem_singleton.1 h1]; exact hqT
        · rw [S.hist_succ_of_some (by rw [← htail] at hnext; exact hnext), hh]
          simp only [List.map_append, List.map_cons, List.map_nil, List.append_assoc]
          rfl
  obtain ⟨tq, hnd, hsub, hh⟩ := hinv j hj
  rw [hh, List.length_map, List.length_append]
  have hle : tq.length ≤ T.length := by
    rw [← List.toFinset_card_of_nodup hnd]
    exact (Finset.card_le_card fun q hq => List.mem_toFinset.2 (hsub q (List.mem_toFinset.1 hq))).trans
      (List.toFinset_card_le _)
  have hT : T.length = p.work (trueAns π) := by rw [List.length_map, Tr.length_trace]
  omega

/-- **By step `|roundsSeq| + work(p)` the strategy has stopped.** -/
theorem ofRounds_tailOf_stop (ths : List θ) (D : ℕ)
    (P : θ → RProg (p3ChainModel n wc).Qry (p3ChainModel n wc).Ans X) (p : Prog (p3ChainModel n wc) Unit)
    (π : Oracle (P3Alpha n wc)) :
    (Strategy.ofRounds ths D P (enc n wc) (dec n wc) (tailOf p)).next
      ((Strategy.ofRounds ths D P (enc n wc) (dec n wc) (tailOf p)).hist π
        ((roundsSeq ths (trueAns π) D P).length + p.work (trueAns π))) = none := by
  cases h : (Strategy.ofRounds ths D P (enc n wc) (dec n wc) (tailOf p)).next _ with
  | none => rfl
  | some q =>
    exact absurd (step_lt_of_length_le _ π _ (ofRounds_tailOf_length_le ths D P p π) h) (lt_irrefl _)

/-- **Completion**: at step `|roundsSeq| + work(p)` the history holds every query of `p`'s true trace. -/
theorem ofRounds_tailOf_complete (ths : List θ) (D : ℕ)
    (P : θ → RProg (p3ChainModel n wc).Qry (p3ChainModel n wc).Ans X) (p : Prog (p3ChainModel n wc) Unit)
    (π : Oracle (P3Alpha n wc)) :
    ∀ q ∈ (Tr.trace (trueAns π) p).map Prod.snd, ∃ e ∈ (Strategy.ofRounds ths D P (enc n wc) (dec n wc) (tailOf p)).hist
      π ((roundsSeq ths (trueAns π) D P).length + p.work (trueAns π)), e.1 = enc n wc q := by
  set S := Strategy.ofRounds ths D P (enc n wc) (dec n wc) (tailOf p)
  set R := roundsSeq ths (trueAns π) D P
  set L := R.length + p.work (trueAns π)
  set h := S.hist π L
  have hpre : R.map (qEntry π (enc n wc)) <+: h := by
    have h1 := Strategy.ofRounds_hist ths D P (enc n wc) (dec n wc) (tailOf p) π R.length le_rfl
    change S.hist π R.length = List.map (qEntry π (enc n wc)) (List.take R.length R) at h1
    rw [List.take_length] at h1
    rw [← h1]
    exact S.hist_prefix π (by omega)
  have hstop := ofRounds_tailOf_stop ths D P p π
  rw [Strategy.ofRounds_next_tail ths D P (enc n wc) (dec n wc) (tailOf p) π _ hpre] at hstop
  unfold tailOf at hstop
  rw [Option.map_eq_none_iff, List.find?_eq_none] at hstop
  have hcons : ∀ e ∈ h, e.2 = ans π e.1 := fun e he => S.mem_hist he
  have hin : ∀ q ∈ (Tr.trace (ansOf h) p).map Prod.snd, (histAns h (enc n wc q)).isNone = false := by
    intro q hq
    exact Bool.eq_false_iff.2 (hstop q hq)
  have hagree : Tr.AgreeBefore (ansOf h) (trueAns π) p (((Tr.trace (trueAns π) p).map Prod.fst).sum) :=
    fun e he _ => ansOf_eq h hcons (hin e.2 (List.mem_map_of_mem he))
  intro q hq
  obtain ⟨e, he, rfl⟩ := List.mem_map.1 hq
  have he' := (Tr.trace_stable (ansOf h) (trueAns π) p _ hagree).2 e he
    (List.le_sum_of_mem (List.mem_map_of_mem he))
  have hne := hin e.2 (List.mem_map_of_mem he')
  cases hh : histAns h (enc n wc e.2) with
  | none => rw [hh] at hne; simp at hne
  | some a =>
    by_contra hall
    push Not at hall
    rw [(histAns_none_iff h _).2 hall] at hh
    exact absurd hh (by simp)

end Tail

/-! ## The thread phase: at most the programs' work -/

section Threads

theorem list_sum_range (g : ℕ → ℕ) (D : ℕ) : ((List.range D).map g).sum = ∑ ρ ∈ Finset.range D, g ρ := by
  rw [← List.sum_toFinset _ (List.nodup_range), List.toFinset_range]

theorem sum_filterMap_round_le {Q : Type} (l : List (ℕ × Q)) (D : ℕ) :
    ∑ ρ ∈ Finset.range D, (l.filterMap fun e => if e.1 = ρ then some e.2 else none).length ≤ l.length := by
  induction l with
  | nil => simp
  | cons e l ih =>
    have hsplit : ∀ ρ, ((e :: l).filterMap fun e => if e.1 = ρ then some e.2 else none).length =
        (if e.1 = ρ then 1 else 0) + (l.filterMap fun e => if e.1 = ρ then some e.2 else none).length := by
      intro ρ
      by_cases h : e.1 = ρ
      · simp only [List.filterMap_cons, h, ↓reduceIte, List.length_cons]; omega
      · simp only [List.filterMap_cons, h, ↓reduceIte, zero_add]
    rw [Finset.sum_congr rfl fun ρ _ => hsplit ρ, Finset.sum_add_distrib, Finset.sum_ite_eq, List.length_cons]
    split_ifs <;> omega

theorem list_sum_comm {α β : Type} (L1 : List α) (L2 : List β) (g : β → α → ℕ) :
    (L1.map fun a => (L2.map fun b => g b a).sum).sum = (L2.map fun b => (L1.map fun a => g b a).sum).sum := by
  induction L1 with
  | nil => simp
  | cons a L1 ih =>
    simp only [List.map_cons, List.sum_cons, ih]
    rw [← List.sum_map_add]

variable {θ Q A X : Type} [DecidableEq θ]

/-- **The thread phase has at most the threads' total work.** -/
theorem roundsSeq_length_le (ths : List θ) (hnd : ths.Nodup) (f : Q → A) (D : ℕ) (P : θ → RProg Q A X) :
    (roundsSeq ths f D P).length ≤ (ths.map fun t => ((P t).trace f).length).sum := by
  rw [roundsSeq_eq hnd f D P, List.length_flatMap]
  simp only [List.length_flatMap, RProg.roundQs_eq_trace]
  rw [list_sum_comm]
  refine List.sum_le_sum fun t _ => ?_
  rw [list_sum_range]
  exact sum_filterMap_round_le _ D

end Threads

/-! ## The labellers' work -/

section Labeller

variable {n wc : ℕ}

theorem work_pbind {M : IdealModel} {X Y : Type} (f : M.Qry → M.Ans) (p : Prog M X) (g : X → Prog M Y) :
    (pbind p g).work f = p.work f + (g (p.run f)).work f := by
  induction p with
  | ret x => show (g x).work f = 0 + (g x).work f; omega
  | round qs k ih =>
    show qs.length + (pbind (k (qs.map f)) g).work f = (qs.length + (k (qs.map f)).work f) + _
    rw [ih]
    show _ = _ + (g ((k (qs.map f)).run f)).work f
    omega

theorem work_p2Fwd (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (x : Bits (n * wc + (n * wc + 512))) :
    (p2Fwd x).work f = 1 := rfl

theorem work_pFwd (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (T : Tweak n) (a : Lab n wc) :
    (pFwd T a).work f = 1 := rfl

theorem work_chainProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) :
    ∀ (bs : List (Bits (n * wc))) (h : Bits (n * wc + 512)) (r : Bits (n * wc)), (chainProg h r bs).work f = bs.length
  | [], _, _ => rfl
  | b :: bs, h, r => by
    show (pbind (p2Fwd (Fin.append b h)) fun y => chainProg (ovH y) (ovR y) bs).work f = _
    rw [work_pbind, work_p2Fwd, work_chainProg f bs, List.length_cons]
    omega

theorem work_rowProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tag : Bits 256) (G : TopoDAG n)
    (L : Fin 2) (v : Fin n) (labs : Fin n → Lab n wc) (pinOf : Lab n wc → Lab n wc) :
    (rowProg tag G L v labs pinOf).work f = ovCalls G v + 1 := by
  show (pbind (chainProg (iv (domP3 tag L v)) (fun _ => false) (rowBlocks labs G v)) fun r =>
    pFwd (tag, L, v) (pinOf ((codeEquiv n wc).symm r))).work f = _
  rw [work_pbind, work_chainProg, work_pFwd, rowBlocks_length]

theorem ovCalls_le_succ (G : TopoDAG n) (v : Fin n) : ovCalls G v ≤ v.val + 1 := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]
  have : (G.par v).card ≤ v.val :=
    calc (G.par v).card ≤ (Finset.range v.val).card :=
          Finset.card_le_card_of_injOn (fun u => u.val)
            (fun u hu => Finset.mem_range.2 (Fin.lt_def.1 (G.par_lt v u hu))) (fun a _ b _ h => Fin.ext h)
      _ = v.val := Finset.card_range _
  omega

theorem work_layerProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tag : Bits 256) (G : TopoDAG n)
    (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc) :
    ∀ (k : ℕ) (acc : Fin n → Lab n wc), (layerProg tag G L pinOf k acc).work f ≤ ∑ v ∈ Finset.Ico k n, (v + 2) := by
  intro k
  induction h : n - k generalizing k with
  | zero =>
    intro acc
    rw [layerProg_eq]
    split_ifs with hk
    · omega
    · exact Nat.zero_le _
  | succ d ih =>
    intro acc
    have hk : k < n := by omega
    rw [layerProg_eq]
    split_ifs
    rw [work_pbind, work_rowProg, Finset.sum_eq_sum_Ico_succ_bot hk]
    have h1 := ovCalls_le_succ G ⟨k, hk⟩
    have h2 := ih (k + 1) (by omega) (Function.update acc ⟨k, hk⟩
      ((rowProg tag G L ⟨k, hk⟩ acc (pinOf ⟨k, hk⟩)).run f))
    simp only at h1
    omega

theorem sum_Ico_two (n : ℕ) : (∑ v ∈ Finset.Ico 0 n, (v + 2)) * 2 = n * (n + 1) + 2 * n := by
  rw [Nat.Ico_zero_eq_range, Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul, add_mul,
    Finset.sum_range_id_mul_two]
  cases n with
  | zero => rfl
  | succ k => simp only [Nat.succ_sub_one]; ring

/-- **One segment's labeller asks at most `n(n+1) + 2n` queries.** -/
theorem work_labProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tag : Bits 256) (G : TopoDAG n)
    (W : Fin n → Lab n wc) : (labProg tag G W).work f ≤ n * (n + 1) + 2 * n := by
  show (pbind (layerProg tag G 0 (fun v key => labXor (W v) key) 0 fun _ _ _ => false) fun c1 =>
    pbind (layerProg tag G 1 (fun v key => labXor (transpose c1 v) key) 0 fun _ _ _ => false)
      fun _ => .ret ()).work f ≤ _
  rw [work_pbind, work_pbind]
  have h1 := work_layerProg f tag G 0 (fun v key => labXor (W v) key) 0 fun _ _ _ => false
  have h2 := work_layerProg f tag G 1
    (fun v key => labXor (transpose ((layerProg tag G 0 (fun v key => labXor (W v) key) 0 fun _ _ _ => false).run f)
      v) key) 0 fun _ _ _ => false
  have h3 := sum_Ico_two n
  have h4 : (Prog.ret () : Prog (p3ChainModel n wc) Unit).work f = 0 := rfl
  rw [h4]
  omega

variable {N : ℕ}

theorem work_segsProg (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) :
    ∀ ss : List (Fin N), (segsProg tags G W ss).work f ≤ ss.length * (n * (n + 1) + 2 * n)
  | [] => Nat.zero_le _
  | s :: ss => by
    show (pbind (labProg (tags s) G (W s)) fun _ => segsProg tags G W ss).work f ≤ _
    rw [work_pbind, List.length_cons, Nat.add_mul, one_mul]
    have := work_labProg f (tags s) G (W s)
    have := work_segsProg f tags G W ss
    omega

/-- **All `N` labellers ask at most `N·(n(n+1) + 2n)` queries.** -/
theorem work_labProgJ (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) : (labProgJ tags G W).work f ≤ N * (n * (n + 1) + 2 * n) := by
  have := work_segsProg f tags G W (List.finRange N)
  rwa [List.length_finRange] at this

end Labeller

/-! ## The joint strategy: every named step is below `N·nPosC` -/

section Joint

variable {N n wc : ℕ}

/-- The joint thread phase plus all labellers' work is at most `N·nPosC`. -/
theorem joint_L_le (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) {D Q : ℕ} (hA : ∀ s v, (A s v).Bounded D Q)
    (π : Oracle (P3Alpha n wc)) :
    (roundsSeq (jointThreads N n) (trueAns π) D fun i => toRProg (A i.1 i.2)).length +
      (labProgJ tags G W).work (trueAns π) ≤ N * nPosC n Q := by
  have hf : trueAns π = (p3ChainModel n wc).answer ((omegaEquiv n wc).symm π) := by
    rw [← trueAns_eq, Equiv.apply_symm_apply]
  have h1 : (roundsSeq (jointThreads N n) (trueAns π) D fun i => toRProg (A i.1 i.2)).length ≤ N * n * Q := by
    refine (roundsSeq_length_le _ jointThreads_nodup _ D _).trans ?_
    have hle : ∀ x ∈ (jointThreads N n).map fun t => ((toRProg (A t.1 t.2)).trace (trueAns π)).length, x ≤ Q := by
      intro x hx
      obtain ⟨t, _, rfl⟩ := List.mem_map.1 hx
      rw [trace_toRProg, Tr.length_trace, hf]
      exact (hA t.1 t.2 _).2
    have := List.sum_le_length_nsmul _ Q hle
    rw [List.length_map, jointThreads, List.length_product, List.length_finRange, List.length_finRange,
      smul_eq_mul] at this
    exact this
  have h2 := work_labProgJ (trueAns π) tags G W
  have h3 : N * n * Q + N * (n * (n + 1) + 2 * n) ≤ N * nPosC n Q := by
    unfold nPosC
    have : N * n * Q ≤ N * (n * (Q + 1)) := by
      rw [Nat.mul_assoc]; exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
    have e : N * (n * (Q + 1) + n * (n + 1) + 2 * n) = N * (n * (Q + 1)) + N * (n * (n + 1) + 2 * n) := by ring
    omega
  omega

/-- **The joint strategy's history has at most `N·nPosC` entries.** -/
theorem jointStrategy_length_le (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) {D Q : ℕ} (hA : ∀ s v, (A s v).Bounded D Q)
    (π : Oracle (P3Alpha n wc)) (j : ℕ) : ((jointStrategy A tags G W D).hist π j).length ≤ N * nPosC n Q :=
  (ofRounds_tailOf_length_le (jointThreads N n) D _ (labProgJ tags G W) π j).trans (joint_L_le A tags G W hA π)

/-- **Every step at which the joint strategy asks a query is below `N·nPosC`**: `h_lt`, for any item design. -/
theorem jointStrategy_step_lt (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) {D Q : ℕ} (hA : ∀ s v, (A s v).Bounded D Q)
    {π : Oracle (P3Alpha n wc)} {j : ℕ} {q : Qry (P3Alpha n wc)}
    (h : (jointStrategy A tags G W D).next ((jointStrategy A tags G W D).hist π j) = some q) : j < N * nPosC n Q :=
  step_lt_of_length_le _ π _ (jointStrategy_length_le A tags G W hA π) h

theorem trace_pbind_snd {M : IdealModel} {X Y : Type} (f : M.Qry → M.Ans) (p : Prog M X) (g : X → Prog M Y) :
    (Tr.trace f (pbind p g)).map Prod.snd = (Tr.trace f p).map Prod.snd ++ (Tr.trace f (g (p.run f))).map Prod.snd := by
  induction p with
  | ret x => rfl
  | round qs k ih =>
    show ((qs.map fun x => ((0 : ℕ), x)) ++ (Tr.trace f (pbind (k (qs.map f)) g)).map
        fun e : ℕ × M.Qry => (e.1 + 1, e.2)).map Prod.snd =
      ((qs.map fun x => ((0 : ℕ), x)) ++ (Tr.trace f (k (qs.map f))).map
        fun e : ℕ × M.Qry => (e.1 + 1, e.2)).map Prod.snd ++
        (Tr.trace f (g ((k (qs.map f)).run f))).map Prod.snd
    simp only [List.map_append, List.map_map]
    have e1 : (Prod.snd ∘ fun e : ℕ × M.Qry => (e.1 + 1, e.2)) = Prod.snd := rfl
    rw [e1, ih, List.append_assoc]

theorem mem_segsProg {N : ℕ} (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) :
    ∀ (ss : List (Fin N)) (t : Fin N), t ∈ ss → ∀ q ∈ (Tr.trace f (labProg (tags t) G (W t))).map Prod.snd,
      q ∈ (Tr.trace f (segsProg tags G W ss)).map Prod.snd
  | [], _, ht => absurd ht (List.not_mem_nil)
  | s :: ss, t, ht => by
    intro q hq
    show q ∈ (Tr.trace f (pbind (labProg (tags s) G (W s)) fun _ => segsProg tags G W ss)).map Prod.snd
    rw [trace_pbind_snd]
    rcases List.mem_cons.1 ht with rfl | ht
    · exact List.mem_append_left _ hq
    · exact List.mem_append_right _ (mem_segsProg f tags G W ss t ht q hq)

/-- **Joint completion**: by step `N·nPosC` the joint history holds every honest query of every segment. -/
theorem jointStrategy_complete (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) {D Q : ℕ} (hA : ∀ s v, (A s v).Bounded D Q)
    (π : Oracle (P3Alpha n wc)) (t : Fin N) :
    ∀ q ∈ (Tr.trace (trueAns π) (labProg (tags t) G (W t))).map Prod.snd,
      ∃ e ∈ (jointStrategy A tags G W D).hist π (N * nPosC n Q), e.1 = enc n wc q := by
  intro q hq
  have hq' := mem_segsProg (trueAns π) tags G W (List.finRange N) t (List.mem_finRange t) q hq
  obtain ⟨e, he, hq⟩ := ofRounds_tailOf_complete (jointThreads N n) D (fun i => toRProg (A i.1 i.2))
    (labProgJ tags G W) π q hq'
  exact ⟨e, (Strategy.hist_prefix _ π (joint_L_le A tags G W hA π)).subset he, hq⟩

end Joint

/-! ## The one-segment strategy's steps (bc-58ec406e's `h_lt`) -/

section One

variable {n wc : ℕ} {ι : Type} [DecidableEq ι]

/-- **Any program index**: `strategy R ths` asks at most `|ths|·Q + n(n+1) + 2n` queries. -/
theorem strategy_length_le (R : P3Replay n wc ι) (ths : List ι) (hnd : ths.Nodup)
    (hA : ∀ i, (R.A i).Bounded R.D R.Q) (π : Oracle (P3Alpha n wc)) (j : ℕ) :
    ((strategy R ths).hist π j).length ≤ ths.length * R.Q + (n * (n + 1) + 2 * n) := by
  refine (ofRounds_tailOf_length_le ths R.D _ (labProg R.tag R.G R.W) π j).trans ?_
  have hf : trueAns π = (p3ChainModel n wc).answer ((omegaEquiv n wc).symm π) := by
    rw [← trueAns_eq, Equiv.apply_symm_apply]
  have h1 : (roundsSeq ths (trueAns π) R.D fun i => toRProg (R.A i)).length ≤ ths.length * R.Q := by
    refine (roundsSeq_length_le _ hnd _ R.D _).trans ?_
    have hle : ∀ x ∈ ths.map fun t => ((toRProg (R.A t)).trace (trueAns π)).length, x ≤ R.Q := by
      intro x hx
      obtain ⟨t, _, rfl⟩ := List.mem_map.1 hx
      rw [trace_toRProg, Tr.length_trace, hf]
      exact (hA t _).2
    have := List.sum_le_length_nsmul _ R.Q hle
    rwa [List.length_map, smul_eq_mul] at this
  have h2 := work_labProg (trueAns π) R.tag R.G R.W
  omega

/-- **One segment: every step at which `strategy R (finRange n)` asks a query is below `nPosC`** (the one-segment
`h_lt` of `P3Client`). -/
theorem strategy_step_lt (R : P3Replay n wc (Fin n)) (hA : ∀ i, (R.A i).Bounded R.D R.Q)
    {π : Oracle (P3Alpha n wc)} {j : ℕ} {q : Qry (P3Alpha n wc)}
    (h : (strategy R (List.finRange n)).next ((strategy R (List.finRange n)).hist π j) = some q) :
    j < nPosC n R.Q := by
  refine step_lt_of_length_le _ π _ (fun j => (strategy_length_le R _ (List.nodup_finRange n) hA π j).trans ?_) h
  rw [List.length_finRange]
  unfold nPosC
  have : n * R.Q ≤ n * (R.Q + 1) := Nat.mul_le_mul_left _ (by omega)
  omega

end One

end

end PousP3ConcreteMulti

end


/-! ════ P3Concrete.P3ChainAssembly ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The fixed-advice reduction and the assembly of `P3ChainEPF`

`P3ChainEPF` rests on two statements, for any adversary-independent collision event `Bad`:
- **`FreshTail Bad`, the compression, for one fixed advice string.** The online adversary is then a fixed replay, and
  its online holding (`onlineH`) is priced at least `s·n` columns, with no collision, with probability at most
  `nPosC^{14n} / 2^{(s−1)·n·wc}`. This is what the lazy-sampling attribution proves.
- **`CollBound Bad`, the collision term:** `pr[Bad] ≤ (nPosC² + (2n)²)/2^{n·wc}`.

**The assembly** (`p3ChainEPF_of_tail`): a win with advice `σ = A₁ ω` forces an online holding priced at least
`(k − X)·n` (`win_price_on` with `P3ChainHard`). A union over the `2^m` advice strings and the collision event then
gives `P3ChainEPF`'s right-hand side exactly.
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge
open scoped ENNReal

theorem pr_or_le {α : Type} [Fintype α] (A B : α → Prop) : pr (fun x => A x ∨ B x) ≤ pr A + pr B := by
  classical
  unfold pr
  rw [← ENNReal.add_div]
  gcongr
  norm_cast
  refine (Finset.card_le_card fun x hx => ?_).trans (Finset.card_union_le _ _)
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
  rcases hx with h | h
  · exact Finset.mem_union_left _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩)
  · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩)

theorem pr_exists_le {α ι : Type} [Fintype α] [Fintype ι] (P : ι → α → Prop) :
    pr (fun x => ∃ i, P i x) ≤ ∑ i, pr (P i) := by
  classical
  unfold pr
  simp only [div_eq_mul_inv]
  rw [← Finset.sum_mul]
  gcongr
  norm_cast
  refine (Finset.card_le_card fun x hx => ?_).trans Finset.card_biUnion_le
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
  obtain ⟨i, hi⟩ := hx
  exact Finset.mem_biUnion.2 ⟨i, Finset.mem_univ _, Finset.mem_filter.2 ⟨Finset.mem_univ _, hi⟩⟩

/-- An adversary-independent event: a predicate on `ω` given one segment's tag, graph and data. -/
abbrev BadEv : Type := ∀ {n wc : ℕ}, Bits 256 → TopoDAG n → (Fin n → Lab n wc) → P3COmega n wc → Prop

/-- **The compression, for one fixed advice string.** -/
def FreshTail (Bad : BadEv) : Prop :=
  ∀ (n wc s : ℕ) (R : P3Replay n wc (Fin n)), 0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * nPosC n R.Q ≤ 2 ^ wc → s ≤ n →
    (∀ v, (R.A v).Bounded R.D R.Q) →
    pr (fun ω => ((s : ℚ) * n ≤ (R.onlineH ω (R.D + 1)).size 512 wc) ∧ ¬ Bad R.tag R.G R.W ω)
      ≤ ((nPosC n R.Q ^ (14 * n) : ℕ) : ℝ≥0∞) / 2 ^ ((s - 1) * (n * wc))

/-- **The collision term.** -/
def CollBound (Bad : BadEv) : Prop :=
  ∀ (n wc Q : ℕ) (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc), 0 < n → 0 < wc → n ≤ 2 ^ 255 →
    pr (fun ω => Bad tag G W ω) ≤ ((nPosC n Q ^ 2 + (2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

theorem card_bits (m : ℕ) : Fintype.card (Bits m) = 2 ^ m := by
  simp [Bits]

/-- **The assembly: `P3ChainEPF` from the per-advice compression and the collision bound.** -/
theorem p3ChainEPF_of_tail (Bad : BadEv) (hT : FreshTail Bad) (hC : CollBound Bad) : P3ChainEPF := by
  intro n wc m D Q k X tag G W hn hwc hn255 hC1 _ _ hard A₁ A₂ hA₂
  by_cases hkn : k ≤ n
  swap
  · refine (pr_mono fun ω hw => ?_).trans ((hC n wc Q tag G W hn hwc hn255).trans le_add_self)
    exact absurd (hw.trans ((Finset.card_le_univ _).trans_eq (Fintype.card_fin n))) hkn
  let R : Bits m → P3Replay n wc (Fin n) := fun σ => ⟨tag, G, W, D, Q, A₂ σ⟩
  have hsub : ∀ ω : P3COmega n wc,
      k ≤ (Finset.univ.filter fun v =>
        (A₂ (A₁ ω) v).run ((p3ChainModel n wc).answer ω) = topLabelC tag G W ω v).card →
      Bad tag G W ω ∨ ∃ σ : Bits m, ((((k - X : ℕ) : ℚ) * n ≤ ((R σ).onlineH ω (D + 1)).size 512 wc) ∧
        ¬ Bad tag G W ω) := by
    intro ω hw
    by_cases hb : Bad tag G W ω
    · exact Or.inl hb
    · exact Or.inr ⟨A₁ ω, (R (A₁ ω)).win_price_on ω (fun v => hA₂ (A₁ ω) v) id hard hw, hb⟩
  refine (pr_mono hsub).trans ((pr_or_le _ _).trans ?_)
  rw [add_comm]
  refine add_le_add ?_ (hC n wc Q tag G W hn hwc hn255)
  refine (pr_exists_le _).trans ?_
  have hσ : ∀ σ : Bits m, pr (fun ω => (((k - X : ℕ) : ℚ) * n ≤ ((R σ).onlineH ω (D + 1)).size 512 wc) ∧
      ¬ Bad tag G W ω) ≤ ((nPosC n Q ^ (14 * n) : ℕ) : ℝ≥0∞) / 2 ^ ((k - X - 1) * (n * wc)) :=
    fun σ => hT n wc (k - X) (R σ) hn hwc hn255 hC1 (by omega) (fun v => hA₂ σ v)
  refine (Finset.sum_le_sum fun σ _ => hσ σ).trans (le_of_eq ?_)
  rw [Finset.sum_const, Finset.card_univ, card_bits, nsmul_eq_mul, mul_div_assoc]
  push_cast
  rfl

end Pous.P3Concrete

end


/-! ════ LazyPermFresh ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The fresh-prediction bridge: from online freshness to the per-advice bound

Generic in the oracle family, the strategy and the client's items. It turns a client's online-freshness predicate,
whose fresh items are **named by distinct deciding steps**, into:
- the per-advice product for one name pattern (`Strategy.prob_pattern_le`);
- the union over name patterns (`Strategy.prob_fresh_le`);
- the closed form `2·(2·nPos·|K|)^{s+1}·2^{−W}` (`Strategy.prob_fresh_width_le`).

Owner: bc-58ec406e (taken over from bc-a359729a). This implements the 06:48Z signature of `proof-technique-decision.md`
unchanged. What P3 needs sits inside it:
- **An item is one deciding step with a combined target.** Several pinned coordinates decided by one sample form one
  item. Its kind `κ` records which coordinates it pins, so `T κ h q` is the set of answers matching all of them, and
  `w κ` is their total width.
- **Names may depend on the oracle and on the other items** (`name : Oracle α → I → ℕ × K`). The only requirements
  are the client hypotheses:
  - `h_distinct`: fresh items at pairwise distinct steps;
  - `h_fresh`: the deciding query is `Fresh`;
  - `h_target`: the deciding answer lands in the target;
  - `h_lt`: steps below `nPos`.
- **The target hypothesis** is `pin_mul_le`'s form: `|T κ h q|·(2^{w κ} − nPos) ≤ |α q.1| − nPos`.

The advice union (`2^m`) and the collision term stay with the client, as do the transfer of its `Ω` (`prob_congr`) and
the choice of `nPos`, the bound on the named steps.
-/

namespace LazyPerm

open scoped ENNReal

theorem prob_mono {Ω : Type} [Fintype Ω] {E F : Ω → Prop} (h : ∀ ω, E ω → F ω) : prob E ≤ prob F := by
  classical
  unfold prob
  gcongr with x
  exact h x

/-- **The union bound.** -/
theorem prob_exists_le {Ω γ : Type} [Fintype Ω] (s : Finset γ) (E : γ → Ω → Prop) :
    prob (fun ω => ∃ g ∈ s, E g ω) ≤ ∑ g ∈ s, prob (E g) := by
  classical
  unfold prob
  simp only [div_eq_mul_inv]
  rw [← Finset.sum_mul]
  gcongr
  norm_cast
  refine (Finset.card_le_card fun x hx => ?_).trans Finset.card_biUnion_le
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
  simp only [Finset.mem_biUnion, Finset.mem_filter, Finset.mem_univ, true_and]
  exact hx

section Bridge

variable {K : Type} [DecidableEq K]

/-- Names at pairwise distinct steps. -/
def DistinctSteps (P : Finset (ℕ × K)) : Prop := ∀ a ∈ P, ∀ b ∈ P, a.1 = b.1 → a = b

open Classical in
/-- All name patterns: distinct-step subsets of `range nPos ×ˢ univ` satisfying `Adm`. -/
noncomputable def patterns [Fintype K] (nPos : ℕ) (Adm : Finset (ℕ × K) → Prop) : Finset (Finset (ℕ × K)) :=
  ((Finset.range nPos ×ˢ (Finset.univ : Finset K)).powerset).filter fun P => DistinctSteps P ∧ Adm P

omit [DecidableEq K] in
theorem mem_patterns [Fintype K] {nPos : ℕ} {Adm : Finset (ℕ × K) → Prop} {P : Finset (ℕ × K)} :
    P ∈ patterns nPos Adm ↔ P ⊆ Finset.range nPos ×ˢ (Finset.univ : Finset K) ∧ DistinctSteps P ∧ Adm P := by
  classical
  unfold patterns
  rw [Finset.mem_filter, Finset.mem_powerset]

/-- At most `s + 1` names, of total width at least `W`. -/
def widthAdm (w : K → ℕ) (s W : ℕ) (P : Finset (ℕ × K)) : Prop := P.card ≤ s + 1 ∧ W ≤ ∑ a ∈ P, w a.2

variable {ι : Type} [Fintype ι] [DecidableEq ι] {α : ι → Type} [∀ i, Fintype (α i)] [∀ i, DecidableEq (α i)]

namespace Strategy

variable (S : Strategy α)

/-- **The per-advice product for one name pattern.** -/
theorem prob_pattern_le (T : K → History α → (q : Qry α) → Finset (α q.1)) (w : K → ℕ) (nPos : ℕ)
    (hT : ∀ κ h q, (T κ h q).card * (2 ^ w κ - nPos) ≤ Fintype.card (α q.1) - nPos)
    (P : Finset (ℕ × K)) (hP : DistinctSteps P) (hlt : ∀ a ∈ P, a.1 < nPos) :
    prob (fun π => ∀ a ∈ P, S.Hit (T a.2) a.1 π) ≤ ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ := by
  classical
  let kd : ℕ → Option K := fun j => if h : ∃ κ, (j, κ) ∈ P then some (Classical.choose h) else none
  have kd_spec : ∀ a ∈ P, kd a.1 = some a.2 := by
    intro a ha
    have hex : ∃ κ, (a.1, κ) ∈ P := ⟨a.2, ha⟩
    simp only [kd, hex, ↓reduceDIte, Option.some.injEq]
    exact (Prod.ext_iff.1 (hP _ (Classical.choose_spec hex) a ha rfl)).2
  by_cases hb0 : ∃ a ∈ P, 2 ^ w a.2 - nPos = 0
  · obtain ⟨a, ha, h0⟩ := hb0
    have hne : ∏ b ∈ P.erase a, (((2 ^ w b.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ ≠ 0 :=
      Finset.prod_ne_zero_iff.2 fun b _ => ENNReal.inv_ne_zero.2 (ENNReal.natCast_ne_top _)
    rw [← Finset.mul_prod_erase P _ ha, h0, Nat.cast_zero, ENNReal.inv_zero, ENNReal.top_mul hne]
    exact le_top
  · push Not at hb0
    let T' : ℕ → History α → (q : Qry α) → Finset (α q.1) := fun j h q =>
      match kd j with
      | some κ => T κ h q
      | none => ∅
    let b : ℕ → ℕ := fun j =>
      match kd j with
      | some κ => 2 ^ w κ - nPos
      | none => 1
    have hevent : (fun π => ∀ a ∈ P, S.Hit (T a.2) a.1 π) = fun π => ∀ j ∈ P.image Prod.fst, S.Hit (T' j) j π := by
      funext π
      apply propext
      constructor
      · intro h j hj
        obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hj
        have := h a ha
        simpa only [T', kd_spec a ha] using this
      · intro h a ha
        have := h a.1 (Finset.mem_image_of_mem _ ha)
        simpa only [T', kd_spec a ha] using this
    rw [hevent]
    refine (S.prob_hits_le (P.image Prod.fst) T' (fun _ => 1) b ?_ ?_).trans (le_of_eq ?_)
    · intro j hj h q
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hj
      simp only [T', b, kd_spec a ha, one_mul]
      exact (hT a.2 h q).trans (Nat.sub_le_sub_left (le_of_lt (hlt a ha)) _)
    · intro j hj
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hj
      simp only [b, kd_spec a ha]
      exact Nat.pos_of_ne_zero (hb0 a ha)
    · rw [Finset.prod_image fun a ha a' ha' h => hP a ha a' ha' h]
      refine Finset.prod_congr rfl fun a ha => ?_
      simp only [b, kd_spec a ha, Nat.cast_one, one_div]

/-- **The per-advice bound from online freshness: the union over names.** -/
theorem prob_fresh_le [Fintype K] (T : K → History α → (q : Qry α) → Finset (α q.1)) (w : K → ℕ) (nPos : ℕ)
    (hT : ∀ κ h q, (T κ h q).card * (2 ^ w κ - nPos) ≤ Fintype.card (α q.1) - nPos)
    {I : Type} (OnFresh : Oracle α → I → Prop) (name : Oracle α → I → ℕ × K)
    (h_distinct : ∀ π x y, OnFresh π x → OnFresh π y → x ≠ y → (name π x).1 ≠ (name π y).1)
    (h_fresh : ∀ π x, OnFresh π x →
      ∃ q, S.next (S.hist π (name π x).1) = some q ∧ Fresh (S.hist π (name π x).1) q)
    (h_target : ∀ π x q, OnFresh π x → S.next (S.hist π (name π x).1) = some q →
      ans π q ∈ T (name π x).2 (S.hist π (name π x).1) q)
    (h_lt : ∀ π x, OnFresh π x → (name π x).1 < nPos)
    (Adm : Finset (ℕ × K) → Prop) (Win : Oracle α → Prop)
    (hwin : ∀ π, Win π → ∃ X : Finset I, (∀ x ∈ X, OnFresh π x) ∧ Adm (X.image (name π))) :
    prob Win ≤ ∑ P ∈ patterns nPos Adm, ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ := by
  classical
  have hsub : ∀ π, Win π → ∃ P ∈ patterns nPos Adm, ∀ a ∈ P, S.Hit (T a.2) a.1 π := by
    intro π hπ
    obtain ⟨X, hX, hadm⟩ := hwin π hπ
    refine ⟨X.image (name π), ?_, ?_⟩
    · refine mem_patterns.2 ⟨fun a ha => ?_, fun a ha b hb hab => ?_, hadm⟩
      · obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 ha
        exact Finset.mem_product.2 ⟨Finset.mem_range.2 (h_lt π x (hX x hx)), Finset.mem_univ _⟩
      · obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 ha
        obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hb
        by_cases hxy : x = y
        · rw [hxy]
        · exact absurd hab (h_distinct π x y (hX x hx) (hX y hy) hxy)
    · intro a ha
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 ha
      obtain ⟨q, hq, hfr⟩ := h_fresh π x (hX x hx)
      exact ⟨q, hq, hfr, h_target π x q (hX x hx) hq⟩
  refine (prob_mono hsub).trans ((prob_exists_le _ _).trans (Finset.sum_le_sum fun P hP => ?_))
  rw [mem_patterns] at hP
  exact S.prob_pattern_le T w nPos hT P hP.2.1 fun a ha =>
    Finset.mem_range.1 (Finset.mem_product.1 (hP.1 ha)).1

end Strategy

/-! ### The closed form -/

theorem inv_sub_le (w nPos : ℕ) (h2 : 2 * nPos ≤ 2 ^ w) :
    (((2 ^ w - nPos : ℕ) : ℝ≥0∞))⁻¹ ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ w := by
  have hx : ((2 ^ w : ℕ) : ℝ≥0∞) ≤ 2 * ((2 ^ w - nPos : ℕ) : ℝ≥0∞) := by
    have : 2 ^ w ≤ 2 * (2 ^ w - nPos) := by omega
    exact_mod_cast this
  have hinv : (2 * ((2 ^ w - nPos : ℕ) : ℝ≥0∞))⁻¹ ≤ ((2 ^ w : ℕ) : ℝ≥0∞)⁻¹ := ENNReal.inv_le_inv.2 hx
  rw [ENNReal.mul_inv (Or.inl two_ne_zero) (Or.inl ENNReal.ofNat_ne_top)] at hinv
  calc (((2 ^ w - nPos : ℕ) : ℝ≥0∞))⁻¹ = 2 * (2⁻¹ * (((2 ^ w - nPos : ℕ) : ℝ≥0∞))⁻¹) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel two_ne_zero ENNReal.ofNat_ne_top, one_mul]
    _ ≤ 2 * ((2 ^ w : ℕ) : ℝ≥0∞)⁻¹ := by gcongr
    _ = 2 * (2⁻¹ : ℝ≥0∞) ^ w := by rw [Nat.cast_pow, Nat.cast_ofNat, ENNReal.inv_pow]

theorem geom_le {X : ℕ} (hX : 2 ≤ X) : ∀ k, ∑ m ∈ Finset.range (k + 1), X ^ m ≤ 2 * X ^ k
  | 0 => by simp
  | k + 1 => by
    rw [Finset.sum_range_succ]
    have ih := geom_le hX k
    have h1 : 2 * X ^ k ≤ X ^ (k + 1) := by
      rw [pow_succ, mul_comm 2]
      exact Nat.mul_le_mul_left _ hX
    calc ∑ m ∈ Finset.range (k + 1), X ^ m + X ^ (k + 1) ≤ 2 * X ^ k + X ^ (k + 1) := Nat.add_le_add_right ih _
      _ ≤ X ^ (k + 1) + X ^ (k + 1) := Nat.add_le_add_right h1 _
      _ = 2 * X ^ (k + 1) := by ring

theorem sum_range_pow_le {X : ℕ} (hX : 2 ≤ X) (s : ℕ) : ∑ m ∈ Finset.range (s + 2), X ^ m ≤ 2 * X ^ (s + 1) :=
  geom_le hX (s + 1)

/-- **The union over names, in closed form**, for `Adm = widthAdm w s W`. -/
theorem sum_patterns_le [Fintype K] (w : K → ℕ) (nPos s W : ℕ) (h2 : ∀ κ, 2 * nPos ≤ 2 ^ w κ) :
    ∑ P ∈ patterns nPos (widthAdm w s W), ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹
      ≤ ∑ m ∈ Finset.range (s + 2), (((2 * (nPos * Fintype.card K)) ^ m : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ W := by
  classical
  set U := Finset.range nPos ×ˢ (Finset.univ : Finset K) with hU
  have hUc : U.card = nPos * Fintype.card K := by simp [U, Finset.card_product]
  -- each admissible pattern weighs at most `2^|P| · 2^{-W}`
  have hpt : ∀ P ∈ patterns nPos (widthAdm w s W),
      ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ ≤ (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W := by
    intro P hP
    rw [mem_patterns] at hP
    unfold widthAdm at hP
    calc ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹ ≤ ∏ a ∈ P, (2 * (2⁻¹ : ℝ≥0∞) ^ w a.2) :=
          Finset.prod_le_prod fun a _ => inv_sub_le _ _ (h2 a.2)
      _ = (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ (∑ a ∈ P, w a.2) := by
          rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.prod_pow_eq_pow_sum]
      _ ≤ (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W :=
          mul_le_mul' le_rfl (pow_le_pow_right_of_le_one' (by norm_num) hP.2.2.2)
  -- patterns sit inside the subsets of `U` of size at most `s + 1`
  have hsubset : patterns nPos (widthAdm w s W) ⊆ (Finset.range (s + 2)).biUnion fun m => U.powersetCard m := by
    intro P hP
    rw [mem_patterns] at hP
    unfold widthAdm at hP
    exact Finset.mem_biUnion.2 ⟨P.card, Finset.mem_range.2 (by omega), Finset.mem_powersetCard.2 ⟨hP.1, rfl⟩⟩
  calc ∑ P ∈ patterns nPos (widthAdm w s W), ∏ a ∈ P, (((2 ^ w a.2 - nPos : ℕ) : ℝ≥0∞))⁻¹
      ≤ ∑ P ∈ patterns nPos (widthAdm w s W), (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W := Finset.sum_le_sum hpt
    _ ≤ ∑ P ∈ (Finset.range (s + 2)).biUnion (fun m => U.powersetCard m),
          (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W := Finset.sum_le_sum_of_subset hsubset
    _ = ∑ m ∈ Finset.range (s + 2), ∑ P ∈ U.powersetCard m, (2 : ℝ≥0∞) ^ P.card * (2⁻¹ : ℝ≥0∞) ^ W := by
        rw [Finset.sum_biUnion]
        intro m _ m' _ hmm
        refine Finset.disjoint_left.2 fun P h1 h2 => hmm ?_
        rw [← (Finset.mem_powersetCard.1 h1).2, (Finset.mem_powersetCard.1 h2).2]
    _ = ∑ m ∈ Finset.range (s + 2), ((U.card.choose m : ℕ) : ℝ≥0∞) * ((2 : ℝ≥0∞) ^ m * (2⁻¹ : ℝ≥0∞) ^ W) := by
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [Finset.sum_congr rfl fun P hP => by rw [(Finset.mem_powersetCard.1 hP).2], Finset.sum_const,
          Finset.card_powersetCard, nsmul_eq_mul]
    _ ≤ ∑ m ∈ Finset.range (s + 2), (((2 * (nPos * Fintype.card K)) ^ m : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ W := by
        refine Finset.sum_le_sum fun m _ => ?_
        rw [← mul_assoc]
        gcongr
        rw [← hUc, mul_pow]
        have : U.card.choose m ≤ U.card ^ m := Nat.choose_le_pow _ _
        calc ((U.card.choose m : ℕ) : ℝ≥0∞) * 2 ^ m ≤ ((U.card ^ m : ℕ) : ℝ≥0∞) * 2 ^ m := by gcongr
          _ = (((2 ^ m * U.card ^ m) : ℕ) : ℝ≥0∞) := by push_cast; ring

namespace Strategy

variable (S : Strategy α)

/-- **Everything at once**: the per-advice bound `2·(2·nPos·|K|)^{s+1}·2^{−W}`. -/
theorem prob_fresh_width_le [Fintype K] (T : K → History α → (q : Qry α) → Finset (α q.1)) (w : K → ℕ) (nPos : ℕ)
    (hT : ∀ κ h q, (T κ h q).card * (2 ^ w κ - nPos) ≤ Fintype.card (α q.1) - nPos)
    (h2 : ∀ κ, 2 * nPos ≤ 2 ^ w κ) (hX : 2 ≤ 2 * (nPos * Fintype.card K))
    {I : Type} (OnFresh : Oracle α → I → Prop) (name : Oracle α → I → ℕ × K)
    (h_distinct : ∀ π x y, OnFresh π x → OnFresh π y → x ≠ y → (name π x).1 ≠ (name π y).1)
    (h_fresh : ∀ π x, OnFresh π x →
      ∃ q, S.next (S.hist π (name π x).1) = some q ∧ Fresh (S.hist π (name π x).1) q)
    (h_target : ∀ π x q, OnFresh π x → S.next (S.hist π (name π x).1) = some q →
      ans π q ∈ T (name π x).2 (S.hist π (name π x).1) q)
    (h_lt : ∀ π x, OnFresh π x → (name π x).1 < nPos)
    (s W : ℕ) (Win : Oracle α → Prop)
    (hwin : ∀ π, Win π → ∃ X : Finset I, (∀ x ∈ X, OnFresh π x) ∧ X.card ≤ s + 1 ∧
      W ≤ ∑ x ∈ X, w (name π x).2) :
    prob Win ≤ 2 * (((2 * (nPos * Fintype.card K)) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ W := by
  classical
  have hwin' : ∀ π, Win π → ∃ X : Finset I, (∀ x ∈ X, OnFresh π x) ∧ widthAdm w s W (X.image (name π)) := by
    intro π hπ
    obtain ⟨X, hX, hc, hW⟩ := hwin π hπ
    have hinj : Set.InjOn (name π) X := fun x hx y hy hxy => by
      by_contra hne
      exact h_distinct π x y (hX x hx) (hX y hy) hne (congrArg Prod.fst hxy)
    refine ⟨X, hX, (Finset.card_image_le).trans hc, ?_⟩
    rw [Finset.sum_image fun x hx y hy h => hinj hx hy h]
    exact hW
  refine (S.prob_fresh_le T w nPos hT OnFresh name h_distinct h_fresh h_target h_lt _ Win hwin').trans
    ((sum_patterns_le w nPos s W h2).trans ?_)
  rw [← Finset.sum_mul]
  gcongr
  have := sum_range_pow_le hX s
  calc ∑ m ∈ Finset.range (s + 2), (((2 * (nPos * Fintype.card K)) ^ m : ℕ) : ℝ≥0∞)
      = ((∑ m ∈ Finset.range (s + 2), (2 * (nPos * Fintype.card K)) ^ m : ℕ) : ℝ≥0∞) := by push_cast; rfl
    _ ≤ ((2 * (2 * (nPos * Fintype.card K)) ^ (s + 1) : ℕ) : ℝ≥0∞) := by exact_mod_cast this
    _ = 2 * (((2 * (nPos * Fintype.card K)) ^ (s + 1) : ℕ) : ℝ≥0∞) := by push_cast; ring

end Strategy

end Bridge

end LazyPerm

end


/-! ════ LazyPermDecide ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Deciding steps, semantic reads, and slot tables

Generic in the oracle family and the strategy. These are the three tools a client needs to discharge the bridge
(`LazyPermFresh`) when its items are honest values that are fixed lazily.

- **Deciding steps.** A point `x` of component `i` is *decided* at the first step whose history fixes it.
  `first_fix`: that step asks `π i x` forward or `(π i)⁻¹ (π i x)` inverse, and the query is `Fresh`.
  `exists_first_fix`: every point fixed by step `N` has a deciding step `< N`.
- **Semantic reads** (`readAt`). A target `T κ h q` sees only the history. At a step that asks a query, the history's
  length is the step (`length_hist_of_next`). So any quantity that the history at that step determines can be read as
  "its value under some oracle with this history" (`readAt_eq`). A client can define targets from honest values and
  from queries of the current round without a history interpreter.
- **Slot tables** (`prob_fresh_slots_le`). The bridge with the targets, freshness and names indexed by a finite table
  `σ : Sig`. The union over `σ` costs `|Sig|`. A table records steps that several items share (for instance, one show
  that pins coordinates in many samples), so they are paid for once rather than in every name.
-/

namespace LazyPerm

open scoped ENNReal

variable {ι : Type} {α : ι → Type}

namespace Strategy

variable (S : Strategy α)

/-- **At a step that asks a query, the history has one entry per earlier step.** -/
theorem length_hist_or_stop (π : Oracle α) (j : ℕ) :
    (S.hist π j).length = j ∨ S.next (S.hist π j) = none := by
  induction j with
  | zero => exact Or.inl rfl
  | succ j ih =>
    cases hq : S.next (S.hist π j) with
    | none =>
      rw [S.hist_succ_of_none hq]
      exact Or.inr hq
    | some q =>
      rw [S.hist_succ_of_some hq, List.length_append, List.length_singleton]
      rcases ih with ih | ih
      · exact Or.inl (by rw [ih])
      · rw [hq] at ih; cases ih

theorem length_hist_of_next {π : Oracle α} {j : ℕ} {q : Qry α} (h : S.next (S.hist π j) = some q) :
    (S.hist π j).length = j :=
  (S.length_hist_or_stop π j).resolve_right (by rw [h]; simp)

/-- **An equal history at step `j` means equal histories at every earlier step** (the prefix corollary; for
labeller-phase steps it gives the whole thread phase). -/
theorem hist_eq_of_le {π π' : Oracle α} {j m : ℕ} (h : S.hist π' j = S.hist π j) (hm : m ≤ j) :
    S.hist π' m = S.hist π m :=
  S.hist_congr (fun e he => (S.mem_hist (h ▸ he : e ∈ S.hist π' j)).symm) hm

variable [DecidableEq ι] [∀ i, DecidableEq (α i)]

theorem dom_mono (π : Oracle α) {m n : ℕ} (h : m ≤ n) (i : ι) : (S.hist π m).dom i ⊆ (S.hist π n).dom i := by
  intro x hx
  obtain ⟨e, he, hx⟩ := History.mem_dom.1 hx
  exact History.mem_dom.2 ⟨e, (S.hist_prefix π h).subset he, hx⟩

/-- **In a consistent history, a point is fixed iff its image is.** -/
theorem mem_dom_iff_mem_rng (π : Oracle α) (j : ℕ) (i : ι) (x : α i) :
    x ∈ (S.hist π j).dom i ↔ π i x ∈ (S.hist π j).rng i := by
  constructor
  · intro hx
    obtain ⟨e, he, hx⟩ := History.mem_dom.1 hx
    refine History.mem_rng.2 ⟨e, he, ?_⟩
    rw [Entry.outAt_eq_map (S.mem_hist he), hx, Option.map_some]
  · intro hy
    obtain ⟨e, he, hy⟩ := History.mem_rng.1 hy
    rw [Entry.outAt_eq_map (S.mem_hist he)] at hy
    obtain ⟨x', hx', hxx⟩ := Option.map_eq_some_iff.1 hy
    rw [(π i).injective hxx] at hx'
    exact History.mem_dom.2 ⟨e, he, hx'⟩

/-- **The deciding step.** The first step whose history fixes `x` asks `x` forward or `π i x` inverse, freshly. -/
theorem first_fix {π : Oracle α} {j : ℕ} {i : ι} {x : α i} (h0 : x ∉ (S.hist π j).dom i)
    (h1 : x ∈ (S.hist π (j + 1)).dom i) :
    ∃ q, S.next (S.hist π j) = some q ∧ Fresh (S.hist π j) q ∧
      (q = ⟨i, .inl x⟩ ∨ q = ⟨i, .inr (π i x)⟩) := by
  cases hq : S.next (S.hist π j) with
  | none => rw [S.hist_succ_of_none hq] at h1; exact absurd h1 h0
  | some q =>
    rw [S.hist_succ_of_some hq] at h1
    obtain ⟨e, he, hx⟩ := History.mem_dom.1 h1
    rcases List.mem_append.1 he with he | he
    · exact absurd (History.mem_dom.2 ⟨e, he, hx⟩) h0
    rw [List.mem_singleton] at he
    subst he
    obtain ⟨k, d⟩ := q
    unfold Entry.inpAt at hx
    split_ifs at hx with hk
    subst hk
    simp only [Option.some_inj] at hx
    refine ⟨_, rfl, ?_, ?_⟩
    · cases d with
      | inl x' =>
        simp only [Entry.inp] at hx
        subst hx
        exact h0
      | inr y =>
        simp only [Entry.inp, ans] at hx
        have hy : y = π k x := by rw [← hx, Equiv.apply_symm_apply]
        show y ∉ (S.hist π j).rng k
        rw [hy, ← S.mem_dom_iff_mem_rng]
        exact h0
    · cases d with
      | inl x' =>
        simp only [Entry.inp] at hx
        exact Or.inl (by rw [hx])
      | inr y =>
        simp only [Entry.inp, ans] at hx
        exact Or.inr (by rw [← hx, Equiv.apply_symm_apply])

/-- **Every point fixed by step `N` has a deciding step before `N`.** -/
theorem exists_first_fix {π : Oracle α} {N : ℕ} {i : ι} {x : α i} (hN : x ∈ (S.hist π N).dom i) :
    ∃ j < N, x ∉ (S.hist π j).dom i ∧ x ∈ (S.hist π (j + 1)).dom i := by
  classical
  have hex : ∃ j, x ∈ (S.hist π (j + 1)).dom i := by
    rcases N with _ | N
    · simp [hist, History.dom] at hN
    · exact ⟨N, hN⟩
  obtain ⟨j, hj, hmin⟩ : ∃ j, x ∈ (S.hist π (j + 1)).dom i ∧ ∀ j' < j, x ∉ (S.hist π (j' + 1)).dom i :=
    ⟨Nat.find hex, Nat.find_spec hex, fun _ h => Nat.find_min hex h⟩
  have h0 : x ∉ (S.hist π j).dom i := by
    rcases j with _ | j'
    · simp [hist, History.dom]
    · exact hmin j' (by omega)
  refine ⟨j, ?_, h0, hj⟩
  by_contra hlt
  exact h0 (S.dom_mono π (by omega) i hN)

end Strategy

/-! ## Semantic reads -/

section Read

variable (S : Strategy α)

open Classical in
/-- **The value of `F` under some oracle whose history at step `|h|` is `h`** (`default` if there is none). -/
noncomputable def readAt {β : Type} [Inhabited β] (h : History α) (F : Oracle α → β) : β :=
  if hex : ∃ π, S.hist π h.length = h then F (Classical.choose hex) else default

/-- **A semantic read is exact** when the history at its step determines `F`. -/
theorem readAt_eq {β : Type} [Inhabited β] (F : Oracle α → β) {π : Oracle α} {j : ℕ}
    (hdet : ∀ π', S.hist π' j = S.hist π j → F π' = F π) (hlen : (S.hist π j).length = j) :
    readAt S (S.hist π j) F = F π := by
  classical
  unfold readAt
  split_ifs with hex
  · exact hdet _ ((congrArg (S.hist (Classical.choose hex)) hlen.symm).trans (Classical.choose_spec hex))
  · exact absurd ⟨π, congrArg (S.hist π) hlen⟩ hex

open Classical in
/-- **A semantic read restricted to the oracles satisfying `P`** (for instance, those that realize a slot table):
the value of `F` under some such oracle whose history at step `|h|` is `h`. -/
noncomputable def readAtP {β : Type} [Inhabited β] (h : History α) (P : Oracle α → Prop) (F : Oracle α → β) : β :=
  if hex : ∃ π, S.hist π h.length = h ∧ P π then F (Classical.choose hex) else default

/-- **A restricted read is exact** when the history at its step, together with `P`, determines `F`. -/
theorem readAtP_eq {β : Type} [Inhabited β] (P : Oracle α → Prop) (F : Oracle α → β) {π : Oracle α} {j : ℕ}
    (hP : P π) (hdet : ∀ π', S.hist π' j = S.hist π j → P π' → F π' = F π) (hlen : (S.hist π j).length = j) :
    readAtP S (S.hist π j) P F = F π := by
  classical
  unfold readAtP
  split_ifs with hex
  · have hs := Classical.choose_spec hex
    exact hdet _ ((congrArg (S.hist (Classical.choose hex)) hlen.symm).trans hs.1) hs.2
  · exact absurd ⟨π, congrArg (S.hist π) hlen, hP⟩ hex

end Read

/-! ## Round programs: a round's queries depend only on earlier rounds' answers -/

namespace RProg

variable {Q A X : Type}

theorem roundQs_ret (f : Q → A) (x : X) : ∀ ρ, (ret x : RProg Q A X).roundQs f ρ = []
  | 0 => rfl
  | ρ + 1 => roundQs_ret f x ρ

/-- **Round `ρ`'s queries depend only on the answers to the trace entries of rounds `< ρ`.** -/
theorem roundQs_congr (f f' : Q → A) :
    ∀ (P : RProg Q A X) (ρ : ℕ), (∀ e ∈ P.trace f, e.1 < ρ → f e.2 = f' e.2) → P.roundQs f ρ = P.roundQs f' ρ
  | ret x, ρ, _ => by rw [roundQs_ret, roundQs_ret]
  | round qs k, 0, _ => rfl
  | round qs k, ρ + 1, h => by
    have hqs : qs.map f = qs.map f' := List.map_congr_left fun q hq =>
      h (0, q) (List.mem_append_left _ (List.mem_map.2 ⟨q, hq, rfl⟩)) (Nat.succ_pos ρ)
    rw [roundQs_succ, roundQs_succ]
    simp only [RProg.qs, feed]
    rw [← hqs]
    refine roundQs_congr f f' (k (qs.map f)) ρ fun e he hlt => ?_
    exact h (e.1 + 1, e.2) (List.mem_append_right _ (List.mem_map.2 ⟨e, he, rfl⟩)) (by omega)

/-- **A trace's entries up to round `τ` depend only on the answers to its entries of rounds `< τ`.** -/
theorem trace_le_congr (f f' : Q → A) :
    ∀ (P : RProg Q A X) (τ : ℕ), (∀ e ∈ P.trace f, e.1 < τ → f e.2 = f' e.2) →
      (P.trace f).filter (fun e => e.1 ≤ τ) = (P.trace f').filter (fun e => e.1 ≤ τ)
  | ret _, _, _ => rfl
  | round qs k, 0, _ => by
    simp only [trace, List.filter_append, List.filter_map]
    congr 1
    · rw [List.filter_eq_nil_iff.2 (fun e _ => by simp), List.filter_eq_nil_iff.2 (fun e _ => by simp)]
  | round qs k, τ + 1, h => by
    have hqs : qs.map f = qs.map f' := List.map_congr_left fun q hq =>
      h (0, q) (List.mem_append_left _ (List.mem_map.2 ⟨q, hq, rfl⟩)) (Nat.succ_pos τ)
    simp only [trace, List.filter_append, List.filter_map]
    rw [← hqs]
    congr 1
    have ih := trace_le_congr f f' (k (qs.map f)) τ fun e he hlt =>
      h (e.1 + 1, e.2) (List.mem_append_right _ (List.mem_map.2 ⟨e, he, rfl⟩)) (by omega)
    have hc : ((fun e : ℕ × Q => decide (e.1 ≤ τ + 1)) ∘ fun e : ℕ × Q => (e.1 + 1, e.2)) =
        fun e : ℕ × Q => decide (e.1 ≤ τ) := by
      funext e; simp
    rw [hc, ih]

end RProg

section OfRoundsDet

variable {θ Q A X : Type} [DecidableEq θ]

/-- **Round `ρ`'s queries are fixed by the history at any step past the earlier rounds.** Under a second oracle
with the same history at step `j`, every thread asks the same round-`ρ` queries, provided `j` lies past the
queries of rounds `< ρ` and within the thread phase. -/
theorem ofRounds_roundQs_det {ths : List θ} (hnd : ths.Nodup) {D : ℕ} {P : θ → RProg Q A X} {enc : Q → Qry α}
    {dec : Entry α → A} {tail : History α → Option (Qry α)} {π π' : Oracle α} {j ρ : ℕ} (hρ : ρ ≤ D)
    (hj : ((List.range ρ).flatMap fun ρ' => ths.flatMap fun t => (P t).roundQs (fun q => dec (qEntry π enc q)) ρ').length
      ≤ j)
    (hjR : j ≤ (roundsSeq ths (fun q => dec (qEntry π enc q)) D P).length)
    (hh : (Strategy.ofRounds ths D P enc dec tail).hist π' j = (Strategy.ofRounds ths D P enc dec tail).hist π j)
    {t : θ} (ht : t ∈ ths) :
    (P t).roundQs (fun q => dec (qEntry π' enc q)) ρ = (P t).roundQs (fun q => dec (qEntry π enc q)) ρ := by
  set f : Q → A := fun q => dec (qEntry π enc q)
  set S := Strategy.ofRounds ths D P enc dec tail
  refine (RProg.roundQs_congr f _ (P t) ρ fun e he hlt => ?_).symm
  have hq : e.2 ∈ (P t).roundQs f e.1 := by
    rw [RProg.roundQs_eq_trace]
    exact List.mem_filterMap.2 ⟨e, he, by simp⟩
  let g : ℕ → List Q := fun ρ' => ths.flatMap fun t => (P t).roundQs f ρ'
  have hpre : e.2 ∈ (List.range ρ).flatMap g :=
    List.mem_flatMap.2 ⟨e.1, List.mem_range.2 hlt, List.mem_flatMap.2 ⟨t, ht, hq⟩⟩
  have hR : roundsSeq ths f D P = (List.range ρ).flatMap g ++ ((List.range (D - ρ)).map (ρ + ·)).flatMap g := by
    rw [roundsSeq_eq hnd f D P]
    conv_lhs => rw [show D = ρ + (D - ρ) by omega, List.range_add, List.flatMap_append]
  have htake : e.2 ∈ (roundsSeq ths f D P).take j := by
    rw [hR, List.take_append, List.take_of_length_le hj]
    exact List.mem_append_left _ hpre
  have hmem : qEntry π enc e.2 ∈ S.hist π' j := by
    rw [hh, Strategy.ofRounds_hist ths D P enc dec tail π j hjR]
    exact List.mem_map.2 ⟨e.2, htake, rfl⟩
  have hans : ans π (enc e.2) = ans π' (enc e.2) := S.mem_hist hmem
  show dec ⟨enc e.2, ans π (enc e.2)⟩ = dec ⟨enc e.2, ans π' (enc e.2)⟩
  rw [hans]

end OfRoundsDet

/-! ## Pinned targets: agreement with a constant on a set of positions -/

section Pin

/-- The functions that agree with `c` on `S`. -/
def agreeSet {X : Type} [Fintype X] [DecidableEq X] (S : Finset X) (c : X → Bool) : Finset (X → Bool) :=
  Finset.univ.filter fun f => ∀ x ∈ S, f x = c x

/-- **Agreeing on `S` fixes `|S|` bits**: `2^{|X| − |S|}` functions. -/
theorem card_agreeSet {X : Type} [Fintype X] [DecidableEq X] (S : Finset X) (c : X → Bool) :
    (agreeSet S c).card = 2 ^ (Fintype.card X - S.card) := by
  classical
  let e : {f : X → Bool // ∀ x ∈ S, f x = c x} ≃ ({x // x ∉ S} → Bool) :=
    { toFun := fun f x => f.1 x.1
      invFun := fun g => ⟨fun x => if hx : x ∈ S then c x else g ⟨x, hx⟩, fun x hx => by simp [hx]⟩
      left_inv := fun f => by
        apply Subtype.ext
        funext x
        by_cases hx : x ∈ S
        · simp [hx, f.2 x hx]
        · simp [hx]
      right_inv := fun g => by
        funext x
        simp [x.2] }
  have h1 : (agreeSet S c).card = Fintype.card {f : X → Bool // ∀ x ∈ S, f x = c x} := by
    rw [Fintype.card_subtype]
    rfl
  rw [h1, Fintype.card_congr e, Fintype.card_fun, Fintype.card_bool, Fintype.card_subtype_compl,
    Fintype.card_coe]

/-- **The target condition for a pinned target** (`pin_mul_le`): a target of at most `2^{B − w}` points among
`2^B`, with `w ≤ B`, satisfies the bridge's `hT`. -/
theorem pin_target_le {B w nPos t : ℕ} (hw : w ≤ B) (ht : t ≤ 2 ^ (B - w)) :
    t * (2 ^ w - nPos) ≤ 2 ^ B - nPos := by
  have hN : 2 ^ (B - w) * 2 ^ w = 2 ^ B := by rw [← pow_add, Nat.sub_add_cancel hw]
  exact (Nat.mul_le_mul_right _ ht).trans (pin_mul_le hN (Nat.one_le_two_pow) le_rfl)

end Pin

/-! ## Slot tables -/

section Slots

variable {K : Type} [DecidableEq K] [Fintype K] [Fintype ι] [DecidableEq ι] [∀ i, Fintype (α i)] [∀ i, DecidableEq (α i)]
  (S : Strategy α)

/-- **The bridge over a slot table**: targets, freshness and names indexed by `σ : Sig`, each satisfying the
bridge's hypotheses, and a win that supplies some `σ` with its items. The union over `σ` costs `|Sig|`. -/
theorem Strategy.prob_fresh_slots_le {Sig : Type} [Fintype Sig]
    (T : Sig → K → History α → (q : Qry α) → Finset (α q.1)) (w : K → ℕ) (nPos : ℕ)
    (hT : ∀ σ κ h q, (T σ κ h q).card * (2 ^ w κ - nPos) ≤ Fintype.card (α q.1) - nPos)
    (h2 : ∀ κ, 2 * nPos ≤ 2 ^ w κ) (hX : 2 ≤ 2 * (nPos * Fintype.card K))
    {I : Type} (OnFresh : Sig → Oracle α → I → Prop) (name : Sig → Oracle α → I → ℕ × K)
    (h_distinct : ∀ σ π x y, OnFresh σ π x → OnFresh σ π y → x ≠ y → (name σ π x).1 ≠ (name σ π y).1)
    (h_fresh : ∀ σ π x, OnFresh σ π x →
      ∃ q, S.next (S.hist π (name σ π x).1) = some q ∧ Fresh (S.hist π (name σ π x).1) q)
    (h_target : ∀ σ π x q, OnFresh σ π x → S.next (S.hist π (name σ π x).1) = some q →
      ans π q ∈ T σ (name σ π x).2 (S.hist π (name σ π x).1) q)
    (h_lt : ∀ σ π x, OnFresh σ π x → (name σ π x).1 < nPos)
    (s W : ℕ) (Win : Oracle α → Prop)
    (hwin : ∀ π, Win π → ∃ σ, ∃ X : Finset I, (∀ x ∈ X, OnFresh σ π x) ∧ X.card ≤ s + 1 ∧
      W ≤ ∑ x ∈ X, w (name σ π x).2) :
    prob Win ≤ (Fintype.card Sig : ℝ≥0∞) *
      (2 * (((2 * (nPos * Fintype.card K)) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ W) := by
  classical
  let WinS : Sig → Oracle α → Prop := fun σ π => ∃ X : Finset I, (∀ x ∈ X, OnFresh σ π x) ∧ X.card ≤ s + 1 ∧
    W ≤ ∑ x ∈ X, w (name σ π x).2
  refine (prob_mono (F := fun π => ∃ σ ∈ (Finset.univ : Finset Sig), WinS σ π) fun π hπ => ?_).trans
    ((prob_exists_le _ WinS).trans ?_)
  · obtain ⟨σ, hσ⟩ := hwin π hπ
    exact ⟨σ, Finset.mem_univ _, hσ⟩
  · refine (Finset.sum_le_sum fun σ _ => S.prob_fresh_width_le (T σ) w nPos (hT σ) h2 hX (OnFresh σ) (name σ)
      (h_distinct σ) (h_fresh σ) (h_target σ) (h_lt σ) s W (WinS σ) fun π h => h).trans (le_of_eq ?_)
    rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

end Slots

end LazyPerm

end


/-! ════ P3Concrete.P3ChainClient ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The P3 client side of the fresh-prediction bridge, and `P3ChainEPF` from it

`P3Client Bad` is the P3-specific obligation of `proof-technique-decision.md`, stated in the bridge's own terms
(`LazyPermFresh`, `LazyPermDecide`), for each replay `R` (fixed advice) and saving `s ≤ n`. It asks for kinds `K`, slot
tables `Sig`, items `I`, targets `T σ`, widths `w`, a charge predicate `OnFresh σ` and π-dependent names `name σ`, on
P3's lazy strategy `strategy R (finRange n)`, such that:
- **`hT`, `h2`, `hX`**: the targets are pinned (`pin_mul_le` form, `nPos = nPosC n Q`), every width is at least
  `log₂ (2·nPosC)`, and the kind count is nontrivial;
- **`h_distinct`**: charged items have distinct steps. Coordinates pinned by one sample form one item;
- **`h_fresh`**: the charged query is `Fresh`;
- **`h_target`**: the charged answer lands in the target;
- **`h_lt`**: every step is below `nPosC`;
- **`hfit`**: the RHS fit. The naming cost `2·|Sig|·(2·nPosC·|K|)^{m+1}` is at most `nPosC^{14n}·2^{n·wc}`, which is
  the target's positions plus its one-label slack;
- **`hwin`**: an online holding priced at least `s·n` columns, without collision, yields a slot table `σ` and at most
  `m + 1` charged items of total width at least `s·n·wc`.

**Why slot tables.** One P3 guess can pin coordinates in `n` different samples (a guessed `pin2_u` pins column `u`
of every lower label). Naming its show once in `σ`, rather than in every item, is what keeps the fit linear in the
number of guesses (`internal/p3-instantiation/p3-attribution-design.md` §1).

**The results.**
- `freshTail_of_client : P3Client Bad → FreshTail Bad`: the bridge over slot tables (`Strategy.prob_fresh_slots_le`),
  moved to `P3COmega` by `pr_transport'`, plus the arithmetic.
- `p3ChainEPF_of_client : P3Client Bad → CollBound Bad → P3ChainEPF`: with `p3ChainEPF_of_tail`.
- `lazy_factor_top`: (C1) is needed by this technique (not by P3).
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm
open scoped ENNReal

/-- **The P3 client obligation**, per replay and saving, in the bridge's terms. -/
def P3Client (Bad : BadEv) : Prop :=
  ∀ (n wc s : ℕ) (R : P3Replay n wc (Fin n)), 0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * nPosC n R.Q ≤ 2 ^ wc → s ≤ n →
    (∀ v, (R.A v).Bounded R.D R.Q) →
    ∃ (K : Type) (hKf : Fintype K) (_ : DecidableEq K) (Sig : Type) (hSf : Fintype Sig) (I : Type)
      (T : Sig → K → History (P3Alpha n wc) → (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1)) (w : K → ℕ)
      (OnFresh : Sig → Oracle (P3Alpha n wc) → I → Prop) (name : Sig → Oracle (P3Alpha n wc) → I → ℕ × K) (m : ℕ),
      -- `hT`: pinned targets
      (∀ σ κ h q, (T σ κ h q).card * (2 ^ w κ - nPosC n R.Q) ≤ Fintype.card (P3Alpha n wc q.1) - nPosC n R.Q) ∧
      -- `h2`, `hX`
      (∀ κ, 2 * nPosC n R.Q ≤ 2 ^ w κ) ∧ 2 ≤ 2 * (nPosC n R.Q * @Fintype.card K hKf) ∧
      -- `h_distinct`: independence per component sample
      (∀ σ π x y, OnFresh σ π x → OnFresh σ π y → x ≠ y → (name σ π x).1 ≠ (name σ π y).1) ∧
      -- `h_fresh`: the charged query is `Fresh`
      (∀ σ π x, OnFresh σ π x →
        ∃ q, (strategy R (List.finRange n)).next ((strategy R (List.finRange n)).hist π (name σ π x).1) = some q ∧
          Fresh ((strategy R (List.finRange n)).hist π (name σ π x).1) q) ∧
      -- `h_target`
      (∀ σ π x q, OnFresh σ π x →
        (strategy R (List.finRange n)).next ((strategy R (List.finRange n)).hist π (name σ π x).1) = some q →
          ans π q ∈ T σ (name σ π x).2 ((strategy R (List.finRange n)).hist π (name σ π x).1) q) ∧
      -- `h_lt`: steps below `nPosC`
      (∀ σ π x, OnFresh σ π x → (name σ π x).1 < nPosC n R.Q) ∧
      -- `hfit`: the RHS fit, slot tables included
      (2 * @Fintype.card Sig hSf * (2 * (nPosC n R.Q * @Fintype.card K hKf)) ^ (m + 1) ≤
        nPosC n R.Q ^ (14 * n) * 2 ^ (n * wc)) ∧
      -- `hwin`: some slot table and at most `m + 1` charged items of total width `s·n·wc`
      (∀ π, (((s : ℚ) * n ≤ (R.onlineH ((omegaEquiv n wc).symm π) (R.D + 1)).size 512 wc) ∧
          ¬ Bad R.tag R.G R.W ((omegaEquiv n wc).symm π)) →
        ∃ σ, ∃ X : Finset I, (∀ x ∈ X, OnFresh σ π x) ∧ X.card ≤ m + 1 ∧ s * (n * wc) ≤ ∑ x ∈ X, w (name σ π x).2)

/-- **(C1) is what this technique needs, not a property of P3.** If a column does not exceed the positions,
`2^wc ≤ nPos`, a one-column item's lazy-sampling factor in `Strategy.prob_pattern_le` is `⊤`, so the fresh-prediction
bound says nothing. `h2` at a one-column kind is (C1) itself. -/
theorem lazy_factor_top {wc nPos : ℕ} (h : 2 ^ wc ≤ nPos) : (((2 ^ wc - nPos : ℕ) : ℝ≥0∞))⁻¹ = ⊤ := by
  rw [Nat.sub_eq_zero_of_le h, Nat.cast_zero, ENNReal.inv_zero]

theorem prob_le_one' {Ω : Type} [Fintype Ω] (E : Ω → Prop) : LazyPerm.prob E ≤ 1 := by
  classical
  unfold LazyPerm.prob
  apply ENNReal.div_le_of_le_mul
  rw [one_mul]
  exact_mod_cast Finset.card_le_univ _

theorem nPosC_pos {n Q : ℕ} (hn : 0 < n) : 1 ≤ nPosC n Q := by
  unfold nPosC
  nlinarith

/-- **The compression from the client side**: the bridge's closed form, on `P3COmega`. -/
theorem freshTail_of_client (Bad : BadEv) (hC : P3Client Bad) : FreshTail Bad := by
  intro n wc s R hn hwc hn255 hC1 hsn hA
  have hN1 : 1 ≤ nPosC n R.Q := nPosC_pos hn
  rcases Nat.eq_zero_or_pos s with rfl | hs
  · -- `s = 0`: the right side is at least 1
    rw [pr_eq_prob]
    refine (prob_le_one' _).trans ?_
    rw [show (0 - 1) * (n * wc) = 0 by simp, pow_zero, div_one]
    exact_mod_cast Nat.one_le_pow _ _ hN1
  obtain ⟨K, hKf, hKd, Sig, hSf, I, T, w, OnFresh, name, m, hT, h2, hX, hd, hf, ht, hl, hfit, hwin⟩ :=
    hC n wc s R hn hwc hn255 hC1 hsn hA
  let _ : Fintype K := hKf
  let _ : DecidableEq K := hKd
  let _ : Fintype Sig := hSf
  rw [pr_transport' n wc]
  refine ((strategy R (List.finRange n)).prob_fresh_slots_le T w (nPosC n R.Q) hT h2 hX OnFresh name hd hf ht hl
    m (s * (n * wc)) _ hwin).trans ?_
  have hfit' : (Fintype.card Sig : ℝ≥0∞) * (2 * (((2 * (nPosC n R.Q * Fintype.card K)) ^ (m + 1) : ℕ) : ℝ≥0∞)) ≤
      ((nPosC n R.Q ^ (14 * n) : ℕ) : ℝ≥0∞) * 2 ^ (n * wc) := by
    have : ((2 * Fintype.card Sig * (2 * (nPosC n R.Q * Fintype.card K)) ^ (m + 1) : ℕ) : ℝ≥0∞) ≤
        ((nPosC n R.Q ^ (14 * n) * 2 ^ (n * wc) : ℕ) : ℝ≥0∞) := by exact_mod_cast hfit
    push_cast at this ⊢
    calc (Fintype.card Sig : ℝ≥0∞) * (2 * (2 * ((nPosC n R.Q : ℝ≥0∞) * Fintype.card K)) ^ (m + 1))
        = 2 * Fintype.card Sig * (2 * ((nPosC n R.Q : ℝ≥0∞) * Fintype.card K)) ^ (m + 1) := by ring
      _ ≤ _ := this
  calc (Fintype.card Sig : ℝ≥0∞) * (2 * (((2 * (nPosC n R.Q * Fintype.card K)) ^ (m + 1) : ℕ) : ℝ≥0∞) *
        (2⁻¹ : ℝ≥0∞) ^ (s * (n * wc)))
      = (Fintype.card Sig : ℝ≥0∞) * (2 * (((2 * (nPosC n R.Q * Fintype.card K)) ^ (m + 1) : ℕ) : ℝ≥0∞)) *
          (2⁻¹ : ℝ≥0∞) ^ (s * (n * wc)) := by ring
    _ ≤ ((nPosC n R.Q ^ (14 * n) : ℕ) : ℝ≥0∞) * 2 ^ (n * wc) * (2⁻¹ : ℝ≥0∞) ^ (s * (n * wc)) := by gcongr
    _ = ((nPosC n R.Q ^ (14 * n) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ ((s - 1) * (n * wc)) := by
        rw [mul_assoc, PousP3Base.two_pow_mul_inv_pow _ _ (Nat.le_mul_of_pos_left _ hs), Nat.sub_one_mul]
    _ = ((nPosC n R.Q ^ (14 * n) : ℕ) : ℝ≥0∞) / 2 ^ ((s - 1) * (n * wc)) := by
        rw [div_eq_mul_inv, ENNReal.inv_pow]

/-- **`P3ChainEPF` from the client side and the collision bound.** -/
theorem p3ChainEPF_of_client (Bad : BadEv) (hC : P3Client Bad) (hB : CollBound Bad) : P3ChainEPF :=
  p3ChainEPF_of_tail Bad (freshTail_of_client Bad hC) hB

end Pous.P3Concrete

end


/-! ════ P3ConcreteMulti.JointClient ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The 14 GB client side of the fresh-prediction bridge, and `P3ChainEPFMulti` from it

The joint counterpart of bc-58ec406e's `P3ChainClient`/`P3ChainAssembly`, on the joint strategy (`jointStrategy`: all
`N·n` programs, then all `N` labellers).

- **`JointFreshTail`, the joint compression for one fixed family.** Every segment's online holding (against all
  segments' reveals, `segReplay`) is priced at least `s·n` columns, off `JBad`, with probability at most
  `N·(N·nPosC)^{14nN} / 2^{N(s−1)·n·wc}`. As in bc-58ec406e's `FreshTail` (their §7), only `s ≤ n` is asked: the
  naming budget caps the item count, and `s = k − X ≤ n` is all the assembly uses (a segment cannot win more than
  its `n` tops).
- **`P3JointClient`, the client obligation in the bridge's terms**, per family and saving: items, kinds, targets,
  widths, online freshness and names on `jointStrategy`, with the named steps below `N·nPosC`, and
  - `hfit`: the naming cost `2·(2·N·nPosC·|K|)^{m+1}` is at most `N·(N·nPosC)^{14nN}·2^{N·n·wc}` (the target's joint
    positions and one label of slack per segment);
  - `hwin`: every segment's online holding priced at least `s·n`, off `JBad`, yields at most `m + 1` fresh items of
    total width at least `N·s·n·wc`.
- **The results.** `jointFreshTail_of_client` (the bridge's `prob_fresh_width_le`, moved to `P3COmega`),
  `p3ChainCountMulti_of_tail` (a joint win prices every segment, `joint_win_price`), and so
  `p3ChainEPFMulti_of_client` and, at `N = 1`, `p3ChainEPF_of_jointClient`.
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete LazyPerm
open scoped ENNReal

/-- **The joint compression, for one fixed family.** -/
def JointFreshTail : Prop :=
  ∀ (N n wc D Q s : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → 1 ≤ N → Function.Injective tags → (∀ t v, (A t v).Bounded D Q) → s ≤ n →
    pr (fun ω => (∀ t : Fin N, (s : ℚ) * n ≤ ((segReplay A tags G W D Q t).onlineH ω (D + 1)).size 512 wc) ∧
        ¬ JBad tags G W ω)
      ≤ (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (s - 1) * (n * wc))

/-- **The joint client obligation**, per family and saving, in the bridge's terms. -/
def P3JointClient : Prop :=
  ∀ (N n wc D Q s : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → 1 ≤ N → Function.Injective tags → (∀ t v, (A t v).Bounded D Q) → s ≤ n →
    ∃ (K : Type) (hKf : Fintype K) (_ : DecidableEq K) (I : Type)
      (T : K → History (P3Alpha n wc) → (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1)) (w : K → ℕ)
      (OnFresh : Oracle (P3Alpha n wc) → I → Prop) (name : Oracle (P3Alpha n wc) → I → ℕ × K) (m : ℕ),
      -- `hT`: pinned targets
      (∀ κ h q, (T κ h q).card * (2 ^ w κ - N * nPosC n Q) ≤ Fintype.card (P3Alpha n wc q.1) - N * nPosC n Q) ∧
      -- `h2`, `hX`
      (∀ κ, 2 * (N * nPosC n Q) ≤ 2 ^ w κ) ∧ 2 ≤ 2 * (N * nPosC n Q * @Fintype.card K hKf) ∧
      -- `h_distinct`
      (∀ π x y, OnFresh π x → OnFresh π y → x ≠ y → (name π x).1 ≠ (name π y).1) ∧
      -- `h_fresh`
      (∀ π x, OnFresh π x →
        ∃ q, (jointStrategy A tags G W D).next ((jointStrategy A tags G W D).hist π (name π x).1) = some q ∧
          Fresh ((jointStrategy A tags G W D).hist π (name π x).1) q) ∧
      -- `h_target`
      (∀ π x q, OnFresh π x →
        (jointStrategy A tags G W D).next ((jointStrategy A tags G W D).hist π (name π x).1) = some q →
          ans π q ∈ T (name π x).2 ((jointStrategy A tags G W D).hist π (name π x).1) q) ∧
      -- `h_lt`: steps below `N·nPosC`
      (∀ π x, OnFresh π x → (name π x).1 < N * nPosC n Q) ∧
      -- `hfit`
      (2 * (2 * (N * nPosC n Q * @Fintype.card K hKf)) ^ (m + 1) ≤
        N * (N * nPosC n Q) ^ (14 * n * N) * 2 ^ (N * (n * wc))) ∧
      -- `hwin`
      (∀ π, ((∀ t : Fin N, (s : ℚ) * n ≤
            ((segReplay A tags G W D Q t).onlineH ((omegaEquiv n wc).symm π) (D + 1)).size 512 wc) ∧
          ¬ JBad tags G W ((omegaEquiv n wc).symm π)) →
        ∃ X : Finset I, (∀ x ∈ X, OnFresh π x) ∧ X.card ≤ m + 1 ∧ N * s * (n * wc) ≤ ∑ x ∈ X, w (name π x).2)

theorem nPosCJ_pos {N n Q : ℕ} (hN : 1 ≤ N) (hn : 0 < n) : 1 ≤ N * nPosC n Q :=
  Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by have := nPosC_pos (Q := Q) hn; omega))

/-- **The joint compression from the client side**: the bridge's closed form, on `P3COmega`. -/
theorem jointFreshTail_of_client (hC : P3JointClient) : JointFreshTail := by
  intro N n wc D Q s tags G W A hn hwc hn255 hC1 hN htags hA hsn
  have hN1 : 1 ≤ N * nPosC n Q := nPosCJ_pos hN hn
  rcases Nat.eq_zero_or_pos s with rfl | hs
  · -- `s = 0`: the right side is at least 1
    rw [pr_eq_prob]
    refine (prob_le_one' _).trans ?_
    rw [show N * (0 - 1) * (n * wc) = 0 by simp, pow_zero, div_one]
    have h1 : (1 : ℝ≥0∞) ≤ (N : ℝ≥0∞) := by exact_mod_cast hN
    have h2 : (1 : ℝ≥0∞) ≤ (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) := by
      exact_mod_cast Nat.one_le_pow _ _ hN1
    calc (1 : ℝ≥0∞) = 1 * 1 := (one_mul 1).symm
      _ ≤ _ := mul_le_mul' h1 h2
  obtain ⟨K, hKf, hKd, I, T, w, OnFresh, name, m, hT, h2, hX, hd, hf, ht, hl, hfit, hwin⟩ :=
    hC N n wc D Q s tags G W A hn hwc hn255 hC1 hN htags hA hsn
  let _ : Fintype K := hKf
  let _ : DecidableEq K := hKd
  rw [pr_transport' n wc]
  refine ((jointStrategy A tags G W D).prob_fresh_width_le T w (N * nPosC n Q) hT h2 hX OnFresh name hd hf ht hl
    m (N * s * (n * wc)) _ hwin).trans ?_
  have hfit' : (2 : ℝ≥0∞) * (((2 * (N * nPosC n Q * Fintype.card K)) ^ (m + 1) : ℕ) : ℝ≥0∞) ≤
      (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) * 2 ^ (N * (n * wc)) := by exact_mod_cast hfit
  obtain ⟨s', rfl⟩ : ∃ s', s = s' + 1 := ⟨s - 1, by omega⟩
  have hexp : N * (s' + 1) * (n * wc) = N * (n * wc) + N * s' * (n * wc) := by ring
  calc 2 * (((2 * (N * nPosC n Q * Fintype.card K)) ^ (m + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (N * (s' + 1) * (n * wc))
      ≤ (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) * 2 ^ (N * (n * wc)) *
          (2⁻¹ : ℝ≥0∞) ^ (N * (s' + 1) * (n * wc)) := by gcongr
    _ = (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (N * (s' + 1 - 1) * (n * wc)) := by
        rw [mul_assoc _ (2 ^ (N * (n * wc))), PousP3Base.two_pow_mul_inv_pow _ _ (by rw [hexp]; omega), hexp,
          Nat.add_sub_cancel_left, Nat.add_sub_cancel]
    _ = (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (s' + 1 - 1) * (n * wc)) := by
        rw [div_eq_mul_inv, ENNReal.inv_pow]

open Classical in
/-- **The joint count from the joint compression**: a joint win prices every segment's online holding at
`(k − X)·n` (`joint_win_price`). -/
theorem p3ChainCountMulti_of_tail (h : JointFreshTail) : P3ChainCountMulti := by
  intro N n wc D Q k X tags G W hn hwc hn255 hC1 hN hXk htags hard A hA
  by_cases hkn : k ≤ n
  swap
  · -- no segment wins more than its `n` tops
    have hempty : (Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω) = ∅ := by
      refine Finset.filter_eq_empty_iff.2 fun ω _ hω => hkn ?_
      exact (hω.1 ⟨0, hN⟩).trans ((Finset.card_filter_le _ _).trans (by rw [Finset.card_univ, Fintype.card_fin]))
    rw [hempty, Finset.card_empty, zero_mul]
    exact Nat.zero_le _
  have hpr := h N n wc D Q (k - X) tags G W A hn hwc hn255 hC1 hN htags hA (by omega)
  have hsub : pr (fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω) ≤
      (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (k - X - 1) * (n * wc)) :=
    (pr_mono fun ω hω => ⟨fun t => joint_win_price A tags G W D Q ω hA hard hω.1 t, hω.2⟩).trans hpr
  set E := N * (k - X - 1) * (n * wc)
  set C := N * (N * nPosC n Q) ^ (14 * n * N)
  have hΩ0 : (Fintype.card (P3COmega n wc) : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (P3COmega n wc) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2E0 : (2 : ℝ≥0∞) ^ E ≠ 0 := pow_ne_zero _ two_ne_zero
  have h2Et : (2 : ℝ≥0∞) ^ E ≠ ⊤ := ENNReal.pow_ne_top ENNReal.ofNat_ne_top
  rw [pr_def, ENNReal.div_le_iff hΩ0 hΩt] at hsub
  have hC' : (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) = ((C : ℕ) : ℝ≥0∞) := by
    simp only [C, Nat.cast_mul]
  rw [hC'] at hsub
  have hmul : ((Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card : ℝ≥0∞) * 2 ^ E ≤
      (C : ℝ≥0∞) * Fintype.card (P3COmega n wc) := by
    calc ((Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card : ℝ≥0∞) * 2 ^ E
        ≤ ((C : ℝ≥0∞) / 2 ^ E * Fintype.card (P3COmega n wc)) * 2 ^ E := by gcongr
      _ = (C : ℝ≥0∞) * Fintype.card (P3COmega n wc) := by
          rw [mul_right_comm, ENNReal.div_mul_cancel h2E0 h2Et]
  have : ((((Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card * 2 ^ E : ℕ)) : ℝ≥0∞) ≤
      ((C * Fintype.card (P3COmega n wc) : ℕ) : ℝ≥0∞) := by
    push_cast
    exact hmul
  exact_mod_cast this

/-- **The 14 GB target from the joint client obligation.** -/
theorem p3ChainEPFMulti_of_client (hC : P3JointClient) : P3ChainEPFMulti :=
  p3ChainEPFMulti_of_count (p3ChainCountMulti_of_tail (jointFreshTail_of_client hC))

/-- **The one-segment target from the joint client obligation at `N = 1`.** -/
theorem p3ChainEPF_of_jointClient (hC : P3JointClient) : P3ChainEPF :=
  p3ChainEPF_of_count (p3ChainCountMulti_of_tail (jointFreshTail_of_client hC))

/-- **The joint item obligations**: `P3JointClient` without `h_lt`, which holds for every item design
(`jointStrategy_step_lt`: every step that asks a query is below `N·nPosC`). -/
def P3JointItems : Prop :=
  ∀ (N n wc D Q s : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → 1 ≤ N → Function.Injective tags → (∀ t v, (A t v).Bounded D Q) → s ≤ n →
    ∃ (K : Type) (hKf : Fintype K) (_ : DecidableEq K) (I : Type)
      (T : K → History (P3Alpha n wc) → (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1)) (w : K → ℕ)
      (OnFresh : Oracle (P3Alpha n wc) → I → Prop) (name : Oracle (P3Alpha n wc) → I → ℕ × K) (m : ℕ),
      (∀ κ h q, (T κ h q).card * (2 ^ w κ - N * nPosC n Q) ≤ Fintype.card (P3Alpha n wc q.1) - N * nPosC n Q) ∧
      (∀ κ, 2 * (N * nPosC n Q) ≤ 2 ^ w κ) ∧ 2 ≤ 2 * (N * nPosC n Q * @Fintype.card K hKf) ∧
      (∀ π x y, OnFresh π x → OnFresh π y → x ≠ y → (name π x).1 ≠ (name π y).1) ∧
      (∀ π x, OnFresh π x →
        ∃ q, (jointStrategy A tags G W D).next ((jointStrategy A tags G W D).hist π (name π x).1) = some q ∧
          Fresh ((jointStrategy A tags G W D).hist π (name π x).1) q) ∧
      (∀ π x q, OnFresh π x →
        (jointStrategy A tags G W D).next ((jointStrategy A tags G W D).hist π (name π x).1) = some q →
          ans π q ∈ T (name π x).2 ((jointStrategy A tags G W D).hist π (name π x).1) q) ∧
      (2 * (2 * (N * nPosC n Q * @Fintype.card K hKf)) ^ (m + 1) ≤
        N * (N * nPosC n Q) ^ (14 * n * N) * 2 ^ (N * (n * wc))) ∧
      (∀ π, ((∀ t : Fin N, (s : ℚ) * n ≤
            ((segReplay A tags G W D Q t).onlineH ((omegaEquiv n wc).symm π) (D + 1)).size 512 wc) ∧
          ¬ JBad tags G W ((omegaEquiv n wc).symm π)) →
        ∃ X : Finset I, (∀ x ∈ X, OnFresh π x) ∧ X.card ≤ m + 1 ∧ N * s * (n * wc) ≤ ∑ x ∈ X, w (name π x).2)

/-- **`h_lt` is free**: the item obligations give the client obligation. -/
theorem p3JointClient_of_items (h : P3JointItems) : P3JointClient := by
  intro N n wc D Q s tags G W A hn hwc hn255 hC1 hN htags hA hsn
  obtain ⟨K, hKf, hKd, I, T, w, OnFresh, name, m, hT, h2, hX, hd, hf, ht, hfit, hwin⟩ :=
    h N n wc D Q s tags G W A hn hwc hn255 hC1 hN htags hA hsn
  refine ⟨K, hKf, hKd, I, T, w, OnFresh, name, m, hT, h2, hX, hd, hf, ht, fun π x hx => ?_, hfit, hwin⟩
  obtain ⟨q, hq, -⟩ := hf π x hx
  exact jointStrategy_step_lt A tags G W hA hq

/-- **The 14 GB target from the joint item obligations.** -/
theorem p3ChainEPFMulti_of_items (h : P3JointItems) : P3ChainEPFMulti :=
  p3ChainEPFMulti_of_client (p3JointClient_of_items h)

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.JointCombine ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The joint items from per-segment items

`P3JointItems` from one item family per segment, all on the joint strategy, with the joint item type the segment-tagged
union `Σ t, I t`. What stays per segment is exactly the one-segment design, read on the joint strategy's history:
- **`SegItems`**: segment `t`'s items with their online freshness and names, `Fresh` at the named step and the
  answer in the target (`h_distinct`, `h_fresh`, `h_target` within the segment);
- **cross-segment disjointness, off `JBad`**: fresh items of different segments are named by different steps (a step
  asks one query, which reveals one point of one component; P3's points of different segments differ: `tweak_ne` for
  `P`, and the honest chaining inputs off `JBad` for `Π₂`). The joint online freshness adds `¬ JBad`, which every win
  has;
- **per-segment wins**: each segment's online holding priced at least `s·n` yields at most `m t + 1` fresh items of
  width at least `s·n·wc`.

Then the joint win's items are the union (at most `Σ_t (m t + 1)` items, width at least `N·s·n·wc`), and the joint
`m + 1` is `Σ_t (m t + 1)` (`jointItems_of_segments`).
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete LazyPerm
open scoped ENNReal

variable {N n wc : ℕ}

/-- **One segment's items on a strategy `S`**, with the bridge's per-item obligations. -/
structure SegItems {n wc : ℕ} (S : Strategy (P3Alpha n wc)) (K : Type)
    (T : K → History (P3Alpha n wc) → (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1)) where
  /-- The items. -/
  I : Type
  /-- Online freshness. -/
  OnFresh : Oracle (P3Alpha n wc) → I → Prop
  /-- The deciding step and the kind. -/
  name : Oracle (P3Alpha n wc) → I → ℕ × K
  distinct : ∀ π x y, OnFresh π x → OnFresh π y → x ≠ y → (name π x).1 ≠ (name π y).1
  fresh : ∀ π x, OnFresh π x → ∃ q, S.next (S.hist π (name π x).1) = some q ∧ Fresh (S.hist π (name π x).1) q
  target : ∀ π x q, OnFresh π x → S.next (S.hist π (name π x).1) = some q →
    ans π q ∈ T (name π x).2 (S.hist π (name π x).1) q

/-- **The per-segment item obligations** on the joint strategy. -/
def P3SegItems : Prop :=
  ∀ (N n wc D Q s : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → 1 ≤ N → Function.Injective tags → (∀ t v, (A t v).Bounded D Q) → s ≤ n →
    ∃ (K : Type) (hKf : Fintype K) (_ : DecidableEq K)
      (T : K → History (P3Alpha n wc) → (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1)) (w : K → ℕ)
      (Dt : Fin N → SegItems (jointStrategy A tags G W D) K T) (m : Fin N → ℕ),
      -- `hT`, `h2`, `hX`
      (∀ κ h q, (T κ h q).card * (2 ^ w κ - N * nPosC n Q) ≤ Fintype.card (P3Alpha n wc q.1) - N * nPosC n Q) ∧
      (∀ κ, 2 * (N * nPosC n Q) ≤ 2 ^ w κ) ∧ 2 ≤ 2 * (N * nPosC n Q * @Fintype.card K hKf) ∧
      -- cross-segment disjointness, off `JBad`
      (∀ π t t' x y, t ≠ t' → ¬ JBad tags G W ((omegaEquiv n wc).symm π) → (Dt t).OnFresh π x →
        (Dt t').OnFresh π y → ((Dt t).name π x).1 ≠ ((Dt t').name π y).1) ∧
      -- `hfit`, with the joint item count `Σ_t (m t + 1)`
      (2 * (2 * (N * nPosC n Q * @Fintype.card K hKf)) ^ (∑ t, (m t + 1)) ≤
        N * (N * nPosC n Q) ^ (14 * n * N) * 2 ^ (N * (n * wc))) ∧
      -- per-segment wins
      (∀ π, ((∀ t : Fin N, (s : ℚ) * n ≤
            ((segReplay A tags G W D Q t).onlineH ((omegaEquiv n wc).symm π) (D + 1)).size 512 wc) ∧
          ¬ JBad tags G W ((omegaEquiv n wc).symm π)) →
        ∀ t, ∃ X : Finset (Dt t).I, (∀ x ∈ X, (Dt t).OnFresh π x) ∧ X.card ≤ m t + 1 ∧
          s * (n * wc) ≤ ∑ x ∈ X, w ((Dt t).name π x).2)

/-- **The joint item obligations from per-segment items.** -/
theorem jointItems_of_segments (h : P3SegItems) : P3JointItems := by
  classical
  intro N n wc D Q s tags G W A hn hwc hn255 hC1 hN htags hA hsn
  obtain ⟨K, hKf, hKd, T, w, Dt, m, hT, h2, hX, hcross, hfit, hwin⟩ :=
    h N n wc D Q s tags G W A hn hwc hn255 hC1 hN htags hA hsn
  have hsum : 1 ≤ ∑ t, (m t + 1) := by
    have : (m ⟨0, hN⟩ + 1) ≤ ∑ t, (m t + 1) :=
      Finset.single_le_sum (f := fun t => m t + 1) (fun _ _ => Nat.zero_le _) (Finset.mem_univ _)
    omega
  refine ⟨K, hKf, hKd, Σ t, (Dt t).I, T, w,
    fun π x => (Dt x.1).OnFresh π x.2 ∧ ¬ JBad tags G W ((omegaEquiv n wc).symm π), fun π x => (Dt x.1).name π x.2,
    (∑ t, (m t + 1)) - 1, hT, h2, hX, ?_, fun π x hx => (Dt x.1).fresh π x.2 hx.1,
    fun π x q hx hq => (Dt x.1).target π x.2 q hx.1 hq, ?_, ?_⟩
  · rintro π ⟨t, x⟩ ⟨t', y⟩ hx hy hne
    by_cases htt : t = t'
    · subst htt
      exact (Dt t).distinct π x y hx.1 hy.1 fun hxy => hne (by rw [hxy])
    · exact hcross π t t' x y htt hx.2 hx.1 hy.1
  · rwa [Nat.sub_add_cancel hsum]
  · intro π hπ
    choose X hXf hXc hXw using hwin π hπ
    refine ⟨Finset.univ.sigma X, fun x hx => ⟨hXf x.1 x.2 (Finset.mem_sigma.1 hx).2, hπ.2⟩, ?_, ?_⟩
    · rw [Finset.card_sigma, Nat.sub_add_cancel hsum]
      exact Finset.sum_le_sum fun t _ => hXc t
    · rw [Finset.sum_sigma]
      calc N * s * (n * wc) = ∑ _t : Fin N, s * (n * wc) := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul, Nat.mul_assoc]
        _ ≤ _ := Finset.sum_le_sum fun t _ => hXw t

/-- **The joint `hfit` from a one-segment fit.** If `M ≤ 14n` items fit one segment,
`2·(2·nPos·|K|)^M ≤ nPos^{14n}·2^{n·wc}`, then `Σ_t (m t + 1) ≤ N·M` items fit the joint target at `N·nPos`. -/
theorem joint_hfit_of_seg {N n wc nPos cK M : ℕ} (m : Fin N → ℕ) (hN : 1 ≤ N) (hpos : 1 ≤ nPos) (hK : 1 ≤ cK)
    (hM : M ≤ 14 * n) (hsum : ∑ t, (m t + 1) ≤ N * M)
    (hfit : 2 * (2 * (nPos * cK)) ^ M ≤ nPos ^ (14 * n) * 2 ^ (n * wc)) :
    2 * (2 * (N * nPos * cK)) ^ (∑ t, (m t + 1)) ≤ N * (N * nPos) ^ (14 * n * N) * 2 ^ (N * (n * wc)) := by
  have hb : 1 ≤ 2 * (N * nPos * cK) := by
    have : 1 ≤ N * nPos * cK := Nat.one_le_iff_ne_zero.2 (by positivity)
    omega
  -- raise the exponent to `N·M`
  calc 2 * (2 * (N * nPos * cK)) ^ (∑ t, (m t + 1)) ≤ 2 * (2 * (N * nPos * cK)) ^ (N * M) :=
        Nat.mul_le_mul_left _ (Nat.pow_le_pow_right hb hsum)
    _ = 2 * (N ^ M * (2 * (nPos * cK)) ^ M) ^ N := by
        rw [← mul_pow, mul_comm N M, pow_mul]; congr 2; ring
    _ ≤ 2 ^ N * (N ^ M * (2 * (nPos * cK)) ^ M) ^ N := by
        exact Nat.mul_le_mul_right _ (by
          calc 2 = 2 ^ 1 := rfl
            _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN)
    _ = (N ^ M * (2 * (2 * (nPos * cK)) ^ M)) ^ N := by rw [← mul_pow]; congr 1; ring
    _ ≤ (N ^ (14 * n) * (nPos ^ (14 * n) * 2 ^ (n * wc))) ^ N := by
        gcongr
    _ = (N * nPos) ^ (14 * n * N) * 2 ^ (N * (n * wc)) := by
        rw [mul_pow, mul_pow, ← pow_mul, ← pow_mul, ← pow_mul, mul_pow, ← mul_assoc]
        congr 1
        rw [mul_comm N (n * wc)]
    _ ≤ N * (N * nPos) ^ (14 * n * N) * 2 ^ (N * (n * wc)) := by
        rw [mul_assoc N]
        exact Nat.le_mul_of_pos_left _ (by omega)

/-- **The thread phase is each segment's.** Up to the end of the thread phase, the joint history is that of
bc-58ec406e's `strategy (segReplay t) (jointThreads N n)`, for every segment `t`: the two strategies differ only in
their tails. So thread-phase lemmas about `strategy R ths` hold on the joint strategy, segment by segment. -/
theorem jointStrategy_hist_eq_seg (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q : ℕ) (t : Fin N) (π : Oracle (P3Alpha n wc)) (j : ℕ)
    (hj : j ≤ (roundsSeq (jointThreads N n) (trueAns π) D fun i => toRProg (A i.1 i.2)).length) :
    (jointStrategy A tags G W D).hist π j = (strategy (segReplay A tags G W D Q t) (jointThreads N n)).hist π j := by
  rw [jointStrategy_hist A tags G W D π j hj]
  exact (Strategy.ofRounds_hist (jointThreads N n) D (fun i => toRProg (A i.1 i.2)) (enc n wc) (dec n wc)
    (tail (tags t) G (W t)) π j hj).symm

/-- **The 14 GB target from per-segment items.** -/
theorem p3ChainEPFMulti_of_segItems (h : P3SegItems) : P3ChainEPFMulti :=
  p3ChainEPFMulti_of_items (jointItems_of_segments h)

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.JointCharges ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The 14 GB bridge in the shape of the one-segment item count

bc-58ec406e proves `FreshTail` directly: a union over the cut `c` (the strategy `stratC R c`, the schedule's first `c`
queries and then the labeller), then over slot tables `σ` (`Strategy.prob_fresh_slots_le`), with uniform targets and
items that are charged steps (`p3-attribution-decided-vs-determined.md`, its addenda, and the red team's GO in
`p3-truncation-uniform-targets-redteam-verdict.md`). This file is the joint counterpart.

- **The truncated joint strategy** (`jointStratC A tags G W D c`): the joint schedule's first `c` queries, then all
  `N` labellers. Every step that asks a query is below `N·nPosC` for `c ≤ N·n·Q` (`jointStratC_step_lt`), so `h_lt`
  is free.
- **One cut for all segments.** The cut is where the *last* segment crosses. An earlier segment keeps its credits up
  to that cut, and they must all be in its table, since truncation only protects credits listed up to the cut.
  So a segment's table is not capped by the one-segment `5n + 2`. It is priced by its number `k` of whole credits:
  `3n + k` slots, `4n + 3k` charged steps, and pinned width at least `wc·n·max(s, k)`, since every whole credit is at
  least `n` columns. Extra whole credits pay for themselves under C2.
- **`P3SegCharges`**: what the one-segment count must deliver for each segment of the joint run.
- **`jointFreshTail2_of_segCharges`**: it gives the joint compression under (C1) and the multi (C2),
  `(2·N·nPosC)^40 ≤ 2^wc`, with the arithmetic proved.
-/

namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete LazyPerm
open scoped ENNReal

noncomputable section

variable {N n wc : ℕ}

/-! ## The truncated joint strategy -/

/-- **The joint strategy truncated after `c` schedule steps**: the joint schedule's first `c` queries, then all `N`
labellers (`stratC`'s joint counterpart). -/
def jointStratC (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D c : ℕ) : Strategy (P3Alpha n wc) where
  next h := if h.length < c then (jointStrategy A tags G W D).next h else tailOf (labProgJ tags G W) h

/-- **A strategy that switches to `tailOf p` at length `c`** holds at most `c + work(p)` entries: past `c`, each step
adds a new query of `p`'s true trace. -/
theorem tailOf_length_le (S : Strategy (P3Alpha n wc)) (p : Prog (p3ChainModel n wc) Unit) (c : ℕ)
    (hS : ∀ h : History (P3Alpha n wc), c ≤ h.length → S.next h = tailOf p h) (π : Oracle (P3Alpha n wc)) (j : ℕ) :
    (S.hist π j).length ≤ c + p.work (trueAns π) := by
  classical
  set T := (Tr.trace (trueAns π) p).map Prod.snd
  have hinv : ∀ j, (S.hist π j).length ≤ c ∨ ∃ (pre : History (P3Alpha n wc)) (tq : List (p3ChainModel n wc).Qry),
      S.hist π j = pre ++ tq.map (qEntry π (enc n wc)) ∧ pre.length = c ∧ tq.Nodup ∧ ∀ q ∈ tq, q ∈ T := by
    intro j
    induction j with
    | zero => exact Or.inl (by simp [Strategy.hist])
    | succ j ih =>
      cases hnext : S.next (S.hist π j) with
      | none => rw [S.hist_succ_of_none hnext]; exact ih
      | some x =>
        rw [S.hist_succ_of_some hnext]
        by_cases hlt : (S.hist π j).length < c
        · left
          rw [List.length_append, List.length_singleton]
          omega
        right
        obtain ⟨pre, tq, hh, hpre, hnd, hsub⟩ : ∃ (pre : History (P3Alpha n wc)) (tq : List (p3ChainModel n wc).Qry),
            S.hist π j = pre ++ tq.map (qEntry π (enc n wc)) ∧ pre.length = c ∧ tq.Nodup ∧ ∀ q ∈ tq, q ∈ T := by
          rcases ih with h | h
          · exact ⟨S.hist π j, [], by simp, by omega, List.nodup_nil, fun q hq => absurd hq List.not_mem_nil⟩
          · exact h
        rw [hS _ (by omega)] at hnext
        obtain ⟨q, rfl, hqT, hnew⟩ := tailOf_some p (S.hist π j) (fun e he => S.mem_hist he) hnext
        have hqtq : q ∉ tq := by
          intro hq
          have hmem : qEntry π (enc n wc) q ∈ S.hist π j := by
            rw [hh]
            exact List.mem_append_right _ (List.mem_map_of_mem hq)
          exact (histAns_none_iff _ _).1 hnew _ hmem rfl
        refine ⟨pre, tq ++ [q], ?_, hpre, hnd.append (List.nodup_singleton q) (List.disjoint_singleton.2 hqtq),
          fun q' hq' => ?_⟩
        · rw [hh]
          simp only [List.map_append, List.map_cons, List.map_nil, List.append_assoc]
          rfl
        · rcases List.mem_append.1 hq' with h1 | h1
          · exact hsub q' h1
          · rw [List.mem_singleton.1 h1]; exact hqT
  rcases hinv j with h | ⟨pre, tq, hh, hpre, hnd, hsub⟩
  · omega
  · rw [hh, List.length_append, List.length_map, hpre]
    have hle : tq.length ≤ T.length := by
      rw [← List.toFinset_card_of_nodup hnd]
      exact (Finset.card_le_card fun q hq => List.mem_toFinset.2 (hsub q (List.mem_toFinset.1 hq))).trans
        (List.toFinset_card_le _)
    have hT : T.length = p.work (trueAns π) := by rw [List.length_map, Tr.length_trace]
    omega

/-- **The truncated joint strategy holds at most `N·nPosC` entries** for `c ≤ N·n·Q`. -/
theorem jointStratC_length_le (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q c : ℕ) (hc : c ≤ N * n * Q) (π : Oracle (P3Alpha n wc))
    (j : ℕ) : ((jointStratC A tags G W D c).hist π j).length ≤ N * nPosC n Q := by
  refine (tailOf_length_le _ (labProgJ tags G W) c (fun h hh => ?_) π j).trans ?_
  · show (if h.length < c then _ else _) = _
    simp only [show ¬ h.length < c by omega, ↓reduceIte]
  · have h2 := work_labProgJ (trueAns π) tags G W
    unfold nPosC
    have : N * n * Q ≤ N * (n * (Q + 1)) := by
      rw [Nat.mul_assoc]; exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
    have e : N * (n * (Q + 1) + n * (n + 1) + 2 * n) = N * (n * (Q + 1)) + N * (n * (n + 1) + 2 * n) := by ring
    omega

/-- **`h_lt` for the truncated joint strategy**: every step that asks a query is below `N·nPosC`. -/
theorem jointStratC_step_lt (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q c : ℕ) (hc : c ≤ N * n * Q) {π : Oracle (P3Alpha n wc)}
    {j : ℕ} {q : Qry (P3Alpha n wc)} (h : (jointStratC A tags G W D c).next ((jointStratC A tags G W D c).hist π j) = some q) :
    j < N * nPosC n Q :=
  step_lt_of_length_le _ π _ (jointStratC_length_le A tags G W D Q c hc π) h

/-- **Up to the cut, the truncated joint history is the joint history.** -/
theorem jointStratC_hist_le (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D c : ℕ) (π : Oracle (P3Alpha n wc))
    (hc : c ≤ (roundsSeq (jointThreads N n) (trueAns π) D fun i => toRProg (A i.1 i.2)).length) :
    ∀ j ≤ c, (jointStratC A tags G W D c).hist π j = (jointStrategy A tags G W D).hist π j := by
  have hc' : c ≤ (roundsSeq (jointThreads N n) (fun q => dec n wc (qEntry π (enc n wc) q)) D
      fun i => toRProg (A i.1 i.2)).length := hc
  intro j
  induction j with
  | zero => intro _; rfl
  | succ j ih =>
    intro hj
    have ihj := ih (by omega)
    have hlen : ((jointStrategy A tags G W D).hist π j).length = j := by
      rw [jointStrategy_hist A tags G W D π j (by omega), List.length_map, List.length_take]
      exact min_eq_left (by omega)
    have hnext : (jointStratC A tags G W D c).next ((jointStratC A tags G W D c).hist π j) =
        (jointStrategy A tags G W D).next ((jointStrategy A tags G W D).hist π j) := by
      rw [ihj]
      show (if _ < c then _ else _) = _
      simp only [hlen, show j < c by omega, ↓reduceIte]
    cases hq : (jointStrategy A tags G W D).next ((jointStrategy A tags G W D).hist π j) with
    | none => rw [Strategy.hist_succ_of_none _ (hnext.trans hq), Strategy.hist_succ_of_none _ hq, ihj]
    | some q => rw [Strategy.hist_succ_of_some _ (hnext.trans hq), Strategy.hist_succ_of_some _ hq, ihj]

/-! ## The statements -/

/-- **The joint compression under (C1) and the multi (C2)**: `JointFreshTail` with `(2·N·nPosC)^40 ≤ 2^wc`. -/
def JointFreshTail2 : Prop :=
  ∀ (N n wc D Q s : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → (2 * (N * nPosC n Q)) ^ 40 ≤ 2 ^ wc → 1 ≤ N →
    Function.Injective tags → (∀ t v, (A t v).Bounded D Q) → s ≤ n →
    pr (fun ω => (∀ t : Fin N, (s : ℚ) * n ≤ ((segReplay A tags G W D Q t).onlineH ω (D + 1)).size 512 wc) ∧
        ¬ JBad tags G W ω)
      ≤ (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (s - 1) * (n * wc))

/-- **What the one-segment count must deliver for each segment of the joint run.**

For a fixed family and saving `s ≤ n`, with the cut `c` and the segment `t` as parameters, on the truncated joint
strategy `jointStratC A tags G W D c`:
- **Tables** `Sig` (finite), each with its number `whole σ` of whole credits. A table lists every credit of its
  segment up to the cut: at most `3n` thin groups and `whole σ` whole credits, each slot a slot name
  (`4n² + 12n + 4` of them) and a step `≤ N·nPosC`. So at most
  `((4n²+12n+4)·(N·nPosC+1))^{3n+k}` tables have `whole σ = k`.
- **Kinds** `K`, with `0 < |K| ≤ 16n³ + 16`, and widths `w κ ≥ wc` (so `h2` is (C1)).
- **Uniform targets** `T c t σ κ h q` in `pin_mul_le` form at `nPos = N·nPosC` (`card_agreeSet`).
- **Charged steps** `I`, with `OnFresh c t σ` and `name c t σ`:
  - distinct steps within a segment, and across segments off `JBad`;
  - `h_fresh` and `h_target` on `jointStratC c`, at the named step.
- **The win.** Every segment priced at least `s·n` off `JBad` gives **one cut `c ≤ N·n·Q` for all segments**
  (where the last one crosses). Each segment then has its realized table `σ` and at most `4n + 3·whole σ` charged
  steps, of total width at least `wc·n·max(s, whole σ)`. `ι` charges every credit of the table, and every whole
  credit is at least `n` columns.

`h_lt` is not asked: it is `jointStratC_step_lt`. The segment is carried in the joint kind, and the cut union, the
class union and the arithmetic are done here (`jointFreshTail2_of_segCharges`). -/
def P3SegCharges : Prop :=
  ∀ (N n wc D Q s : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → (2 * (N * nPosC n Q)) ^ 40 ≤ 2 ^ wc → 1 ≤ N →
    Function.Injective tags → (∀ t v, (A t v).Bounded D Q) → s ≤ n →
    ∃ (Sig : Type) (_ : Fintype Sig) (whole : Sig → ℕ) (K : Type) (_ : Fintype K) (_ : DecidableEq K) (w : K → ℕ)
      (I : Type)
      (T : ℕ → Fin N → Sig → K → History (P3Alpha n wc) → (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1))
      (OnFresh : ℕ → Fin N → Sig → Oracle (P3Alpha n wc) → I → Prop)
      (name : ℕ → Fin N → Sig → Oracle (P3Alpha n wc) → I → ℕ × K),
      -- the tables, per whole-credit count
      (∀ k, (Finset.univ.filter fun σ => whole σ = k).card ≤
        ((4 * n ^ 2 + 12 * n + 4) * (N * nPosC n Q + 1)) ^ (3 * n + k)) ∧
      -- the kinds and widths
      0 < Fintype.card K ∧ Fintype.card K ≤ 16 * n ^ 3 + 16 ∧ (∀ κ, wc ≤ w κ) ∧
      -- `hT`, at `nPos = N·nPosC`
      (∀ c t σ κ h q, (T c t σ κ h q).card * (2 ^ w κ - N * nPosC n Q) ≤
        Fintype.card (P3Alpha n wc q.1) - N * nPosC n Q) ∧
      -- distinct steps within a segment
      (∀ c t σ π x y, OnFresh c t σ π x → OnFresh c t σ π y → x ≠ y → (name c t σ π x).1 ≠ (name c t σ π y).1) ∧
      -- distinct steps across segments, off `JBad`
      (∀ c t t' σ σ' π x y, t ≠ t' → ¬ JBad tags G W ((omegaEquiv n wc).symm π) → OnFresh c t σ π x →
        OnFresh c t' σ' π y → (name c t σ π x).1 ≠ (name c t' σ' π y).1) ∧
      -- `h_fresh`
      (∀ c t σ π x, OnFresh c t σ π x →
        ∃ q, (jointStratC A tags G W D c).next ((jointStratC A tags G W D c).hist π (name c t σ π x).1) = some q ∧
          Fresh ((jointStratC A tags G W D c).hist π (name c t σ π x).1) q) ∧
      -- `h_target`
      (∀ c t σ π x q, OnFresh c t σ π x →
        (jointStratC A tags G W D c).next ((jointStratC A tags G W D c).hist π (name c t σ π x).1) = some q →
          ans π q ∈ T c t σ (name c t σ π x).2 ((jointStratC A tags G W D c).hist π (name c t σ π x).1) q) ∧
      -- the win: one cut for all segments, and each segment's charged steps
      (∀ π, ((∀ t : Fin N, (s : ℚ) * n ≤
            ((segReplay A tags G W D Q t).onlineH ((omegaEquiv n wc).symm π) (D + 1)).size 512 wc) ∧
          ¬ JBad tags G W ((omegaEquiv n wc).symm π)) →
        ∃ c ≤ N * n * Q, ∀ t, ∃ σ, ∃ X : Finset I, (∀ x ∈ X, OnFresh c t σ π x) ∧
          X.card ≤ 4 * n + 3 * whole σ ∧ wc * n * max s (whole σ) ≤ ∑ x ∈ X, w (name c t σ π x).2)

/-! ## The joint tables -/

section Tables

variable {Sig : Type} (whole : Sig → ℕ)

/-- The joint tables of a class profile `p`: one table per segment, segment `t`'s with `p t` whole credits. -/
def SigP (p : Fin N → ℕ) : Type := {σ : Fin N → Sig // ∀ t, whole (σ t) = p t}

noncomputable instance instFintypeSigP [Fintype Sig] (p : Fin N → ℕ) : Fintype (SigP whole p) := by
  classical
  unfold SigP
  infer_instance

theorem card_sigP_le [Fintype Sig] (p : Fin N → ℕ) (Z n : ℕ)
    (hZ : ∀ k, (Finset.univ.filter fun σ => whole σ = k).card ≤ Z ^ (3 * n + k)) :
    Fintype.card (SigP whole p) ≤ ∏ t, Z ^ (3 * n + p t) := by
  classical
  have e : Fintype.card (SigP whole p) = ∏ t, (Finset.univ.filter fun σ => whole σ = p t).card := by
    unfold SigP
    rw [Fintype.card_congr (Equiv.subtypePiEquivPi (p := fun t σ => whole σ = p t)), Fintype.card_pi]
    exact Finset.prod_congr rfl fun t _ => Fintype.card_subtype _
  rw [e]
  exact Finset.prod_le_prod fun t _ => hZ (p t)

end Tables

/-! ## The arithmetic of the joint count

With `P = N·nPosC` and `B = 2P`, the counts are bounded crudely by powers of `B`: slot values `Z ≤ B³` and the
bridge's `2·nPos·|K_joint| ≤ B⁵`. A segment's class-`k` term is at most `B^{29n+18s}·2^{s+1}·2^{−wc·n·s}·2^{−(k+1)}`
(`term_le`), so the class sum is geometric (`seg_sum_le`). The product over segments and the cut union fit
`N·P^{14nN}/2^{N(s−1)·n·wc}` under the multi (C2), `B^40 ≤ 2^wc` (`joint_final`), since `2^{15n+2} ≤ B^{6n}`. -/

section Arith

theorem pow_15_le {n B : ℕ} (hn : 1 ≤ n) (hB : 10 ≤ B) : 2 ^ (15 * n + 2) ≤ B ^ (6 * n) := by
  have h30 : 4 ≤ 30 ^ n := le_trans (by norm_num) (Nat.pow_le_pow_right (by norm_num) hn : 30 ^ 1 ≤ 30 ^ n)
  calc 2 ^ (15 * n + 2) = 4 * 32768 ^ n := by rw [pow_add, pow_mul]; norm_num [mul_comm]
    _ ≤ 30 ^ n * 32768 ^ n := Nat.mul_le_mul_right _ h30
    _ = (30 * 32768) ^ n := (mul_pow _ _ _).symm
    _ ≤ (10 ^ 6) ^ n := Nat.pow_le_pow_left (by norm_num) _
    _ = 10 ^ (6 * n) := by rw [← pow_mul]
    _ ≤ B ^ (6 * n) := Nat.pow_le_pow_left hB _

theorem one_le_two_pow_mul_inv (a b : ℕ) (h : b ≤ a) : (1 : ℝ≥0∞) ≤ 2 ^ a * (2⁻¹ : ℝ≥0∞) ^ b := by
  calc (1 : ℝ≥0∞) = 2 ^ b * (2⁻¹ : ℝ≥0∞) ^ b := by rw [PousP3Base.two_pow_mul_inv_pow b b le_rfl, Nat.sub_self, pow_zero]
    _ ≤ 2 ^ a * (2⁻¹ : ℝ≥0∞) ^ b := by gcongr; norm_num

/-- **One class term.** -/
theorem term_le {n s wc Z Y B : ℕ} (k : ℕ) (hZ : Z ≤ B ^ 3) (hY : Y ≤ B ^ 5) (hB : 1 ≤ B)
    (hr : 2 * B ^ 18 ≤ 2 ^ (wc * n)) :
    ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s k) ≤
      ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * (2⁻¹ : ℝ≥0∞) ^ (k + 1) := by
  have hZY : ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) ≤
      ((B ^ (29 * n + 18 * k) : ℕ) : ℝ≥0∞) := by
    have : Z ^ (3 * n + k) * Y ^ (4 * n + 3 * k) ≤ B ^ (29 * n + 18 * k) :=
      calc Z ^ (3 * n + k) * Y ^ (4 * n + 3 * k) ≤ (B ^ 3) ^ (3 * n + k) * (B ^ 5) ^ (4 * n + 3 * k) :=
            Nat.mul_le_mul (Nat.pow_le_pow_left hZ _) (Nat.pow_le_pow_left hY _)
        _ = B ^ (29 * n + 18 * k) := by rw [← pow_mul, ← pow_mul, ← pow_add]; ring_nf
    exact_mod_cast this
  rcases le_or_gt k s with hks | hks
  · rw [max_eq_left hks]
    have hB' : ((B ^ (29 * n + 18 * k) : ℕ) : ℝ≥0∞) ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) := by
      exact_mod_cast Nat.pow_le_pow_right hB (by omega)
    calc ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)
        ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * 1 := by
          rw [mul_one]; gcongr; exact hZY.trans hB'
      _ ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) *
            (2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (k + 1)) := by
          gcongr; exact one_le_two_pow_mul_inv _ _ (by omega)
      _ = _ := by ring
  · rw [max_eq_right hks.le]
    obtain ⟨d, rfl⟩ : ∃ d, k = s + d + 1 := ⟨k - s - 1, by omega⟩
    have hq : ((B ^ 18 : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n) ≤ 2⁻¹ := by
      have h1 : ((B ^ 18 : ℕ) : ℝ≥0∞) ≤ 2⁻¹ * 2 ^ (wc * n) := by
        have : ((2 * B ^ 18 : ℕ) : ℝ≥0∞) ≤ 2 ^ (wc * n) := by exact_mod_cast hr
        calc ((B ^ 18 : ℕ) : ℝ≥0∞) = 2⁻¹ * ((2 * B ^ 18 : ℕ) : ℝ≥0∞) := by
              push_cast
              rw [← mul_assoc, ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top, one_mul]
          _ ≤ 2⁻¹ * 2 ^ (wc * n) := by gcongr
      calc ((B ^ 18 : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n) ≤ 2⁻¹ * 2 ^ (wc * n) * (2⁻¹ : ℝ≥0∞) ^ (wc * n) := by
            gcongr
        _ = 2⁻¹ := by
            rw [mul_assoc, PousP3Base.two_pow_mul_inv_pow _ _ le_rfl, Nat.sub_self, pow_zero, mul_one]
    have hsplit : ((B ^ (29 * n + 18 * (s + d + 1)) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * (s + d + 1)) =
        ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) *
          (((B ^ 18 : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n)) ^ (d + 1) := by
      push_cast
      rw [mul_pow, ← pow_mul, ← pow_mul]
      rw [show 29 * n + 18 * (s + d + 1) = (29 * n + 18 * s) + 18 * (d + 1) by ring,
        show wc * n * (s + d + 1) = wc * n * s + wc * n * (d + 1) by ring, pow_add, pow_add]
      ring
    have hrhs : (2 : ℝ≥0∞) ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (s + d + 1 + 1) = (2⁻¹ : ℝ≥0∞) ^ (d + 1) := by
      rw [PousP3Base.two_pow_mul_inv_pow _ _ (by omega)]
      congr 1
      omega
    calc ((Z ^ (3 * n + (s + d + 1)) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * (s + d + 1)) : ℕ) : ℝ≥0∞) *
          (2⁻¹ : ℝ≥0∞) ^ (wc * n * (s + d + 1))
        ≤ ((B ^ (29 * n + 18 * (s + d + 1)) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * (s + d + 1)) := by gcongr
      _ = ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) *
            (((B ^ 18 : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n)) ^ (d + 1) := hsplit
      _ ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * (2⁻¹ : ℝ≥0∞) ^ (d + 1) := by
          gcongr
      _ = _ := by rw [← hrhs]; ring

theorem sum_inv_two_succ_le (m : ℕ) : ∑ k ∈ Finset.range m, (2⁻¹ : ℝ≥0∞) ^ (k + 1) ≤ 1 := by
  calc ∑ k ∈ Finset.range m, (2⁻¹ : ℝ≥0∞) ^ (k + 1) = 2⁻¹ * ∑ k ∈ Finset.range m, (2⁻¹ : ℝ≥0∞) ^ k := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun k _ => by ring
    _ ≤ 2⁻¹ * ∑' k, (2⁻¹ : ℝ≥0∞) ^ k := by gcongr; exact ENNReal.sum_le_tsum _
    _ = 1 := by
        rw [ENNReal.tsum_geometric, ENNReal.one_sub_inv_two, inv_inv,
          ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top]

/-- **One segment's sum over the classes.** -/
theorem seg_sum_le {n s wc Z Y B : ℕ} (Kmax : ℕ) (hZ : Z ≤ B ^ 3) (hY : Y ≤ B ^ 5) (hB : 1 ≤ B)
    (hr : 2 * B ^ 18 ≤ 2 ^ (wc * n)) :
    ∑ k ∈ Finset.range (Kmax + 1),
        ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s k) ≤
      ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) := by
  calc _ ≤ ∑ k ∈ Finset.range (Kmax + 1), ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) *
          (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * (2⁻¹ : ℝ≥0∞) ^ (k + 1) :=
        Finset.sum_le_sum fun k _ => term_le k hZ hY hB hr
    _ = ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) *
          ∑ k ∈ Finset.range (Kmax + 1), (2⁻¹ : ℝ≥0∞) ^ (k + 1) := by rw [Finset.mul_sum]
    _ ≤ _ := by
        calc _ ≤ ((B ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) * 1 := by
              gcongr; exact sum_inv_two_succ_le _
          _ = _ := mul_one _

/-- **The ℕ core of the fit**: `(C+1)·2·(B^{47n}·2^{n+1})^N ≤ N·P^{14nN}·2^{N·n·wc}` with `B = 2P`. -/
theorem joint_final_nat {N n wc P Cmax : ℕ} (hN : 1 ≤ N) (hn : 1 ≤ n) (hB : 10 ≤ 2 * P) (hC : Cmax + 1 ≤ 2 * P)
    (hC2 : (2 * P) ^ 40 ≤ 2 ^ wc) :
    (Cmax + 1) * 2 * ((2 * P) ^ (47 * n) * 2 ^ (n + 1)) ^ N ≤ N * P ^ (14 * n * N) * 2 ^ (N * (n * wc)) := by
  have hPB : P ^ (14 * n * N) * 2 ^ (14 * n * N) = (2 * P) ^ (14 * n * N) := by rw [mul_pow]; ring
  generalize hBdef : 2 * P = B at hB hC hC2 hPB ⊢
  have hB1 : 1 ≤ B := by omega
  have h15 := pow_15_le hn hB
  have hnN : 1 ≤ n * N := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
  refine le_of_mul_le_mul_right ?_ (by positivity : 0 < 2 ^ (14 * n * N))
  have e1 : (2 : ℕ) ^ (15 * n + 1) = 2 ^ (n + 1) * 2 ^ (14 * n) := by rw [← pow_add]; ring_nf
  have hL : (Cmax + 1) * 2 * (B ^ (47 * n) * 2 ^ (n + 1)) ^ N * 2 ^ (14 * n * N) ≤ B ^ (54 * n * N) :=
    calc (Cmax + 1) * 2 * (B ^ (47 * n) * 2 ^ (n + 1)) ^ N * 2 ^ (14 * n * N)
        = (Cmax + 1) * B ^ (47 * n * N) * (2 * (2 ^ (15 * n + 1)) ^ N) := by
          rw [e1, mul_pow (2 ^ (n + 1)) (2 ^ (14 * n)) N, ← pow_mul 2 (14 * n) N, mul_pow (B ^ (47 * n)) (2 ^ (n + 1)) N,
            ← pow_mul B (47 * n) N]
          ring
      _ ≤ B * B ^ (47 * n * N) * (2 ^ (15 * n + 2)) ^ N := by
          gcongr
          calc 2 * (2 ^ (15 * n + 1)) ^ N ≤ 2 ^ N * (2 ^ (15 * n + 1)) ^ N :=
                Nat.mul_le_mul_right _ (by calc 2 = 2 ^ 1 := rfl
                                              _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN)
            _ = (2 ^ (15 * n + 2)) ^ N := by rw [← mul_pow, ← pow_succ']
      _ ≤ B ^ (n * N) * B ^ (47 * n * N) * (B ^ (6 * n)) ^ N := by
          gcongr
          calc B = B ^ 1 := (pow_one B).symm
            _ ≤ B ^ (n * N) := Nat.pow_le_pow_right hB1 hnN
      _ = B ^ (54 * n * N) := by rw [← pow_mul, ← pow_add, ← pow_add]; ring_nf
  have hR : B ^ (54 * n * N) ≤ N * P ^ (14 * n * N) * 2 ^ (N * (n * wc)) * 2 ^ (14 * n * N) :=
    calc B ^ (54 * n * N) = 1 * (B ^ (14 * n * N) * (B ^ 40) ^ (n * N)) := by
          rw [one_mul, ← pow_mul, ← pow_add]; ring_nf
      _ ≤ N * (B ^ (14 * n * N) * (2 ^ wc) ^ (n * N)) := by gcongr
      _ = N * P ^ (14 * n * N) * 2 ^ (N * (n * wc)) * 2 ^ (14 * n * N) := by
          rw [← hPB, ← pow_mul]; ring_nf
  exact hL.trans hR

/-- **The fit in `ℝ≥0∞`**: the cut union of the product of the segment sums is within the joint target. -/
theorem joint_final {N n wc s P Cmax : ℕ} (hN : 1 ≤ N) (hn : 1 ≤ n) (hs : 1 ≤ s) (hsn : s ≤ n) (hB : 10 ≤ 2 * P)
    (hC : Cmax + 1 ≤ 2 * P) (hC2 : (2 * P) ^ 40 ≤ 2 ^ wc) :
    ((Cmax + 1 : ℕ) : ℝ≥0∞) * (2 * (((2 * P) ^ (29 * n + 18 * s) : ℕ) * 2 ^ (s + 1) *
        (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)) ^ N) ≤
      (N : ℝ≥0∞) * ((P ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (s - 1) * (n * wc)) := by
  have hX : (((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) ≤
      (((2 * P) ^ (47 * n) * 2 ^ (n + 1) : ℕ) : ℝ≥0∞) := by
    have : (2 * P) ^ (29 * n + 18 * s) * 2 ^ (s + 1) ≤ (2 * P) ^ (47 * n) * 2 ^ (n + 1) :=
      Nat.mul_le_mul (Nat.pow_le_pow_right (by omega) (by omega)) (Nat.pow_le_pow_right (by norm_num) (by omega))
    exact_mod_cast this
  have hnat := joint_final_nat (Cmax := Cmax) hN hn hB hC hC2
  have hnat' : ((((Cmax + 1) * 2 * ((2 * P) ^ (47 * n) * 2 ^ (n + 1)) ^ N : ℕ)) : ℝ≥0∞) ≤
      (N : ℝ≥0∞) * ((P ^ (14 * n * N) : ℕ) : ℝ≥0∞) * 2 ^ (N * (n * wc)) := by exact_mod_cast hnat
  have hexp : wc * n * s * N = N * (n * wc) + N * (s - 1) * (n * wc) := by
    obtain ⟨s', rfl⟩ : ∃ s', s = s' + 1 := ⟨s - 1, by omega⟩
    rw [Nat.add_sub_cancel]; ring
  calc ((Cmax + 1 : ℕ) : ℝ≥0∞) * (2 * (((2 * P) ^ (29 * n + 18 * s) : ℕ) * 2 ^ (s + 1) *
        (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)) ^ N)
      = ((Cmax + 1 : ℕ) : ℝ≥0∞) * 2 * ((((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1)) ^ N *
          (2⁻¹ : ℝ≥0∞) ^ (wc * n * s * N) := by rw [mul_pow, pow_mul]; ring
    _ ≤ ((Cmax + 1 : ℕ) : ℝ≥0∞) * 2 * ((((2 * P) ^ (47 * n) * 2 ^ (n + 1) : ℕ) : ℝ≥0∞)) ^ N *
          (2⁻¹ : ℝ≥0∞) ^ (wc * n * s * N) := by gcongr
    _ = ((((Cmax + 1) * 2 * ((2 * P) ^ (47 * n) * 2 ^ (n + 1)) ^ N : ℕ)) : ℝ≥0∞) *
          ((2⁻¹ : ℝ≥0∞) ^ (N * (n * wc)) * (2⁻¹ : ℝ≥0∞) ^ (N * (s - 1) * (n * wc))) := by
          rw [hexp, pow_add]; push_cast; ring
    _ ≤ (N : ℝ≥0∞) * ((P ^ (14 * n * N) : ℕ) : ℝ≥0∞) * 2 ^ (N * (n * wc)) *
          ((2⁻¹ : ℝ≥0∞) ^ (N * (n * wc)) * (2⁻¹ : ℝ≥0∞) ^ (N * (s - 1) * (n * wc))) := by gcongr
    _ = (N : ℝ≥0∞) * ((P ^ (14 * n * N) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (N * (s - 1) * (n * wc)) := by
          rw [← mul_assoc, mul_assoc _ (2 ^ (N * (n * wc))), PousP3Base.two_pow_mul_inv_pow _ _ le_rfl, Nat.sub_self,
            pow_zero, mul_one]
    _ = _ := by rw [div_eq_mul_inv, ENNReal.inv_pow]

end Arith

/-! ## The joint compression from the per-segment charges -/

/-- **`JointFreshTail2` from `P3SegCharges`.** A union over the joint cut `c ≤ N·n·Q` and over the class profile
`p` (each segment's number of whole credits), then `Strategy.prob_fresh_slots_le` on `jointStratC c` for the joint
tables of class `p`, then the arithmetic (`seg_sum_le`, `joint_final`). -/
theorem jointFreshTail2_of_segCharges (h : P3SegCharges) : JointFreshTail2 := by
  classical
  intro N n wc D Q s tags G W A hn hwc hn255 hC1 hC2 hN htags hA hsn
  rcases Nat.eq_zero_or_pos s with rfl | hs
  · rw [pr_eq_prob]
    refine (prob_le_one' _).trans ?_
    rw [show N * (0 - 1) * (n * wc) = 0 by simp, pow_zero, div_one]
    have h1 : (1 : ℝ≥0∞) ≤ (N : ℝ≥0∞) := by exact_mod_cast hN
    have h2 : (1 : ℝ≥0∞) ≤ (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) := by
      exact_mod_cast Nat.one_le_pow _ _ (nPosCJ_pos hN hn)
    calc (1 : ℝ≥0∞) = 1 * 1 := (one_mul 1).symm
      _ ≤ _ := mul_le_mul' h1 h2
  obtain ⟨Sig, hSf, whole, K, hKf, hKd, w, I, T, OnFresh, name, hZ, hK0, hK, hw, hT, hdist, hcross, hfresh,
    htarget, hwin⟩ := h N n wc D Q s tags G W A hn hwc hn255 hC1 hC2 hN htags hA hsn
  let _ := hSf
  let _ := hKf
  let _ := hKd
  set P := N * nPosC n Q with hPdef
  -- sizes
  have hnP : n * n + 4 * n ≤ nPosC n Q := by unfold nPosC; nlinarith
  have hPn : n * (Q + 1) + 1 ≤ nPosC n Q := by unfold nPosC; nlinarith
  have hNP : N ≤ P := Nat.le_mul_of_pos_right _ (by omega)
  have hP1 : n * n ≤ P := (by omega : n * n ≤ nPosC n Q).trans (Nat.le_mul_of_pos_left _ (by omega))
  have hPn1 : n ≤ P := (by nlinarith : n ≤ n * n).trans hP1
  have hB10 : 10 ≤ 2 * P := by
    have : 5 ≤ nPosC n Q := by nlinarith
    have : nPosC n Q ≤ P := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have hCmax : N * n * Q + 1 ≤ 2 * P := by
    have : N * n * Q + 1 ≤ P := by
      rw [hPdef]
      nlinarith
    omega
  have hcardK : Fintype.card (Fin N × K) = N * Fintype.card K := by rw [Fintype.card_prod, Fintype.card_fin]
  set Z := (4 * n ^ 2 + 12 * n + 4) * (P + 1) with hZdef
  set Y := 2 * (P * Fintype.card (Fin N × K)) with hYdef
  have hZB : Z ≤ (2 * P) ^ 3 := by
    have h20 : 4 * n ^ 2 + 12 * n + 4 ≤ 20 * P := by nlinarith
    calc Z ≤ 20 * P * (2 * P) := Nat.mul_le_mul h20 (by omega)
      _ = 10 * (2 * P) ^ 2 := by ring
      _ ≤ (2 * P) * (2 * P) ^ 2 := Nat.mul_le_mul_right _ hB10
      _ = (2 * P) ^ 3 := by ring
  have hYB : Y ≤ (2 * P) ^ 5 := by
    have hn3 : n ^ 3 ≤ P ^ 2 := by
      calc n ^ 3 = n * (n * n) := by ring
        _ ≤ P * P := Nat.mul_le_mul hPn1 hP1
        _ = P ^ 2 := by ring
    have hK' : Fintype.card K ≤ 32 * P ^ 2 := by
      have : 1 ≤ P ^ 2 := Nat.one_le_pow _ _ (by omega)
      omega
    calc Y = 2 * (P * (N * Fintype.card K)) := by rw [hYdef, hcardK]
      _ ≤ 2 * (P * (P * (32 * P ^ 2))) := by gcongr
      _ = 4 * (2 * P) ^ 4 := by ring
      _ ≤ (2 * P) * (2 * P) ^ 4 := Nat.mul_le_mul_right _ (by omega)
      _ = (2 * P) ^ 5 := by ring
  have hr : 2 * (2 * P) ^ 18 ≤ 2 ^ (wc * n) :=
    calc 2 * (2 * P) ^ 18 ≤ (2 * P) * (2 * P) ^ 18 := Nat.mul_le_mul_right _ (by omega)
      _ = (2 * P) ^ 19 := by ring
      _ ≤ (2 * P) ^ 40 := Nat.pow_le_pow_right (by omega) (by norm_num)
      _ ≤ 2 ^ wc := hC2
      _ ≤ 2 ^ (wc * n) := Nat.pow_le_pow_right (by norm_num) (Nat.le_mul_of_pos_right _ hn)
  -- the joint objects of a cut `c` and a class profile `p`
  set Kmax := Finset.univ.sup whole
  let IJ : Type := Σ _ : Fin N, I
  let OnJ : ℕ → (p : Fin N → ℕ) → SigP whole p → Oracle (P3Alpha n wc) → IJ → Prop := fun c _ σ π x =>
    OnFresh c x.1 (σ.1 x.1) π x.2 ∧ ¬ JBad tags G W ((omegaEquiv n wc).symm π)
  let nameJ : ℕ → (p : Fin N → ℕ) → SigP whole p → Oracle (P3Alpha n wc) → IJ → ℕ × (Fin N × K) :=
    fun c _ σ π x => ((name c x.1 (σ.1 x.1) π x.2).1, (x.1, (name c x.1 (σ.1 x.1) π x.2).2))
  let TJ : ℕ → (p : Fin N → ℕ) → SigP whole p → Fin N × K → History (P3Alpha n wc) →
      (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1) := fun c _ σ κ hh q => T c κ.1 (σ.1 κ.1) κ.2 hh q
  let wJ : Fin N × K → ℕ := fun κ => w κ.2
  let items : (Fin N → ℕ) → ℕ := fun p => ∑ t, (4 * n + 3 * p t)
  let Wp : (Fin N → ℕ) → ℕ := fun p => ∑ t, wc * n * max s (p t)
  let WinE : ℕ → (Fin N → ℕ) → Oracle (P3Alpha n wc) → Prop := fun c p π =>
    ∃ σ : SigP whole p, ∃ X : Finset IJ, (∀ x ∈ X, OnJ c p σ π x) ∧ X.card ≤ (items p - 1) + 1 ∧
      Wp p ≤ ∑ x ∈ X, wJ (nameJ c p σ π x).2
  have hitems : ∀ p, 1 ≤ items p := fun p =>
    le_trans (by omega : 1 ≤ 4 * n + 3 * p ⟨0, hN⟩)
      (Finset.single_le_sum (f := fun t => 4 * n + 3 * p t) (fun _ _ => Nat.zero_le _) (Finset.mem_univ _))
  -- one cut and one class profile per win
  have hcov : ∀ π, ((∀ t : Fin N, (s : ℚ) * n ≤
        ((segReplay A tags G W D Q t).onlineH ((omegaEquiv n wc).symm π) (D + 1)).size 512 wc) ∧
        ¬ JBad tags G W ((omegaEquiv n wc).symm π)) →
      ∃ c ∈ Finset.range (N * n * Q + 1), ∃ p ∈ Fintype.piFinset fun _ : Fin N => Finset.range (Kmax + 1),
        WinE c p π := by
    intro π hπ
    obtain ⟨c, hc, hall⟩ := hwin π hπ
    choose σt X hXf hXc hXw using hall
    refine ⟨c, Finset.mem_range.2 (by omega), fun t => whole (σt t),
      Fintype.mem_piFinset.2 fun t => Finset.mem_range.2 (Nat.lt_succ_of_le
        (Finset.le_sup (f := whole) (Finset.mem_univ _))), ⟨fun t => σt t, fun t => rfl⟩, Finset.univ.sigma X,
      fun x hx => ⟨hXf x.1 x.2 (Finset.mem_sigma.1 hx).2, hπ.2⟩, ?_, ?_⟩
    · rw [Nat.sub_add_cancel (hitems _), Finset.card_sigma]
      exact Finset.sum_le_sum fun t _ => hXc t
    · show ∑ t, wc * n * max s (whole (σt t)) ≤ ∑ x ∈ Finset.univ.sigma X, w (name c x.1 (σt x.1) π x.2).2
      rw [Finset.sum_sigma]
      exact Finset.sum_le_sum fun t _ => hXw t
  -- the bridge, per cut and class profile
  have hcp : ∀ c ∈ Finset.range (N * n * Q + 1), ∀ p : Fin N → ℕ, prob (WinE c p) ≤
      (Fintype.card (SigP whole p) : ℝ≥0∞) *
        (2 * (((2 * (P * Fintype.card (Fin N × K))) ^ ((items p - 1) + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (Wp p)) := by
    intro c hc p
    have hc' : c ≤ N * n * Q := Nat.lt_succ_iff.1 (Finset.mem_range.1 hc)
    refine (jointStratC A tags G W D c).prob_fresh_slots_le (Sig := SigP whole p) (TJ c p) wJ P
      (fun σ κ hh q => hT c κ.1 (σ.1 κ.1) κ.2 hh q)
      (fun κ => hC1.trans (Nat.pow_le_pow_right (by norm_num) (hw κ.2))) ?_ (OnJ c p) (nameJ c p) ?_
      (fun σ π x hx => hfresh c x.1 (σ.1 x.1) π x.2 hx.1)
      (fun σ π x q hx hq => htarget c x.1 (σ.1 x.1) π x.2 q hx.1 hq)
      (fun σ π x hx => by
        obtain ⟨q, hq, -⟩ := hfresh c x.1 (σ.1 x.1) π x.2 hx.1
        exact jointStratC_step_lt A tags G W D Q c hc' hq)
      (items p - 1) (Wp p) (WinE c p) (fun π hπ => hπ)
    · have : 1 ≤ P * Fintype.card (Fin N × K) :=
        Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by rw [hcardK]; exact Nat.mul_ne_zero (by omega) (by omega)))
      omega
    · rintro σ π ⟨t, x⟩ ⟨t', y⟩ hx hy hne
      by_cases htt : t = t'
      · subst htt
        exact hdist c t (σ.1 t) π x y hx.1 hy.1 fun hxy => hne (by rw [hxy])
      · exact hcross c t t' (σ.1 t) (σ.1 t') π x y htt hx.2 hx.1 hy.1
  -- per class profile, the terms factor over the segments
  let f : ℕ → ℝ≥0∞ := fun k => ((Z ^ (3 * n + k) : ℕ) : ℝ≥0∞) * ((Y ^ (4 * n + 3 * k) : ℕ) : ℝ≥0∞) *
    (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s k)
  have hterm : ∀ p : Fin N → ℕ, (Fintype.card (SigP whole p) : ℝ≥0∞) *
      (2 * (((2 * (P * Fintype.card (Fin N × K))) ^ ((items p - 1) + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (Wp p)) ≤
      2 * ∏ t, f (p t) := by
    intro p
    have hcard : (Fintype.card (SigP whole p) : ℝ≥0∞) ≤ ∏ t, ((Z ^ (3 * n + p t) : ℕ) : ℝ≥0∞) := by
      have := card_sigP_le whole p Z n hZ
      rw [← Nat.cast_prod]
      exact_mod_cast this
    rw [Nat.sub_add_cancel (hitems p), ← hYdef]
    have hY : ((Y ^ items p : ℕ) : ℝ≥0∞) = ∏ t, ((Y ^ (4 * n + 3 * p t) : ℕ) : ℝ≥0∞) := by
      rw [← Nat.cast_prod, Finset.prod_pow_eq_pow_sum]
    have hW : (2⁻¹ : ℝ≥0∞) ^ (Wp p) = ∏ t, (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s (p t)) := by
      rw [Finset.prod_pow_eq_pow_sum]
    rw [hY, hW]
    calc (Fintype.card (SigP whole p) : ℝ≥0∞) * (2 * (∏ t, ((Y ^ (4 * n + 3 * p t) : ℕ) : ℝ≥0∞)) *
          ∏ t, (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s (p t)))
        ≤ (∏ t, ((Z ^ (3 * n + p t) : ℕ) : ℝ≥0∞)) * (2 * (∏ t, ((Y ^ (4 * n + 3 * p t) : ℕ) : ℝ≥0∞)) *
          ∏ t, (2⁻¹ : ℝ≥0∞) ^ (wc * n * max s (p t))) := by gcongr
      _ = 2 * ∏ t, f (p t) := by
          simp only [f, Finset.prod_mul_distrib]
          ring
  have hseg : ∑ k ∈ Finset.range (Kmax + 1), f k ≤
      (((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s) :=
    seg_sum_le Kmax hZB hYB (by omega) hr
  have hprof : ∑ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), 2 * ∏ t, f (p t) =
      2 * (∑ k ∈ Finset.range (Kmax + 1), f k) ^ N := by
    rw [← Finset.mul_sum, ← Finset.prod_univ_sum (fun _ : Fin N => Finset.range (Kmax + 1)) (fun _ k => f k),
      Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  -- assemble
  rw [pr_transport' n wc]
  calc prob (fun π => (∀ t : Fin N, (s : ℚ) * n ≤
          ((segReplay A tags G W D Q t).onlineH ((omegaEquiv n wc).symm π) (D + 1)).size 512 wc) ∧
          ¬ JBad tags G W ((omegaEquiv n wc).symm π))
      ≤ prob (fun π => ∃ c ∈ Finset.range (N * n * Q + 1),
          ∃ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), WinE c p π) := prob_mono hcov
    _ ≤ ∑ c ∈ Finset.range (N * n * Q + 1),
          prob (fun π => ∃ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), WinE c p π) :=
        prob_exists_le _ _
    _ ≤ ∑ c ∈ Finset.range (N * n * Q + 1),
          ∑ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), prob (WinE c p) :=
        Finset.sum_le_sum fun c _ => prob_exists_le _ _
    _ ≤ ∑ c ∈ Finset.range (N * n * Q + 1),
          ∑ p ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (Kmax + 1)), 2 * ∏ t, f (p t) :=
        Finset.sum_le_sum fun c hc => Finset.sum_le_sum fun p _ => (hcp c hc p).trans (hterm p)
    _ = ∑ _c ∈ Finset.range (N * n * Q + 1), 2 * (∑ k ∈ Finset.range (Kmax + 1), f k) ^ N :=
        Finset.sum_congr rfl fun _ _ => hprof
    _ ≤ ∑ _c ∈ Finset.range (N * n * Q + 1),
          2 * ((((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)) ^ N :=
        Finset.sum_le_sum fun _ _ => by gcongr
    _ = ((N * n * Q + 1 : ℕ) : ℝ≥0∞) *
          (2 * ((((2 * P) ^ (29 * n + 18 * s) : ℕ) : ℝ≥0∞) * 2 ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (wc * n * s)) ^ N) := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    _ ≤ _ := joint_final hN hn hs hsn hB10 hCmax hC2

/-! ## To the 14 GB target with (C2) -/

open PousAssembly PousForwardCore

open Classical in
/-- **The joint count under (C1) and the multi (C2)**: `P3ChainCountMulti` with `(2·N·nPosC)^40 ≤ 2^wc`. -/
def P3ChainCountMulti2 : Prop :=
  ∀ (N n wc D Q k X : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → (2 * (N * nPosC n Q)) ^ 40 ≤ 2 ^ wc → 1 ≤ N →
    X + 1 ≤ k → Function.Injective tags → P3ChainHard G 512 wc D k X →
    ∀ A : Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc), (∀ s v, (A s v).Bounded D Q) →
      (Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card * 2 ^ (N * (k - X - 1) * (n * wc)) ≤
        N * (N * nPosC n Q) ^ (14 * n * N) * Fintype.card (P3COmega n wc)

/-- **`P3ChainEPFMulti` with the multi (C2)** right after (C1), where the one-segment prover adds it. -/
def P3ChainEPFMulti2 : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → (2 * (N * nPosC n Q)) ^ 40 ≤ 2 ^ wc → 1 ≤ N →
    X + 1 ≤ k → Function.Injective tags → P3ChainHard G 512 wc D k X →
    ∀ (A₁ : P3COmega n wc → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)),
      (∀ σ s v, (A₂ σ s v).Bounded D Q) →
      pr (JointEventC G tags W A₁ A₂ k) ≤
        (N : ℝ≥0∞) * 2 ^ m * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (k - X - 1) * (n * wc)) +
          (((N * nPosC n Q) ^ 2 + (2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

/-- A joint win prices every segment at `(k − X)·n` (`joint_win_price`); the compression bounds that, as a count. -/
theorem p3ChainCountMulti2_of_tail2 (h : JointFreshTail2) : P3ChainCountMulti2 := by
  classical
  intro N n wc D Q k X tags G W hn hwc hn255 hC1 hC2 hN hXk htags hard A hA
  by_cases hkn : k ≤ n
  swap
  · have hempty : (Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω) = ∅ := by
      refine Finset.filter_eq_empty_iff.2 fun ω _ hω => hkn ?_
      exact (hω.1 ⟨0, hN⟩).trans ((Finset.card_filter_le _ _).trans (by rw [Finset.card_univ, Fintype.card_fin]))
    rw [hempty, Finset.card_empty, zero_mul]
    exact Nat.zero_le _
  have hpr := h N n wc D Q (k - X) tags G W A hn hwc hn255 hC1 hC2 hN htags hA (by omega)
  have hsub : pr (fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω) ≤
      (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (k - X - 1) * (n * wc)) :=
    (pr_mono fun ω hω => ⟨fun t => joint_win_price A tags G W D Q ω hA hard hω.1 t, hω.2⟩).trans hpr
  set E := N * (k - X - 1) * (n * wc)
  set C := N * (N * nPosC n Q) ^ (14 * n * N)
  have hΩ0 : (Fintype.card (P3COmega n wc) : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (P3COmega n wc) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2E0 : (2 : ℝ≥0∞) ^ E ≠ 0 := pow_ne_zero _ two_ne_zero
  have h2Et : (2 : ℝ≥0∞) ^ E ≠ ⊤ := ENNReal.pow_ne_top ENNReal.ofNat_ne_top
  rw [pr_def, ENNReal.div_le_iff hΩ0 hΩt] at hsub
  have hC' : (N : ℝ≥0∞) * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) = ((C : ℕ) : ℝ≥0∞) := by
    simp only [C, Nat.cast_mul]
  rw [hC'] at hsub
  have hmul : ((Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card : ℝ≥0∞) * 2 ^ E ≤
      (C : ℝ≥0∞) * Fintype.card (P3COmega n wc) :=
    calc ((Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card : ℝ≥0∞) * 2 ^ E
        ≤ ((C : ℝ≥0∞) / 2 ^ E * Fintype.card (P3COmega n wc)) * 2 ^ E := by gcongr
      _ = (C : ℝ≥0∞) * Fintype.card (P3COmega n wc) := by rw [mul_right_comm, ENNReal.div_mul_cancel h2E0 h2Et]
  have : ((((Finset.univ.filter fun ω => WinC k tags G W A ω ∧ ¬ JBad tags G W ω).card * 2 ^ E : ℕ)) : ℝ≥0∞) ≤
      ((C * Fintype.card (P3COmega n wc) : ℕ) : ℝ≥0∞) := by
    push_cast
    exact hmul
  exact_mod_cast this

/-- **The target from the count**: the union over advice (`pr_le_of_advice`) and `jointBirthday` for `JBad`. -/
theorem p3ChainEPFMulti2_of_count2 (h : P3ChainCountMulti2) : P3ChainEPFMulti2 := by
  classical
  intro N n wc m D Q k X tags G W hn hwc hn255 hC1 hC2 hN hXk htags hard A₁ A₂ hA
  have hcount := h N n wc D Q k X tags G W hn hwc hn255 hC1 hC2 hN hXk htags hard
  rw [pr_partition (JointEventC G tags W A₁ A₂ k) (JBad tags G W)]
  refine add_le_add ?_ ((pr_mono fun ω h => h.2).trans (jointBirthday N n wc Q tags G W htags hn255))
  refine (pr_le_of_advice A₁ (fun ω => JointEventC G tags W A₁ A₂ k ω ∧ ¬ JBad tags G W ω)
    (N * (N * nPosC n Q) ^ (14 * n * N)) (2 ^ (N * (k - X - 1) * (n * wc))) (by positivity)
    fun σ => ?_).trans (le_of_eq ?_)
  · refine le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card fun ω hω => ?_)) (hcount (A₂ σ) (hA σ))
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
    obtain ⟨hσ, hwin, hbad⟩ := hω
    refine ⟨fun s => ?_, hbad⟩
    have hs := hwin s
    rw [hσ] at hs
    exact hs
  · simp only [Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat, div_eq_mul_inv]
    ring

/-- **The 14 GB target, with the multi (C2), from the per-segment charges.** -/
theorem p3ChainEPFMulti2_of_segCharges (h : P3SegCharges) : P3ChainEPFMulti2 :=
  p3ChainEPFMulti2_of_count2 (p3ChainCountMulti2_of_tail2 (jointFreshTail2_of_segCharges h))

/-- bc-58ec406e's target now carries the multi (C2) right after (C1). -/
theorem p3ChainEPFMulti_eq_2 : P3ChainEPFMulti = P3ChainEPFMulti2 := rfl

/-- **The 14 GB target from the per-segment charges.** -/
theorem p3ChainEPFMulti_of_segCharges (h : P3SegCharges) : P3ChainEPFMulti := p3ChainEPFMulti2_of_segCharges h

/-- **The one-segment target from the per-segment charges** (`N = 1`, `p3ChainEPF_of_multi`). -/
theorem p3ChainEPF_of_segCharges (h : P3SegCharges) : P3ChainEPF := p3ChainEPF_of_multi (p3ChainEPFMulti_of_segCharges h)

set_option exponentiation.threshold 3000 in
/-- **The multi (C2) at the deployment**: `(2·971·nPosC 220 2^20)^40 ≤ (2^39)^40 = 2^1560 ≤ 2^2384`. -/
theorem c2_multi_64 : (2 * (971 * nPosC 220 (2 ^ 20))) ^ 40 ≤ 2 ^ 2384 := by
  have h39 : 2 * (971 * nPosC 220 (2 ^ 20)) ≤ 2 ^ 39 :=
    calc 2 * (971 * nPosC 220 (2 ^ 20)) ≤ 2 * (2 ^ 10 * 2 ^ 28) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul (by norm_num) nPosC_le)
      _ = 2 ^ 39 := by norm_num
  calc (2 * (971 * nPosC 220 (2 ^ 20))) ^ 40 ≤ (2 ^ 39) ^ 40 := Nat.pow_le_pow_left h39 _
    _ = 2 ^ (39 * 40) := (pow_mul 2 39 40).symm
    _ ≤ 2 ^ 2384 := Nat.pow_le_pow_right (by norm_num) (by norm_num)

end

end PousP3ConcreteMulti

end


