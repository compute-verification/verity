      ∃ τ < T, ∃ x ∈ R.basisAt π τ, x.atom = .h q
  | 0, _, h => by simp [v6SeedsThrough, PousSpongeChain.ChainKnow.empty] at h
  | T + 1, q, h => by
      rw [v6SeedsThrough, seedPrefixAt, List.take_length] at h
      rcases R.seedFold_hs_origin π T (R.basisAt π T) _ h with h | ⟨x, hx, heq⟩
      · obtain ⟨τ, hτ, x, hx, heq⟩ := R.v6SeedsThrough_h_source π h
