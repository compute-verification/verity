seeds. This file proves the simulation for **observation-round freshness**, B5's shape (`PousB5Chain.fresh`): a value is
fresh when a position shows it no later than the first round that asks its point. A label may be shown as itself or as
its key (an inverse query `Π₂⁻¹(π(realPt v))` shows `keyAt v`).
- `bfreshLabelObs`, `bfreshChainingObs`, `freshHoldingObs`: the proposed replacements for the contract's definitions.
- `mem_reach_of_asked_obs`: the contract's theorem for them. It does not need `¬Bad`.

First, the structural facts the simulation needs.
- **The real chain, position by position.** `chainH R π v p` is block `v`'s chaining value after `p` calls. The
  `(p+1)`-th input is `absorbedG[p] ‖ chainH p` (`xin_succ`), and the next chaining value is `ovH (π (xin (p+1)))`
  (`chainH_succ`). A block is a parent's label before the pad and `padBlk` at it (`absorbedG_getElem_*`).
- **The `ChainKnow` step.** A makeable call is made in the next round (`mem_reach_succ_of_canCall`). Knowledge only grows
  (`reach_mono`). A known pad-call `r` puts its label in the same round's knowledge (`mem_labs_of_pad`).
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace Reach

/-! ### The overwrite chain, position by position -/

section Chain

variable {r c : ℕ}

/-- The chaining value after absorbing the first `k` blocks of `blks` from `s`. -/
def stateAfter (f : Bits (r + (r + c)) → Bits (r + (r + c))) (s : Bits r × Bits (r + c)) (blks : List (Bits r))
    (k : ℕ) : Bits (r + c) :=
  ((blks.take k).foldl (ovStep f) s).2

theorem stateAfter_zero (f : Bits (r + (r + c)) → Bits (r + (r + c))) (s : Bits r × Bits (r + c))
    (blks : List (Bits r)) : stateAfter f s blks 0 = s.2 := by
  simp [stateAfter]

/-- **The `k`-th forward input** is the `k`-th block beside the chaining value after `k` blocks. -/
theorem ovInputs_getElem (f : Bits (r + (r + c)) → Bits (r + (r + c))) :
    ∀ (s : Bits r × Bits (r + c)) (blks : List (Bits r)) (k : ℕ) (hk : k < blks.length),
      (ovInputs f s blks)[k]? = some (Fin.append blks[k] (stateAfter f s blks k))
  | _, [], _, hk => absurd hk (Nat.not_lt_zero _)
  | s, blk :: blks, 0, _ => by simp [ovInputs, stateAfter]
  | s, blk :: blks, k + 1, hk => by
      have ih := ovInputs_getElem f (ovStep f s blk) blks k (by simpa using hk)
      simp only [ovInputs, List.getElem?_cons_succ, ih, List.getElem_cons_succ]
      simp [stateAfter, List.take_succ_cons, List.foldl_cons]

/-- **The next chaining value** is the `h`-part of `f` at the current input. -/
theorem stateAfter_succ (f : Bits (r + (r + c)) → Bits (r + (r + c))) (s : Bits r × Bits (r + c))
    (blks : List (Bits r)) (k : ℕ) (hk : k < blks.length) :
    stateAfter f s blks (k + 1) = ovH (f (Fin.append blks[k] (stateAfter f s blks k))) := by
  unfold stateAfter
  rw [List.take_add_one, List.getElem?_eq_getElem hk, Option.toList_some, List.foldl_append]
  rfl

end Chain

/-! ### Block `v`'s real chain -/

namespace ChainReplayR

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- Block `v`'s absorbed blocks: its parents' labels newest first, then the pad. -/
noncomputable abbrev blks (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : List (Bits ℓ) :=
  absorbedG R.G (labelG R.G (fun x => π x) R.dom R.Wb) v

/-- Block `v`'s chaining value after `p` calls (`chainH 0` is the IV). -/
noncomputable def chainH (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) : Bits (ℓ + c) :=
  stateAfter (fun x => π x) (fun _ => false, iv (R.dom v.val)) (blks R π v) p

theorem blks_length (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : (blks R π v).length = ovCalls R.G v := by
  simp [blks, absorbedG, ovCalls]

theorem chainH_zero (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : chainH R π v 0 = iv (R.dom v.val) :=
  stateAfter_zero _ _ _

/-- **Input `p + 1`** is the `p`-th absorbed block beside the chaining value after `p` calls. -/
theorem xin_succ (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) (hp : p < ovCalls R.G v) :
    R.xin π v (p + 1) = Fin.append ((blks R π v)[p]'(by rw [blks_length]; exact hp)) (chainH R π v p) := by
  have h := ovInputs_getElem (fun x => π x) (fun _ => false, iv (R.dom v.val)) (blks R π v) p
    (by rw [blks_length]; exact hp)
  unfold ChainReplay.xin ChainReplay.chainInputList
  simp only [Nat.add_sub_cancel]
  rw [h]
  rfl

/-- **The chaining value after call `p + 1`** is the `h`-part of `π` at input `p + 1`. -/
theorem chainH_succ (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) (hp : p < ovCalls R.G v) :
    chainH R π v (p + 1) = ovH (π (R.xin π v (p + 1))) := by
  rw [xin_succ R π v p hp]
  exact stateAfter_succ _ _ _ p (by rw [blks_length]; exact hp)

/-- Before the pad, the absorbed block is a parent's label. -/
theorem blks_getElem_parent (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ)
    (hp : p < (parentsDesc R.G v).length) :
    (blks R π v)[p]'(by rw [blks_length, ovCalls]; omega) =
      labelG R.G (fun x => π x) R.dom R.Wb ((parentsDesc R.G v)[p]) := by
  simp [blks, absorbedG, List.getElem_append_left, hp]

/-- At the pad position the absorbed block is `padBlk`. -/
theorem blks_getElem_pad (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    (blks R π v)[(parentsDesc R.G v).length]'(by rw [blks_length, ovCalls]; omega) = padBlk := by
  simp [blks, absorbedG]

end ChainReplayR

/-! ### The `ChainKnow` step -/

section Know

variable {N : ℕ}

theorem reach_succ (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) :
    ChainKnow.reach G P₀ (t + 1) = (ChainKnow.reach G P₀ t).round G := rfl

theorem hs_subset_round (G : TopoDAG N) (K : ChainKnow N) : K.hs ⊆ (K.round G).hs := by
  intro p hp
  simp only [ChainKnow.round, ChainKnow.read, Finset.mem_union]
  exact Or.inl hp

theorem rs_subset_round (G : TopoDAG N) (K : ChainKnow N) : K.rs ⊆ (K.round G).rs := by
  intro p hp
  simp only [ChainKnow.round, ChainKnow.read, Finset.mem_union]
  exact Or.inl hp

/-- **Knowledge only grows.** -/
theorem reach_mono (G : TopoDAG N) (P₀ : ChainKnow N) {t t' : ℕ} (h : t ≤ t') :
    (ChainKnow.reach G P₀ t).labs ⊆ (ChainKnow.reach G P₀ t').labs ∧
    (ChainKnow.reach G P₀ t).hs ⊆ (ChainKnow.reach G P₀ t').hs ∧
    (ChainKnow.reach G P₀ t).rs ⊆ (ChainKnow.reach G P₀ t').rs := by
  induction h with
  | refl => exact ⟨le_rfl, le_rfl, le_rfl⟩
  | step _ ih =>
    exact ⟨ih.1.trans (labs_subset_round G _), ih.2.1.trans (hs_subset_round G _),
      ih.2.2.trans (rs_subset_round G _)⟩

/-- Held chaining values stay known. -/
theorem hs_subset_reach (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) : P₀.hs ⊆ (ChainKnow.reach G P₀ t).hs :=
  (reach_mono G P₀ (Nat.zero_le t)).2.1

/-- **A makeable call is made in the next round**: its `h` and `r` are known after it. -/
theorem mem_reach_succ_of_canCall (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) (v : Fin N) (j : ℕ)
    (hc : (ChainKnow.reach G P₀ t).canCall G v j) :
    (v, j) ∈ (ChainKnow.reach G P₀ (t + 1)).hs ∧ (v, j) ∈ (ChainKnow.reach G P₀ (t + 1)).rs := by
  have hj : j < N + 2 := by
    have h1 := hc.2.1
    have h2 := parentsDesc_length_le G v
    have h3 := v.isLt
    unfold ovCalls at h1
    omega
  have hpos : (v, j) ∈ ovPos N := Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 hj⟩
  rw [reach_succ]
  simp only [ChainKnow.round, ChainKnow.read, Finset.mem_union, Finset.mem_filter]
  exact ⟨Or.inr ⟨hpos, Or.inl hc⟩, Or.inr ⟨hpos, hc⟩⟩

/-- **A known pad-call `r` gives its label** in the same round's knowledge. -/
theorem mem_labs_of_pad (G : TopoDAG N) (P₀ : ChainKnow N) (t : ℕ) (v : Fin N)
    (h : (v, ovCalls G v) ∈ (ChainKnow.reach G P₀ t).rs) : v ∈ (ChainKnow.reach G P₀ t).labs := by
  cases t with
  | zero =>
    rw [ChainKnow.reach, mem_read_labs]
    exact Or.inr h
  | succ t =>
    rw [reach_succ] at h ⊢
    exact (mem_round_labs G _ v).2 (Or.inr h)

end Know

end Reach

/-! ### Observation-round freshness and the simulation -/

namespace ChainReplay

open Reach Reach.ChainReplayR

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- **Label freshness, observation-round form.** Some position shows block `v`'s label, or its key, no later than the
first round that asks `realPt v`. -/
def bfreshLabelObs (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : Prop :=
  ∃ (o : R.Pos) (τ : ℕ) (v' : Bits ℓ), R.obsKey π o = some (v', τ) ∧
    (v' = bxor (ovR (π (R.realPt π v))) (R.Wb v) ∨ v' = ovR (π (R.realPt π v))) ∧
    ∀ ρ < τ, ¬ R.askedPt π (R.realPt π v) ρ

/-- **Chaining freshness, observation-round form.** Some position shows `h_{v,p} = ovH (π (xin v p))` no later than the
first round that asks `xin v p`. -/
def bfreshChainingObs (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) (p : ℕ) : Prop :=
  ∃ (o : R.Pos) (τ : ℕ), R.obsKeyH π o = some (ovH (π (R.xin π v p)), τ) ∧
    ∀ ρ < τ, ¬ R.askedPt π (R.xin π v p) ρ

open Classical in
/-- The fresh seeds under observation-round freshness: `freshHolding` with `bfreshLabelObs`/`bfreshChainingObs`. -/
noncomputable def freshHoldingObs (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ChainKnow B where
  labs := Finset.univ.filter (fun v => R.bfreshLabelObs π v)
  hs := (ovPos B).filter (fun q => 1 ≤ q.2 ∧ q.2 < ovCalls R.G q.1 ∧ R.bfreshChainingObs π q.1 q.2)
  rs := ∅

/-- A thread's transcript has at most `Q` entries. -/
theorem tr_length_le (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) :
    (R.tr π i).length ≤ R.Q :=
  (PousB5Chain.length_trace (M := idealPerm (ℓ + (ℓ + c))) ((idealPerm (ℓ + (ℓ + c))).answer π) (R.P i)).le.trans
    (hP i π).2

/-- A transcript entry is shown at a query position, with its input's `ℓ`-bit and `(ℓ+c)`-bit parts. -/
theorem obs_of_mem_tr (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {i : Fin B}
    {e : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))} (he : e ∈ R.tr π i) :
    ∃ o : R.Pos, R.obsKey π o = some (qKey e.2, e.1) ∧ R.obsKeyH π o = some (qKeyH e.2, e.1) := by
  obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 he
  have hkQ : k < R.Q := lt_of_lt_of_le (List.getElem?_eq_some_iff.1 hk).1 (R.tr_length_le hP π i)
  refine ⟨.inl (i, ⟨k, by omega⟩), ?_, ?_⟩
  · simp only [obsKey, hkQ, ↓reduceIte, hk, Option.map_some]
  · simp only [obsKeyH, hkQ, ↓reduceIte, hk, Option.map_some]

/-- The first round that asks a point, below a bound. -/
theorem exists_first_ask {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z : Bits (ℓ + (ℓ + c))} {ρ : ℕ}
    (h : ∃ ρ' < ρ, R.askedPt π z ρ') :
    ∃ ρ₁ < ρ, R.askedPt π z ρ₁ ∧ ∀ ρ' < ρ₁, ¬ R.askedPt π z ρ' := by
  classical
  have h' : ∃ ρ', ρ' < ρ ∧ R.askedPt π z ρ' := by obtain ⟨ρ', h1, h2⟩ := h; exact ⟨ρ', h1, h2⟩
  refine ⟨Nat.find h', (Nat.find_spec h').1, (Nat.find_spec h').2, fun ρ' hρ' ha => ?_⟩
  exact Nat.find_min h' hρ' ⟨lt_trans hρ' (Nat.find_spec h').1, ha⟩

/-- An ask is a forward query of the point, or an inverse query of its image. -/
theorem askedPt_cases {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {z : Bits (ℓ + (ℓ + c))} {ρ : ℕ}
    (h : R.askedPt π z ρ) :
    ∃ i, ∃ e ∈ R.tr π i, e.1 = ρ ∧ (e.2 = .inl z ∨ e.2 = .inr (π z)) := by
  obtain ⟨i, e, he, hρ, hz⟩ := h
  refine ⟨i, e, he, hρ, ?_⟩
  rcases hq : e.2 with x | y
  · rw [hq] at hz; left; rw [← hz]; rfl
  · rw [hq] at hz; right; rw [← hz]; simp [revealPt]

/-- `realPt v` is block `v`'s last chain input. -/
theorem realPt_eq_xin (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    R.realPt π v = R.xin π v (ovCalls R.G v) := (R.xin_pad π v).symm

theorem ovCalls_lt (v : Fin B) : ovCalls R.G v < B + 2 := by
  have h1 := parentsDesc_length_le R.G v
  have h2 := v.isLt
  unfold ovCalls
  omega

/-- A label is `ovR (π (realPt v)) ⊕ Wb v`. -/
theorem labelG_eq_realPt (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) :
    labelG R.G (fun x => π x) R.dom R.Wb v = bxor (ovR (π (R.realPt π v))) (R.Wb v) :=
  labelG_pad R.G (fun x => π x) R.dom R.Wb v

/-- **The simulation.** A forward ask of block `v`'s chain input `p' + 1` in round `ρ` makes call `(v, p' + 1)` in
`ChainKnow` round `ρ + 1` from the observation-round fresh seeds. Strong induction on `ρ`: the call's parent label is
fresh or first asked earlier, and so is its previous chaining value. -/
theorem sim (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ ρ (v : Fin B) (p' : ℕ), p' < ovCalls R.G v →
      (∃ i, ∃ e ∈ R.tr π i, e.1 = ρ ∧ e.2 = .inl (R.xin π v (p' + 1))) →
      (v, p' + 1) ∈ (ChainKnow.reach R.G (R.freshHoldingObs π) (ρ + 1)).hs ∧
      (v, p' + 1) ∈ (ChainKnow.reach R.G (R.freshHoldingObs π) (ρ + 1)).rs := by
  classical
  intro ρ
  induction ρ using Nat.strong_induction_on with
  | _ ρ ih =>
    intro v p' hp' ⟨i, e, he, hρ, hx⟩
    set K := ChainKnow.reach R.G (R.freshHoldingObs π) ρ
    obtain ⟨o, hoK, hoH⟩ := R.obs_of_mem_tr hP he
    rw [hx, hρ] at hoK hoH
    have hxin := xin_succ R π v p' hp'
    -- a label shown in round `ρ` is known by round `ρ`
    have hlab : ∀ u : Fin B, (∃ o : R.Pos, R.obsKey π o = some (labelG R.G (fun x => π x) R.dom R.Wb u, ρ)) →
        u ∈ K.labs := by
      intro u ⟨o', ho'⟩
      by_cases hearly : ∃ ρ' < ρ, R.askedPt π (R.realPt π u) ρ'
      · obtain ⟨ρ₁, hρ₁, hask₁, hfirst⟩ := R.exists_first_ask hearly
        obtain ⟨i₁, e₁, he₁, hr₁, hcase⟩ := R.askedPt_cases hask₁
        rcases hcase with hf | hb
        · rw [realPt_eq_xin] at hf
          obtain ⟨j, hj⟩ : ∃ j, ovCalls R.G u = j + 1 := ⟨ovCalls R.G u - 1, by unfold ovCalls; omega⟩
          rw [hj] at hf
          have := (ih ρ₁ hρ₁ u j (by omega) ⟨i₁, e₁, he₁, hr₁, hf⟩).2
          rw [← hj] at this
          exact (reach_mono R.G _ (by omega : ρ₁ + 1 ≤ ρ)).1 (mem_labs_of_pad R.G _ _ u this)
        · obtain ⟨o₁, ho₁, -⟩ := R.obs_of_mem_tr hP he₁
          rw [hb, hr₁] at ho₁
          refine (labs_subset_reach R.G _ ρ) (Finset.mem_filter.2 ⟨Finset.mem_univ _,
            o₁, ρ₁, _, ho₁, Or.inr rfl, hfirst⟩)
      · push Not at hearly
        refine (labs_subset_reach R.G _ ρ) (Finset.mem_filter.2 ⟨Finset.mem_univ _,
          o', ρ, _, ho', Or.inl (R.labelG_eq_realPt π u), hearly⟩)
    -- a chaining value shown in round `ρ` is known by round `ρ`
    have hch : ∀ q : ℕ, 1 ≤ q → q < ovCalls R.G v →
        (∃ o : R.Pos, R.obsKeyH π o = some (ovH (π (R.xin π v q)), ρ)) → (v, q) ∈ K.hs := by
      intro q hq1 hq ⟨o', ho'⟩
      by_cases hearly : ∃ ρ' < ρ, R.askedPt π (R.xin π v q) ρ'
      · obtain ⟨ρ₁, hρ₁, hask₁, hfirst⟩ := R.exists_first_ask hearly
        obtain ⟨i₁, e₁, he₁, hr₁, hcase⟩ := R.askedPt_cases hask₁
        rcases hcase with hf | hb
        · obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩
          exact (reach_mono R.G _ (by omega : ρ₁ + 1 ≤ ρ)).2.1
            (ih ρ₁ hρ₁ v j (by omega) ⟨i₁, e₁, he₁, hr₁, hf⟩).1
        · obtain ⟨o₁, -, ho₁⟩ := R.obs_of_mem_tr hP he₁
          rw [hb, hr₁] at ho₁
          refine hs_subset_reach R.G _ ρ (Finset.mem_filter.2 ⟨?_, hq1, hq, o₁, ρ₁, ho₁, hfirst⟩)
          exact Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 (by have := R.ovCalls_lt v; omega)⟩
      · push Not at hearly
        refine hs_subset_reach R.G _ ρ (Finset.mem_filter.2 ⟨?_, hq1, hq, o', ρ, ho', hearly⟩)
        exact Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 (by have := R.ovCalls_lt v; omega)⟩
    refine mem_reach_succ_of_canCall R.G _ ρ v (p' + 1) ⟨by omega, by omega, ?_, ?_⟩
    · -- the parent absorbed by this call
      intro u hu
      have hlt : p' < (parentsDesc R.G v).length := (List.getElem?_eq_some_iff.1 hu).1
      have hu' : (parentsDesc R.G v)[p'] = u := (List.getElem?_eq_some_iff.1 hu).2
      refine hlab u ⟨o, ?_⟩
      rw [hoK]
      simp only [qKey, hxin, ovR_append, blks_getElem_parent R π v p' hlt, hu']
    · -- the previous chaining value
      rcases Nat.eq_zero_or_pos p' with h0 | hpos
      · left; omega
      · right
        obtain ⟨q', rfl⟩ : ∃ q', p' = q' + 1 := ⟨p' - 1, by omega⟩
        refine hch (q' + 1) (by omega) hp' ⟨o, ?_⟩
        rw [hoH]
        simp only [qKeyH, hxin, ovH_append, chainH_succ R π v q' (by omega)]

/-- **`mem_reach_of_asked` for observation-round freshness.** If block `v`'s pad input is asked within the `D` online
rounds, `v` is in the `ChainKnow` reach of the fresh seeds after `D` rounds. No collision hypothesis is needed. -/
theorem mem_reach_of_asked_obs (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {v : Fin B} {ρ : ℕ} (hρ : ρ < R.D) (hask : R.askedPt π (R.realPt π v) ρ) :
    v ∈ (ChainKnow.reach R.G (R.freshHoldingObs π) R.D).labs := by
  classical
  obtain ⟨ρ₁, hρ₁, hask₁, hfirst⟩ := R.exists_first_ask (ρ := ρ + 1) ⟨ρ, Nat.lt_succ_self _, hask⟩
  obtain ⟨i₁, e₁, he₁, hr₁, hcase⟩ := R.askedPt_cases hask₁
  rcases hcase with hf | hb
  · rw [realPt_eq_xin] at hf
    obtain ⟨j, hj⟩ : ∃ j, ovCalls R.G v = j + 1 := ⟨ovCalls R.G v - 1, by unfold ovCalls; omega⟩
    rw [hj] at hf
    have := (R.sim hP π ρ₁ v j (by omega) ⟨i₁, e₁, he₁, hr₁, hf⟩).2
    rw [← hj] at this
    exact (Reach.reach_mono R.G _ (by omega : ρ₁ + 1 ≤ R.D)).1 (Reach.mem_labs_of_pad R.G _ _ v this)
  · obtain ⟨o₁, ho₁, -⟩ := R.obs_of_mem_tr hP he₁
    rw [hb, hr₁] at ho₁
    exact (labs_subset_reach R.G _ R.D) (Finset.mem_filter.2 ⟨Finset.mem_univ _, o₁, ρ₁, _, ho₁, Or.inr rfl, hfirst⟩)

/-- The contract's signature, with the (unneeded) collision hypothesis. -/
theorem mem_reach_of_asked_obs' (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (_hbad : ¬ R.Bad π) {v : Fin B} {ρ : ℕ} (hρ : ρ < R.D) (hask : R.askedPt π (R.realPt π v) ρ) :
    v ∈ (ChainKnow.reach R.G (R.freshHoldingObs π) R.D).labs :=
  R.mem_reach_of_asked_obs hP hρ hask

end ChainReplay

end PousSpongeChain

end


