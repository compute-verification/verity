/-! ════ P3Concrete.P3Trace ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete.Tr

open Pous Pous.Labelling
open scoped ENNReal

section Trace

variable {M : IdealModel} {α : Type}

/-- The queries on the path taken when queries are answered by `f`, in order, each with its round (from 0). -/
def trace (f : M.Qry → M.Ans) : OracleProg M α → List (ℕ × M.Qry)
  | .ret _ => []
  | .round qs k => qs.map (fun x => (0, x)) ++ (trace f (k (qs.map f))).map fun e => (e.1 + 1, e.2)

theorem length_trace (f : M.Qry → M.Ans) (P : OracleProg M α) : (trace f P).length = P.work f := by
  induction P with
  | ret a => rfl
  | round qs k ih => simp [trace, OracleProg.work, ih]

theorem round_lt_depth (f : M.Qry → M.Ans) (P : OracleProg M α) : ∀ e ∈ trace f P, e.1 < P.depth f := by
  induction P with
  | ret a => simp [trace]
  | round qs k ih =>
    intro e he
    simp only [trace, List.mem_append, List.mem_map] at he
    simp only [OracleProg.depth]
    rcases he with ⟨x, _, rfl⟩ | ⟨e', he', rfl⟩
    · simp
    · have := ih _ e' he'
      simp only
      omega

/-- `f` and `g` agree on every point that `P` asks, under `f`, before round `r`. -/
def AgreeBefore (f g : M.Qry → M.Ans) (P : OracleProg M α) (r : ℕ) : Prop :=
  ∀ e ∈ trace f P, e.1 < r → f e.2 = g e.2

theorem mem_trace_round (f : M.Qry → M.Ans) (qs : List M.Qry) (k : List M.Ans → OracleProg M α) (x : M.Qry)
    (hx : x ∈ qs) : (0, x) ∈ trace f (.round qs k) := by
  simp only [trace, List.mem_append, List.mem_map]
  exact Or.inl ⟨x, hx, rfl⟩

theorem mem_trace_round_succ (f : M.Qry → M.Ans) (qs : List M.Qry) (k : List M.Ans → OracleProg M α)
    (e : ℕ × M.Qry) (he : e ∈ trace f (k (qs.map f))) : (e.1 + 1, e.2) ∈ trace f (.round qs k) := by
  simp only [trace, List.mem_append, List.mem_map]
  exact Or.inr ⟨e, he, rfl⟩

theorem agree_round {f g : M.Qry → M.Ans} {qs : List M.Qry} {k : List M.Ans → OracleProg M α} {r : ℕ}
    (h : AgreeBefore f g (.round qs k) (r + 1)) :
    qs.map f = qs.map g ∧ AgreeBefore f g (k (qs.map f)) r :=
  ⟨List.map_congr_left fun x hx => h (0, x) (mem_trace_round f qs k x hx) (Nat.succ_pos r),
    fun e he hlt => h (e.1 + 1, e.2) (mem_trace_round_succ f qs k e he) (by omega)⟩

/-- **Transcript locality.** If `f` and `g` agree on the points asked before round `r`, then the transcripts agree,
entry by entry, up to round `r`; and every entry of `g`'s transcript up to round `r` is one of `f`'s. -/
theorem trace_stable (f g : M.Qry → M.Ans) (P : OracleProg M α) : ∀ r : ℕ, AgreeBefore f g P r →
    (∀ (n : ℕ) (e : ℕ × M.Qry), (trace f P)[n]? = some e → e.1 ≤ r → (trace g P)[n]? = some e) ∧
    (∀ e ∈ trace g P, e.1 ≤ r → e ∈ trace f P) := by
  induction P with
  | ret a => intro r _; simp [trace]
  | round qs k ih =>
    intro r hag
    cases r with
    | zero =>
      constructor
      · intro n e hn he
        simp only [trace] at hn ⊢
        by_cases hlt : n < qs.length
        · rw [List.getElem?_append_left (by simpa using hlt)] at hn ⊢
          exact hn
        · rw [List.getElem?_append_right (by simpa using not_lt.1 hlt), List.getElem?_map,
            List.length_map] at hn
          cases hk : (trace f (k (qs.map f)))[n - qs.length]? with
          | none => rw [hk] at hn; simp at hn
          | some e' =>
            simp only [hk, Option.map_some, Option.some.injEq] at hn
            subst hn
            simp at he
      · intro e he he0
        simp only [trace, List.mem_append, List.mem_map] at he ⊢
        rcases he with ⟨x, hx, rfl⟩ | ⟨e', _, rfl⟩
        · exact Or.inl ⟨x, hx, rfl⟩
        · simp at he0
    | succ r =>
      obtain ⟨hqs, hag'⟩ := agree_round hag
      obtain ⟨ih1, ih2⟩ := ih (qs.map f) r hag'
      constructor
      · intro n e hn he
        simp only [trace] at hn ⊢
        rw [← hqs]
        by_cases hlt : n < qs.length
        · rw [List.getElem?_append_left (by simpa using hlt)] at hn ⊢
          exact hn
        · rw [List.getElem?_append_right (by simpa using not_lt.1 hlt), List.getElem?_map,
            List.length_map] at hn ⊢
          cases hk : (trace f (k (qs.map f)))[n - qs.length]? with
          | none => rw [hk] at hn; simp at hn
          | some e' =>
            simp only [hk, Option.map_some, Option.some.injEq] at hn
            subst hn
            rw [ih1 _ e' hk (by simp only at he; omega)]
            rfl
      · intro e he her
        simp only [trace, List.mem_append, List.mem_map] at he ⊢
        rw [← hqs] at he
        rcases he with ⟨x, hx, rfl⟩ | ⟨e', he', rfl⟩
        · exact Or.inl ⟨x, hx, rfl⟩
        · exact Or.inr ⟨e', ih2 e' he' (by simp only at her; omega), rfl⟩

/-- **Output locality.** A program that stops by round `r` returns the same output, at the same depth, under any
oracle that agrees with `f` on the points asked before round `r`. -/
theorem run_stable (f g : M.Qry → M.Ans) (P : OracleProg M α) : ∀ r : ℕ, AgreeBefore f g P r → P.depth f ≤ r →
    P.run g = P.run f ∧ P.depth g = P.depth f := by
  induction P with
  | ret a => intro _ _ _; exact ⟨rfl, rfl⟩
  | round qs k ih =>
    intro r hag hd
    cases r with
    | zero => simp [OracleProg.depth] at hd
    | succ r =>
      obtain ⟨hqs, hag'⟩ := agree_round hag
      have hd' : (k (qs.map f)).depth f ≤ r := by simp only [OracleProg.depth] at hd; omega
      obtain ⟨h1, h2⟩ := ih (qs.map f) r hag' hd'
      simp only [OracleProg.run, OracleProg.depth, ← hqs]
      exact ⟨h1, by rw [h2]⟩


end Trace

end Pous.P3Concrete.Tr

end


/-! ════ P3Concrete.P3ChainReplay ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge


section ChainPts

variable {r c : ℕ}

/-- The chain state after the first `j` blocks. -/
def stAfter (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r)) (j : ℕ) :
    Bits r × Bits (r + c) :=
  (blks.take j).foldl (ovStep f) (fun _ => false, h₀)

/-- The input of call `p` (from 1): block `p` next to the chaining value after `p − 1` calls. -/
def xinAt (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r)) (p : ℕ) :
    Bits (r + (r + c)) :=
  Fin.append (blks.getD (p - 1) padBlk) (stAfter f h₀ blks (p - 1)).2

theorem getD_of_lt {α : Type} (l : List α) (d : α) {i : ℕ} (h : i < l.length) : l.getD i d = l[i] := by
  simp [List.getD, List.getElem?_eq_getElem h]

theorem ovR_append (b : Bits r) (h : Bits (r + c)) : ovR (Fin.append b h) = b := by
  funext j
  simp [ovR, Fin.append_left]

theorem ovH_append (b : Bits r) (h : Bits (r + c)) : ovH (Fin.append b h) = h := by
  funext j
  simp [ovH, Fin.append_right]

theorem stAfter_succ (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r))
    {j : ℕ} (hj : j < blks.length) :
    stAfter f h₀ blks (j + 1) = ovStep f (stAfter f h₀ blks j) blks[j] := by
  unfold stAfter
  rw [List.take_add_one, List.getElem?_eq_getElem hj, Option.toList_some, List.foldl_append]
  rfl

theorem xinAt_ovR (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r)) (p : ℕ) :
    ovR (xinAt f h₀ blks p) = blks.getD (p - 1) padBlk :=
  ovR_append _ _

/-- The chaining value shown in call `p + 1`'s input is the output of call `p`. -/
theorem xinAt_ovH_succ (f : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r))
    {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ blks.length) :
    ovH (xinAt f h₀ blks (p + 1)) = ovH (f (xinAt f h₀ blks p)) := by
  unfold xinAt
  rw [ovH_append, Nat.add_sub_cancel, show p = (p - 1) + 1 by omega, stAfter_succ f h₀ blks (by omega)]
  simp only [ovStep, Nat.add_sub_cancel]
  rw [getD_of_lt _ _ (by omega)]

/-- **The key is the dropped part of the last call.** -/
theorem ovKey_eq_xinAt (f : Bits (r + (r + c)) → Bits (r + (r + c))) (dom : Bits c) (blks : List (Bits r))
    (hne : blks ≠ []) : ovKey f dom blks = ovR (f (xinAt f (iv dom) blks blks.length)) := by
  have hl : 0 < blks.length := List.length_pos_iff.2 hne
  have h1 : ovKey f dom blks = (stAfter f (iv dom) blks ((blks.length - 1) + 1)).1 := by
    unfold ovKey ovAbsorb stAfter
    rw [Nat.sub_add_cancel hl, List.take_length]
  rw [h1, stAfter_succ f (iv dom) blks (by omega)]
  unfold xinAt
  rw [getD_of_lt _ _ (by omega)]
  rfl

end ChainPts


section Rows

variable {n wc : ℕ}

/-- Row `v`'s blocks under the labels `lab`: its parents' labels newest first, then the pad. -/
def rowBlocks (lab : Fin n → Lab n wc) (G : TopoDAG n) (v : Fin n) : List (Bits (n * wc)) :=
  (parentsDesc G v).map (fun u => codeEquiv n wc (lab u)) ++ [padBlk]

theorem rowBlocks_length (lab : Fin n → Lab n wc) (G : TopoDAG n) (v : Fin n) :
    (rowBlocks lab G v).length = ovCalls G v := by
  simp [rowBlocks, ovCalls]

theorem rowBlocks_getD (lab : Fin n → Lab n wc) (G : TopoDAG n) (v : Fin n) {p : ℕ} {u : Fin n}
    (hb : ovBlock G v p = some u) : (rowBlocks lab G v).getD (p - 1) padBlk = codeEquiv n wc (lab u) := by
  unfold ovBlock at hb
  have hlt : p - 1 < (parentsDesc G v).length := by
    by_contra h
    rw [List.getElem?_eq_none (by omega)] at hb
    exact absurd hb (by simp)
  rw [List.getElem?_eq_getElem hlt, Option.some_inj] at hb
  unfold rowBlocks
  rw [getD_of_lt _ _ (by simp; omega), List.getElem_append_left (by simpa using hlt), List.getElem_map, hb]

theorem ovCalls_le (G : TopoDAG n) (v : Fin n) : ovCalls G v ≤ n := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]
  have : (G.par v).card ≤ v.val := by
    calc (G.par v).card ≤ ((Finset.range v.val).attachFin (fun m hm => by
          have := (Finset.mem_range.1 hm); omega)).card := Finset.card_le_card fun u hu => by
            simp only [Finset.mem_attachFin, Finset.mem_range]
            exact G.par_lt v u hu
      _ = v.val := by simp
  omega

end Rows


/-- **One segment's replay**: tag, graph and data, the round and query budget, and the online programs over any index. -/
structure P3Replay (n wc : ℕ) (ι : Type) where
  tag : Bits 256
  G : TopoDAG n
  W : Fin n → Lab n wc
  D : ℕ
  Q : ℕ
  /-- The online programs, over any program index (one segment: `Fin n`; all segments in lock-step: `Fin N × Fin n`). -/
  A : ι → OracleProg (p3ChainModel n wc) (Lab n wc)

namespace P3Replay

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) (ω : P3COmega n wc)

/-- The lower labels. -/
def c1 : Fin n → Lab n wc := c1c R.tag R.G ω.2 ω.1 R.W

/-- The top labels. -/
def c2 : Fin n → Lab n wc := c2c R.tag R.G ω.2 ω.1 R.W

/-- The labels of layer `L`. -/
def lab (L : Fin 2) : Fin n → Lab n wc := if L = 0 then R.c1 ω else R.c2 ω

/-- The input of call `p` of row `(L, v)`. -/
def xin (L : Fin 2) (v : Fin n) (p : ℕ) : Bits (n * wc + (n * wc + 512)) :=
  xinAt ω.2 (iv (domP3 R.tag L v)) (rowBlocks (R.lab ω L) R.G v) p

/-- The chaining value after call `p` of row `(L, v)`. -/
def hval (L : Fin 2) (v : Fin n) (p : ℕ) : Bits (n * wc + 512) := ovH (ω.2 (R.xin ω L v p))

/-- The dropped part of call `p` of row `(L, v)`. -/
def rval (L : Fin 2) (v : Fin n) (p : ℕ) : Bits (n * wc) := ovR (ω.2 (R.xin ω L v p))

/-- Row `(L, v)`'s key: the dropped part of its pad call. -/
def key (L : Fin 2) (v : Fin n) : Lab n wc := (codeEquiv n wc).symm (R.rval ω L v (ovCalls R.G v))

/-- Lower `P` input: `W_w ⊕ key¹_w`. -/
def pin1 (w : Fin n) : Lab n wc := labXor (R.W w) (R.key ω 0 w)

/-- Top `P` input: `transpose(c¹)_u ⊕ key²_u`. -/
def pin2 (u : Fin n) : Lab n wc := labXor (transpose (R.c1 ω) u) (R.key ω 1 u)

theorem key_eq (L : Fin 2) (v : Fin n) :
    R.key ω L v = keyP3c ω.2 R.tag L v ((parentsDesc R.G v).map (R.lab ω L)) := by
  unfold key keyP3c rval xin
  congr 1
  rw [show ((parentsDesc R.G v).map (R.lab ω L)).map (codeEquiv n wc) ++ [padBlk] =
      rowBlocks (R.lab ω L) R.G v by simp [rowBlocks, List.map_map, Function.comp_def],
    ovKey_eq_xinAt _ _ _ (by simp [rowBlocks]), rowBlocks_length]

theorem c1_eq (w : Fin n) : R.c1 ω w = ω.1 (R.tag, 0, w) (R.pin1 ω w) := by
  unfold pin1
  rw [key_eq]
  exact c1c_eq R.tag R.G ω R.W w

theorem c2_eq (u : Fin n) : R.c2 ω u = ω.1 (R.tag, 1, u) (R.pin2 ω u) := by
  unfold pin2
  rw [key_eq]
  exact c2c_eq R.tag R.G ω R.W u


/-- A call's block is its parent's label. -/
theorem xin_ovR {L : Fin 2} {v u : Fin n} {p : ℕ} (hb : ovBlock R.G v p = some u) :
    ovR (R.xin ω L v p) = codeEquiv n wc (R.lab ω L u) := by
  unfold xin
  rw [xinAt_ovR, rowBlocks_getD _ _ _ hb]

/-- A call's chaining value is the previous call's output. -/
theorem xin_ovH {L : Fin 2} {v : Fin n} {p : ℕ} (hp1 : 1 ≤ p) (hp : p < ovCalls R.G v) :
    ovH (R.xin ω L v (p + 1)) = R.hval ω L v p := by
  unfold xin hval
  rw [xinAt_ovH_succ _ _ _ hp1 (by rw [rowBlocks_length]; omega)]
  rfl


/-- Program `v`'s transcript against `ω`. -/
noncomputable def tr (v : ι) : List (ℕ × (p3ChainModel n wc).Qry) := Tr.trace ((p3ChainModel n wc).answer ω) (R.A v)

/-- The `Π₂` point a query reveals: `x` for `Π₂ x`, `Π₂⁻¹ y` for `Π₂⁻¹ y`. -/
def revS : (p3ChainModel n wc).Qry → Option (Bits (n * wc + (n * wc + 512)))
  | .inl (.inl x) => some x
  | .inl (.inr y) => some (ω.2.symm y)
  | .inr _ => none

/-- The `P` point a query reveals: `(T, a)` for `P_T a`, `(T, P_T⁻¹ z)` for `P_T⁻¹ z`. -/
def revP : (p3ChainModel n wc).Qry → Option (Tweak n × Lab n wc)
  | .inl _ => none
  | .inr (T, .inl a) => some (T, a)
  | .inr (T, .inr z) => some (T, (ω.1 T).symm z)

/-- Some program reveals `Π₂` point `z` at round `ρ`. -/
def askedS (z : Bits (n * wc + (n * wc + 512))) (ρ : ℕ) : Prop :=
  ∃ v, ∃ e ∈ R.tr ω v, e.1 = ρ ∧ revS ω e.2 = some z

/-- Some program reveals `P` point `(T, a)` at round `ρ`. -/
def askedP (T : Tweak n) (a : Lab n wc) (ρ : ℕ) : Prop :=
  ∃ v, ∃ e ∈ R.tr ω v, e.1 = ρ ∧ revP ω e.2 = some (T, a)

/-- The label a query shows in the clear: a `Π₂` block, or a `P⁻¹` input. -/
def showLab : (p3ChainModel n wc).Qry → Option (Lab n wc)
  | .inl (.inl x) => some ((codeEquiv n wc).symm (ovR x))
  | .inl (.inr _) => none
  | .inr (_, .inl _) => none
  | .inr (_, .inr z) => some z

/-- The chaining value a query shows: the input's (`Π₂`) or the chosen output's (`Π₂⁻¹`) chained part. -/
def showH : (p3ChainModel n wc).Qry → Option (Bits (n * wc + 512))
  | .inl (.inl x) => some (ovH x)
  | .inl (.inr y) => some (ovH y)
  | .inr _ => none

/-- The dropped part a query shows: the chosen output's (`Π₂⁻¹`). -/
def showR : (p3ChainModel n wc).Qry → Option (Bits (n * wc))
  | .inl (.inr y) => some (ovR y)
  | _ => none

/-- The `P` input a query shows: `(T, a)` for `P_T a`. -/
def showPin : (p3ChainModel n wc).Qry → Option (Tweak n × Lab n wc)
  | .inr (T, .inl a) => some (T, a)
  | _ => none

/-- Label `x` is shown at round `τ`: in some query, or as some program's output (at its depth). -/
def showsLab (x : Lab n wc) (τ : ℕ) : Prop :=
  ∃ v, (∃ e ∈ R.tr ω v, e.1 = τ ∧ showLab e.2 = some x) ∨
    ((R.A v).run ((p3ChainModel n wc).answer ω) = x ∧ (R.A v).depth ((p3ChainModel n wc).answer ω) = τ)

def showsH (h : Bits (n * wc + 512)) (τ : ℕ) : Prop := ∃ v, ∃ e ∈ R.tr ω v, e.1 = τ ∧ showH e.2 = some h

def showsR (x : Bits (n * wc)) (τ : ℕ) : Prop := ∃ v, ∃ e ∈ R.tr ω v, e.1 = τ ∧ showR e.2 = some x

def showsPin (T : Tweak n) (a : Lab n wc) (τ : ℕ) : Prop :=
  ∃ v, ∃ e ∈ R.tr ω v, e.1 = τ ∧ showPin e.2 = some (T, a)

end P3Replay

end Pous.P3Concrete

end


/-! ════ P3ConcreteMulti.Honest ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal


theorem domP3_def (a : Bits 256) (L : Fin 2) (v : ℕ) :
    domP3 a L v = Fin.append a fun j : Fin 256 => (2 * v + L.val).testBit j := rfl

/-- **`domP3` is injective** on nodes below `2^255`: the tag is its first half, and `2v + L` its second. -/
theorem domP3_inj {a a' : Bits 256} {L L' : Fin 2} {v v' : ℕ} (hv : v < 2 ^ 255) (hv' : v' < 2 ^ 255)
    (h : domP3 a L v = domP3 a' L' v') : a = a' ∧ L = L' ∧ v = v' := by
  have ha : a = a' := funext fun j => by
    have hh := congrFun h (Fin.castAdd 256 j)
    rw [domP3_def, domP3_def] at hh
    rwa [Fin.append_left, Fin.append_left] at hh
  have hx : 2 * v + L.val = 2 * v' + L'.val := by
    refine Nat.eq_of_testBit_eq fun i => ?_
    by_cases hi : i < 256
    · have hh := congrFun h (Fin.natAdd 256 (⟨i, hi⟩ : Fin 256))
      rw [domP3_def, domP3_def] at hh
      rw [Fin.append_right, Fin.append_right] at hh
      simpa using hh
    · push Not at hi
      have hL := L.isLt
      have hL' := L'.isLt
      have h256 : (2 : ℕ) ^ 256 ≤ 2 ^ i := Nat.pow_le_pow_right (by norm_num) hi
      rw [Nat.testBit_eq_false_of_lt (by omega), Nat.testBit_eq_false_of_lt (by omega)]
  have hL := L.isLt
  have hL' := L'.isLt
  refine ⟨ha, Fin.ext (by omega), by omega⟩

section IV

variable {r c : ℕ}

theorem iv_def (d : Bits c) : (iv d : Bits (r + c)) = Fin.append (fun _ => false) d := rfl

/-- The IV determines the domain. -/
theorem iv_inj {d d' : Bits c} (h : (iv d : Bits (r + c)) = iv d') : d = d' := funext fun j => by
  have hh := congrFun h (Fin.natAdd r j)
  rw [iv_def, iv_def] at hh
  rwa [Fin.append_right, Fin.append_right] at hh

end IV


section Rows

variable {n wc : ℕ} {ι ι' : Type}

/-- **Row `(L, v)`'s first call shows its IV** in the chained part of its input. -/
theorem ovH_xin_one (R : P3Replay n wc ι) (ω : P3COmega n wc) (L : Fin 2) (v : Fin n) :
    ovH (R.xin ω L v 1) = iv (domP3 R.tag L v) := by
  unfold P3Replay.xin xinAt stAfter
  rw [ovH_append]
  rfl


end Rows


section Chain

variable {r c : ℕ}

/-- **An overwrite chain reads its permutation only at its own call inputs.** -/
theorem stAfter_congr (f g : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r)) :
    ∀ j, j ≤ blks.length → (∀ p, 1 ≤ p → p ≤ j → f (xinAt f h₀ blks p) = g (xinAt f h₀ blks p)) →
      stAfter f h₀ blks j = stAfter g h₀ blks j
  | 0, _, _ => rfl
  | j + 1, hj, hfg => by
    have ih := stAfter_congr f g h₀ blks j (by omega) fun p hp hpj => hfg p hp (by omega)
    rw [stAfter_succ f h₀ blks (by omega), stAfter_succ g h₀ blks (by omega), ← ih]
    have hx : xinAt f h₀ blks (j + 1) = Fin.append blks[j] (stAfter f h₀ blks j).2 := by
      unfold xinAt
      rw [Nat.add_sub_cancel, getD_of_lt _ _ (by omega)]
    have h := hfg (j + 1) (by omega) le_rfl
    rw [hx] at h
    simp only [ovStep, h]

theorem xinAt_congr (f g : Bits (r + (r + c)) → Bits (r + (r + c))) (h₀ : Bits (r + c)) (blks : List (Bits r))
    (hfg : ∀ p, 1 ≤ p → p ≤ blks.length → f (xinAt f h₀ blks p) = g (xinAt f h₀ blks p)) {p : ℕ}
    (hp : p ≤ blks.length) : xinAt f h₀ blks p = xinAt g h₀ blks p := by
  unfold xinAt
  rw [stAfter_congr f g h₀ blks (p - 1) (by omega) fun q hq hqp => hfg q hq (by omega)]

/-- **The key reads the permutation only at the chain's call inputs.** -/
theorem ovKey_congr (f g : Bits (r + (r + c)) → Bits (r + (r + c))) (dom : Bits c) (blks : List (Bits r))
    (hne : blks ≠ []) (hfg : ∀ p, 1 ≤ p → p ≤ blks.length → f (xinAt f (iv dom) blks p) = g (xinAt f (iv dom) blks p)) :
    ovKey f dom blks = ovKey g dom blks := by
  have hl : 1 ≤ blks.length := List.length_pos_iff.2 hne
  rw [ovKey_eq_xinAt f dom blks hne, ovKey_eq_xinAt g dom blks hne, hfg _ hl le_rfl,
    xinAt_congr f g (iv dom) blks hfg le_rfl]

end Chain

namespace Loc

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι)

/-- Row `(L, v)`'s key through the chain, with its blocks as `rowBlocks`. -/
theorem key_eq_ovKey (ω : P3COmega n wc) (L : Fin 2) (v : Fin n) :
    R.key ω L v = (codeEquiv n wc).symm (ovKey ω.2 (domP3 R.tag L v) (rowBlocks (R.lab ω L) R.G v)) := by
  rw [P3Replay.key_eq]
  unfold keyP3c
  congr 2
  simp [rowBlocks, List.map_map, Function.comp_def]

theorem rowBlocks_ne_nil (lab : Fin n → Lab n wc) (G : TopoDAG n) (v : Fin n) : rowBlocks lab G v ≠ [] := by
  simp [rowBlocks]

theorem rowBlocks_congr {lab lab' : Fin n → Lab n wc} (G : TopoDAG n) (v : Fin n)
    (h : ∀ u ∈ G.par v, lab u = lab' u) : rowBlocks lab G v = rowBlocks lab' G v := by
  unfold rowBlocks
  congr 1
  exact List.map_congr_left fun u hu => by rw [h u ((Finset.mem_sort _).1 hu)]

/-- A row's key agrees under two primitives if its parents' labels agree and `Π₂` agrees at its honest inputs. -/
theorem key_congr {ω ω' : P3COmega n wc} (L : Fin 2) (v : Fin n)
    (hpar : ∀ u ∈ R.G.par v, R.lab ω' L u = R.lab ω L u)
    (hS : ∀ p, 1 ≤ p → p ≤ ovCalls R.G v → ω.2 (R.xin ω L v p) = ω'.2 (R.xin ω L v p)) :
    R.key ω' L v = R.key ω L v := by
  rw [key_eq_ovKey, key_eq_ovKey, rowBlocks_congr R.G v hpar]
  congr 1
  refine (ovKey_congr ω.2 ω'.2 _ _ (rowBlocks_ne_nil _ _ _) fun p hp hpl => ?_).symm
  rw [rowBlocks_length] at hpl
  exact hS p hp hpl

variable {ω ω' : P3COmega n wc}


end Loc


section Bad

variable {N n wc : ℕ}

/-- Segment `s`'s honest computation: a replay with no programs. -/
def baseReplay (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (s : Fin N) :
    P3Replay n wc Empty :=
  ⟨tags s, G, W s, 0, 0, Empty.elim⟩


/-- Two distinct honest `Π₂` positions of the store share an input. -/
def HonestCollJ (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (ω : P3COmega n wc) :
    Prop :=
  ∃ (s s' : Fin N) (L L' : Fin 2) (v v' : Fin n) (p p' : ℕ), 1 ≤ p ∧ p ≤ ovCalls G v ∧ 1 ≤ p' ∧
    p' ≤ ovCalls G v' ∧ (s, L, v, p) ≠ (s', L', v', p') ∧
    (baseReplay tags G W s).xin ω L v p = (baseReplay tags G W s').xin ω L' v' p'

/-- Two distinct labels of the store coincide. -/
def LabCollJ (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (ω : P3COmega n wc) : Prop :=
  ∃ (s s' : Fin N) (L L' : Fin 2) (v v' : Fin n), (s, L, v) ≠ (s', L', v') ∧
    (baseReplay tags G W s).lab ω L v = (baseReplay tags G W s').lab ω L' v'

/-- **The joint bad event.** -/
def JBad (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (ω : P3COmega n wc) : Prop :=
  HonestCollJ tags G W ω ∨ LabCollJ tags G W ω

/-- **Off the bad event, distinct honest positions are distinct points.** -/
theorem xin_ne_of_not_JBad {tags : Fin N → Bits 256} {G : TopoDAG n} {W : Fin N → Fin n → Lab n wc}
    {ω : P3COmega n wc} (h : ¬ JBad tags G W ω) {s s' : Fin N} {L L' : Fin 2} {v v' : Fin n} {p p' : ℕ}
    (hp : 1 ≤ p) (hpv : p ≤ ovCalls G v) (hp' : 1 ≤ p') (hpv' : p' ≤ ovCalls G v')
    (hne : (s, L, v, p) ≠ (s', L', v', p')) :
    (baseReplay tags G W s).xin ω L v p ≠ (baseReplay tags G W s').xin ω L' v' p' :=
  fun heq => h (Or.inl ⟨s, s', L, L', v, v', p, p', hp, hpv, hp', hpv', hne, heq⟩)

/-- **The joint birthday** (proved in `Birthday.lean`, `jointBirthday`). With injective tags and `n ≤ 2^255`, the
joint bad event has probability at most the target's collision term. -/
def JointBirthday : Prop :=
  ∀ (N n wc Q : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    Function.Injective tags → n ≤ 2 ^ 255 →
    pr (JBad tags G W) ≤ (((N * nPosC n Q) ^ 2 + (2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

end Bad

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.BirthdayPin ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

namespace Bday


theorem pr_congr_inst {α : Type} (i1 i2 : Fintype α) (P : α → Prop) : @pr α i1 P = @pr α i2 P := by
  rw [Subsingleton.elim i1 i2]

theorem pr_or_le {α : Type} [Fintype α] (P Q : α → Prop) : pr (fun x => P x ∨ Q x) ≤ pr P + pr Q := by
  classical
  simp only [pr_def]
  rw [← ENNReal.add_div]
  gcongr
  rw [Finset.filter_or]
  exact_mod_cast Finset.card_union_le _ _

/-- **Averaging over the first coordinate.** -/
theorem pr_le_of_forall_fst {α β : Type} [Fintype α] [Fintype β] [Nonempty α] [Nonempty β] (R : α × β → Prop)
    (c : ℝ≥0∞) (h : ∀ a, pr (fun b => R (a, b)) ≤ c) : pr R ≤ c := by
  classical
  have hα0 : (Fintype.card α : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hβ0 : (Fintype.card β : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hαt : (Fintype.card α : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hβt : (Fintype.card β : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hcount : ((Finset.univ.filter R).card : ℝ≥0∞) = ∑ a, ((Finset.univ.filter fun b => R (a, b)).card : ℝ≥0∞) := by
    rw [Finset.natCast_card_filter, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.natCast_card_filter]
  have hfib : ∀ a, ((Finset.univ.filter fun b => R (a, b)).card : ℝ≥0∞) ≤ c * Fintype.card β := by
    intro a
    have := h a
    rwa [pr_def, ENNReal.div_le_iff hβ0 hβt] at this
  rw [pr_def, hcount, Fintype.card_prod, Nat.cast_mul,
    ENNReal.div_le_iff (mul_ne_zero hα0 hβ0) (ENNReal.mul_ne_top hαt hβt)]
  calc ∑ a, ((Finset.univ.filter fun b => R (a, b)).card : ℝ≥0∞) ≤ ∑ _a : α, c * Fintype.card β :=
        Finset.sum_le_sum fun a _ => hfib a
    _ = c * (Fintype.card α * Fintype.card β) := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; ring

theorem inv_two_pow_sub_le {ℓ n : ℕ} (h : 2 * n ≤ 2 ^ ℓ) :
    (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹ ≤ 2 * ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := by
  have hnat : (2 : ℕ) ^ ℓ ≤ 2 * (2 ^ ℓ - n) := by omega
  have hcast : ((2 : ℝ≥0∞) ^ ℓ) ≤ 2 * (((2 ^ ℓ - n : ℕ) : ℝ≥0∞)) := by
    have := (Nat.cast_le (α := ℝ≥0∞)).2 hnat
    rw [Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] at this
    simpa using this
  have ha : ((2 ^ ℓ - n : ℕ) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : (2 : ℝ≥0∞) ≠ 0 := two_ne_zero
  have h2t : (2 : ℝ≥0∞) ≠ ⊤ := ENNReal.ofNat_ne_top
  calc (((2 ^ ℓ - n : ℕ) : ℝ≥0∞))⁻¹ = 2 * (2 * (((2 ^ ℓ - n : ℕ) : ℝ≥0∞)))⁻¹ := by
        rw [ENNReal.mul_inv (Or.inl h2) (Or.inl h2t), ← mul_assoc, ENNReal.mul_inv_cancel h2 h2t, one_mul]
    _ ≤ 2 * ((2 : ℝ≥0∞) ^ ℓ)⁻¹ := by gcongr

theorem append_ovR_ovH {r c : ℕ} (o : Bits (r + (r + c))) : Fin.append (ovR o) (ovH o) = o := by
  funext i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp only [Fin.append_left, Fin.append_right, ovR, ovH]

theorem card_bits (n : ℕ) : Fintype.card (Bits n) = 2 ^ n := by simp [Bits]


section Pin

variable {r c : ℕ}

/-- Set `π z` to `t`, swapping with the point that `π` sent to `t`. -/
def swapTo (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) : Equiv.Perm (Bits (r + (r + c))) :=
  Equiv.swap (π z) t * π

theorem swapTo_self (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) : swapTo π z t z = t := by
  simp only [swapTo, Equiv.Perm.mul_apply, Equiv.swap_apply_left]

theorem swapTo_apply_ne (π : Equiv.Perm (Bits (r + (r + c)))) (z t x : Bits (r + (r + c))) (hx : x ≠ z)
    (hy : π x ≠ t) : swapTo π z t x = π x := by
  simp only [swapTo, Equiv.Perm.mul_apply]
  exact Equiv.swap_apply_of_ne_of_ne (fun h => hx (π.injective h)) hy

theorem swapTo_recover (π : Equiv.Perm (Bits (r + (r + c)))) (z t : Bits (r + (r + c))) :
    Equiv.swap (π z) (swapTo π z t z) * swapTo π z t = π := by
  rw [swapTo_self]
  show Equiv.swap (π z) t * (Equiv.swap (π z) t * π) = π
  rw [← mul_assoc, Equiv.swap_mul_self, one_mul]

open Classical in
/-- **Adaptive pin.** Let `z π` be a point, `T π` an `h`-value and `S π` a set of at most `n` points, where `z` and `T`
depend on `π` only through `S π`. The permutations with `ovH (π (z π)) = T π` and `z π ∉ S π`, times `2^(r+c) − n`,
number at most all permutations. -/
theorem card_pin_le (z : Equiv.Perm (Bits (r + (r + c))) → Bits (r + (r + c)))
    (T : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c))
    (S : Equiv.Perm (Bits (r + (r + c))) → Finset (Bits (r + (r + c)))) (n : ℕ)
    (hS : ∀ π, (S π).card ≤ n)
    (hstab : ∀ π π' : Equiv.Perm (Bits (r + (r + c))), (∀ x ∈ S π, π' x = π x) → z π' = z π ∧ T π' = T π)
    (E : Equiv.Perm (Bits (r + (r + c))) → Prop)
    (hE : ∀ π, E π → ovH (π (z π)) = T π ∧ z π ∉ S π) :
    (Finset.univ.filter E).card * (2 ^ (r + c) - n) ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := by
  let good : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c) → Prop :=
    fun π h' => ∀ x ∈ S π, π x ≠ Fin.append (ovR (π (z π))) h'
  have hgood_card : ∀ π, 2 ^ (r + c) - n ≤ (Finset.univ.filter (good π)).card := by
    intro π
    have hbad : (Finset.univ.filter fun h' => ¬ good π h') ⊆ (S π).image (fun x => ovH (π x)) := by
      intro h' hh
      simp only [good, Finset.mem_filter, Finset.mem_univ, true_and, not_forall, not_not] at hh
      obtain ⟨x, hx, hxe⟩ := hh
      exact Finset.mem_image.2 ⟨x, hx, by rw [hxe, ovH_append]⟩
    have hsplit := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset (Bits (r + c)))) (good π)
    rw [Finset.card_univ, card_bits] at hsplit
    have := (Finset.card_le_card hbad).trans (Finset.card_image_le.trans (hS π))
    omega
  have hpairs : (Finset.univ.filter E).card * (2 ^ (r + c) - n) ≤
      ((Finset.univ.filter E ×ˢ (Finset.univ : Finset (Bits (r + c)))).filter (fun p => good p.1 p.2)).card := by
    have hsum : ((Finset.univ.filter E ×ˢ (Finset.univ : Finset (Bits (r + c)))).filter
        (fun p => good p.1 p.2)).card = ∑ π ∈ Finset.univ.filter E, (Finset.univ.filter (good π)).card := by
      rw [Finset.card_filter, Finset.sum_product]
      exact Finset.sum_congr rfl (fun π _ => (Finset.card_filter _ _).symm)
    rw [hsum, ← smul_eq_mul]
    exact Finset.card_nsmul_le_sum _ _ _ (fun π _ => hgood_card π)
  refine hpairs.trans ((Finset.card_le_card_of_injOn
    (fun p => swapTo p.1 (z p.1) (Fin.append (ovR (p.1 (z p.1))) p.2))
    (fun _ _ => Finset.mem_coe.2 (Finset.mem_univ _)) ?_).trans Finset.card_univ.le)
  intro p₁ hp₁ p₂ hp₂ heq
  simp only [Finset.coe_filter, Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and,
    Set.mem_ofPred_eq] at hp₁ hp₂
  obtain ⟨⟨hE₁, -⟩, hg₁⟩ := hp₁
  obtain ⟨⟨hE₂, -⟩, hg₂⟩ := hp₂
  dsimp only at heq
  set π' := swapTo p₁.1 (z p₁.1) (Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2) with hπ'
  have hag₁ : ∀ x ∈ S p₁.1, π' x = p₁.1 x := fun x hx =>
    swapTo_apply_ne _ _ _ x (fun h => (hE p₁.1 hE₁).2 (h ▸ hx)) (hg₁ x hx)
  have hag₂ : ∀ x ∈ S p₂.1, π' x = p₂.1 x := fun x hx => by
    rw [heq]; exact swapTo_apply_ne _ _ _ x (fun h => (hE p₂.1 hE₂).2 (h ▸ hx)) (hg₂ x hx)
  obtain ⟨hz₁, hT₁⟩ := hstab p₁.1 π' hag₁
  obtain ⟨hz₂, hT₂⟩ := hstab p₂.1 π' hag₂
  have hzz : z p₂.1 = z p₁.1 := hz₂.symm.trans hz₁
  have hself₁ : π' (z p₁.1) = Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2 := swapTo_self _ _ _
  have hself₂ : π' (z p₁.1) = Fin.append (ovR (p₂.1 (z p₁.1))) p₂.2 := by
    rw [heq, ← hzz]; exact swapTo_self _ _ _
  have hh : p₁.2 = p₂.2 := by
    have := congrArg ovH (hself₁.symm.trans hself₂)
    simpa only [ovH_append] using this
  have hr : ovR (p₁.1 (z p₁.1)) = ovR (p₂.1 (z p₁.1)) := by
    have := congrArg ovR (hself₁.symm.trans hself₂)
    simpa only [ovR_append] using this
  have hv : p₁.1 (z p₁.1) = p₂.1 (z p₁.1) := by
    rw [← append_ovR_ovH (p₁.1 (z p₁.1)), ← append_ovR_ovH (p₂.1 (z p₁.1)), hr]
    congr 1
    rw [(hE p₁.1 hE₁).1, ← hzz, (hE p₂.1 hE₂).1, ← hT₁, hT₂]
  have hrec₁ := swapTo_recover p₁.1 (z p₁.1) (Fin.append (ovR (p₁.1 (z p₁.1))) p₁.2)
  have hrec₂ := swapTo_recover p₂.1 (z p₂.1) (Fin.append (ovR (p₂.1 (z p₂.1))) p₂.2)
  rw [← hπ'] at hrec₁
  rw [← heq, hzz] at hrec₂
  refine Prod.ext ?_ hh
  rw [← hrec₁, ← hrec₂, hv]

open Classical in
/-- **Adaptive pin, as a probability**: the event has probability at most `1/(2^(r+c) − n)`. -/
theorem pr_pin_le (z : Equiv.Perm (Bits (r + (r + c))) → Bits (r + (r + c)))
    (T : Equiv.Perm (Bits (r + (r + c))) → Bits (r + c))
    (S : Equiv.Perm (Bits (r + (r + c))) → Finset (Bits (r + (r + c)))) (n : ℕ)
    (hS : ∀ π, (S π).card ≤ n)
    (hstab : ∀ π π' : Equiv.Perm (Bits (r + (r + c))), (∀ x ∈ S π, π' x = π x) → z π' = z π ∧ T π' = T π)
    (E : Equiv.Perm (Bits (r + (r + c))) → Prop)
    (hE : ∀ π, E π → ovH (π (z π)) = T π ∧ z π ∉ S π) :
    pr E ≤ (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by
  have hnat := card_pin_le z T S n hS hstab E hE
  rcases Nat.eq_zero_or_pos (2 ^ (r + c) - n) with h0 | hpos
  · rw [h0, Nat.cast_zero, ENNReal.inv_zero]; exact le_top
  have hΩ0 : (Fintype.card (Equiv.Perm (Bits (r + (r + c)))) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (Equiv.Perm (Bits (r + (r + c)))) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h2 : (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) ≠ 0 := by exact_mod_cast hpos.ne'
  have h2t : (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) ≠ ⊤ := ENNReal.natCast_ne_top _
  rw [pr_def, ENNReal.div_le_iff hΩ0 hΩt]
  have hc : ((Finset.univ.filter E).card : ℝ≥0∞) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))
      ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := by exact_mod_cast hnat
  calc ((Finset.univ.filter E).card : ℝ≥0∞)
      = (Finset.univ.filter E).card * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞)) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by
        rw [mul_assoc, ENNReal.mul_inv_cancel h2 h2t, mul_one]
    _ ≤ Fintype.card (Equiv.Perm (Bits (r + (r + c)))) * (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ := by gcongr
    _ = (((2 ^ (r + c) - n : ℕ) : ℝ≥0∞))⁻¹ * Fintype.card (Equiv.Perm (Bits (r + (r + c)))) := mul_comm _ _

end Pin


section PPin

variable {τ α β : Type} [Fintype τ] [DecidableEq τ] [Fintype α] [DecidableEq α] [Fintype β]

/-- Reset tweak `T` of `ω.1` to `σ`. -/
def upd (T : τ) (ω : (τ → Equiv.Perm α) × β) (σ : Equiv.Perm α) : (τ → Equiv.Perm α) × β :=
  (Function.update ω.1 T σ, ω.2)

omit [Fintype τ] [Fintype β] in
open Classical in
/-- **The `P` pin.** If `x` and `y` do not read tweak `T`, the primitives with `ω.1 T (x ω) = y ω`, times `|α|`,
number at most all primitives. -/
theorem card_ppin_le [inst : Fintype ((τ → Equiv.Perm α) × β)] (T : τ) (x y : (τ → Equiv.Perm α) × β → α)
    (hx : ∀ ω σ, x (upd T ω σ) = x ω) (hy : ∀ ω σ, y (upd T ω σ) = y ω) :
    (Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω).card * Fintype.card α ≤
      Fintype.card ((τ → Equiv.Perm α) × β) := by
  set E := Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω
  let F : ((τ → Equiv.Perm α) × β) × α → (τ → Equiv.Perm α) × β :=
    fun p => upd T p.1 (Equiv.swap (y p.1) p.2 * p.1.1 T)
  have hF1 : ∀ p : ((τ → Equiv.Perm α) × β) × α, p.1 ∈ E → (F p).1 T (x (F p)) = p.2 := by
    intro p hp
    have hp' : p.1.1 T (x p.1) = y p.1 := (Finset.mem_filter.1 hp).2
    have e1 : x (F p) = x p.1 := hx p.1 _
    rw [e1]
    simp only [F, upd, Function.update_self, Equiv.Perm.mul_apply, hp', Equiv.swap_apply_left]
  rw [← Finset.card_univ (α := α), ← Finset.card_product]
  refine (Finset.card_le_card_of_injOn F (fun _ _ => Finset.mem_coe.2 (Finset.mem_univ _)) ?_).trans
    Finset.card_univ.le
  intro p₁ hp₁ p₂ hp₂ heq
  simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe] at hp₁ hp₂
  have ht : p₁.2 = p₂.2 := by rw [← hF1 p₁ hp₁.1, ← hF1 p₂ hp₂.1, heq]
  have hy12 : y p₁.1 = y p₂.1 := by rw [← hy p₁.1 (Equiv.swap (y p₁.1) p₁.2 * p₁.1.1 T),
    ← hy p₂.1 (Equiv.swap (y p₂.1) p₂.2 * p₂.1.1 T)]; exact congrArg y heq
  have h2 : p₁.1.2 = p₂.1.2 := by
    have e := congrArg Prod.snd heq
    simpa [F, upd] using e
  have hT : p₁.1.1 T = p₂.1.1 T := by
    have e := congrArg (fun ω : (τ → Equiv.Perm α) × β => ω.1 T) heq
    simp only [F, upd, Function.update_self] at e
    rw [hy12, ht] at e
    exact mul_left_cancel e
  have hrest : ∀ T', p₁.1.1 T' = p₂.1.1 T' := by
    intro T'
    by_cases hT' : T' = T
    · rw [hT', hT]
    · have e := congrArg (fun ω : (τ → Equiv.Perm α) × β => ω.1 T') heq
      simpa [F, upd, Function.update_of_ne hT'] using e
  exact Prod.ext (Prod.ext (funext hrest) h2) ht

omit [Fintype τ] [Fintype β] in
open Classical in
/-- **The `P` pin, as a probability**: at most `1/|α|`. -/
theorem pr_ppin_le [inst : Fintype ((τ → Equiv.Perm α) × β)] [Nonempty α] [Nonempty β] (T : τ)
    (x y : (τ → Equiv.Perm α) × β → α) (hx : ∀ ω σ, x (upd T ω σ) = x ω) (hy : ∀ ω σ, y (upd T ω σ) = y ω) :
    pr (fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω) ≤ ((Fintype.card α : ℝ≥0∞))⁻¹ := by
  have hnat := card_ppin_le T x y hx hy
  have hΩ0 : (Fintype.card ((τ → Equiv.Perm α) × β) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast (Fintype.card_pos_iff.2 ⟨(fun _ => 1, Classical.arbitrary β)⟩).ne'
  have hΩt : (Fintype.card ((τ → Equiv.Perm α) × β) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hα0 : (Fintype.card α : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hαt : (Fintype.card α : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  rw [pr_def, ENNReal.div_le_iff hΩ0 hΩt]
  have hc : ((Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω).card : ℝ≥0∞) *
      Fintype.card α ≤ Fintype.card ((τ → Equiv.Perm α) × β) := by exact_mod_cast hnat
  calc ((Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω).card : ℝ≥0∞)
      = (Finset.univ.filter fun ω : (τ → Equiv.Perm α) × β => ω.1 T (x ω) = y ω).card * Fintype.card α *
          ((Fintype.card α : ℝ≥0∞))⁻¹ := by rw [mul_assoc, ENNReal.mul_inv_cancel hα0 hαt, mul_one]
    _ ≤ Fintype.card ((τ → Equiv.Perm α) × β) * ((Fintype.card α : ℝ≥0∞))⁻¹ := by gcongr
    _ = ((Fintype.card α : ℝ≥0∞))⁻¹ * Fintype.card ((τ → Equiv.Perm α) × β) := mul_comm _ _

end PPin

end Bday

end PousP3ConcreteMulti

end


/-! ════ P3ConcreteMulti.Birthday ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousP3ConcreteMulti

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Concrete
open scoped ENNReal

set_option maxRecDepth 8000

namespace Bday


section Prefix

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) {ω ω' : P3COmega n wc}

/-- **Lower labels up to `u` are local** to `P` at lower tweaks `≤ u` and `Π₂` at lower rows `≤ u`. -/
theorem c1_congr_le (u : Fin n) (hP : ∀ u' : Fin n, u' ≤ u → ω'.1 (R.tag, 0, u') = ω.1 (R.tag, 0, u'))
    (hS : ∀ u' : Fin n, u' ≤ u → ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 0 u' p) = ω'.2 (R.xin ω 0 u' p)) :
    ∀ u' : Fin n, u' ≤ u → R.c1 ω' u' = R.c1 ω u' := by
  intro u'
  induction u' using WellFoundedLT.induction with
  | _ u' ih =>
    intro hu'
    rw [R.c1_eq ω', R.c1_eq ω, hP u' hu']
    unfold P3Replay.pin1
    rw [Loc.key_congr R 0 u' (fun w hw => ih w (R.G.par_lt u' w hw) ((R.G.par_lt u' w hw).le.trans hu'))
      (hS u' hu')]

/-- **Top labels up to `u` are local**, given all lower labels. -/
theorem c2_congr_le (hc1 : R.c1 ω' = R.c1 ω) (u : Fin n)
    (hP : ∀ u' : Fin n, u' ≤ u → ω'.1 (R.tag, 1, u') = ω.1 (R.tag, 1, u'))
    (hS : ∀ u' : Fin n, u' ≤ u → ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 1 u' p) = ω'.2 (R.xin ω 1 u' p)) :
    ∀ u' : Fin n, u' ≤ u → R.c2 ω' u' = R.c2 ω u' := by
  intro u'
  induction u' using WellFoundedLT.induction with
  | _ u' ih =>
    intro hu'
    rw [R.c2_eq ω', R.c2_eq ω, hP u' hu']
    unfold P3Replay.pin2
    rw [hc1, Loc.key_congr R 1 u' (fun w hw => ih w (R.G.par_lt u' w hw) ((R.G.par_lt u' w hw).le.trans hu'))
      (hS u' hu')]

/-- All lower labels, from `P` at all lower tweaks and `Π₂` at all lower rows. -/
theorem c1_congr_all (hP : ∀ u' : Fin n, ω'.1 (R.tag, 0, u') = ω.1 (R.tag, 0, u'))
    (hS : ∀ u' : Fin n, ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 0 u' p) = ω'.2 (R.xin ω 0 u' p)) :
    R.c1 ω' = R.c1 ω :=
  funext fun u => c1_congr_le R u (fun u' _ => hP u') (fun u' _ => hS u') u le_rfl

/-- **The lower `P` input of `w` reads `P` only at lower tweaks `< w`.** -/
theorem pin1_congr (w : Fin n) (hP : ∀ u' : Fin n, u' < w → ω'.1 (R.tag, 0, u') = ω.1 (R.tag, 0, u'))
    (hS : ∀ u' : Fin n, u' ≤ w → ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 0 u' p) = ω'.2 (R.xin ω 0 u' p)) :
    R.pin1 ω' w = R.pin1 ω w := by
  unfold P3Replay.pin1
  rw [Loc.key_congr R 0 w (fun u hu => ?_) (hS w le_rfl)]
  have huw := R.G.par_lt w u hu
  exact c1_congr_le R u (fun u' hu' => hP u' (lt_of_le_of_lt hu' huw)) (fun u' hu' => hS u' (hu'.trans huw.le)) u le_rfl

/-- **The top `P` input of `u` reads `P` only at lower tweaks and top tweaks `< u`.** -/
theorem pin2_congr (hc1 : R.c1 ω' = R.c1 ω) (u : Fin n)
    (hP : ∀ u' : Fin n, u' < u → ω'.1 (R.tag, 1, u') = ω.1 (R.tag, 1, u'))
    (hS : ∀ u' : Fin n, u' ≤ u → ∀ p, 1 ≤ p → p ≤ ovCalls R.G u' → ω.2 (R.xin ω 1 u' p) = ω'.2 (R.xin ω 1 u' p)) :
    R.pin2 ω' u = R.pin2 ω u := by
  unfold P3Replay.pin2
  rw [hc1, Loc.key_congr R 1 u (fun w hw => ?_) (hS u le_rfl)]
  have hwu := R.G.par_lt u w hw
  exact c2_congr_le R hc1 w (fun u' hu' => hP u' (lt_of_le_of_lt hu' hwu)) (fun u' hu' => hS u' (hu'.trans hwu.le))
    w le_rfl

end Prefix


theorem seg_div {s i B : ℕ} (hi : i < B) : (s * B + i) / B = s := by
  rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega : 0 < B), Nat.div_eq_of_lt hi, Nat.zero_add]

/-- Quotient and remainder determine the number. -/
theorem divmod_inj {D a a' x x' : ℕ} (hx : x < D) (hx' : x' < D) (h : a * D + x = a' * D + x') :
    a = a' ∧ x = x' := by
  have h1 := seg_div (s := a) hx
  have h2 := seg_div (s := a') hx'
  rw [h] at h1
  have ha : a = a' := h1.symm.trans h2
  subst ha
  exact ⟨rfl, by omega⟩

section Pos

variable {N n : ℕ}

/-- A store row `(s, L, v)`: its key orders by segment, layer, then row. -/
def rowKey (n : ℕ) (ρ : Fin N × Fin 2 × Fin n) : ℕ := (ρ.1.val * 2 + ρ.2.1.val) * n + ρ.2.2.val

/-- A store position `(row, call)`. -/
def posKey (n : ℕ) (q : (Fin N × Fin 2 × Fin n) × ℕ) : ℕ := rowKey n q.1 * (n + 2) + q.2

theorem rowKey_inj {ρ ρ' : Fin N × Fin 2 × Fin n} (h : rowKey n ρ = rowKey n ρ') : ρ = ρ' := by
  obtain ⟨h1, h2⟩ := divmod_inj ρ.2.2.isLt ρ'.2.2.isLt h
  obtain ⟨h3, h4⟩ := divmod_inj ρ.2.1.isLt ρ'.2.1.isLt h1
  exact Prod.ext (Fin.ext h3) (Prod.ext (Fin.ext h4) (Fin.ext h2))


variable (G : TopoDAG n)

/-- The honest chain positions of the store: call `p` of row `(s, L, v)`, `1 ≤ p ≤ ovCalls v`. -/
def posSetJ (N : ℕ) : Finset ((Fin N × Fin 2 × Fin n) × ℕ) :=
  (Finset.univ ×ˢ Finset.range (n + 2)).filter fun q => 1 ≤ q.2 ∧ q.2 ≤ ovCalls G q.1.2.2

theorem mem_posSetJ {q : (Fin N × Fin 2 × Fin n) × ℕ} : q ∈ posSetJ G N ↔ 1 ≤ q.2 ∧ q.2 ≤ ovCalls G q.1.2.2 := by
  unfold posSetJ
  rw [Finset.mem_filter]
  refine ⟨fun h => h.2, fun h => ⟨Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 ?_⟩, h⟩⟩
  have := ovCalls_le G q.1.2.2
  omega

theorem posKey_inj {q q' : (Fin N × Fin 2 × Fin n) × ℕ} (hq : q ∈ posSetJ G N) (hq' : q' ∈ posSetJ G N)
    (h : posKey n q = posKey n q') : q = q' := by
  have h1 := ovCalls_le G q.1.2.2
  have h2 := ovCalls_le G q'.1.2.2
  have hq2 := ((mem_posSetJ G).1 hq).2
  have hq2' := ((mem_posSetJ G).1 hq').2
  obtain ⟨e1, e2⟩ := divmod_inj (D := n + 2) (by omega) (by omega) h
  exact Prod.ext (rowKey_inj e1) e2

/-- A position of an earlier row comes before every position of a later row. -/
theorem posKey_lt_of_rowKey {q q' : (Fin N × Fin 2 × Fin n) × ℕ} (hq : q ∈ posSetJ G N)
    (h : rowKey n q.1 < rowKey n q'.1) : posKey n q < posKey n q' := by
  have h1 := ovCalls_le G q.1.2.2
  have hq2 := ((mem_posSetJ G).1 hq).2
  have e : (rowKey n q.1 + 1) * (n + 2) ≤ rowKey n q'.1 * (n + 2) := Nat.mul_le_mul_right _ h
  unfold posKey
  rw [Nat.add_mul, one_mul] at e
  omega

theorem rowKey_lt_same_layer {s : Fin N} {L : Fin 2} {u v : Fin n} (h : u < v) :
    rowKey n (s, L, u) < rowKey n (s, L, v) := by
  unfold rowKey; simp only; rw [Fin.lt_def] at h; omega

theorem rowKey_lt_lower_top (s : Fin N) (u v : Fin n) : rowKey n (s, (0 : Fin 2), u) < rowKey n (s, (1 : Fin 2), v) := by
  have hu := u.isLt
  unfold rowKey
  simp only [Fin.val_zero, Fin.val_one, add_zero]
  rw [Nat.add_mul, one_mul]
  omega

/-- **At most `N·n(n+1)` honest positions**: row `v` has at most `v + 1` calls. -/
theorem card_posSetJ_le : (posSetJ G N).card ≤ N * (n * (n + 1)) := by
  have hcall : ∀ v : Fin n, ovCalls G v ≤ v.val + 1 := by
    intro v
    unfold ovCalls parentsDesc
    rw [Finset.length_sort]
    have : (G.par v).card ≤ v.val :=
      calc (G.par v).card ≤ (Finset.range v.val).card :=
            Finset.card_le_card_of_injOn (fun u => u.val)
              (fun u hu => Finset.mem_range.2 (Fin.lt_def.1 (G.par_lt v u hu))) (fun a _ b _ h => Fin.ext h)
        _ = v.val := Finset.card_range _
    omega
  have hsub : posSetJ G N ⊆ Finset.univ.biUnion
      (fun ρ : Fin N × Fin 2 × Fin n => (Finset.Icc 1 (ovCalls G ρ.2.2)).image (fun p => (ρ, p))) := by
    intro q hq
    obtain ⟨h1, h2⟩ := (mem_posSetJ G).1 hq
    exact Finset.mem_biUnion.2 ⟨q.1, Finset.mem_univ _, Finset.mem_image.2 ⟨q.2, Finset.mem_Icc.2 ⟨h1, h2⟩, rfl⟩⟩
  refine (Finset.card_le_card hsub).trans (Finset.card_biUnion_le.trans ?_)
  have htri : ∑ v : Fin n, (v.val + 1) * 2 = n * (n + 1) := by
    rw [← Finset.sum_mul, Fin.sum_univ_eq_sum_range (fun i => i + 1) n, Finset.sum_add_distrib, Finset.sum_const,
      Finset.card_range, smul_eq_mul, mul_one, add_mul, Finset.sum_range_id_mul_two]
    cases n with
    | zero => rfl
    | succ k => simp only [Nat.succ_sub_one]; ring
  calc ∑ ρ : Fin N × Fin 2 × Fin n, ((Finset.Icc 1 (ovCalls G ρ.2.2)).image (fun p => (ρ, p))).card
      ≤ ∑ ρ : Fin N × Fin 2 × Fin n, (ρ.2.2.val + 1) := Finset.sum_le_sum fun ρ _ => by
        refine Finset.card_image_le.trans ?_
        rw [Nat.card_Icc]
        have := hcall ρ.2.2
        omega
    _ = N * (2 * ∑ v : Fin n, (v.val + 1)) := by
        simp only [Fintype.sum_prod_type, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
    _ = N * (n * (n + 1)) := by rw [← htri, ← Finset.sum_mul]; ring

end Pos


section Stable

variable {N n wc : ℕ} (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)

/-- The honest input of store position `q`. -/
noncomputable def xinJ (ω : P3COmega n wc) (q : (Fin N × Fin 2 × Fin n) × ℕ) : Bits (n * wc + (n * wc + 512)) :=
  (baseReplay tags G W q.1.1).xin ω q.1.2.1 q.1.2.2 q.2

/-- **Prefix stability.** With `P` fixed, if `π'` agrees with `π` at the honest inputs of every position before key
`k`, the honest inputs of every position up to key `k` agree. -/
theorem xin_stable (P : Tweak n → Equiv.Perm (Lab n wc)) {π π' : Equiv.Perm (Bits (n * wc + (n * wc + 512)))}
    (k : ℕ) (hag : ∀ q ∈ posSetJ G N, posKey n q < k → π' (xinJ tags G W (P, π) q) = π (xinJ tags G W (P, π) q)) :
    ∀ q ∈ posSetJ G N, posKey n q ≤ k → xinJ tags G W (P, π') q = xinJ tags G W (P, π) q := by
  rintro ⟨⟨s, L, v⟩, p⟩ hq hk
  obtain ⟨hp1, hpv⟩ := (mem_posSetJ G).1 hq
  simp only at hp1 hpv
  set R := baseReplay tags G W s
  -- agreement at every call of an earlier row of this segment
  have hrow : ∀ (L' : Fin 2) (u : Fin n), rowKey n (s, L', u) < rowKey n (s, L, v) →
      ∀ p', 1 ≤ p' → p' ≤ ovCalls R.G u → (P, π).2 (R.xin (P, π) L' u p') = (P, π').2 (R.xin (P, π) L' u p') := by
    intro L' u hlt p' hp1' hp'
    have hmem : ((s, L', u), p') ∈ posSetJ G N := (mem_posSetJ G).2 ⟨hp1', hp'⟩
    exact (hag _ hmem ((posKey_lt_of_rowKey G hmem hlt).trans_le hk)).symm
  have hc1 : ∀ u : Fin n, (L = 1 ∨ u < v) → R.c1 (P, π') u = R.c1 (P, π) u := by
    intro u hu
    refine c1_congr_le (ω := (P, π)) (ω' := (P, π')) R u (fun _ _ => rfl) (fun u' hu' p' hp1' hp' => ?_) u le_rfl
    refine hrow 0 u' ?_ p' hp1' hp'
    rcases hu with hL | huv
    · subst hL; exact rowKey_lt_lower_top s u' v
    · have : L = 0 ∨ L = 1 := by fin_cases L <;> simp
      rcases this with rfl | rfl
      · exact rowKey_lt_same_layer (lt_of_le_of_lt hu' huv)
      · exact rowKey_lt_lower_top s u' v
  have hblk : rowBlocks (R.lab (P, π') L) R.G v = rowBlocks (R.lab (P, π) L) R.G v := by
    refine Loc.rowBlocks_congr R.G v fun u hu => ?_
    have huv := R.G.par_lt v u hu
    have hL : L = 0 ∨ L = 1 := by fin_cases L <;> simp
    rcases hL with rfl | rfl
    · exact hc1 u (Or.inr huv)
    · have hall : R.c1 (P, π') = R.c1 (P, π) := funext fun u' => hc1 u' (Or.inl rfl)
      refine c2_congr_le (ω := (P, π)) (ω' := (P, π')) R hall u (fun _ _ => rfl) (fun u' hu' p' hp1' hp' => ?_) u
        le_rfl
      exact hrow 1 u' (rowKey_lt_same_layer (lt_of_le_of_lt hu' huv)) p' hp1' hp'
  show R.xin (P, π') L v p = R.xin (P, π) L v p
  unfold P3Replay.xin xinAt
  rw [hblk]
  congr 2
  refine (stAfter_congr π π' _ _ (p - 1) (by rw [rowBlocks_length]; show p - 1 ≤ ovCalls G v; omega)
    fun p' hp1' hp' => ?_).symm
  have hmem : ((s, L, v), p') ∈ posSetJ G N := (mem_posSetJ G).2 ⟨hp1', by show p' ≤ ovCalls G v; omega⟩
  have hlt : posKey n ((s, L, v), p') < posKey n ((s, L, v), p) := by unfold posKey; simp only; omega
  have := hag _ hmem (hlt.trans_le hk)
  exact this.symm

end Stable


section Honest

variable {N n wc : ℕ} (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)

/-- `a` and `b` share their honest input, and no two positions before `b` do. -/
def FirstCollJ (ω : P3COmega n wc) (a b : (Fin N × Fin 2 × Fin n) × ℕ) : Prop :=
  xinJ tags G W ω a = xinJ tags G W ω b ∧
    ∀ q ∈ posSetJ G N, ∀ q' ∈ posSetJ G N, posKey n q < posKey n q' → posKey n q' < posKey n b →
      xinJ tags G W ω q ≠ xinJ tags G W ω q'

/-- **A coincidence has a first one.** -/
theorem exists_firstColl {ω : P3COmega n wc} (h : HonestCollJ tags G W ω) :
    ∃ a ∈ posSetJ G N, ∃ b ∈ posSetJ G N, posKey n a < posKey n b ∧ FirstCollJ tags G W ω a b := by
  classical
  obtain ⟨s, s', L, L', v, v', p, p', hp1, hp, hp1', hp', hne, heq⟩ := h
  have hm : ((s, L, v), p) ∈ posSetJ G N := (mem_posSetJ G).2 ⟨hp1, hp⟩
  have hm' : ((s', L', v'), p') ∈ posSetJ G N := (mem_posSetJ G).2 ⟨hp1', hp'⟩
  have hkne : posKey n ((s, L, v), p) ≠ posKey n ((s', L', v'), p') := by
    intro hk
    have := posKey_inj G hm hm' hk
    simp only [Prod.mk.injEq] at this
    exact hne (by rw [this.1.1, this.1.2.1, this.1.2.2, this.2])
  have hP : ∃ k, ∃ a ∈ posSetJ G N, ∃ b ∈ posSetJ G N, posKey n a < posKey n b ∧ posKey n b = k ∧
      xinJ tags G W ω a = xinJ tags G W ω b := by
    rcases lt_or_gt_of_ne hkne with hlt | hlt
    · exact ⟨_, _, hm, _, hm', hlt, rfl, heq⟩
    · exact ⟨_, _, hm', _, hm, hlt, rfl, heq.symm⟩
  obtain ⟨a, ha, b, hb, hab, hbn, hxe⟩ := Nat.find_spec hP
  refine ⟨a, ha, b, hb, hab, hxe, fun q hq q' hq' hqq' hq'b hcoll => ?_⟩
  exact Nat.find_min hP (hbn ▸ hq'b) ⟨q, hq, q', hq', hqq', rfl, hcoll⟩

/-- The position whose output a first coincidence pins: `b`'s predecessor, or `a`'s if `b` is a first call. -/
def pinPos (a b : (Fin N × Fin 2 × Fin n) × ℕ) : (Fin N × Fin 2 × Fin n) × ℕ :=
  if 2 ≤ b.2 then (b.1, b.2 - 1) else (a.1, a.2 - 1)

/-- The value it is pinned to: `a`'s chained part, or `b`'s IV. -/
noncomputable def pinVal (ω : P3COmega n wc) (a b : (Fin N × Fin 2 × Fin n) × ℕ) : Bits (n * wc + 512) :=
  if 2 ≤ b.2 then ovH (xinJ tags G W ω a) else iv (domP3 (tags b.1.1) b.1.2.1 b.1.2.2)

/-- The honest inputs of the positions before key `k`. -/
noncomputable def earlierPts (ω : P3COmega n wc) (k : ℕ) : Finset (Bits (n * wc + (n * wc + 512))) :=
  ((posSetJ G N).filter (fun q => posKey n q < k)).image (xinJ tags G W ω)

theorem card_earlierPts_le (ω : P3COmega n wc) (k : ℕ) :
    (earlierPts tags G W ω k).card ≤ (posSetJ G N).card :=
  Finset.card_image_le.trans (Finset.card_filter_le _ _)

/-- A later call's chained part is its predecessor's output. -/
theorem ovH_xinJ_pred (ω : P3COmega n wc) {q : (Fin N × Fin 2 × Fin n) × ℕ} (hq : q ∈ posSetJ G N)
    (h2 : 2 ≤ q.2) : ovH (xinJ tags G W ω q) = ovH (ω.2 (xinJ tags G W ω (q.1, q.2 - 1))) := by
  obtain ⟨-, hq2⟩ := (mem_posSetJ G).1 hq
  obtain ⟨p, hp⟩ : ∃ p, q.2 = p + 1 := ⟨q.2 - 1, by omega⟩
  unfold xinJ
  rw [hp, (baseReplay tags G W q.1.1).xin_ovH ω (by omega) (by show p < ovCalls G q.1.2.2; omega)]
  show ovH (ω.2 _) = _
  simp only [Nat.add_sub_cancel]

/-- A first call's chained part is its IV. -/
theorem ovH_xinJ_one (ω : P3COmega n wc) {q : (Fin N × Fin 2 × Fin n) × ℕ} (h1 : q.2 = 1) :
    ovH (xinJ tags G W ω q) = iv (domP3 (tags q.1.1) q.1.2.1 q.1.2.2) := by
  unfold xinJ
  rw [h1, ovH_xin_one]
  rfl

variable {tags G W}

/-- **A first coincidence pins one output**, and the pinned input is new. -/
theorem firstColl_pin (htags : Function.Injective tags) (hn : n ≤ 2 ^ 255) {ω : P3COmega n wc}
    {a b : (Fin N × Fin 2 × Fin n) × ℕ} (ha : a ∈ posSetJ G N) (hb : b ∈ posSetJ G N)
    (hab : posKey n a < posKey n b) (hF : FirstCollJ tags G W ω a b) :
    (2 ≤ b.2 ∨ 2 ≤ a.2) ∧ ovH (ω.2 (xinJ tags G W ω (pinPos a b))) = pinVal tags G W ω a b ∧
      xinJ tags G W ω (pinPos a b) ∉ earlierPts tags G W ω (posKey n (pinPos a b)) := by
  obtain ⟨hxe, hfirst⟩ := hF
  obtain ⟨ha1, ha2⟩ := (mem_posSetJ G).1 ha
  obtain ⟨hb1, hb2⟩ := (mem_posSetJ G).1 hb
  have hcase : 2 ≤ b.2 ∨ 2 ≤ a.2 := by
    by_contra hno
    push Not at hno
    have hb1' : b.2 = 1 := by omega
    have ha1' : a.2 = 1 := by omega
    have hh := congrArg ovH hxe
    rw [ovH_xinJ_one tags G W ω ha1', ovH_xinJ_one tags G W ω hb1'] at hh
    have hlt := a.1.2.2.isLt
    have hlt' := b.1.2.2.isLt
    obtain ⟨h1, h2, h3⟩ := domP3_inj (by omega) (by omega) (iv_inj hh)
    have hrow : a.1 = b.1 := Prod.ext (htags h1) (Prod.ext h2 (Fin.ext h3))
    have : a = b := Prod.ext hrow (by omega)
    rw [this] at hab
    exact lt_irrefl _ hab
  have hpin_mem : pinPos a b ∈ posSetJ G N := by
    unfold pinPos
    split_ifs with h2
    · exact (mem_posSetJ G).2 ⟨by simp only; omega, by simp only; omega⟩
    · exact (mem_posSetJ G).2 ⟨by simp only; omega, by simp only; omega⟩
  have hpin_key : posKey n (pinPos a b) < posKey n b := by
    unfold pinPos posKey
    split_ifs with h2
    · simp only; omega
    · simp only; unfold posKey at hab; omega
  refine ⟨hcase, ?_, ?_⟩
  · unfold pinPos pinVal
    split_ifs with h2
    · rw [← ovH_xinJ_pred tags G W ω hb h2, hxe]
    · have hb1' : b.2 = 1 := by omega
      have ha2' : 2 ≤ a.2 := by omega
      rw [← ovH_xinJ_pred tags G W ω ha ha2', hxe, ovH_xinJ_one tags G W ω hb1']
  · intro hmem
    obtain ⟨q, hq, hqx⟩ := Finset.mem_image.1 hmem
    obtain ⟨hqs, hqk⟩ := Finset.mem_filter.1 hq
    exact hfirst q hqs _ hpin_mem hqk hpin_key hqx

/-- **With `P` fixed, one pair coincides first with probability at most `1/(2^{m+512} − M)`.** -/
theorem pr_firstColl_le (htags : Function.Injective tags) (hn : n ≤ 2 ^ 255) (P : Tweak n → Equiv.Perm (Lab n wc))
    {a b : (Fin N × Fin 2 × Fin n) × ℕ} (ha : a ∈ posSetJ G N) (hb : b ∈ posSetJ G N)
    (hab : posKey n a < posKey n b) :
    pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => FirstCollJ tags G W (P, π) a b) ≤
      (((2 ^ (n * wc + 512) - (posSetJ G N).card : ℕ) : ℝ≥0∞))⁻¹ := by
  by_cases hcase : 2 ≤ b.2 ∨ 2 ≤ a.2
  · have hpin_mem : pinPos a b ∈ posSetJ G N := by
      obtain ⟨ha1, ha2⟩ := (mem_posSetJ G).1 ha
      obtain ⟨hb1, hb2⟩ := (mem_posSetJ G).1 hb
      unfold pinPos
      split_ifs with h2
      · exact (mem_posSetJ G).2 ⟨by simp only; omega, by simp only; omega⟩
      · exact (mem_posSetJ G).2 ⟨by simp only; omega, by simp only; omega⟩
    refine pr_pin_le (r := n * wc) (c := 512) (fun π => xinJ tags G W (P, π) (pinPos a b))
      (fun π => pinVal tags G W (P, π) a b) (fun π => earlierPts tags G W (P, π) (posKey n (pinPos a b)))
      (posSetJ G N).card (fun π => card_earlierPts_le tags G W _ _) ?_ _
      (fun π hF => (firstColl_pin htags hn ha hb hab hF).2)
    intro π π' hag
    have hag' : ∀ q ∈ posSetJ G N, posKey n q < posKey n (pinPos a b) →
        π' (xinJ tags G W (P, π) q) = π (xinJ tags G W (P, π) q) := fun q hq hk =>
      hag _ (Finset.mem_image.2 ⟨q, Finset.mem_filter.2 ⟨hq, hk⟩, rfl⟩)
    refine ⟨xin_stable tags G W P _ hag' _ hpin_mem le_rfl, ?_⟩
    show pinVal tags G W (P, π') a b = pinVal tags G W (P, π) a b
    unfold pinVal
    split_ifs with h2
    · have hkey : posKey n a ≤ posKey n (pinPos a b) := by
        unfold pinPos posKey
        simp only [h2, ↓reduceIte]
        unfold posKey at hab
        omega
      rw [xin_stable tags G W P _ hag' _ ha hkey]
    · rfl
  · classical
    push Not at hcase
    have h0 : pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => FirstCollJ tags G W (P, π) a b) = 0 := by
      rw [pr_def, ENNReal.div_eq_zero_iff]
      left
      norm_cast
      rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      intro π _ hF
      have := (firstColl_pin htags hn ha hb hab hF).1
      omega
    rw [h0]
    exact bot_le

/-- **With `P` fixed, the honest coincidences have probability at most `(N·nPosC)²/2^{n·wc}`.** -/
theorem pr_honest_fixed_le (htags : Function.Injective tags) (hn : n ≤ 2 ^ 255) (Q : ℕ)
    (P : Tweak n → Equiv.Perm (Lab n wc)) :
    pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => HonestCollJ tags G W (P, π)) ≤
      (((N * nPosC n Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
  classical
  set M := (posSetJ G N).card with hM
  set pairs := (posSetJ G N ×ˢ posSetJ G N).filter (fun x => posKey n x.1 < posKey n x.2) with hpairs
  have hunion : pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => HonestCollJ tags G W (P, π)) ≤
      ∑ x ∈ pairs, pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => FirstCollJ tags G W (P, π) x.1 x.2) := by
    refine le_trans (pr_mono fun π hπ => ?_) (PousThm1Chain.pr_exists_le pairs (fun x π => FirstCollJ tags G W (P, π) x.1 x.2))
    obtain ⟨a, ha, b, hb, hab, hF⟩ := exists_firstColl tags G W hπ
    exact ⟨(a, b), Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨ha, hb⟩, hab⟩, hF⟩
  have hsum : ∑ x ∈ pairs, pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) =>
      FirstCollJ tags G W (P, π) x.1 x.2) ≤ pairs.card * (((2 ^ (n * wc + 512) - M : ℕ) : ℝ≥0∞))⁻¹ := by
    rw [← nsmul_eq_mul]
    refine Finset.sum_le_card_nsmul _ _ _ fun x hx => ?_
    obtain ⟨hx1, hx2⟩ := Finset.mem_filter.1 hx
    obtain ⟨ha, hb⟩ := Finset.mem_product.1 hx1
    exact pr_firstColl_le htags hn P ha hb hx2
  have hpairsM : pairs.card ≤ M ^ 2 := by
    rw [sq, hM, ← Finset.card_product]
    exact Finset.card_filter_le _ _
  have hMn : M ≤ N * nPosC n Q := by
    refine (card_posSetJ_le G).trans (Nat.mul_le_mul_left _ ?_)
    unfold nPosC
    omega
  by_cases h2M : 2 * M ≤ 2 ^ (n * wc + 512)
  · have hinv := inv_two_pow_sub_le h2M
    have hstep : 2 * ((2 : ℝ≥0∞) ^ (n * wc + 512))⁻¹ ≤ ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ := by
      rw [pow_add, ENNReal.mul_inv (Or.inl (pow_ne_zero _ two_ne_zero)) (Or.inl (ENNReal.pow_ne_top ENNReal.ofNat_ne_top)),
        mul_left_comm]
      refine mul_le_of_le_one_right bot_le ?_
      have h2 : (2 : ℝ≥0∞) ≤ 2 ^ 512 := le_self_pow₀ (by norm_num) (by norm_num)
      calc 2 * ((2 : ℝ≥0∞) ^ 512)⁻¹ ≤ 2 ^ 512 * ((2 : ℝ≥0∞) ^ 512)⁻¹ := by gcongr
        _ = 1 := ENNReal.mul_inv_cancel (pow_ne_zero _ two_ne_zero) (ENNReal.pow_ne_top ENNReal.ofNat_ne_top)
    calc pr (fun π : Equiv.Perm (Bits (n * wc + (n * wc + 512))) => HonestCollJ tags G W (P, π))
        ≤ pairs.card * (((2 ^ (n * wc + 512) - M : ℕ) : ℝ≥0∞))⁻¹ := hunion.trans hsum
      _ ≤ (M ^ 2 : ℕ) * ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ :=
          mul_le_mul' (by exact_mod_cast hpairsM) (hinv.trans hstep)
      _ ≤ (((N * nPosC n Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
          rw [div_eq_mul_inv]
          exact mul_le_mul' (by exact_mod_cast Nat.pow_le_pow_left hMn 2) le_rfl
  · push Not at h2M
    refine (PousThm1Chain.pr_le_one _).trans ?_
    have hbig : 2 ^ (n * wc) ≤ (N * nPosC n Q) ^ 2 := by
      have h1 : 2 ^ (n * wc) ≤ 2 ^ (n * wc + 512) := Nat.pow_le_pow_right (by norm_num) (by omega)
      have h2 : 2 ^ (n * wc + 512) ≤ 2 * M := h2M.le
      have hM1 : 1 ≤ M := by
        rcases Nat.eq_zero_or_pos M with h | h
        · rw [h] at h2M; simp at h2M
        · exact h
      have h3 : 2 * M ≤ M ^ 2 ∨ M = 1 := by
        rcases Nat.lt_or_ge M 2 with h | h
        · right; omega
        · left; rw [sq]; exact Nat.mul_le_mul_right _ h
      rcases h3 with h3 | h3
      · calc 2 ^ (n * wc) ≤ M ^ 2 := h1.trans (h2.trans h3)
          _ ≤ (N * nPosC n Q) ^ 2 := Nat.pow_le_pow_left hMn 2
      · rw [h3] at h2
        have : 2 ^ (n * wc + 512) ≤ 2 := h2
        have h5 : n * wc + 512 ≤ 1 :=
          (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).1 (by rw [pow_one]; exact this)
        omega
    rw [ENNReal.le_div_iff_mul_le (Or.inl (pow_ne_zero _ two_ne_zero)) (Or.inl (ENNReal.pow_ne_top ENNReal.ofNat_ne_top)),
      one_mul]
    exact_mod_cast hbig

end Honest


/-- Lexicographic order from a quotient–remainder form. -/
theorem lex_of_lt {n A A' v v' : ℕ} (_hv : v < n) (hv' : v' < n) (h : A * n + v < A' * n + v') :
    A < A' ∨ (A = A' ∧ v < v') := by
  rcases lt_trichotomy A A' with h1 | h1 | h1
  · exact Or.inl h1
  · subst h1; right; exact ⟨rfl, by omega⟩
  · exfalso
    have : (A' + 1) * n ≤ A * n := Nat.mul_le_mul_right _ h1
    rw [Nat.add_mul, one_mul] at this
    omega

theorem card_lab (n wc : ℕ) : Fintype.card (Lab n wc) = 2 ^ (n * wc) := by
  simp only [Lab, Bits, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
  rw [← pow_mul, mul_comm]

section Labels

variable {N n wc : ℕ} (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)

/-- The label of store row `ρ`. -/
noncomputable def labJ (ω : P3COmega n wc) (ρ : Fin N × Fin 2 × Fin n) : Lab n wc :=
  (baseReplay tags G W ρ.1).lab ω ρ.2.1 ρ.2.2

/-- The `P` input of store row `ρ`. -/
noncomputable def pinJ (ω : P3COmega n wc) (ρ : Fin N × Fin 2 × Fin n) : Lab n wc :=
  if ρ.2.1 = 0 then (baseReplay tags G W ρ.1).pin1 ω ρ.2.2 else (baseReplay tags G W ρ.1).pin2 ω ρ.2.2

/-- The tweak of store row `ρ`. -/
def twJ (ρ : Fin N × Fin 2 × Fin n) : Tweak n := (tags ρ.1, ρ.2.1, ρ.2.2)

/-- **A label is its own tweak's permutation at its `P` input.** -/
theorem labJ_eq (ω : P3COmega n wc) (ρ : Fin N × Fin 2 × Fin n) :
    labJ tags G W ω ρ = ω.1 (twJ tags ρ) (pinJ tags G W ω ρ) := by
  obtain ⟨s, L, v⟩ := ρ
  unfold labJ pinJ twJ P3Replay.lab
  fin_cases L
  · exact (baseReplay tags G W s).c1_eq ω v
  · exact (baseReplay tags G W s).c2_eq ω v

variable {tags}

/-- **An earlier row's label does not read a later row's tweak.** -/
theorem labJ_upd (htags : Function.Injective tags) {a b : Fin N × Fin 2 × Fin n} (h : rowKey n a < rowKey n b)
    (ω : P3COmega n wc) (σ : Equiv.Perm (Lab n wc)) :
    labJ tags G W (upd (twJ tags b) ω σ) a = labJ tags G W ω a := by
  obtain ⟨sa, La, va⟩ := a
  obtain ⟨sb, Lb, vb⟩ := b
  have hva := va.isLt
  have hvb := vb.isLt
  have hlex := lex_of_lt hva hvb h
  have hLa := La.isLt
  have hLb := Lb.isLt
  -- a tweak of row `a`'s dependencies equals `b`'s only in the same segment
  have hseg : ∀ (L' : Fin 2) (u' : Fin n), ((tags sa, L', u') : Tweak n) = twJ tags (sb, Lb, vb) →
      sa = sb ∧ L' = Lb ∧ u' = vb := by
    intro L' u' he
    simp only [twJ, Prod.mk.injEq] at he
    exact ⟨htags he.1, he.2.1, he.2.2⟩
  set R := baseReplay tags G W sa
  unfold labJ P3Replay.lab
  fin_cases La
  · simp only
    refine c1_congr_le (ω := ω) (ω' := upd (twJ tags (sb, Lb, vb)) ω σ) R va (fun u' hu' => ?_)
      (fun _ _ _ _ _ => rfl) va le_rfl
    refine Function.update_of_ne (fun he => ?_) _ _
    obtain ⟨rfl, hL, hu⟩ := hseg 0 u' he
    subst hu
    rw [Fin.le_def] at hu'
    simp only at hlex
    rcases hlex with h1 | ⟨h1, h2⟩
    · omega
    · rw [← hL] at h1; simp at h1; omega
  · simp only [Fin.mk_one, one_ne_zero, ↓reduceIte]
    have hc1 : R.c1 (upd (twJ tags (sb, Lb, vb)) ω σ) = R.c1 ω := by
      refine c1_congr_all R (fun u' => Function.update_of_ne (fun he => ?_) _ _) (fun _ _ _ _ => rfl)
      obtain ⟨rfl, hL, -⟩ := hseg 0 u' he
      simp only at hlex
      rw [← hL] at hlex
      simp only [Fin.val_zero] at hlex
      omega
    refine c2_congr_le (ω := ω) (ω' := upd (twJ tags (sb, Lb, vb)) ω σ) R hc1 va (fun u' hu' => ?_)
      (fun _ _ _ _ _ => rfl) va le_rfl
    refine Function.update_of_ne (fun he => ?_) _ _
    obtain ⟨rfl, hL, hu⟩ := hseg 1 u' he
    subst hu
    rw [Fin.le_def] at hu'
    simp only at hlex
    rw [← hL] at hlex
    simp only [Fin.val_one] at hlex
    omega

/-- **A row's `P` input does not read its own tweak.** -/
theorem pinJ_upd (b : Fin N × Fin 2 × Fin n) (ω : P3COmega n wc) (σ : Equiv.Perm (Lab n wc)) :
    pinJ tags G W (upd (twJ tags b) ω σ) b = pinJ tags G W ω b := by
  obtain ⟨sb, Lb, vb⟩ := b
  set R := baseReplay tags G W sb
  unfold pinJ
  fin_cases Lb
  · simp only
    refine pin1_congr (ω := ω) (ω' := upd (twJ tags (sb, 0, vb)) ω σ) R vb (fun u' hu' => ?_) (fun _ _ _ _ _ => rfl)
    refine Function.update_of_ne (fun he => ?_) _ _
    simp only [twJ, Prod.mk.injEq] at he
    exact (ne_of_lt hu') he.2.2
  · simp only [Fin.mk_one, one_ne_zero, ↓reduceIte]
    have hc1 : R.c1 (upd (twJ tags (sb, 1, vb)) ω σ) = R.c1 ω := by
      refine c1_congr_all R (fun u' => Function.update_of_ne (fun he => ?_) _ _) (fun _ _ _ _ => rfl)
      simp only [twJ, Prod.mk.injEq] at he
      exact absurd he.2.1 (by decide)
    refine pin2_congr (ω := ω) (ω' := upd (twJ tags (sb, 1, vb)) ω σ) R hc1 vb (fun u' hu' => ?_)
      (fun _ _ _ _ _ => rfl)
    refine Function.update_of_ne (fun he => ?_) _ _
    simp only [twJ, Prod.mk.injEq] at he
    exact (ne_of_lt hu') he.2.2

/-- **Two rows' labels coincide with probability at most `1/2^{n·wc}`.** -/
theorem pr_labPair_le (htags : Function.Injective tags) {a b : Fin N × Fin 2 × Fin n} (h : rowKey n a < rowKey n b) :
    pr (fun ω : P3COmega n wc => labJ tags G W ω a = labJ tags G W ω b) ≤ ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ := by
  have hev : (fun ω : P3COmega n wc => labJ tags G W ω a = labJ tags G W ω b) =
      fun ω => ω.1 (twJ tags b) (pinJ tags G W ω b) = labJ tags G W ω a := by
    funext ω
    rw [labJ_eq tags G W ω b]
    exact propext eq_comm
  rw [hev]
  refine ((pr_congr_inst _ _ _).trans_le (pr_ppin_le (twJ tags b) (fun ω => pinJ tags G W ω b)
    (fun ω => labJ tags G W ω a) (fun ω σ => pinJ_upd G W b ω σ) (fun ω σ => labJ_upd G W htags h ω σ))).trans ?_
  rw [card_lab]
  push_cast
  exact le_rfl

open Classical in
/-- **The label coincidences have probability at most `(2Nn)²/2^{n·wc}`.** -/
theorem pr_lab_le (htags : Function.Injective tags) :
    pr (LabCollJ tags G W) ≤ (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
  set rows := (Finset.univ : Finset (Fin N × Fin 2 × Fin n))
  set pairs := (rows ×ˢ rows).filter (fun x => rowKey n x.1 < rowKey n x.2)
  have hunion : pr (LabCollJ tags G W) ≤
      ∑ x ∈ pairs, pr (fun ω : P3COmega n wc => labJ tags G W ω x.1 = labJ tags G W ω x.2) := by
    refine le_trans (pr_mono fun ω hω => ?_)
      (PousThm1Chain.pr_exists_le pairs (fun x (ω : P3COmega n wc) => labJ tags G W ω x.1 = labJ tags G W ω x.2))
    obtain ⟨s, s', L, L', v, v', hne, heq⟩ := hω
    have hk : rowKey n (s, L, v) ≠ rowKey n (s', L', v') := fun hk => hne (rowKey_inj hk)
    rcases lt_or_gt_of_ne hk with hlt | hlt
    · exact ⟨((s, L, v), (s', L', v')), Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨Finset.mem_univ _,
        Finset.mem_univ _⟩, hlt⟩, heq⟩
    · exact ⟨((s', L', v'), (s, L, v)), Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨Finset.mem_univ _,
        Finset.mem_univ _⟩, hlt⟩, heq.symm⟩
  have hsum : ∑ x ∈ pairs, pr (fun ω : P3COmega n wc => labJ tags G W ω x.1 = labJ tags G W ω x.2) ≤
      pairs.card * ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ := by
    rw [← nsmul_eq_mul]
    exact Finset.sum_le_card_nsmul _ _ _ fun x hx => pr_labPair_le G W htags (Finset.mem_filter.1 hx).2
  have hcard : pairs.card ≤ (2 * N * n) ^ 2 := by
    refine (Finset.card_filter_le _ _).trans (le_of_eq ?_)
    rw [Finset.card_product, Finset.card_univ, Fintype.card_prod, Fintype.card_prod, Fintype.card_fin,
      Fintype.card_fin, Fintype.card_fin]
    ring
  calc pr (LabCollJ tags G W) ≤ pairs.card * ((2 : ℝ≥0∞) ^ (n * wc))⁻¹ := hunion.trans hsum
    _ ≤ (((2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) := by
        rw [div_eq_mul_inv]
        exact mul_le_mul' (by exact_mod_cast hcard) le_rfl

end Labels


/-- **The honest coincidences, over both primitives**: average over `P`. -/
theorem pr_honest_le {N n wc : ℕ} {tags : Fin N → Bits 256} (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (htags : Function.Injective tags) (hn : n ≤ 2 ^ 255) (Q : ℕ) :
    pr (HonestCollJ tags G W) ≤ (((N * nPosC n Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc) :=
  (pr_congr_inst _ (instFintypeProd _ _) _).trans_le
    (pr_le_of_forall_fst (fun x => HonestCollJ tags G W x) _ fun P => pr_honest_fixed_le htags hn Q P)

end Bday

/-- **`JointBirthday`, proved.** The joint collision event has probability at most the target's collision term,
with no `2^m` factor: it depends on the primitives alone. -/
theorem jointBirthday : JointBirthday := by
  intro N n wc Q tags G W htags hn
  show pr (fun ω => HonestCollJ tags G W ω ∨ LabCollJ tags G W ω) ≤ _
  refine (Bday.pr_or_le _ _).trans ((add_le_add (Bday.pr_honest_le G W htags hn Q) (Bday.pr_lab_le G W htags)).trans
    (le_of_eq ?_))
  rw [Nat.cast_add, ENNReal.add_div]

end PousP3ConcreteMulti


end


/-! ════ P3Concrete.P3ChainCert ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Sponge

namespace P3ChainKnow

variable {n : ℕ} (G : TopoDAG n)


theorem mem_step_tops (K : P3ChainKnow n) (u : Fin n) :
    u ∈ (K.step G).tops ↔ u ∈ K.tops ∨ ((K.keyKnown G 1 u ∧ K.colKnown u) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 1 ∧ ovBlock G p.2.1 p.2.2 = some u) ∨ ∀ w, (u, w) ∈ K.pc) := by
  simp only [step, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_step_cols (K : P3ChainKnow n) (w u : Fin n) :
    (w, u) ∈ (K.step G).cols ↔ (w, u) ∈ K.cols ∨ (K.keyKnown G 0 w ∨ (u ∈ K.tops ∧ K.keyKnown G 1 u) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 0 ∧ ovBlock G p.2.1 p.2.2 = some w) ∨ (u ∈ K.tops ∧ (u, w) ∈ K.kc)) := by
  simp only [step, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_step_hs (K : P3ChainKnow n) (L : Fin 2) (v : Fin n) (j : ℕ) :
    (L, v, j) ∈ (K.step G).hs ↔ (L, v, j) ∈ K.hs ∨ ((L, v, j) ∈ pos n ∧ (K.canCall G L v j ∨
      (1 ≤ j ∧ (L, v, j + 1) ∈ K.hs ∧ (L, v, j + 1) ∈ K.rs))) := by
  simp only [step, Finset.mem_union, Finset.mem_filter]

theorem mem_step_rs (K : P3ChainKnow n) (L : Fin 2) (v : Fin n) (j : ℕ) :
    (L, v, j) ∈ (K.step G).rs ↔ (L, v, j) ∈ K.rs ∨ ((L, v, j) ∈ pos n ∧ (K.canCall G L v j ∨
      (j = ovCalls G v ∧ ((L = 0 ∧ K.lowKnown v) ∨ (L = 1 ∧ v ∈ K.tops ∧ K.colKnown v))))) := by
  simp only [step, Finset.mem_union, Finset.mem_filter]

theorem mem_step_kc (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ (K.step G).kc ↔ (u, w) ∈ K.kc ∨ (u ∈ K.tops ∧ (w, u) ∈ K.cols) := by
  simp only [step, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_step_pc (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ (K.step G).pc ↔ (u, w) ∈ K.pc ∨ u ∈ K.tops := by
  simp only [step, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_kc1 (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ K.kc1 G ↔ (u, w) ∈ K.kc ∨ ((1 : Fin 2), u, ovCalls G u) ∈ K.rs := by
  simp only [kc1, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_asm_cols (K : P3ChainKnow n) (w u : Fin n) :
    (w, u) ∈ (K.assemble G).cols ↔ (w, u) ∈ K.cols ∨ ((u, w) ∈ K.pc ∧ (u, w) ∈ K.kc1 G) := by
  simp only [assemble, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_asm_kc (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ (K.assemble G).kc ↔ (u, w) ∈ K.kc1 G ∨ ((u, w) ∈ K.pc ∧ (w, u) ∈ K.cols) := by
  simp only [assemble, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_asm_pc (K : P3ChainKnow n) (u w : Fin n) :
    (u, w) ∈ (K.assemble G).pc ↔ (u, w) ∈ K.pc ∨ ((w, u) ∈ K.cols ∧ (u, w) ∈ K.kc1 G) := by
  simp only [assemble, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]

theorem mem_asm_rs (K : P3ChainKnow n) (L : Fin 2) (v : Fin n) (j : ℕ) :
    (L, v, j) ∈ (K.assemble G).rs ↔ (L, v, j) ∈ K.rs ∨
      (L = 1 ∧ j = ovCalls G v ∧ ∀ w, (v, w) ∈ K.kc1 G ∨ ((v, w) ∈ K.pc ∧ (w, v) ∈ K.cols)) := by
  classical
  simp only [assemble, Finset.mem_union, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro (h | ⟨v', hv', he⟩)
    · exact Or.inl h
    · simp only [Prod.mk.injEq] at he
      obtain ⟨rfl, rfl, rfl⟩ := he
      exact Or.inr ⟨rfl, rfl, hv'⟩
  · rintro (h | ⟨rfl, rfl, hv⟩)
    · exact Or.inl h
    · exact Or.inr ⟨v, hv, rfl⟩


/-- `K ≤ K'`: every part of `K` is in `K'`. -/
def Le (K K' : P3ChainKnow n) : Prop :=
  K.tops ⊆ K'.tops ∧ K.cols ⊆ K'.cols ∧ K.hs ⊆ K'.hs ∧ K.rs ⊆ K'.rs ∧ K.kc ⊆ K'.kc ∧ K.pc ⊆ K'.pc

theorem le_step (K : P3ChainKnow n) : Le K (K.step G) :=
  ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left,
    Finset.subset_union_left, Finset.subset_union_left⟩

theorem le_assemble (K : P3ChainKnow n) : Le K (K.assemble G) :=
  ⟨subset_rfl, Finset.subset_union_left, subset_rfl, Finset.subset_union_left,
    Finset.subset_union_left.trans Finset.subset_union_left, Finset.subset_union_left⟩

theorem Le.trans {K K' K'' : P3ChainKnow n} (h : Le K K') (h' : Le K' K'') : Le K K'' :=
  ⟨h.1.trans h'.1, h.2.1.trans h'.2.1, h.2.2.1.trans h'.2.2.1, h.2.2.2.1.trans h'.2.2.2.1,
    h.2.2.2.2.1.trans h'.2.2.2.2.1, h.2.2.2.2.2.trans h'.2.2.2.2.2⟩

theorem le_round (K : P3ChainKnow n) : Le K (K.round G) := (le_step G K).trans (le_assemble G _)

theorem Le.labKnown {K K' : P3ChainKnow n} (h : Le K K') {L : Fin 2} {u : Fin n} (hu : K.labKnown L u) :
    K'.labKnown L u := by
  unfold P3ChainKnow.labKnown at hu ⊢
  split_ifs at hu ⊢ with hL
  · exact fun x => h.2.1 (hu x)
  · exact h.1 hu

theorem le_reach (K₀ : P3ChainKnow n) {t t' : ℕ} (htt : t ≤ t') : Le (reach G K₀ t) (reach G K₀ t') := by
  induction t', htt using Nat.le_induction with
  | base => exact ⟨subset_rfl, subset_rfl, subset_rfl, subset_rfl, subset_rfl, subset_rfl⟩
  | succ t' _ ih => exact ih.trans (le_round G _)

/-- A column entry made by the moves is in the round's knowledge. -/
theorem round_cols_of_step {K : P3ChainKnow n} {w u : Fin n} (h : (w, u) ∈ (K.step G).cols) :
    (w, u) ∈ (K.round G).cols := (le_assemble G _).2.1 h

/-- A dropped part made by the moves is in the round's knowledge. -/
theorem round_rs_of_step {K : P3ChainKnow n} {L : Fin 2} {v : Fin n} {j : ℕ} (h : (L, v, j) ∈ (K.step G).rs) :
    (L, v, j) ∈ (K.round G).rs := (le_assemble G _).2.2.2.1 h

theorem ovBlock_pad (v : Fin n) : ovBlock G v (ovCalls G v) = none := by
  unfold ovBlock ovCalls
  simp


variable (K₀ : P3ChainKnow n)

/-- Row `(L, v)` is seeded by `K₀`: a held chaining value on it, its held pad `r` (its key), or, for a top row, every
coordinate of its key held as a key component or a top-input component. -/
def RowSeed (L : Fin 2) (v : Fin n) : Prop :=
  (∃ j, 1 ≤ j ∧ (L, v, j) ∈ K₀.hs) ∨ (L, v, ovCalls G v) ∈ K₀.rs ∨
    (L = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc)

/-- Label `u` of layer `L` is the block of a call whose dropped `r` is held. -/
def Reveal (L : Fin 2) (u : Fin n) : Prop := ∃ v j, (L, v, j) ∈ K₀.rs ∧ ovBlock G v j = some u

/-- Top `u` is covered: held, seeded, or revealed. -/
def TopCov (u : Fin n) : Prop := u ∈ K₀.tops ∨ RowSeed G K₀ 1 u ∨ Reveal G K₀ 1 u

/-- Lower row `w` is covered: seeded or revealed. -/
def LowCov (w : Fin n) : Prop := RowSeed G K₀ 0 w ∨ Reveal G K₀ 0 w

/-- **The clock invariant** after `t` rounds. -/
def Inv (t : ℕ) : Prop :=
  (∀ L v j, (L, v, j) ∈ (reach G K₀ t).hs → 1 ≤ j → RowSeed G K₀ L v ∨ j ≤ t) ∧
  (∀ L v j u, (L, v, j) ∈ (reach G K₀ t).rs → ovBlock G v j = some u →
    (L, v, j) ∈ K₀.rs ∨ (reach G K₀ t).labKnown L u) ∧
  (∀ L v, (reach G K₀ t).keyKnown G L v → RowSeed G K₀ L v ∨ ovCalls G v ≤ t ∨ (reach G K₀ t).labKnown L v) ∧
  (∀ u, u ∈ (reach G K₀ t).tops → TopCov G K₀ u ∨ ∃ t' < t,
    (ovCalls G u ≤ t' ∧ (reach G K₀ t').colKnown u) ∨ ∀ w, (u, w) ∈ (reach G K₀ t').pc) ∧
  (∀ w u, (w, u) ∈ (reach G K₀ t).cols → (w, u) ∈ K₀.cols ∨ (u, w) ∈ K₀.pc ∨ LowCov G K₀ w ∨
    ovCalls G w + 1 ≤ t ∨ ∃ t' < t, u ∈ (reach G K₀ t').tops) ∧
  (∀ u w, (u, w) ∈ (reach G K₀ t).kc → (u, w) ∈ K₀.kc ∨ (u, w) ∈ K₀.pc ∨ (reach G K₀ t).keyKnown G 1 u ∨
    ∃ t' < t, u ∈ (reach G K₀ t').tops) ∧
  (∀ u w, (u, w) ∈ (reach G K₀ t).pc → (u, w) ∈ K₀.pc ∨
    ((w, u) ∈ (reach G K₀ t).cols ∧ (u, w) ∈ (reach G K₀ t).kc) ∨ ∃ t' < t, u ∈ (reach G K₀ t').tops)

theorem labKnown_one' (K : P3ChainKnow n) (u : Fin n) : K.labKnown 1 u ↔ u ∈ K.tops := by
  simp [P3ChainKnow.labKnown]

theorem labKnown_zero' (K : P3ChainKnow n) (u : Fin n) : K.labKnown 0 u ↔ K.lowKnown u := by
  simp [P3ChainKnow.labKnown]

theorem inv_zero : Inv G K₀ 0 := by
  have hR : reach G K₀ 0 = K₀.assemble G := rfl
  refine ⟨fun L v j h hj => Or.inl (Or.inl ⟨j, hj, h⟩), fun L v j u h hb => ?_, fun L v h => ?_,
    fun u h => Or.inl (Or.inl h), fun w u h => ?_, fun u w h => ?_, fun u w h => ?_⟩
  · rw [hR, mem_asm_rs] at h
    rcases h with h | ⟨_, hj, _⟩
    · exact Or.inl h
    · rw [hj, ovBlock_pad] at hb
      exact absurd hb (by simp)
  · unfold P3ChainKnow.keyKnown at h
    rw [hR, mem_asm_rs] at h
    rcases h with h | ⟨hL, _, hall⟩
    · exact Or.inl (Or.inr (Or.inl h))
    · subst hL
      by_cases hk : ((1 : Fin 2), v, ovCalls G v) ∈ K₀.rs
      · exact Or.inl (Or.inr (Or.inl hk))
      · refine Or.inl (Or.inr (Or.inr ⟨rfl, fun w => ?_⟩))
        rcases hall w with h1 | ⟨h1, _⟩
        · rcases (mem_kc1 G K₀ v w).1 h1 with h1 | h1
          · exact Or.inl h1
          · exact absurd h1 hk
        · exact Or.inr h1
  · rw [hR, mem_asm_cols] at h
    rcases h with h | ⟨h, _⟩
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
  · rw [hR, mem_asm_kc] at h
    rcases h with h | ⟨h, _⟩
    · rcases (mem_kc1 G K₀ u w).1 h with h | h
      · exact Or.inl h
      · exact Or.inr (Or.inr (Or.inl ((le_assemble G K₀).2.2.2.1 h)))
    · exact Or.inr (Or.inl h)
  · rw [hR, mem_asm_pc] at h
    rcases h with h | ⟨h1, h2⟩
    · exact Or.inl h
    · exact Or.inr (Or.inl ⟨(le_assemble G K₀).2.1 h1, (mem_asm_kc G K₀ u w).2 (Or.inl h2)⟩)

theorem inv_succ (t : ℕ) (hI : Inv G K₀ t) : Inv G K₀ (t + 1) := by
  obtain ⟨i1, i2a, i2b, i3, i4, i5, i6⟩ := hI
  set R := reach G K₀ t with hR
  set S := R.step G with hS
  have hRR : reach G K₀ (t + 1) = S.assemble G := rfl
  have hRS : Le R S := le_step G R
  have hSA : Le S (S.assemble G) := le_assemble G S
  have hle : Le R (S.assemble G) := hRS.trans hSA
  -- the earlier-top disjunct, lifted
  have lift : ∀ u, (∃ t' < t, u ∈ (reach G K₀ t').tops) → ∃ t' < t + 1, u ∈ (reach G K₀ t').tops :=
    fun u ⟨t', ht', h⟩ => ⟨t', by omega, h⟩
  have now : ∀ u, u ∈ R.tops → ∃ t' < t + 1, u ∈ (reach G K₀ t').tops := fun u h => ⟨t, by omega, h⟩
  -- a key known at the start of the round
  have keyR : ∀ v, R.keyKnown G 1 v → RowSeed G K₀ 1 v ∨ ovCalls G v ≤ t + 1 ∨ v ∈ R.tops := by
    intro v h
    rcases i2b 1 v h with h' | h' | h'
    · exact Or.inl h'
    · exact Or.inr (Or.inl (by omega))
    · exact Or.inr (Or.inr ((labKnown_one' R v).1 h'))
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- chaining values
    intro L v j h hj
    rw [hRR] at h
    change (L, v, j) ∈ S.hs at h
    rw [hS, mem_step_hs] at h
    rcases h with h | ⟨_, ⟨_, _, _, h1 | h1⟩ | ⟨_, h2, _⟩⟩
    · rcases i1 L v j h hj with h' | h'
      · exact Or.inl h'
      · exact Or.inr (by omega)
    · exact Or.inr (by omega)
    · rcases Nat.lt_or_ge (j - 1) 1 with hj1 | hj1
      · exact Or.inr (by omega)
      · rcases i1 L v (j - 1) h1 hj1 with h' | h'
        · exact Or.inl h'
        · exact Or.inr (by omega)
    · rcases i1 L v (j + 1) h2 (by omega) with h' | h'
      · exact Or.inl h'
      · exact Or.inr (by omega)
  · -- reveals
    intro L v j u h hb
    rw [hRR, mem_asm_rs, hS, mem_step_rs] at h
    rcases h with (h | ⟨_, ⟨_, _, hblk, _⟩ | ⟨hj, _⟩⟩) | ⟨_, hj, _⟩
    · rcases i2a L v j u h hb with h' | h'
      · exact Or.inl h'
      · exact Or.inr (hle.labKnown h')
    · exact Or.inr (hle.labKnown (hblk u hb))
    · rw [hj, ovBlock_pad] at hb
      exact absurd hb (by simp)
    · rw [hj, ovBlock_pad] at hb
      exact absurd hb (by simp)
  · -- keys
    have stepKey : ∀ L v, (L, v, ovCalls G v) ∈ S.rs →
        RowSeed G K₀ L v ∨ ovCalls G v ≤ t + 1 ∨ (S.assemble G).labKnown L v := by
      intro L v h
      rw [hS, mem_step_rs] at h
      rcases h with h | ⟨_, ⟨hj1, _, _, h1 | h1⟩ | ⟨_, h2 | h2⟩⟩
      · rcases i2b L v h with h' | h' | h'
        · exact Or.inl h'
        · exact Or.inr (Or.inl (by omega))
        · exact Or.inr (Or.inr (hle.labKnown h'))
      · exact Or.inr (Or.inl (by omega))
      · rcases Nat.lt_or_ge (ovCalls G v - 1) 1 with hj2 | hj2
        · exact Or.inr (Or.inl (by omega))
        · rcases i1 L v (ovCalls G v - 1) h1 hj2 with h' | h'
          · exact Or.inl h'
          · exact Or.inr (Or.inl (by omega))
      · obtain ⟨rfl, hk⟩ := h2
        exact Or.inr (Or.inr (hle.labKnown ((labKnown_zero' R v).2 hk)))
      · obtain ⟨rfl, hk, _⟩ := h2
        exact Or.inr (Or.inr (hle.labKnown ((labKnown_one' R v).2 hk)))
    intro L v h
    unfold P3ChainKnow.keyKnown at h
    rw [hRR, mem_asm_rs] at h
    rcases h with h | ⟨hL, _, hall⟩
    · exact stepKey L v h
    · subst hL
      by_cases hsk : ((1 : Fin 2), v, ovCalls G v) ∈ S.rs
      · exact stepKey 1 v hsk
      by_cases htop : v ∈ S.tops
      · exact Or.inr (Or.inr ((labKnown_one' _ v).2 htop))
      by_cases hclk : ovCalls G v ≤ t + 1
      · exact Or.inr (Or.inl hclk)
      by_cases hseed : RowSeed G K₀ 1 v
      · exact Or.inl hseed
      exfalso
      -- every coordinate is held as a key or input component
      have hRkc : ∀ w, (v, w) ∈ R.kc → (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc := by
        intro w hw
        rcases i5 v w hw with h' | h' | h' | h'
        · exact Or.inl h'
        · exact Or.inr h'
        · rcases keyR v h' with h'' | h'' | h''
          · exact absurd h'' hseed
          · exact absurd h'' hclk
          · exact absurd (hRS.1 h'') htop
        · obtain ⟨t', ht', h''⟩ := h'
          exact absurd ((le_reach G K₀ (show t' ≤ t by omega)).1 h'' |> hRS.1) htop
      have hall' : ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc := by
        intro w
        rcases hall w with h1 | ⟨h1, _⟩
        · rcases (mem_kc1 G S v w).1 h1 with h1 | h1
          · rcases (mem_step_kc G R v w).1 h1 with h1 | ⟨h1, _⟩
            · exact hRkc w h1
            · exact absurd (hRS.1 h1) htop
          · exact absurd h1 hsk
        · rcases (mem_step_pc G R v w).1 h1 with h1 | h1
          · rcases i6 v w h1 with h' | ⟨_, h'⟩ | ⟨t', ht', h'⟩
            · exact Or.inr h'
            · exact hRkc w h'
            · exact absurd ((le_reach G K₀ (show t' ≤ t by omega)).1 h' |> hRS.1) htop
          · exact absurd (hRS.1 h1) htop
      exact hseed (Or.inr (Or.inr ⟨rfl, hall'⟩))
  · -- tops
    intro u h
    rw [hRR] at h
    change u ∈ S.tops at h
    rw [hS, mem_step_tops] at h
    rcases h with h | ⟨hk, hc⟩ | ⟨p, hp, hpr, hp1, hb⟩ | hpc
    · rcases i3 u h with h' | ⟨t', ht', h''⟩
      · exact Or.inl h'
      · exact Or.inr ⟨t', by omega, h''⟩
    · rcases i2b 1 u hk with h' | h' | h'
      · exact Or.inl (Or.inr (Or.inl h'))
      · exact Or.inr ⟨t, by omega, Or.inl ⟨h', hc⟩⟩
      · rcases i3 u ((labKnown_one' R u).1 h') with h'' | ⟨t', ht', h3⟩
        · exact Or.inl h''
        · exact Or.inr ⟨t', by omega, h3⟩
    · obtain ⟨L, v, j⟩ := p
      simp only at hp1 hb
      subst hp1
      rcases i2a 1 v j u hpr hb with h' | h'
      · exact Or.inl (Or.inr (Or.inr ⟨v, j, h', hb⟩))
      · rcases i3 u ((labKnown_one' R u).1 h') with h'' | ⟨t', ht', h3⟩
        · exact Or.inl h''
        · exact Or.inr ⟨t', by omega, h3⟩
    · exact Or.inr ⟨t, by omega, Or.inr hpc⟩
  · -- lower columns
    have fromR : ∀ w u, (w, u) ∈ R.cols → (w, u) ∈ K₀.cols ∨ (u, w) ∈ K₀.pc ∨ LowCov G K₀ w ∨
        ovCalls G w + 1 ≤ t + 1 ∨ ∃ t' < t + 1, u ∈ (reach G K₀ t').tops := by
      intro w u hw
      rcases i4 w u hw with h' | h' | h' | h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inl h')
      · exact Or.inr (Or.inr (Or.inl h'))
      · exact Or.inr (Or.inr (Or.inr (Or.inl (by omega))))
      · exact Or.inr (Or.inr (Or.inr (Or.inr (lift u h'))))
    intro w u h
    rw [hRR, mem_asm_cols] at h
    rcases h with h | ⟨hp, _⟩
    · rw [hS, mem_step_cols] at h
      rcases h with h | hk | ⟨hu, _⟩ | ⟨p, hp, hpr, hp1, hb⟩ | ⟨hu, _⟩
      · exact fromR w u h
      · rcases i2b 0 w hk with h' | h' | h'
        · exact Or.inr (Or.inr (Or.inl (Or.inl h')))
        · exact Or.inr (Or.inr (Or.inr (Or.inl (by omega))))
        · exact fromR w u ((labKnown_zero' R w).1 h' u)
      · exact Or.inr (Or.inr (Or.inr (Or.inr (now u hu))))
      · obtain ⟨L, v, j⟩ := p
        simp only at hp1 hb
        subst hp1
        rcases i2a 0 v j w hpr hb with h' | h'
        · exact Or.inr (Or.inr (Or.inl (Or.inr ⟨v, j, h', hb⟩)))
        · exact fromR w u ((labKnown_zero' R w).1 h' u)
      · exact Or.inr (Or.inr (Or.inr (Or.inr (now u hu))))
    · rcases (mem_step_pc G R u w).1 hp with hp | hp
      · rcases i6 u w hp with h' | ⟨h', _⟩ | h'
        · exact Or.inr (Or.inl h')
        · exact fromR w u h'
        · exact Or.inr (Or.inr (Or.inr (Or.inr (lift u h'))))
      · exact Or.inr (Or.inr (Or.inr (Or.inr (now u hp))))
  · -- key components
    have fromRkc : ∀ u w, (u, w) ∈ R.kc → (u, w) ∈ K₀.kc ∨ (u, w) ∈ K₀.pc ∨
        (S.assemble G).keyKnown G 1 u ∨ ∃ t' < t + 1, u ∈ (reach G K₀ t').tops := by
      intro u w hw
      rcases i5 u w hw with h' | h' | h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inl h')
      · exact Or.inr (Or.inr (Or.inl (hle.2.2.2.1 h')))
      · exact Or.inr (Or.inr (Or.inr (lift u h')))
    intro u w h
    rw [hRR, mem_asm_kc] at h
    rcases h with h | ⟨hp, _⟩
    · rcases (mem_kc1 G S u w).1 h with h | h
      · rcases (mem_step_kc G R u w).1 h with h | ⟨hu, _⟩
        · exact fromRkc u w h
        · exact Or.inr (Or.inr (Or.inr (now u hu)))
      · exact Or.inr (Or.inr (Or.inl (hSA.2.2.2.1 h)))
    · rcases (mem_step_pc G R u w).1 hp with hp | hp
      · rcases i6 u w hp with h' | ⟨_, h'⟩ | h'
        · exact Or.inr (Or.inl h')
        · exact fromRkc u w h'
        · exact Or.inr (Or.inr (Or.inr (lift u h')))
      · exact Or.inr (Or.inr (Or.inr (now u hp)))
  · -- input components
    intro u w h
    rw [hRR, mem_asm_pc] at h
    rcases h with h | ⟨hc, hk⟩
    · rcases (mem_step_pc G R u w).1 h with h | h
      · rcases i6 u w h with h' | ⟨h1, h2⟩ | h'
        · exact Or.inl h'
        · exact Or.inr (Or.inl ⟨hle.2.1 h1, hle.2.2.2.2.1 h2⟩)
        · exact Or.inr (Or.inr (lift u h'))
      · exact Or.inr (Or.inr (now u h))
    · exact Or.inr (Or.inl ⟨hSA.2.1 hc, (mem_asm_kc G S u w).2 (Or.inl hk)⟩)

theorem inv_reach (t : ℕ) : Inv G K₀ t := by
  induction t with
  | zero => exact inv_zero G K₀
  | succ t ih => exact inv_succ G K₀ t ih


/-- **A known top that is not covered is free**: it is a row of at most `D − 1` calls, and each coordinate of its
column is held (as a column entry or a top-input component), on a covered lower row, or on a lower row of at most `D − 2`
calls. -/
theorem free_top (D : ℕ) (u : Fin n) (hu : u ∈ (reach G K₀ D).tops) (hc : ¬ TopCov G K₀ u) :
    ovCalls G u + 1 ≤ D ∧
      ∀ w, (w, u) ∈ K₀.cols ∨ (u, w) ∈ K₀.pc ∨ LowCov G K₀ w ∨ ovCalls G w + 2 ≤ D := by
  classical
  have hex : ∃ t', t' < D ∧ ((ovCalls G u ≤ t' ∧ (reach G K₀ t').colKnown u) ∨
      ∀ w, (u, w) ∈ (reach G K₀ t').pc) := by
    rcases (inv_reach G K₀ D).2.2.2.1 u hu with h | ⟨t', ht', h⟩
    · exact absurd h hc
    · exact ⟨t', ht', h⟩
  set t₀ := Nat.find hex with ht₀
  obtain ⟨hlt, hspec⟩ := Nat.find_spec hex
  have notop : ∀ t'' ≤ t₀, u ∉ (reach G K₀ t'').tops := by
    intro t'' ht'' h
    rcases (inv_reach G K₀ t'').2.2.2.1 u h with h' | ⟨t3, ht3, h3⟩
    · exact hc h'
    · exact Nat.find_min hex (show t3 < t₀ by omega) ⟨by omega, h3⟩
  have entry : ∀ w, (w, u) ∈ (reach G K₀ t₀).cols →
      (w, u) ∈ K₀.cols ∨ (u, w) ∈ K₀.pc ∨ LowCov G K₀ w ∨ ovCalls G w + 2 ≤ D := by
    intro w hw
    rcases (inv_reach G K₀ t₀).2.2.2.2.1 w u hw with h | h | h | h | ⟨t', ht', h⟩
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr (by omega)))
    · exact absurd h (notop t' (by omega))
  rcases hspec with ⟨hcl, hcol⟩ | hpc
  · exact ⟨by omega, fun w => entry w (hcol w)⟩
  · have hcoord : ∀ w, ((u, w) ∈ K₀.pc) ∨ ((w, u) ∈ (reach G K₀ t₀).cols ∧ (u, w) ∈ (reach G K₀ t₀).kc) := by
      intro w
      rcases (inv_reach G K₀ t₀).2.2.2.2.2.2 u w (hpc w) with h | h | ⟨t', ht', h⟩
      · exact Or.inl h
      · exact Or.inr h
      · exact absurd h (notop t' (by omega))
    refine ⟨?_, fun w => ?_⟩
    · by_contra hcl
      apply hc
      refine Or.inr (Or.inl (Or.inr (Or.inr ⟨rfl, fun w => ?_⟩)))
      rcases hcoord w with h | ⟨_, hk⟩
      · exact Or.inr h
      · rcases (inv_reach G K₀ t₀).2.2.2.2.2.1 u w hk with h' | h' | h' | ⟨t', ht', h'⟩
        · exact Or.inl h'
        · exact Or.inr h'
        · rcases (inv_reach G K₀ t₀).2.2.1 1 u h' with h'' | h'' | h''
          · exact absurd (Or.inr (Or.inl h'')) hc
          · exact absurd (show ovCalls G u + 1 ≤ D by omega) hcl
          · exact absurd ((labKnown_one' _ u).1 h'') (notop t₀ le_rfl)
        · exact absurd h' (notop t' (by omega))
    · rcases hcoord w with h | ⟨hw, _⟩
      · exact Or.inr (Or.inl h)
      · exact entry w hw


/-- The item a held `r` at call `j` of row `v` covers: its block, or the row itself for the pad call. -/
def rTarget (p : Fin 2 × Fin n × ℕ) : Fin n :=
  match ovBlock G p.2.1 p.2.2 with
  | some u => u
  | none => p.2.1

theorem card_filter_lt_le (a : ℕ) : (Finset.univ.filter fun u : Fin n => u.val < a).card ≤ a := by
  calc (Finset.univ.filter fun u : Fin n => u.val < a).card
      = ((Finset.univ.filter fun u : Fin n => u.val < a).image Fin.val).card :=
        (Finset.card_image_of_injective _ Fin.val_injective).symm
    _ ≤ (Finset.range a).card := Finset.card_le_card (fun x hx => by
        obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hx
        exact Finset.mem_range.2 (Finset.mem_filter.1 hy).2)
    _ = a := Finset.card_range a

open Classical in
/-- Covered rows of layer `L` lie in the image of that layer's held items, or have every key coordinate held. -/
theorem cov_subset (L : Fin 2) :
    (Finset.univ.filter fun v => RowSeed G K₀ L v ∨ Reveal G K₀ L v) ⊆
      ((K₀.hs.filter fun p => p.1 = L ∧ p.2.2 ≠ 0).image fun p => p.2.1) ∪
        ((K₀.rs.filter fun p => p.1 = L).image (rTarget G)) ∪
        (Finset.univ.filter fun v => L = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc) := by
  intro v hv
  rcases (Finset.mem_filter.1 hv).2 with (⟨j, hj, h⟩ | h | h) | ⟨v', j, h, hb⟩
  · exact Finset.mem_union_left _ (Finset.mem_union_left _
      (Finset.mem_image.2 ⟨(L, v, j), Finset.mem_filter.2 ⟨h, rfl, Nat.pos_iff_ne_zero.mp hj⟩, rfl⟩))
  · refine Finset.mem_union_left _ (Finset.mem_union_right _
      (Finset.mem_image.2 ⟨(L, v, ovCalls G v), Finset.mem_filter.2 ⟨h, rfl⟩, ?_⟩))
    simp only [rTarget, ovBlock_pad]
  · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩)
  · refine Finset.mem_union_left _ (Finset.mem_union_right _
      (Finset.mem_image.2 ⟨(L, v', j), Finset.mem_filter.2 ⟨h, rfl⟩, ?_⟩))
    simp only [rTarget, hb]

open Classical in
theorem card_cov_le (L : Fin 2) :
    (Finset.univ.filter fun v => RowSeed G K₀ L v ∨ Reveal G K₀ L v).card ≤
      (K₀.hs.filter fun p => p.1 = L ∧ p.2.2 ≠ 0).card + (K₀.rs.filter fun p => p.1 = L).card +
        (Finset.univ.filter fun v => L = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card :=
  (Finset.card_le_card (cov_subset G K₀ L)).trans ((Finset.card_union_le _ _).trans
    (add_le_add ((Finset.card_union_le _ _).trans (add_le_add Finset.card_image_le Finset.card_image_le)) le_rfl))

open Classical in
theorem card_comp_zero :
    (Finset.univ.filter fun v : Fin n => (0 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card = 0 := by
  rw [Finset.card_eq_zero]
  exact Finset.filter_false_of_mem fun v _ h => absurd h.1 (by decide)

open Classical in
/-- **The tops covered by components, and the free tops' held input components, are disjoint held items.** -/
theorem card_comp_le (F : Finset (Fin n)) (hF : ∀ u ∈ F, ¬ ∀ w, (u, w) ∈ K₀.kc ∨ (u, w) ∈ K₀.pc) :
    n * (Finset.univ.filter fun v : Fin n => (1 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card +
      (K₀.pc.filter fun q => q.1 ∈ F).card ≤ K₀.kc.card + K₀.pc.card := by
  set S3 := Finset.univ.filter fun v : Fin n => (1 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc
  have hAsub : S3 ×ˢ (Finset.univ : Finset (Fin n)) ⊆ K₀.kc ∪ K₀.pc := fun q hq => by
    obtain ⟨h1, _⟩ := Finset.mem_product.1 hq
    rcases (Finset.mem_filter.1 h1).2.2 q.2 with h | h
    · exact Finset.mem_union_left _ h
    · exact Finset.mem_union_right _ h
  have hBsub : (K₀.pc.filter fun q => q.1 ∈ F) ⊆ K₀.kc ∪ K₀.pc :=
    fun q hq => Finset.mem_union_right _ (Finset.mem_filter.1 hq).1
  have hdisj : Disjoint (S3 ×ˢ (Finset.univ : Finset (Fin n))) (K₀.pc.filter fun q => q.1 ∈ F) :=
    Finset.disjoint_left.2 fun q h1 h2 => by
      obtain ⟨h1, _⟩ := Finset.mem_product.1 h1
      exact hF q.1 (Finset.mem_filter.1 h2).2 (Finset.mem_filter.1 h1).2.2
  have h := Finset.card_le_card (Finset.union_subset hAsub hBsub)
  rw [Finset.card_union_of_disjoint hdisj, Finset.card_product, Finset.card_univ, Fintype.card_fin] at h
  have hu := Finset.card_union_le K₀.kc K₀.pc
  linarith [Nat.mul_comm n S3.card]

theorem card_layers_le {α : Type} [DecidableEq α] (s : Finset (Fin 2 × α)) (P : Fin 2 × α → Prop) [DecidablePred P] :
    (s.filter fun p => p.1 = 0 ∧ P p).card + (s.filter fun p => p.1 = 1 ∧ P p).card ≤ (s.filter P).card := by
  rw [← Finset.card_union_of_disjoint]
  · refine Finset.card_le_card fun p hp => ?_
    rcases Finset.mem_union.1 hp with h | h <;> exact Finset.mem_filter.2 ⟨(Finset.mem_filter.1 h).1, (Finset.mem_filter.1 h).2.2⟩
  · refine Finset.disjoint_left.2 fun p h1 h2 => ?_
    have := (Finset.mem_filter.1 h1).2.1
    have := (Finset.mem_filter.1 h2).2.1
    simp_all

/-- The free tops' held column entries are held entries. -/
theorem sum_cols_le (F : Finset (Fin n)) :
    ∑ u ∈ F, (Finset.univ.filter fun w => (w, u) ∈ K₀.cols).card ≤ K₀.cols.card := by
  classical
  have hbi : (F.biUnion fun u => (Finset.univ.filter fun w => (w, u) ∈ K₀.cols).image fun w => (w, u)) ⊆
      K₀.cols := by
    intro q hq
    obtain ⟨u, _, hq⟩ := Finset.mem_biUnion.1 hq
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.1 hq
    exact (Finset.mem_filter.1 hw).2
  refine le_trans (le_of_eq ?_) (Finset.card_le_card hbi)
  rw [Finset.card_biUnion]
  · exact Finset.sum_congr rfl fun u _ =>
      (Finset.card_image_of_injective _ fun w w' h => (Prod.mk.inj h).1).symm
  · intro u _ u' _ huu
    refine Finset.disjoint_left.2 fun q h1 h2 => huu ?_
    obtain ⟨w, _, rfl⟩ := Finset.mem_image.1 h1
    obtain ⟨w', _, h⟩ := Finset.mem_image.1 h2
    exact ((Prod.mk.inj h).2).symm

/-- The free tops' held input components are the held input components on free rows. -/
theorem sum_pc_le (F : Finset (Fin n)) :
    ∑ u ∈ F, (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).card ≤ (K₀.pc.filter fun q => q.1 ∈ F).card := by
  classical
  have hbi : (F.biUnion fun u => (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).image fun w => (u, w)) ⊆
      K₀.pc.filter fun q => q.1 ∈ F := by
    intro q hq
    obtain ⟨u, hu, hq⟩ := Finset.mem_biUnion.1 hq
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.1 hq
    exact Finset.mem_filter.2 ⟨(Finset.mem_filter.1 hw).2, hu⟩
  refine le_trans (le_of_eq ?_) (Finset.card_le_card hbi)
  rw [Finset.card_biUnion]
  · exact Finset.sum_congr rfl fun u _ =>
      (Finset.card_image_of_injective _ fun w w' h => (Prod.mk.inj h).2).symm
  · intro u _ u' _ huu
    refine Finset.disjoint_left.2 fun q h1 h2 => huu ?_
    obtain ⟨w, _, rfl⟩ := Finset.mem_image.1 h1
    obtain ⟨w', _, h⟩ := Finset.mem_image.1 h2
    exact ((Prod.mk.inj h).1).symm

/-- **The generic chain-column certificate.** If a top row of at most `D − 1` calls has index `< a`, and a lower row
of at most `D − 2` calls has index `< b`, then every holding that knows all `n` tops after `D` rounds costs at least
`n² − a·b` columns. So `P3ChainHard G c wc D n X` whenever `a·b ≤ X·n`. -/
theorem p3ChainHard_of_clock (c wc D a b X : ℕ) (ha : ∀ u : Fin n, ovCalls G u + 1 ≤ D → u.val < a)
    (hb : ∀ w : Fin n, ovCalls G w + 2 ≤ D → w.val < b) (hab : a * b ≤ X * n) :
    P3ChainHard G c wc D n X := by
  classical
  intro K₀ hk
  have hall : ∀ u : Fin n, u ∈ (reach G K₀ D).tops := by
    intro u
    by_contra hu
    have : ((reach G K₀ D).tops).card < n := by
      calc ((reach G K₀ D).tops).card < (Finset.univ : Finset (Fin n)).card :=
            Finset.card_lt_card (Finset.ssubset_iff_subset_ne.2 ⟨Finset.subset_univ _,
              fun he => hu (he ▸ Finset.mem_univ u)⟩)
        _ = n := by simp
    omega
  set F := Finset.univ.filter fun u => ¬ TopCov G K₀ u with hF
  set Lc := Finset.univ.filter fun w => RowSeed G K₀ 0 w ∨ Reveal G K₀ 0 w with hLc
  have hFa : F.card ≤ a := (Finset.card_le_card fun u hu =>
    Finset.mem_filter.2 ⟨Finset.mem_univ _, ha u (free_top G K₀ D u (hall u) (Finset.mem_filter.1 hu).2).1⟩).trans
      (card_filter_lt_le a)
  have hFn : F.card ≤ n := (Finset.card_le_univ F).trans (by simp)
  have hTop : n ≤ K₀.tops.card + ((K₀.hs.filter fun p => p.1 = 1 ∧ p.2.2 ≠ 0).card +
      (K₀.rs.filter fun p => p.1 = 1).card +
      (Finset.univ.filter fun v : Fin n => (1 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card) +
      F.card := by
    have hsplit : (Finset.univ : Finset (Fin n)) ⊆ K₀.tops ∪
        (Finset.univ.filter fun v => RowSeed G K₀ 1 v ∨ Reveal G K₀ 1 v) ∪ F := by
      intro u _
      by_cases hu : TopCov G K₀ u
      · rcases hu with h | h | h
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ h)
        · exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inl h⟩))
        · exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, Or.inr h⟩))
      · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hu⟩)
    have := Finset.card_le_card hsplit
    simp only [Finset.card_univ, Fintype.card_fin] at this
    have h2 := Finset.card_union_le (K₀.tops ∪ Finset.univ.filter fun v => RowSeed G K₀ 1 v ∨ Reveal G K₀ 1 v) F
    have h3 := Finset.card_union_le K₀.tops (Finset.univ.filter fun v => RowSeed G K₀ 1 v ∨ Reveal G K₀ 1 v)
    have h4 := card_cov_le G K₀ 1
    omega
  set PF := (K₀.pc.filter fun q => q.1 ∈ F).card with hPF
  have hCols : F.card * n ≤ K₀.cols.card + PF + F.card * (Lc.card + b) := by
    have hper : ∀ u ∈ F, n ≤ (Finset.univ.filter fun w => (w, u) ∈ K₀.cols).card +
        (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).card + (Lc.card + b) := by
      intro u hu
      have hfree := (free_top G K₀ D u (hall u) (Finset.mem_filter.1 hu).2).2
      have hsub : (Finset.univ : Finset (Fin n)) ⊆
          (Finset.univ.filter fun w => (w, u) ∈ K₀.cols) ∪
          (Finset.univ.filter fun w => (u, w) ∈ K₀.pc) ∪ Lc ∪
          (Finset.univ.filter fun w : Fin n => w.val < b) := by
        intro w _
        rcases hfree w with h | h | h | h
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
            (Finset.mem_filter.2 ⟨Finset.mem_univ _, by simpa using h⟩)))
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
            (Finset.mem_filter.2 ⟨Finset.mem_univ _, by simpa using h⟩)))
        · exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩))
        · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hb w h⟩)
      have := Finset.card_le_card hsub
      simp only [Finset.card_univ, Fintype.card_fin] at this
      have h1 := Finset.card_union_le ((Finset.univ.filter fun w => (w, u) ∈ K₀.cols) ∪
          (Finset.univ.filter fun w => (u, w) ∈ K₀.pc) ∪ Lc)
        (Finset.univ.filter fun w : Fin n => w.val < b)
      have h2 := Finset.card_union_le ((Finset.univ.filter fun w => (w, u) ∈ K₀.cols) ∪
          (Finset.univ.filter fun w => (u, w) ∈ K₀.pc)) Lc
      have h3 := Finset.card_union_le (Finset.univ.filter fun w => (w, u) ∈ K₀.cols)
          (Finset.univ.filter fun w => (u, w) ∈ K₀.pc)
      have h4 := card_filter_lt_le (n := n) b
      omega
    have hsC := sum_cols_le K₀ F
    have hsP := sum_pc_le K₀ F
    calc F.card * n = ∑ _u ∈ F, n := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ ∑ u ∈ F, ((Finset.univ.filter fun w => (w, u) ∈ K₀.cols).card +
            (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).card + (Lc.card + b)) :=
          Finset.sum_le_sum hper
      _ = ∑ u ∈ F, (Finset.univ.filter fun w => (w, u) ∈ K₀.cols).card +
            ∑ u ∈ F, (Finset.univ.filter fun w => (u, w) ∈ K₀.pc).card +
            F.card * (Lc.card + b) := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_const, smul_eq_mul]
      _ ≤ K₀.cols.card + PF + F.card * (Lc.card + b) := add_le_add (add_le_add hsC hsP) le_rfl
  have hLow := card_cov_le G K₀ 0
  rw [card_comp_zero, Nat.add_zero] at hLow
  have hKP := card_comp_le K₀ F fun u hu hcov =>
    (Finset.mem_filter.1 hu).2 (Or.inr (Or.inl (Or.inr (Or.inr ⟨rfl, hcov⟩))))
  have hHs := card_layers_le K₀.hs fun p => p.2.2 ≠ 0
  have hRs : (K₀.rs.filter fun p => p.1 = 0).card + (K₀.rs.filter fun p => p.1 = 1).card ≤ K₀.rs.card := by
    have := card_layers_le K₀.rs fun _ => True
    simp only [and_true] at this
    rwa [Finset.filter_true_of_mem (fun _ _ => trivial)] at this
  have hsize : ((n : ℚ) * K₀.tops.card + K₀.cols.card + (n : ℚ) * (K₀.hs.filter fun p => p.2.2 ≠ 0).card +
      (n : ℚ) * K₀.rs.card + K₀.kc.card + K₀.pc.card) ≤ K₀.size c wc := by
    unfold P3ChainKnow.size
    have : (n : ℚ) * (K₀.hs.filter fun p => p.2.2 ≠ 0).card ≤
        ((n : ℚ) + (c : ℚ) / wc) * (K₀.hs.filter fun p => p.2.2 ≠ 0).card := by
      have : (0 : ℚ) ≤ (c : ℚ) / wc := by positivity
      nlinarith [(Nat.cast_nonneg (K₀.hs.filter fun p => p.2.2 ≠ 0).card : (0 : ℚ) ≤ _)]
    linarith
  refine le_trans ?_ hsize
  set T := K₀.tops.card
  set C := K₀.cols.card
  set f := F.card
  set il := Lc.card
  set Ht := (K₀.hs.filter fun p => p.1 = 1 ∧ p.2.2 ≠ 0).card
  set Hl := (K₀.hs.filter fun p => p.1 = 0 ∧ p.2.2 ≠ 0).card
  set Rt := (K₀.rs.filter fun p => p.1 = 1).card
  set Rl := (K₀.rs.filter fun p => p.1 = 0).card
  set Kt := (Finset.univ.filter fun v : Fin n => (1 : Fin 2) = 1 ∧ ∀ w, (v, w) ∈ K₀.kc ∨ (v, w) ∈ K₀.pc).card
  have e1 : (n : ℚ) ≤ T + (Ht + Rt + Kt) + f := by exact_mod_cast hTop
  have e2 : (f : ℚ) * n ≤ C + PF + f * (il + b) := by exact_mod_cast hCols
  have e3 : (il : ℚ) ≤ Hl + Rl := by exact_mod_cast hLow
  have e4 : (Hl : ℚ) + Ht ≤ (K₀.hs.filter fun p => p.2.2 ≠ 0).card := by exact_mod_cast hHs
  have e5 : (Rl : ℚ) + Rt ≤ K₀.rs.card := by exact_mod_cast hRs
  have e6 : (f : ℚ) ≤ a := by exact_mod_cast hFa
  have e7 : (f : ℚ) ≤ n := by exact_mod_cast hFn
  have e8 : (a : ℚ) * b ≤ X * n := by exact_mod_cast hab
  have e9 : (n : ℚ) * Kt + PF ≤ K₀.kc.card + K₀.pc.card := by exact_mod_cast hKP
  have hb0 : (0 : ℚ) ≤ b := by positivity
  have hil0 : (0 : ℚ) ≤ il := by positivity
  rcases Nat.le_total X n with hXle | hXle
  · rw [Nat.cast_sub hXle]
    nlinarith [mul_le_mul_of_nonneg_right e6 hb0, mul_nonneg hil0 (sub_nonneg.2 e7),
      mul_le_mul_of_nonneg_left e4 (Nat.cast_nonneg n), mul_le_mul_of_nonneg_left e5 (Nat.cast_nonneg n),
      mul_le_mul_of_nonneg_left e3 (Nat.cast_nonneg n), mul_le_mul_of_nonneg_left e1 (Nat.cast_nonneg n)]
  · rw [Nat.sub_eq_zero_of_le hXle, Nat.cast_zero, zero_mul]
    positivity

end P3ChainKnow


/-- On `B(220, k)`, a node at index `≥ m` with `m ≤ k` has at least `m` parents. -/
theorem card_par_band_ge {k : ℕ} (hk : 1 ≤ k) (v : Fin 220) (m : ℕ) (hm : m ≤ k) (hv : m ≤ v.val) :
    m ≤ ((Pous.P3Column.bandGraph 220 k).par v).card := by
  classical
  let f : Fin m → Fin 220 := fun i => ⟨v.val - 1 - i.val, by omega⟩
  have hf : Function.Injective f := fun i i' h => by
    have := congrArg Fin.val h
    simp only [f] at this
    exact Fin.ext (by omega)
  calc m = (Finset.univ.image f).card := by rw [Finset.card_image_of_injective _ hf]; simp
    _ ≤ _ := Finset.card_le_card fun u hu => by
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.1 hu
      rw [Pous.P3Column.mem_par_band hk]
      unfold Pous.P3Column.Band
      simp only [f]
      omega

theorem ovCalls_band_ge (v : Fin 220) (m : ℕ) (hm : m ≤ 12) (hv : m ≤ v.val) :
    m + 1 ≤ ovCalls (Pous.P3Column.bandGraph 220 12) v := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]
  have := card_par_band_ge (k := 12) (by norm_num) v m hm hv
  omega

/-- **The deployment certificate: `X = 1` on `B(220, 12)` at `D = 10`.** A free top is a row of at most 9 calls,
`u ≤ 8`, and a clocked lower row has at most 8, `w ≤ 7`, so `a·b = 9·8 = 72 ≤ 220`. -/
theorem p3ChainCert : P3ChainCert := by
  refine P3ChainKnow.p3ChainHard_of_clock _ 512 2384 10 9 8 1 (fun u hu => ?_) (fun w hw => ?_) (by norm_num)
  · by_contra h
    have := ovCalls_band_ge u 9 (by norm_num) (by omega)
    omega
  · by_contra h
    have := ovCalls_band_ge w 8 (by norm_num) (by omega)
    omega

/-- **The generic certificate at the fallback `B(220, 16)`, `D = 12`**: `a = 11` (rows of at most 11 calls), `b = 10`,
`a·b = 110 ≤ 220`, so `X = 1` there too. -/
theorem card_par_band16_ge (v : Fin 220) (m : ℕ) (hm : m ≤ 16) (hv : m ≤ v.val) :
    m + 1 ≤ ovCalls (Pous.P3Column.bandGraph 220 16) v := by
  unfold ovCalls parentsDesc
  rw [Finset.length_sort]
  have := card_par_band_ge (k := 16) (by norm_num) v m hm hv
  omega

theorem p3ChainCert_band16 : P3ChainHard (Pous.P3Column.bandGraph 220 16) 512 2384 12 220 1 := by
  refine P3ChainKnow.p3ChainHard_of_clock _ 512 2384 12 11 10 1 (fun u hu => ?_) (fun w hw => ?_) (by norm_num)
  · by_contra h
    have := card_par_band16_ge u 11 (by norm_num) (by omega)
    omega
  · by_contra h
    have := card_par_band16_ge w 10 (by norm_num) (by omega)
    omega

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainSim ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge

namespace P3Replay

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) (ω : P3COmega n wc)


theorem mem_pos {L : Fin 2} {v : Fin n} {p : ℕ} (hp : p ≤ ovCalls R.G v) : (L, v, p) ∈ P3ChainKnow.pos n := by
  have := ovCalls_le R.G v
  simp only [P3ChainKnow.pos, Finset.mem_product, Finset.mem_univ, Finset.mem_range, true_and]
  omega


theorem labKnown_zero (K : P3ChainKnow n) (u : Fin n) : K.labKnown 0 u ↔ K.lowKnown u := by
  simp [P3ChainKnow.labKnown]

theorem labKnown_one (K : P3ChainKnow n) (u : Fin n) : K.labKnown 1 u ↔ u ∈ K.tops := by
  simp [P3ChainKnow.labKnown]


end P3Replay

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainOnline ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge

namespace P3ChainKnow

variable {n : ℕ} (G : TopoDAG n)

def empty : P3ChainKnow n := ⟨∅, ∅, ∅, ∅, ∅, ∅⟩

def union (A B : P3ChainKnow n) : P3ChainKnow n :=
  ⟨A.tops ∪ B.tops, A.cols ∪ B.cols, A.hs ∪ B.hs, A.rs ∪ B.rs, A.kc ∪ B.kc, A.pc ∪ B.pc⟩

open Classical in
/-- **What a round adds**: the shows `S` that `K` does not know, closed against each other under the instantaneous
XOR. Columns join first. A top-key component is dropped when this round's column and a known `pin2` component give it;
a `pin2` component is dropped when its column and key component are known or shown. So no triple
`(entry, kc, pc)` gains two items from one guess. -/
noncomputable def fresh (S K : P3ChainKnow n) : P3ChainKnow n where
  tops := S.tops \ K.tops
  cols := S.cols \ K.cols
  hs := S.hs \ K.hs
  rs := S.rs \ K.rs
  kc := (S.kc \ K.kc).filter fun q => ¬ ((q.2, q.1) ∈ S.cols ∧ q ∈ K.pc)
  pc := (S.pc \ K.pc).filter fun q => ¬ ((q.2, q.1) ∈ K.cols ∪ S.cols ∧ q ∈ K.kc ∪ S.kc)

theorem fresh_sub (S K : P3ChainKnow n) :
    (∀ x ∈ (fresh S K).tops, x ∈ S.tops ∧ x ∉ K.tops) ∧ (∀ x ∈ (fresh S K).cols, x ∈ S.cols ∧ x ∉ K.cols) ∧
    (∀ x ∈ (fresh S K).hs, x ∈ S.hs ∧ x ∉ K.hs) ∧ (∀ x ∈ (fresh S K).rs, x ∈ S.rs ∧ x ∉ K.rs) ∧
    (∀ x ∈ (fresh S K).kc, x ∈ S.kc ∧ x ∉ K.kc) ∧ (∀ x ∈ (fresh S K).pc, x ∈ S.pc ∧ x ∉ K.pc) := by
  refine ⟨fun x hx => Finset.mem_sdiff.1 hx, fun x hx => Finset.mem_sdiff.1 hx, fun x hx => Finset.mem_sdiff.1 hx,
    fun x hx => Finset.mem_sdiff.1 hx, fun x hx => Finset.mem_sdiff.1 (Finset.mem_filter.1 hx).1,
    fun x hx => Finset.mem_sdiff.1 (Finset.mem_filter.1 hx).1⟩

/-- **An assembled holding is XOR-closed** (column and `pin2` give the key component). -/
theorem asm_closed_kc (X : P3ChainKnow n) {u w : Fin n} (hc : (w, u) ∈ (X.assemble G).cols)
    (hp : (u, w) ∈ (X.assemble G).pc) : (u, w) ∈ (X.assemble G).kc := by
  rw [mem_asm_cols] at hc
  rw [mem_asm_pc] at hp
  rw [mem_asm_kc]
  rcases hc with hc | ⟨_, hk⟩
  · rcases hp with hp | ⟨_, hk⟩
    · exact Or.inr ⟨hp, hc⟩
    · exact Or.inl hk
  · exact Or.inl hk

/-- **An assembled holding is XOR-closed** (column and key component give the `pin2` component). -/
theorem asm_closed_pc (X : P3ChainKnow n) {u w : Fin n} (hc : (w, u) ∈ (X.assemble G).cols)
    (hk : (u, w) ∈ (X.assemble G).kc) : (u, w) ∈ (X.assemble G).pc := by
  rw [mem_asm_cols] at hc
  rw [mem_asm_kc] at hk
  rw [mem_asm_pc]
  rcases hc with hc | ⟨hp, _⟩
  · rcases hk with hk | ⟨hp, _⟩
    · exact Or.inr ⟨hc, hk⟩
    · exact Or.inl hp
  · exact Or.inl hp

/-- Every reach is an assembled holding. -/
theorem reach_asm (K₀ : P3ChainKnow n) (t : ℕ) : ∃ X : P3ChainKnow n, reach G K₀ t = X.assemble G := by
  cases t with
  | zero => exact ⟨K₀, rfl⟩
  | succ t => exact ⟨(reach G K₀ t).step G, rfl⟩

theorem reach_closed_kc (K₀ : P3ChainKnow n) (t : ℕ) {u w : Fin n} (hc : (w, u) ∈ (reach G K₀ t).cols)
    (hp : (u, w) ∈ (reach G K₀ t).pc) : (u, w) ∈ (reach G K₀ t).kc := by
  obtain ⟨X, hX⟩ := reach_asm G K₀ t
  rw [hX] at hc hp ⊢
  exact asm_closed_kc G X hc hp

theorem reach_closed_pc (K₀ : P3ChainKnow n) (t : ℕ) {u w : Fin n} (hc : (w, u) ∈ (reach G K₀ t).cols)
    (hk : (u, w) ∈ (reach G K₀ t).kc) : (u, w) ∈ (reach G K₀ t).pc := by
  obtain ⟨X, hX⟩ := reach_asm G K₀ t
  rw [hX] at hc hk ⊢
  exact asm_closed_pc G X hc hk

/-- In an assembled holding, a whole top key gives each of its components. -/
theorem asm_kc_of_key (X : P3ChainKnow n) {u w : Fin n} (hr : ((1 : Fin 2), u, ovCalls G u) ∈ (X.assemble G).rs) :
    (u, w) ∈ (X.assemble G).kc := by
  rw [mem_asm_rs] at hr
  rw [mem_asm_kc]
  rcases hr with hr | ⟨_, _, hall⟩
  · exact Or.inl ((mem_kc1 G _ u w).2 (Or.inr hr))
  · rcases hall w with h | h
    · exact Or.inl h
    · exact Or.inr h

/-- In an assembled holding, a top key whose components are all known is itself known. -/
theorem asm_key_of_kc (X : P3ChainKnow n) {u : Fin n} (hk : ∀ w, (u, w) ∈ (X.assemble G).kc) :
    ((1 : Fin 2), u, ovCalls G u) ∈ (X.assemble G).rs := by
  rw [mem_asm_rs]
  refine Or.inr ⟨rfl, rfl, fun w => ?_⟩
  have := hk w
  rw [mem_asm_kc] at this
  exact this

/-- **The closure is idempotent**: assembling an assembled holding adds nothing. -/
theorem asm_idem (X : P3ChainKnow n) : Le ((X.assemble G).assemble G) (X.assemble G) := by
  set A := X.assemble G
  have hkc1 : ∀ {u w : Fin n}, (u, w) ∈ A.kc1 G → (u, w) ∈ A.kc := fun {u w} h => by
    rcases (mem_kc1 G A u w).1 h with h | h
    · exact h
    · exact asm_kc_of_key G X h
  refine ⟨fun x hx => hx, fun q hq => ?_, fun p hp => hp, fun p hp => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · obtain ⟨w, u⟩ := q
    rcases (mem_asm_cols G A w u).1 hq with h | ⟨hp, hk⟩
    · exact h
    · have hk' := hkc1 hk
      rw [mem_asm_pc] at hp
      rw [mem_asm_kc] at hk'
      rw [mem_asm_cols]
      rcases hp with hp | ⟨hc, _⟩
      · rcases hk' with hk' | ⟨_, hc⟩
        · exact Or.inr ⟨hp, hk'⟩
        · exact Or.inl hc
      · exact Or.inl hc
  · obtain ⟨L, v, j⟩ := p
    rcases (mem_asm_rs G A L v j).1 hp with h | ⟨hL, hj, hall⟩
    · exact h
    · subst hL; subst hj
      refine asm_key_of_kc G X fun w => ?_
      rcases hall w with h | ⟨hp, hc⟩
      · exact hkc1 h
      · exact asm_closed_kc G X hc hp
  · obtain ⟨u, w⟩ := q
    rcases (mem_asm_kc G A u w).1 hq with h | ⟨hp, hc⟩
    · exact hkc1 h
    · exact asm_closed_kc G X hc hp
  · obtain ⟨u, w⟩ := q
    rcases (mem_asm_pc G A u w).1 hq with h | ⟨hc, hk⟩
    · exact h
    · exact asm_closed_pc G X hc (hkc1 hk)

/-- **Every reach is closed under the instantaneous closure.** -/
theorem reach_asm_le (K₀ : P3ChainKnow n) (t : ℕ) : Le ((reach G K₀ t).assemble G) (reach G K₀ t) := by
  obtain ⟨X, hX⟩ := reach_asm G K₀ t
  rw [hX]
  exact asm_idem G X

theorem Le.rfl' (K : P3ChainKnow n) : Le K K :=
  ⟨subset_rfl, subset_rfl, subset_rfl, subset_rfl, subset_rfl, subset_rfl⟩

theorem le_union_left (A B : P3ChainKnow n) : Le A (A.union B) :=
  ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left,
    Finset.subset_union_left, Finset.subset_union_left⟩

theorem le_union_right (A B : P3ChainKnow n) : Le B (A.union B) :=
  ⟨Finset.subset_union_right, Finset.subset_union_right, Finset.subset_union_right, Finset.subset_union_right,
    Finset.subset_union_right, Finset.subset_union_right⟩

theorem canCall_mono {K K' : P3ChainKnow n} (h : Le K K') {L : Fin 2} {v : Fin n} {j : ℕ}
    (hc : K.canCall G L v j) : K'.canCall G L v j :=
  ⟨hc.1, hc.2.1, fun u hb => h.labKnown (hc.2.2.1 u hb), hc.2.2.2.imp_right fun hh => h.2.2.1 hh⟩

/-- **The moves are monotone in the knowledge.** -/
theorem step_mono {K K' : P3ChainKnow n} (h : Le K K') : Le (K.step G) (K'.step G) := by
  refine ⟨fun u hu => ?_, fun q hq => ?_, fun p hp => ?_, fun p hp => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · rw [mem_step_tops] at hu ⊢
    rcases hu with hu | ⟨hk, hc⟩ | ⟨p, hp, hpr, hp1, hb⟩ | hpc
    · exact Or.inl (h.1 hu)
    · exact Or.inr (Or.inl ⟨h.2.2.2.1 hk, fun w => h.2.1 (hc w)⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨p, h.2.2.1 hp, h.2.2.2.1 hpr, hp1, hb⟩))
    · exact Or.inr (Or.inr (Or.inr fun w => h.2.2.2.2.2 (hpc w)))
  · obtain ⟨w, u⟩ := q
    rw [mem_step_cols] at hq ⊢
    rcases hq with hq | hk | ⟨hu, hk⟩ | ⟨p, hp, hpr, hp1, hb⟩ | ⟨hu, hk⟩
    · exact Or.inl (h.2.1 hq)
    · exact Or.inr (Or.inl (h.2.2.2.1 hk))
    · exact Or.inr (Or.inr (Or.inl ⟨h.1 hu, h.2.2.2.1 hk⟩))
    · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨p, h.2.2.1 hp, h.2.2.2.1 hpr, hp1, hb⟩)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨h.1 hu, h.2.2.2.2.1 hk⟩)))
  · obtain ⟨L, v, j⟩ := p
    rw [mem_step_hs] at hp ⊢
    rcases hp with hp | ⟨hpos, hc | ⟨hj, h1, h2⟩⟩
    · exact Or.inl (h.2.2.1 hp)
    · exact Or.inr ⟨hpos, Or.inl (canCall_mono G h hc)⟩
    · exact Or.inr ⟨hpos, Or.inr ⟨hj, h.2.2.1 h1, h.2.2.2.1 h2⟩⟩
  · obtain ⟨L, v, j⟩ := p
    rw [mem_step_rs] at hp ⊢
    rcases hp with hp | ⟨hpos, hc | ⟨hj, (⟨hL, hl⟩ | ⟨hL, ht, hcol⟩)⟩⟩
    · exact Or.inl (h.2.2.2.1 hp)
    · exact Or.inr ⟨hpos, Or.inl (canCall_mono G h hc)⟩
    · exact Or.inr ⟨hpos, Or.inr ⟨hj, Or.inl ⟨hL, fun x => h.2.1 (hl x)⟩⟩⟩
    · exact Or.inr ⟨hpos, Or.inr ⟨hj, Or.inr ⟨hL, h.1 ht, fun x => h.2.1 (hcol x)⟩⟩⟩
  · obtain ⟨u, w⟩ := q
    rw [mem_step_kc] at hq ⊢
    rcases hq with hq | ⟨hu, hc⟩
    · exact Or.inl (h.2.2.2.2.1 hq)
    · exact Or.inr ⟨h.1 hu, h.2.1 hc⟩
  · obtain ⟨u, w⟩ := q
    rw [mem_step_pc] at hq ⊢
    rcases hq with hq | hu
    · exact Or.inl (h.2.2.2.2.2 hq)
    · exact Or.inr (h.1 hu)

theorem kc1_mono {K K' : P3ChainKnow n} (h : Le K K') {u w : Fin n} (hk : (u, w) ∈ K.kc1 G) : (u, w) ∈ K'.kc1 G := by
  rw [mem_kc1] at hk ⊢
  rcases hk with hk | hk
  · exact Or.inl (h.2.2.2.2.1 hk)
  · exact Or.inr (h.2.2.2.1 hk)

/-- **The instantaneous closure is monotone.** -/
theorem assemble_mono {K K' : P3ChainKnow n} (h : Le K K') : Le (K.assemble G) (K'.assemble G) := by
  refine ⟨h.1, fun q hq => ?_, h.2.2.1, fun p hp => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · obtain ⟨w, u⟩ := q
    rw [mem_asm_cols] at hq ⊢
    rcases hq with hq | ⟨hp, hk⟩
    · exact Or.inl (h.2.1 hq)
    · exact Or.inr ⟨h.2.2.2.2.2 hp, kc1_mono G h hk⟩
  · obtain ⟨L, v, j⟩ := p
    rw [mem_asm_rs] at hp ⊢
    rcases hp with hp | ⟨hL, hj, hall⟩
    · exact Or.inl (h.2.2.2.1 hp)
    · refine Or.inr ⟨hL, hj, fun w => ?_⟩
      rcases hall w with hw | ⟨hp, hc⟩
      · exact Or.inl (kc1_mono G h hw)
      · exact Or.inr ⟨h.2.2.2.2.2 hp, h.2.1 hc⟩
  · obtain ⟨u, w⟩ := q
    rw [mem_asm_kc] at hq ⊢
    rcases hq with hq | ⟨hp, hc⟩
    · exact Or.inl (kc1_mono G h hq)
    · exact Or.inr ⟨h.2.2.2.2.2 hp, h.2.1 hc⟩
  · obtain ⟨u, w⟩ := q
    rw [mem_asm_pc] at hq ⊢
    rcases hq with hq | ⟨hc, hk⟩
    · exact Or.inl (h.2.2.2.2.2 hq)
    · exact Or.inr ⟨h.2.1 hc, kc1_mono G h hk⟩

/-- **A round is monotone in the knowledge.** -/
theorem round_mono {K K' : P3ChainKnow n} (h : Le K K') : Le (K.round G) (K'.round G) :=
  assemble_mono G (step_mono G h)

/-- **The reach is monotone in the holding.** -/
theorem reach_mono {K₀ K₀' : P3ChainKnow n} (h : Le K₀ K₀') (t : ℕ) : Le (reach G K₀ t) (reach G K₀' t) := by
  induction t with
  | zero => exact assemble_mono G h
  | succ t ih => exact round_mono G ih

/-- **A top key whose components are all known is assembled by the next round.** -/
theorem key_of_kc {K : P3ChainKnow n} {u : Fin n} (h : ∀ w, (u, w) ∈ K.kc) :
    ((1 : Fin 2), u, ovCalls G u) ∈ (K.round G).rs :=
  (mem_asm_rs G _ _ _ _).2 (Or.inr ⟨rfl, rfl, fun w =>
    Or.inl ((mem_kc1 G _ u w).2 (Or.inl ((le_step G K).2.2.2.2.1 (h w))))⟩)

end P3ChainKnow

namespace P3Replay

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) (ω : P3COmega n wc)

open Classical in
/-- **What round `τ` shows, as game items** (one coordinate or one whole permutation value each). -/
noncomputable def shownAt (τ : ℕ) : P3ChainKnow n where
  tops := Finset.univ.filter fun u => R.showsLab ω (R.c2 ω u) τ
  cols := Finset.univ.filter fun q => R.showsLab ω (R.c1 ω q.1) τ
  hs := (P3ChainKnow.pos n).filter fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
    R.showsH ω (R.hval ω p.1 p.2.1 p.2.2) τ
  rs := (P3ChainKnow.pos n).filter fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
    ((R.showsR ω (R.rval ω p.1 p.2.1 p.2.2) τ ∧ ¬ (p.1 = 1 ∧ p.2.2 = ovCalls R.G p.2.1)) ∨
      (p.1 = 0 ∧ p.2.2 = ovCalls R.G p.2.1 ∧ R.showsPin ω (R.tag, 0, p.2.1) (R.pin1 ω p.2.1) τ))
  kc := Finset.univ.filter fun q => R.showsR ω (R.rval ω 1 q.1 (ovCalls R.G q.1)) τ
  pc := Finset.univ.filter fun q => R.showsPin ω (R.tag, 1, q.1) (R.pin2 ω q.1) τ

open Classical in
/-- **One pass of the value closure's pair rule.** Every honest pair that a program revealed before round `τ` gives
either whole side from the other:
- `Π₂` at `xin L v p`: the input (the block's label and `h_{p−1}`) gives `h_p` and `r_p`, and the output gives the
  input;
- `P_(tag,0,w)`: `key¹_w` (that is, `pin1 = W ⊕ key¹`) gives all columns of `c¹_w`, and back;
- `P_(tag,1,u)`: all of `pin2 u` gives the top, and back.

Only revealed pairs fire, unlike `step`, which fires every callable move. -/
noncomputable def vcStep (τ : ℕ) (K : P3ChainKnow n) : P3ChainKnow n where
  tops := K.tops ∪ Finset.univ.filter (fun u =>
      ((∃ ρ < τ, R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ) ∧ ∀ w, (u, w) ∈ K.pc) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 1 ∧ 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
        (∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 p.2.2) ρ) ∧ ovBlock R.G p.2.1 p.2.2 = some u))
  cols := K.cols ∪ Finset.univ.filter (fun q : Fin n × Fin n =>
      ((∃ ρ < τ, R.askedP ω (R.tag, 0, q.1) (R.pin1 ω q.1) ρ) ∧ K.keyKnown R.G 0 q.1) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 0 ∧ 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
        (∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 p.2.2) ρ) ∧ ovBlock R.G p.2.1 p.2.2 = some q.1))
  hs := K.hs ∪ (P3ChainKnow.pos n).filter (fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
      (((∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 p.2.2) ρ) ∧ K.canCall R.G p.1 p.2.1 p.2.2) ∨
       (p.2.2 + 1 ≤ ovCalls R.G p.2.1 ∧ (∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 (p.2.2 + 1)) ρ) ∧
         (p.1, p.2.1, p.2.2 + 1) ∈ K.hs ∧ (p.1, p.2.1, p.2.2 + 1) ∈ K.rs)))
  rs := K.rs ∪ (P3ChainKnow.pos n).filter (fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
      (((∃ ρ < τ, R.askedS ω (R.xin ω p.1 p.2.1 p.2.2) ρ) ∧ K.canCall R.G p.1 p.2.1 p.2.2) ∨
       (p.1 = 0 ∧ p.2.2 = ovCalls R.G p.2.1 ∧ (∃ ρ < τ, R.askedP ω (R.tag, 0, p.2.1) (R.pin1 ω p.2.1) ρ) ∧
         K.lowKnown p.2.1)))
  kc := K.kc
  pc := K.pc ∪ Finset.univ.filter (fun q : Fin n × Fin n =>
      (∃ ρ < τ, R.askedP ω (R.tag, 1, q.1) (R.pin2 ω q.1) ρ) ∧ q.1 ∈ K.tops)

/-- Enough passes to close: the number of items is at most `8 (n + 2)³`. -/
def vcIters (n : ℕ) : ℕ := 8 * (n + 2) ^ 3

/-- **The value closure `VC_τ` of a holding `H`**: `H` closed under the pair rule of the pairs revealed before `τ`,
the identities (a label is all its columns, a top key is all its components) and the `pin2` triples (`assemble`).
It is what the history of rounds `< τ` and the credits in `H` determine. -/
noncomputable def vc (τ : ℕ) (H : P3ChainKnow n) : P3ChainKnow n :=
  (fun K => (R.vcStep ω τ K).assemble R.G)^[vcIters n] (H.assemble R.G)

/-- **The online holding**: what each round shows and the history plus earlier credits do not determine (`VC`). -/
noncomputable def onlineH : ℕ → P3ChainKnow n
  | 0 => P3ChainKnow.empty
  | τ + 1 => (onlineH τ).union (P3ChainKnow.fresh (R.shownAt ω τ) (R.vc ω τ (onlineH τ)))

/-- The game knowledge at round `τ`, from the items that joined before `τ`. -/
noncomputable abbrev Kon (τ : ℕ) : P3ChainKnow n := P3ChainKnow.reach R.G (R.onlineH ω τ) τ

/-- The game knowledge at round `ρ`, including what round `ρ` shows. -/
noncomputable abbrev Ks (ρ : ℕ) : P3ChainKnow n := P3ChainKnow.reach R.G (R.onlineH ω (ρ + 1)) ρ

/-- What the history of rounds `< τ` and the credits so far determine. -/
noncomputable abbrev Vc (τ : ℕ) : P3ChainKnow n := R.vc ω τ (R.onlineH ω τ)

theorem onlineH_le_succ (τ : ℕ) : P3ChainKnow.Le (R.onlineH ω τ) (R.onlineH ω (τ + 1)) :=
  P3ChainKnow.le_union_left _ _

theorem onlineH_mono {τ τ' : ℕ} (h : τ ≤ τ') : P3ChainKnow.Le (R.onlineH ω τ) (R.onlineH ω τ') := by
  induction τ', h using Nat.le_induction with
  | base => exact P3ChainKnow.Le.rfl' _
  | succ τ' _ ih => exact ih.trans (R.onlineH_le_succ ω τ')

/-- Knowledge grows with the holding's round and the game's round. -/
theorem reach_le {τ τ' t t' : ℕ} (hτ : τ ≤ τ') (ht : t ≤ t') :
    P3ChainKnow.Le (P3ChainKnow.reach R.G (R.onlineH ω τ) t) (P3ChainKnow.reach R.G (R.onlineH ω τ') t') :=
  (P3ChainKnow.reach_mono R.G (R.onlineH_mono ω hτ) t).trans (P3ChainKnow.le_reach R.G _ ht)

/-- **Everything round `τ` shows is known at `τ`, once round `τ`'s fresh items have joined.** -/
theorem shown_le_of {τ : ℕ} (hK : P3ChainKnow.Le (R.Vc ω τ) (R.Ks ω τ)) :
    P3ChainKnow.Le (R.shownAt ω τ) (R.Ks ω τ) := by
  classical
  have hH : P3ChainKnow.Le (R.onlineH ω (τ + 1)) (R.Ks ω τ) :=
    (P3ChainKnow.le_assemble R.G _).trans (P3ChainKnow.le_reach R.G _ (Nat.zero_le τ))
  have hF : P3ChainKnow.Le (P3ChainKnow.fresh (R.shownAt ω τ) (R.Vc ω τ)) (R.Ks ω τ) :=
    (P3ChainKnow.le_union_right _ _).trans hH
  have hcols : (R.shownAt ω τ).cols ⊆ (R.Ks ω τ).cols := fun x hx => by
    by_cases hk : x ∈ (R.Vc ω τ).cols
    · exact hK.2.1 hk
    · exact hF.2.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  have hkc : (R.shownAt ω τ).kc ⊆ (R.Ks ω τ).kc := fun x hx => by
    by_cases hk : x ∈ (R.Vc ω τ).kc
    · exact hK.2.2.2.2.1 hk
    · by_cases hd : (x.2, x.1) ∈ (R.shownAt ω τ).cols ∧ x ∈ (R.Vc ω τ).pc
      · exact P3ChainKnow.reach_closed_kc R.G _ _ (hcols hd.1) (hK.2.2.2.2.2 hd.2)
      · exact hF.2.2.2.2.1 (Finset.mem_filter.2 ⟨Finset.mem_sdiff.2 ⟨hx, hk⟩, hd⟩)
  refine ⟨fun x hx => ?_, hcols, fun x hx => ?_, fun x hx => ?_, hkc, fun x hx => ?_⟩
  · by_cases hk : x ∈ (R.Vc ω τ).tops
    · exact hK.1 hk
    · exact hF.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  · by_cases hk : x ∈ (R.Vc ω τ).hs
    · exact hK.2.2.1 hk
    · exact hF.2.2.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  · by_cases hk : x ∈ (R.Vc ω τ).rs
    · exact hK.2.2.2.1 hk
    · exact hF.2.2.2.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  · by_cases hk : x ∈ (R.Vc ω τ).pc
    · exact hK.2.2.2.2.2 hk
    · by_cases hd : (x.2, x.1) ∈ (R.Vc ω τ).cols ∪ (R.shownAt ω τ).cols ∧ x ∈ (R.Vc ω τ).kc ∪ (R.shownAt ω τ).kc
      · have hc : (x.2, x.1) ∈ (R.Ks ω τ).cols := by
          rcases Finset.mem_union.1 hd.1 with h | h
          · exact hK.2.1 h
          · exact hcols h
        have hk' : x ∈ (R.Ks ω τ).kc := by
          rcases Finset.mem_union.1 hd.2 with h | h
          · exact hK.2.2.2.2.1 h
          · exact hkc h
        exact P3ChainKnow.reach_closed_pc R.G _ _ hc hk'
      · exact hF.2.2.2.2.2 (Finset.mem_filter.2 ⟨Finset.mem_sdiff.2 ⟨hx, hk⟩, hd⟩)


section Known

variable {R ω}

theorem ks_lab {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {L : Fin 2} {u : Fin n} (hs : R.showsLab ω (R.lab ω L u) ρ) : (R.Ks ω ρ).labKnown L u := by
  classical
  by_cases hL : L = 0
  · subst hL
    rw [labKnown_zero]
    exact fun x => hsl.2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hs⟩)
  · have hL1 : L = 1 := by fin_cases L <;> simp_all
    subst hL1
    rw [labKnown_one]
    exact hsl.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hs⟩)

theorem ks_h {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {L : Fin 2} {v : Fin n} {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ ovCalls R.G v)
    (hs : R.showsH ω (R.hval ω L v p) ρ) : (L, v, p) ∈ (R.Ks ω ρ).hs := by
  classical
  exact hsl.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, hs⟩)

/-- A shown dropped part is known one round later (a top row's pad `r` through its key components). -/
theorem ks_r {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {L : Fin 2} {v : Fin n} {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ ovCalls R.G v)
    (hs : R.showsR ω (R.rval ω L v p) ρ) : (L, v, p) ∈ ((R.Ks ω ρ).round R.G).rs := by
  classical
  by_cases htp : L = 1 ∧ p = ovCalls R.G v
  · obtain ⟨rfl, rfl⟩ := htp
    exact P3ChainKnow.key_of_kc R.G fun w =>
      hsl.2.2.2.2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hs⟩)
  · exact (P3ChainKnow.le_round R.G _).2.2.2.1
      (hsl.2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, Or.inl ⟨hs, htp⟩⟩))

theorem ks_keyLow {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {w : Fin n} (hs : R.showsPin ω (R.tag, 0, w) (R.pin1 ω w) ρ) :
    (R.Ks ω ρ).keyKnown R.G 0 w := by
  classical
  have h1 : 1 ≤ ovCalls R.G w := by unfold ovCalls; omega
  exact hsl.2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos le_rfl, h1, le_rfl, Or.inr ⟨rfl, rfl, hs⟩⟩)

theorem ks_pin2 {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ))
    {u : Fin n} (hs : R.showsPin ω (R.tag, 1, u) (R.pin2 ω u) ρ) :
    ∀ w, (u, w) ∈ (R.Ks ω ρ).pc := by
  classical
  exact fun w => hsl.2.2.2.2.2 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hs⟩)

end Known


/-- **The online simulation at round `ρ`**: a point revealed at `ρ` is known one round later. -/
def SimOn (ρ : ℕ) : Prop :=
  (∀ (L : Fin 2) (v : Fin n) (p : ℕ), 1 ≤ p → p ≤ ovCalls R.G v → R.askedS ω (R.xin ω L v p) ρ →
      (L, v, p) ∈ ((R.Ks ω ρ).round R.G).hs ∧ (L, v, p) ∈ ((R.Ks ω ρ).round R.G).rs) ∧
  (∀ w, R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ → ((R.Ks ω ρ).round R.G).lowKnown w) ∧
  (∀ u, R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ → u ∈ ((R.Ks ω ρ).round R.G).tops)

/-- **The simulation holds by construction**, with no induction: each reveal's inputs are shown in its own round. -/
theorem simOn_of {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ)) : R.SimOn ω ρ := by
  classical
  have hle := P3ChainKnow.le_round R.G (R.Ks ω ρ)
  refine ⟨?_, ?_, ?_⟩
  · intro L v p hp1 hp ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst hρ
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp only [revS, Option.some_inj] at hrev
      subst hrev
      have hcall : (R.Ks ω ρe).canCall R.G L v p := by
        refine ⟨hp1, hp, fun u hb => ks_lab hsl ⟨v', Or.inl ⟨_, he, rfl, ?_⟩⟩, ?_⟩
        · simp only [showLab, R.xin_ovR ω hb, Equiv.symm_apply_apply]
        · rcases Nat.lt_or_ge p 2 with h2 | h2
          · exact Or.inl (by omega)
          · refine Or.inr (ks_h hsl (p := p - 1) (by omega) (by omega) ⟨v', _, he, rfl, ?_⟩)
            have := R.xin_ovH ω (L := L) (v := v) (p := p - 1) (by omega) (by omega)
            rw [Nat.sub_add_cancel (by omega)] at this
            simp only [showH, this]
      exact ⟨(P3ChainKnow.mem_step_hs _ _ _ _ _).2 (Or.inr ⟨R.mem_pos hp, Or.inl hcall⟩),
        P3ChainKnow.round_rs_of_step _ ((P3ChainKnow.mem_step_rs _ _ _ _ _).2 (Or.inr ⟨R.mem_pos hp, Or.inl hcall⟩))⟩
    · simp only [revS, Option.some_inj] at hrev
      have hy : y = ω.2 (R.xin ω L v p) := by rw [← hrev, Equiv.apply_symm_apply]
      subst hy
      exact ⟨hle.2.2.1 (ks_h hsl hp1 hp ⟨v', _, he, rfl, by simp only [showH]; rfl⟩),
        ks_r hsl hp1 hp ⟨v', _, he, rfl, by simp only [showR]; rfl⟩⟩
    · simp [revS] at hrev
    · simp [revS] at hrev
  · intro w ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst hρ
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      exact fun x => P3ChainKnow.round_cols_of_step _
        ((P3ChainKnow.mem_step_cols _ _ _ _).2 (Or.inr (Or.inl (ks_keyLow hsl ⟨v', _, he, rfl, rfl⟩))))
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c1 ω w := by rw [R.c1_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      have := (labKnown_zero _ _).1 (ks_lab hsl (L := 0) ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩)
      exact fun x => hle.2.1 (this x)
  · intro u ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst hρ
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      exact (P3ChainKnow.mem_step_tops _ _ _).2 (Or.inr (Or.inr (Or.inr (ks_pin2 hsl ⟨v', _, he, rfl, rfl⟩))))
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c2 ω u := by rw [R.c2_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      exact hle.1 ((labKnown_one _ _).1 (ks_lab hsl (L := 1) ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩))

/-- **Both sides of a revealed pair are known one round later**: the input sides, next to `SimOn`'s outputs. -/
def SimBoth (ρ : ℕ) : Prop :=
  (∀ (L : Fin 2) (v : Fin n) (p : ℕ), 1 ≤ p → p ≤ ovCalls R.G v → R.askedS ω (R.xin ω L v p) ρ →
      (∀ u, ovBlock R.G v p = some u → ((R.Ks ω ρ).round R.G).labKnown L u) ∧
      (2 ≤ p → (L, v, p - 1) ∈ ((R.Ks ω ρ).round R.G).hs)) ∧
  (∀ w, R.askedP ω (R.tag, 0, w) (R.pin1 ω w) ρ → ((R.Ks ω ρ).round R.G).keyKnown R.G 0 w) ∧
  (∀ u, R.askedP ω (R.tag, 1, u) (R.pin2 ω u) ρ → ∀ w, (u, w) ∈ ((R.Ks ω ρ).round R.G).pc)

theorem simBoth_of {ρ : ℕ} (hsl : P3ChainKnow.Le (R.shownAt ω ρ) (R.Ks ω ρ)) : R.SimBoth ω ρ := by
  classical
  have hle := P3ChainKnow.le_round R.G (R.Ks ω ρ)
  refine ⟨?_, ?_, ?_⟩
  · intro L v p hp1 hp ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst ρe
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp only [revS, Option.some_inj] at hrev
      subst hrev
      refine ⟨fun u hb => hle.labKnown (ks_lab hsl ⟨v', Or.inl ⟨_, he, rfl, ?_⟩⟩), fun h2 => hle.2.2.1 ?_⟩
      · simp only [showLab, R.xin_ovR ω hb, Equiv.symm_apply_apply]
      · refine ks_h hsl (p := p - 1) (by omega) (by omega) ⟨v', _, he, rfl, ?_⟩
        have := R.xin_ovH ω (L := L) (v := v) (p := p - 1) (by omega) (by omega)
        rw [Nat.sub_add_cancel (by omega)] at this
        simp only [showH, this]
    · simp only [revS, Option.some_inj] at hrev
      have hy : y = ω.2 (R.xin ω L v p) := by rw [← hrev, Equiv.apply_symm_apply]
      subst hy
      have hh : (L, v, p) ∈ (R.Ks ω ρ).hs := ks_h hsl hp1 hp ⟨v', _, he, rfl, by simp only [showH]; rfl⟩
      have hr : (L, v, p) ∈ (R.Ks ω ρ).rs := by
        by_cases htp : L = 1 ∧ p = ovCalls R.G v
        · obtain ⟨rfl, rfl⟩ := htp
          obtain ⟨X, hX⟩ := P3ChainKnow.reach_asm R.G (R.onlineH ω (ρ + 1)) ρ
          have hk : ∀ w, (v, w) ∈ (X.assemble R.G).kc := fun w => by
            rw [← hX]
            exact hsl.2.2.2.2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, ⟨v', _, he, rfl, by simp only [showR]; rfl⟩⟩)
          have := P3ChainKnow.asm_key_of_kc R.G X hk
          rwa [← hX] at this
        · exact hsl.2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, Or.inl ⟨⟨v', _, he, rfl, by simp only [showR]; rfl⟩, htp⟩⟩)
      refine ⟨fun u hb => ?_, fun h2 => ?_⟩
      · have hst : ((R.Ks ω ρ).step R.G).labKnown L u := by
          by_cases hL : L = 0
          · subst hL
            rw [labKnown_zero]
            exact fun x => (P3ChainKnow.mem_step_cols _ _ _ _).2
              (Or.inr (Or.inr (Or.inr (Or.inl ⟨(0, v, p), hh, hr, rfl, hb⟩))))
          · have hL1 : L = 1 := by fin_cases L <;> simp_all
            subst hL1
            rw [labKnown_one]
            exact (P3ChainKnow.mem_step_tops _ _ _).2 (Or.inr (Or.inr (Or.inl ⟨(1, v, p), hh, hr, rfl, hb⟩)))
        exact (P3ChainKnow.le_assemble R.G _).labKnown hst
      · have hmem : (L, v, p - 1) ∈ ((R.Ks ω ρ).step R.G).hs := by
          refine (P3ChainKnow.mem_step_hs _ _ _ _ _).2 (Or.inr ⟨R.mem_pos (by omega), Or.inr ⟨by omega, ?_, ?_⟩⟩)
          · rwa [Nat.sub_add_cancel (by omega)]
          · rwa [Nat.sub_add_cancel (by omega)]
        exact (P3ChainKnow.le_assemble R.G _).2.2.1 hmem
    · simp [revS] at hrev
    · simp [revS] at hrev
  · intro w ⟨v', e, he, hρ, hrev⟩
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst ρe
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      exact hle.2.2.2.1 (ks_keyLow hsl ⟨v', _, he, rfl, rfl⟩)
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c1 ω w := by rw [R.c1_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      have hlow := (labKnown_zero _ _).1 (ks_lab hsl (L := 0) ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩)
      have h1 : 1 ≤ ovCalls R.G w := by unfold ovCalls; omega
      exact P3ChainKnow.round_rs_of_step _ ((P3ChainKnow.mem_step_rs _ _ _ _ _).2
        (Or.inr ⟨R.mem_pos le_rfl, Or.inr ⟨rfl, Or.inl ⟨rfl, hlow⟩⟩⟩))
  · intro u ⟨v', e, he, hρ, hrev⟩ w
    obtain ⟨ρe, q⟩ := e
    simp only at hρ
    subst ρe
    rcases q with (x | y) | ⟨T, a | z⟩
    · simp [revP] at hrev
    · simp [revP] at hrev
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, rfl⟩ := hrev
      exact hle.2.2.2.2.2 (ks_pin2 hsl ⟨v', _, he, rfl, rfl⟩ w)
    · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
      obtain ⟨rfl, hz⟩ := hrev
      have hz' : z = R.c2 ω u := by rw [R.c2_eq, ← hz, Equiv.apply_symm_apply]
      subst hz'
      have htop := (labKnown_one _ _).1 (ks_lab hsl (L := 1) ⟨v', Or.inl ⟨_, he, rfl, rfl⟩⟩)
      exact (P3ChainKnow.le_assemble R.G _).2.2.2.2.2 ((P3ChainKnow.mem_step_pc _ _ _ _).2 (Or.inr htop))

/-- **The value closure is inside the game.** Each pair it uses was revealed at some `ρ < τ`, and both its sides
are in the game at `ρ + 1 ≤ τ`; the closure is instantaneous in both. -/
theorem vc_le (τ : ℕ) (hsim : ∀ ρ < τ, R.SimOn ω ρ ∧ R.SimBoth ω ρ) : P3ChainKnow.Le (R.Vc ω τ) (R.Kon ω τ) := by
  classical
  have hup : ∀ {ρ : ℕ}, ρ < τ → P3ChainKnow.Le ((R.Ks ω ρ).round R.G) (R.Kon ω τ) := fun {ρ} hρ =>
    R.reach_le ω (τ := ρ + 1) (τ' := τ) (t := ρ + 1) (t' := τ) (by omega) (by omega)
  have hstep : ∀ K : P3ChainKnow n, P3ChainKnow.Le K (R.Kon ω τ) →
      P3ChainKnow.Le (R.vcStep ω τ K) (R.Kon ω τ) := by
    intro K hK
    refine ⟨fun u hu => ?_, fun q hq => ?_, fun p hp => ?_, fun p hp => ?_, fun q hq => hK.2.2.2.2.1 hq,
      fun q hq => ?_⟩
    · rcases Finset.mem_union.1 hu with hu | hu
      · exact hK.1 hu
      rcases (Finset.mem_filter.1 hu).2 with ⟨⟨ρ, hρ, ha⟩, _⟩ | ⟨p, _, _, hp1, hj1, hj, ⟨ρ, hρ, ha⟩, hb⟩
      · exact (hup hρ).1 ((hsim ρ hρ).1.2.2 u ha)
      · have := ((hsim ρ hρ).2.1 p.1 p.2.1 p.2.2 hj1 hj ha).1 u hb
        rw [hp1] at this
        exact (hup hρ).1 ((labKnown_one _ _).1 this)
    · obtain ⟨w, x⟩ := q
      rcases Finset.mem_union.1 hq with hq | hq
      · exact hK.2.1 hq
      rcases (Finset.mem_filter.1 hq).2 with ⟨⟨ρ, hρ, ha⟩, _⟩ | ⟨p, _, _, hp0, hj1, hj, ⟨ρ, hρ, ha⟩, hb⟩
      · exact (hup hρ).2.1 ((hsim ρ hρ).1.2.1 w ha x)
      · have := ((hsim ρ hρ).2.1 p.1 p.2.1 p.2.2 hj1 hj ha).1 w hb
        rw [hp0] at this
        exact (hup hρ).2.1 ((labKnown_zero _ _).1 this x)
    · obtain ⟨L, v, j⟩ := p
      rcases Finset.mem_union.1 hp with hp | hp
      · exact hK.2.2.1 hp
      obtain ⟨hj1, hj, h⟩ := (Finset.mem_filter.1 hp).2
      simp only at hj1 hj h
      rcases h with ⟨⟨ρ, hρ, ha⟩, _⟩ | ⟨hj2, ⟨ρ, hρ, ha⟩, _, _⟩
      · exact (hup hρ).2.2.1 ((hsim ρ hρ).1.1 L v j hj1 hj ha).1
      · have := ((hsim ρ hρ).2.1 L v (j + 1) (by omega) hj2 ha).2 (by omega)
        simp only [Nat.add_sub_cancel] at this
        exact (hup hρ).2.2.1 this
    · obtain ⟨L, v, j⟩ := p
      rcases Finset.mem_union.1 hp with hp | hp
      · exact hK.2.2.2.1 hp
      obtain ⟨hj1, hj, h⟩ := (Finset.mem_filter.1 hp).2
      rcases h with ⟨⟨ρ, hρ, ha⟩, _⟩ | ⟨hL, hjp, ⟨ρ, hρ, ha⟩, _⟩
      · exact (hup hρ).2.2.2.1 ((hsim ρ hρ).1.1 L v j hj1 hj ha).2
      · simp only at hL hjp
        subst hL; subst hjp
        exact (hup hρ).2.2.2.1 ((hsim ρ hρ).2.2.1 v ha)
    · obtain ⟨u, w⟩ := q
      rcases Finset.mem_union.1 hq with hq | hq
      · exact hK.2.2.2.2.2 hq
      obtain ⟨⟨ρ, hρ, ha⟩, _⟩ := (Finset.mem_filter.1 hq).2
      exact (hup hρ).2.2.2.2.2 ((hsim ρ hρ).2.2.2 u ha w)
  have hiter : ∀ k, P3ChainKnow.Le ((fun K => (R.vcStep ω τ K).assemble R.G)^[k]
      ((R.onlineH ω τ).assemble R.G)) (R.Kon ω τ) := by
    intro k
    induction k with
    | zero => exact P3ChainKnow.le_reach R.G _ (Nat.zero_le τ)
    | succ k ih =>
      rw [Function.iterate_succ_apply']
      exact (P3ChainKnow.assemble_mono R.G (hstep _ ih)).trans (P3ChainKnow.reach_asm_le R.G _ τ)
  exact hiter _

/-- **Everything round `τ` shows is known at `τ`, once round `τ`'s credits have joined** (strong induction on the
round, through `vc_le`). -/
theorem shown_le (τ : ℕ) : P3ChainKnow.Le (R.shownAt ω τ) (R.Ks ω τ) := by
  induction τ using Nat.strong_induction_on with
  | _ τ ih =>
    exact R.shown_le_of ω ((R.vc_le ω τ fun ρ hρ => ⟨R.simOn_of ω (ih ρ hρ), R.simBoth_of ω (ih ρ hρ)⟩).trans
      (R.reach_le ω (Nat.le_succ τ) le_rfl))


/-- **A correct output lies in the online reach at `D`.** -/
theorem mem_reach_of_correct_on (hA : ∀ i, (R.A i).Bounded R.D R.Q) (i : ι) (v : Fin n)
    (hv : (R.A i).run ((p3ChainModel n wc).answer ω) = R.c2 ω v) :
    v ∈ (P3ChainKnow.reach R.G (R.onlineH ω (R.D + 1)) R.D).tops := by
  have hd := (hA i ω).1
  have hs : R.showsLab ω (R.lab ω 1 v) ((R.A i).depth ((p3ChainModel n wc).answer ω)) := ⟨i, Or.inr ⟨hv, rfl⟩⟩
  exact (R.reach_le ω (by omega) hd).1 ((labKnown_one _ _).1 (ks_lab (R.shown_le ω _) hs))

/-- **A win forces an expensive online holding.** `out v` is the program answering challenge `v`. -/
theorem win_price_on (hA : ∀ i, (R.A i).Bounded R.D R.Q) (out : Fin n → ι) {c k X : ℕ}
    (hard : P3ChainHard R.G c wc R.D k X)
    (hk : k ≤ (Finset.univ.filter fun v => (R.A (out v)).run ((p3ChainModel n wc).answer ω) = R.c2 ω v).card) :
    (((k - X : ℕ) : ℚ) * n) ≤ (R.onlineH ω (R.D + 1)).size c wc := by
  classical
  refine hard _ (hk.trans (Finset.card_le_card fun v hv => ?_))
  exact R.mem_reach_of_correct_on ω hA (out v) v (Finset.mem_filter.1 hv).2


end P3Replay

end Pous.P3Concrete

end


/-! ════ Freshness.Timed ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousTimedGame

open Pous Pous.ColumnAware

variable {n : ℕ}

/-- Promotion (0 rounds): every lower label whose columns are all held becomes whole. -/
def promote (c : ColState n) : ColState n :=
  { c with lowerWhole := c.lowerWhole ∪ Finset.univ.filter fun w => ∀ u, (w, u) ∈ c.lowerCol }

/-- Reverse (1 round): column `u` of every lower label, for each known top `u` with known top parents. -/
def revCols (G : Labelling.TopoDAG n) (c : ColState n) : Finset (Fin n × Fin n) :=
  Finset.univ ×ˢ c.topWhole.filter fun u => G.par u ⊆ c.topWhole

/-- Round `1` before promotion: only the 1-round reverse, from round `0` (`b`). -/
def stepOne (G : Labelling.TopoDAG n) (b : ColState n) : ColState n where
  lowerWhole := b.lowerWhole
  lowerCol := b.lowerCol ∪ revCols G b
  topWhole := b.topWhole

/-- Round `t + 2` before promotion, from rounds `t` (`a`) and `t + 1` (`b`): reverse from `b` (1 round);
forward-lower from `a` (2 rounds: `H`, then `P`); forward-top with its columns from `b` (the `P` query) and its top
parents from `a` (the key `H` query, one round earlier). -/
def stepTwo (G : Labelling.TopoDAG n) (a b : ColState n) : ColState n where
  lowerWhole := b.lowerWhole ∪ Finset.univ.filter fun w => G.par w ⊆ a.lowerWhole
  lowerCol := b.lowerCol ∪ revCols G b
  topWhole := b.topWhole ∪ Finset.univ.filter fun u =>
    (∀ w, w ∈ b.lowerWhole ∨ (w, u) ∈ b.lowerCol) ∧ G.par u ⊆ a.topWhole

/-- The holding known after `t` oracle rounds from `c0`, every move at its real cost. -/
def timedReach (G : Labelling.TopoDAG n) (c0 : ColState n) : ℕ → ColState n
  | 0 => promote c0
  | 1 => promote (stepOne G (timedReach G c0 0))
  | t + 2 => promote (stepTwo G (timedReach G c0 t) (timedReach G c0 (t + 1)))

theorem mem_promote_lowerWhole {c : ColState n} {w : Fin n} :
    w ∈ (promote c).lowerWhole ↔ w ∈ c.lowerWhole ∨ ∀ u, (w, u) ∈ c.lowerCol := by
  simp [promote]


/-- The path `0 → 1`. -/
def path2 : Labelling.TopoDAG 2 where
  par v := Finset.univ.filter fun u : Fin 2 => (u : ℕ) + 1 = v
  par_lt v u h := by
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at h
    exact Fin.lt_def.2 (by omega)


end PousTimedGame

end


/-! ════ Freshness.Keyed ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousTimedGame

open Pous Pous.ColumnAware

variable {n : ℕ}

/-- Column `(w, u)` is available: `w` is whole, or the column is held. -/
abbrev avail (c : ColState n) (w u : Fin n) : Prop := w ∈ c.lowerWhole ∨ (w, u) ∈ c.lowerCol


/-- A holding with keys: `lowerKey` holds `k¹_w`, `topKey` holds `k²_u`. -/
structure KState (n : ℕ) where
  hold : ColState n
  lowerKey : Finset (Fin n)
  topKey : Finset (Fin n)

/-- Size in column units: each held key costs `n` (a whole label). -/
def KState.size (c : KState n) : ℕ := c.hold.size + n * c.lowerKey.card + n * c.topKey.card

/-- Reverse (1 round) at a known top whose top parents are known, or whose key is held. -/
def revColsK (G : Labelling.TopoDAG n) (K : Finset (Fin n)) (b : ColState n) : Finset (Fin n × Fin n) :=
  Finset.univ ×ˢ b.topWhole.filter fun u => G.par u ⊆ b.topWhole ∨ u ∈ K

/-- Round `1` before promotion: held lower keys give their labels, held top keys a forward-top from round-0
columns; reverse from round `0`. -/
def stepOneK (G : Labelling.TopoDAG n) (c : KState n) (b : ColState n) : ColState n where
  lowerWhole := b.lowerWhole ∪ c.lowerKey
  lowerCol := b.lowerCol ∪ revColsK G c.topKey b
  topWhole := b.topWhole ∪ c.topKey.filter fun u => ∀ w, avail b w u

/-- Round `t + 2` before promotion, from rounds `t` (`a`) and `t + 1` (`b`). -/
def stepTwoK (G : Labelling.TopoDAG n) (c : KState n) (a b : ColState n) : ColState n where
  lowerWhole := b.lowerWhole ∪ (Finset.univ.filter fun w => G.par w ⊆ a.lowerWhole) ∪ c.lowerKey
  lowerCol := b.lowerCol ∪ revColsK G c.topKey b
  topWhole := b.topWhole ∪ Finset.univ.filter fun u =>
    (∀ w, avail b w u) ∧ (G.par u ⊆ a.topWhole ∨ u ∈ c.topKey)

/-- The holding known after `t` oracle rounds from a keyed holding `c`, every move at its real cost. -/
def timedReachK (G : Labelling.TopoDAG n) (c : KState n) : ℕ → ColState n
  | 0 => promote c.hold
  | 1 => promote (stepOneK G c (timedReachK G c 0))
  | t + 2 => promote (stepTwoK G c (timedReachK G c t) (timedReachK G c (t + 1)))


end PousTimedGame

end


/-! ════ Freshness.Rounds ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousRounds

open Pous PousForwardCore

variable {M : IdealModel} {α : Type}

/-- The query batches of `p` answered by `f`, in round order. -/
def rounds (f : M.Qry → M.Ans) : OracleProg M α → List (List M.Qry)
  | .ret _ => []
  | .round qs k => qs :: rounds f (k (qs.map f))

theorem progTrace_eq_flatten (f : M.Qry → M.Ans) (p : OracleProg M α) : progTrace f p = (rounds f p).flatten := by
  induction p with
  | ret a => rfl
  | round qs k ih => simp [progTrace, rounds, ih]


/-- The queries of the first `t` rounds. -/
def upTo (f : M.Qry → M.Ans) (p : OracleProg M α) (t : ℕ) : List M.Qry := ((rounds f p).take t).flatten


end PousRounds

end


/-! ════ Freshness.KnowledgeSim ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds
open scoped ENNReal

variable {n wc : ℕ}


section Honest

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω)

/-- The honest lower labels `c¹` and top labels `c²`. -/
def c1 : Fin n → Lab n wc := c1T τ G ω.1 ω.2 W
def c2 : Fin n → Lab n wc := c2T τ G ω.1 ω.2 W

/-- The honest key inputs `(τ, ℓ, v, parents' labels)`, as `c1T`/`c2T` query them. -/
def hk1 (w : Fin n) : KQ' n wc := (τ, 0, w, fun v => if _h : v ∈ G.par w then some (c1 τ G W ω v) else none)
def hk2 (u : Fin n) : KQ' n wc := (τ, 1, u, fun v => if _h : v ∈ G.par u then some (c2 τ G W ω v) else none)

/-- The honest `P_t` inputs `x¹_w = W_w ⊕ k¹_w` and `x²_u ⊕ k²_u`. -/
def in1 (w : Fin n) : Lab n wc := labXor (W w) (ω.1 (hk1 τ G W ω w))
def in2 (u : Fin n) : Lab n wc := labXor (transpose (c1 τ G W ω) u) (ω.1 (hk2 τ G W ω u))

def qH1 (w : Fin n) : (p3ModelT n wc).Qry := Sum.inl (hk1 τ G W ω w)
def qH2 (u : Fin n) : (p3ModelT n wc).Qry := Sum.inl (hk2 τ G W ω u)
def qP1 (w : Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inl ((τ, 0, w), in1 τ G W ω w))
def qP2 (u : Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inl ((τ, 1, u), in2 τ G W ω u))
def qI1 (w : Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inr ((τ, 0, w), c1 τ G W ω w))
def qI2 (u : Fin n) : (p3ModelT n wc).Qry := Sum.inr (Sum.inr ((τ, 1, u), c2 τ G W ω u))

end Honest


section Trace

variable (ps : Fin n → OracleProg (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)

/-- Some challenge program sends `q` within its first `t` rounds. -/
def Asked (q : (p3ModelT n wc).Qry) (t : ℕ) : Prop :=
  ∃ c, q ∈ upTo ((p3ModelT n wc).answer ω) (ps c) t

/-- `q` is first asked (by any program) in round `r`. -/
def FirstAt (q : (p3ModelT n wc).Qry) (r : ℕ) : Prop :=
  Asked ps ω q r ∧ ¬ Asked ps ω q (r - 1)

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)


end Trace


end PousKnowledge

end


