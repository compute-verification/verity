theorem raise_aY (h : ¬ fI1 p τ G W ω w) : GRaises p τ G W D Q ω u w .aY := by
  have hc : c1a p τ G W ω w = .p1 := by classical unfold c1a; rw [if_neg h]
  refine graises_single p τ G W D Q ω u w .aY .vY (fun h' => absurd h' (vY_not_sampled p τ G W D ω u w))
    (fun r' hr' => ?_) ?_
