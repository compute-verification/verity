theorem bxor_bxor_cancel {w : ℕ} (a c : Bits w) : bxor a (bxor c a) = c := by
  funext b
  show xor (a b) (xor (c b) (a b)) = c b
  cases a b <;> cases c b <;> rfl

/-- On any DAG, labelling the decoding of `C` gives `C` back: block `i`'s label query sees the parents' labels, which
are `C`'s blocks by induction, so its key is the one decoding removed. -/
theorem label_dec {N w : ℕ} (G : TopoDAG N) (H : LabelQry N w → Bits w) (C : Fin N → Bits w) (i : Fin N) :
    label G (fun i => bxor (C i) (H (i, fun j => if j ∈ G.par i then some (C j) else none))) H i = C i := by
  suffices h : ∀ n, ∀ i : Fin N, i.val = n →
      label G (fun i => bxor (C i) (H (i, fun j => if j ∈ G.par i then some (C j) else none))) H i = C i from
    h _ i rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro i hi
    rw [PousB5Chain.label_eq]
    have hq : PousB5Chain.realQ G
        (fun i => bxor (C i) (H (i, fun j => if j ∈ G.par i then some (C j) else none))) H i =
        (i, fun j => if j ∈ G.par i then some (C j) else none) := by
      unfold PousB5Chain.realQ
      congr 1
      funext j
      split_ifs with hj
      · have hlt := G.par_lt i j hj
        rw [Fin.lt_def] at hlt
        rw [ih j.val (by omega) j rfl]
      · rfl
    rw [hq]
    exact bxor_bxor_cancel _ _

theorem denseScheme_encDec (B ℓ : ℕ) [NeZero B] : (Pous.Dense.denseScheme B ℓ).EncDec := by
  intro pp C H r
  refine Prod.ext (funext fun i => i.elim0) (funext fun i => ?_)
  show label (Pous.Dense.completeDAG B) ((codeEquiv B ℓ).symm (codeEquiv B ℓ _)) H i = C i
  rw [Equiv.symm_apply_apply]
  exact label_dec _ H C i

theorem segScheme_encDec (N B ℓ : ℕ) [NeZero (N * B)] : (Pous.DenseReCert.segScheme N B ℓ).EncDec := by
  intro pp C H r
  refine Prod.ext (funext fun i => i.elim0) (funext fun i => ?_)
  show label (Pous.DenseReCert.segDAG N B) ((codeEquiv (N * B) ℓ).symm (codeEquiv (N * B) ℓ _)) H i = C i
  rw [Equiv.symm_apply_apply]
  exact label_dec _ H C i

/-- Block `i` absorbs only the blocks before it. -/
theorem absorbed_congr {B ℓ : ℕ} {X Y : Fin B → Bits ℓ} (i : Fin B) (h : ∀ j : Fin B, j.val < i.val → X j = Y j) :
    Pous.Sponge.absorbed X i = Pous.Sponge.absorbed Y i := by
  unfold Pous.Sponge.absorbed Pous.Sponge.parentsNF
  congr 1
  congr 1
  funext j
  exact h _ (by show i.val - 1 - j.val < i.val; omega)

/-- Over the overwrite chain, labelling the decoding of `C` gives `C` back. -/
theorem labelOv_dec {B ℓ c : ℕ} (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (C : Fin B → Bits ℓ) (i : Fin B) :
    Pous.Sponge.labelOv f dom (fun i => bxor (C i) (Pous.Sponge.ovKey f (dom i) (Pous.Sponge.absorbed C i))) i =
      C i := by
  suffices h : ∀ n, ∀ i : Fin B, i.val = n →
      Pous.Sponge.labelOv f dom (fun i => bxor (C i) (Pous.Sponge.ovKey f (dom i) (Pous.Sponge.absorbed C i))) i =
        C i from h _ i rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro i hi
    rw [Pous.Sponge.labelOv_eq, absorbed_congr i fun j hj => ih j.val (by omega) j rfl]
    exact bxor_bxor_cancel _ _

theorem chainDense_encDec (B ℓ c : ℕ) [NeZero B] (dom : ℕ → Bits c) : (Pous.Sponge.chainDense B ℓ c dom).EncDec := by
  intro pp C π r
  refine Prod.ext (funext fun i => i.elim0) (funext fun i => ?_)
  show Pous.Sponge.labelOv _ dom ((codeEquiv B ℓ).symm (codeEquiv B ℓ _)) i = C i
  rw [Equiv.symm_apply_apply]
  exact labelOv_dec _ dom C i


/-- The first answers of a sequential audit do not depend on the later indices. -/
theorem seqAnswers_take_append {M : IdealModel} {ℓ S B : ℕ} (f : M.Qry → M.Ans)
    (step : ℕ → Bits S → Fin B → OracleProg M (Bits ℓ × Bits S)) :
    ∀ (j : ℕ) (l₁ l₂ : List (Fin B)) (σ : Bits S),
      (seqAnswers f step j (l₁ ++ l₂) σ).take l₁.length = seqAnswers f step j l₁ σ
  | _, [], _, _ => by simp [seqAnswers]
  | j, i :: is, l₂, σ => by
      simp only [List.cons_append, seqAnswers, List.length_cons, List.take_succ_cons]
      rw [seqAnswers_take_append f step (j + 1) is l₂]

/-- A uniform `k + j` indices, split into the first `k` and the rest. -/
def splitIdx (k j B : ℕ) : (Fin (k + j) → Fin B) ≃ (Fin k → Fin B) × (Fin j → Fin B) :=
  (Equiv.arrowCongr finSumFinEquiv.symm (Equiv.refl _)).trans (Equiv.sumArrowEquivProdArrow _ _ _)

theorem splitIdx_fst {k j B : ℕ} (I : Fin (k + j) → Fin B) :
    (splitIdx k j B I).1 = fun t => I (Fin.castAdd j t) := by
  funext t
  simp [splitIdx, Equiv.arrowCongr]

/-- An event of the first component of a relabelled sample space. -/
theorem pr_proj {α β γ : Type} [Fintype α] [Fintype β] [Fintype γ] [Nonempty γ] (e : α ≃ β × γ) (P : β → Prop) :
    pr (fun a => P (e a).1) = pr P :=
  (PousThm1Dense.pr_equiv e (fun y : β × γ => P y.1)).trans (PousThm1Dense.pr_fst P)

theorem auditSecure_seq_add {M : IdealModel} (sch : Scheme M) {S D Q k : ℕ} (j : ℕ) {δ ε : ℝ≥0∞}
    (h : AuditSecure sch .sequential S D Q k δ ε) : AuditSecure sch .sequential S D Q (k + j) δ ε := by
  intro W A₁ A₂
  refine le_trans ?_ (h W A₁ A₂)
  have hsub : ∀ x : Outcome sch (k + j), seqAccepts sch (k + j) W A₁ A₂ x →
      seqAccepts sch k W A₁ A₂ (x.1, x.2.1, fun t => x.2.2 (Fin.castAdd j t)) := by
    intro x hx
    simp only [seqAccepts] at hx ⊢
    have h1 := congrArg (List.take k) hx
    simp only [List.ofFn_add] at h1
    rw [List.take_left' List.length_ofFn] at h1
    have h2 := seqAnswers_take_append (M.answer x.1) (A₂.step W (sch.enc W x.1 x.2.1).1) 0
      (List.ofFn fun i : Fin k => x.2.2 (i.castLE (Nat.le_add_right k j)))
      (List.ofFn fun i : Fin j => x.2.2 (i.natAdd k))
      (A₁ W (sch.enc W x.1 x.2.1).1 (sch.enc W x.1 x.2.1).2 x.1)
    rw [List.length_ofFn] at h2
    exact h2.symm.trans h1
  have : Nonempty (Fin j → Fin sch.B) := ⟨fun _ => ⟨0, sch.B_pos⟩⟩
  let e : Outcome sch (k + j) ≃ Outcome sch k × (Fin j → Fin sch.B) :=
    ((Equiv.refl M.Ω).prodCongr ((Equiv.refl sch.Coins).prodCongr (splitIdx k j sch.B))).trans
      (((Equiv.refl M.Ω).prodCongr (Equiv.prodAssoc _ _ _).symm).trans (Equiv.prodAssoc _ _ _).symm)
  have he : ∀ x, (e x).1 = (x.1, x.2.1, fun t => x.2.2 (Fin.castAdd j t)) := by
    intro x
    simp only [e, Equiv.trans_apply, Equiv.prodCongr_apply, Equiv.coe_refl, Prod.map, id,
      Equiv.prodAssoc_symm_apply]
    rw [splitIdx_fst]
  calc pr (seqAccepts sch (k + j) W A₁ A₂)
      ≤ pr (fun x : Outcome sch (k + j) => seqAccepts sch k W A₁ A₂ (x.1, x.2.1, fun t => x.2.2 (Fin.castAdd j t))) :=
        pr_mono hsub
    _ = pr (fun x => seqAccepts sch k W A₁ A₂ (e x).1) := by simp only [he]
    _ = pr (seqAccepts sch k W A₁ A₂) := pr_proj e _

theorem meets_seq_add {M : IdealModel} (sch : Scheme M) {D Q k : ℕ} (j : ℕ) {ε : ℝ≥0∞}
    (h : Meets sch .sequential D Q k ε) : Meets sch .sequential D Q (k + j) ε :=
  ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, auditSecure_seq_add sch j h.2.2.2.2⟩


/-- The exact check's outcome is today's outcome with a `Unit` coordinate for the check's coins. -/
def dropUnit {M : IdealModel} (sch : Scheme M) (k : ℕ) : PubOutcome sch Unit k ≃ Outcome sch k :=
  (Equiv.refl M.Ω).prodCongr ((Equiv.refl sch.Coins).prodCongr (Equiv.uniqueProd (Fin k → Fin sch.B) Unit))

/-- The exact check accepts only the honest encoding: `dec pp C = W` and `EncDec` give `enc W = (pp, C)`. -/
theorem enc_eq_of_dec {M : IdealModel} {sch : Scheme M} (hed : sch.EncDec) {W : Bits sch.n} {pp : Bits sch.t}
    {C : sch.Code} {ω : M.Ω} (r : sch.Coins) (h : sch.dec pp C (M.answer ω) = W) : sch.enc W ω r = (pp, C) := by
  rw [← h]
  exact hed pp C ω r

theorem pubAuditSecure_exact {M : IdealModel} (sch : Scheme M) [Subsingleton sch.Coins] (hed : sch.EncDec)
    (reveal : Reveal) {S D Q k : ℕ} {δ ε : ℝ≥0∞} (h : AuditSecure sch reveal S D Q k δ ε) :
    PubAuditSecure sch (exactCheck sch) reveal S D Q k δ ε := by
  obtain ⟨r₀⟩ := (inferInstance : Nonempty sch.Coins)
  cases reveal with
  | simultaneous =>
    intro W E A₁ A₂
    refine le_trans ?_ (h W (fun W pp C ω => A₁ W pp C r₀ () ω) A₂)
    refine le_trans (pr_mono fun x hx => ?_) (le_of_eq (PousThm1Dense.pr_equiv (dropUnit sch k) _))
    obtain ⟨ω, r, ξ, I⟩ := x
    obtain ⟨hdec, hacc⟩ := hx
    have henc := enc_eq_of_dec hed r hdec
    cases ξ
    show simAccepts sch W _ A₂ (ω, r, I)
    simp only [simAccepts, henc]
    rw [Subsingleton.elim r₀ r]
    exact hacc
  | sequential =>
    intro W E A₁ A₂
    refine le_trans ?_ (h W (fun W pp C ω => A₁ W pp C r₀ () ω) A₂)
    refine le_trans (pr_mono fun x hx => ?_) (le_of_eq (PousThm1Dense.pr_equiv (dropUnit sch k) _))
    obtain ⟨ω, r, ξ, I⟩ := x
    obtain ⟨hdec, hacc⟩ := hx
    have henc := enc_eq_of_dec hed r hdec
    cases ξ
    show seqAccepts sch k W _ A₂ (ω, r, I)
    simp only [seqAccepts, henc]
    rw [Subsingleton.elim r₀ r]
    exact hacc

/-- With the exact check the public game is today's game, no weaker and no stronger. -/
theorem pubAuditSecure_exact_iff {M : IdealModel} (sch : Scheme M) [Subsingleton sch.Coins] (hc : sch.Correct)
    (hed : sch.EncDec) (reveal : Reveal) {S D Q k : ℕ} {δ ε : ℝ≥0∞} :
    PubAuditSecure sch (exactCheck sch) reveal S D Q k δ ε ↔ AuditSecure sch reveal S D Q k δ ε := by
  refine ⟨fun hpub => ?_, pubAuditSecure_exact sch hed reveal⟩
  cases reveal with
  | simultaneous =>
    intro W A₁ A₂
    refine le_trans ?_ (hpub W sch.enc (fun W pp C _ _ ω => A₁ W pp C ω) A₂)
    rw [← PousThm1Dense.pr_equiv (dropUnit sch k) (simAccepts sch W A₁ A₂)]
    refine pr_mono fun x hx => ?_
    obtain ⟨ω, r, ξ, I⟩ := x
    exact ⟨hc W ω r, hx⟩
  | sequential =>
    intro W A₁ A₂
    refine le_trans ?_ (hpub W sch.enc (fun W pp C _ _ ω => A₁ W pp C ω) A₂)
    rw [← PousThm1Dense.pr_equiv (dropUnit sch k) (seqAccepts sch k W A₁ A₂)]
    refine pr_mono fun x hx => ?_
    obtain ⟨ω, r, ξ, I⟩ := x
    exact ⟨hc W ω r, hx⟩

theorem pubMeets_exact {M : IdealModel} (sch : Scheme M) [Subsingleton sch.Coins] (hed : sch.EncDec)
    {reveal : Reveal} {D Q k : ℕ} {ε : ℝ≥0∞} (h : Meets sch reveal D Q k ε) :
    PubMeets sch (exactCheck sch) reveal D Q k ε :=
  ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, fun W ω r _ => h.2.1 W ω r, pubAuditSecure_exact sch hed reveal h.2.2.2.2⟩


instance instSubsingletonCoinsDenseScheme (B ℓ : ℕ) [NeZero B] : Subsingleton (Pous.Dense.denseScheme B ℓ).Coins := inferInstanceAs (Subsingleton Unit)

instance instSubsingletonCoinsSegScheme (N B ℓ : ℕ) [NeZero (N * B)] : Subsingleton (Pous.DenseReCert.segScheme N B ℓ).Coins :=
  inferInstanceAs (Subsingleton Unit)

instance instSubsingletonCoinsChainDense (B ℓ c : ℕ) [NeZero B] (dom : ℕ → Bits c) : Subsingleton (Pous.Sponge.chainDense B ℓ c dom).Coins :=
  inferInstanceAs (Subsingleton Unit)

/-- The trusted `Pous.Dense.denseScheme` is the dense file's `PousDenseChain.denseScheme`, verbatim. -/
theorem denseScheme_trusted (B ℓ : ℕ) [NeZero B] : PousDenseChain.denseScheme B ℓ = Pous.Dense.denseScheme B ℓ := rfl

theorem dense_pub_meets_64 : Pous.Pinned.DensePubMeets64 := by
  have h := meets_seq_add _ 5 Pous.DenseReCert.dense_meets_64
  rw [denseScheme_trusted] at h
  exact pubMeets_exact _ (denseScheme_encDec _ _) h

theorem seg_pub_meets_14 : SegPubMeets14 :=
  pubMeets_exact _ (segScheme_encDec _ _ _) (meets_seq_add _ 5 Pous.DenseReCert.seg_meets_14)

theorem chain_pub_meets_64 (hepf : Pous.Sponge.ChainExPostFacto) : ChainPubMeets64 := fun salt =>
  pubMeets_exact _ (chainDense_encDec _ _ _ _) (PousSpongeChain.chain_meets_64 hepf salt)


/-- A check that accepts everything. -/
def acceptAll {M : IdealModel} (sch : Scheme M) : SetupCheck sch where
  Ξ := Unit
  accepts _ _ _ _ _ := True


/-- The all-zero server, stateless zero responder. -/
def zeroSeq {M : IdealModel} (sch : Scheme M) (S D Q : ℕ) : SeqResponder sch S D Q where
  step _ _ _ σ _ := .ret ((fun _ => false), σ)
  bounded _ _ _ _ _ := ret_bounded _ _ _

theorem acceptAll_not_pubAuditSecure {M : IdealModel} (sch : Scheme M) (S D Q k : ℕ) {δ ε : ℝ≥0∞}
    (h : δ + ε < 1) : ¬ PubAuditSecure sch (acceptAll sch) .sequential S D Q k δ ε := by
  intro hsec
  have hone : pr (pubSeqAccepts sch (acceptAll sch) k (fun _ => false)
      (fun _ _ _ => ((fun _ => false), fun _ _ => false)) (fun _ _ _ _ _ _ => fun _ => false) (zeroSeq sch S D Q)) =
      1 :=
    pr_eq_one fun x => by
      refine ⟨trivial, ?_⟩
      simp only [zeroSeq]
      rw [seqAnswers_const _ (fun _ _ => fun _ => false), List.map_ofFn]
      rfl
  have := hsec (fun _ => false) (fun _ _ _ => ((fun _ => false), fun _ _ => false))
    (fun _ _ _ _ _ _ => fun _ => false) (zeroSeq sch S D Q)
  rw [hone] at this
  exact absurd (this.trans_lt h) (lt_irrefl 1)


/-- The hypothesis of `acceptAll_not_pubAuditSecure` holds at the problem statement's `δ = 1%`, `ε = 2^-128`: a check
that accepts everything fails the requirement there. -/
theorem acceptAll_hyp_witness : ENNReal.ofReal (Params.δ : ℝ) + (2⁻¹ : ℝ≥0∞) ^ 128 < 1 := by
  have hδ : ENNReal.ofReal (Params.δ : ℝ) < 2⁻¹ := by
    rw [ENNReal.ofReal_lt_iff_lt_toReal (by norm_num [Params.δ]) (by simp)]
    norm_num [Params.δ]
  have hε : (2⁻¹ : ℝ≥0∞) ^ 128 ≤ 2⁻¹ := pow_le_of_le_one (by norm_num) (by norm_num) (by norm_num)
  calc ENNReal.ofReal (Params.δ : ℝ) + (2⁻¹ : ℝ≥0∞) ^ 128 < 2⁻¹ + 2⁻¹ :=
        ENNReal.add_lt_add_of_lt_of_le (by simp) hδ hε
    _ = 1 := ENNReal.inv_two_add_inv_two

/-- So the deployed dense scheme with an accept-all check fails the public-encoder game. -/
theorem acceptAll_fails_dense (k : ℕ) :
    ¬ PubAuditSecure (Pous.Dense.denseScheme (2 ^ 9) 524288) (acceptAll _) .sequential
      ((Pous.Dense.denseScheme (2 ^ 9) 524288).stateBound Params.ρ) 5 (2 ^ 20) k (ENNReal.ofReal Params.δ)
      ((2⁻¹ : ℝ≥0∞) ^ 128) :=
  acceptAll_not_pubAuditSecure _ _ _ _ _ acceptAll_hyp_witness

end PousPub

end


/-! ════ BandEncDec ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace Pous.BandChain

open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal

section EncDec

variable {N ℓ c : ℕ}

/-- A row absorbs only its parents' blocks. -/
theorem absorbedG_congr (G : TopoDAG N) {X Y : Fin N → Bits ℓ} (v : Fin N) (h : ∀ u ∈ G.par v, X u = Y u) :
    absorbedG G X v = absorbedG G Y v := by
  unfold absorbedG
  congr 1
  exact List.map_congr_left fun u hu => h u ((Finset.mem_sort _).1 hu)

/-- **Labelling the decoding of `C` gives `C` back, on any DAG.** The port of `labelOv_dec` to `labelG`. -/
theorem labelG_dec (G : TopoDAG N) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (C : Fin N → Bits ℓ) (v : Fin N) :
    labelG G f dom (fun u => bxor (C u) (ovKey f (dom u) (absorbedG G C u))) v = C v := by
  induction v using WellFoundedLT.induction with
  | _ v ih =>
    rw [labelG_eq, absorbedG_congr G v fun u hu => ih u (G.par_lt v u hu), bxor_comm _ (bxor (C v) _),
      bxor_self_right]

/-- **Encode after decode for the overwrite-chain scheme on any DAG.** -/
theorem chainScheme_encDec {B : ℕ} [NeZero B] (G : TopoDAG B) (ℓ c : ℕ) (dom : ℕ → Bits c) :
    (chainScheme G ℓ c dom).EncDec := by
  intro pp C π r
  refine Prod.ext (funext fun i => i.elim0) (funext fun i => ?_)
  show labelG G _ dom ((codeEquiv B ℓ).symm (codeEquiv B ℓ _)) i = C i
  rw [Equiv.symm_apply_apply]
  exact labelG_dec G _ dom C i

/-- **`EncDec` for the band codec** (row B4). -/
theorem chainBand_encDec (B d ℓ c : ℕ) [NeZero B] (dom : ℕ → Bits c) : (chainBand B d ℓ c dom).EncDec :=
  chainScheme_encDec (bandDAG B d) ℓ c dom


end EncDec


end Pous.BandChain

end


