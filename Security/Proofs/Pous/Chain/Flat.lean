/-!
# Band v6 (c′): the fixed-pattern fibers

`v6_pattern_fibers : V6PatternFibers`. A fiber is "realizes the (c′) pattern with code `f`",
patterns of `n` names are coded into `Fin (card (Fin n → Name)) ⊆ range (M^n)`, and every winning
oracle realizes its own pattern. Small patterns pay `2·2^{-(ℓs+1)} = 2^{-ℓs}`, large ones
`2·2^{-ℓn}`, by `prob_realizes6_le`.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm
open Pous.BandChain.KeyRule
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

theorem realizedSeeds_card_le (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (R.realizedSeeds s π).card ≤ 2 * R.posSet.card := by
  classical
  have hsub : R.realizedSeeds s π ⊆ R.posSet.image VAtom.r ∪ R.posSet.image VAtom.h := by
    intro a ha
    have hv := R.realized_atom_valid s π ha
    rcases a with ⟨q⟩ | ⟨q⟩
    · exact Finset.mem_union_left _ (Finset.mem_image.2 ⟨q, hv, rfl⟩)
    · exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨q, hv, rfl⟩)
  calc (R.realizedSeeds s π).card
      ≤ (R.posSet.image VAtom.r ∪ R.posSet.image VAtom.h).card := Finset.card_le_card hsub
    _ ≤ (R.posSet.image VAtom.r).card + (R.posSet.image VAtom.h).card := Finset.card_union_le _ _
    _ ≤ R.posSet.card + R.posSet.card := Nat.add_le_add Finset.card_image_le Finset.card_image_le
    _ = 2 * R.posSet.card := by ring

theorem realizes6_card {hP : ∀ i, (R.P i).Bounded R.D R.Q} {s n : ℕ}
    {p : Fin n → Fin (nPos B R.Q) × R.V6SeedName} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hr : R.Realizes6 hP s ⟨List.ofFn p⟩ π) : (R.realizedSeeds s π).card = n := by
  obtain ⟨hcross, -, heq⟩ := hr
  have := congrArg (fun P : R.V6Pattern => P.names.length) heq
  simpa [realizedPattern6] using this

end ChainReplay

open ChainReplay in
/-- **The fixed-pattern fibers of the (c′) band attribution.** -/
theorem v6_pattern_fibers : V6PatternFibers := by
  classical
  intro B ℓ c s R hP hB hM
  let N := Fin (nPos B R.Q) × R.V6SeedName
  let enc : ∀ n, (Fin n → N) ≃ Fin (Fintype.card (Fin n → N)) := fun n => Fintype.equivFin _
  have hcardN : Fintype.card N ≤ R.v6M := R.card_v6_seed_names_large hB
  have hcardE : ∀ n, Fintype.card (Fin n → N) ≤ R.v6M ^ n := fun n => by
    rw [Fintype.card_fun, Fintype.card_fin]
    exact Nat.pow_le_pow_left hcardN n
  let E : ℕ → ℕ → Equiv.Perm (Bits (ℓ + (ℓ + c))) → Prop := fun n f π =>
    ∃ p : Fin n → N, ((enc n p : ℕ) = f) ∧ R.Realizes6 hP s ⟨List.ofFn p⟩ π
  have hn1 : 1 ≤ nPos B R.Q := by
    unfold nPos
    have : 1 ≤ B * (R.Q + 1) := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
    omega
  have hM2 : 2 ≤ R.v6M := by
    unfold ChainReplay.v6M
    have : 1 ≤ nPos B R.Q ^ 2 * B := Nat.mul_pos (pow_pos (by omega) 2) hB
    omega
  have hℓ : 1 ≤ ℓ := by
    by_contra h
    have : ℓ = 0 := by omega
    subst this
    simp at hM
    omega
  have hpop : 4 * nPos B R.Q ^ 2 ≤ 2 ^ ℓ ∨ (B = 1 ∧ 2 * nPos B R.Q ≤ 2 ^ ℓ) := by
    rcases Nat.lt_or_ge B 2 with hB1 | hB2
    · right
      refine ⟨by omega, ?_⟩
      have : B = 1 := by omega
      subst this
      unfold ChainReplay.v6M at hM
      have : nPos 1 R.Q ≤ nPos 1 R.Q ^ 2 := by nlinarith
      omega
    · left
      unfold ChainReplay.v6M at hM
      have : nPos B R.Q ^ 2 * 2 * 2 ≤ nPos B R.Q ^ 2 * B * 2 := by
        have := Nat.mul_le_mul_left (nPos B R.Q ^ 2) hB2
        omega
      omega
  -- the fiber of a code is at most the fiber of its pattern
  have hfiber : ∀ n f (β : ℝ≥0∞), (∀ p : Fin n → N, pr (R.Realizes6 hP s ⟨List.ofFn p⟩) ≤ β) →
      pr (E n f) ≤ β := by
    intro n f β hβ
    by_cases hex : ∃ p : Fin n → N, (enc n p : ℕ) = f
    · obtain ⟨p, hp⟩ := hex
      refine le_trans (pr_mono fun π hπ => ?_) (hβ p)
      obtain ⟨p', hp', hr⟩ := hπ
      have : p' = p := (enc n).injective (Fin.ext (hp'.trans hp.symm))
      rw [← this]
      exact hr
    · refine le_trans (pr_mono (Q := fun _ => False) fun π hπ => ?_) ?_
      · obtain ⟨p, hp, -⟩ := hπ
        exact hex ⟨p, hp⟩
      · rw [pr_def]; simp
  refine ⟨2 * R.posSet.card + 1, E, fun π ⟨hsize, hnc⟩ => ?_, fun n hn f _ => ?_,
    fun k _ f _ => ?_⟩
  · have hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut :=
      ⟨R.programSteps π, le_rfl, R.full_crosses_of_size_gt hℓ s π hsize⟩
    set n := (R.realizedSeeds s π).card with hn_def
    let p : Fin n → N := R.realizedName6 hP s π hcross
    have hE : E n (enc n p) π := ⟨p, rfl, hcross, hnc, rfl⟩
    have hf : (enc n p : ℕ) < R.v6M ^ n := lt_of_lt_of_le (enc n p).isLt (hcardE n)
    by_cases hsm : n < s + 2
    · exact Or.inl ⟨n, Finset.mem_range.2 hsm, _, Finset.mem_range.2 hf, hE⟩
    · right
      have hle := R.realizedSeeds_card_le s π
      refine ⟨n - (s + 2), Finset.mem_range.2 (by omega), (enc n p : ℕ), ?_, ?_⟩
      · rw [show s + 2 + (n - (s + 2)) = n by omega]
        exact Finset.mem_range.2 hf
      · rw [show s + 2 + (n - (s + 2)) = n by omega]
        exact hE
  · refine hfiber n f _ fun p => ?_
    refine (R.prob_realizes6_le hP s _ (ℓ * s + 1) (fun π hr => ?_) hpop).trans (le_of_eq ?_)
    · obtain ⟨hcross, -, -⟩ := hr
      exact R.realizedSeeds_width_gt s π hcross
    · rw [pow_succ, mul_comm _ (2⁻¹ : ℝ≥0∞), ← mul_assoc,
        ENNReal.mul_inv_cancel two_ne_zero ENNReal.ofNat_ne_top, one_mul, ENNReal.inv_pow,
        pow_mul]
      push_cast
      rw [ENNReal.inv_pow]
  · refine hfiber _ f _ fun p => ?_
    refine (R.prob_realizes6_le hP s _ (ℓ * (s + 2 + k)) (fun π hr => ?_) hpop).trans
      (le_of_eq ?_)
    · have hcard := R.realizes6_card hr
      have : ∑ a ∈ R.realizedSeeds s π, ℓ ≤ ∑ a ∈ R.realizedSeeds s π, atomWidth ℓ c a :=
        Finset.sum_le_sum fun a _ => by cases a <;> simp [atomWidth]
      simp only [Finset.sum_const, smul_eq_mul, hcard] at this
      rw [mul_comm]
      exact this
    · rw [pow_mul, ← ENNReal.inv_pow]
      push_cast
      rfl

end PousSpongeChain

end


