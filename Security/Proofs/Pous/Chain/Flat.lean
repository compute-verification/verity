/-! ════ P3Concrete.P3ChainLabeller ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge

section Labeller

variable {n wc : ℕ}

theorem lab_run_pbind {M : IdealModel} {X Y : Type} (f : M.Qry → M.Ans) (p : OracleProg M X) (g : X → OracleProg M Y) :
    (pbind p g).run f = (g (p.run f)).run f := by
  induction p with
  | ret x => rfl
  | round qs k ih => exact ih (qs.map f)

theorem lab_trace_pbind {M : IdealModel} {X Y : Type} (f : M.Qry → M.Ans) (p : OracleProg M X) (g : X → OracleProg M Y) :
    (Tr.trace f (pbind p g)).map Prod.snd = (Tr.trace f p).map Prod.snd ++ (Tr.trace f (g (p.run f))).map Prod.snd := by
  induction p with
  | ret x => rfl
  | round qs k ih =>
    show ((qs.map fun x => ((0 : ℕ), x)) ++ (Tr.trace f (pbind (k (qs.map f)) g)).map
        fun e : ℕ × M.Qry => (e.1 + 1, e.2)).map Prod.snd =
      ((qs.map fun x => ((0 : ℕ), x)) ++ (Tr.trace f (k (qs.map f))).map
        fun e : ℕ × M.Qry => (e.1 + 1, e.2)).map Prod.snd ++
        (Tr.trace f (g ((k (qs.map f)).run f))).map Prod.snd
    simp only [List.map_append, List.map_map]
    have e1 : (Prod.snd ∘ fun e : ℕ × M.Qry => (e.1 + 1, e.2)) = Prod.snd := rfl
    rw [e1, ih, List.append_assoc]

variable (ω : P3COmega n wc)

theorem ovStep_fold_eq (f : Bits (n * wc + (n * wc + 512)) → Bits (n * wc + (n * wc + 512)))
    (a a' : Bits (n * wc)) (h : Bits (n * wc + 512)) :
    ∀ l : List (Bits (n * wc)), l ≠ [] → l.foldl (ovStep f) (a, h) = l.foldl (ovStep f) (a', h)
  | [], hl => absurd rfl hl
  | _ :: _, _ => rfl

theorem ovStep_fold_snd (f : Bits (n * wc + (n * wc + 512)) → Bits (n * wc + (n * wc + 512)))
    (a a' : Bits (n * wc)) (h : Bits (n * wc + 512)) (l : List (Bits (n * wc))) :
    (l.foldl (ovStep f) (a, h)).2 = (l.foldl (ovStep f) (a', h)).2 := by
  rcases l with _ | ⟨b, l⟩
  · rfl
  · rw [ovStep_fold_eq f a a' h _ (List.cons_ne_nil b l)]

theorem xinAt_cons_one (f : Bits (n * wc + (n * wc + 512)) → Bits (n * wc + (n * wc + 512)))
    (h : Bits (n * wc + 512)) (b : Bits (n * wc)) (bs : List (Bits (n * wc))) :
    xinAt f h (b :: bs) 1 = Fin.append b h := rfl

theorem xinAt_cons_succ (f : Bits (n * wc + (n * wc + 512)) → Bits (n * wc + (n * wc + 512)))
    (h : Bits (n * wc + 512)) (b : Bits (n * wc)) (bs : List (Bits (n * wc))) (i : ℕ) :
    xinAt f h (b :: bs) (i + 2) = xinAt f (ovH (f (Fin.append b h))) bs (i + 1) := by
  unfold xinAt stAfter
  rw [show i + 2 - 1 = i + 1 by omega, show i + 1 - 1 = i by omega, List.getD_cons_succ, List.take_succ_cons,
    List.foldl_cons]
  congr 1
  exact ovStep_fold_snd f _ _ _ _

/-- **A chain's queries**: its calls' inputs, `xinAt` at `1, 2, …`. -/
theorem chain_trace : ∀ (bs : List (Bits (n * wc))) (h : Bits (n * wc + 512)) (r : Bits (n * wc)),
    (Tr.trace ((p3ChainModel n wc).answer ω) (chainProg h r bs)).map Prod.snd =
      (List.range bs.length).map fun i => (.inl (.inl (xinAt ω.2 h bs (i + 1))) : (p3ChainModel n wc).Qry)
  | [], _, _ => rfl
  | b :: bs, h, r => by
    have ih := chain_trace bs (ovH (ω.2 (Fin.append b h))) (ovR (ω.2 (Fin.append b h)))
    have h1 : (Tr.trace ((p3ChainModel n wc).answer ω) (p2Fwd (Fin.append b h))).map Prod.snd =
        [(.inl (.inl (Fin.append b h)) : (p3ChainModel n wc).Qry)] := rfl
    have h2 : (p2Fwd (Fin.append b h)).run ((p3ChainModel n wc).answer ω) = ω.2 (Fin.append b h) := rfl
    rw [chainProg, lab_trace_pbind, h1, h2, ih, List.length_cons, List.range_succ_eq_map, List.map_cons,
      List.map_map, xinAt_cons_one]
    refine congrArg (List.cons _) (List.map_congr_left fun i _ => ?_)
    exact congrArg (fun x => (.inl (.inl x) : (p3ChainModel n wc).Qry)) (xinAt_cons_succ ω.2 h b bs i).symm

/-- **A chain's result**: the dropped part of its last call. -/
theorem chain_run : ∀ (bs : List (Bits (n * wc))) (h : Bits (n * wc + 512)) (r : Bits (n * wc)), bs ≠ [] →
    (chainProg h r bs).run ((p3ChainModel n wc).answer ω) = ovR (ω.2 (xinAt ω.2 h bs bs.length))
  | [], _, _, hne => absurd rfl hne
  | [b], h, r, _ => by
    rw [chainProg, lab_run_pbind]
    rfl
  | b :: b' :: bs, h, r, _ => by
    rw [chainProg, lab_run_pbind]
    change (chainProg (ovH (ω.2 (Fin.append b h))) (ovR (ω.2 (Fin.append b h))) (b' :: bs)).run ((p3ChainModel n wc).answer ω) = _
    rw [chain_run (b' :: bs) _ _ (List.cons_ne_nil _ _)]
    simp only [List.length_cons]
    rw [show bs.length + 1 + 1 = bs.length + 2 by omega, xinAt_cons_succ]

/-- **A row's queries and label**: its chain inputs in order, then `P_(tag,L,v)` on `pinOf key`. -/
theorem row_spec (tag : Bits 256) (G : TopoDAG n) (L : Fin 2) (v : Fin n) (labs : Fin n → Lab n wc)
    (pinOf : Lab n wc → Lab n wc) :
    (Tr.trace ((p3ChainModel n wc).answer ω) (rowProg tag G L v labs pinOf)).map Prod.snd =
      (List.range (ovCalls G v)).map (fun i =>
        (.inl (.inl (xinAt ω.2 (iv (domP3 tag L v)) (rowBlocks labs G v) (i + 1))) : (p3ChainModel n wc).Qry)) ++
      [.inr ((tag, L, v), .inl (pinOf ((codeEquiv n wc).symm
        (ovR (ω.2 (xinAt ω.2 (iv (domP3 tag L v)) (rowBlocks labs G v) (ovCalls G v)))))))] ∧
    (rowProg tag G L v labs pinOf).run ((p3ChainModel n wc).answer ω) = ω.1 (tag, L, v) (pinOf ((codeEquiv n wc).symm
        (ovR (ω.2 (xinAt ω.2 (iv (domP3 tag L v)) (rowBlocks labs G v) (ovCalls G v)))))) := by
  have hne : rowBlocks labs G v ≠ [] := by simp [rowBlocks]
  have hrun := chain_run ω (rowBlocks labs G v) (iv (domP3 tag L v)) (fun _ => false) hne
  rw [rowBlocks_length] at hrun
  refine ⟨?_, ?_⟩
  · rw [rowProg, lab_trace_pbind, chain_trace, rowBlocks_length, hrun]
    rfl
  · rw [rowProg, lab_run_pbind, hrun]
    rfl

theorem rowBlocks_congr {lab lab' : Fin n → Lab n wc} (G : TopoDAG n) (v : Fin n)
    (h : ∀ u, u.val < v.val → lab u = lab' u) : rowBlocks lab G v = rowBlocks lab' G v := by
  unfold rowBlocks
  congr 1
  refine List.map_congr_left fun u hu => ?_
  rw [h u (G.par_lt v u ((Finset.mem_sort _).1 hu))]

variable {ι : Type} (R : P3Replay n wc ι)

/-- **A layer, from row `k` on, when the accumulated labels are honest below `k`.** Every later row's chain inputs
and `P` query are in the trace, and the result is the honest layer. The hypothesis `hpin` says that `pinOf` builds
the honest `P` input. -/
theorem layer_spec (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc)
    (hpin : ∀ v, ω.1 (R.tag, L, v) (pinOf v (R.key ω L v)) = R.lab ω L v) :
    ∀ (d k : ℕ), n - k = d → ∀ acc : Fin n → Lab n wc, (∀ u : Fin n, u.val < k → acc u = R.lab ω L u) →
      (∀ v : Fin n, k ≤ v.val →
        (∀ p, 1 ≤ p → p ≤ ovCalls R.G v →
          (.inl (.inl (R.xin ω L v p)) : (p3ChainModel n wc).Qry) ∈
            (Tr.trace ((p3ChainModel n wc).answer ω) (layerProg R.tag R.G L pinOf k acc)).map Prod.snd) ∧
        (.inr ((R.tag, L, v), .inl (pinOf v (R.key ω L v))) : (p3ChainModel n wc).Qry) ∈
            (Tr.trace ((p3ChainModel n wc).answer ω) (layerProg R.tag R.G L pinOf k acc)).map Prod.snd) ∧
      (layerProg R.tag R.G L pinOf k acc).run ((p3ChainModel n wc).answer ω) = R.lab ω L := by
  intro d
  induction d with
  | zero =>
    intro k hk acc hacc
    rw [layerProg_eq]
    split_ifs with hk'
    · omega
    · exact ⟨fun v hv => absurd v.isLt (by omega), funext fun u => hacc u (by omega)⟩
  | succ d ih =>
    intro k hk acc hacc
    have hkn : k < n := by omega
    rw [layerProg_eq, dite_eq_left_of_eq_true (eq_true hkn)]
    set vk : Fin n := ⟨k, hkn⟩
    have hrow := row_spec ω R.tag R.G L vk acc (pinOf vk)
    have hblk : rowBlocks acc R.G vk = rowBlocks (R.lab ω L) R.G vk :=
      rowBlocks_congr R.G vk fun u hu => hacc u hu
    have hkey : (codeEquiv n wc).symm (ovR (ω.2 (xinAt ω.2 (iv (domP3 R.tag L vk)) (rowBlocks (R.lab ω L) R.G vk)
        (ovCalls R.G vk)))) = R.key ω L vk := rfl
    rw [hblk, hkey] at hrow
    have hc : (rowProg R.tag R.G L vk acc (pinOf vk)).run ((p3ChainModel n wc).answer ω) = R.lab ω L vk := by rw [hrow.2, hpin]
    have hacc' : ∀ u : Fin n, u.val < k + 1 → Function.update acc vk ((rowProg R.tag R.G L vk acc (pinOf vk)).run ((p3ChainModel n wc).answer ω)) u
        = R.lab ω L u := by
      intro u hu
      by_cases huk : u = vk
      · rw [huk, Function.update_self, hc]
      · rw [Function.update_of_ne huk]
        exact hacc u (by
          have : u.val ≠ k := fun h => huk (Fin.ext h)
          omega)
    obtain ⟨ihq, ihr⟩ := ih (k + 1) (by omega) _ hacc'
    refine ⟨fun v hv => ?_, by rw [lab_run_pbind]; exact ihr⟩
    rw [lab_trace_pbind]
    by_cases hvk : v = vk
    · subst hvk
      rw [hrow.1]
      refine ⟨fun p hp1 hp => List.mem_append_left _ (List.mem_append_left _ (List.mem_map.2
        ⟨p - 1, List.mem_range.2 (by omega), ?_⟩)), List.mem_append_left _ (List.mem_append_right _
          (List.mem_singleton.2 rfl))⟩
      rw [Nat.sub_add_cancel hp1]
      rfl
    · have hv' : k + 1 ≤ v.val := by
        have : v.val ≠ k := fun h => hvk (Fin.ext h)
        omega
      exact ⟨fun p hp1 hp => List.mem_append_right _ ((ihq v hv').1 p hp1 hp),
        List.mem_append_right _ (ihq v hv').2⟩

/-- Row `v`'s labeller queries: its chain inputs in order, then its `P` query on `pinOf v key`. -/
noncomputable def rowQ (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc) (v : Fin n) :
    List (p3ChainModel n wc).Qry :=
  (List.range (ovCalls R.G v)).map (β := (p3ChainModel n wc).Qry) (fun i => .inl (.inl (R.xin ω L v (i + 1)))) ++
    ([.inr ((R.tag, L, v), .inl (pinOf v (R.key ω L v)))] : List (p3ChainModel n wc).Qry)

/-- **A layer's trace, exactly**: rows `k, k + 1, …` in order, each its chain then its `P` query. -/
theorem layer_trace (L : Fin 2) (pinOf : Fin n → Lab n wc → Lab n wc)
    (hpin : ∀ v, ω.1 (R.tag, L, v) (pinOf v (R.key ω L v)) = R.lab ω L v) :
    ∀ (d k : ℕ), n - k = d → ∀ acc : Fin n → Lab n wc, (∀ u : Fin n, u.val < k → acc u = R.lab ω L u) →
      (Tr.trace ((p3ChainModel n wc).answer ω) (layerProg R.tag R.G L pinOf k acc)).map Prod.snd =
        ((List.finRange n).drop k).flatMap (rowQ ω R L pinOf) := by
  intro d
  induction d with
  | zero =>
    intro k hk acc _
    rw [layerProg_eq]
    split_ifs with hk'
    · omega
    · rw [List.drop_eq_nil_of_le (by rw [List.length_finRange]; omega)]
      rfl
  | succ d ih =>
    intro k hk acc hacc
    have hkn : k < n := by omega
    rw [layerProg_eq, dite_eq_left_of_eq_true (eq_true hkn)]
    set vk : Fin n := ⟨k, hkn⟩
    have hrow := row_spec ω R.tag R.G L vk acc (pinOf vk)
    have hblk : rowBlocks acc R.G vk = rowBlocks (R.lab ω L) R.G vk :=
      rowBlocks_congr R.G vk fun u hu => hacc u hu
    have hkey : (codeEquiv n wc).symm (ovR (ω.2 (xinAt ω.2 (iv (domP3 R.tag L vk)) (rowBlocks (R.lab ω L) R.G vk)
        (ovCalls R.G vk)))) = R.key ω L vk := rfl
    rw [hblk, hkey] at hrow
    have hc : (rowProg R.tag R.G L vk acc (pinOf vk)).run ((p3ChainModel n wc).answer ω) = R.lab ω L vk := by
      rw [hrow.2, hpin]
    have hacc' : ∀ u : Fin n, u.val < k + 1 →
        Function.update acc vk ((rowProg R.tag R.G L vk acc (pinOf vk)).run ((p3ChainModel n wc).answer ω)) u
          = R.lab ω L u := by
      intro u hu
      by_cases huk : u = vk
      · rw [huk, Function.update_self, hc]
      · rw [Function.update_of_ne huk]
        exact hacc u (by
          have : u.val ≠ k := fun h => huk (Fin.ext h)
          omega)
    rw [lab_trace_pbind, hrow.1, ih (k + 1) (by omega) _ hacc']
    rw [List.drop_eq_getElem_cons (i := k) (l := List.finRange n) (by rw [List.length_finRange]; exact hkn),
      List.flatMap_cons]
    have hvk : (List.finRange n)[k]'(by rw [List.length_finRange]; exact hkn) = vk := by simp [vk]
    rw [hvk]
    rfl

/-- **The labeller's trace, exactly**: the lower rows in order, then the top rows. -/
theorem labProg_trace :
    (Tr.trace ((p3ChainModel n wc).answer ω) (labProg R.tag R.G R.W)).map Prod.snd =
      (List.finRange n).flatMap (rowQ ω R 0 fun v key => labXor (R.W v) key) ++
        (List.finRange n).flatMap (rowQ ω R 1 fun v key => labXor (transpose (R.c1 ω) v) key) := by
  have h0 := layer_spec ω R 0 (fun v key => labXor (R.W v) key)
    (fun v => (R.c1_eq ω v).symm) (n - 0) 0 rfl (fun _ _ _ => false) (fun u hu => absurd hu (by omega))
  have hc1 : (layerProg R.tag R.G 0 (fun v key => labXor (R.W v) key) 0 fun _ _ _ => false).run
      ((p3ChainModel n wc).answer ω) = R.c1 ω := h0.2
  have t0 := layer_trace ω R 0 (fun v key => labXor (R.W v) key) (fun v => (R.c1_eq ω v).symm) (n - 0) 0 rfl
    (fun _ _ _ => false) (fun u hu => absurd hu (by omega))
  have t1 := layer_trace ω R 1 (fun v key => labXor (transpose (R.c1 ω) v) key) (fun v => (R.c2_eq ω v).symm)
    (n - 0) 0 rfl (fun _ _ _ => false) (fun u hu => absurd hu (by omega))
  rw [labProg, lab_trace_pbind, hc1, lab_trace_pbind, t0, t1]
  simp [Tr.trace]

/-- **Every honest point is a forward query of the labeller**, against the true answers. -/
theorem labProg_honest :
    (∀ (L : Fin 2) (v : Fin n) (p : ℕ), 1 ≤ p → p ≤ ovCalls R.G v →
      (.inl (.inl (R.xin ω L v p)) : (p3ChainModel n wc).Qry) ∈ (Tr.trace ((p3ChainModel n wc).answer ω) (labProg R.tag R.G R.W)).map Prod.snd) ∧
    (∀ w, (.inr ((R.tag, 0, w), .inl (R.pin1 ω w)) : (p3ChainModel n wc).Qry) ∈
      (Tr.trace ((p3ChainModel n wc).answer ω) (labProg R.tag R.G R.W)).map Prod.snd) ∧
    (∀ u, (.inr ((R.tag, 1, u), .inl (R.pin2 ω u)) : (p3ChainModel n wc).Qry) ∈
      (Tr.trace ((p3ChainModel n wc).answer ω) (labProg R.tag R.G R.W)).map Prod.snd) := by
  have h0 := layer_spec ω R 0 (fun v key => labXor (R.W v) key)
    (fun v => (R.c1_eq ω v).symm) (n - 0) 0 rfl (fun _ _ _ => false) (fun u hu => absurd hu (by omega))
  have hc1 : (layerProg R.tag R.G 0 (fun v key => labXor (R.W v) key) 0 fun _ _ _ => false).run ((p3ChainModel n wc).answer ω) = R.c1 ω := h0.2
  have h1 := layer_spec ω R 1 (fun v key => labXor (transpose (R.c1 ω) v) key)
    (fun v => (R.c2_eq ω v).symm) (n - 0) 0 rfl (fun _ _ _ => false) (fun u hu => absurd hu (by omega))
  have htr : (Tr.trace ((p3ChainModel n wc).answer ω) (labProg R.tag R.G R.W)).map Prod.snd =
      (Tr.trace ((p3ChainModel n wc).answer ω) (layerProg R.tag R.G 0 (fun v key => labXor (R.W v) key) 0 fun _ _ _ => false)).map Prod.snd ++
      ((Tr.trace ((p3ChainModel n wc).answer ω) (layerProg R.tag R.G 1 (fun v key => labXor (transpose (R.c1 ω) v) key) 0
        fun _ _ _ => false)).map Prod.snd ++ []) := by
    rw [labProg, lab_trace_pbind, hc1, lab_trace_pbind]
    rfl
  rw [htr]
  refine ⟨fun L v p hp1 hp => ?_, fun w => List.mem_append_left _ ((h0.1 w (Nat.zero_le _)).2),
    fun u => List.mem_append_right _ (List.mem_append_left _ ((h1.1 u (Nat.zero_le _)).2))⟩
  fin_cases L
  · exact List.mem_append_left _ ((h0.1 v (Nat.zero_le _)).1 p hp1 hp)
  · exact List.mem_append_right _ (List.mem_append_left _ ((h1.1 v (Nat.zero_le _)).1 p hp1 hp))

end Labeller

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainDecide ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

section Decide

variable {n wc : ℕ} (R : P3Replay n wc (Fin n)) (π : Oracle (P3Alpha n wc))


/-- The honest points of a segment, as points of the family: `Π₂` chain inputs, then the two `P` inputs. -/
inductive HPt (n : ℕ) where
  | chain (L : Fin 2) (v : Fin n) (p : ℕ)
  | low (w : Fin n)
  | top (u : Fin n)

/-- A point's component. -/
def HPt.comp (tag : Bits 256) : HPt n → P3Idx n
  | .chain .. => .inr ()
  | .low w => .inl (tag, 0, w)
  | .top u => .inl (tag, 1, u)

/-- A point's value under `ω`. -/
noncomputable def HPt.val {ι : Type} (R : P3Replay n wc ι) (ω : P3COmega n wc) : (x : HPt n) → P3Alpha n wc (x.comp R.tag)
  | .chain L v p => R.xin ω L v p
  | .low w => R.pin1 ω w
  | .top u => R.pin2 ω u

/-- A point is a real honest pair: chain calls `1 ≤ p ≤ ovCalls G v`, and every `P` input. -/
def HPt.Valid (G : TopoDAG n) : HPt n → Prop
  | .chain _ v p => 1 ≤ p ∧ p ≤ ovCalls G v
  | _ => True

theorem trueAns_symm : trueAns π = (p3ChainModel n wc).answer ((omegaEquiv n wc).symm π) := by
  conv_lhs => rw [← (omegaEquiv n wc).apply_symm_apply π]
  exact trueAns_eq _


end Decide

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainCut ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge

/-- **A segment's replay with its schedule order**: the replay, and its threads in schedule order, each once. One
segment has threads `finRange n`; a segment of the 14 GB run has all `N·n` threads (`jointThreads N n`). -/
structure P3Seg (n wc : ℕ) (ι : Type) extends P3Replay n wc ι where
  ths : List ι
  hnodup : ths.Nodup
  hmem : ∀ i, i ∈ ths

namespace P3Seg

open P3Replay (showLab showH showR showPin)

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3Seg n wc ι) (ω : P3COmega n wc)

/-- Thread `v`'s round-`τ` queries, against the true answers. -/
noncomputable def rq (τ : ℕ) (v : ι) : List (p3ChainModel n wc).Qry :=
  (toRProg (R.A v)).roundQs ((p3ChainModel n wc).answer ω) τ

theorem mem_rq_iff {τ : ℕ} {v : ι} {q : (p3ChainModel n wc).Qry} :
    q ∈ R.rq ω τ v ↔ ∃ e ∈ R.tr ω v, e.1 = τ ∧ e.2 = q := by
  unfold rq
  rw [LazyPerm.RProg.roundQs_eq_trace, trace_toRProg]
  constructor
  · intro h
    obtain ⟨e, he, hq⟩ := List.mem_filterMap.1 h
    by_cases hτ : e.1 = τ
    · simp only [hτ, ite_true, Option.some_inj] at hq
      exact ⟨e, he, hτ, hq⟩
    · simp [hτ] at hq
  · rintro ⟨e, he, hτ, hq⟩
    exact List.mem_filterMap.2 ⟨e, he, by simp [hτ, hq]⟩

/-- Round `ρ`'s queries, threads in order: the schedule's round-`ρ` block. -/
noncomputable def rqAll (ρ : ℕ) : List (p3ChainModel n wc).Qry := R.ths.flatMap (R.rq ω ρ)

/-- **The step of thread `v`'s first round-`τ` query**: all earlier rounds, then the earlier threads of round `τ`. -/
noncomputable def off (τ : ℕ) (v : ι) : ℕ :=
  ((List.range τ).flatMap (R.rqAll ω)).length + ((R.ths.take (R.ths.idxOf v)).flatMap (R.rq ω τ)).length

/-- Round `τ` ends at the start of round `τ + 1`. -/
noncomputable def roundEnd (τ : ℕ) : ℕ := ((List.range (τ + 1)).flatMap (R.rqAll ω)).length

theorem ths_split (v : ι) :
    R.ths = R.ths.take (R.ths.idxOf v) ++ v :: R.ths.drop (R.ths.idxOf v + 1) := by
  have hlt : R.ths.idxOf v < R.ths.length := List.idxOf_lt_length_iff.2 (R.hmem v)
  have h : R.ths.drop (R.ths.idxOf v) = v :: R.ths.drop (R.ths.idxOf v + 1) := by
    rw [List.drop_eq_getElem_cons hlt, List.getElem_idxOf hlt]
  rw [← h, List.take_append_drop]

theorem rqAll_split (τ : ℕ) (v : ι) :
    R.rqAll ω τ = (R.ths.take (R.ths.idxOf v)).flatMap (R.rq ω τ) ++ R.rq ω τ v ++
      (R.ths.drop (R.ths.idxOf v + 1)).flatMap (R.rq ω τ) := by
  unfold rqAll
  conv_lhs => rw [R.ths_split v]
  rw [List.flatMap_append, List.flatMap_cons, List.append_assoc]


/-- Label `x` is shown at round `τ` before the cut `c`: by a query at a step `< c`, or as the output of a program
of depth `τ` once round `τ`'s queries are all before `c`. -/
def showsLabC (c : ℕ) (x : Lab n wc) (τ : ℕ) : Prop :=
  ∃ v, (∃ i, ∃ hi : i < (R.rq ω τ v).length, R.off ω τ v + i < c ∧ showLab (R.rq ω τ v)[i] = some x) ∨
    ((R.A v).run ((p3ChainModel n wc).answer ω) = x ∧ (R.A v).depth ((p3ChainModel n wc).answer ω) = τ ∧
      R.roundEnd ω τ ≤ c)

def showsHC (c : ℕ) (h : Bits (n * wc + 512)) (τ : ℕ) : Prop :=
  ∃ v, ∃ i, ∃ hi : i < (R.rq ω τ v).length, R.off ω τ v + i < c ∧ showH (R.rq ω τ v)[i] = some h

def showsRC (c : ℕ) (x : Bits (n * wc)) (τ : ℕ) : Prop :=
  ∃ v, ∃ i, ∃ hi : i < (R.rq ω τ v).length, R.off ω τ v + i < c ∧ showR (R.rq ω τ v)[i] = some x

def showsPinC (c : ℕ) (T : Tweak n) (a : Lab n wc) (τ : ℕ) : Prop :=
  ∃ v, ∃ i, ∃ hi : i < (R.rq ω τ v).length, R.off ω τ v + i < c ∧ showPin (R.rq ω τ v)[i] = some (T, a)

open Classical in
/-- **What round `τ` shows before the cut `c`**, as game items (`shownAt`, restricted). -/
noncomputable def shownAtC (c τ : ℕ) : P3ChainKnow n where
  tops := Finset.univ.filter fun u => R.showsLabC ω c (R.c2 ω u) τ
  cols := Finset.univ.filter fun q => R.showsLabC ω c (R.c1 ω q.1) τ
  hs := (P3ChainKnow.pos n).filter fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
    R.showsHC ω c (R.hval ω p.1 p.2.1 p.2.2) τ
  rs := (P3ChainKnow.pos n).filter fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
    ((R.showsRC ω c (R.rval ω p.1 p.2.1 p.2.2) τ ∧ ¬ (p.1 = 1 ∧ p.2.2 = ovCalls R.G p.2.1)) ∨
      (p.1 = 0 ∧ p.2.2 = ovCalls R.G p.2.1 ∧ R.showsPinC ω c (R.tag, 0, p.2.1) (R.pin1 ω p.2.1) τ))
  kc := Finset.univ.filter fun q => R.showsRC ω c (R.rval ω 1 q.1 (ovCalls R.G q.1)) τ
  pc := Finset.univ.filter fun q => R.showsPinC ω c (R.tag, 1, q.1) (R.pin2 ω q.1) τ

/-- **The cut holding**: `onlineH`'s recursion over the shows before the cut. -/
noncomputable def onlineHC (c : ℕ) : ℕ → P3ChainKnow n
  | 0 => P3ChainKnow.empty
  | τ + 1 => (onlineHC c τ).union (P3ChainKnow.fresh (R.shownAtC ω c τ) (R.vc ω τ (onlineHC c τ)))


/-- A program has no queries at rounds past its depth. -/
theorem roundQs_depth {M : IdealModel} {X : Type} (f : M.Qry → M.Ans) :
    ∀ (P : OracleProg M X) (ρ : ℕ), P.depth f ≤ ρ → (toRProg P).roundQs f ρ = []
  | .ret x, ρ, _ => LazyPerm.RProg.roundQs_ret f x ρ
  | .round qs k, 0, h => by simp [OracleProg.depth] at h
  | .round qs k, ρ + 1, h => by
    rw [LazyPerm.RProg.roundQs_succ]
    simp only [toRProg, LazyPerm.RProg.qs, LazyPerm.RProg.feed]
    exact roundQs_depth f (k (qs.map f)) ρ (by simp [OracleProg.depth] at h; omega)

/-- A thread's round-`τ` queries end by the end of round `τ`. -/
theorem off_add_lt (τ : ℕ) (v : ι) {i : ℕ} (hi : i < (R.rq ω τ v).length) :
    R.off ω τ v + i < R.roundEnd ω τ := by
  have hs := congrArg List.length (R.rqAll_split ω τ v)
  simp only [List.length_append] at hs
  unfold off roundEnd
  rw [List.range_succ, List.flatMap_append, List.length_append, List.flatMap_singleton]
  omega

theorem roundEnd_mono {τ τ' : ℕ} (h : τ ≤ τ') : R.roundEnd ω τ ≤ R.roundEnd ω τ' := by
  unfold roundEnd
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [show τ + d + 1 = (τ + 1) + d by omega, List.range_add (n := τ + 1) (m := d), List.flatMap_append, List.length_append]
  omega

/-- **Every position of a flat list of blocks is in some block.** -/
theorem flatMap_decode {α β : Type} (f : α → List β) :
    ∀ (l : List α) (d : ℕ), d < (l.flatMap f).length →
      ∃ k, ∃ hk : k < l.length, ∃ i < (f l[k]).length, d = ((l.take k).flatMap f).length + i
  | [], d, hd => by simp at hd
  | a :: l, d, hd => by
    rw [List.flatMap_cons, List.length_append] at hd
    rcases Nat.lt_or_ge d (f a).length with h | h
    · exact ⟨0, by simp, d, h, by simp⟩
    · obtain ⟨k, hk, i, hi, hdi⟩ := flatMap_decode f l (d - (f a).length) (by omega)
      refine ⟨k + 1, by simp; omega, i, by simpa using hi, ?_⟩
      rw [List.take_succ_cons, List.flatMap_cons, List.length_append]
      omega

/-- **Every program step is a thread's query**: step `d` of the schedule is thread `v`'s `i`-th round-`τ` query,
at `d = off τ v + i`, for some `τ < D`. -/
theorem sched_decode {d : ℕ}
    (hd : d < (LazyPerm.roundsSeq R.ths ((p3ChainModel n wc).answer ω) R.D
      (fun t => toRProg (R.A t))).length) :
    ∃ τ < R.D, ∃ v : ι, ∃ i < (R.rq ω τ v).length, d = R.off ω τ v + i := by
  rw [LazyPerm.roundsSeq_eq R.hnodup] at hd
  change d < ((List.range R.D).flatMap (R.rqAll ω)).length at hd
  obtain ⟨τ, hτ, j, hj, hdj⟩ := flatMap_decode (R.rqAll ω) (List.range R.D) d hd
  simp only [List.length_range] at hτ
  simp only [List.getElem_range] at hj
  obtain ⟨k, hk, i, hi, hji⟩ := flatMap_decode (R.rq ω τ) R.ths j hj
  refine ⟨τ, hτ, R.ths[k], i, hi, ?_⟩
  unfold off
  have e : R.ths.idxOf R.ths[k] = k := List.get_idxOf R.hnodup ⟨k, hk⟩
  rw [e, hdj, hji, List.take_range, min_eq_left hτ.le]
  simp only [Nat.add_assoc]

/-- **The schedule's step `off τ v + i` is thread `v`'s `i`-th round-`τ` query** (`τ < D`). -/
theorem roundsSeq_off {τ : ℕ} (hτ : τ < R.D) (v : ι) {i : ℕ} (hi : i < (R.rq ω τ v).length) :
    (LazyPerm.roundsSeq R.ths ((p3ChainModel n wc).answer ω) R.D (fun t => toRProg (R.A t)))[R.off ω τ v + i]?
      = some (R.rq ω τ v)[i] := by
  rw [LazyPerm.roundsSeq_eq R.hnodup]
  show ((List.range R.D).flatMap (R.rqAll ω))[R.off ω τ v + i]? = _
  have hD : List.range R.D = List.range τ ++ τ :: (List.range (R.D - (τ + 1))).map (τ + 1 + ·) := by
    rw [show R.D = (τ + 1) + (R.D - (τ + 1)) by omega, List.range_add, List.range_succ, List.append_assoc,
      List.singleton_append]
    simp
  rw [hD, List.flatMap_append, List.flatMap_cons, R.rqAll_split ω τ v]
  unfold off
  rw [List.getElem?_append_right (by omega), show ((List.range τ).flatMap (R.rqAll ω)).length +
      ((R.ths.take (R.ths.idxOf v)).flatMap (R.rq ω τ)).length + i - ((List.range τ).flatMap (R.rqAll ω)).length =
      ((R.ths.take (R.ths.idxOf v)).flatMap (R.rq ω τ)).length + i by omega, List.append_assoc,
    List.append_assoc, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left,
    List.getElem?_append_left hi, List.getElem?_eq_getElem hi]

/-- The last step of the program phase. -/
noncomputable def cutFull : ℕ := R.roundEnd ω R.D

/-- **The last step of the program phase is the schedule's length**: round `D` has no queries. -/
theorem cutFull_eq (hA : ∀ v, (R.A v).Bounded R.D R.Q) :
    R.cutFull ω = (LazyPerm.roundsSeq R.ths ((p3ChainModel n wc).answer ω) R.D (fun t => toRProg (R.A t))).length := by
  unfold cutFull roundEnd
  rw [List.range_succ, List.flatMap_append, List.flatMap_singleton, List.length_append]
  have h0 : R.rqAll ω R.D = [] := by
    unfold rqAll
    rw [List.flatMap_eq_nil_iff]
    intro v _
    unfold rq
    exact roundQs_depth _ _ _ ((hA v) ω).1
  rw [h0, List.length_nil, Nat.add_zero, LazyPerm.roundsSeq_eq R.hnodup]
  rfl

/-- **Past the last step, every show counts.** -/
theorem shownAtC_full (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c : ℕ} (hc : R.cutFull ω ≤ c) (τ : ℕ) :
    R.shownAtC ω c τ = R.toP3Replay.shownAt ω τ := by
  classical
  have hq : ∀ {v : ι} {q : (p3ChainModel n wc).Qry}, (∃ e ∈ R.tr ω v, e.1 = τ ∧ e.2 = q) →
      ∃ i, ∃ hi : i < (R.rq ω τ v).length, R.off ω τ v + i < c ∧ (R.rq ω τ v)[i] = q := by
    intro v q ⟨e, he, hτ, heq⟩
    have hmem : q ∈ R.rq ω τ v := (R.mem_rq_iff ω).2 ⟨e, he, hτ, heq⟩
    obtain ⟨i, hi, hiq⟩ := List.getElem_of_mem hmem
    have hd := Tr.round_lt_depth _ (R.A v) e he
    have hD := ((hA v) ω).1
    refine ⟨i, hi, ?_, hiq⟩
    exact (R.off_add_lt ω τ v hi).trans_le ((R.roundEnd_mono ω (by omega)).trans hc)
  have hq' : ∀ {v : ι} {i : ℕ} (hi : i < (R.rq ω τ v).length),
      ∃ e ∈ R.tr ω v, e.1 = τ ∧ e.2 = (R.rq ω τ v)[i] := fun hi => (R.mem_rq_iff ω).1 (List.getElem_mem hi)
  have hlab : ∀ x, R.showsLabC ω c x τ ↔ R.showsLab ω x τ := by
    intro x
    constructor
    · rintro ⟨v, ⟨i, hi, _, hx⟩ | ⟨hr, hd, _⟩⟩
      · obtain ⟨e, he, hτ, heq⟩ := hq' hi
        exact ⟨v, Or.inl ⟨e, he, hτ, by rw [heq]; exact hx⟩⟩
      · exact ⟨v, Or.inr ⟨hr, hd⟩⟩
    · rintro ⟨v, ⟨e, he, hτ, hx⟩ | ⟨hr, hd⟩⟩
      · obtain ⟨i, hi, hc', hiq⟩ := hq ⟨e, he, hτ, rfl⟩
        exact ⟨v, Or.inl ⟨i, hi, hc', by rw [hiq]; exact hx⟩⟩
      · refine ⟨v, Or.inr ⟨hr, hd, (R.roundEnd_mono ω ?_).trans hc⟩⟩
        rw [← hd]; exact ((hA v) ω).1
  have hgen : ∀ {β : Type} (sh : (p3ChainModel n wc).Qry → Option β) (x : β),
      (∃ v, ∃ i, ∃ hi : i < (R.rq ω τ v).length, R.off ω τ v + i < c ∧ sh (R.rq ω τ v)[i] = some x) ↔
      (∃ v, ∃ e ∈ R.tr ω v, e.1 = τ ∧ sh e.2 = some x) := by
    intro β sh x
    constructor
    · rintro ⟨v, i, hi, _, hx⟩
      obtain ⟨e, he, hτ, heq⟩ := hq' hi
      exact ⟨v, e, he, hτ, by rw [heq]; exact hx⟩
    · rintro ⟨v, e, he, hτ, hx⟩
      obtain ⟨i, hi, hc', hiq⟩ := hq ⟨e, he, hτ, rfl⟩
      exact ⟨v, i, hi, hc', by rw [hiq]; exact hx⟩
  have hH : ∀ h, R.showsHC ω c h τ ↔ R.showsH ω h τ := fun h => hgen showH h
  have hR : ∀ x, R.showsRC ω c x τ ↔ R.showsR ω x τ := fun x => hgen showR x
  have hP : ∀ T a, R.showsPinC ω c T a τ ↔ R.showsPin ω T a τ := fun T a => hgen showPin (T, a)
  simp only [shownAtC, P3Replay.shownAt, hlab, hH, hR, hP]

/-- **Past the last step, the cut holding is the online holding.** -/
theorem onlineHC_full (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c : ℕ} (hc : R.cutFull ω ≤ c) :
    ∀ τ, R.onlineHC ω c τ = R.toP3Replay.onlineH ω τ
  | 0 => rfl
  | τ + 1 => by
    rw [onlineHC, P3Replay.onlineH, onlineHC_full hA hc τ, R.shownAtC_full ω hA hc τ]

end P3Seg

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainTrunc ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

/-- **A segment with its labeller tail**: the tail program `tailP`, whose true trace holds the segment's labeller
queries as one block, `pre ++ labeller ++ post`. One segment's tail is its labeller (`pre = post = []`); a segment
of the 14 GB run has all `N` labellers (`labProgJ`), with the other segments' queries in `pre` and `post`. -/
structure P3SegT (n wc : ℕ) (ι : Type) extends P3Seg n wc ι where
  tailP : OracleProg (p3ChainModel n wc) Unit
  pre : P3COmega n wc → List (p3ChainModel n wc).Qry
  post : P3COmega n wc → List (p3ChainModel n wc).Qry
  hsplit : ∀ ω, (Tr.trace ((p3ChainModel n wc).answer ω) tailP).map Prod.snd =
    pre ω ++ (Tr.trace ((p3ChainModel n wc).answer ω) (labProg tag G W)).map Prod.snd ++ post ω

namespace P3SegT

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι)

/-- The untruncated strategy: the schedule, then the tail. -/
noncomputable def strat : Strategy (P3Alpha n wc) :=
  Strategy.ofRounds R.ths R.D (fun i => toRProg (R.A i)) (enc n wc) (dec n wc) (tailOf R.tailP)

/-- **The strategy truncated after `c` program steps**: the schedule, then the tail. -/
noncomputable def stratC (c : ℕ) : Strategy (P3Alpha n wc) where
  next h := if h.length < c then R.strat.next h else tailOf R.tailP h

variable (π : Oracle (P3Alpha n wc))

/-- The schedule against `π`. -/
noncomputable abbrev sched : List (p3ChainModel n wc).Qry :=
  roundsSeq R.ths (trueAns π) R.D (fun i => toRProg (R.A i))

/-- **Up to the cut, the truncated strategy's history is the full strategy's.** -/
theorem stratC_hist_le {c : ℕ} (hc : c ≤ (sched R π).length) :
    ∀ j ≤ c, (stratC R c).hist π j = R.strat.hist π j := by
  intro j
  induction j with
  | zero => intro _; rfl
  | succ j ih =>
    intro hj
    have ihj := ih (by omega)
    have hnext : (stratC R c).next ((stratC R c).hist π j) =
        R.strat.next (R.strat.hist π j) := by
      rw [ihj]
      have hlen : (R.strat.hist π j).length = j := by
        unfold strat
        rw [Strategy.ofRounds_hist _ _ _ _ _ _ π j (le_trans (by omega) hc), List.length_map, List.length_take]
        exact min_eq_left (le_trans (by omega) hc)
      show (if _ < c then _ else _) = _
      simp only [hlen, show j < c by omega, ↓reduceIte]
    cases hq : R.strat.next (R.strat.hist π j) with
    | none =>
      rw [Strategy.hist_succ_of_none _ (hnext.trans hq), Strategy.hist_succ_of_none _ hq, ihj]
    | some q =>
      rw [Strategy.hist_succ_of_some _ (hnext.trans hq), Strategy.hist_succ_of_some _ hq, ihj]

theorem stratC_hist_c {c : ℕ} (hc : c ≤ (sched R π).length) :
    (stratC R c).hist π c = ((sched R π).take c).map (qEntry π (enc n wc)) := by
  rw [stratC_hist_le R π hc c le_rfl]
  exact Strategy.ofRounds_hist _ _ _ _ _ _ π c hc

/-- **After the cut, the tail chooses.** -/
theorem stratC_next_tail {c : ℕ} {h : History (P3Alpha n wc)} (hh : c ≤ h.length) :
    (stratC R c).next h = tailOf R.tailP h := by
  show (if _ < c then _ else _) = _
  simp only [show ¬ h.length < c by omega, ↓reduceIte]

/-- The labeller's queries against `π`. -/
noncomputable abbrev labT : List (p3ChainModel n wc).Qry :=
  (Tr.trace (trueAns π) R.tailP).map Prod.snd

/-- **After the cut, the history is the schedule's prefix and new labeller queries.** -/
theorem stratC_inv {c : ℕ} (hc : c ≤ (sched R π).length) :
    ∀ j, c ≤ j → ∃ tq : List (p3ChainModel n wc).Qry, tq.Nodup ∧ (∀ q ∈ tq, q ∈ labT R π) ∧
      (stratC R c).hist π j = ((sched R π).take c ++ tq).map (qEntry π (enc n wc)) := by
  intro j hj
  induction j, hj using Nat.le_induction with
  | base => exact ⟨[], List.nodup_nil, fun q hq => absurd hq (List.not_mem_nil), by
      rw [List.append_nil]; exact stratC_hist_c R π hc⟩
  | succ j hcj ih =>
    obtain ⟨tq, hnd, hsub, hh⟩ := ih
    set S := stratC R c
    cases hnext : S.next (S.hist π j) with
    | none => exact ⟨tq, hnd, hsub, by rw [S.hist_succ_of_none hnext, hh]⟩
    | some x =>
      have hlen : c ≤ (S.hist π j).length := by
        rw [hh, List.length_map, List.length_append, List.length_take]
        omega
      have htail := stratC_next_tail R hlen
      rw [htail] at hnext
      obtain ⟨q, rfl, hqT, hnew⟩ := tailOf_some R.tailP (S.hist π j) (fun e he => S.mem_hist he) hnext
      have hqtq : q ∉ tq := by
        intro hq
        have hmem : qEntry π (enc n wc) q ∈ S.hist π j := by
          rw [hh, List.map_append]
          exact List.mem_append_right _ (List.mem_map_of_mem hq)
        exact (histAns_none_iff _ _).1 hnew _ hmem rfl
      refine ⟨tq ++ [q], hnd.append (List.nodup_singleton q) (List.disjoint_singleton.2 hqtq), fun q' hq' => ?_, ?_⟩
      · rcases List.mem_append.1 hq' with h1 | h1
        · exact hsub q' h1
        · rw [List.mem_singleton.1 h1]; exact hqT
      · rw [S.hist_succ_of_some (by rw [htail]; exact hnext), hh]
        simp only [List.map_append, List.map_cons, List.map_nil, List.append_assoc]
        rfl

/-- **The truncated history has at most `c + work(labProg)` entries.** -/
theorem stratC_length_le {c : ℕ} (hc : c ≤ (sched R π).length) (j : ℕ) :
    ((stratC R c).hist π j).length ≤ c + R.tailP.work (trueAns π) := by
  classical
  rcases Nat.lt_or_ge j c with hj | hj
  · exact ((stratC R c).hist_length_le π j).trans (by omega)
  obtain ⟨tq, hnd, hsub, hh⟩ := stratC_inv R π hc j hj
  rw [hh, List.length_map, List.length_append, List.length_take]
  have hle : tq.length ≤ (labT R π).length := by
    rw [← List.toFinset_card_of_nodup hnd]
    exact (Finset.card_le_card fun q hq => List.mem_toFinset.2 (hsub q (List.mem_toFinset.1 hq))).trans
      (List.toFinset_card_le _)
  have hT : (labT R π).length = R.tailP.work (trueAns π) := by
    rw [List.length_map, Tr.length_trace]
  omega

/-- **Completion**: by step `c + work(labProg)` the history holds every labeller query. -/
theorem stratC_complete {c : ℕ} (hc : c ≤ (sched R π).length) :
    ∀ q ∈ labT R π, ∃ e ∈ (stratC R c).hist π (c + R.tailP.work (trueAns π)),
      e.1 = enc n wc q := by
  have hlen : c ≤ ((stratC R c).hist π (c + R.tailP.work (trueAns π))).length := by
    obtain ⟨tq, _, _, hh⟩ := stratC_inv R π hc (c + R.tailP.work (trueAns π)) (by omega)
    rw [hh, List.length_map, List.length_append, List.length_take]
    omega
  set S := stratC R c
  set L := c + R.tailP.work (trueAns π)
  set h := S.hist π L
  have hstop : S.next h = none := by
    cases hq : S.next h with
    | none => rfl
    | some q => exact absurd (step_lt_of_length_le _ π _ (stratC_length_le R π hc) hq) (lt_irrefl _)
  rw [stratC_next_tail R hlen] at hstop
  unfold tailOf at hstop
  rw [Option.map_eq_none_iff, List.find?_eq_none] at hstop
  have hcons : ∀ e ∈ h, e.2 = ans π e.1 := fun e he => S.mem_hist he
  have hin : ∀ q ∈ (Tr.trace (ansOf h) R.tailP).map Prod.snd, (histAns h (enc n wc q)).isNone = false :=
    fun q hq => Bool.eq_false_iff.2 (hstop q hq)
  have hagree : Tr.AgreeBefore (ansOf h) (trueAns π) R.tailP
      (((Tr.trace (trueAns π) R.tailP).map Prod.fst).sum) :=
    fun e he _ => ansOf_eq h hcons (hin e.2 (List.mem_map_of_mem he))
  intro q hq
  obtain ⟨e, he, rfl⟩ := List.mem_map.1 hq
  have he' := (Tr.trace_stable (ansOf h) (trueAns π) R.tailP _ hagree).2 e he
    (List.le_sum_of_mem (List.mem_map_of_mem he))
  have hne := hin e.2 (List.mem_map_of_mem he')
  cases hh : histAns h (enc n wc e.2) with
  | none => rw [hh] at hne; simp at hne
  | some a =>
    by_contra hall
    push Not at hall
    rw [(histAns_none_iff h _).2 hall] at hh
    exact absurd hh (by simp)

/-- **By the end of the truncated run, the history fixes every honest point.** -/
theorem honest_fixed_C {c : ℕ} (hc : c ≤ (sched R π).length) (x : HPt n) (hx : x.Valid R.G) :
    x.val R.toP3Replay ((omegaEquiv n wc).symm π) ∈
      ((stratC R c).hist π (c + R.tailP.work (trueAns π))).dom (x.comp R.tag) := by
  have hL := labProg_honest ((omegaEquiv n wc).symm π) R.toP3Replay
  rw [← trueAns_symm] at hL
  have hsub : ∀ q ∈ (Tr.trace (trueAns π) (labProg R.tag R.G R.W)).map Prod.snd, q ∈ labT R π := by
    intro q hq
    have e := R.hsplit ((omegaEquiv n wc).symm π)
    rw [← trueAns_symm] at e
    show q ∈ (Tr.trace (trueAns π) R.tailP).map Prod.snd
    rw [e]
    exact List.mem_append_left _ (List.mem_append_right _ hq)
  have key := fun q hq => stratC_complete R π hc q (hsub q hq)
  rcases x with ⟨L, v, p⟩ | w | u
  · obtain ⟨e, he, heq⟩ := key _ (hL.1 L v p hx.1 hx.2)
    refine History.mem_dom.2 ⟨e, he, ?_⟩
    obtain ⟨⟨k, d⟩, a⟩ := e
    simp only [enc] at heq
    obtain ⟨rfl, hd⟩ := Sigma.mk.inj_iff.1 heq
    rw [heq_eq_eq] at hd
    subst hd
    rfl
  · obtain ⟨e, he, heq⟩ := key _ (hL.2.1 w)
    refine History.mem_dom.2 ⟨e, he, ?_⟩
    obtain ⟨⟨k, d⟩, a⟩ := e
    simp only [enc] at heq
    obtain ⟨rfl, hd⟩ := Sigma.mk.inj_iff.1 heq
    rw [heq_eq_eq] at hd
    subst hd
    simp [Entry.inpAt, Entry.inp, HPt.comp, HPt.val]
  · obtain ⟨e, he, heq⟩ := key _ (hL.2.2 u)
    refine History.mem_dom.2 ⟨e, he, ?_⟩
    obtain ⟨⟨k, d⟩, a⟩ := e
    simp only [enc] at heq
    obtain ⟨rfl, hd⟩ := Sigma.mk.inj_iff.1 heq
    rw [heq_eq_eq] at hd
    subst hd
    simp [Entry.inpAt, Entry.inp, HPt.comp, HPt.val]


end P3SegT

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainStepVC ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge

namespace P3Replay

section Values

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι)

theorem append_ovR_ovH {r c : ℕ} (x : Bits (r + (r + c))) : Fin.append (ovR x) (ovH x) = x := by
  funext j
  refine Fin.addCases (fun i => ?_) (fun i => ?_) j
  · rw [Fin.append_left]; rfl
  · rw [Fin.append_right]; rfl

theorem rowBlocks_getD_pad (lab : Fin n → Lab n wc) (G : TopoDAG n) (v : Fin n) {p : ℕ}
    (hb : ovBlock G v p = none) : (rowBlocks lab G v).getD (p - 1) padBlk = padBlk := by
  unfold ovBlock at hb
  have hge : (parentsDesc G v).length ≤ p - 1 := by
    by_contra h
    rw [List.getElem?_eq_getElem (by omega)] at hb
    exact absurd hb (by simp)
  unfold rowBlocks
  rcases Nat.lt_or_ge (p - 1) ((parentsDesc G v).map (fun u => codeEquiv n wc (lab u)) ++ [padBlk]).length with h | h
  · rw [getD_of_lt _ _ h, List.getElem_append_right (by simpa using hge)]
    simp
  · rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none h, Option.getD_none]

/-- **A chain point is determined by its block's label and the previous chaining value.** -/
theorem xin_congr (ω ω' : P3COmega n wc) {L : Fin 2} {v : Fin n} {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ ovCalls R.G v)
    (hb : ∀ u, ovBlock R.G v p = some u → R.lab ω L u = R.lab ω' L u)
    (hh : 2 ≤ p → R.hval ω L v (p - 1) = R.hval ω' L v (p - 1)) :
    R.xin ω L v p = R.xin ω' L v p := by
  rw [← append_ovR_ovH (R.xin ω L v p), ← append_ovR_ovH (R.xin ω' L v p)]
  congr 1
  · unfold P3Replay.xin
    rw [xinAt_ovR, xinAt_ovR]
    cases hbo : ovBlock R.G v p with
    | none => rw [rowBlocks_getD_pad _ _ _ hbo, rowBlocks_getD_pad _ _ _ hbo]
    | some u => rw [rowBlocks_getD _ _ _ hbo, rowBlocks_getD _ _ _ hbo, hb u hbo]
  · rcases Nat.lt_or_ge p 2 with h2 | h2
    · have : p = 1 := by omega
      subst this
      unfold P3Replay.xin xinAt
      rw [ovH_append, ovH_append]
      rfl
    · have h1 := R.xin_ovH ω (L := L) (v := v) (p := p - 1) (by omega) (by omega)
      have h1' := R.xin_ovH ω' (L := L) (v := v) (p := p - 1) (by omega) (by omega)
      rw [Nat.sub_add_cancel (by omega)] at h1 h1'
      rw [h1, h1', hh h2]

/-- The `pin2` identity, component by component: `pin2_u(w) = c¹_w(u) ⊕ key²_u(w)`. -/
theorem pin2_apply (ω : P3COmega n wc) (u w : Fin n) :
    R.pin2 ω u w = bxor (R.c1 ω w u) (R.key ω 1 u w) := rfl

theorem bxor_cancel_left {m : ℕ} (a b : Bits m) : bxor a (bxor a b) = b := by
  funext j; simp [bxor]

theorem bxor_eq_iff_right {m : ℕ} {a b c d : Bits m} (hac : a = c) (h : bxor a b = bxor c d) : b = d := by
  subst hac
  have := congrArg (bxor a) h
  rwa [bxor_cancel_left, bxor_cancel_left] at this

theorem bxor_comm {m : ℕ} (a b : Bits m) : bxor a b = bxor b a := by
  funext j; simp [bxor, Bool.xor_comm]

theorem bxor_eq_iff_left {m : ℕ} {a b c d : Bits m} (hbd : b = d) (h : bxor a b = bxor c d) : a = c := by
  subst hbd
  rw [bxor_comm a b, bxor_comm c b] at h
  exact bxor_eq_iff_right rfl h

/-- **Two oracles agree on a holding**: every item's honest value is the same under both. Chain items are
compared at the chain's real positions. -/
def Agree (ω ω' : P3COmega n wc) (K : P3ChainKnow n) : Prop :=
  (∀ u ∈ K.tops, R.c2 ω u = R.c2 ω' u) ∧
  (∀ q ∈ K.cols, R.c1 ω q.1 q.2 = R.c1 ω' q.1 q.2) ∧
  (∀ p ∈ K.hs, 1 ≤ p.2.2 → p.2.2 ≤ ovCalls R.G p.2.1 → R.hval ω p.1 p.2.1 p.2.2 = R.hval ω' p.1 p.2.1 p.2.2) ∧
  (∀ p ∈ K.rs, 1 ≤ p.2.2 → p.2.2 ≤ ovCalls R.G p.2.1 → R.rval ω p.1 p.2.1 p.2.2 = R.rval ω' p.1 p.2.1 p.2.2) ∧
  (∀ q ∈ K.kc, R.key ω 1 q.1 q.2 = R.key ω' 1 q.1 q.2) ∧
  (∀ q ∈ K.pc, R.pin2 ω q.1 q.2 = R.pin2 ω' q.1 q.2)

theorem key_congr {ω ω' : P3COmega n wc} {L : Fin 2} {v : Fin n}
    (h : R.rval ω L v (ovCalls R.G v) = R.rval ω' L v (ovCalls R.G v)) : R.key ω L v = R.key ω' L v := by
  unfold P3Replay.key; rw [h]

theorem rval_of_key {ω ω' : P3COmega n wc} {L : Fin 2} {v : Fin n} (h : R.key ω L v = R.key ω' L v) :
    R.rval ω L v (ovCalls R.G v) = R.rval ω' L v (ovCalls R.G v) := by
  unfold P3Replay.key at h
  exact (codeEquiv n wc).symm.injective h

theorem ovCalls_pos (G : TopoDAG n) (v : Fin n) : 1 ≤ ovCalls G v := by unfold ovCalls; omega

/-- **The instantaneous closure keeps agreement.** The `pin2` triples are identities of honest values. A top key
is its components. -/
theorem agree_assemble {ω ω' : P3COmega n wc} {K : P3ChainKnow n} (hA : R.Agree ω ω' K) :
    R.Agree ω ω' (K.assemble R.G) := by
  obtain ⟨ht, hc, hh, hr, hk, hp⟩ := hA
  have hk1 : ∀ {u w : Fin n}, (u, w) ∈ K.kc1 R.G → R.key ω 1 u w = R.key ω' 1 u w := fun {u w} h => by
    rcases (P3ChainKnow.mem_kc1 R.G K u w).1 h with h | h
    · exact hk (u, w) h
    · exact congrFun (R.key_congr (hr ((1 : Fin 2), u, ovCalls R.G u) h (ovCalls_pos R.G u) le_rfl)) w
  refine ⟨ht, fun q hq => ?_, hh, fun p hp' h1 h2 => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · obtain ⟨w, u⟩ := q
    rcases (P3ChainKnow.mem_asm_cols R.G K w u).1 hq with h | ⟨hpc, hkc⟩
    · exact hc _ h
    · have e1 := hp _ hpc
      rw [R.pin2_apply, R.pin2_apply] at e1
      exact bxor_eq_iff_left (hk1 hkc) e1
  · obtain ⟨L, v, j⟩ := p
    rcases (P3ChainKnow.mem_asm_rs R.G K L v j).1 hp' with h | ⟨hL, hj, hall⟩
    · exact hr _ h h1 h2
    · subst hL; subst hj
      refine R.rval_of_key (funext fun w => ?_)
      rcases hall w with h | ⟨hpc, hcol⟩
      · exact hk1 h
      · have e1 := hp _ hpc
        rw [R.pin2_apply, R.pin2_apply] at e1
        exact bxor_eq_iff_right (hc _ hcol) e1
  · obtain ⟨u, w⟩ := q
    rcases (P3ChainKnow.mem_asm_kc R.G K u w).1 hq with h | ⟨hpc, hcol⟩
    · exact hk1 h
    · have e1 := hp _ hpc
      rw [R.pin2_apply, R.pin2_apply] at e1
      exact bxor_eq_iff_right (hc _ hcol) e1
  · obtain ⟨u, w⟩ := q
    rcases (P3ChainKnow.mem_asm_pc R.G K u w).1 hq with h | ⟨hcol, hkc⟩
    · exact hp _ h
    · rw [R.pin2_apply, R.pin2_apply, hc _ hcol, hk1 hkc]


open Classical in
/-- **One pass of the step-level pair rule**: `vcStep`'s rules, firing on the pairs whose honest point (under `ω`)
the history `h` fixes. -/
noncomputable def svcStep (ω : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) (K : P3ChainKnow n) :
    P3ChainKnow n where
  tops := K.tops ∪ Finset.univ.filter (fun u =>
      (R.pin2 ω u ∈ h.dom (.inl (R.tag, 1, u)) ∧ ∀ w, (u, w) ∈ K.pc) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 1 ∧ 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
        R.xin ω p.1 p.2.1 p.2.2 ∈ h.dom (.inr ()) ∧ ovBlock R.G p.2.1 p.2.2 = some u))
  cols := K.cols ∪ Finset.univ.filter (fun q : Fin n × Fin n =>
      (R.pin1 ω q.1 ∈ h.dom (.inl (R.tag, 0, q.1)) ∧ K.keyKnown R.G 0 q.1) ∨
      (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 0 ∧ 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
        R.xin ω p.1 p.2.1 p.2.2 ∈ h.dom (.inr ()) ∧ ovBlock R.G p.2.1 p.2.2 = some q.1))
  hs := K.hs ∪ (P3ChainKnow.pos n).filter (fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
      ((R.xin ω p.1 p.2.1 p.2.2 ∈ h.dom (.inr ()) ∧ K.canCall R.G p.1 p.2.1 p.2.2) ∨
       (p.2.2 + 1 ≤ ovCalls R.G p.2.1 ∧ R.xin ω p.1 p.2.1 (p.2.2 + 1) ∈ h.dom (.inr ()) ∧
         (p.1, p.2.1, p.2.2 + 1) ∈ K.hs ∧ (p.1, p.2.1, p.2.2 + 1) ∈ K.rs)))
  rs := K.rs ∪ (P3ChainKnow.pos n).filter (fun p => 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧
      ((R.xin ω p.1 p.2.1 p.2.2 ∈ h.dom (.inr ()) ∧ K.canCall R.G p.1 p.2.1 p.2.2) ∨
       (p.1 = 0 ∧ p.2.2 = ovCalls R.G p.2.1 ∧ R.pin1 ω p.2.1 ∈ h.dom (.inl (R.tag, 0, p.2.1)) ∧
         K.lowKnown p.2.1)))
  kc := K.kc
  pc := K.pc ∪ Finset.univ.filter (fun q : Fin n × Fin n =>
      R.pin2 ω q.1 ∈ h.dom (.inl (R.tag, 1, q.1)) ∧ q.1 ∈ K.tops)

/-- **A point a consistent history fixes has one image**, under any two oracles consistent with it. -/
theorem dom_agree {π π' : LazyPerm.Oracle (P3Alpha n wc)} {h : LazyPerm.History (P3Alpha n wc)}
    (hc : ∀ e ∈ h, e.2 = LazyPerm.ans π e.1) (hc' : ∀ e ∈ h, e.2 = LazyPerm.ans π' e.1) {i : P3Idx n}
    {x : P3Alpha n wc i} (hx : x ∈ h.dom i) : π i x = π' i x := by
  obtain ⟨e, he, hx⟩ := LazyPerm.History.mem_dom.1 hx
  have h1 := LazyPerm.Entry.outAt_eq_map (hc e he) i
  have h2 := LazyPerm.Entry.outAt_eq_map (hc' e he) i
  rw [hx, Option.map_some] at h1 h2
  exact Option.some_inj.1 (h1.symm.trans h2)

/-- Two oracles whose histories are the same list `h`: consistency on both sides. -/
def Cons2 (ω ω' : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) : Prop :=
  (∀ e ∈ h, e.2 = LazyPerm.ans (omegaEquiv n wc ω) e.1) ∧ (∀ e ∈ h, e.2 = LazyPerm.ans (omegaEquiv n wc ω') e.1)

theorem cons2_symm {ω ω' : P3COmega n wc} {h : LazyPerm.History (P3Alpha n wc)} (hc : Cons2 ω ω' h) :
    Cons2 ω' ω h := ⟨hc.2, hc.1⟩

theorem agree_symm {ω ω' : P3COmega n wc} {K : P3ChainKnow n} (hA : R.Agree ω ω' K) : R.Agree ω' ω K :=
  ⟨fun u hu => (hA.1 u hu).symm, fun q hq => (hA.2.1 q hq).symm, fun p hp h1 h2 => (hA.2.2.1 p hp h1 h2).symm,
    fun p hp h1 h2 => (hA.2.2.2.1 p hp h1 h2).symm, fun q hq => (hA.2.2.2.2.1 q hq).symm,
    fun q hq => (hA.2.2.2.2.2 q hq).symm⟩

/-- A chain point fixed in `h` whose outputs agree is the same point under both oracles. -/
theorem xin_inv_congr {ω ω' : P3COmega n wc} {h : LazyPerm.History (P3Alpha n wc)} (hc : Cons2 ω ω' h)
    {L : Fin 2} {v : Fin n} {p : ℕ} (hd : R.xin ω L v p ∈ h.dom (.inr ()))
    (hh : R.hval ω L v p = R.hval ω' L v p) (hr : R.rval ω L v p = R.rval ω' L v p) :
    R.xin ω L v p = R.xin ω' L v p := by
  have hy : ω.2 (R.xin ω L v p) = ω'.2 (R.xin ω' L v p) := by
    rw [← append_ovR_ovH (ω.2 (R.xin ω L v p)), ← append_ovR_ovH (ω'.2 (R.xin ω' L v p))]
    exact congrArg₂ _ hr hh
  have := dom_agree hc.1 hc.2 hd
  exact ω'.2.injective (this.symm.trans hy)

theorem lab_of_xin {ω ω' : P3COmega n wc} {L : Fin 2} {v u : Fin n} {p : ℕ} (hb : ovBlock R.G v p = some u)
    (hx : R.xin ω L v p = R.xin ω' L v p) : R.lab ω L u = R.lab ω' L u := by
  have h1 := R.xin_ovR ω (L := L) hb
  have h2 := R.xin_ovR ω' (L := L) hb
  rw [hx] at h1
  exact (codeEquiv n wc).injective (h1.symm.trans h2)

theorem hval_of_xin {ω ω' : P3COmega n wc} {h : LazyPerm.History (P3Alpha n wc)} (hc : Cons2 ω ω' h)
    {L : Fin 2} {v : Fin n} {p : ℕ} (hx : R.xin ω L v p = R.xin ω' L v p) (hd : R.xin ω L v p ∈ h.dom (.inr ())) :
    R.hval ω L v p = R.hval ω' L v p ∧ R.rval ω L v p = R.rval ω' L v p := by
  have := dom_agree hc.1 hc.2 hd
  unfold P3Replay.hval P3Replay.rval
  rw [← hx]
  exact ⟨congrArg ovH this, congrArg ovR this⟩


theorem lab_of_known {ω ω' : P3COmega n wc} {K : P3ChainKnow n} (hA : R.Agree ω ω' K) {L : Fin 2} {u : Fin n}
    (hk : K.labKnown L u) : R.lab ω L u = R.lab ω' L u := by
  by_cases hL : L = 0
  · subst hL
    rw [labKnown_zero] at hk
    exact funext fun x => hA.2.1 (u, x) (hk x)
  · have hL1 : L = 1 := by fin_cases L <;> simp_all
    subst hL1
    rw [labKnown_one] at hk
    exact hA.1 u hk

theorem xin_of_canCall {ω ω' : P3COmega n wc} {K : P3ChainKnow n} (hA : R.Agree ω ω' K) {L : Fin 2} {v : Fin n}
    {p : ℕ} (hc : K.canCall R.G L v p) : R.xin ω L v p = R.xin ω' L v p := by
  obtain ⟨hp1, hp, hb, hprev⟩ := hc
  refine R.xin_congr ω ω' hp1 hp (fun u hbu => R.lab_of_known hA (hb u hbu)) fun h2 => ?_
  rcases hprev with h1 | h1
  · omega
  · exact hA.2.2.1 (L, v, p - 1) h1 (show 1 ≤ p - 1 by omega) (show p - 1 ≤ ovCalls R.G v by omega)

theorem key_of_pin1 {ω ω' : P3COmega n wc} {w : Fin n} (h : R.pin1 ω w = R.pin1 ω' w) :
    R.key ω 0 w = R.key ω' 0 w := by
  funext x
  have := congrFun h x
  unfold P3Replay.pin1 labXor at this
  exact bxor_eq_iff_right rfl this

theorem pin2_of_agree {ω ω' : P3COmega n wc} {K : P3ChainKnow n} (hA : R.Agree ω ω' K) {u : Fin n}
    (hk : ∀ w, (u, w) ∈ K.pc) : R.pin2 ω u = R.pin2 ω' u := funext fun w => hA.2.2.2.2.2 (u, w) (hk w)

/-- **The step-level pair rule keeps agreement, and fires the same way under both oracles.** -/
theorem svcStep_agree {ω ω' : P3COmega n wc} {h : LazyPerm.History (P3Alpha n wc)} (hc : Cons2 ω ω' h)
    {K : P3ChainKnow n} (hA : R.Agree ω ω' K) :
    P3ChainKnow.Le (R.svcStep ω h K) (R.svcStep ω' h K) ∧ R.Agree ω ω' (R.svcStep ω h K) := by
  classical
  have hπ : ∀ (T : Tweak n) (a : Lab n wc), a ∈ h.dom (.inl T) → ω.1 T a = ω'.1 T a := fun T a ha =>
    dom_agree hc.1 hc.2 ha
  have hS : ∀ (x : Bits (n * wc + (n * wc + 512))), x ∈ h.dom (.inr ()) → ω.2 x = ω'.2 x := fun x hx =>
    dom_agree hc.1 hc.2 hx
  -- the inverse `Π₂` rule: outputs known and the point fixed
  have hinvS : ∀ {L : Fin 2} {v : Fin n} {j : ℕ}, (L, v, j) ∈ K.hs → (L, v, j) ∈ K.rs → 1 ≤ j →
      j ≤ ovCalls R.G v → R.xin ω L v j ∈ h.dom (.inr ()) → R.xin ω L v j = R.xin ω' L v j :=
    fun {L v j} hh hr h1 h2 hd => R.xin_inv_congr hc hd (hA.2.2.1 (L, v, j) hh h1 h2) (hA.2.2.2.1 (L, v, j) hr h1 h2)
  -- the `P₀` point: known key, or known label and fixed point
  have hpin1 : ∀ {w : Fin n}, R.pin1 ω w ∈ h.dom (.inl (R.tag, 0, w)) → K.lowKnown w → R.pin1 ω w = R.pin1 ω' w := by
    intro w hd hlow
    have hc1 : R.c1 ω w = R.c1 ω' w := funext fun x => hA.2.1 (w, x) (hlow x)
    have e1 := hπ _ _ hd
    rw [← R.c1_eq, hc1, R.c1_eq] at e1
    exact (ω'.1 (R.tag, 0, w)).injective e1.symm
  have hpin2 : ∀ {u : Fin n}, R.pin2 ω u ∈ h.dom (.inl (R.tag, 1, u)) → u ∈ K.tops → R.pin2 ω u = R.pin2 ω' u := by
    intro u hd ht
    have e1 := hπ _ _ hd
    rw [← R.c2_eq, hA.1 u ht, R.c2_eq] at e1
    exact (ω'.1 (R.tag, 1, u)).injective e1.symm
  refine ⟨⟨fun u hu => ?_, fun q hq => ?_, fun p hp => ?_, fun p hp => ?_, fun q hq => hq, fun q hq => ?_⟩,
    ⟨fun u hu => ?_, fun q hq => ?_, fun p hp h1 h2 => ?_, fun p hp h1 h2 => ?_, fun q hq => hA.2.2.2.2.1 q hq,
      fun q hq => ?_⟩⟩
  -- ### the sets
  · rcases Finset.mem_union.1 hu with hu | hu
    · exact Finset.mem_union_left _ hu
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩)
    rcases (Finset.mem_filter.1 hu).2 with ⟨hd, hk⟩ | ⟨p, hph, hpr, hp1, hj1, hj, hd, hb⟩
    · exact Or.inl ⟨R.pin2_of_agree hA hk ▸ hd, hk⟩
    · exact Or.inr ⟨p, hph, hpr, hp1, hj1, hj, hinvS hph hpr hj1 hj hd ▸ hd, hb⟩
  · rcases Finset.mem_union.1 hq with hq | hq
    · exact Finset.mem_union_left _ hq
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩)
    rcases (Finset.mem_filter.1 hq).2 with ⟨hd, hk⟩ | ⟨p, hph, hpr, hp0, hj1, hj, hd, hb⟩
    · have hkey := R.key_congr (hA.2.2.2.1 _ hk (ovCalls_pos R.G _) le_rfl)
      have : R.pin1 ω q.1 = R.pin1 ω' q.1 := by unfold P3Replay.pin1; rw [hkey]
      exact Or.inl ⟨this ▸ hd, hk⟩
    · exact Or.inr ⟨p, hph, hpr, hp0, hj1, hj, hinvS hph hpr hj1 hj hd ▸ hd, hb⟩
  · rcases Finset.mem_union.1 hp with hp | hp
    · exact Finset.mem_union_left _ hp
    obtain ⟨hpos, hj1, hj, hc'⟩ := Finset.mem_filter.1 hp
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, hj1, hj, ?_⟩)
    rcases hc' with ⟨hd, hcall⟩ | ⟨hj2, hd, hh, hr⟩
    · exact Or.inl ⟨R.xin_of_canCall hA hcall ▸ hd, hcall⟩
    · exact Or.inr ⟨hj2, hinvS hh hr (by omega) hj2 hd ▸ hd, hh, hr⟩
  · rcases Finset.mem_union.1 hp with hp | hp
    · exact Finset.mem_union_left _ hp
    obtain ⟨hpos, hj1, hj, hc'⟩ := Finset.mem_filter.1 hp
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, hj1, hj, ?_⟩)
    rcases hc' with ⟨hd, hcall⟩ | ⟨hL, hjp, hd, hlow⟩
    · exact Or.inl ⟨R.xin_of_canCall hA hcall ▸ hd, hcall⟩
    · exact Or.inr ⟨hL, hjp, hpin1 hd hlow ▸ hd, hlow⟩
  · rcases Finset.mem_union.1 hq with hq | hq
    · exact Finset.mem_union_left _ hq
    obtain ⟨_, hd, ht⟩ := Finset.mem_filter.1 hq
    exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hpin2 hd ht ▸ hd, ht⟩)
  -- ### the values
  · rcases Finset.mem_union.1 hu with hu | hu
    · exact hA.1 u hu
    rcases (Finset.mem_filter.1 hu).2 with ⟨hd, hk⟩ | ⟨p, hph, hpr, hp1, hj1, hj, hd, hb⟩
    · rw [R.c2_eq, R.c2_eq, ← R.pin2_of_agree hA hk]
      exact hπ _ _ hd
    · obtain ⟨L, v, j⟩ := p
      simp only at hp1 hj1 hj hd hb
      subst hp1
      exact R.lab_of_xin hb (hinvS hph hpr hj1 hj hd)
  · obtain ⟨w, x⟩ := q
    rcases Finset.mem_union.1 hq with hq | hq
    · exact hA.2.1 _ hq
    rcases (Finset.mem_filter.1 hq).2 with ⟨hd, hk⟩ | ⟨p, hph, hpr, hp0, hj1, hj, hd, hb⟩
    · have hkey := R.key_congr (hA.2.2.2.1 _ hk (ovCalls_pos R.G _) le_rfl)
      have hp : R.pin1 ω w = R.pin1 ω' w := by unfold P3Replay.pin1; rw [hkey]
      show R.c1 ω w x = R.c1 ω' w x
      rw [R.c1_eq, R.c1_eq, ← hp, hπ _ _ hd]
    · obtain ⟨L, v, j⟩ := p
      simp only at hp0 hj1 hj hd hb
      subst hp0
      exact congrFun (R.lab_of_xin hb (hinvS hph hpr hj1 hj hd)) x
  · rcases Finset.mem_union.1 hp with hp | hp
    · exact hA.2.2.1 p hp h1 h2
    obtain ⟨_, _, _, hc'⟩ := Finset.mem_filter.1 hp
    obtain ⟨L, v, j⟩ := p
    simp only at h1 h2 hc' ⊢
    rcases hc' with ⟨hd, hcall⟩ | ⟨hj2, hd, hh, hr⟩
    · exact (R.hval_of_xin hc (R.xin_of_canCall hA hcall) hd).1
    · have hx := hinvS hh hr (by omega) hj2 hd
      have e1 := R.xin_ovH ω (L := L) (v := v) (p := j) h1 (by omega)
      have e2 := R.xin_ovH ω' (L := L) (v := v) (p := j) h1 (by omega)
      rw [← e1, ← e2, hx]
  · rcases Finset.mem_union.1 hp with hp | hp
    · exact hA.2.2.2.1 p hp h1 h2
    obtain ⟨_, _, _, hc'⟩ := Finset.mem_filter.1 hp
    obtain ⟨L, v, j⟩ := p
    simp only at h1 h2 hc' ⊢
    rcases hc' with ⟨hd, hcall⟩ | ⟨hL, hjp, hd, hlow⟩
    · exact (R.hval_of_xin hc (R.xin_of_canCall hA hcall) hd).2
    · subst hL; subst hjp
      exact R.rval_of_key (R.key_of_pin1 (hpin1 hd hlow))
  · obtain ⟨u, w⟩ := q
    rcases Finset.mem_union.1 hq with hq | hq
    · exact hA.2.2.2.2.2 _ hq
    obtain ⟨_, hd, ht⟩ := Finset.mem_filter.1 hq
    exact congrFun (hpin2 hd ht) w

theorem knowLe_antisymm {A B : P3ChainKnow n} (h1 : P3ChainKnow.Le A B) (h2 : P3ChainKnow.Le B A) : A = B := by
  obtain ⟨a1, a2, a3, a4, a5, a6⟩ := A
  obtain ⟨b1, b2, b3, b4, b5, b6⟩ := B
  obtain ⟨e1, e2, e3, e4, e5, e6⟩ := h1
  obtain ⟨f1, f2, f3, f4, f5, f6⟩ := h2
  simp only at e1 e2 e3 e4 e5 e6 f1 f2 f3 f4 f5 f6
  rw [Finset.Subset.antisymm e1 f1, Finset.Subset.antisymm e2 f2, Finset.Subset.antisymm e3 f3,
    Finset.Subset.antisymm e4 f4, Finset.Subset.antisymm e5 f5, Finset.Subset.antisymm e6 f6]

/-- **Iterating two maps that agree step by step.** -/
theorem iter_agree {α : Type} (F F' : α → α) (P : α → Prop) {x : α} (hx : P x)
    (hstep : ∀ y, P y → F y = F' y ∧ P (F y)) : ∀ k, F^[k] x = F'^[k] x ∧ P (F^[k] x)
  | 0 => ⟨rfl, hx⟩
  | k + 1 => by
    obtain ⟨heq, hk⟩ := iter_agree F F' P hx hstep k
    obtain ⟨h1, h2⟩ := hstep _ hk
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ← heq]
    exact ⟨h1, h2⟩

/-- One pass of the step-level closure: the pair rule, then `assemble`. -/
noncomputable def svcF (ω : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) (K : P3ChainKnow n) :
    P3ChainKnow n :=
  (R.svcStep ω h K).assemble R.G

/-- **The step-level value closure** of a holding `K₀` at history `h`: `K₀` closed under the pair rule of the
pairs `h` fixes, the identities and the `pin2` triples. It is what `h` and `K₀`'s values determine. -/
noncomputable def svc (ω : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) (K₀ : P3ChainKnow n) :
    P3ChainKnow n :=
  (R.svcF ω h)^[P3Replay.vcIters n] (K₀.assemble R.G)

theorem svcF_agree {ω ω' : P3COmega n wc} {h : LazyPerm.History (P3Alpha n wc)} (hc : Cons2 ω ω' h)
    (y : P3ChainKnow n) (hy : R.Agree ω ω' y) : R.svcF ω h y = R.svcF ω' h y ∧ R.Agree ω ω' (R.svcF ω h y) := by
  have h1 := R.svcStep_agree hc hy
  have h2 := R.svcStep_agree (cons2_symm hc) (R.agree_symm hy)
  have hS : R.svcStep ω h y = R.svcStep ω' h y := knowLe_antisymm h1.1 h2.1
  refine ⟨?_, R.agree_assemble h1.2⟩
  unfold svcF
  rw [hS]

/-- **Value soundness of the step-level closure.** Two oracles consistent with `h` that agree on `K₀`'s values
compute the same closure, and agree on all its values. So its values are functions of `h` and `K₀`'s values. -/
theorem agree_svc {ω ω' : P3COmega n wc} {h : LazyPerm.History (P3Alpha n wc)} (hc : Cons2 ω ω' h)
    {K₀ : P3ChainKnow n} (hA : R.Agree ω ω' K₀) :
    R.svc ω h K₀ = R.svc ω' h K₀ ∧ R.Agree ω ω' (R.svc ω h K₀) :=
  iter_agree (R.svcF ω h) (R.svcF ω' h) (R.Agree ω ω') (R.agree_assemble hA) (R.svcF_agree hc) _


theorem svcStep_mono (ω : P3COmega n wc) {h h' : LazyPerm.History (P3Alpha n wc)} (hd : ∀ i, h.dom i ⊆ h'.dom i)
    {K K' : P3ChainKnow n} (hK : P3ChainKnow.Le K K') : P3ChainKnow.Le (R.svcStep ω h K) (R.svcStep ω h' K') := by
  classical
  have hlow : ∀ {w}, K.lowKnown w → K'.lowKnown w := fun hl x => hK.2.1 (hl x)
  refine ⟨fun u hu => ?_, fun q hq => ?_, fun p hp => ?_, fun p hp => ?_, fun q hq => hK.2.2.2.2.1 hq, fun q hq => ?_⟩
  · rcases Finset.mem_union.1 hu with hu | hu
    · exact Finset.mem_union_left _ (hK.1 hu)
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩)
    rcases (Finset.mem_filter.1 hu).2 with ⟨hdm, hk⟩ | ⟨p, hph, hpr, hp1, hj1, hj, hdm, hb⟩
    · exact Or.inl ⟨hd _ hdm, fun w => hK.2.2.2.2.2 (hk w)⟩
    · exact Or.inr ⟨p, hK.2.2.1 hph, hK.2.2.2.1 hpr, hp1, hj1, hj, hd _ hdm, hb⟩
  · rcases Finset.mem_union.1 hq with hq | hq
    · exact Finset.mem_union_left _ (hK.2.1 hq)
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩)
    rcases (Finset.mem_filter.1 hq).2 with ⟨hdm, hk⟩ | ⟨p, hph, hpr, hp0, hj1, hj, hdm, hb⟩
    · exact Or.inl ⟨hd _ hdm, hK.2.2.2.1 hk⟩
    · exact Or.inr ⟨p, hK.2.2.1 hph, hK.2.2.2.1 hpr, hp0, hj1, hj, hd _ hdm, hb⟩
  · rcases Finset.mem_union.1 hp with hp | hp
    · exact Finset.mem_union_left _ (hK.2.2.1 hp)
    obtain ⟨hpos, hj1, hj, hc⟩ := Finset.mem_filter.1 hp
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, hj1, hj, ?_⟩)
    rcases hc with ⟨hdm, hcall⟩ | ⟨hj2, hdm, hh, hr⟩
    · exact Or.inl ⟨hd _ hdm, P3ChainKnow.canCall_mono R.G hK hcall⟩
    · exact Or.inr ⟨hj2, hd _ hdm, hK.2.2.1 hh, hK.2.2.2.1 hr⟩
  · rcases Finset.mem_union.1 hp with hp | hp
    · exact Finset.mem_union_left _ (hK.2.2.2.1 hp)
    obtain ⟨hpos, hj1, hj, hc⟩ := Finset.mem_filter.1 hp
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, hj1, hj, ?_⟩)
    rcases hc with ⟨hdm, hcall⟩ | ⟨hL, hjp, hdm, hl⟩
    · exact Or.inl ⟨hd _ hdm, P3ChainKnow.canCall_mono R.G hK hcall⟩
    · exact Or.inr ⟨hL, hjp, hd _ hdm, hlow hl⟩
  · rcases Finset.mem_union.1 hq with hq | hq
    · exact Finset.mem_union_left _ (hK.2.2.2.2.2 hq)
    obtain ⟨_, hdm, ht⟩ := Finset.mem_filter.1 hq
    exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hd _ hdm, hK.1 ht⟩)

theorem svcF_mono (ω : P3COmega n wc) {h h' : LazyPerm.History (P3Alpha n wc)} (hd : ∀ i, h.dom i ⊆ h'.dom i)
    {K K' : P3ChainKnow n} (hK : P3ChainKnow.Le K K') : P3ChainKnow.Le (R.svcF ω h K) (R.svcF ω h' K') :=
  P3ChainKnow.assemble_mono R.G (R.svcStep_mono ω hd hK)

theorem le_svcF (ω : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) (K : P3ChainKnow n) :
    P3ChainKnow.Le K (R.svcF ω h K) :=
  (show P3ChainKnow.Le K (R.svcStep ω h K) from
    ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left,
      subset_rfl, Finset.subset_union_left⟩).trans (P3ChainKnow.le_assemble R.G _)

theorem iterate_mono_le {f g : P3ChainKnow n → P3ChainKnow n}
    (hfg : ∀ {K K'}, P3ChainKnow.Le K K' → P3ChainKnow.Le (f K) (g K')) {x y : P3ChainKnow n}
    (hxy : P3ChainKnow.Le x y) : ∀ k, P3ChainKnow.Le (f^[k] x) (g^[k] y)
  | 0 => hxy
  | k + 1 => by
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
    exact hfg (iterate_mono_le hfg hxy k)

/-- **The step-level closure grows with the history and the holding.** -/
theorem svc_mono (ω : P3COmega n wc) {h h' : LazyPerm.History (P3Alpha n wc)} (hd : ∀ i, h.dom i ⊆ h'.dom i)
    {K K' : P3ChainKnow n} (hK : P3ChainKnow.Le K K') : P3ChainKnow.Le (R.svc ω h K) (R.svc ω h' K') :=
  iterate_mono_le (fun hle => R.svcF_mono ω hd hle) (P3ChainKnow.assemble_mono R.G hK) _

theorem le_svc (ω : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) (K : P3ChainKnow n) :
    P3ChainKnow.Le K (R.svc ω h K) := by
  have : ∀ k, P3ChainKnow.Le (K.assemble R.G) ((R.svcF ω h)^[k] (K.assemble R.G)) := by
    intro k
    induction k with
    | zero => exact P3ChainKnow.Le.rfl' _
    | succ k ih =>
      rw [Function.iterate_succ_apply']
      exact ih.trans (R.le_svcF ω h _)
  exact (P3ChainKnow.le_assemble R.G K).trans (this _)


/-- A holding's size: the number of items. -/
def ksize (K : P3ChainKnow n) : ℕ :=
  K.tops.card + K.cols.card + K.hs.card + K.rs.card + K.kc.card + K.pc.card

/-- A holding inside the item universe (chain items at the real positions). -/
def InU (K : P3ChainKnow n) : Prop := K.hs ⊆ P3ChainKnow.pos n ∧ K.rs ⊆ P3ChainKnow.pos n

theorem ksize_lt {a b : P3ChainKnow n} (hle : P3ChainKnow.Le a b) (hne : a ≠ b) : ksize a < ksize b := by
  unfold ksize
  have c1 := Finset.card_le_card hle.1
  have c2 := Finset.card_le_card hle.2.1
  have c3 := Finset.card_le_card hle.2.2.1
  have c4 := Finset.card_le_card hle.2.2.2.1
  have c5 := Finset.card_le_card hle.2.2.2.2.1
  have c6 := Finset.card_le_card hle.2.2.2.2.2
  by_contra hlt
  push Not at hlt
  apply hne
  have e1 := Finset.eq_of_subset_of_card_le hle.1 (by omega)
  have e2 := Finset.eq_of_subset_of_card_le hle.2.1 (by omega)
  have e3 := Finset.eq_of_subset_of_card_le hle.2.2.1 (by omega)
  have e4 := Finset.eq_of_subset_of_card_le hle.2.2.2.1 (by omega)
  have e5 := Finset.eq_of_subset_of_card_le hle.2.2.2.2.1 (by omega)
  have e6 := Finset.eq_of_subset_of_card_le hle.2.2.2.2.2 (by omega)
  obtain ⟨a1, a2, a3, a4, a5, a6⟩ := a
  obtain ⟨b1, b2, b3, b4, b5, b6⟩ := b
  simp only at e1 e2 e3 e4 e5 e6
  rw [e1, e2, e3, e4, e5, e6]

theorem card_pos_le : (P3ChainKnow.pos n).card ≤ 2 * n * (n + 2) := by
  unfold P3ChainKnow.pos
  simp [Finset.card_product]
  ring_nf
  omega

theorem ksize_le {K : P3ChainKnow n} (hU : InU K) : ksize K ≤ P3Replay.vcIters n := by
  unfold ksize P3Replay.vcIters
  have h1 : K.tops.card ≤ n := (Finset.card_le_univ _).trans (by simp)
  have h2 : K.cols.card ≤ n * n := (Finset.card_le_univ _).trans (by simp)
  have h3 : K.hs.card ≤ 2 * n * (n + 2) := (Finset.card_le_card hU.1).trans card_pos_le
  have h4 : K.rs.card ≤ 2 * n * (n + 2) := (Finset.card_le_card hU.2).trans card_pos_le
  have h5 : K.kc.card ≤ n * n := (Finset.card_le_univ _).trans (by simp)
  have h6 : K.pc.card ≤ n * n := (Finset.card_le_univ _).trans (by simp)
  nlinarith

theorem inU_svcF (ω : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) {K : P3ChainKnow n} (hU : InU K) :
    InU (R.svcF ω h K) := by
  classical
  refine ⟨fun p hp => ?_, fun p hp => ?_⟩
  · have : p ∈ (R.svcStep ω h K).hs := hp
    rcases Finset.mem_union.1 this with h1 | h1
    · exact hU.1 h1
    · exact (Finset.mem_filter.1 h1).1
  · obtain ⟨L, v, j⟩ := p
    rcases (P3ChainKnow.mem_asm_rs R.G _ L v j).1 hp with h1 | ⟨_, hj, _⟩
    · rcases Finset.mem_union.1 h1 with h1 | h1
      · exact hU.2 h1
      · exact (Finset.mem_filter.1 h1).1
    · subst hj
      exact R.mem_pos (L := L) le_rfl

theorem inU_assemble {K : P3ChainKnow n} (hU : InU K) : InU (K.assemble R.G) := by
  refine ⟨hU.1, fun p hp => ?_⟩
  obtain ⟨L, v, j⟩ := p
  rcases (P3ChainKnow.mem_asm_rs R.G _ L v j).1 hp with h1 | ⟨_, hj, _⟩
  · exact hU.2 h1
  · subst hj
    exact R.mem_pos (L := L) le_rfl

/-- **Stabilization**: an inflationary map on a bounded finite lattice is stable after `M` passes. -/
theorem iterate_stable (f : P3ChainKnow n → P3ChainKnow n) (hinf : ∀ K, InU K → P3ChainKnow.Le K (f K))
    (hU : ∀ K, InU K → InU (f K)) {x : P3ChainKnow n} (hx : InU x) :
    f (f^[P3Replay.vcIters n] x) = f^[P3Replay.vcIters n] x := by
  have hUk : ∀ k, InU (f^[k] x) := by
    intro k
    induction k with
    | zero => exact hx
    | succ k ih => rw [Function.iterate_succ_apply']; exact hU _ ih
  -- if every pass up to `k` changed the holding, the size is at least `k`
  have hgrow : ∀ k, (∀ i < k, f^[i + 1] x ≠ f^[i] x) → k ≤ ksize (f^[k] x) := by
    intro k
    induction k with
    | zero => intro _; exact Nat.zero_le _
    | succ k ih =>
      intro hne
      have h1 := ih fun i hi => hne i (by omega)
      have h2 := ksize_lt (hinf _ (hUk k)) (by
        have := hne k (by omega)
        rw [Function.iterate_succ_apply'] at this
        exact fun e => this e.symm)
      rw [Function.iterate_succ_apply']
      omega
  -- so some pass up to `M` fixes it, and then every later one does
  have hex : ∃ k ≤ P3Replay.vcIters n, f^[k + 1] x = f^[k] x := by
    by_contra hall
    push Not at hall
    have := hgrow (P3Replay.vcIters n + 1) fun i hi => hall i (by omega)
    have := ksize_le (hUk (P3Replay.vcIters n + 1))
    omega
  obtain ⟨k, hk, hfix⟩ := hex
  have hconst : ∀ d, f^[k + d] x = f^[k] x := by
    intro d
    induction d with
    | zero => rfl
    | succ d ih =>
      rw [← Nat.add_assoc, Function.iterate_succ_apply', ih]
      rw [Function.iterate_succ_apply'] at hfix
      exact hfix
  have e1 := hconst (P3Replay.vcIters n - k)
  have e2 := hconst (P3Replay.vcIters n + 1 - k)
  rw [Nat.add_sub_cancel' hk] at e1
  rw [show k + (P3Replay.vcIters n + 1 - k) = P3Replay.vcIters n + 1 by omega, Function.iterate_succ_apply'] at e2
  rw [e2, e1]

/-- **The step-level closure is closed**: one more pass adds nothing. -/
theorem svc_fix (ω : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) {K₀ : P3ChainKnow n} (hU : InU K₀) :
    R.svcF ω h (R.svc ω h K₀) = R.svc ω h K₀ :=
  iterate_stable (R.svcF ω h) (fun K _ => R.le_svcF ω h K) (fun _ hK => R.inU_svcF ω h hK) (R.inU_assemble hU)

theorem svc_step_le (ω : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) {K₀ : P3ChainKnow n} (hU : InU K₀) :
    P3ChainKnow.Le (R.svcStep ω h (R.svc ω h K₀)) (R.svc ω h K₀) := by
  have := R.svc_fix ω h hU
  rw [← this]
  exact (P3ChainKnow.le_assemble R.G _).trans (R.svcF_mono ω (fun _ => subset_rfl) (by rw [this]; exact P3ChainKnow.Le.rfl' _))

theorem svc_asm_le (ω : P3COmega n wc) (h : LazyPerm.History (P3Alpha n wc)) {K₀ : P3ChainKnow n} (hU : InU K₀) :
    P3ChainKnow.Le ((R.svc ω h K₀).assemble R.G) (R.svc ω h K₀) := by
  have := R.svc_fix ω h hU
  unfold svcF at this
  rw [← this]
  exact P3ChainKnow.asm_idem R.G _

/-- **The round-level closure is inside the step-level one**, once the history fixes every pair the programs
revealed before round `τ`. -/
theorem vc_le_svc (ω : P3COmega n wc) (τ : ℕ) {H K₀ : P3ChainKnow n} (hH : P3ChainKnow.Le H K₀)
    {h : LazyPerm.History (P3Alpha n wc)}
    (hrevS : ∀ z ρ, ρ < τ → R.askedS ω z ρ → z ∈ h.dom (.inr ()))
    (hrevP : ∀ (T : Tweak n) a ρ, ρ < τ → R.askedP ω T a ρ → a ∈ h.dom (.inl T)) :
    P3ChainKnow.Le (R.vc ω τ H) (R.svc ω h K₀) := by
  classical
  have hstep : ∀ {K K' : P3ChainKnow n}, P3ChainKnow.Le K K' →
      P3ChainKnow.Le ((R.vcStep ω τ K).assemble R.G) (R.svcF ω h K') := by
    intro K K' hK
    refine P3ChainKnow.assemble_mono R.G ?_
    have hlow : ∀ {w}, K.lowKnown w → K'.lowKnown w := fun hl x => hK.2.1 (hl x)
    refine ⟨fun u hu => ?_, fun q hq => ?_, fun p hp => ?_, fun p hp => ?_, fun q hq => hK.2.2.2.2.1 hq,
      fun q hq => ?_⟩
    · rcases Finset.mem_union.1 hu with hu | hu
      · exact Finset.mem_union_left _ (hK.1 hu)
      refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩)
      rcases (Finset.mem_filter.1 hu).2 with ⟨⟨ρ, hρ, ha⟩, hk⟩ | ⟨p, hph, hpr, hp1, hj1, hj, ⟨ρ, hρ, ha⟩, hb⟩
      · exact Or.inl ⟨hrevP _ _ ρ hρ ha, fun w => hK.2.2.2.2.2 (hk w)⟩
      · exact Or.inr ⟨p, hK.2.2.1 hph, hK.2.2.2.1 hpr, hp1, hj1, hj, hrevS _ ρ hρ ha, hb⟩
    · rcases Finset.mem_union.1 hq with hq | hq
      · exact Finset.mem_union_left _ (hK.2.1 hq)
      refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩)
      rcases (Finset.mem_filter.1 hq).2 with ⟨⟨ρ, hρ, ha⟩, hk⟩ | ⟨p, hph, hpr, hp0, hj1, hj, ⟨ρ, hρ, ha⟩, hb⟩
      · exact Or.inl ⟨hrevP _ _ ρ hρ ha, hK.2.2.2.1 hk⟩
      · exact Or.inr ⟨p, hK.2.2.1 hph, hK.2.2.2.1 hpr, hp0, hj1, hj, hrevS _ ρ hρ ha, hb⟩
    · rcases Finset.mem_union.1 hp with hp | hp
      · exact Finset.mem_union_left _ (hK.2.2.1 hp)
      obtain ⟨hpos, hj1, hj, hc⟩ := Finset.mem_filter.1 hp
      refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, hj1, hj, ?_⟩)
      rcases hc with ⟨⟨ρ, hρ, ha⟩, hcall⟩ | ⟨hj2, ⟨ρ, hρ, ha⟩, hh, hr⟩
      · exact Or.inl ⟨hrevS _ ρ hρ ha, P3ChainKnow.canCall_mono R.G hK hcall⟩
      · exact Or.inr ⟨hj2, hrevS _ ρ hρ ha, hK.2.2.1 hh, hK.2.2.2.1 hr⟩
    · rcases Finset.mem_union.1 hp with hp | hp
      · exact Finset.mem_union_left _ (hK.2.2.2.1 hp)
      obtain ⟨hpos, hj1, hj, hc⟩ := Finset.mem_filter.1 hp
      refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, hj1, hj, ?_⟩)
      rcases hc with ⟨⟨ρ, hρ, ha⟩, hcall⟩ | ⟨hL, hjp, ⟨ρ, hρ, ha⟩, hl⟩
      · exact Or.inl ⟨hrevS _ ρ hρ ha, P3ChainKnow.canCall_mono R.G hK hcall⟩
      · exact Or.inr ⟨hL, hjp, hrevP _ _ ρ hρ ha, hlow hl⟩
    · rcases Finset.mem_union.1 hq with hq | hq
      · exact Finset.mem_union_left _ (hK.2.2.2.2.2 hq)
      obtain ⟨_, ⟨ρ, hρ, ha⟩, ht⟩ := Finset.mem_filter.1 hq
      exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hrevP _ _ ρ hρ ha, hK.1 ht⟩)
  exact iterate_mono_le (fun hle => hstep hle) (P3ChainKnow.assemble_mono R.G hH) _

end Values

end P3Replay

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainBacking ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))

/-- The schedule under `π` is the one read off `((omegaEquiv n wc).symm π)`. -/
theorem sched_eq : sched R π = LazyPerm.roundsSeq R.ths ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π)) R.D
    (fun t => toRProg (R.A t)) := by
  unfold sched
  rw [trueAns_symm]

/-- **A schedule entry before step `j ≤ c` is in the truncated history at `j`.** -/
theorem sched_mem_hist {c j k : ℕ} (hc : c ≤ (sched R π).length) (hjc : j ≤ c) (hk : k < j)
    {q : (p3ChainModel n wc).Qry} (hq : (sched R π)[k]? = some q) :
    qEntry π (enc n wc) q ∈ (stratC R c).hist π j := by
  rw [stratC_hist_le R π hc j hjc]
  unfold strat
  rw [Strategy.ofRounds_hist _ _ _ _ _ _ π j (le_trans hjc hc)]
  refine List.mem_map.2 ⟨q, ?_, rfl⟩
  have hk' : k < ((sched R π).take j).length := by
    rw [List.length_take]
    have := (List.getElem?_eq_some_iff.1 hq).1
    omega
  exact List.mem_of_getElem? (show ((sched R π).take j)[k]? = some q by rw [List.getElem?_take_of_lt hk, hq])

/-- **A program's query at round `ρ < D` sits in the schedule.** -/
theorem tr_sched {v : ι} {e : ℕ × (p3ChainModel n wc).Qry} (he : e ∈ R.tr ((omegaEquiv n wc).symm π) v) (hρ : e.1 < R.D) :
    ∃ k < R.roundEnd ((omegaEquiv n wc).symm π) e.1, (sched R π)[k]? = some e.2 := by
  have hmem : e.2 ∈ R.rq ((omegaEquiv n wc).symm π) e.1 v := (R.mem_rq_iff ((omegaEquiv n wc).symm π)).2 ⟨e, he, rfl, rfl⟩
  obtain ⟨i, hi, hiq⟩ := List.getElem_of_mem hmem
  refine ⟨R.off ((omegaEquiv n wc).symm π) e.1 v + i, R.off_add_lt ((omegaEquiv n wc).symm π) e.1 v hi, ?_⟩
  rw [sched_eq, R.roundsSeq_off ((omegaEquiv n wc).symm π) hρ v hi, hiq]

theorem roundEnd_le_off {ρ τ : ℕ} (h : ρ < τ) (v : ι) : R.roundEnd ((omegaEquiv n wc).symm π) ρ ≤ R.off ((omegaEquiv n wc).symm π) τ v := by
  unfold roundEnd off
  have : ((List.range (ρ + 1)).flatMap (R.rqAll ((omegaEquiv n wc).symm π))).length ≤ ((List.range τ).flatMap (R.rqAll ((omegaEquiv n wc).symm π))).length := by
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le (show ρ + 1 ≤ τ by omega)
    rw [hd, List.range_add (n := ρ + 1) (m := d), List.flatMap_append, List.length_append]
    omega
  omega

/-- **A `Π₂` pair a program revealed at an earlier round is fixed in the truncated history.** -/
theorem revealS_mem_dom (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c j : ℕ} (hc : c ≤ (sched R π).length)
    (hjc : j ≤ c) {z : Bits (n * wc + (n * wc + 512))} {ρ : ℕ} (hz : R.askedS ((omegaEquiv n wc).symm π) z ρ)
    (hρj : R.roundEnd ((omegaEquiv n wc).symm π) ρ ≤ j) : z ∈ ((stratC R c).hist π j).dom (.inr ()) := by
  obtain ⟨v, e, he, hρ, hrev⟩ := hz
  have hD : e.1 < R.D := (Tr.round_lt_depth _ (R.A v) e he).trans_le ((hA v) ((omegaEquiv n wc).symm π)).1
  obtain ⟨k, hk, hq⟩ := R.tr_sched π he hD
  have hmem := R.sched_mem_hist π hc hjc (by rw [← hρ] at hρj; omega) hq
  refine History.mem_dom.2 ⟨_, hmem, ?_⟩
  obtain ⟨ρe, q⟩ := e
  rcases q with (x | y) | ⟨T, a | b⟩
  · simp only [revS, Option.some_inj] at hrev
    subst hrev
    rfl
  · simp only [revS, Option.some_inj] at hrev
    subst hrev
    rfl
  · simp [revS] at hrev
  · simp [revS] at hrev

/-- **A `P` pair a program revealed at an earlier round is fixed in the truncated history.** -/
theorem revealP_mem_dom (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c j : ℕ} (hc : c ≤ (sched R π).length)
    (hjc : j ≤ c) {T : Tweak n} {a : Lab n wc} {ρ : ℕ} (hz : R.askedP ((omegaEquiv n wc).symm π) T a ρ)
    (hρj : R.roundEnd ((omegaEquiv n wc).symm π) ρ ≤ j) : a ∈ ((stratC R c).hist π j).dom (.inl T) := by
  classical
  obtain ⟨v, e, he, hρ, hrev⟩ := hz
  have hD : e.1 < R.D := (Tr.round_lt_depth _ (R.A v) e he).trans_le ((hA v) ((omegaEquiv n wc).symm π)).1
  obtain ⟨k, hk, hq⟩ := R.tr_sched π he hD
  have hmem := R.sched_mem_hist π hc hjc (by rw [← hρ] at hρj; omega) hq
  refine History.mem_dom.2 ⟨_, hmem, ?_⟩
  obtain ⟨ρe, q⟩ := e
  rcases q with (x | y) | ⟨T', a' | b⟩
  · simp [revP] at hrev
  · simp [revP] at hrev
  · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
    obtain ⟨rfl, rfl⟩ := hrev
    simp [Entry.inpAt, Entry.inp, qEntry, enc]
  · simp only [revP, Option.some_inj, Prod.mk.injEq] at hrev
    obtain ⟨rfl, rfl⟩ := hrev
    simp [Entry.inpAt, Entry.inp, qEntry, enc, ans, omegaEquiv]
    rfl

theorem onlineHC_mono (ω : P3COmega n wc) (c : ℕ) {τ τ' : ℕ} (h : τ ≤ τ') :
    P3ChainKnow.Le (R.onlineHC ω c τ) (R.onlineHC ω c τ') := by
  induction τ', h using Nat.le_induction with
  | base => exact P3ChainKnow.Le.rfl' _
  | succ τ' _ ih => exact ih.trans (P3ChainKnow.le_union_left _ _)

theorem inU_onlineHC (ω : P3COmega n wc) (c : ℕ) : ∀ τ, InU (R.onlineHC ω c τ)
  | 0 => ⟨fun _ h => by simp [onlineHC, P3ChainKnow.empty] at h, fun _ h => by simp [onlineHC, P3ChainKnow.empty] at h⟩
  | τ + 1 => by
    classical
    have ih := inU_onlineHC ω c τ
    have hF := P3ChainKnow.fresh_sub (R.shownAtC ω c τ) (R.vc ω τ (R.onlineHC ω c τ))
    refine ⟨fun p hp => ?_, fun p hp => ?_⟩
    · rcases Finset.mem_union.1 hp with h | h
      · exact ih.1 h
      · exact (Finset.mem_filter.1 (hF.2.2.1 p h).1).1
    · rcases Finset.mem_union.1 hp with h | h
      · exact ih.2 h
      · exact (Finset.mem_filter.1 (hF.2.2.2.1 p h).1).1

theorem svc_closed_kc {ω : P3COmega n wc} {h : LazyPerm.History (P3Alpha n wc)} {K₀ : P3ChainKnow n} (hU : InU K₀)
    {u w : Fin n} (hc : (w, u) ∈ (R.svc ω h K₀).cols) (hp : (u, w) ∈ (R.svc ω h K₀).pc) :
    (u, w) ∈ (R.svc ω h K₀).kc :=
  (R.svc_asm_le ω h hU).2.2.2.2.1 ((P3ChainKnow.mem_asm_kc R.G _ u w).2 (Or.inr ⟨hp, hc⟩))

theorem svc_closed_pc {ω : P3COmega n wc} {h : LazyPerm.History (P3Alpha n wc)} {K₀ : P3ChainKnow n} (hU : InU K₀)
    {u w : Fin n} (hc : (w, u) ∈ (R.svc ω h K₀).cols) (hk : (u, w) ∈ (R.svc ω h K₀).kc) :
    (u, w) ∈ (R.svc ω h K₀).pc :=
  (R.svc_asm_le ω h hU).2.2.2.2.2 ((P3ChainKnow.mem_asm_pc R.G _ u w).2
    (Or.inr ⟨hc, (P3ChainKnow.mem_kc1 R.G _ u w).2 (Or.inl hk)⟩))

/-- **Round `τ`'s shows before the cut are in the step-level closure** of the truncated history, with every credit
of the cut holding taken as known. Each show is credited, in the round-level `VC`, or derivable by a `pin2` triple.
The history must hold rounds `< τ` (`hrev`). -/
theorem shownAtC_le_svc (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c j τ : ℕ} (hc : c ≤ (sched R π).length)
    (hjc : j ≤ c) (hτD : τ ≤ R.D) (hrev : ∀ ρ < τ, R.roundEnd ((omegaEquiv n wc).symm π) ρ ≤ j) {K : P3ChainKnow n}
    (hK : P3ChainKnow.Le (R.onlineHC ((omegaEquiv n wc).symm π) c (τ + 1)) K) (hU : InU K) :
    P3ChainKnow.Le (R.shownAtC ((omegaEquiv n wc).symm π) c τ) (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K) := by
  classical
  set X := R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K
  have hV : P3ChainKnow.Le (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)) X :=
    R.vc_le_svc ((omegaEquiv n wc).symm π) τ ((R.onlineHC_mono ((omegaEquiv n wc).symm π) c (Nat.le_succ τ)).trans hK)
      (fun z ρ hρ hz => R.revealS_mem_dom π hA hc hjc hz (hrev ρ hρ))
      (fun T a ρ hρ hz => R.revealP_mem_dom π hA hc hjc hz (hrev ρ hρ))
  have hF : P3ChainKnow.Le (P3ChainKnow.fresh (R.shownAtC ((omegaEquiv n wc).symm π) c τ) (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ))) X :=
    ((P3ChainKnow.le_union_right _ _).trans hK).trans (R.le_svc _ _ _)
  have hcols : (R.shownAtC ((omegaEquiv n wc).symm π) c τ).cols ⊆ X.cols := fun x hx => by
    by_cases hk : x ∈ (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)).cols
    · exact hV.2.1 hk
    · exact hF.2.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  have hkc : (R.shownAtC ((omegaEquiv n wc).symm π) c τ).kc ⊆ X.kc := fun x hx => by
    by_cases hk : x ∈ (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)).kc
    · exact hV.2.2.2.2.1 hk
    · by_cases hd : (x.2, x.1) ∈ (R.shownAtC ((omegaEquiv n wc).symm π) c τ).cols ∧ x ∈ (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)).pc
      · exact R.svc_closed_kc hU (hcols hd.1) (hV.2.2.2.2.2 hd.2)
      · exact hF.2.2.2.2.1 (Finset.mem_filter.2 ⟨Finset.mem_sdiff.2 ⟨hx, hk⟩, hd⟩)
  refine ⟨fun x hx => ?_, hcols, fun x hx => ?_, fun x hx => ?_, hkc, fun x hx => ?_⟩
  · by_cases hk : x ∈ (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)).tops
    · exact hV.1 hk
    · exact hF.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  · by_cases hk : x ∈ (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)).hs
    · exact hV.2.2.1 hk
    · exact hF.2.2.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  · by_cases hk : x ∈ (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)).rs
    · exact hV.2.2.2.1 hk
    · exact hF.2.2.2.1 (Finset.mem_sdiff.2 ⟨hx, hk⟩)
  · by_cases hk : x ∈ (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)).pc
    · exact hV.2.2.2.2.2 hk
    · by_cases hd : (x.2, x.1) ∈ (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)).cols ∪ (R.shownAtC ((omegaEquiv n wc).symm π) c τ).cols ∧
          x ∈ (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)).kc ∪ (R.shownAtC ((omegaEquiv n wc).symm π) c τ).kc
      · have hc' : (x.2, x.1) ∈ X.cols := by
          rcases Finset.mem_union.1 hd.1 with h | h
          · exact hV.2.1 h
          · exact hcols h
        have hk' : x ∈ X.kc := by
          rcases Finset.mem_union.1 hd.2 with h | h
          · exact hV.2.2.2.2.1 h
          · exact hkc h
        exact R.svc_closed_pc hU hc' hk'
      · exact hF.2.2.2.2.2 (Finset.mem_filter.2 ⟨Finset.mem_sdiff.2 ⟨hx, hk⟩, hd⟩)

/-- **Both sides of an honest pair**, as items of a holding. -/
def Sides (K : P3ChainKnow n) : HPt n → Prop
  | .chain L v p => (∀ u, ovBlock R.G v p = some u → K.labKnown L u) ∧ (2 ≤ p → (L, v, p - 1) ∈ K.hs) ∧
      (L, v, p) ∈ K.hs ∧ (L, v, p) ∈ K.rs
  | .low w => K.keyKnown R.G 0 w ∧ K.lowKnown w
  | .top u => (∀ w, (u, w) ∈ K.pc) ∧ u ∈ K.tops

section Closed

variable {ω : P3COmega n wc} {h : LazyPerm.History (P3Alpha n wc)} {K₀ : P3ChainKnow n} (hU : InU K₀)
include hU

/-- A chain pair fixed in `h` with its input known has its output known. -/
theorem chain_fwd {L : Fin 2} {v : Fin n} {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ ovCalls R.G v)
    (hd : R.xin ω L v p ∈ h.dom (.inr ())) (hcall : (R.svc ω h K₀).canCall R.G L v p) :
    (L, v, p) ∈ (R.svc ω h K₀).hs ∧ (L, v, p) ∈ (R.svc ω h K₀).rs := by
  classical
  have hle := R.svc_step_le ω h hU
  refine ⟨hle.2.2.1 (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, Or.inl ⟨hd, hcall⟩⟩)),
    hle.2.2.2.1 (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, Or.inl ⟨hd, hcall⟩⟩))⟩

/-- A chain pair fixed in `h` with its output known has its input known. -/
theorem chain_inv {L : Fin 2} {v : Fin n} {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ ovCalls R.G v)
    (hd : R.xin ω L v p ∈ h.dom (.inr ())) (hh : (L, v, p) ∈ (R.svc ω h K₀).hs)
    (hr : (L, v, p) ∈ (R.svc ω h K₀).rs) :
    (∀ u, ovBlock R.G v p = some u → (R.svc ω h K₀).labKnown L u) ∧ (2 ≤ p → (L, v, p - 1) ∈ (R.svc ω h K₀).hs) := by
  classical
  have hle := R.svc_step_le ω h hU
  refine ⟨fun u hb => ?_, fun h2 => ?_⟩
  · by_cases hL : L = 0
    · subst hL
      rw [labKnown_zero]
      exact fun x => hle.2.1 (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _,
        Or.inr ⟨(0, v, p), hh, hr, rfl, hp1, hp, hd, hb⟩⟩))
    · have hL1 : L = 1 := by fin_cases L <;> simp_all
      subst hL1
      rw [labKnown_one]
      exact hle.1 (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _,
        Or.inr ⟨(1, v, p), hh, hr, rfl, hp1, hp, hd, hb⟩⟩))
  · have hp' : p - 1 + 1 = p := by omega
    refine hle.2.2.1 (Finset.mem_union_right _ (Finset.mem_filter.2 ⟨R.mem_pos (by omega), by simp; omega,
      by simp; omega, Or.inr ⟨by simp; omega, ?_, ?_, ?_⟩⟩))
    · simp only; rwa [hp']
    · simp only; rwa [hp']
    · simp only; rwa [hp']

theorem low_fwd {w : Fin n} (hd : R.pin1 ω w ∈ h.dom (.inl (R.tag, 0, w)))
    (hk : (R.svc ω h K₀).keyKnown R.G 0 w) : (R.svc ω h K₀).lowKnown w := by
  classical
  exact fun x => (R.svc_step_le ω h hU).2.1 (Finset.mem_union_right _ (Finset.mem_filter.2
    ⟨Finset.mem_univ _, Or.inl ⟨hd, hk⟩⟩))

theorem low_inv {w : Fin n} (hd : R.pin1 ω w ∈ h.dom (.inl (R.tag, 0, w)))
    (hl : (R.svc ω h K₀).lowKnown w) : (R.svc ω h K₀).keyKnown R.G 0 w := by
  classical
  exact (R.svc_step_le ω h hU).2.2.2.1 (Finset.mem_union_right _ (Finset.mem_filter.2
    ⟨R.mem_pos le_rfl, ovCalls_pos R.G w, le_rfl, Or.inr ⟨rfl, rfl, hd, hl⟩⟩))

theorem top_fwd {u : Fin n} (hd : R.pin2 ω u ∈ h.dom (.inl (R.tag, 1, u)))
    (hk : ∀ w, (u, w) ∈ (R.svc ω h K₀).pc) : u ∈ (R.svc ω h K₀).tops := by
  classical
  exact (R.svc_step_le ω h hU).1 (Finset.mem_union_right _ (Finset.mem_filter.2
    ⟨Finset.mem_univ _, Or.inl ⟨hd, hk⟩⟩))

theorem top_inv {u : Fin n} (hd : R.pin2 ω u ∈ h.dom (.inl (R.tag, 1, u)))
    (ht : u ∈ (R.svc ω h K₀).tops) : ∀ w, (u, w) ∈ (R.svc ω h K₀).pc := by
  classical
  exact fun w => (R.svc_step_le ω h hU).2.2.2.2.2 (Finset.mem_union_right _ (Finset.mem_filter.2
    ⟨Finset.mem_univ _, hd, ht⟩))

/-- A top pad whose key components are all known has its key known. -/
theorem key_of_kc_svc {v : Fin n} (hk : ∀ w, (v, w) ∈ (R.svc ω h K₀).kc) :
    ((1 : Fin 2), v, ovCalls R.G v) ∈ (R.svc ω h K₀).rs :=
  (R.svc_asm_le ω h hU).2.2.2.1 ((P3ChainKnow.mem_asm_rs R.G _ 1 v _).2
    (Or.inr ⟨rfl, rfl, fun w => Or.inl ((P3ChainKnow.mem_kc1 R.G _ v w).2 (Or.inl (hk w)))⟩))

end Closed

theorem enc_S_fwd {mq : (p3ChainModel n wc).Qry} {x : Bits (n * wc + (n * wc + 512))}
    (h : enc n wc mq = ⟨.inr (), .inl x⟩) : mq = .inl (.inl x) := by
  rcases mq with (x' | y') | ⟨T', a' | b'⟩
  all_goals first
    | (have hf := congrArg Sigma.fst h; simp [enc] at hf; done)
    | (have hl := congrArg (fun e : LazyPerm.Qry (P3Alpha n wc) => e.2.isLeft) h; simp [enc] at hl; done)
    | skip
  simp only [enc] at h
  rw [Sum.inl.inj (eq_of_heq (Sigma.mk.inj_iff.1 h).2)]

theorem enc_S_inv {mq : (p3ChainModel n wc).Qry} {y : Bits (n * wc + (n * wc + 512))}
    (h : enc n wc mq = ⟨.inr (), .inr y⟩) : mq = .inl (.inr y) := by
  rcases mq with (x' | y') | ⟨T', a' | b'⟩
  all_goals first
    | (have hf := congrArg Sigma.fst h; simp [enc] at hf; done)
    | (have hl := congrArg (fun e : LazyPerm.Qry (P3Alpha n wc) => e.2.isLeft) h; simp [enc] at hl; done)
    | skip
  simp only [enc] at h
  rw [Sum.inr.inj (eq_of_heq (Sigma.mk.inj_iff.1 h).2)]

theorem enc_P_fwd {mq : (p3ChainModel n wc).Qry} {T : Tweak n} {a : Lab n wc}
    (h : enc n wc mq = ⟨.inl T, .inl a⟩) : mq = .inr (T, .inl a) := by
  rcases mq with (x' | y') | ⟨T', a' | b'⟩
  all_goals first
    | (have hf := congrArg Sigma.fst h; simp [enc] at hf; done)
    | (have hl := congrArg (fun e : LazyPerm.Qry (P3Alpha n wc) => e.2.isLeft) h; simp [enc] at hl; done)
    | skip
  simp only [enc] at h
  obtain ⟨h1, h2⟩ := Sigma.mk.inj_iff.1 h
  obtain rfl := Sum.inl.inj h1
  rw [Sum.inl.inj (eq_of_heq h2)]

theorem enc_P_inv {mq : (p3ChainModel n wc).Qry} {T : Tweak n} {b : Lab n wc}
    (h : enc n wc mq = ⟨.inl T, .inr b⟩) : mq = .inr (T, .inr b) := by
  rcases mq with (x' | y') | ⟨T', a' | b'⟩
  all_goals first
    | (have hf := congrArg Sigma.fst h; simp [enc] at hf; done)
    | (have hl := congrArg (fun e : LazyPerm.Qry (P3Alpha n wc) => e.2.isLeft) h; simp [enc] at hl; done)
    | skip
  simp only [enc] at h
  obtain ⟨h1, h2⟩ := Sigma.mk.inj_iff.1 h
  obtain rfl := Sum.inl.inj h1
  rw [Sum.inr.inj (eq_of_heq h2)]

/-- **Before the cut, the truncated strategy asks the schedule.** -/
theorem next_prog {c d : ℕ} (hc : c ≤ (sched R π).length) (hdc : d < c) :
    (stratC R c).next ((stratC R c).hist π d) = some (enc n wc ((sched R π)[d]'(by omega))) := by
  rw [stratC_hist_le R π hc d hdc.le]
  have hlen : (R.strat.hist π d).length = d := by
    unfold strat
    rw [Strategy.ofRounds_hist _ _ _ _ _ _ π d (le_trans hdc.le hc), List.length_map, List.length_take]
    exact min_eq_left (le_trans hdc.le hc)
  have h1 : (stratC R c).next (R.strat.hist π d) =
      R.strat.next (R.strat.hist π d) := by
    show (if _ < c then _ else _) = _
    simp only [hlen, hdc, ↓reduceIte]
  rw [h1]
  unfold strat
  exact Strategy.ofRounds_next _ _ _ _ _ _ π (lt_of_lt_of_le hdc hc)

/-- **The backing lemma, program case.** A pair decided at a program step `d < j ≤ c` has both sides in the
step-level closure at `j`: its query side was shown at `d`, so it is in the closure (`shownAtC_le_svc`), and the pair
rule gives the other side. -/
theorem backing_prog (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c j d : ℕ} (hc : c ≤ (sched R π).length) (hjc : j ≤ c)
    (hdj : d < j) {x : HPt n} (hx : x.Valid R.G)
    (h0 : x.val R.toP3Replay ((omegaEquiv n wc).symm π) ∉ ((stratC R c).hist π d).dom (x.comp R.tag))
    (h1 : x.val R.toP3Replay ((omegaEquiv n wc).symm π) ∈ ((stratC R c).hist π (d + 1)).dom (x.comp R.tag)) {K : P3ChainKnow n}
    (hK : ∀ τ v i, i < (R.rq ((omegaEquiv n wc).symm π) τ v).length → R.off ((omegaEquiv n wc).symm π) τ v + i < j →
      P3ChainKnow.Le (R.onlineHC ((omegaEquiv n wc).symm π) c (τ + 1)) K) (hU : InU K) :
    R.Sides (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K) x := by
  classical
  obtain ⟨q, hq, _, hqq⟩ := (stratC R c).first_fix h0 h1
  have hdc : d < c := by omega
  rw [next_prog R π hc hdc] at hq
  obtain ⟨τ, hτ, v, i, hi, hdi⟩ := R.sched_decode ((omegaEquiv n wc).symm π) (d := d) (by rw [← sched_eq]; omega)
  have hsched : (sched R π)[d]'(by omega) = (R.rq ((omegaEquiv n wc).symm π) τ v)[i] := by
    have := R.roundsSeq_off ((omegaEquiv n wc).symm π) hτ v hi
    rw [← sched_eq, ← hdi] at this
    exact Option.some_inj.1 ((List.getElem?_eq_getElem (by omega)).symm.trans this)
  rw [hsched] at hq
  have hqe : enc n wc (R.rq ((omegaEquiv n wc).symm π) τ v)[i] = q := Option.some_inj.1 hq
  have hS := R.shownAtC_le_svc π hA hc hjc (τ := τ) hτ.le (fun ρ hρ => (R.roundEnd_le_off π hρ v).trans (by omega))
    (hK τ v i hi (by omega)) hU
  have hdm : ∀ {k : P3Idx n} {y : P3Alpha n wc k}, y ∈ ((stratC R c).hist π (d + 1)).dom k →
      y ∈ ((stratC R c).hist π j).dom k := fun hy => (stratC R c).dom_mono π hdj _ hy
  have hpos : R.off ((omegaEquiv n wc).symm π) τ v + i < c := by omega
  generalize hmq : (R.rq ((omegaEquiv n wc).symm π) τ v)[i] = mq at hqe
  rcases x with ⟨L, w, p⟩ | w | u
  · -- a chain pair
    obtain ⟨hp1, hp⟩ := hx
    have hdom := hdm h1
    rcases hqq with rfl | rfl
    · -- forward at the honest input: it showed the block's label and `h_{p−1}`
      obtain rfl := enc_S_fwd hqe
      have hcall : (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K).canCall R.G L w p := by
        refine ⟨hp1, hp, fun u hb => ?_, ?_⟩
        · have hsh : R.showsLabC ((omegaEquiv n wc).symm π) c (R.lab ((omegaEquiv n wc).symm π) L u) τ :=
            ⟨v, Or.inl ⟨i, hi, hpos, by rw [hmq]; simp only [showLab, HPt.val, R.xin_ovR ((omegaEquiv n wc).symm π) hb, Equiv.symm_apply_apply]⟩⟩
          by_cases hL : L = 0
          · subst hL
            rw [labKnown_zero]
            exact fun x => hS.2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hsh⟩)
          · have hL1 : L = 1 := by fin_cases L <;> simp_all
            subst hL1
            rw [labKnown_one]
            exact hS.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hsh⟩)
        · rcases Nat.lt_or_ge p 2 with h2 | h2
          · exact Or.inl (by omega)
          · refine Or.inr (hS.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos (by omega), by simp; omega, by simp; omega,
              ⟨v, i, hi, hpos, ?_⟩⟩))
            have := R.xin_ovH ((omegaEquiv n wc).symm π) (L := L) (v := w) (p := p - 1) (by omega) (by omega)
            rw [Nat.sub_add_cancel (by omega)] at this
            rw [hmq]
            simp only [showH, HPt.val, this]
      have hout := R.chain_fwd hU hp1 hp hdom hcall
      exact ⟨hcall.2.2.1, fun h2 => (hcall.2.2.2.resolve_left (by omega)), hout.1, hout.2⟩
    · -- inverse at the honest output: it showed `h_p` and `r_p`
      obtain rfl := enc_S_inv hqe
      have hh : (L, w, p) ∈ (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K).hs :=
        hS.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp, ⟨v, i, hi, hpos, by rw [hmq]; rfl⟩⟩)
      have hr : (L, w, p) ∈ (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K).rs := by
        by_cases htp : L = 1 ∧ p = ovCalls R.G w
        · obtain ⟨rfl, rfl⟩ := htp
          exact R.key_of_kc_svc hU fun x => hS.2.2.2.2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _,
            ⟨v, i, hi, hpos, by rw [hmq]; rfl⟩⟩)
        · exact hS.2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos hp, hp1, hp,
            Or.inl ⟨⟨v, i, hi, hpos, by rw [hmq]; rfl⟩, htp⟩⟩)
      have hin := R.chain_inv hU hp1 hp hdom hh hr
      exact ⟨hin.1, hin.2, hh, hr⟩
  · -- a lower `P` pair
    have hdom := hdm h1
    rcases hqq with rfl | rfl
    · obtain rfl := enc_P_fwd hqe
      have hk : (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K).keyKnown R.G 0 w :=
        hS.2.2.2.1 (Finset.mem_filter.2 ⟨R.mem_pos le_rfl, ovCalls_pos R.G w, le_rfl,
          Or.inr ⟨rfl, rfl, ⟨v, i, hi, hpos, by rw [hmq]; rfl⟩⟩⟩)
      exact ⟨hk, R.low_fwd hU hdom hk⟩
    · obtain rfl := enc_P_inv hqe
      have hl : (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K).lowKnown w := fun x =>
        hS.2.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, ⟨v, Or.inl ⟨i, hi, hpos, by
          rw [hmq]; simp only [showLab]; rw [R.c1_eq]; rfl⟩⟩⟩)
      exact ⟨R.low_inv hU hdom hl, hl⟩
  · -- a top `P` pair
    have hdom := hdm h1
    rcases hqq with rfl | rfl
    · obtain rfl := enc_P_fwd hqe
      have hk : ∀ x, (u, x) ∈ (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K).pc := fun x =>
        hS.2.2.2.2.2 (Finset.mem_filter.2 ⟨Finset.mem_univ _, ⟨v, i, hi, hpos, by rw [hmq]; rfl⟩⟩)
      exact ⟨hk, R.top_fwd hU hdom hk⟩
    · obtain rfl := enc_P_inv hqe
      have ht : u ∈ (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K).tops :=
        hS.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, ⟨v, Or.inl ⟨i, hi, hpos, by
          rw [hmq]; simp only [showLab]; rw [R.c2_eq]; rfl⟩⟩⟩)
      exact ⟨R.top_inv hU hdom ht, ht⟩

/-- **The tail asks the first unanswered labeller query**: the true trace splits as `l1 ++ q :: l2` around it,
with every query of `l1` answered in the history. -/
theorem tailOf_prefix (p : OracleProg (p3ChainModel n wc) Unit) (h : History (P3Alpha n wc))
    (hcons : ∀ e ∈ h, e.2 = ans π e.1) {x : Qry (P3Alpha n wc)} (hx : tailOf p h = some x) :
    ∃ q l1 l2, x = enc n wc q ∧ (Tr.trace (trueAns π) p).map Prod.snd = l1 ++ q :: l2 ∧
      ∀ q' ∈ l1, (histAns h (enc n wc q')).isNone = false := by
  unfold tailOf at hx
  obtain ⟨q, hfind, rfl⟩ := Option.map_eq_some_iff.1 hx
  obtain ⟨_, as, bs, hl, hbefore⟩ := List.find?_eq_some_iff_append.1 hfind
  obtain ⟨l1, l2, htr, hl1, hl2⟩ := List.map_eq_append_iff.1 hl
  obtain ⟨e, l3, rfl, he, -⟩ := List.map_eq_cons_iff.1 hl2
  have hsorted := trace_pairwise (ansOf h) p
  rw [htr] at hsorted
  have hle : ∀ a ∈ l1, a.1 ≤ e.1 := fun a ha =>
    (List.pairwise_append.1 hsorted).2.2 a ha e (List.mem_cons_self)
  have hagree : Tr.AgreeBefore (ansOf h) (trueAns π) p e.1 := by
    intro e' he' hlt
    rw [htr] at he'
    rcases List.mem_append.1 he' with h1 | h1
    · have hmem : e'.2 ∈ as := hl1 ▸ List.mem_map_of_mem h1
      have := hbefore _ hmem
      simp only [Bool.not_eq_true'] at this
      exact ansOf_eq h hcons this
    · rcases List.mem_cons.1 h1 with h2 | h2
      · subst h2; exact absurd hlt (lt_irrefl _)
      · have := (List.pairwise_append.1 hsorted).2.1
        exact absurd ((List.pairwise_cons.1 this).1 e' h2) (not_le.2 hlt)
  have hst := (Tr.trace_stable (ansOf h) (trueAns π) p e.1 hagree).1
  have htake : (Tr.trace (trueAns π) p).take (l1.length + 1) = l1 ++ [e] := by
    apply List.ext_getElem?
    intro i
    rcases Nat.lt_or_ge i (l1.length + 1) with hi | hi
    · rw [List.getElem?_take_of_lt hi]
      have hsrc : (Tr.trace (ansOf h) p)[i]? = (l1 ++ [e])[i]? := by
        rw [htr, show l1 ++ e :: l3 = (l1 ++ [e]) ++ l3 by simp, List.getElem?_append_left (by simp; omega)]
      obtain ⟨e', he'⟩ : ∃ e', (l1 ++ [e])[i]? = some e' :=
        ⟨_, List.getElem?_eq_getElem (by simp; omega)⟩
      have hr : e'.1 ≤ e.1 := by
        have hmem := List.mem_of_getElem? he'
        rcases List.mem_append.1 hmem with h1 | h1
        · exact hle e' h1
        · rw [List.mem_singleton.1 h1]
      rw [he', hst i e' (hsrc.trans he') hr]
    · rw [List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by simp; omega)]
  refine ⟨e.2, as, ((Tr.trace (trueAns π) p).drop (l1.length + 1)).map Prod.snd, by rw [he], ?_, ?_⟩
  · rw [← List.take_append_drop (l1.length + 1) (Tr.trace (trueAns π) p), List.map_append, htake]
    simp [hl1]
  · intro q' hq'
    have := hbefore q' hq'
    simpa using this


/-- An honest pair's labeller query (forward, at its honest point). -/
noncomputable def labQ (ω : P3COmega n wc) : HPt n → (p3ChainModel n wc).Qry
  | .chain L v p => .inl (.inl (R.xin ω L v p))
  | .low w => .inr ((R.tag, 0, w), .inl (R.pin1 ω w))
  | .top u => .inr ((R.tag, 1, u), .inl (R.pin2 ω u))

theorem enc_labQ (ω : P3COmega n wc) (x : HPt n) :
    enc n wc (R.labQ ω x) = ⟨x.comp R.tag, .inl (x.val R.toP3Replay ω)⟩ := by
  rcases x with ⟨L, v, p⟩ | w | u <;> rfl

/-- **In a list, the prefix before an element absent from it is determined.** -/
theorem prefix_unique {α : Type} [DecidableEq α] {a : α} {l1 l2 l1' l2' : List α} (h : l1 ++ a :: l2 = l1' ++ a :: l2')
    (h1 : a ∉ l1) (h1' : a ∉ l1') : l1 = l1' := by
  have e1 : List.idxOf a (l1 ++ a :: l2) = l1.length := by
    rw [List.idxOf_append_of_notMem h1, List.idxOf_cons_self, Nat.add_zero]
  have e2 : List.idxOf a (l1' ++ a :: l2') = l1'.length := by
    rw [List.idxOf_append_of_notMem h1', List.idxOf_cons_self, Nat.add_zero]
  rw [h] at e1
  have hlen : l1.length = l1'.length := e1.symm.trans e2
  have := congrArg (List.take l1.length) h
  rwa [List.take_left' rfl, hlen, List.take_left' rfl] at this

theorem mem_rowQ {ω : P3COmega n wc} {L : Fin 2} {pinOf : Fin n → Lab n wc → Lab n wc} {v : Fin n}
    {z : (p3ChainModel n wc).Qry} (hz : z ∈ rowQ ω R.toP3Replay L pinOf v) :
    (∃ p, 1 ≤ p ∧ p ≤ ovCalls R.G v ∧ z = .inl (.inl (R.xin ω L v p))) ∨
      z = .inr ((R.tag, L, v), .inl (pinOf v (R.key ω L v))) := by
  unfold rowQ at hz
  rcases List.mem_append.1 hz with h | h
  · obtain ⟨i, hi, rfl⟩ := List.mem_map.1 h
    exact Or.inl ⟨i + 1, by omega, by simp at hi; omega, rfl⟩
  · exact Or.inr (List.mem_singleton.1 h)

theorem mem_take_finRange {k : ℕ} {u : Fin n} : u ∈ (List.finRange n).take k ↔ u.val < k := by
  constructor
  · intro h
    obtain ⟨i, hi, hu⟩ := List.mem_iff_getElem.1 h
    rw [List.getElem_take, List.getElem_finRange] at hu
    rw [← hu]
    simp only [List.length_take, List.length_finRange] at hi
    simp; omega
  · intro h
    refine List.mem_iff_getElem.2 ⟨u.val, by simp; omega, ?_⟩
    rw [List.getElem_take, List.getElem_finRange]
    rfl

theorem finRange_split' (v : Fin n) :
    List.finRange n = (List.finRange n).take v.val ++ v :: (List.finRange n).drop (v.val + 1) := by
  have h : (List.finRange n).drop v.val = v :: (List.finRange n).drop (v.val + 1) := by
    rw [List.drop_eq_getElem_cons (by simp)]
    simp
  rw [← h, List.take_append_drop]

theorem layer_split {β : Type} (g : Fin n → List β) (v : Fin n) :
    (List.finRange n).flatMap g =
      ((List.finRange n).take v.val).flatMap g ++ g v ++ ((List.finRange n).drop (v.val + 1)).flatMap g := by
  conv_lhs => rw [finRange_split' v]
  rw [List.flatMap_append, List.flatMap_cons, List.append_assoc]

theorem range_map_split {β : Type} (f : ℕ → β) {k m : ℕ} (hk : k < m) :
    (List.range m).map f = (List.range k).map f ++ f k :: ((List.range m).map f).drop (k + 1) := by
  conv_lhs => rw [← List.take_append_drop (k + 1) ((List.range m).map f)]
  rw [List.take_add_one, List.getElem?_map, List.getElem?_range hk, ← List.map_take, List.take_range, min_eq_left hk.le]
  simp

variable {R} in
/-- Distinct honest chain positions are distinct points (true off `p3Bad`). -/
def XinDistinct (ω : P3COmega n wc) : Prop :=
  ∀ (L L' : Fin 2) (v v' : Fin n) (p p' : ℕ), 1 ≤ p → p ≤ ovCalls R.G v → 1 ≤ p' → p' ≤ ovCalls R.G v' →
    (L, v, p) ≠ (L', v', p') → R.xin ω L v p ≠ R.xin ω L' v' p'


/-- **No foreign tail query fixes a segment point**: every query of the tail outside the segment's labeller block is
neither the forward query at a segment's honest point nor the inverse one at its image. -/
def Foreign (π : Oracle (P3Alpha n wc)) : Prop :=
  ∀ q ∈ R.pre ((omegaEquiv n wc).symm π) ++ R.post ((omegaEquiv n wc).symm π), ∀ x : HPt n, x.Valid R.G →
    enc n wc q ≠ ⟨x.comp R.tag, .inl (x.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩ ∧
    enc n wc q ≠ ⟨x.comp R.tag, .inr (π (x.comp R.tag) (x.val R.toP3Replay ((omegaEquiv n wc).symm π)))⟩

/-- **The good event for a segment**: its honest chain points are distinct, and no foreign tail query fixes one of its
points. Off `JBad` both hold (`good_of_not_JBad`). -/
def Good (π : Oracle (P3Alpha n wc)) : Prop := R.XinDistinct ((omegaEquiv n wc).symm π) ∧ R.Foreign π

/-- The labeller's true trace against `ω`. -/
noncomputable def labList (ω : P3COmega n wc) : List (p3ChainModel n wc).Qry :=
  (List.finRange n).flatMap (rowQ ω R.toP3Replay 0 fun v key => labXor (R.W v) key) ++
    (List.finRange n).flatMap (rowQ ω R.toP3Replay 1 fun v key => labXor (transpose (R.c1 ω) v) key)

/-- The labeller queries upstream of an honest pair appear before it: in any split of the labeller's trace around
the pair's query whose prefix lacks that query. -/
def UpIn (ω : P3COmega n wc) (l : List (p3ChainModel n wc).Qry) : HPt n → Prop
  | .chain L v p => (2 ≤ p → R.labQ ω (.chain L v (p - 1)) ∈ l) ∧
      ∀ u, ovBlock R.G v p = some u → R.labQ ω (if L = 0 then .low u else .top u) ∈ l
  | .low w => R.labQ ω (.chain 0 w (ovCalls R.G w)) ∈ l
  | .top u => R.labQ ω (.chain 1 u (ovCalls R.G u)) ∈ l ∧ ∀ w, R.labQ ω (.low w) ∈ l

theorem pQ_mem {ω : P3COmega n wc} {L : Fin 2} {pinOf : Fin n → Lab n wc → Lab n wc} {k : ℕ} {u : Fin n}
    (hu : u.val < k) :
    (.inr ((R.tag, L, u), .inl (pinOf u (R.key ω L u))) : (p3ChainModel n wc).Qry) ∈
      ((List.finRange n).take k).flatMap (rowQ ω R.toP3Replay L pinOf) :=
  List.mem_flatMap.2 ⟨u, mem_take_finRange.2 hu, List.mem_append_right _ (List.mem_singleton_self _)⟩

theorem pQ_mem_all {ω : P3COmega n wc} {L : Fin 2} {pinOf : Fin n → Lab n wc → Lab n wc} (u : Fin n) :
    (.inr ((R.tag, L, u), .inl (pinOf u (R.key ω L u))) : (p3ChainModel n wc).Qry) ∈
      (List.finRange n).flatMap (rowQ ω R.toP3Replay L pinOf) :=
  List.mem_flatMap.2 ⟨u, List.mem_finRange u, List.mem_append_right _ (List.mem_singleton_self _)⟩

/-- A query in the rows before `v` of layer `L` is not `(L, v)`'s: a chain point of another row, or another row's
`P` query. -/
theorem mem_take_rows {ω : P3COmega n wc} {L : Fin 2} {pinOf : Fin n → Lab n wc → Lab n wc} {k : ℕ}
    {z : (p3ChainModel n wc).Qry} (hz : z ∈ ((List.finRange n).take k).flatMap (rowQ ω R.toP3Replay L pinOf)) :
    ∃ u : Fin n, u.val < k ∧ ((∃ p, 1 ≤ p ∧ p ≤ ovCalls R.G u ∧ z = .inl (.inl (R.xin ω L u p))) ∨
      z = .inr ((R.tag, L, u), .inl (pinOf u (R.key ω L u)))) := by
  obtain ⟨u, hu, hz⟩ := List.mem_flatMap.1 hz
  exact ⟨u, mem_take_finRange.1 hu, R.mem_rowQ hz⟩

theorem mem_all_rows {ω : P3COmega n wc} {L : Fin 2} {pinOf : Fin n → Lab n wc → Lab n wc}
    {z : (p3ChainModel n wc).Qry} (hz : z ∈ (List.finRange n).flatMap (rowQ ω R.toP3Replay L pinOf)) :
    ∃ u : Fin n, ((∃ p, 1 ≤ p ∧ p ≤ ovCalls R.G u ∧ z = .inl (.inl (R.xin ω L u p))) ∨
      z = .inr ((R.tag, L, u), .inl (pinOf u (R.key ω L u)))) := by
  obtain ⟨u, _, hz⟩ := List.mem_flatMap.1 hz
  exact ⟨u, R.mem_rowQ hz⟩

/-- **The labeller's order**: in any split of the labeller trace around an honest pair's query whose prefix lacks
that query, the prefix holds the pair's upstream queries. -/
theorem up_answered {ω : P3COmega n wc} (hd : R.XinDistinct ω) {x : HPt n} (hx : x.Valid R.G)
    {l1 l2 : List (p3ChainModel n wc).Qry} (hsplit : R.labList ω = l1 ++ R.labQ ω x :: l2)
    (hnot : R.labQ ω x ∉ l1) : R.UpIn ω l1 x := by
  classical
  set f0 : Fin n → Lab n wc → Lab n wc := fun v key => labXor (R.W v) key
  set f1 : Fin n → Lab n wc → Lab n wc := fun v key => labXor (transpose (R.c1 ω) v) key
  have hL0 : R.labList ω = (List.finRange n).flatMap (rowQ ω R.toP3Replay 0 f0) ++ (List.finRange n).flatMap (rowQ ω R.toP3Replay 1 f1) :=
    rfl
  rcases x with ⟨L, v, p⟩ | w | u
  · -- a chain pair: the rows before `v` (and the lower layer if `L = 1`), then row `v`'s calls before `p`
    obtain ⟨hp1, hp⟩ := hx
    set fq : ℕ → (p3ChainModel n wc).Qry := fun i => .inl (.inl (R.xin ω L v (i + 1)))
    have hrow : ∀ pinOf : Fin n → Lab n wc → Lab n wc, rowQ ω R.toP3Replay L pinOf v =
        (List.range (p - 1)).map fq ++ R.labQ ω (.chain L v p) ::
          (((List.range (ovCalls R.G v)).map fq).drop p ++ [.inr ((R.tag, L, v), .inl (pinOf v (R.key ω L v)))]) := by
      intro pinOf
      have h0 : rowQ ω R.toP3Replay L pinOf v = (List.range (ovCalls R.G v)).map fq ++
          [.inr ((R.tag, L, v), .inl (pinOf v (R.key ω L v)))] := rfl
      rw [h0]
      conv_lhs => rw [range_map_split fq (show p - 1 < ovCalls R.G v by omega)]
      simp only [fq, labQ, Nat.sub_add_cancel hp1, List.append_assoc]
      rfl
    have hpre : ∀ (pre : List (p3ChainModel n wc).Qry), (∃ rest, R.labList ω = pre ++ R.labQ ω (.chain L v p) :: rest) →
        R.labQ ω (.chain L v p) ∉ pre → l1 = pre := fun pre ⟨rest, hr⟩ hn =>
      prefix_unique (hsplit.symm.trans hr) hnot hn
    have hchain_ne : ∀ {L' : Fin 2} {u : Fin n} {p' : ℕ}, 1 ≤ p' → p' ≤ ovCalls R.G u → (L', u, p') ≠ (L, v, p) →
        (.inl (.inl (R.xin ω L' u p')) : (p3ChainModel n wc).Qry) ≠ R.labQ ω (.chain L v p) := by
      intro L' u p' h1 h2 hne heq
      simp only [labQ, Sum.inl.injEq] at heq
      exact hd L' L u v p' p h1 h2 hp1 hp hne heq
    rcases (show L = 0 ∨ L = 1 by fin_cases L <;> simp) with rfl | rfl
    · -- lower layer
      set pre := ((List.finRange n).take v.val).flatMap (rowQ ω R.toP3Replay 0 f0) ++ (List.range (p - 1)).map fq
      have hl1 : l1 = pre := by
        refine hpre pre ⟨?_, ?_⟩ ?_
        · exact ((List.range (ovCalls R.G v)).map fq).drop p ++
            ([.inr ((R.tag, 0, v), .inl (f0 v (R.key ω 0 v)))] : List (p3ChainModel n wc).Qry) ++
            ((List.finRange n).drop (v.val + 1)).flatMap (rowQ ω R.toP3Replay 0 f0) ++ (List.finRange n).flatMap (rowQ ω R.toP3Replay 1 f1)
        · rw [hL0, layer_split (rowQ ω R.toP3Replay 0 f0) v, hrow f0]
          simp only [pre, List.append_assoc, List.cons_append]
        · intro hmem
          rcases List.mem_append.1 hmem with h | h
          · obtain ⟨u, hu, ⟨p', h1, h2, heq⟩ | heq⟩ := R.mem_take_rows h
            · exact hchain_ne h1 h2 (by intro e; simp only [Prod.mk.injEq] at e; omega) heq.symm
            · simp [labQ] at heq
          · obtain ⟨i, hi, heq⟩ := List.mem_map.1 h
            simp only [List.mem_range] at hi
            exact hchain_ne (by omega) (by omega) (by intro e; simp only [Prod.mk.injEq] at e; omega) heq
      rw [hl1]
      refine ⟨fun h2 => List.mem_append_right _ (List.mem_map.2 ⟨p - 2, List.mem_range.2 (by omega), ?_⟩),
        fun u hb => ?_⟩
      · simp only [fq, labQ]; congr 3; omega
      · have hu : u.val < v.val := R.G.par_lt v u ((Finset.mem_sort _).1 (List.mem_of_getElem? hb))
        exact List.mem_append_left _ (R.pQ_mem (L := 0) (pinOf := f0) hu)
    · -- top layer
      set pre := (List.finRange n).flatMap (rowQ ω R.toP3Replay 0 f0) ++
        (((List.finRange n).take v.val).flatMap (rowQ ω R.toP3Replay 1 f1) ++ (List.range (p - 1)).map fq)
      have hl1 : l1 = pre := by
        refine hpre pre ⟨?_, ?_⟩ ?_
        · exact ((List.range (ovCalls R.G v)).map fq).drop p ++
            ([.inr ((R.tag, 1, v), .inl (f1 v (R.key ω 1 v)))] : List (p3ChainModel n wc).Qry) ++
            ((List.finRange n).drop (v.val + 1)).flatMap (rowQ ω R.toP3Replay 1 f1)
        · rw [hL0, layer_split (rowQ ω R.toP3Replay 1 f1) v, hrow f1]
          simp only [pre, List.append_assoc, List.cons_append]
        · intro hmem
          rcases List.mem_append.1 hmem with h | h
          · obtain ⟨u, ⟨p', h1, h2, heq⟩ | heq⟩ := R.mem_all_rows h
            · exact hchain_ne h1 h2 (by intro e; simp only [Prod.mk.injEq] at e; exact absurd e.1 (by decide)) heq.symm
            · simp [labQ] at heq
          rcases List.mem_append.1 h with h | h
          · obtain ⟨u, hu, ⟨p', h1, h2, heq⟩ | heq⟩ := R.mem_take_rows h
            · exact hchain_ne h1 h2 (by intro e; simp only [Prod.mk.injEq] at e; omega) heq.symm
            · simp [labQ] at heq
          · obtain ⟨i, hi, heq⟩ := List.mem_map.1 h
            simp only [List.mem_range] at hi
            exact hchain_ne (by omega) (by omega) (by intro e; simp only [Prod.mk.injEq] at e; omega) heq
      rw [hl1]
      refine ⟨fun h2 => List.mem_append_right _ (List.mem_append_right _
        (List.mem_map.2 ⟨p - 2, List.mem_range.2 (by omega), ?_⟩)), fun u hb => ?_⟩
      · simp only [fq, labQ]; congr 3; omega
      · have hu : u.val < v.val := R.G.par_lt v u ((Finset.mem_sort _).1 (List.mem_of_getElem? hb))
        exact List.mem_append_right _ (List.mem_append_left _ (R.pQ_mem (L := 1) (pinOf := f1) hu))
  · -- a lower `P` pair: the rows before `w`, then row `w`'s calls
    set fq : ℕ → (p3ChainModel n wc).Qry := fun i => .inl (.inl (R.xin ω 0 w (i + 1)))
    set pre := ((List.finRange n).take w.val).flatMap (rowQ ω R.toP3Replay 0 f0) ++ (List.range (ovCalls R.G w)).map fq
    have hl1 : l1 = pre := by
      refine prefix_unique (l2' := (List.drop (w.val + 1) (List.finRange n)).flatMap (rowQ ω R.toP3Replay 0 f0) ++
          (List.finRange n).flatMap (rowQ ω R.toP3Replay 1 f1)) (hsplit.symm.trans ?_) hnot ?_
      · rw [hL0, layer_split (rowQ ω R.toP3Replay 0 f0) w]
        simp only [pre, rowQ, List.append_assoc, labQ]
        rfl
      · intro hmem
        rcases List.mem_append.1 hmem with h | h
        · obtain ⟨u, hu, ⟨p', _, _, heq⟩ | heq⟩ := R.mem_take_rows h
          · simp [labQ] at heq
          · have h1 := (Prod.mk.inj (Sum.inr.inj heq)).1
            have h2 := (Prod.mk.inj (Prod.mk.inj h1).2).2
            rw [h2] at hu
            exact lt_irrefl _ hu
        · obtain ⟨i, _, heq⟩ := List.mem_map.1 h
          simp [labQ, fq] at heq
    rw [hl1]
    refine List.mem_append_right _ (List.mem_map.2 ⟨ovCalls R.G w - 1, List.mem_range.2 (by
      have := ovCalls_pos R.G w; omega), ?_⟩)
    simp only [fq, labQ]; congr 3
  · -- a top `P` pair: the lower layer, the top rows before `u`, then row `u`'s calls
    set fq : ℕ → (p3ChainModel n wc).Qry := fun i => .inl (.inl (R.xin ω 1 u (i + 1)))
    set pre := (List.finRange n).flatMap (rowQ ω R.toP3Replay 0 f0) ++
      (((List.finRange n).take u.val).flatMap (rowQ ω R.toP3Replay 1 f1) ++ (List.range (ovCalls R.G u)).map fq)
    have hl1 : l1 = pre := by
      refine prefix_unique (l2' := (List.drop (u.val + 1) (List.finRange n)).flatMap (rowQ ω R.toP3Replay 1 f1))
        (hsplit.symm.trans ?_) hnot ?_
      · rw [hL0, layer_split (rowQ ω R.toP3Replay 1 f1) u]
        simp only [pre, rowQ, List.append_assoc, labQ]
        rfl
      · intro hmem
        rcases List.mem_append.1 hmem with h | h
        · obtain ⟨w, ⟨p', _, _, heq⟩ | heq⟩ := R.mem_all_rows h
          · simp [labQ] at heq
          · have h1 := (Prod.mk.inj (Sum.inr.inj heq)).1
            exact absurd (Prod.mk.inj (Prod.mk.inj h1).2).1 (by decide)
        rcases List.mem_append.1 h with h | h
        · obtain ⟨u', hu, ⟨p', _, _, heq⟩ | heq⟩ := R.mem_take_rows h
          · simp [labQ] at heq
          · have h1 := (Prod.mk.inj (Sum.inr.inj heq)).1
            have h2 := (Prod.mk.inj (Prod.mk.inj h1).2).2
            rw [h2] at hu
            exact lt_irrefl _ hu
        · obtain ⟨i, _, heq⟩ := List.mem_map.1 h
          simp [labQ, fq] at heq
    rw [hl1]
    refine ⟨List.mem_append_right _ (List.mem_append_right _ (List.mem_map.2 ⟨ovCalls R.G u - 1,
      List.mem_range.2 (by have := ovCalls_pos R.G u; omega), ?_⟩)), fun w =>
        List.mem_append_left _ (R.pQ_mem_all (L := 0) (pinOf := f0) w)⟩
    simp only [fq, labQ]; congr 3

theorem sides_mono {K K' : P3ChainKnow n} (hle : P3ChainKnow.Le K K') {x : HPt n} (hx : R.Sides K x) :
    R.Sides K' x := by
  rcases x with ⟨L, v, p⟩ | w | u
  · exact ⟨fun u hb => hle.labKnown (hx.1 u hb), fun h2 => hle.2.2.1 (hx.2.1 h2), hle.2.2.1 hx.2.2.1,
      hle.2.2.2.1 hx.2.2.2⟩
  · exact ⟨hle.2.2.2.1 hx.1, fun x => hle.2.1 (hx.2 x)⟩
  · exact ⟨fun w => hle.2.2.2.2.2 (hx.1 w), hle.1 hx.2⟩

theorem labList_eq : (Tr.trace (trueAns π) (labProg R.tag R.G R.W)).map Prod.snd = R.labList ((omegaEquiv n wc).symm π) := by
  rw [trueAns_symm]
  exact labProg_trace ((omegaEquiv n wc).symm π) R.toP3Replay

/-- **The backing lemma**: an honest pair fixed in the truncated history at step `j` has both sides in the
step-level closure at `j` (off `p3Bad`, every credit of the cut holding taken as known). By strong induction on the
deciding step: a program step shows its query side (`backing_prog`); a labeller step asks the first unanswered
labeller query, whose upstream pairs were fixed before (`up_answered`). -/
theorem backing (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π) {c : ℕ}
    (hc : c ≤ (sched R π).length) {K : P3ChainKnow n} (hU : InU K) :
    ∀ d (x : HPt n), x.Valid R.G → x.val R.toP3Replay ((omegaEquiv n wc).symm π) ∉ ((stratC R c).hist π d).dom (x.comp R.tag) →
      x.val R.toP3Replay ((omegaEquiv n wc).symm π) ∈ ((stratC R c).hist π (d + 1)).dom (x.comp R.tag) →
      ∀ j, d < j → (∀ τ v i, i < (R.rq ((omegaEquiv n wc).symm π) τ v).length → R.off ((omegaEquiv n wc).symm π) τ v + i < j →
        P3ChainKnow.Le (R.onlineHC ((omegaEquiv n wc).symm π) c (τ + 1)) K) →
      R.Sides (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K) x := by
  classical
  have hdist := hnb.1
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
  intro x hx h0 h1 j hdj hK
  set S := stratC R c
  set K₀ := K
  have hmonoj : ∀ {j' : ℕ}, j' ≤ j → P3ChainKnow.Le (R.svc ((omegaEquiv n wc).symm π) (S.hist π j') K₀) (R.svc ((omegaEquiv n wc).symm π) (S.hist π j) K₀) :=
    fun hj' => R.svc_mono ((omegaEquiv n wc).symm π) (fun i => S.dom_mono π hj' i) (P3ChainKnow.Le.rfl' _)
  rcases Nat.lt_or_ge d c with hdc | hdc
  · -- a program step
    rcases le_or_gt j c with hjc | hjc
    · exact R.backing_prog π hA hc hjc hdj hx h0 h1 hK hU
    · exact R.sides_mono (hmonoj hjc.le) (R.backing_prog π hA hc le_rfl hdc hx h0 h1
        (fun τ v i hi h => hK τ v i hi (by omega)) hU)
  · -- a labeller step: the tail asked the pair's labeller query
    obtain ⟨q, hq, _, hqq⟩ := S.first_fix h0 h1
    have hlen := S.length_hist_of_next hq
    rw [stratC_next_tail R (h := S.hist π d) (by omega)] at hq
    obtain ⟨q', l1, l2, hqe, hsplit, hans⟩ := tailOf_prefix π _ _ (fun e he => S.mem_hist he) hq
    -- the tail's trace is `pre ++ labList ++ post`; `q'` fixes a segment point, so it is not foreign
    have htr : (Tr.trace (trueAns π) R.tailP).map Prod.snd = R.pre ((omegaEquiv n wc).symm π) ++
        R.labList ((omegaEquiv n wc).symm π) ++ R.post ((omegaEquiv n wc).symm π) := by
      have e := R.hsplit ((omegaEquiv n wc).symm π)
      rw [← trueAns_symm] at e
      rw [e, R.labList_eq π]
    have hnf : q' ∉ R.pre ((omegaEquiv n wc).symm π) ++ R.post ((omegaEquiv n wc).symm π) := fun hm => by
      have hf := hnb.2 q' hm x hx
      rw [← hqe] at hf
      rcases hqq with h | h
      · exact hf.1 h
      · exact hf.2 h
    have hq'mem : q' ∈ R.labList ((omegaEquiv n wc).symm π) := by
      have hin : q' ∈ (Tr.trace (trueAns π) R.tailP).map Prod.snd := hsplit ▸ List.mem_append_right _ List.mem_cons_self
      rw [htr] at hin
      rcases List.mem_append.1 hin with h | h
      · rcases List.mem_append.1 h with h | h
        · exact absurd (List.mem_append_left _ h) hnf
        · exact h
      · exact absurd (List.mem_append_right _ h) hnf
    have hfwd : q = ⟨x.comp R.tag, .inl (x.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩ := by
      rcases hqq with h | h
      · exact h
      · exfalso
        obtain ⟨u, hz⟩ : ∃ u : Fin n, ((∃ p, 1 ≤ p ∧ p ≤ ovCalls R.G u ∧ q' = .inl (.inl (R.xin ((omegaEquiv n wc).symm π) 0 u p))) ∨
            q' = .inr ((R.tag, 0, u), .inl (labXor (R.W u) (R.key ((omegaEquiv n wc).symm π) 0 u)))) ∨
            ((∃ p, 1 ≤ p ∧ p ≤ ovCalls R.G u ∧ q' = .inl (.inl (R.xin ((omegaEquiv n wc).symm π) 1 u p))) ∨
            q' = .inr ((R.tag, 1, u), .inl (labXor (transpose (R.c1 ((omegaEquiv n wc).symm π)) u) (R.key ((omegaEquiv n wc).symm π) 1 u)))) := by
          rcases List.mem_append.1 hq'mem with hm | hm
          · obtain ⟨u, hu⟩ := R.mem_all_rows hm; exact ⟨u, Or.inl hu⟩
          · obtain ⟨u, hu⟩ := R.mem_all_rows hm; exact ⟨u, Or.inr hu⟩
        rw [h] at hqe
        have hl := congrArg (fun e : Qry (P3Alpha n wc) => e.2.isLeft) hqe
        rcases hz with (⟨p, _, _, rfl⟩ | rfl) | (⟨p, _, _, rfl⟩ | rfl) <;> simp [enc] at hl
    have hq'x : q' = R.labQ ((omegaEquiv n wc).symm π) x := by
      have e := hqe.symm.trans (hfwd.trans (R.enc_labQ ((omegaEquiv n wc).symm π) x).symm)
      rcases x with ⟨L, v, p⟩ | w | u
      · exact (enc_S_fwd (e.trans (R.enc_labQ ((omegaEquiv n wc).symm π) _))).trans rfl
      · exact (enc_P_fwd (e.trans (R.enc_labQ ((omegaEquiv n wc).symm π) _))).trans rfl
      · exact (enc_P_fwd (e.trans (R.enc_labQ ((omegaEquiv n wc).symm π) _))).trans rfl
    rw [hq'x] at hsplit hq'mem hnf
    have hnot : R.labQ ((omegaEquiv n wc).symm π) x ∉ l1 := by
      intro hm
      have hs := hans _ hm
      rw [R.enc_labQ] at hs
      apply h0
      cases hh : histAns (S.hist π d) ⟨x.comp R.tag, .inl (x.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩ with
      | none => rw [hh] at hs; simp at hs
      | some a =>
        obtain ⟨e, he, hee⟩ : ∃ e ∈ S.hist π d, e.1 = ⟨x.comp R.tag, .inl (x.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩ := by
          by_contra hno
          push Not at hno
          rw [(histAns_none_iff _ _).2 hno] at hh
          exact absurd hh (by simp)
        refine History.mem_dom.2 ⟨e, he, ?_⟩
        obtain ⟨⟨k, dd⟩, a'⟩ := e
        obtain ⟨rfl, hd'⟩ := Sigma.mk.inj_iff.1 hee
        rw [heq_eq_eq] at hd'
        subst hd'
        simp [Entry.inpAt, Entry.inp]
    -- split the labeller block at the query's first occurrence: its prefix is in `l1`
    set LL := R.labList ((omegaEquiv n wc).symm π)
    set qx := R.labQ ((omegaEquiv n wc).symm π) x
    have hi : LL.idxOf qx < LL.length := List.idxOf_lt_length_iff.2 hq'mem
    have hLL : LL = LL.take (LL.idxOf qx) ++ qx :: LL.drop (LL.idxOf qx + 1) := by
      have e : LL.drop (LL.idxOf qx) = qx :: LL.drop (LL.idxOf qx + 1) := by
        rw [List.drop_eq_getElem_cons hi, List.getElem_idxOf hi]
      rw [← e, List.take_append_drop]
    have hnA : qx ∉ LL.take (LL.idxOf qx) := fun hm => by
      have e1 : LL.idxOf qx = (LL.take (LL.idxOf qx)).idxOf qx := by
        conv_lhs => rw [← List.take_append_drop (LL.idxOf qx) LL]
        exact List.idxOf_append_of_mem hm
      have e2 := List.idxOf_lt_length_iff.2 hm
      rw [List.length_take] at e2
      omega
    have hl1 : l1 = R.pre ((omegaEquiv n wc).symm π) ++ LL.take (LL.idxOf qx) := by
      refine prefix_unique (a := qx) (l2 := l2) (l2' := LL.drop (LL.idxOf qx + 1) ++ R.post ((omegaEquiv n wc).symm π))
        ?_ hnot ?_
      · rw [← hsplit, htr]
        conv_lhs => rw [hLL]
        simp only [List.append_assoc, List.cons_append]
      · intro hm
        rcases List.mem_append.1 hm with h | h
        · exact hnf (List.mem_append_left _ h)
        · exact hnA h
    have hup := R.up_answered hdist hx hLL hnA
    -- an upstream query answered before `d` is a pair fixed before `d`, so the induction applies
    have hprev : ∀ y : HPt n, y.Valid R.G → R.labQ ((omegaEquiv n wc).symm π) y ∈ LL.take (LL.idxOf qx) →
        R.Sides (R.svc ((omegaEquiv n wc).symm π) (S.hist π j) K₀) y := by
      intro y hy hm
      have hs := hans _ (hl1 ▸ List.mem_append_right _ hm)
      rw [R.enc_labQ] at hs
      have hdom : y.val R.toP3Replay ((omegaEquiv n wc).symm π) ∈ (S.hist π d).dom (y.comp R.tag) := by
        cases hh : histAns (S.hist π d) ⟨y.comp R.tag, .inl (y.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩ with
        | none => rw [hh] at hs; simp at hs
        | some a =>
          obtain ⟨e, he, hee⟩ : ∃ e ∈ S.hist π d, e.1 = ⟨y.comp R.tag, .inl (y.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩ := by
            by_contra hno
            push Not at hno
            rw [(histAns_none_iff _ _).2 hno] at hh
            exact absurd hh (by simp)
          refine History.mem_dom.2 ⟨e, he, ?_⟩
          obtain ⟨⟨k, dd⟩, a'⟩ := e
          obtain ⟨rfl, hd'⟩ := Sigma.mk.inj_iff.1 hee
          rw [heq_eq_eq] at hd'
          subst hd'
          simp [Entry.inpAt, Entry.inp]
      obtain ⟨dy, hdy, hy0, hy1⟩ := S.exists_first_fix hdom
      exact ih dy hdy y hy hy0 hy1 j (by omega) hK
    have hdomj : x.val R.toP3Replay ((omegaEquiv n wc).symm π) ∈ (S.hist π j).dom (x.comp R.tag) := S.dom_mono π hdj _ h1
    rcases x with ⟨L, v, p⟩ | w | u
    · obtain ⟨hp1, hp⟩ := hx
      have hblk : ∀ u, ovBlock R.G v p = some u → (R.svc ((omegaEquiv n wc).symm π) (S.hist π j) K₀).labKnown L u := by
        intro u hb
        have hu := hup.2 u hb
        rcases (show L = 0 ∨ L = 1 by fin_cases L <;> simp) with rfl | rfl
        · have := hprev (.low u) trivial (by simpa using hu)
          rw [labKnown_zero]; exact this.2
        · have := hprev (.top u) trivial (by simpa using hu)
          rw [labKnown_one]; exact this.2
      have hprevh : 2 ≤ p → (L, v, p - 1) ∈ (R.svc ((omegaEquiv n wc).symm π) (S.hist π j) K₀).hs := fun h2 =>
        (hprev (.chain L v (p - 1)) ⟨by omega, by omega⟩ (hup.1 h2)).2.2.1
      have hcall : (R.svc ((omegaEquiv n wc).symm π) (S.hist π j) K₀).canCall R.G L v p :=
        ⟨hp1, hp, hblk, by rcases Nat.lt_or_ge p 2 with h | h; exact Or.inl (by omega); exact Or.inr (hprevh h)⟩
      have hout := R.chain_fwd hU hp1 hp hdomj hcall
      exact ⟨hblk, hprevh, hout.1, hout.2⟩
    · have hk := (hprev (.chain 0 w (ovCalls R.G w)) ⟨ovCalls_pos R.G w, le_rfl⟩ hup).2.2.2
      exact ⟨hk, R.low_fwd hU hdomj hk⟩
    · have hkey := (hprev (.chain 1 u (ovCalls R.G u)) ⟨ovCalls_pos R.G u, le_rfl⟩ hup.1).2.2.2
      have hpc : ∀ w, (u, w) ∈ (R.svc ((omegaEquiv n wc).symm π) (S.hist π j) K₀).pc := by
        intro w
        have hlow := (hprev (.low w) trivial (hup.2 w)).2
        have hkc : (u, w) ∈ (R.svc ((omegaEquiv n wc).symm π) (S.hist π j) K₀).kc :=
          (R.svc_asm_le ((omegaEquiv n wc).symm π) _ hU).2.2.2.2.1 ((P3ChainKnow.mem_asm_kc R.G _ u w).2
            (Or.inl ((P3ChainKnow.mem_kc1 R.G _ u w).2 (Or.inr hkey))))
        exact R.svc_closed_pc hU (hlow u) hkc
      exact ⟨hpc, R.top_fwd hU hdomj hpc⟩

end P3SegT

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainCharge ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

/-- **Honest cells**: component `k` of label `(L, u)` (`c¹_u` or `c²_u`); component `k < n` or the capacity `k = n`
of `h_{L,v,p}`; component `k` of `r_{L,v,p}` (the top pad's is `key²`); component `w` of `pin2_u`. -/
inductive HCell (n : ℕ) where
  | lab (L : Fin 2) (u k : Fin n)
  | hc (L : Fin 2) (v : Fin n) (p : ℕ) (k : Fin (n + 1))
  | rc (L : Fin 2) (v : Fin n) (p : ℕ) (k : Fin n)
  | pin2 (u w : Fin n)
  deriving DecidableEq

namespace HCell

variable {n : ℕ}

/-- The pair a cell is an output of (`pin2` is the top pair's input). -/
def home : HCell n → HPt n
  | .lab L u _ => if L = 0 then .low u else .top u
  | .hc L v p _ => .chain L v p
  | .rc L v p _ => .chain L v p
  | .pin2 u _ => .top u

/-- A cell is on its home's output side (every cell but `pin2`). -/
def isOut : HCell n → Bool
  | .pin2 .. => false
  | _ => true

/-- A cell's position in its home's answer: a `Π₂` answer has the left components `0 … n − 1`, the right ones
`n … 2n − 1` and the capacity `2n`; a `P` answer has its components `0 … n − 1`. -/
def pos : HCell n → ℕ
  | .lab _ _ k => k
  | .hc _ _ _ k => n + k
  | .rc _ _ _ k => k
  | .pin2 _ w => w

/-- A cell's width in bits. -/
def bits (wc : ℕ) : HCell n → ℕ
  | .hc _ _ _ k => if (k : ℕ) = n then 512 else wc
  | _ => wc

/-- A cell's item is in a holding. -/
def known (G : TopoDAG n) (K : P3ChainKnow n) : HCell n → Prop
  | .lab L u k => if L = 0 then (u, k) ∈ K.cols else u ∈ K.tops
  | .hc L v p _ => (L, v, p) ∈ K.hs
  | .rc L v p k => if L = 1 ∧ p = ovCalls G v then (v, k) ∈ K.kc else (L, v, p) ∈ K.rs
  | .pin2 u w => (u, w) ∈ K.pc

theorem known_mono {G : TopoDAG n} {K K' : P3ChainKnow n} (hle : P3ChainKnow.Le K K') {c : HCell n}
    (h : c.known G K) : c.known G K' := by
  rcases c with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  · by_cases hL : L = 0
    · simp only [known, hL, reduceIte] at h ⊢; exact hle.2.1 h
    · simp only [known, hL, reduceIte] at h ⊢; exact hle.1 h
  · exact hle.2.2.1 h
  · by_cases hL : L = 1 ∧ p = ovCalls G v
    · simp only [known, hL, and_self, reduceIte] at h ⊢; exact hle.2.2.2.2.1 h
    · simp only [known, hL, reduceIte] at h ⊢; exact hle.2.2.2.1 h
  · exact hle.2.2.2.2.2 h

end HCell

/-- **The cell at position `k` of side `out` of an honest pair** (`none`: a public constant, or no cell). A chain
call's input is its block (a parent label of its layer, or the pad) and `h_{p−1}` (the IV at `p = 1`); a lower `P`
input is `pin1 = W ⊕ key¹`, whose cells are `key¹`'s; a top `P` input is `pin2`. -/
def cellAt {n : ℕ} (G : TopoDAG n) : HPt n → Bool → ℕ → Option (HCell n)
  | .chain L v p, true, k =>
      if h : k < n then some (.rc L v p ⟨k, h⟩)
      else if h' : k - n < n + 1 then some (.hc L v p ⟨k - n, h'⟩) else none
  | .chain L v p, false, k =>
      if h : k < n then (match ovBlock G v p with | some u => some (.lab L u ⟨k, h⟩) | none => none)
      else if p ≤ 1 then none
      else if h' : k - n < n + 1 then some (.hc L v (p - 1) ⟨k - n, h'⟩) else none
  | .low w, true, k => if h : k < n then some (.lab 0 w ⟨k, h⟩) else none
  | .low w, false, k => if h : k < n then some (.rc 0 w (ovCalls G w) ⟨k, h⟩) else none
  | .top u, true, k => if h : k < n then some (.lab 1 u ⟨k, h⟩) else none
  | .top u, false, k => if h : k < n then some (.pin2 u ⟨k, h⟩) else none

namespace HCell

variable {n : ℕ}

/-- The cell at the same position on the other side of its home. -/
def partner (G : TopoDAG n) (c : HCell n) : Option (HCell n) := cellAt G c.home (!c.isOut) c.pos

/-- A valid cell: chain cells at real calls. -/
def Valid (G : TopoDAG n) : HCell n → Prop
  | .hc _ v p _ => 1 ≤ p ∧ p ≤ ovCalls G v
  | .rc _ v p _ => 1 ≤ p ∧ p ≤ ovCalls G v
  | _ => True

theorem home_valid {G : TopoDAG n} {c : HCell n} (hc : c.Valid G) : c.home.Valid G := by
  rcases c with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  · by_cases hL : L = 0 <;> simp [home, hL, HPt.Valid]
  · exact hc
  · exact hc
  · trivial

/-- **A cell sits at its own position on its own side.** -/
theorem cellAt_self (G : TopoDAG n) (c : HCell n) : cellAt G c.home c.isOut c.pos = some c := by
  rcases c with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  · have : L = 0 ∨ L = 1 := by fin_cases L <;> simp
    rcases this with rfl | rfl <;> simp [home, isOut, pos, cellAt, k.isLt]
  · simp [home, isOut, pos, cellAt, k.isLt]
  · simp [home, isOut, pos, cellAt, k.isLt]
  · simp [home, isOut, pos, cellAt, w.isLt]

/-- **The cell at a position has that position.** -/
theorem pos_of_cellAt {G : TopoDAG n} {x : HPt n} {o : Bool} {k : ℕ} {c : HCell n} (h : cellAt G x o k = some c) :
    c.pos = k := by
  rcases x with ⟨L, v, p⟩ | w | u <;> rcases o with _ | _
  · simp only [cellAt] at h
    split_ifs at h with h1 h2 h3
    · cases hb : ovBlock G v p with
      | none => rw [hb] at h; simp at h
      | some u => rw [hb] at h; simp at h; subst h; rfl
    · simp at h; subst h; simp [pos]; omega
  · simp only [cellAt] at h
    split_ifs at h with h1 h2
    · simp at h; subst h; rfl
    · simp at h; subst h; simp [pos]; omega
  all_goals (simp only [cellAt] at h; split_ifs at h; simp at h; subst h; rfl)


/-- **Cells at the same position of the same side of a pair are equal.** -/
theorem cellAt_inj {G : TopoDAG n} {x : HPt n} {o : Bool} {k : ℕ} {c c' : HCell n}
    (h : cellAt G x o k = some c) (h' : cellAt G x o k = some c') : c = c' :=
  Option.some_inj.1 (h.symm.trans h')

/-- **Two cells with the same home, side and position are equal.** -/
theorem eq_of_home {G : TopoDAG n} {c c' : HCell n} (hh : c.home = c'.home) (ho : c.isOut = c'.isOut)
    (hp : c.pos = c'.pos) : c = c' := by
  have h1 := cellAt_self G c
  have h2 := cellAt_self G c'
  rw [hh, ho, hp] at h1
  exact cellAt_inj h1 h2

end HCell

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι)

/-- **Both sides of a pair give every cell of both sides**, in a holding closed under key assembly. -/
theorem sides_cells {K : P3ChainKnow n} (hasm : P3ChainKnow.Le (K.assemble R.G) K) {x : HPt n} (hx : R.Sides K x)
    {o : Bool} {k : ℕ} {c : HCell n} (h : cellAt R.G x o k = some c) : c.known R.G K := by
  rcases x with ⟨L, v, p⟩ | w | u <;> rcases o with _ | _
  · simp only [cellAt] at h
    split_ifs at h with h1 h2 h3
    · cases hb : ovBlock R.G v p with
      | none => rw [hb] at h; simp at h
      | some u =>
        rw [hb] at h; simp at h; subst h
        have hl := hx.1 u hb
        by_cases hL : L = 0
        · subst hL; rw [labKnown_zero] at hl; simp only [HCell.known, reduceIte]; exact hl _
        · rw [(show P3ChainKnow.labKnown K L u ↔ u ∈ K.tops by simp [P3ChainKnow.labKnown, hL])] at hl
          simp only [HCell.known, hL, reduceIte]; exact hl
    · simp at h; subst h; exact hx.2.1 (by omega)
  · simp only [cellAt] at h
    split_ifs at h with h1 h2
    · simp at h; subst h
      simp only [HCell.known]
      split_ifs with htp
      · obtain ⟨rfl, rfl⟩ := htp
        exact hasm.2.2.2.2.1 ((P3ChainKnow.mem_asm_kc R.G _ _ _).2
          (Or.inl ((P3ChainKnow.mem_kc1 R.G _ _ _).2 (Or.inr hx.2.2.2))))
      · exact hx.2.2.2
    · simp at h; subst h; exact hx.2.2.1
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h
    simp only [HCell.known]; exact hx.1
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h
    simp only [HCell.known, reduceIte]; exact hx.2 _
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h
    exact hx.1 _
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h
    simp only [HCell.known]; exact hx.2

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))


/-- A pair is fixed in the truncated history at step `j`. -/
def Fixed (c j : ℕ) (x : HPt n) : Prop :=
  x.val R.toP3Replay ((omegaEquiv n wc).symm π) ∈ ((stratC R c).hist π j).dom (x.comp R.tag)

/-- **A pair's first fresh step** in the truncated run (the step whose query fixes it). -/
noncomputable def dstep (c : ℕ) (x : HPt n) : ℕ :=
  Classical.epsilon fun j => ¬ R.Fixed π c j x ∧ R.Fixed π c (j + 1) x

theorem fixed_mono {c j j' : ℕ} (h : j ≤ j') {x : HPt n} (hx : R.Fixed π c j x) : R.Fixed π c j' x :=
  (stratC R c).dom_mono π h _ hx

theorem first_unique {c j j' : ℕ} {x : HPt n} (h : ¬ R.Fixed π c j x ∧ R.Fixed π c (j + 1) x)
    (h' : ¬ R.Fixed π c j' x ∧ R.Fixed π c (j' + 1) x) : j = j' := by
  rcases lt_trichotomy j j' with hlt | heq | hgt
  · exact absurd (R.fixed_mono π (show j + 1 ≤ j' by omega) h.2) h'.1
  · exact heq
  · exact absurd (R.fixed_mono π (show j' + 1 ≤ j by omega) h'.2) h.1

/-- **The first fresh step exists and is before the end of the truncated run.** -/
theorem dstep_spec {c : ℕ} (hc : c ≤ (sched R π).length) {x : HPt n} (hx : x.Valid R.G) :
    ¬ R.Fixed π c (R.dstep π c x) x ∧ R.Fixed π c (R.dstep π c x + 1) x ∧
      R.dstep π c x < c + R.tailP.work (trueAns π) := by
  obtain ⟨j, hj, h0, h1⟩ := (stratC R c).exists_first_fix (honest_fixed_C R π hc x hx)
  have hs := Classical.epsilon_spec (p := fun j => ¬ R.Fixed π c j x ∧ R.Fixed π c (j + 1) x) ⟨j, h0, h1⟩
  refine ⟨hs.1, hs.2, ?_⟩
  have e := R.first_unique π hs ⟨h0, h1⟩
  unfold dstep
  rw [e]
  exact hj


/-- The pair was fixed by the forward query at its input (else by the inverse query at its image). -/
def Fwd (c : ℕ) (x : HPt n) : Prop :=
  (stratC R c).next ((stratC R c).hist π (R.dstep π c x)) =
    some ⟨x.comp R.tag, .inl (x.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩

theorem dstep_query {c : ℕ} (hc : c ≤ (sched R π).length) {x : HPt n} (hx : x.Valid R.G) :
    ∃ q, (stratC R c).next ((stratC R c).hist π (R.dstep π c x)) = some q ∧
      Fresh ((stratC R c).hist π (R.dstep π c x)) q ∧
      (q = ⟨x.comp R.tag, .inl (x.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩ ∨
        q = ⟨x.comp R.tag, .inr (π (x.comp R.tag) (x.val R.toP3Replay ((omegaEquiv n wc).symm π)))⟩) :=
  (stratC R c).first_fix (R.dstep_spec π hc hx).1 (R.dstep_spec π hc hx).2.1


/-- **Distinct pairs have distinct first fresh steps** (off `p3Bad`): a step's query fixes one honest point. -/
theorem dstep_inj {c : ℕ} (hc : c ≤ (sched R π).length) (hnb : R.Good π)
    {x y : HPt n} (hx : x.Valid R.G) (hy : y.Valid R.G) (h : R.dstep π c x = R.dstep π c y) : x = y := by
  obtain ⟨q, hq, _, hqq⟩ := R.dstep_query π hc hx
  obtain ⟨q', hq', _, hqq'⟩ := R.dstep_query π hc hy
  rw [h, hq'] at hq
  obtain rfl := Option.some_inj.1 hq
  have hd := hnb.1
  rcases x with ⟨L, v, p⟩ | w | u <;> rcases y with ⟨L', v', p'⟩ | w' | u'
  · have hval : R.xin ((omegaEquiv n wc).symm π) L v p = R.xin ((omegaEquiv n wc).symm π) L' v' p' := by
      rcases hqq with e | e <;> rcases hqq' with e' | e' <;> have ee := e.symm.trans e' <;>
        simp only [HPt.comp, HPt.val] at ee <;> have ee2 := eq_of_heq (Sigma.mk.inj_iff.1 ee).2 <;>
        simp at ee2 <;> first | exact ee2 | exact (π _).injective ee2
    by_contra hne
    exact hd L L' v v' p p' hx.1 hx.2 hy.1 hy.2
      (fun h => hne (by simp only [Prod.mk.injEq] at h; obtain ⟨rfl, rfl, rfl⟩ := h; rfl)) hval
  all_goals
    rcases hqq with e | e <;> rcases hqq' with e' | e' <;>
    (have ee := congrArg Sigma.fst (e.symm.trans e'); simp [HPt.comp] at ee) <;> (try subst ee) <;> (try rfl)

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))


/-- **The round of a schedule position.** -/
noncomputable def rnd (j : ℕ) : ℕ :=
  Classical.epsilon fun τ => τ < R.D ∧ ∃ v : ι, ∃ i < (R.rq ((omegaEquiv n wc).symm π) τ v).length,
    j = R.off ((omegaEquiv n wc).symm π) τ v + i

theorem rnd_spec {j : ℕ} (hj : j < (sched R π).length) :
    R.rnd π j < R.D ∧ ∃ v : ι, ∃ i < (R.rq ((omegaEquiv n wc).symm π) (R.rnd π j) v).length,
      j = R.off ((omegaEquiv n wc).symm π) (R.rnd π j) v + i :=
  Classical.epsilon_spec (R.sched_decode ((omegaEquiv n wc).symm π) (by rw [← sched_eq]; exact hj))

/-- A schedule position before `j` is in a round `≤ rnd j`. -/
theorem le_rnd {j τ i : ℕ} {v : ι} (hj : j < (sched R π).length)
    (hi : i < (R.rq ((omegaEquiv n wc).symm π) τ v).length) (hlt : R.off ((omegaEquiv n wc).symm π) τ v + i < j) :
    τ ≤ R.rnd π j := by
  by_contra h
  obtain ⟨_, v', i', hi', he⟩ := R.rnd_spec π hj
  have h1 := R.off_add_lt ((omegaEquiv n wc).symm π) (R.rnd π j) v' hi'
  have h2 := R.roundEnd_le_off π (not_le.1 h) v
  omega

theorem rq_lt_D (hA : ∀ v, (R.A v).Bounded R.D R.Q) {τ i : ℕ} {v : ι}
    (hi : i < (R.rq ((omegaEquiv n wc).symm π) τ v).length) : τ < R.D := by
  obtain ⟨e, he, h1, _⟩ := (R.mem_rq_iff ((omegaEquiv n wc).symm π)).1 (List.getElem_mem hi)
  exact h1 ▸ (Tr.round_lt_depth _ (R.A v) e he).trans_le ((hA v) ((omegaEquiv n wc).symm π)).1

/-- **The credits readable at step `j`**: through round `rnd j` at a program step, all of them past the cut. -/
noncomputable def Kat (c j : ℕ) : P3ChainKnow n :=
  R.onlineHC ((omegaEquiv n wc).symm π) c (if j < c then R.rnd π j + 1 else R.D + 1)

theorem inU_kat (c j : ℕ) : InU (R.Kat π c j) := R.inU_onlineHC _ c _


/-- **`Kat` holds the credits of every round before a step.** -/
theorem kat_hK (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c : ℕ} (hc : c ≤ (sched R π).length) (j : ℕ) :
    ∀ τ v i, i < (R.rq ((omegaEquiv n wc).symm π) τ v).length → R.off ((omegaEquiv n wc).symm π) τ v + i < j →
      P3ChainKnow.Le (R.onlineHC ((omegaEquiv n wc).symm π) c (τ + 1)) (R.Kat π c j) := by
  intro τ v i hi hlt
  unfold Kat
  split_ifs with h
  · exact R.onlineHC_mono _ c (by have := R.le_rnd π (by omega) hi hlt; omega)
  · exact R.onlineHC_mono _ c (by have := R.rq_lt_D π hA hi; omega)


/-- **What is known at step `j`**: the step-level closure of the truncated history with the readable credits. -/
noncomputable def kn (c j : ℕ) : P3ChainKnow n :=
  R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) (R.Kat π c j)


theorem kn_asm (c j : ℕ) : P3ChainKnow.Le ((R.kn π c j).assemble R.G) (R.kn π c j) :=
  R.svc_asm_le _ _ (R.inU_kat π c j)

/-- **The cell-level backing lemma**: every cell of both sides of a pair fixed before `j` is known at `j`. -/
theorem known_of_fixed (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) {x : HPt n} (hx : x.Valid R.G) {j : ℕ} (hxj : R.dstep π c x < j)
    {o : Bool} {k : ℕ} {z : HCell n} (hz : cellAt R.G x o k = some z) : z.known R.G (R.kn π c j) := by
  have hs := R.dstep_spec π hc hx
  exact R.sides_cells (R.kn_asm π c j)
    (R.backing π hA hnb hc (R.inU_kat π c j) _ x hx hs.1 hs.2.1 j hxj (R.kat_hK π hA hc j)) hz

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))


/-- **An entry of the truncated history before the cut is a schedule query's.** -/
theorem hist_entry {c j : ℕ} (hc : c ≤ (sched R π).length) (hjc : j ≤ c) {e : Entry (P3Alpha n wc)}
    (he : e ∈ (stratC R c).hist π j) :
    ∃ k < j, ∃ q, (sched R π)[k]? = some q ∧ e = qEntry π (enc n wc) q := by
  rw [stratC_hist_le R π hc j hjc] at he
  unfold strat at he
  rw [Strategy.ofRounds_hist _ _ _ _ _ _ π j (le_trans hjc hc)] at he
  obtain ⟨q, hq, rfl⟩ := List.mem_map.1 he
  obtain ⟨k, hk, hkq⟩ := List.mem_iff_getElem.1 hq
  have hk' : k < j := by simp at hk; omega
  refine ⟨k, hk', q, ?_, rfl⟩
  rw [← hkq, List.getElem_take]
  exact List.getElem?_eq_getElem _

/-- The first step of round `τ`. -/
noncomputable def rstart (τ : ℕ) : ℕ := if τ = 0 then 0 else R.roundEnd ((omegaEquiv n wc).symm π) (τ - 1)

/-- **A schedule query before round `τ`'s start is a program's query of a round `< τ`.** -/
theorem sched_before {k τ : ℕ} {q : (p3ChainModel n wc).Qry} (hq : (sched R π)[k]? = some q) (hk : k < R.rstart π τ) :
    ∃ ρ < τ, ∃ v : ι, ∃ e ∈ R.tr ((omegaEquiv n wc).symm π) v, e.1 = ρ ∧ e.2 = q := by
  have hkl : k < (sched R π).length := (List.getElem?_eq_some_iff.1 hq).1
  obtain ⟨ρ, hρ, v, i, hi, hki⟩ := R.sched_decode ((omegaEquiv n wc).symm π) (d := k) (by rw [← sched_eq]; exact hkl)
  have hoff := R.roundsSeq_off ((omegaEquiv n wc).symm π) hρ v hi
  rw [← sched_eq, ← hki, hq] at hoff
  obtain rfl := Option.some_inj.1 hoff
  obtain ⟨e, he, h1, h2⟩ := (R.mem_rq_iff ((omegaEquiv n wc).symm π)).1 (List.getElem_mem hi)
  refine ⟨ρ, ?_, v, e, he, h1, h2⟩
  by_contra hge
  unfold rstart at hk
  split_ifs at hk with h0
  · omega
  · have := R.roundEnd_le_off π (show τ - 1 < ρ by omega) v
    omega

/-- **A `Π₂` point fixed before round `τ`'s start (and the cut) was revealed at a round `< τ`.** -/
theorem dom_askedS {c j τ : ℕ} (hc : c ≤ (sched R π).length) (hjc : j ≤ c) (hjτ : j ≤ R.rstart π τ)
    {z : Bits (n * wc + (n * wc + 512))} (hz : z ∈ ((stratC R c).hist π j).dom (.inr ())) :
    ∃ ρ < τ, R.askedS ((omegaEquiv n wc).symm π) z ρ := by
  obtain ⟨e, he, hez⟩ := History.mem_dom.1 hz
  obtain ⟨k, hk, q, hq, rfl⟩ := R.hist_entry π hc hjc he
  obtain ⟨ρ, hρ, v, e', he', h1, h2⟩ := R.sched_before π hq (lt_of_lt_of_le hk hjτ)
  refine ⟨ρ, hρ, v, e', he', h1, ?_⟩
  rw [h2]
  rcases q with (x | y) | ⟨T, a | b⟩ <;>
    simp [qEntry, enc, Entry.inpAt, Entry.inp, ans] at hez
  · subst hez; rfl
  · subst hez; rfl

/-- **A `P` point fixed before round `τ`'s start (and the cut) was revealed at a round `< τ`.** -/
theorem dom_askedP {c j τ : ℕ} (hc : c ≤ (sched R π).length) (hjc : j ≤ c) (hjτ : j ≤ R.rstart π τ)
    {T : Tweak n} {a : Lab n wc} (hz : a ∈ ((stratC R c).hist π j).dom (.inl T)) :
    ∃ ρ < τ, R.askedP ((omegaEquiv n wc).symm π) T a ρ := by
  obtain ⟨e, he, hez⟩ := History.mem_dom.1 hz
  obtain ⟨k, hk, q, hq, rfl⟩ := R.hist_entry π hc hjc he
  obtain ⟨ρ, hρ, v, e', he', h1, h2⟩ := R.sched_before π hq (lt_of_lt_of_le hk hjτ)
  refine ⟨ρ, hρ, v, e', he', h1, ?_⟩
  rw [h2]
  rcases q with (x | y) | ⟨T', a' | b⟩
  · simp [qEntry, enc, Entry.inpAt] at hez
  · simp [qEntry, enc, Entry.inpAt] at hez
  · by_cases hT : T' = T
    · subst hT; simp [qEntry, enc, Entry.inpAt, Entry.inp, ans] at hez; subst hez; rfl
    · simp [qEntry, enc, Entry.inpAt, hT] at hez
  · by_cases hT : T' = T
    · subst hT; simp [qEntry, enc, Entry.inpAt, Entry.inp, ans] at hez; subst hez; rfl
    · simp [qEntry, enc, Entry.inpAt, hT] at hez

end P3SegT

namespace P3Replay

variable {n wc : ℕ} {ι : Type} (R : P3Replay n wc ι) (ω : P3COmega n wc)

/-- One pass of the round-level closure: the pair rule, then `assemble`. -/
noncomputable def vcF (τ : ℕ) (K : P3ChainKnow n) : P3ChainKnow n := (R.vcStep ω τ K).assemble R.G

theorem vc_eq (τ : ℕ) (H : P3ChainKnow n) : R.vc ω τ H = (R.vcF ω τ)^[vcIters n] (H.assemble R.G) := rfl

theorem le_vcF (τ : ℕ) (K : P3ChainKnow n) : P3ChainKnow.Le K (R.vcF ω τ K) :=
  (show P3ChainKnow.Le K (R.vcStep ω τ K) from
    ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left,
      subset_rfl, Finset.subset_union_left⟩).trans (P3ChainKnow.le_assemble R.G _)

theorem inU_vcF (τ : ℕ) {K : P3ChainKnow n} (hU : InU K) : InU (R.vcF ω τ K) := by
  classical
  refine ⟨fun p hp => ?_, fun p hp => ?_⟩
  · have : p ∈ (R.vcStep ω τ K).hs := hp
    rcases Finset.mem_union.1 this with h1 | h1
    · exact hU.1 h1
    · exact (Finset.mem_filter.1 h1).1
  · obtain ⟨L, v, j⟩ := p
    rcases (P3ChainKnow.mem_asm_rs R.G _ L v j).1 hp with h1 | ⟨_, hj, _⟩
    · rcases Finset.mem_union.1 h1 with h1 | h1
      · exact hU.2 h1
      · exact (Finset.mem_filter.1 h1).1
    · subst hj
      exact R.mem_pos (L := L) le_rfl

/-- **The round-level closure is a fixpoint.** -/
theorem vc_fix (τ : ℕ) {H : P3ChainKnow n} (hU : InU H) : R.vcF ω τ (R.vc ω τ H) = R.vc ω τ H := by
  rw [vc_eq]
  exact iterate_stable (R.vcF ω τ) (fun K _ => R.le_vcF ω τ K) (fun _ hK => R.inU_vcF ω τ hK) (R.inU_assemble hU)

theorem le_iter_vcF (τ : ℕ) (x : P3ChainKnow n) : ∀ k, P3ChainKnow.Le x ((R.vcF ω τ)^[k] x)
  | 0 => P3ChainKnow.Le.rfl' _
  | k + 1 => by
    rw [Function.iterate_succ_apply']
    exact (le_iter_vcF τ x k).trans (R.le_vcF ω τ _)

/-- **The step-level pair rule fires inside the round-level one** when every point the history fixes was revealed
before round `τ`. -/
theorem svcStep_le_vcStep {h : LazyPerm.History (P3Alpha n wc)} {τ : ℕ}
    (hS : ∀ z, z ∈ h.dom (.inr ()) → ∃ ρ < τ, R.askedS ω z ρ)
    (hP : ∀ (T : Tweak n) a, a ∈ h.dom (.inl T) → ∃ ρ < τ, R.askedP ω T a ρ)
    {K K' : P3ChainKnow n} (hK : P3ChainKnow.Le K K') : P3ChainKnow.Le (R.svcStep ω h K) (R.vcStep ω τ K') := by
  classical
  have hlow : ∀ {w}, K.lowKnown w → K'.lowKnown w := fun hl x => hK.2.1 (hl x)
  refine ⟨fun u hu => ?_, fun q hq => ?_, fun p hp => ?_, fun p hp => ?_, fun q hq => hK.2.2.2.2.1 hq, fun q hq => ?_⟩
  · rcases Finset.mem_union.1 hu with hu | hu
    · exact Finset.mem_union_left _ (hK.1 hu)
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩)
    rcases (Finset.mem_filter.1 hu).2 with ⟨hdm, hk⟩ | ⟨p, hph, hpr, hp1, hj1, hj, hdm, hb⟩
    · exact Or.inl ⟨hP _ _ hdm, fun w => hK.2.2.2.2.2 (hk w)⟩
    · exact Or.inr ⟨p, hK.2.2.1 hph, hK.2.2.2.1 hpr, hp1, hj1, hj, hS _ hdm, hb⟩
  · rcases Finset.mem_union.1 hq with hq | hq
    · exact Finset.mem_union_left _ (hK.2.1 hq)
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩)
    rcases (Finset.mem_filter.1 hq).2 with ⟨hdm, hk⟩ | ⟨p, hph, hpr, hp0, hj1, hj, hdm, hb⟩
    · exact Or.inl ⟨hP _ _ hdm, hK.2.2.2.1 hk⟩
    · exact Or.inr ⟨p, hK.2.2.1 hph, hK.2.2.2.1 hpr, hp0, hj1, hj, hS _ hdm, hb⟩
  · rcases Finset.mem_union.1 hp with hp | hp
    · exact Finset.mem_union_left _ (hK.2.2.1 hp)
    obtain ⟨hpos, hj1, hj, hc⟩ := Finset.mem_filter.1 hp
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, hj1, hj, ?_⟩)
    rcases hc with ⟨hdm, hcall⟩ | ⟨hj2, hdm, hh, hr⟩
    · exact Or.inl ⟨hS _ hdm, P3ChainKnow.canCall_mono R.G hK hcall⟩
    · exact Or.inr ⟨hj2, hS _ hdm, hK.2.2.1 hh, hK.2.2.2.1 hr⟩
  · rcases Finset.mem_union.1 hp with hp | hp
    · exact Finset.mem_union_left _ (hK.2.2.2.1 hp)
    obtain ⟨hpos, hj1, hj, hc⟩ := Finset.mem_filter.1 hp
    refine Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hpos, hj1, hj, ?_⟩)
    rcases hc with ⟨hdm, hcall⟩ | ⟨hL, hjp, hdm, hl⟩
    · exact Or.inl ⟨hS _ hdm, P3ChainKnow.canCall_mono R.G hK hcall⟩
    · exact Or.inr ⟨hL, hjp, hP _ _ hdm, hlow hl⟩
  · rcases Finset.mem_union.1 hq with hq | hq
    · exact Finset.mem_union_left _ (hK.2.2.2.2.2 hq)
    obtain ⟨_, hdm, ht⟩ := Finset.mem_filter.1 hq
    exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hP _ _ hdm, hK.1 ht⟩)

/-- **The step-level closure is inside the round-level one** when every point the history fixes was revealed
before round `τ`. -/
theorem svc_le_vc {h : LazyPerm.History (P3Alpha n wc)} {τ : ℕ}
    (hS : ∀ z, z ∈ h.dom (.inr ()) → ∃ ρ < τ, R.askedS ω z ρ)
    (hP : ∀ (T : Tweak n) a, a ∈ h.dom (.inl T) → ∃ ρ < τ, R.askedP ω T a ρ)
    {K : P3ChainKnow n} (hU : InU K) : P3ChainKnow.Le (R.svc ω h K) (R.vc ω τ K) := by
  have hfix := R.vc_fix ω τ hU
  have key : ∀ k, P3ChainKnow.Le ((R.svcF ω h)^[k] (K.assemble R.G)) (R.vc ω τ K) := by
    intro k
    induction k with
    | zero => rw [vc_eq]; exact R.le_iter_vcF ω τ _ _
    | succ k ih =>
      rw [Function.iterate_succ_apply']
      rw [← hfix]
      exact P3ChainKnow.assemble_mono R.G (R.svcStep_le_vcStep ω hS hP ih)
  exact key _

end P3Replay

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))

/-- **SV: at a round start before the cut, what is known is inside the round-level closure.** -/
theorem kn_le_vc {c τ j : ℕ} (hc : c ≤ (sched R π).length) (hjc : j ≤ c) (hjτ : j ≤ R.rstart π τ)
    {K : P3ChainKnow n} (hU : InU K) :
    P3ChainKnow.Le (R.svc ((omegaEquiv n wc).symm π) ((stratC R c).hist π j) K) (R.vc ((omegaEquiv n wc).symm π) τ K) :=
  R.svc_le_vc _ (fun _ hz => R.dom_askedS π hc hjc hjτ hz) (fun _ _ hz => R.dom_askedP π hc hjc hjτ hz) hU

end P3SegT

namespace HCell

variable {n : ℕ}

theorem known_union {G : TopoDAG n} {A B : P3ChainKnow n} {c : HCell n} :
    c.known G (A.union B) ↔ c.known G A ∨ c.known G B := by
  rcases c with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩ <;>
    simp only [known, P3ChainKnow.union] <;> (try split_ifs) <;> simp [Finset.mem_union]

theorem not_known_empty {G : TopoDAG n} {c : HCell n} : ¬ c.known G P3ChainKnow.empty := by
  rcases c with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩ <;>
    simp only [known, P3ChainKnow.empty] <;> (try split_ifs) <;> simp

theorem known_fresh {G : TopoDAG n} {S K : P3ChainKnow n} {c : HCell n} (h : c.known G (P3ChainKnow.fresh S K)) :
    ¬ c.known G K := by
  have hf := P3ChainKnow.fresh_sub S K
  rcases c with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩ <;> simp only [known] at h ⊢
  · split_ifs at h ⊢
    · exact (hf.2.1 _ h).2
    · exact (hf.1 _ h).2
  · exact (hf.2.2.1 _ h).2
  · split_ifs at h ⊢
    · exact (hf.2.2.2.2.1 _ h).2
    · exact (hf.2.2.2.1 _ h).2
  · exact (hf.2.2.2.2.2 _ h).2

end HCell

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))


/-- **A credit of round `τ`**: in the cut holding after round `τ`, and not in round `τ`'s value closure. -/
def CredAt (c : ℕ) (z : HCell n) (τ : ℕ) : Prop :=
  z.known R.G (R.onlineHC ((omegaEquiv n wc).symm π) c (τ + 1)) ∧
    ¬ z.known R.G (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ))

theorem cred_round (c : ℕ) (z : HCell n) :
    ∀ τ, z.known R.G (R.onlineHC ((omegaEquiv n wc).symm π) c τ) → ∃ τ' < τ, R.CredAt π c z τ'
  | 0, h => absurd h HCell.not_known_empty
  | τ + 1, h => by
    change z.known R.G ((R.onlineHC ((omegaEquiv n wc).symm π) c τ).union _) at h
    rcases HCell.known_union.1 h with h' | h'
    · obtain ⟨τ', hτ', hc⟩ := cred_round c z τ h'
      exact ⟨τ', by omega, hc⟩
    · exact ⟨τ, by omega, h, HCell.known_fresh h'⟩

/-- A program step of a round `< τ` is before round `τ`'s start. -/
theorem lt_rstart {c j τ : ℕ} (hc : c ≤ (sched R π).length) (hjc : j < c) (hjτ : R.rnd π j < τ) :
    j < R.rstart π τ := by
  obtain ⟨_, v, i, hi, he⟩ := R.rnd_spec π (by omega : j < (sched R π).length)
  have h1 := R.off_add_lt ((omegaEquiv n wc).symm π) (R.rnd π j) v hi
  have h2 := R.roundEnd_mono ((omegaEquiv n wc).symm π) (show R.rnd π j ≤ τ - 1 by omega)
  unfold rstart
  rw [if_neg (by omega)]
  omega

/-- **The credits of rounds `< τ` hold every program step before round `τ`'s start.** -/
theorem hK_rstart (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c τ j : ℕ} (hjτ : j ≤ R.rstart π τ) :
    ∀ τ' v i, i < (R.rq ((omegaEquiv n wc).symm π) τ' v).length → R.off ((omegaEquiv n wc).symm π) τ' v + i < j →
      P3ChainKnow.Le (R.onlineHC ((omegaEquiv n wc).symm π) c (τ' + 1)) (R.onlineHC ((omegaEquiv n wc).symm π) c τ) := by
  intro τ' v i _ hlt
  refine R.onlineHC_mono _ c ?_
  by_contra hge
  unfold rstart at hjτ
  split_ifs at hjτ with h0
  · omega
  · have h2 := R.roundEnd_le_off π (show τ - 1 < τ' by omega) v
    omega

/-- **A pair fixed at a program step of a round `< τ` has every cell in round `τ`'s value closure.** -/
theorem early_cells (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) {x : HPt n} (hx : x.Valid R.G) {τ : ℕ} (hxc : R.dstep π c x < c)
    (hxτ : R.rnd π (R.dstep π c x) < τ) {o : Bool} {k : ℕ} {z : HCell n} (hz : cellAt R.G x o k = some z) :
    z.known R.G (R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)) := by
  set j' := min (R.rstart π τ) c
  have hs := R.dstep_spec π hc hx
  have hlt : R.dstep π c x < j' := lt_min (R.lt_rstart π hc hxc hxτ) hxc
  have hU := R.inU_onlineHC ((omegaEquiv n wc).symm π) c τ
  have hb := R.backing π hA hnb hc hU _ x hx hs.1 hs.2.1 j' hlt (R.hK_rstart π hA (min_le_left _ _))
  have hk := R.sides_cells (R.svc_asm_le _ _ hU) hb hz
  exact HCell.known_mono (R.kn_le_vc π hc (min_le_right _ _) (min_le_left _ _) hU) hk

/-- **A credit of a round `≤ rnd j` (or any credit, past the cut) is known at `j`.** -/
theorem credAt_known {c τ j : ℕ} {z : HCell n} (hcr : R.CredAt π c z τ) (hτD : τ ≤ R.D)
    (hj : c ≤ j ∨ τ ≤ R.rnd π j) : z.known R.G (R.kn π c j) := by
  refine HCell.known_mono (R.le_svc _ _ _) (HCell.known_mono ?_ hcr.1)
  unfold Kat
  split_ifs with h
  · exact R.onlineHC_mono _ c (by rcases hj with hj | hj <;> omega)
  · exact R.onlineHC_mono _ c (by omega)

/-- **KC: a credited cell of a pair's side is known at the pair's first fresh step.** A later credit round would
find the pair fixed at an earlier round, so the cell in round `VC`, and it would not be fresh. -/
theorem cred_known (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) {x : HPt n} (hx : x.Valid R.G) {o : Bool} {k : ℕ} {z : HCell n}
    (hz : cellAt R.G x o k = some z) (hcred : z.known R.G (R.onlineHC ((omegaEquiv n wc).symm π) c (R.D + 1))) :
    z.known R.G (R.kn π c (R.dstep π c x)) := by
  obtain ⟨τ, hτ, hcr⟩ := R.cred_round π c z _ hcred
  rcases le_or_gt c (R.dstep π c x) with h | h
  · exact R.credAt_known π hcr (by omega) (Or.inl h)
  rcases le_or_gt τ (R.rnd π (R.dstep π c x)) with h' | h'
  · exact R.credAt_known π hcr (by omega) (Or.inr h')
  · exact absurd (R.early_cells π hA hnb hc hx h h' hz) hcr.2

end P3SegT

namespace HCell

variable {n : ℕ}

/-- **Cells of a valid pair are valid.** -/
theorem valid_of_cellAt {G : TopoDAG n} {x : HPt n} (hx : x.Valid G) {o : Bool} {k : ℕ} {y : HCell n}
    (h : cellAt G x o k = some y) : y.Valid G := by
  rcases x with ⟨L, v, p⟩ | w | u <;> rcases o with _ | _
  · simp only [cellAt] at h
    split_ifs at h with h1 h2 h3
    · cases hb : ovBlock G v p with
      | none => rw [hb] at h; simp at h
      | some u => rw [hb] at h; simp at h; subst h; trivial
    · simp at h; subst h; exact ⟨by omega, by have := hx.2; omega⟩
  · simp only [cellAt] at h
    split_ifs at h <;> simp at h <;> subst h <;> exact hx
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h
    exact ⟨P3Replay.ovCalls_pos G w, le_rfl⟩
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h; trivial
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h; trivial
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h; trivial

/-- **An output cell on a pair's input side lives at another pair** (except `pin2`, the top pair's own input). -/
theorem home_ne_of_in {G : TopoDAG n} {x : HPt n} {k : ℕ} {y : HCell n} (h : cellAt G x false k = some y)
    (hy : y.isOut = true) : y.home ≠ x := by
  rcases x with ⟨L, v, p⟩ | w | u
  · simp only [cellAt] at h
    split_ifs at h with h1 h2 h3
    · cases hb : ovBlock G v p with
      | none => rw [hb] at h; simp at h
      | some u =>
        rw [hb] at h; simp at h; subst h
        by_cases hL : L = 0 <;> simp [home, hL]
    · simp at h; subst h; simp [home]; omega
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h; simp [home]
  · simp only [cellAt] at h; split_ifs at h; simp at h; subst h; simp [isOut] at hy

/-- The level of a cell: `1` for the top layer's cells (and `pin2`), `0` for the lower layer's. -/
def level : HCell n → ℕ
  | .lab L _ _ => L
  | .hc L _ _ _ => L
  | .rc L _ _ _ => L
  | .pin2 .. => 1

/-- **Positional steps keep the level.** -/
theorem level_of_cellAt {G : TopoDAG n} {z y : HCell n} (h : cellAt G z.home (!z.isOut) z.pos = some y) :
    y.level = z.level := by
  rcases z with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  · have : L = 0 ∨ L = 1 := by fin_cases L <;> simp
    rcases this with rfl | rfl <;> simp [home, isOut, pos, cellAt, k.isLt] at h <;> subst h <;> rfl
  all_goals simp only [home, isOut, pos, cellAt, Bool.not_true, Bool.not_false] at h
  all_goals split_ifs at h <;> (try split at h) <;> first | omega | (simp at h; done) | (simp at h; subst h; rfl)

/-- **A top pad's `r` cell (`key²`) is no cell's partner.** -/
theorem partner_ne_key2 {G : TopoDAG n} {z : HCell n} (hz : z.isOut = true) {u w : Fin n}
    (h : cellAt G z.home (!z.isOut) z.pos = some (.rc 1 u (ovCalls G u) w)) : False := by
  rw [hz] at h
  rcases z with ⟨L, u', k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u', w'⟩
  · have : L = 0 ∨ L = 1 := by fin_cases L <;> simp
    rcases this with rfl | rfl <;> simp [home, pos, cellAt, k.isLt] at h
  all_goals simp only [home, pos, cellAt, Bool.not_true] at h
  all_goals first
    | (simp [isOut] at hz; done)
    | (split_ifs at h <;> (try split at h) <;> first | omega | (simp at h; done))

end HCell

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))


open Classical in
/-- **One positional step of a chain**: a cell on its home's query side passes to its partner on the answer side,
unless the partner is a public constant or known at the home's first fresh step. -/
noncomputable def nextP (c : ℕ) (z : HCell n) : Option (HCell n) :=
  if (R.Fwd π c z.home ↔ z.isOut = true) then none
  else match z.partner R.G with
    | none => none
    | some y => if y.known R.G (R.kn π c (R.dstep π c z.home)) then none else some y

/-- The cut holding: every credit. -/
noncomputable abbrev Kfull (c : ℕ) : P3ChainKnow n := R.onlineHC ((omegaEquiv n wc).symm π) c (R.D + 1)

open Classical in
/-- **The chain step.** A `pin2` cell `pin2_u(w) = c¹_w(u) ⊕ key²_u(w)` passes to one of the two samples of its
triple, `A = c¹_w(u)` at `P₀(w)` or `B = key²_u(w)` at the top pad: `B` if `A` is otherwise entered (credited, or
some positional step lands on it); else `A` if `key²_u(w)` is credited; else the later sample. Every other cell takes
the positional step. -/
noncomputable def next (c : ℕ) (z : HCell n) : Option (HCell n) :=
  match z with
  | .pin2 u w =>
    if (w, u) ∈ (R.Kfull π c).cols ∨ ∃ y, y.Valid R.G ∧ R.nextP π c y = some (.lab 0 w u) then
      some (.rc 1 u (ovCalls R.G u) w)
    else if (u, w) ∈ (R.Kfull π c).kc then some (.lab 0 w u)
    else if R.dstep π c (.low w) < R.dstep π c (.chain 1 u (ovCalls R.G u)) then some (.rc 1 u (ovCalls R.G u) w)
    else some (.lab 0 w u)
  | z => R.nextP π c z

/-- Follow the chain for at most `f` steps. -/
noncomputable def last (c : ℕ) : ℕ → HCell n → HCell n
  | 0, z => z
  | f + 1, z => match R.next π c z with
    | none => z
    | some y => last c f y

theorem nextP_some {c : ℕ} {z y : HCell n} (h : R.nextP π c z = some y) :
    ¬ (R.Fwd π c z.home ↔ z.isOut = true) ∧ cellAt R.G z.home (!z.isOut) z.pos = some y ∧
      ¬ y.known R.G (R.kn π c (R.dstep π c z.home)) := by
  unfold nextP at h
  split_ifs at h with h1
  cases hp : z.partner R.G with
  | none => rw [hp] at h; simp at h
  | some y' =>
    rw [hp] at h
    simp only at h
    split_ifs at h with h2
    obtain rfl := Option.some_inj.1 h
    exact ⟨h1, hp, h2⟩

theorem next_of_ne_pin2 {c : ℕ} {z : HCell n} (hz : ∀ u w, z ≠ .pin2 u w) : R.next π c z = R.nextP π c z := by
  rcases z with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  · rfl
  · rfl
  · rfl
  · exact absurd rfl (hz u w)

theorem pin2_ne_of_isOut {z : HCell n} (hz : z.isOut = true) : ∀ u w, z ≠ .pin2 u w := by
  rintro u w rfl; simp [HCell.isOut] at hz

/-- **A positional step lands on no credited cell** (KC). -/
theorem nextP_not_cred (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) {z y : HCell n} (hzv : z.Valid R.G) (h : R.nextP π c z = some y) :
    ¬ y.known R.G (R.Kfull π c) := fun hcr => by
  obtain ⟨_, hy, hnk⟩ := R.nextP_some π h
  exact hnk (R.cred_known π hA hnb hc (HCell.home_valid hzv) hy hcr)

/-- **A positional step goes to a later pair** (or, from `c²_u(w)`, to `pin2_u(w)` at the same pair). -/
theorem nextP_later (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) {z y : HCell n} (hzv : z.Valid R.G) (hzo : z.isOut = true)
    (hyo : y.isOut = true) (h : R.nextP π c z = some y) :
    R.dstep π c z.home < R.dstep π c y.home := by
  obtain ⟨_, hy, hnk⟩ := R.nextP_some π h
  have hyv : y.Valid R.G := HCell.valid_of_cellAt (HCell.home_valid hzv) hy
  rcases lt_trichotomy (R.dstep π c y.home) (R.dstep π c z.home) with hlt | heq | hgt
  · have hself := HCell.cellAt_self R.G y
    rw [hyo] at hself
    exact absurd (R.known_of_fixed π hA hnb hc (HCell.home_valid hyv) hlt hself) hnk
  · have := R.dstep_inj π hc hnb (HCell.home_valid hyv) (HCell.home_valid hzv) heq
    rw [hzo] at hy
    exact absurd this (HCell.home_ne_of_in hy hyo)
  · exact hgt

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))

/-- **What the `pin2` rule chose.** -/
theorem next_pin2 {c : ℕ} {u w : Fin n} {y : HCell n} (h : R.next π c (.pin2 u w) = some y) :
    (y = .rc 1 u (ovCalls R.G u) w ∧
      (((w, u) ∈ (R.Kfull π c).cols ∨ ∃ y', y'.Valid R.G ∧ R.nextP π c y' = some (.lab 0 w u)) ∨
        ((u, w) ∉ (R.Kfull π c).kc ∧ R.dstep π c (.low w) < R.dstep π c (.chain 1 u (ovCalls R.G u))))) ∨
    (y = .lab 0 w u ∧ ¬ ((w, u) ∈ (R.Kfull π c).cols ∨ ∃ y', y'.Valid R.G ∧ R.nextP π c y' = some (.lab 0 w u)) ∧
      ((u, w) ∈ (R.Kfull π c).kc ∨ ¬ R.dstep π c (.low w) < R.dstep π c (.chain 1 u (ovCalls R.G u)))) := by
  simp only [next] at h
  split_ifs at h with h1 h2 h3 <;> obtain rfl := Option.some_inj.1 h
  · exact Or.inl ⟨rfl, Or.inl h1⟩
  · exact Or.inr ⟨rfl, h1, Or.inl h2⟩
  · exact Or.inl ⟨rfl, Or.inr ⟨h2, h3⟩⟩
  · exact Or.inr ⟨rfl, h1, Or.inr h3⟩

/-- **The chain step is injective.** Two positional steps landing on one cell come from one pair (else the later
pair would find it known, by `backing`), hence from one cell; the `pin2` rule avoids every positional landing. -/
theorem next_inj (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) {z₁ z₂ y : HCell n} (hv₁ : z₁.Valid R.G) (hv₂ : z₂.Valid R.G)
    (h₁ : R.next π c z₁ = some y) (h₂ : R.next π c z₂ = some y) : z₁ = z₂ := by
  -- two positional steps
  have hpos : ∀ {a b : HCell n}, a.Valid R.G → b.Valid R.G → a.isOut = true → b.isOut = true →
      R.nextP π c a = some y → R.nextP π c b = some y → a = b := by
    intro a b hva hvb hao hbo ha hb
    obtain ⟨_, hya, hnka⟩ := R.nextP_some π ha
    obtain ⟨_, hyb, hnkb⟩ := R.nextP_some π hb
    rw [hao] at hya
    rw [hbo] at hyb
    have hpa := HCell.pos_of_cellAt hya
    have hpb := HCell.pos_of_cellAt hyb
    by_cases hh : a.home = b.home
    · exact HCell.eq_of_home (G := R.G) hh (hao.trans hbo.symm) (hpa.symm.trans hpb)
    · exfalso
      have hne : R.dstep π c a.home ≠ R.dstep π c b.home := fun he =>
        hh (R.dstep_inj π hc hnb (HCell.home_valid hva) (HCell.home_valid hvb) he)
      rcases lt_or_gt_of_ne hne with hlt | hlt
      · exact hnkb (R.known_of_fixed π hA hnb hc (HCell.home_valid hva) hlt hya)
      · exact hnka (R.known_of_fixed π hA hnb hc (HCell.home_valid hvb) hlt hyb)
  -- a `pin2` step and a positional step
  have hmix : ∀ {u w : Fin n} {b : HCell n}, b.Valid R.G → b.isOut = true → R.next π c (.pin2 u w) = some y →
      R.nextP π c b = some y → False := by
    intro u w b hbv hbo hn hb
    obtain ⟨_, hyb, _⟩ := R.nextP_some π hb
    rcases R.next_pin2 π hn with ⟨rfl, _⟩ | ⟨rfl, hno, _⟩
    · exact HCell.partner_ne_key2 hbo hyb
    · exact hno (Or.inr ⟨b, hbv, hb⟩)
  rcases z₁ with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩ <;>
    rcases z₂ with ⟨L', u', k'⟩ | ⟨L', v', p', k'⟩ | ⟨L', v', p', k'⟩ | ⟨u', w'⟩
  all_goals first
    | exact hpos hv₁ hv₂ rfl rfl h₁ h₂
    | exact (hmix hv₂ rfl h₁ h₂).elim
    | exact (hmix hv₁ rfl h₂ h₁).elim
    | skip
  -- two `pin2` steps
  rcases R.next_pin2 π h₁ with ⟨rfl, _⟩ | ⟨rfl, _⟩ <;> rcases R.next_pin2 π h₂ with ⟨he, _⟩ | ⟨he, _⟩
  · simp only [HCell.rc.injEq] at he; obtain ⟨-, rfl, -, rfl⟩ := he; rfl
  · simp at he
  · simp at he
  · simp only [HCell.lab.injEq] at he; obtain ⟨-, rfl, rfl⟩ := he; rfl

/-- The chain step keeps cells valid. -/
theorem next_valid {c : ℕ} {z y : HCell n} (hz : z.Valid R.G) (h : R.next π c z = some y) : y.Valid R.G := by
  rcases z with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  all_goals first
    | (rcases R.next_pin2 π h with ⟨rfl, _⟩ | ⟨rfl, _⟩
       · exact ⟨ovCalls_pos R.G u, le_rfl⟩
       · trivial)
    | exact HCell.valid_of_cellAt (HCell.home_valid hz) (R.nextP_some π h).2.1

/-- **A top pad's `r` cell ends every chain**: its partner is the pad block. -/
theorem next_key2 {c : ℕ} {u w : Fin n} : R.next π c (.rc 1 u (ovCalls R.G u) w) = none := by
  show R.nextP π c _ = none
  unfold nextP
  split_ifs
  · rfl
  · have : (HCell.rc 1 u (ovCalls R.G u) w).partner R.G = none := by
      simp [HCell.partner, HCell.home, HCell.isOut, HCell.pos, cellAt, w.isLt, P3ChainKnow.ovBlock_pad]
    rw [this]

end P3SegT

namespace HCell

variable {n : ℕ}

/-- The `pin2` cells. -/
def isPin2 : HCell n → Bool
  | .pin2 .. => true
  | _ => false

theorem isPin2_eq {z : HCell n} (h : z.isOut = true) : z.isPin2 = false := by
  rcases z with _ | _ | _ | _ <;> simp_all [isOut, isPin2]

/-- **Only the top pair's input holds a `pin2` cell.** -/
theorem home_of_pin2 {G : TopoDAG n} {x : HPt n} {k : ℕ} {u w : Fin n} (h : cellAt G x false k = some (.pin2 u w)) :
    x = .top u := by
  rcases x with ⟨L, v, p⟩ | w' | u'
  · simp only [cellAt] at h
    split_ifs at h <;> (try split at h) <;> simp at h
  · simp only [cellAt] at h; split_ifs at h; simp at h
  · simp only [cellAt] at h; split_ifs at h; simp at h; obtain ⟨rfl, -⟩ := h; rfl

end HCell

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))


/-- A bound on every first fresh step. -/
noncomputable abbrev Tend (c : ℕ) : ℕ := c + R.tailP.work (trueAns π)

open Classical in
/-- **The chain potential**: `0` at a top pad's `r` cell; else the top layer's cells above the lower layer's, and
within a layer, later pairs (and `pin2` after its top) lower. -/
noncomputable def pot (c : ℕ) (z : HCell n) : ℕ :=
  if ∃ u w, z = .rc 1 u (ovCalls R.G u) w then 0
  else if z.level = 1 then
    3 * R.Tend π c + 3 + (2 * R.Tend π c + 1 - (2 * R.dstep π c z.home + if z.isPin2 then 1 else 0))
  else 1 + (2 * R.Tend π c + 1 - 2 * R.dstep π c z.home)

theorem pot_lt_out (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) {z y : HCell n} (hz : z.Valid R.G) (hzo : z.isOut = true)
    (hnk : ¬ ∃ u w, z = .rc 1 u (ovCalls R.G u) w) (h : R.next π c z = some y) :
    R.pot π c y < R.pot π c z := by
  have hdz : R.dstep π c z.home < R.Tend π c := (R.dstep_spec π hc (HCell.home_valid hz)).2.2
  rw [R.next_of_ne_pin2 π (pin2_ne_of_isOut hzo)] at h
  obtain ⟨_, hy, _⟩ := R.nextP_some π h
  have hyv := HCell.valid_of_cellAt (HCell.home_valid hz) hy
  have hdy : R.dstep π c y.home < R.Tend π c := (R.dstep_spec π hc (HCell.home_valid hyv)).2.2
  have hlev := HCell.level_of_cellAt hy
  have hyk : ¬ ∃ u w, y = .rc 1 u (ovCalls R.G u) w := by
    rintro ⟨u, w, rfl⟩; exact HCell.partner_ne_key2 hzo hy
  unfold pot
  rw [if_neg hyk, if_neg hnk, hlev, HCell.isPin2_eq hzo]
  cases hyo : y.isOut
  · -- `y` is `pin2`: it sits at the same top pair
    rw [hzo] at hy
    rcases y with _ | _ | _ | ⟨u', w'⟩ <;> simp [HCell.isOut] at hyo
    have hx := HCell.home_of_pin2 hy
    have hh : (HCell.pin2 u' w' : HCell n).home = z.home := by rw [hx]; rfl
    rw [hh]
    have hl : z.level = 1 := by rw [← hlev]; rfl
    simp only [HCell.isPin2, hl, Bool.false_eq_true, ite_true, ite_false]
    omega
  · have hlt := R.nextP_later π hA hnb hc hz hzo hyo h
    rw [HCell.isPin2_eq hyo]
    split_ifs <;> omega

theorem pot_lt (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) {z y : HCell n} (hz : z.Valid R.G) (h : R.next π c z = some y) :
    R.pot π c y < R.pot π c z := by
  have hnk : ¬ ∃ u w, z = .rc 1 u (ovCalls R.G u) w := by
    rintro ⟨u, w, rfl⟩; rw [R.next_key2 π] at h; simp at h
  rcases z with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  rotate_left 3
  · have hzp : R.pot π c (.pin2 u w) ≥ 3 * R.Tend π c + 3 := by
      unfold pot; rw [if_neg hnk]; simp [HCell.level]
    rcases R.next_pin2 π h with ⟨rfl, _⟩ | ⟨rfl, _⟩
    · have : R.pot π c (.rc 1 u (ovCalls R.G u) w) = 0 := by unfold pot; rw [if_pos ⟨u, w, rfl⟩]
      omega
    · have : R.pot π c (.lab 0 w u) ≤ 2 * R.Tend π c + 2 := by
        unfold pot
        rw [if_neg (by rintro ⟨_, _, h⟩; simp at h)]
        simp [HCell.level]; omega
      omega
  all_goals exact R.pot_lt_out π hA hnb hc hz rfl hnk h

/-- **A long enough chain ends.** -/
theorem last_terminal (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) : ∀ f (z : HCell n), z.Valid R.G → R.pot π c z < f →
      R.next π c (R.last π c f z) = none
  | 0, _, _, h => absurd h (Nat.not_lt_zero _)
  | f + 1, z, hz, h => by
    simp only [last]
    cases hn : R.next π c z with
    | none => exact hn
    | some y =>
      simp only
      exact last_terminal hA hnb hc f y (R.next_valid π hz hn) (by have := R.pot_lt π hA hnb hc hz hn; omega)

/-- `k` chain steps. -/
noncomputable def nextN (c : ℕ) : ℕ → HCell n → Option (HCell n)
  | 0, z => some z
  | k + 1, z => (nextN c k z).bind (R.next π c)

theorem nextN_succ {c k : ℕ} {z e : HCell n} :
    R.nextN π c (k + 1) z = some e ↔ ∃ y, R.nextN π c k z = some y ∧ R.next π c y = some e := by
  simp only [nextN, Option.bind_eq_some_iff]

theorem last_reach (c : ℕ) : ∀ f (z : HCell n), ∃ k, R.nextN π c k z = some (R.last π c f z)
  | 0, z => ⟨0, rfl⟩
  | f + 1, z => by
    simp only [last]
    cases hn : R.next π c z with
    | none => exact ⟨0, rfl⟩
    | some y =>
      obtain ⟨k, hk⟩ := last_reach c f y
      refine ⟨k + 1, ?_⟩
      -- shift the start
      have shift : ∀ k (e : HCell n), R.nextN π c k y = some e → R.nextN π c (k + 1) z = some e := by
        intro k
        induction k with
        | zero => intro e he; simp only [nextN] at he ⊢; obtain rfl := Option.some_inj.1 he; simpa using hn
        | succ k ih =>
          intro e he
          obtain ⟨y', hy', he'⟩ := (R.nextN_succ π).1 he
          exact (R.nextN_succ π).2 ⟨y', ih y' hy', he'⟩
      exact shift k _ hk

theorem nextN_valid {c : ℕ} : ∀ k {z e : HCell n}, z.Valid R.G → R.nextN π c k z = some e → e.Valid R.G
  | 0, z, e, hz, h => by simp only [nextN] at h; obtain rfl := Option.some_inj.1 h; exact hz
  | k + 1, z, e, hz, h => by
    obtain ⟨y, hy, he⟩ := (R.nextN_succ π).1 h
    exact R.next_valid π (nextN_valid k hz hy) he


/-- The starts: the valid credited cells. -/
def Start (c : ℕ) (z : HCell n) : Prop := z.Valid R.G ∧ z.known R.G (R.Kfull π c)

/-- A cell some chain from a start reaches. -/
def Reached (c : ℕ) (e : HCell n) : Prop := ∃ z k, R.Start π c z ∧ R.nextN π c k z = some e

/-- **TR3, the triple's rank**: a reached `pin2` cell whose `c¹` coordinate is otherwise entered has no credited top-key
coordinate. -/
def TR3 (c : ℕ) : Prop :=
  ∀ u w : Fin n, R.Reached π c (.pin2 u w) →
    ((w, u) ∈ (R.Kfull π c).cols ∨ ∃ y, y.Valid R.G ∧ R.nextP π c y = some (.lab 0 w u)) → (u, w) ∉ (R.Kfull π c).kc

/-- **XV, the triple's validity**: the sample the `pin2` rule picks, if on its pair's answer side, is known there. -/
def XV (c : ℕ) : Prop :=
  ∀ (u w : Fin n) (e : HCell n), R.Reached π c (.pin2 u w) → R.next π c (.pin2 u w) = some e →
    R.Fwd π c e.home → e.known R.G (R.kn π c (R.dstep π c e.home))

/-- **No chain step lands on a credited cell** (given the triple's rank). -/
theorem next_not_cred (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) (htr : R.TR3 π c) {y e : HCell n} (hy : R.Reached π c y)
    (h : R.next π c y = some e) : ¬ e.known R.G (R.Kfull π c) := by
  obtain ⟨z, k, hz, hk⟩ := hy
  have hyv := R.nextN_valid π k hz.1 hk
  rcases y with ⟨L, u, k'⟩ | ⟨L, v, p, k'⟩ | ⟨L, v, p, k'⟩ | ⟨u, w⟩
  rotate_left 3
  · rcases R.next_pin2 π h with ⟨rfl, hB⟩ | ⟨rfl, hno, _⟩
    · intro hcr
      simp [HCell.known] at hcr
      rcases hB with hB | ⟨hkc, _⟩
      · exact htr u w ⟨z, k, hz, hk⟩ hB hcr
      · exact hkc hcr
    · exact fun hcr => hno (Or.inl hcr)
  all_goals
    rw [R.next_of_ne_pin2 π (pin2_ne_of_isOut rfl)] at h
    exact R.nextP_not_cred π hA hnb hc hyv h

/-- **Backward uniqueness**: two chains from starts reaching one cell are one chain. -/
theorem reach_unique (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) (htr : R.TR3 π c) :
    ∀ k₁ k₂ {z₁ z₂ e : HCell n}, R.Start π c z₁ → R.Start π c z₂ → R.nextN π c k₁ z₁ = some e →
      R.nextN π c k₂ z₂ = some e → z₁ = z₂
  | 0, 0, z₁, z₂, e, _, _, h₁, h₂ => by
    simp only [nextN] at h₁ h₂; exact Option.some_inj.1 (h₁.trans h₂.symm)
  | 0, k₂ + 1, z₁, z₂, e, hs₁, hs₂, h₁, h₂ => by
    simp only [nextN] at h₁; obtain rfl := Option.some_inj.1 h₁
    obtain ⟨y, hy, he⟩ := (R.nextN_succ π).1 h₂
    exact absurd hs₁.2 (R.next_not_cred π hA hnb hc htr ⟨z₂, k₂, hs₂, hy⟩ he)
  | k₁ + 1, 0, z₁, z₂, e, hs₁, hs₂, h₁, h₂ => by
    simp only [nextN] at h₂; obtain rfl := Option.some_inj.1 h₂
    obtain ⟨y, hy, he⟩ := (R.nextN_succ π).1 h₁
    exact absurd hs₂.2 (R.next_not_cred π hA hnb hc htr ⟨z₁, k₁, hs₁, hy⟩ he)
  | k₁ + 1, k₂ + 1, z₁, z₂, e, hs₁, hs₂, h₁, h₂ => by
    obtain ⟨y₁, hy₁, he₁⟩ := (R.nextN_succ π).1 h₁
    obtain ⟨y₂, hy₂, he₂⟩ := (R.nextN_succ π).1 h₂
    have := R.next_inj π hA hnb hc (R.nextN_valid π k₁ hs₁.1 hy₁) (R.nextN_valid π k₂ hs₂.1 hy₂) he₁ he₂
    subst this
    exact reach_unique hA hnb hc htr k₁ k₂ hs₁ hs₂ hy₁ hy₂

open Classical in
/-- The answer side of a pair's first fresh step: the output after a forward query, the input after an inverse one. -/
noncomputable def ansSide (c : ℕ) (x : HPt n) : Bool := decide (R.Fwd π c x)

/-- **A pinned cell**: the answer cell at `(pair, position)` is a public constant, or known at the first fresh step. -/
def Pinned (c : ℕ) (x : HPt n) (k : ℕ) : Prop :=
  ∀ y, cellAt R.G x (R.ansSide π c x) k = some y → y.known R.G (R.kn π c (R.dstep π c x))

/-- **Every chain from a start ends at a pinned answer cell** (given the triple's validity). -/
theorem end_pinned (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) (hxv : R.XV π c) {e : HCell n} (he : R.Reached π c e)
    (hend : R.next π c e = none) : R.Pinned π c e.home e.pos := by
  obtain ⟨z, k, hz, hk⟩ := he
  have hev := R.nextN_valid π k hz.1 hk
  have heo : e.isOut = true := by
    rcases e with _ | _ | _ | ⟨u, w⟩
    · rfl
    · rfl
    · rfl
    · rcases h : R.next π c (.pin2 u w) with _ | y
      · simp only [next] at h; split_ifs at h <;> simp at h
      · rw [h] at hend; simp at hend
  intro y hy
  classical
  unfold ansSide at hy
  by_cases hF : R.Fwd π c e.home
  · rw [decide_eq_true hF] at hy
    have hself := HCell.cellAt_self R.G e
    rw [heo] at hself
    obtain rfl := HCell.cellAt_inj hy hself
    -- the answer cell is `e` itself
    rcases k with _ | k
    · simp only [nextN] at hk; obtain rfl := Option.some_inj.1 hk
      exact R.cred_known π hA hnb hc (HCell.home_valid hz.1) hself hz.2
    · obtain ⟨y', hy', hn⟩ := (R.nextN_succ π).1 hk
      have hy'v := R.nextN_valid π k hz.1 hy'
      rcases y' with ⟨L, u, k'⟩ | ⟨L, v, p, k'⟩ | ⟨L, v, p, k'⟩ | ⟨u, w⟩
      rotate_left 3
      · exact hxv u w _ ⟨z, k, hz, hy'⟩ hn hF
      all_goals
        rw [R.next_of_ne_pin2 π (pin2_ne_of_isOut rfl)] at hn
        obtain ⟨_, hy'', _⟩ := R.nextP_some π hn
        exact R.known_of_fixed π hA hnb hc (HCell.home_valid hy'v) (R.nextP_later π hA hnb hc hy'v rfl heo hn) hy''
  · rw [decide_eq_false hF] at hy
    rw [R.next_of_ne_pin2 π (pin2_ne_of_isOut heo)] at hend
    unfold nextP at hend
    rw [if_neg (by rw [heo]; simpa using hF)] at hend
    have hp : e.partner R.G = some y := by
      unfold HCell.partner; rw [heo]; exact hy
    rw [hp] at hend
    simp only at hend
    split_ifs at hend with hk'
    exact hk'

end P3SegT

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainTriple ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))

/-- Round `τ`'s value closure of the cut holding. -/
noncomputable abbrev VCr (c τ : ℕ) : P3ChainKnow n :=
  R.vc ((omegaEquiv n wc).symm π) τ (R.onlineHC ((omegaEquiv n wc).symm π) c τ)

theorem vcr_asm (c τ : ℕ) : P3ChainKnow.Le ((R.VCr π c τ).assemble R.G) (R.VCr π c τ) := by
  have hU := R.inU_onlineHC ((omegaEquiv n wc).symm π) c τ
  have hfix := R.vc_fix ((omegaEquiv n wc).symm π) τ hU
  unfold vcF at hfix
  have hle : P3ChainKnow.Le (R.VCr π c τ) (R.vcStep ((omegaEquiv n wc).symm π) τ (R.VCr π c τ)) :=
    ⟨Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left, Finset.subset_union_left,
      subset_rfl, Finset.subset_union_left⟩
  have := P3ChainKnow.assemble_mono R.G hle
  rw [hfix] at this
  exact this

theorem onlineHC_le_vcr (c τ : ℕ) : P3ChainKnow.Le (R.onlineHC ((omegaEquiv n wc).symm π) c τ) (R.VCr π c τ) := by
  show P3ChainKnow.Le _ (R.vc _ τ _)
  rw [vc_eq]
  exact (P3ChainKnow.le_assemble R.G _).trans (R.le_iter_vcF _ τ _ _)


section Tri

variable {G : TopoDAG n} {K : P3ChainKnow n} (hK : P3ChainKnow.Le (K.assemble G) K) {u w : Fin n}
include hK

theorem tri_col (hk : (u, w) ∈ K.kc) (hp : (u, w) ∈ K.pc) : (w, u) ∈ K.cols :=
  hK.2.1 ((P3ChainKnow.mem_asm_cols G K w u).2 (Or.inr ⟨hp, (P3ChainKnow.mem_kc1 G K u w).2 (Or.inl hk)⟩))

theorem tri_kc (hc : (w, u) ∈ K.cols) (hp : (u, w) ∈ K.pc) : (u, w) ∈ K.kc :=
  hK.2.2.2.2.1 ((P3ChainKnow.mem_asm_kc G K u w).2 (Or.inr ⟨hp, hc⟩))

theorem tri_pc (hc : (w, u) ∈ K.cols) (hk : (u, w) ∈ K.kc) : (u, w) ∈ K.pc :=
  hK.2.2.2.2.2 ((P3ChainKnow.mem_asm_pc G K u w).2 (Or.inr ⟨hc, (P3ChainKnow.mem_kc1 G K u w).2 (Or.inl hk)⟩))

end Tri


theorem known_A {G : TopoDAG n} {K : P3ChainKnow n} {w u : Fin n} :
    (HCell.lab 0 w u).known G K ↔ (w, u) ∈ K.cols := by simp [HCell.known]

theorem known_B {G : TopoDAG n} {K : P3ChainKnow n} {u w : Fin n} :
    (HCell.rc 1 u (ovCalls G u) w).known G K ↔ (u, w) ∈ K.kc := by simp [HCell.known]

theorem known_C {G : TopoDAG n} {K : P3ChainKnow n} {u w : Fin n} :
    (HCell.pin2 u w).known G K ↔ (u, w) ∈ K.pc := by simp [HCell.known]

/-- A credit of round `τ` is in round `τ`'s fresh set. -/
theorem cred_fresh {c τ : ℕ} {z : HCell n} (h : R.CredAt π c z τ) :
    z.known R.G (P3ChainKnow.fresh (R.shownAtC ((omegaEquiv n wc).symm π) c τ) (R.VCr π c τ)) := by
  have h1 := h.1
  change z.known R.G ((R.onlineHC ((omegaEquiv n wc).symm π) c τ).union _) at h1
  rcases HCell.known_union.1 h1 with h' | h'
  · exact absurd (HCell.known_mono (R.onlineHC_le_vcr π c τ) h') h.2
  · exact h'

/-- An earlier credit is in the value closure. -/
theorem cred_in {c τ' τ : ℕ} {z : HCell n} (h : R.CredAt π c z τ') (hlt : τ' < τ) : z.known R.G (R.VCr π c τ) :=
  HCell.known_mono ((R.onlineHC_mono _ c (by omega)).trans (R.onlineHC_le_vcr π c τ)) h.1

variable {c : ℕ} {u w : Fin n}

theorem no_C {τ : ℕ} (hC : R.CredAt π c (.pin2 u w) τ) (hA : (w, u) ∈ (R.VCr π c τ).cols)
    (hB : (u, w) ∈ (R.VCr π c τ).kc) : False :=
  hC.2 (known_C.2 (tri_pc (R.vcr_asm π c τ) hA hB))

theorem no_A {τ : ℕ} (hA' : R.CredAt π c (.lab 0 w u) τ) (hB : (u, w) ∈ (R.VCr π c τ).kc)
    (hC : (u, w) ∈ (R.VCr π c τ).pc) : False :=
  hA'.2 (known_A.2 (tri_col (R.vcr_asm π c τ) hB hC))

theorem no_B {τ : ℕ} (hB' : R.CredAt π c (.rc 1 u (ovCalls R.G u) w) τ) (hA : (w, u) ∈ (R.VCr π c τ).cols)
    (hC : (u, w) ∈ (R.VCr π c τ).pc) : False :=
  hB'.2 (known_B.2 (tri_kc (R.vcr_asm π c τ) hA hC))

/-- **The `pin2` filter**: a `pin2` credit's column and key are not both known or shown in its round. -/
theorem no_C_fresh {τ : ℕ} (hC : R.CredAt π c (.pin2 u w) τ)
    (hA : (w, u) ∈ (R.VCr π c τ).cols ∨ R.CredAt π c (.lab 0 w u) τ)
    (hB : (u, w) ∈ (R.VCr π c τ).kc ∨ R.CredAt π c (.rc 1 u (ovCalls R.G u) w) τ) : False := by
  classical
  have hf := known_C.1 (R.cred_fresh π hC)
  simp only [P3ChainKnow.fresh, Finset.mem_filter] at hf
  apply hf.2
  refine ⟨?_, ?_⟩
  · rcases hA with h | h
    · exact Finset.mem_union_left _ h
    · have := known_A.1 (R.cred_fresh π h)
      simp only [P3ChainKnow.fresh, Finset.mem_sdiff] at this
      exact Finset.mem_union_right _ this.1
  · rcases hB with h | h
    · exact Finset.mem_union_left _ h
    · have := known_B.1 (R.cred_fresh π h)
      simp only [P3ChainKnow.fresh, Finset.mem_filter, Finset.mem_sdiff] at this
      exact Finset.mem_union_right _ this.1.1

/-- **The key filter**: a top-key credit's column is not shown in its round while its `pin2` is known. -/
theorem no_B_fresh {τ : ℕ} (hB' : R.CredAt π c (.rc 1 u (ovCalls R.G u) w) τ) (hA' : R.CredAt π c (.lab 0 w u) τ)
    (hC : (u, w) ∈ (R.VCr π c τ).pc) : False := by
  classical
  have hf := known_B.1 (R.cred_fresh π hB')
  simp only [P3ChainKnow.fresh, Finset.mem_filter] at hf
  apply hf.2
  have := known_A.1 (R.cred_fresh π hA')
  simp only [P3ChainKnow.fresh, Finset.mem_sdiff] at this
  exact ⟨this.1, hC⟩


theorem rnd_mono {j j' : ℕ} (h : j ≤ j') (hj' : j' < (sched R π).length) : R.rnd π j ≤ R.rnd π j' := by
  rcases h.lt_or_eq with h | rfl
  · obtain ⟨_, v, i, hi, he⟩ := R.rnd_spec π (by omega : j < (sched R π).length)
    exact R.le_rnd π hj' hi (by omega)
  · exact le_rfl

theorem lt_of_rnd_lt {j j' : ℕ} (hj : j < (sched R π).length) (h : R.rnd π j < R.rnd π j') : j < j' := by
  by_contra hle
  exact absurd (R.rnd_mono π (not_lt.1 hle) hj) (not_le.2 h)

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))

variable {c : ℕ} {u w : Fin n}

/-- **No triple has three credits.** At the latest round, the other two are known or shown, and `fresh` drops it. -/
theorem three_cred {τA τB τC : ℕ} (hA' : R.CredAt π c (.lab 0 w u) τA)
    (hB : R.CredAt π c (.rc 1 u (ovCalls R.G u) w) τB) (hC : R.CredAt π c (.pin2 u w) τC) : False := by
  by_cases hAC : τA < τC
  · by_cases hBC : τB < τC
    · exact R.no_C π hC (known_A.1 (R.cred_in π hA' hAC)) (known_B.1 (R.cred_in π hB hBC))
    · rcases (not_lt.1 hBC).lt_or_eq with hBC' | hBC'
      · exact R.no_B π hB (known_A.1 (R.cred_in π hA' (by omega))) (known_C.1 (R.cred_in π hC hBC'))
      · subst hBC'
        exact R.no_C_fresh π hC (Or.inl (known_A.1 (R.cred_in π hA' hAC))) (Or.inr hB)
  · rcases (not_lt.1 hAC).lt_or_eq with hAC' | hAC'
    · by_cases hBA : τB < τA
      · exact R.no_A π hA' (known_B.1 (R.cred_in π hB hBA)) (known_C.1 (R.cred_in π hC hAC'))
      · rcases (not_lt.1 hBA).lt_or_eq with hBA' | hBA'
        · exact R.no_B π hB (known_A.1 (R.cred_in π hA' hBA')) (known_C.1 (R.cred_in π hC (by omega)))
        · subst hBA'
          exact R.no_B_fresh π hB hA' (known_C.1 (R.cred_in π hC hAC'))
    · subst hAC'
      by_cases hBC : τB < τC
      · exact R.no_C_fresh π hC (Or.inr hA') (Or.inl (known_B.1 (R.cred_in π hB hBC)))
      · rcases (not_lt.1 hBC).lt_or_eq with hBC' | hBC'
        · exact R.no_B π hB (known_A.1 (R.cred_in π hA' hBC')) (known_C.1 (R.cred_in π hC hBC'))
        · subst hBC'
          exact R.no_C_fresh π hC (Or.inr hA') (Or.inr hB)

/-- The layer of a pair. -/
def _root_.Pous.P3Concrete.HPt.lvl : HPt n → ℕ
  | .chain L _ _ => L
  | .low _ => 0
  | .top _ => 1

/-- **A pair's cells are of its layer.** -/
theorem level_cellAt {x : HPt n} {o : Bool} {k : ℕ} {y : HCell n} (h : cellAt R.G x o k = some y) :
    y.level = x.lvl := by
  rcases x with ⟨L, v, p⟩ | w' | u' <;> rcases o with _ | _
  all_goals simp only [cellAt] at h
  all_goals split_ifs at h <;> (try split at h) <;> first | (simp at h; done) | (simp at h; subst h; rfl)

/-- **How a `pin2` cell is reached**: credited, or as the unknown partner of `c²_u(w)` after the top pair was
inverse-decided. -/
theorem reached_pin2 (hc : c ≤ (sched R π).length) (h : R.Reached π c (.pin2 u w)) :
    (HCell.pin2 u w).known R.G (R.Kfull π c) ∨
      (¬ R.Fwd π c (.top u) ∧ (u, w) ∉ (R.kn π c (R.dstep π c (.top u))).pc) := by
  obtain ⟨z, k, hz, hk⟩ := h
  rcases k with _ | k
  · simp only [nextN] at hk
    obtain rfl := Option.some_inj.1 hk
    exact Or.inl hz.2
  · obtain ⟨y, _, hn⟩ := (R.nextN_succ π).1 hk
    rcases y with ⟨L, u', k'⟩ | ⟨L, v, p, k'⟩ | ⟨L, v, p, k'⟩ | ⟨u', w'⟩
    rotate_left 3
    · rcases R.next_pin2 π hn with ⟨he, _⟩ | ⟨he, _⟩ <;> simp at he
    all_goals
      rw [R.next_of_ne_pin2 π (pin2_ne_of_isOut rfl)] at hn
      obtain ⟨hF, hy, hnk⟩ := R.nextP_some π hn
      have hx := HCell.home_of_pin2 hy
      rw [hx] at hF hnk
      refine Or.inr ⟨fun h => hF (iff_of_true h rfl), fun h => hnk (known_C.2 h)⟩

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))

variable {c : ℕ}

/-- **TR3, the triple's rank.** A reached `pin2_u(w)` whose `c¹_w(u)` is credited or entered by a transfer has no
credited `key²_u(w)`: three entries would make the last one derivable when it was credited. -/
theorem tr3 (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    (hc : c ≤ (sched R π).length) : R.TR3 π c := by
  intro u w hreach hent hkcF
  obtain ⟨τB, hτB, hB⟩ := R.cred_round π c (.rc 1 u (ovCalls R.G u) w) _ (known_B.2 hkcF)
  have hBkn : ∀ j, (c ≤ j ∨ τB ≤ R.rnd π j) → (u, w) ∈ (R.kn π c j).kc := fun j hj =>
    known_B.1 (R.credAt_known π hB (by omega) hj)
  have hCcell : cellAt R.G (.top u) false w = some (.pin2 u w) := by simp [cellAt, w.isLt]
  have hvt : (HPt.top u : HPt n).Valid R.G := trivial
  have hCearly : ∀ τ, R.dstep π c (.top u) < c → R.rnd π (R.dstep π c (.top u)) < τ →
      (u, w) ∈ (R.VCr π c τ).pc :=
    fun τ h1 h2 => known_C.1 (R.early_cells π hA hnb hc hvt h1 h2 hCcell)
  rcases R.reached_pin2 π hc hreach with hCcr | ⟨_, hCunk⟩
  · obtain ⟨τC, hτC, hC⟩ := R.cred_round π c (.pin2 u w) _ hCcr
    have hCkn : ∀ j, (c ≤ j ∨ τC ≤ R.rnd π j) → (u, w) ∈ (R.kn π c j).pc := fun j hj =>
      known_C.1 (R.credAt_known π hC (by omega) hj)
    rcases hent with hAcr | ⟨y', hy'v, hnP⟩
    · obtain ⟨τA, _, hA'⟩ := R.cred_round π c (.lab 0 w u) _ (known_A.2 hAcr)
      exact R.three_cred π hA' hB hC
    · obtain ⟨_, hy, hnk⟩ := R.nextP_some π hnP
      have hXv : y'.home.Valid R.G := HCell.home_valid hy'v
      have hAunk : (w, u) ∉ (R.kn π c (R.dstep π c y'.home)).cols := fun h => hnk (known_A.2 h)
      have hAearly : ∀ τ, R.dstep π c y'.home < c → R.rnd π (R.dstep π c y'.home) < τ →
          (w, u) ∈ (R.VCr π c τ).cols :=
        fun τ h1 h2 => known_A.1 (R.early_cells π hA hnb hc hXv h1 h2 hy)
      have hnot : ¬ ((c ≤ R.dstep π c y'.home ∨ τB ≤ R.rnd π (R.dstep π c y'.home)) ∧
          (c ≤ R.dstep π c y'.home ∨ τC ≤ R.rnd π (R.dstep π c y'.home))) := fun ⟨h1, h2⟩ =>
        hAunk (tri_col (R.kn_asm π c _) (hBkn _ h1) (hCkn _ h2))
      have htc : R.dstep π c y'.home < c := by
        by_contra h; exact hnot ⟨Or.inl (not_lt.1 h), Or.inl (not_lt.1 h)⟩
      by_cases hBt : τB ≤ R.rnd π (R.dstep π c y'.home)
      · have hCt : R.rnd π (R.dstep π c y'.home) < τC := by
          by_contra h; exact hnot ⟨Or.inr hBt, Or.inr (not_lt.1 h)⟩
        exact R.no_C π hC (hAearly τC htc hCt) (known_B.1 (R.cred_in π hB (by omega)))
      · have hBt' := not_le.1 hBt
        by_cases hCt : τC ≤ R.rnd π (R.dstep π c y'.home)
        · exact R.no_B π hB (hAearly τB htc hBt') (known_C.1 (R.cred_in π hC (by omega)))
        · have hCt' := not_le.1 hCt
          rcases lt_trichotomy τB τC with h | h | h
          · exact R.no_C π hC (hAearly τC htc hCt') (known_B.1 (R.cred_in π hB h))
          · subst h
            exact R.no_C_fresh π hC (Or.inl (hAearly τB htc hBt')) (Or.inr hB)
          · exact R.no_B π hB (hAearly τB htc hBt') (known_C.1 (R.cred_in π hC h))
  · have hnot : (w, u) ∈ (R.kn π c (R.dstep π c (.top u))).cols →
        (u, w) ∈ (R.kn π c (R.dstep π c (.top u))).kc → False := fun hA hB =>
      hCunk (tri_pc (R.kn_asm π c _) hA hB)
    rcases hent with hAcr | ⟨y', hy'v, hnP⟩
    · obtain ⟨τA, hτA, hA'⟩ := R.cred_round π c (.lab 0 w u) _ (known_A.2 hAcr)
      have hAkn : ∀ j, (c ≤ j ∨ τA ≤ R.rnd π j) → (w, u) ∈ (R.kn π c j).cols := fun j hj =>
        known_A.1 (R.credAt_known π hA' (by omega) hj)
      have ht₁c : R.dstep π c (.top u) < c := by
        by_contra h; exact hnot (hAkn _ (Or.inl (not_lt.1 h))) (hBkn _ (Or.inl (not_lt.1 h)))
      by_cases hAt : τA ≤ R.rnd π (R.dstep π c (.top u))
      · have hBt : R.rnd π (R.dstep π c (.top u)) < τB := by
          by_contra h; exact hnot (hAkn _ (Or.inr hAt)) (hBkn _ (Or.inr (not_lt.1 h)))
        exact R.no_B π hB (known_A.1 (R.cred_in π hA' (by omega))) (hCearly τB ht₁c hBt)
      · have hAt' := not_le.1 hAt
        by_cases hBt : τB ≤ R.rnd π (R.dstep π c (.top u))
        · exact R.no_A π hA' (known_B.1 (R.cred_in π hB (by omega))) (hCearly τA ht₁c hAt')
        · have hBt' := not_le.1 hBt
          rcases lt_trichotomy τA τB with h | h | h
          · exact R.no_B π hB (known_A.1 (R.cred_in π hA' h)) (hCearly τB ht₁c hBt')
          · subst h
            exact R.no_B_fresh π hB hA' (hCearly τA ht₁c hAt')
          · exact R.no_A π hA' (known_B.1 (R.cred_in π hB h)) (hCearly τA ht₁c hAt')
    · obtain ⟨_, hy, hnk⟩ := R.nextP_some π hnP
      have hXv : y'.home.Valid R.G := HCell.home_valid hy'v
      have hAunk : (w, u) ∉ (R.kn π c (R.dstep π c y'.home)).cols := fun h => hnk (known_A.2 h)
      have hAearly : ∀ τ, R.dstep π c y'.home < c → R.rnd π (R.dstep π c y'.home) < τ →
          (w, u) ∈ (R.VCr π c τ).cols :=
        fun τ h1 h2 => known_A.1 (R.early_cells π hA hnb hc hXv h1 h2 hy)
      have hne : R.dstep π c y'.home ≠ R.dstep π c (.top u) := by
        intro e
        have := R.dstep_inj π hc hnb hXv hvt e
        have hl := R.level_cellAt hy
        rw [this] at hl
        simp [HCell.level, HPt.lvl] at hl
      rcases lt_or_gt_of_ne hne with hlt | hlt
      · have hAt₁ : (w, u) ∈ (R.kn π c (R.dstep π c (.top u))).cols :=
          known_A.1 (R.known_of_fixed π hA hnb hc hXv hlt hy)
        have ht₁c : R.dstep π c (.top u) < c := by
          by_contra h; exact hnot hAt₁ (hBkn _ (Or.inl (not_lt.1 h)))
        have hBt : R.rnd π (R.dstep π c (.top u)) < τB := by
          by_contra h; exact hnot hAt₁ (hBkn _ (Or.inr (not_lt.1 h)))
        exact R.no_B π hB (hAearly τB (by omega) (lt_of_le_of_lt (R.rnd_mono π hlt.le (by omega)) hBt))
          (hCearly τB ht₁c hBt)
      · have hCt : (u, w) ∈ (R.kn π c (R.dstep π c y'.home)).pc :=
          known_C.1 (R.known_of_fixed π hA hnb hc hvt hlt hCcell)
        have htc : R.dstep π c y'.home < c := by
          by_contra h; exact hAunk (tri_col (R.kn_asm π c _) (hBkn _ (Or.inl (not_lt.1 h))) hCt)
        have hBt : R.rnd π (R.dstep π c y'.home) < τB := by
          by_contra h; exact hAunk (tri_col (R.kn_asm π c _) (hBkn _ (Or.inr (not_lt.1 h))) hCt)
        exact R.no_B π hB (hAearly τB htc hBt)
          (hCearly τB (by omega) (lt_of_le_of_lt (R.rnd_mono π hlt.le (by omega)) hBt))

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))

variable {c : ℕ} {u w : Fin n}

/-- How `C = pin2_u(w)` got into a chain. -/
def CIn (c : ℕ) (u w : Fin n) : Prop :=
  (HCell.pin2 u w).known R.G (R.Kfull π c) ∨ (u, w) ∉ (R.kn π c (R.dstep π c (.top u))).pc

variable (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
  (hc : c ≤ (sched R π).length)
include hA hnb hc

theorem cell_C : cellAt R.G (.top u) false w = some (.pin2 u w) := by simp [cellAt, w.isLt]

/-- **`C` is known at `j`** if both `A` and `B` are fixed by `j` (in every later round's closure, and known at every
later step). -/
theorem C_known {j : ℕ} (hC : R.CIn π c u w) (hj : j ≠ R.dstep π c (.top u))
    (hAv : ∀ τ, j < c → R.rnd π j < τ → (w, u) ∈ (R.VCr π c τ).cols)
    (hBv : ∀ τ, j < c → R.rnd π j < τ → (u, w) ∈ (R.VCr π c τ).kc)
    (hAk : ∀ j', j < j' → (w, u) ∈ (R.kn π c j').cols) (hBk : ∀ j', j < j' → (u, w) ∈ (R.kn π c j').kc) :
    (u, w) ∈ (R.kn π c j).pc := by
  rcases hC with hCcr | hCunk
  · obtain ⟨τC, hτC, hC⟩ := R.cred_round π c (.pin2 u w) _ hCcr
    by_cases h : c ≤ j ∨ τC ≤ R.rnd π j
    · exact known_C.1 (R.credAt_known π hC (by omega) h)
    · push Not at h
      exact absurd (R.no_C π hC (hAv τC h.1 h.2) (hBv τC h.1 h.2)) not_false
  · rcases lt_or_gt_of_ne hj with h | h
    · exact absurd (tri_pc (R.kn_asm π c _) (hAk _ h) (hBk _ h)) hCunk
    · exact known_C.1 (R.known_of_fixed π hA hnb hc (x := .top u) trivial h (R.cell_C π hA hnb hc))

/-- **`C` is known at `j`** if `A` is credited and `B` is fixed by `j`. -/
theorem C_known_A {j τA : ℕ} (hC : R.CIn π c u w) (hj : j ≠ R.dstep π c (.top u))
    (hA' : R.CredAt π c (.lab 0 w u) τA) (hτA : τA ≤ R.D)
    (hBv : ∀ τ, j < c → R.rnd π j < τ → (u, w) ∈ (R.VCr π c τ).kc) (hBk : ∀ j', j < j' → (u, w) ∈ (R.kn π c j').kc) :
    (u, w) ∈ (R.kn π c j).pc := by
  rcases hC with hCcr | hCunk
  · obtain ⟨τC, hτC, hC⟩ := R.cred_round π c (.pin2 u w) _ hCcr
    by_cases h : c ≤ j ∨ τC ≤ R.rnd π j
    · exact known_C.1 (R.credAt_known π hC (by omega) h)
    · push Not at h
      exfalso
      rcases lt_trichotomy τA τC with e | e | e
      · exact R.no_C π hC (known_A.1 (R.cred_in π hA' e)) (hBv τC h.1 h.2)
      · subst e; exact R.no_C_fresh π hC (Or.inr hA') (Or.inl (hBv τA h.1 h.2))
      · exact R.no_A π hA' (hBv τA h.1 (by omega)) (known_C.1 (R.cred_in π hC e))
  · rcases lt_or_gt_of_ne hj with h | h
    · exfalso
      by_cases h' : c ≤ R.dstep π c (.top u) ∨ τA ≤ R.rnd π (R.dstep π c (.top u))
      · exact hCunk (tri_pc (R.kn_asm π c _) (known_A.1 (R.credAt_known π hA' hτA h')) (hBk _ h))
      · push Not at h'
        exact R.no_A π hA' (hBv τA (by omega) (lt_of_le_of_lt (R.rnd_mono π h.le (by omega)) h'.2))
          (known_C.1 (R.early_cells π hA hnb hc (x := .top u) trivial h'.1 h'.2 (R.cell_C π hA hnb hc)))
    · exact known_C.1 (R.known_of_fixed π hA hnb hc (x := .top u) trivial h (R.cell_C π hA hnb hc))

/-- **`C` is known at `j`** if `B` is credited and `A` is fixed by `j`. -/
theorem C_known_B {j τB : ℕ} (hC : R.CIn π c u w) (hj : j ≠ R.dstep π c (.top u))
    (hB : R.CredAt π c (.rc 1 u (ovCalls R.G u) w) τB) (hτB : τB ≤ R.D)
    (hAv : ∀ τ, j < c → R.rnd π j < τ → (w, u) ∈ (R.VCr π c τ).cols) (hAk : ∀ j', j < j' → (w, u) ∈ (R.kn π c j').cols) :
    (u, w) ∈ (R.kn π c j).pc := by
  rcases hC with hCcr | hCunk
  · obtain ⟨τC, hτC, hC⟩ := R.cred_round π c (.pin2 u w) _ hCcr
    by_cases h : c ≤ j ∨ τC ≤ R.rnd π j
    · exact known_C.1 (R.credAt_known π hC (by omega) h)
    · push Not at h
      exfalso
      rcases lt_trichotomy τB τC with e | e | e
      · exact R.no_C π hC (hAv τC h.1 h.2) (known_B.1 (R.cred_in π hB e))
      · subst e; exact R.no_C_fresh π hC (Or.inl (hAv τB h.1 h.2)) (Or.inr hB)
      · exact R.no_B π hB (hAv τB h.1 (by omega)) (known_C.1 (R.cred_in π hC e))
  · rcases lt_or_gt_of_ne hj with h | h
    · exfalso
      by_cases h' : c ≤ R.dstep π c (.top u) ∨ τB ≤ R.rnd π (R.dstep π c (.top u))
      · exact hCunk (tri_pc (R.kn_asm π c _) (hAk _ h) (known_B.1 (R.credAt_known π hB hτB h')))
      · push Not at h'
        exact R.no_B π hB (hAv τB (by omega) (lt_of_le_of_lt (R.rnd_mono π h.le (by omega)) h'.2))
          (known_C.1 (R.early_cells π hA hnb hc (x := .top u) trivial h'.1 h'.2 (R.cell_C π hA hnb hc)))
    · exact known_C.1 (R.known_of_fixed π hA hnb hc (x := .top u) trivial h (R.cell_C π hA hnb hc))

/-- **A credited `A` is known at `j`** if `B` is fixed by `j` (and `C` is in a chain). -/
theorem A_known {j τA : ℕ} (hC : R.CIn π c u w) (hj : j ≠ R.dstep π c (.top u)) (hjl : j < (sched R π).length ∨ c ≤ j)
    (hA' : R.CredAt π c (.lab 0 w u) τA) (hτA : τA ≤ R.D)
    (hBv : ∀ τ, j < c → R.rnd π j < τ → (u, w) ∈ (R.VCr π c τ).kc) (hBk : ∀ j', j < j' → (u, w) ∈ (R.kn π c j').kc) :
    (w, u) ∈ (R.kn π c j).cols := by
  by_cases h : c ≤ j ∨ τA ≤ R.rnd π j
  · exact known_A.1 (R.credAt_known π hA' hτA h)
  push Not at h
  exfalso
  rcases hC with hCcr | hCunk
  · obtain ⟨τC, hτC, hC⟩ := R.cred_round π c (.pin2 u w) _ hCcr
    rcases lt_trichotomy τC τA with e | e | e
    · exact R.no_A π hA' (hBv τA h.1 h.2) (known_C.1 (R.cred_in π hC e))
    · subst e; exact R.no_C_fresh π hC (Or.inr hA') (Or.inl (hBv τC h.1 h.2))
    · exact R.no_C π hC (known_A.1 (R.cred_in π hA' e)) (hBv τC h.1 (by omega))
  · by_cases h' : R.dstep π c (.top u) < c ∧ R.rnd π (R.dstep π c (.top u)) < τA
    · exact R.no_A π hA' (hBv τA h.1 h.2)
        (known_C.1 (R.early_cells π hA hnb hc (x := .top u) trivial h'.1 h'.2 (R.cell_C π hA hnb hc)))
    · have h'' : c ≤ R.dstep π c (.top u) ∨ τA ≤ R.rnd π (R.dstep π c (.top u)) := by
        by_contra hh; push Not at hh h'; exact absurd (h' hh.1) (not_le.2 hh.2)
      have hjt : j < R.dstep π c (.top u) := by
        rcases h'' with h'' | h''
        · omega
        · exact R.lt_of_rnd_lt π (by omega) (lt_of_lt_of_le h.2 h'')
      exact hCunk (tri_pc (R.kn_asm π c _) (known_A.1 (R.credAt_known π hA' hτA h'')) (hBk _ hjt))

/-- **A credited `B` is known at `j`** if `A` is fixed by `j` (and `C` is in a chain). -/
theorem B_known {j τB : ℕ} (hC : R.CIn π c u w) (hj : j ≠ R.dstep π c (.top u))
    (hB : R.CredAt π c (.rc 1 u (ovCalls R.G u) w) τB) (hτB : τB ≤ R.D)
    (hAv : ∀ τ, j < c → R.rnd π j < τ → (w, u) ∈ (R.VCr π c τ).cols) (hAk : ∀ j', j < j' → (w, u) ∈ (R.kn π c j').cols) :
    (u, w) ∈ (R.kn π c j).kc := by
  by_cases h : c ≤ j ∨ τB ≤ R.rnd π j
  · exact known_B.1 (R.credAt_known π hB hτB h)
  push Not at h
  exfalso
  rcases hC with hCcr | hCunk
  · obtain ⟨τC, hτC, hC⟩ := R.cred_round π c (.pin2 u w) _ hCcr
    rcases lt_trichotomy τC τB with e | e | e
    · exact R.no_B π hB (hAv τB h.1 h.2) (known_C.1 (R.cred_in π hC e))
    · subst e; exact R.no_C_fresh π hC (Or.inl (hAv τC h.1 h.2)) (Or.inr hB)
    · exact R.no_C π hC (hAv τC h.1 (by omega)) (known_B.1 (R.cred_in π hB e))
  · by_cases h' : R.dstep π c (.top u) < c ∧ R.rnd π (R.dstep π c (.top u)) < τB
    · exact R.no_B π hB (hAv τB h.1 h.2)
        (known_C.1 (R.early_cells π hA hnb hc (x := .top u) trivial h'.1 h'.2 (R.cell_C π hA hnb hc)))
    · have h'' : c ≤ R.dstep π c (.top u) ∨ τB ≤ R.rnd π (R.dstep π c (.top u)) := by
        by_contra hh; push Not at hh h'; exact absurd (h' hh.1) (not_le.2 hh.2)
      have hjt : j < R.dstep π c (.top u) := by
        rcases h'' with h'' | h''
        · omega
        · exact R.lt_of_rnd_lt π (by omega) (lt_of_lt_of_le h.2 h'')
      exact hCunk (tri_pc (R.kn_asm π c _) (hAk _ hjt) (known_B.1 (R.credAt_known π hB hτB h'')))

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))

variable {c : ℕ}

/-- **XV, the triple's validity.** The sample the `pin2` rule picks is known at its first fresh step. -/
theorem xv (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    (hc : c ≤ (sched R π).length) : R.XV π c := by
  intro u w e hreach hn _
  have hCin : R.CIn π c u w := by
    rcases R.reached_pin2 π hc hreach with h | ⟨_, h⟩
    · exact Or.inl h
    · exact Or.inr h
  have hAcell : cellAt R.G (.low w) true u = some (.lab 0 w u) := by simp [cellAt, u.isLt]
  have hBcell : cellAt R.G (.chain 1 u (ovCalls R.G u)) true w = some (.rc 1 u (ovCalls R.G u) w) := by
    simp [cellAt, w.isLt]
  have hvl : (HPt.low w : HPt n).Valid R.G := trivial
  have hvb : (HPt.chain 1 u (ovCalls R.G u) : HPt n).Valid R.G := ⟨ovCalls_pos R.G u, le_rfl⟩
  have hvt : (HPt.top u : HPt n).Valid R.G := trivial
  have hAe : ∀ τ, R.dstep π c (.low w) < c → R.rnd π (R.dstep π c (.low w)) < τ → (w, u) ∈ (R.VCr π c τ).cols :=
    fun τ h1 h2 => known_A.1 (R.early_cells π hA hnb hc hvl h1 h2 hAcell)
  have hBe : ∀ τ, R.dstep π c (.chain 1 u (ovCalls R.G u)) < c →
      R.rnd π (R.dstep π c (.chain 1 u (ovCalls R.G u))) < τ → (u, w) ∈ (R.VCr π c τ).kc :=
    fun τ h1 h2 => known_B.1 (R.early_cells π hA hnb hc hvb h1 h2 hBcell)
  have hAf : ∀ j', R.dstep π c (.low w) < j' → (w, u) ∈ (R.kn π c j').cols :=
    fun j' h => known_A.1 (R.known_of_fixed π hA hnb hc hvl h hAcell)
  have hBf : ∀ j', R.dstep π c (.chain 1 u (ovCalls R.G u)) < j' → (u, w) ∈ (R.kn π c j').kc :=
    fun j' h => known_B.1 (R.known_of_fixed π hA hnb hc hvb h hBcell)
  have hab : R.dstep π c (.low w) ≠ R.dstep π c (.chain 1 u (ovCalls R.G u)) := fun e => by
    have := R.dstep_inj π hc hnb hvl hvb e; simp at this
  have hat : R.dstep π c (.low w) ≠ R.dstep π c (.top u) := fun e => by
    have := R.dstep_inj π hc hnb hvl hvt e; simp at this
  have hbt : R.dstep π c (.chain 1 u (ovCalls R.G u)) ≠ R.dstep π c (.top u) := fun e => by
    have := R.dstep_inj π hc hnb hvb hvt e; simp at this
  have hsl : ∀ {j : ℕ}, j < c → j < (sched R π).length := fun h => by omega
  rcases R.next_pin2 π hn with ⟨rfl, hBr⟩ | ⟨rfl, hno, hAr⟩
  · -- `B`, at the top pad's first fresh step `b`
    show (HCell.rc 1 u (ovCalls R.G u) w).known R.G (R.kn π c (R.dstep π c (.chain 1 u (ovCalls R.G u))))
    refine known_B.2 (tri_kc (R.kn_asm π c _) ?_ ?_)
    · rcases hBr with (hAcr | ⟨y', hy'v, hnP⟩) | ⟨_, hlt⟩
      · obtain ⟨τA, hτA, hA'⟩ := R.cred_round π c (.lab 0 w u) _ (known_A.2 hAcr)
        exact R.A_known π hA hnb hc hCin hbt (by rcases lt_or_ge _ c with h | h; exact Or.inl (hsl h); exact Or.inr h)
          hA' (by omega) hBe hBf
      · obtain ⟨_, hy, hnk⟩ := R.nextP_some π hnP
        have hXv := HCell.home_valid hy'v
        rcases lt_or_gt_of_ne (show R.dstep π c y'.home ≠ R.dstep π c (.chain 1 u (ovCalls R.G u)) from fun e => by
            have := R.dstep_inj π hc hnb hXv hvb e
            have hl := R.level_cellAt hy
            rw [this] at hl; simp [HCell.level, HPt.lvl] at hl) with hlt | hlt
        · exact known_A.1 (R.known_of_fixed π hA hnb hc hXv hlt hy)
        · -- a transfer after `b` finds `B` known, so `C` unknown: impossible
          exfalso
          have hAunk : (w, u) ∉ (R.kn π c (R.dstep π c y'.home)).cols := fun h => hnk (known_A.2 h)
          have hBt := hBf _ hlt
          have hCunk : (u, w) ∉ (R.kn π c (R.dstep π c y'.home)).pc := fun h =>
            hAunk (tri_col (R.kn_asm π c _) hBt h)
          rcases hCin with hCcr | hCt₁
          · obtain ⟨τC, hτC, hC⟩ := R.cred_round π c (.pin2 u w) _ hCcr
            by_cases h : c ≤ R.dstep π c y'.home ∨ τC ≤ R.rnd π (R.dstep π c y'.home)
            · exact hCunk (known_C.1 (R.credAt_known π hC (by omega) h))
            · push Not at h
              exact R.no_C π hC (known_A.1 (R.early_cells π hA hnb hc hXv h.1 h.2 hy))
                (hBe τC (by omega) (lt_of_le_of_lt (R.rnd_mono π hlt.le (hsl h.1)) h.2))
          · have hne : R.dstep π c y'.home ≠ R.dstep π c (.top u) := fun e => by
              have := R.dstep_inj π hc hnb hXv hvt e
              have hl := R.level_cellAt hy
              rw [this] at hl; simp [HCell.level, HPt.lvl] at hl
            rcases lt_or_gt_of_ne hne with h | h
            · exact hCt₁ (tri_pc (R.kn_asm π c _) (known_A.1 (R.known_of_fixed π hA hnb hc hXv h hy))
                (hBf _ (by omega)))
            · exact hCunk (known_C.1 (R.known_of_fixed π hA hnb hc hvt h (R.cell_C π hA hnb hc)))
      · exact hAf _ hlt
    · rcases hBr with (hAcr | ⟨y', hy'v, hnP⟩) | ⟨_, hlt⟩
      · obtain ⟨τA, hτA, hA'⟩ := R.cred_round π c (.lab 0 w u) _ (known_A.2 hAcr)
        exact R.C_known_A π hA hnb hc hCin hbt hA' (by omega) hBe hBf
      · obtain ⟨_, hy, hnk⟩ := R.nextP_some π hnP
        have hXv := HCell.home_valid hy'v
        -- the transfer is before `b` (shown above, reproved)
        have hlt : R.dstep π c y'.home < R.dstep π c (.chain 1 u (ovCalls R.G u)) := by
          rcases lt_or_gt_of_ne (show R.dstep π c y'.home ≠ R.dstep π c (.chain 1 u (ovCalls R.G u)) from fun e => by
              have := R.dstep_inj π hc hnb hXv hvb e
              have hl := R.level_cellAt hy
              rw [this] at hl; simp [HCell.level, HPt.lvl] at hl) with hlt | hlt
          · exact hlt
          · exfalso
            have hAunk : (w, u) ∉ (R.kn π c (R.dstep π c y'.home)).cols := fun h => hnk (known_A.2 h)
            have hBt := hBf _ hlt
            have hCunk : (u, w) ∉ (R.kn π c (R.dstep π c y'.home)).pc := fun h =>
              hAunk (tri_col (R.kn_asm π c _) hBt h)
            rcases hCin with hCcr | hCt₁
            · obtain ⟨τC, hτC, hC⟩ := R.cred_round π c (.pin2 u w) _ hCcr
              by_cases h : c ≤ R.dstep π c y'.home ∨ τC ≤ R.rnd π (R.dstep π c y'.home)
              · exact hCunk (known_C.1 (R.credAt_known π hC (by omega) h))
              · push Not at h
                exact R.no_C π hC (known_A.1 (R.early_cells π hA hnb hc hXv h.1 h.2 hy))
                  (hBe τC (by omega) (lt_of_le_of_lt (R.rnd_mono π hlt.le (hsl h.1)) h.2))
            · have hne : R.dstep π c y'.home ≠ R.dstep π c (.top u) := fun e => by
                have := R.dstep_inj π hc hnb hXv hvt e
                have hl := R.level_cellAt hy
                rw [this] at hl; simp [HCell.level, HPt.lvl] at hl
              rcases lt_or_gt_of_ne hne with h | h
              · exact hCt₁ (tri_pc (R.kn_asm π c _) (known_A.1 (R.known_of_fixed π hA hnb hc hXv h hy))
                  (hBf _ (by omega)))
              · exact hCunk (known_C.1 (R.known_of_fixed π hA hnb hc hvt h (R.cell_C π hA hnb hc)))
        exact R.C_known π hA hnb hc hCin hbt
          (fun τ h1 h2 => known_A.1 (R.early_cells π hA hnb hc hXv (by omega)
            (lt_of_le_of_lt (R.rnd_mono π hlt.le (hsl h1)) h2) hy))
          hBe (fun j' h => known_A.1 (R.known_of_fixed π hA hnb hc hXv (by omega) hy)) hBf
      · exact R.C_known π hA hnb hc hCin hbt
          (fun τ h1 h2 => hAe τ (by omega) (lt_of_le_of_lt (R.rnd_mono π hlt.le (hsl h1)) h2))
          hBe (fun j' h => hAf j' (by omega)) hBf
  · -- `A`, at `P₀(w)`'s first fresh step `a`
    show (HCell.lab 0 w u).known R.G (R.kn π c (R.dstep π c (.low w)))
    refine known_A.2 (tri_col (R.kn_asm π c _) ?_ ?_)
    · rcases hAr with hkc | hnlt
      · obtain ⟨τB, hτB, hB⟩ := R.cred_round π c (.rc 1 u (ovCalls R.G u) w) _ (known_B.2 hkc)
        exact R.B_known π hA hnb hc hCin hat hB (by omega) hAe hAf
      · exact hBf _ (lt_of_le_of_ne (not_lt.1 hnlt) (Ne.symm hab))
    · rcases hAr with hkc | hnlt
      · obtain ⟨τB, hτB, hB⟩ := R.cred_round π c (.rc 1 u (ovCalls R.G u) w) _ (known_B.2 hkc)
        exact R.C_known_B π hA hnb hc hCin hat hB (by omega) hAe hAf
      · have hlt := lt_of_le_of_ne (not_lt.1 hnlt) (Ne.symm hab)
        exact R.C_known π hA hnb hc hCin hat hAe
          (fun τ h1 h2 => hBe τ (by omega) (lt_of_le_of_lt (R.rnd_mono π hlt.le (hsl h1)) h2))
          hAf (fun j' h => hBf j' (by omega))

end P3SegT

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainCount ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

deriving instance DecidableEq for HPt

namespace HCell

variable {n : ℕ}

/-- The width of answer position `k`: the capacity `2n` is 512 bits, a component is `wc`. -/
def bitsAt (n wc k : ℕ) : ℕ := if k = 2 * n then 512 else wc

theorem bits_eq (wc : ℕ) (z : HCell n) : z.bits wc = bitsAt n wc z.pos := by
  unfold bitsAt
  by_cases h : z.pos = 2 * n
  · rw [if_pos h]
    rcases z with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩ <;> simp only [pos] at h
    · have := k.isLt; omega
    · simp only [bits]; rw [if_pos (by omega)]
    · have := k.isLt; omega
    · have := w.isLt; omega
  · rw [if_neg h]
    rcases z with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩ <;> simp only [pos] at h
    · rfl
    · simp only [bits]; rw [if_neg (by omega)]
    · rfl
    · rfl

end HCell

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))

/-- **A chain step keeps the width.** A positional step keeps the position; the `pin2` rule goes between
components. -/
theorem bits_next {c : ℕ} {z y : HCell n} (h : R.next π c z = some y) : y.bits wc = z.bits wc := by
  rcases z with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  rotate_left 3
  · rcases R.next_pin2 π h with ⟨rfl, _⟩ | ⟨rfl, _⟩ <;> rfl
  all_goals
    rw [R.next_of_ne_pin2 π (pin2_ne_of_isOut rfl)] at h
    obtain ⟨_, hy, _⟩ := R.nextP_some π h
    rw [HCell.bits_eq, HCell.bits_eq, HCell.pos_of_cellAt hy]

theorem bits_last (c : ℕ) : ∀ f (z : HCell n), (R.last π c f z).bits wc = z.bits wc
  | 0, z => rfl
  | f + 1, z => by
    simp only [last]
    cases hn : R.next π c z with
    | none => rfl
    | some y => simp only; rw [bits_last c f y, R.bits_next π hn]

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι)

/-- **A valid holding**: chain items at real calls, and no top pad among the `r`s (a top key is counted by
component, as `kc`). -/
def ValidK (K : P3ChainKnow n) : Prop :=
  (∀ p ∈ K.hs, 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1) ∧
  (∀ p ∈ K.rs, 1 ≤ p.2.2 ∧ p.2.2 ≤ ovCalls R.G p.2.1 ∧ ¬ (p.1 = 1 ∧ p.2.2 = ovCalls R.G p.2.1))

/-- **The cells of a holding's items.** -/
noncomputable def cellsOf (K : P3ChainKnow n) : Finset (HCell n) :=
  K.tops.biUnion (fun u => Finset.univ.image (fun k => HCell.lab 1 u k)) ∪
  K.cols.image (fun q => HCell.lab 0 q.1 q.2) ∪
  K.hs.biUnion (fun p => Finset.univ.image (fun k => HCell.hc p.1 p.2.1 p.2.2 k)) ∪
  K.rs.biUnion (fun p => Finset.univ.image (fun k => HCell.rc p.1 p.2.1 p.2.2 k)) ∪
  K.kc.image (fun q => HCell.rc 1 q.1 (ovCalls R.G q.1) q.2) ∪
  K.pc.image (fun q => HCell.pin2 q.1 q.2)

/-- **A holding's cells are known in it, and valid if it is.** -/
theorem mem_cellsOf {K : P3ChainKnow n} (hV : R.ValidK K) {z : HCell n} (hz : z ∈ R.cellsOf K) :
    z.known R.G K ∧ z.Valid R.G := by
  simp only [cellsOf, Finset.mem_union, Finset.mem_biUnion, Finset.mem_image, Finset.mem_univ, true_and] at hz
  rcases hz with ((((⟨u, hu, k, rfl⟩ | ⟨q, hq, rfl⟩) | ⟨p, hp, k, rfl⟩) | ⟨p, hp, k, rfl⟩) | ⟨q, hq, rfl⟩) |
    ⟨q, hq, rfl⟩
  · exact ⟨by simp [HCell.known, hu], trivial⟩
  · exact ⟨by simp [HCell.known, hq], trivial⟩
  · exact ⟨hp, hV.1 p hp⟩
  · have h := hV.2 p hp
    refine ⟨?_, h.1, h.2.1⟩
    simp only [HCell.known]
    rw [if_neg h.2.2]
    exact hp
  · exact ⟨by simp [HCell.known, hq], ovCalls_pos R.G _, le_rfl⟩
  · exact ⟨by simp [HCell.known, hq], trivial⟩


/-- Which piece of `cellsOf` a cell is in. -/
def tagOf : HCell n → ℕ
  | .lab L _ _ => if L = 1 then 0 else 1
  | .hc .. => 2
  | .rc L v p _ => if L = 1 ∧ p = ovCalls R.G v then 4 else 3
  | .pin2 .. => 5

/-- **A holding's cells carry its price in bits.** -/
theorem sum_bits_cellsOf {K : P3ChainKnow n} (hV : R.ValidK K) :
    ∑ z ∈ R.cellsOf K, z.bits wc =
      wc * (n * K.tops.card + K.cols.card + n * K.hs.card + n * K.rs.card + K.kc.card + K.pc.card) +
        512 * K.hs.card := by
  classical
  have hlab1 : ∑ z ∈ K.tops.biUnion (fun u => Finset.univ.image (fun k => HCell.lab 1 u k)), z.bits wc =
      wc * (n * K.tops.card) := by
    rw [Finset.sum_biUnion (fun a _ b _ hab => Finset.disjoint_left.2 fun z h1 h2 => by
      simp only [Finset.mem_image, Finset.mem_univ, true_and] at h1 h2
      obtain ⟨k, rfl⟩ := h1; obtain ⟨k', e⟩ := h2; simp at e; exact hab e.1.symm)]
    rw [Finset.sum_congr rfl fun u _ => Finset.sum_image (fun a _ b _ e => by simpa using e)]
    simp [HCell.bits, Finset.sum_const, Finset.card_univ]; ring
  have hlab0 : ∑ z ∈ K.cols.image (fun q => HCell.lab 0 q.1 q.2), z.bits wc = wc * K.cols.card := by
    rw [Finset.sum_image (fun a _ b _ e => by simp at e; exact Prod.ext e.1 e.2)]
    simp [HCell.bits, mul_comm]
  have hhc : ∑ z ∈ K.hs.biUnion (fun p => Finset.univ.image (fun k => HCell.hc p.1 p.2.1 p.2.2 k)), z.bits wc =
      (wc * n + 512) * K.hs.card := by
    rw [Finset.sum_biUnion (fun a _ b _ hab => Finset.disjoint_left.2 fun z h1 h2 => by
      simp only [Finset.mem_image, Finset.mem_univ, true_and] at h1 h2
      obtain ⟨k, rfl⟩ := h1; obtain ⟨k', e⟩ := h2; simp at e
      exact hab (Prod.ext e.1.symm (Prod.ext e.2.1.symm e.2.2.1.symm)))]
    rw [Finset.sum_congr rfl fun p _ => Finset.sum_image (fun a _ b _ e => by simpa using e)]
    have : ∀ p : Fin 2 × Fin n × ℕ, ∑ k : Fin (n + 1), (HCell.hc p.1 p.2.1 p.2.2 k).bits wc = wc * n + 512 := by
      intro p
      simp only [HCell.bits]
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.coe_castSucc, Fin.val_last, if_pos rfl]
      rw [Finset.sum_congr rfl fun (i : Fin n) _ => if_neg (by omega : ¬ (i : ℕ) = n)]
      simp [mul_comm]
    rw [Finset.sum_congr rfl fun p _ => this p]
    simp [mul_comm]
  have hrc : ∑ z ∈ K.rs.biUnion (fun p => Finset.univ.image (fun k => HCell.rc p.1 p.2.1 p.2.2 k)), z.bits wc =
      wc * (n * K.rs.card) := by
    rw [Finset.sum_biUnion (fun a _ b _ hab => Finset.disjoint_left.2 fun z h1 h2 => by
      simp only [Finset.mem_image, Finset.mem_univ, true_and] at h1 h2
      obtain ⟨k, rfl⟩ := h1; obtain ⟨k', e⟩ := h2; simp at e
      exact hab (Prod.ext e.1.symm (Prod.ext e.2.1.symm e.2.2.1.symm)))]
    rw [Finset.sum_congr rfl fun p _ => Finset.sum_image (fun a _ b _ e => by simpa using e)]
    simp [HCell.bits, Finset.sum_const, Finset.card_univ]; ring
  have hkc : ∑ z ∈ K.kc.image (fun q => HCell.rc 1 q.1 (ovCalls R.G q.1) q.2), z.bits wc = wc * K.kc.card := by
    rw [Finset.sum_image (fun a _ b _ e => by simp at e; exact Prod.ext e.1 e.2.2)]
    simp [HCell.bits, mul_comm]
  have hpc : ∑ z ∈ K.pc.image (fun q => HCell.pin2 q.1 q.2), z.bits wc = wc * K.pc.card := by
    rw [Finset.sum_image (fun a _ b _ e => by simp at e; exact Prod.ext e.1 e.2)]
    simp [HCell.bits, mul_comm]
  -- the pieces carry distinct tags
  have t0 : ∀ z ∈ K.tops.biUnion (fun u => Finset.univ.image (fun k => HCell.lab 1 u k)), R.tagOf z < 1 := by
    intro z hz
    simp only [Finset.mem_biUnion, Finset.mem_image, Finset.mem_univ, true_and] at hz
    obtain ⟨_, _, _, rfl⟩ := hz; simp [tagOf]
  have t1 : ∀ z ∈ K.cols.image (fun q => HCell.lab 0 q.1 q.2), R.tagOf z = 1 := by
    intro z hz
    simp only [Finset.mem_image] at hz
    obtain ⟨_, _, rfl⟩ := hz; simp [tagOf]
  have t2 : ∀ z ∈ K.hs.biUnion (fun p => Finset.univ.image (fun k => HCell.hc p.1 p.2.1 p.2.2 k)),
      R.tagOf z = 2 := by
    intro z hz
    simp only [Finset.mem_biUnion, Finset.mem_image, Finset.mem_univ, true_and] at hz
    obtain ⟨_, _, _, rfl⟩ := hz; rfl
  have t3 : ∀ z ∈ K.rs.biUnion (fun p => Finset.univ.image (fun k => HCell.rc p.1 p.2.1 p.2.2 k)),
      R.tagOf z = 3 := by
    intro z hz
    simp only [Finset.mem_biUnion, Finset.mem_image, Finset.mem_univ, true_and] at hz
    obtain ⟨p, hp, _, rfl⟩ := hz
    simp only [tagOf]; rw [if_neg (hV.2 p hp).2.2]
  have t4 : ∀ z ∈ K.kc.image (fun q => HCell.rc 1 q.1 (ovCalls R.G q.1) q.2), R.tagOf z = 4 := by
    intro z hz
    simp only [Finset.mem_image] at hz
    obtain ⟨_, _, rfl⟩ := hz; simp [tagOf]
  have t5 : ∀ z ∈ K.pc.image (fun q => HCell.pin2 q.1 q.2), R.tagOf z = 5 := by
    intro z hz
    simp only [Finset.mem_image] at hz
    obtain ⟨_, _, rfl⟩ := hz; rfl
  have hd : ∀ {A B : Finset (HCell n)} {i : ℕ}, (∀ z ∈ A, R.tagOf z < i) → (∀ z ∈ B, R.tagOf z = i) →
      Disjoint A B := fun hA hB => Finset.disjoint_left.2 fun z h1 h2 => by
    have := hA z h1; rw [hB z h2] at this; omega
  have hu : ∀ {A B : Finset (HCell n)} {i : ℕ}, (∀ z ∈ A, R.tagOf z < i) → (∀ z ∈ B, R.tagOf z = i) →
      ∀ z ∈ A ∪ B, R.tagOf z < i + 1 := fun hA hB z hz => by
    rcases Finset.mem_union.1 hz with h | h
    · have := hA z h; omega
    · have := hB z h; omega
  unfold cellsOf
  rw [Finset.sum_union (hd (hu (hu (hu (hu t0 t1) t2) t3) t4) t5),
    Finset.sum_union (hd (hu (hu (hu t0 t1) t2) t3) t4),
    Finset.sum_union (hd (hu (hu t0 t1) t2) t3),
    Finset.sum_union (hd (hu t0 t1) t2),
    Finset.sum_union (hd t0 t1),
    hlab1, hlab0, hhc, hrc, hkc, hpc]
  ring

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))


/-- **The cut holding is valid.** -/
theorem validK_onlineHC (ω : P3COmega n wc) (c : ℕ) : ∀ τ, R.ValidK (R.onlineHC ω c τ)
  | 0 => ⟨fun p hp => by simp [onlineHC, P3ChainKnow.empty] at hp, fun p hp => by simp [onlineHC, P3ChainKnow.empty] at hp⟩
  | τ + 1 => by
    classical
    have ih := validK_onlineHC ω c τ
    have hf := P3ChainKnow.fresh_sub (R.shownAtC ω c τ) (R.vc ω τ (R.onlineHC ω c τ))
    refine ⟨fun p hp => ?_, fun p hp => ?_⟩
    · rcases Finset.mem_union.1 hp with h | h
      · exact ih.1 p h
      · have := (Finset.mem_filter.1 (hf.2.2.1 p h).1).2; exact ⟨this.1, this.2.1⟩
    · rcases Finset.mem_union.1 hp with h | h
      · exact ih.2 p h
      · obtain ⟨_, h1, h2, h3⟩ := Finset.mem_filter.1 (hf.2.2.2.1 p h).1
        refine ⟨h1, h2, ?_⟩
        rcases h3 with ⟨_, h⟩ | ⟨h, _⟩
        · exact h
        · rintro ⟨h', _⟩; rw [h] at h'; exact absurd h' (by decide)

/-- The number of positions of a pair's answer. -/
def posN (x : HPt n) : ℕ :=
  match x with
  | .chain .. => 2 * n + 1
  | _ => n

theorem lt_posN {x : HPt n} {o : Bool} {k : ℕ} {y : HCell n} (h : cellAt R.G x o k = some y) : k < posN x := by
  rcases x with ⟨L, v, p⟩ | w | u <;> rcases o with _ | _ <;> simp only [cellAt, posN] at h ⊢ <;>
    split_ifs at h <;> (try split at h) <;> first | omega | (simp at h)

open Classical in
/-- **The pinned positions** of a pair's answer. -/
noncomputable def pinSet (c : ℕ) (x : HPt n) : Finset ℕ :=
  (Finset.range (posN x)).filter fun k => R.Pinned π c x k

/-- **The pinned width** of a pair's answer, in bits. -/
noncomputable def PW (c : ℕ) (x : HPt n) : ℕ := ∑ k ∈ R.pinSet π c x, HCell.bitsAt n wc k

/-- Enough steps to end every chain. -/
noncomputable abbrev fuel (c : ℕ) : ℕ := 5 * R.Tend π c + 5

/-- A chain's end. -/
noncomputable abbrev endOf (c : ℕ) (z : HCell n) : HCell n := R.last π c (R.fuel π c) z

theorem pot_lt_fuel {c : ℕ} (hc : c ≤ (sched R π).length) {z : HCell n} (hz : z.Valid R.G) :
    R.pot π c z < R.fuel π c := by
  show R.pot π c z < 5 * R.Tend π c + 5
  unfold pot
  split_ifs <;> omega

theorem terminal_isOut {c : ℕ} {e : HCell n} (h : R.next π c e = none) : e.isOut = true := by
  rcases e with _ | _ | _ | ⟨u, w⟩
  · rfl
  · rfl
  · rfl
  · simp only [next] at h; split_ifs at h <;> simp at h

/-- **The count.** For a valid sub-holding `K'` of the cut holding, the credited bits are at most the total pinned
width of the pairs where `K'`'s chains end. -/
theorem charge_count (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hnb : R.Good π)
    {c : ℕ} (hc : c ≤ (sched R π).length) {K' : P3ChainKnow n} (hle : P3ChainKnow.Le K' (R.Kfull π c))
    (hV : R.ValidK K') :
    ∑ z ∈ R.cellsOf K', z.bits wc ≤ ∑ x ∈ (R.cellsOf K').image (fun z => (R.endOf π c z).home), R.PW π c x := by
  classical
  set S := R.cellsOf K'
  set X := S.image (fun z => (R.endOf π c z).home)
  have hstart : ∀ z ∈ S, R.Start π c z := fun z hz =>
    ⟨(R.mem_cellsOf hV hz).2, HCell.known_mono hle (R.mem_cellsOf hV hz).1⟩
  have hterm : ∀ z ∈ S, R.next π c (R.endOf π c z) = none := fun z hz =>
    R.last_terminal π hA hnb hc _ z (hstart z hz).1 (R.pot_lt_fuel π hc (hstart z hz).1)
  have hreach : ∀ z ∈ S, R.Reached π c (R.endOf π c z) := fun z hz => by
    obtain ⟨k, hk⟩ := R.last_reach π c (R.fuel π c) z
    exact ⟨z, k, hstart z hz, hk⟩
  let g : HCell n → (Σ _ : HPt n, ℕ) := fun z => ⟨(R.endOf π c z).home, (R.endOf π c z).pos⟩
  have hinj : Set.InjOn g S := by
    intro z₁ h₁ z₂ h₂ e
    obtain ⟨eh, ep⟩ := Sigma.mk.inj_iff.1 e
    have ep' := eq_of_heq ep
    have hee : R.endOf π c z₁ = R.endOf π c z₂ :=
      HCell.eq_of_home (G := R.G) eh ((R.terminal_isOut π (hterm z₁ h₁)).trans (R.terminal_isOut π (hterm z₂ h₂)).symm) ep'
    obtain ⟨k₁, hk₁⟩ := R.last_reach π c (R.fuel π c) z₁
    obtain ⟨k₂, hk₂⟩ := R.last_reach π c (R.fuel π c) z₂
    rw [show R.last π c (R.fuel π c) z₁ = R.endOf π c z₂ from hee] at hk₁
    exact R.reach_unique π hA hnb hc (R.tr3 π hA hnb hc) k₁ k₂ (hstart z₁ h₁) (hstart z₂ h₂) hk₁ hk₂
  have hsub : S.image g ⊆ X.sigma (fun x => R.pinSet π c x) := by
    intro y hy
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.1 hy
    refine Finset.mem_sigma.2 ⟨Finset.mem_image_of_mem _ hz, Finset.mem_filter.2 ⟨Finset.mem_range.2 ?_, ?_⟩⟩
    · have hself := HCell.cellAt_self R.G (R.endOf π c z)
      exact R.lt_posN hself
    · exact R.end_pinned π hA hnb hc (R.xv π hA hnb hc) (hreach z hz) (hterm z hz)
  calc ∑ z ∈ S, z.bits wc
      = ∑ z ∈ S, HCell.bitsAt n wc (g z).2 := Finset.sum_congr rfl fun z _ => by
        rw [← R.bits_last π c (R.fuel π c) z, HCell.bits_eq]
    _ = ∑ y ∈ S.image g, HCell.bitsAt n wc y.2 :=
        (Finset.sum_image (f := fun y : (Σ _ : HPt n, ℕ) => HCell.bitsAt n wc y.2) hinj).symm
    _ ≤ ∑ y ∈ X.sigma (fun x => R.pinSet π c x), HCell.bitsAt n wc y.2 :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => Nat.zero_le _
    _ = ∑ x ∈ X, R.PW π c x := by rw [Finset.sum_sigma]; rfl

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc))


/-- **The thin pairs**: the `P` pairs and the pad calls, at most `4n`. -/
noncomputable def thinSet : Finset (HPt n) :=
  Finset.univ.image HPt.low ∪ Finset.univ.image HPt.top ∪
    Finset.univ.image (fun v => HPt.chain 0 v (ovCalls R.G v)) ∪
    Finset.univ.image (fun v => HPt.chain 1 v (ovCalls R.G v))

theorem card_thinSet : (R.thinSet).card ≤ 4 * n := by
  unfold thinSet
  refine (Finset.card_union_le _ _).trans ?_
  refine (Nat.add_le_add_right ((Finset.card_union_le _ _).trans
    (Nat.add_le_add_right (Finset.card_union_le _ _) _)) _).trans ?_
  have h := fun {β : Type} [DecidableEq β] (f : Fin n → β) => (Finset.card_image_le (s := Finset.univ) (f := f)).trans
    (le_of_eq (Finset.card_fin n))
  have := h HPt.low; have := h HPt.top
  have := h (fun v => HPt.chain 0 v (ovCalls R.G v)); have := h (fun v => HPt.chain 1 v (ovCalls R.G v))
  omega

/-- **Thin cells**: labels, `pin2`, and the pad calls' `r`. -/
def ThinCell : HCell n → Prop
  | .lab .. => True
  | .pin2 .. => True
  | .rc _ v p _ => p = ovCalls R.G v
  | .hc .. => False

theorem thin_home {z : HCell n} (h : R.ThinCell z) : z.home ∈ R.thinSet := by
  unfold thinSet
  simp only [Finset.mem_union, Finset.mem_image, Finset.mem_univ, true_and]
  rcases z with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  · by_cases hL : L = 0 <;> simp [HCell.home, hL]
  · exact absurd h id
  · simp only [ThinCell] at h; subst h
    have : L = 0 ∨ L = 1 := by fin_cases L <;> simp
    rcases this with rfl | rfl <;> simp [HCell.home]
  · simp [HCell.home]

/-- **A chain step from a thin cell lands on a thin cell.** -/
theorem thin_next {c : ℕ} {z y : HCell n} (h : R.ThinCell z) (hn : R.next π c z = some y) : R.ThinCell y := by
  rcases z with ⟨L, u, k⟩ | ⟨L, v, p, k⟩ | ⟨L, v, p, k⟩ | ⟨u, w⟩
  rotate_left 3
  · rcases R.next_pin2 π hn with ⟨rfl, _⟩ | ⟨rfl, _⟩
    · show ovCalls R.G u = ovCalls R.G u; rfl
    · trivial
  all_goals rw [R.next_of_ne_pin2 π (pin2_ne_of_isOut rfl)] at hn
  all_goals obtain ⟨_, hy, _⟩ := R.nextP_some π hn
  · have : L = 0 ∨ L = 1 := by fin_cases L <;> simp
    rcases this with rfl | rfl <;> simp [HCell.home, HCell.isOut, HCell.pos, cellAt, k.isLt] at hy <;>
      subst hy <;> first | trivial | rfl
  · exact absurd h id
  · simp only [ThinCell] at h; subst h
    simp [HCell.home, HCell.isOut, HCell.pos, cellAt, k.isLt, P3ChainKnow.ovBlock_pad] at hy

theorem thin_last {c : ℕ} : ∀ f {z : HCell n}, R.ThinCell z → R.ThinCell (R.last π c f z)
  | 0, _, h => h
  | f + 1, z, h => by
    simp only [last]
    cases hn : R.next π c z with
    | none => exact h
    | some y => exact thin_last f (R.thin_next π h hn)

/-- **A chain from a non-pad `r` cell stays at its call or goes thin.** -/
theorem rc_last {c : ℕ} {L : Fin 2} {v : Fin n} {p : ℕ} {k : Fin n} :
    ∀ f, (R.last π c f (.rc L v p k)).home = .chain L v p ∨ R.ThinCell (R.last π c f (.rc L v p k))
  | 0 => Or.inl rfl
  | f + 1 => by
    simp only [last]
    cases hn : R.next π c (.rc L v p k) with
    | none => exact Or.inl rfl
    | some y =>
      refine Or.inr (R.thin_last π f ?_)
      rw [R.next_of_ne_pin2 π (pin2_ne_of_isOut rfl)] at hn
      obtain ⟨_, hy, _⟩ := R.nextP_some π hn
      simp only [HCell.home, HCell.isOut, HCell.pos, cellAt, Bool.not_true, k.isLt, dif_pos] at hy
      split at hy
      · simp at hy; subst hy; trivial
      · simp at hy

open Classical in
/-- **The `h` step**: a chaining value's cells move together. -/
theorem next_hc {c : ℕ} {L : Fin 2} {v : Fin n} {p : ℕ} (k : Fin (n + 1)) :
    R.next π c (.hc L v p k) =
      if R.Fwd π c (.chain L v p) ∨ p ≤ 1 ∨ (L, v, p - 1) ∈ (R.kn π c (R.dstep π c (.chain L v p))).hs then none
      else some (HCell.hc L v (p - 1) k) := by
  show R.nextP π c _ = _
  unfold nextP
  simp only [HCell.home, HCell.isOut, iff_true]
  by_cases hF : R.Fwd π c (.chain L v p)
  · rw [if_pos hF, if_pos (Or.inl hF)]
  rw [if_neg hF]
  have hpart : (HCell.hc L v p k).partner R.G = if p ≤ 1 then none else some (.hc L v (p - 1) k) := by
    simp only [HCell.partner, HCell.home, HCell.isOut, HCell.pos, cellAt, Bool.not_true]
    rw [dif_neg (by omega)]
    split_ifs with h1 h2
    · rfl
    · congr 2; ext; simp
    · exact absurd (by omega : n + (k : ℕ) - n < n + 1) h2
  rw [hpart]
  by_cases hp : p ≤ 1
  · rw [if_pos hp, if_pos (Or.inr (Or.inl hp))]
  · rw [if_neg hp]
    show (if (HCell.hc L v (p - 1) k).known R.G (R.kn π c (R.dstep π c (HPt.chain L v p))) then none
      else some (HCell.hc L v (p - 1) k)) = _
    by_cases hk : (L, v, p - 1) ∈ (R.kn π c (R.dstep π c (.chain L v p))).hs
    · rw [if_pos (show (HCell.hc L v (p - 1) k).known R.G _ from hk), if_pos (Or.inr (Or.inr hk))]
    · rw [if_neg (show ¬ (HCell.hc L v (p - 1) k).known R.G _ from hk), if_neg (by tauto)]

/-- **A chaining value's cells end at one pair.** -/
theorem hc_last {c : ℕ} {L : Fin 2} {v : Fin n} : ∀ f {p : ℕ} (k k' : Fin (n + 1)),
    (R.last π c f (.hc L v p k)).home = (R.last π c f (.hc L v p k')).home
  | 0, p, k, k' => rfl
  | f + 1, p, k, k' => by
    classical
    simp only [last]
    rw [R.next_hc π k, R.next_hc π k']
    by_cases h : R.Fwd π c (.chain L v p) ∨ p ≤ 1 ∨ (L, v, p - 1) ∈ (R.kn π c (R.dstep π c (.chain L v p))).hs
    · rw [if_pos h, if_pos h]; rfl
    · rw [if_neg h, if_neg h]
      exact hc_last f k k'

/-- **The item count**: the pairs where a valid holding's chains end are thin, or one per chaining value or dropped
part it credits. -/
theorem card_ends {c : ℕ} {K' : P3ChainKnow n} :
    ((R.cellsOf K').image (fun z => (R.endOf π c z).home)).card ≤ 4 * n + K'.hs.card + K'.rs.card := by
  classical
  have hsub : (R.cellsOf K').image (fun z => (R.endOf π c z).home) ⊆
      R.thinSet ∪ K'.hs.image (fun p => (R.endOf π c (.hc p.1 p.2.1 p.2.2 0)).home) ∪
        K'.rs.image (fun p => HPt.chain p.1 p.2.1 p.2.2) := by
    intro x hx
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.1 hx
    simp only [cellsOf, Finset.mem_union, Finset.mem_biUnion, Finset.mem_image, Finset.mem_univ, true_and] at hz
    simp only [Finset.mem_union, Finset.mem_image]
    rcases hz with ((((⟨u, hu, k, rfl⟩ | ⟨q, hq, rfl⟩) | ⟨p, hp, k, rfl⟩) | ⟨p, hp, k, rfl⟩) | ⟨q, hq, rfl⟩) |
      ⟨q, hq, rfl⟩
    · exact Or.inl (Or.inl (R.thin_home (R.thin_last π _ trivial)))
    · exact Or.inl (Or.inl (R.thin_home (R.thin_last π _ trivial)))
    · exact Or.inl (Or.inr ⟨p, hp, R.hc_last π _ 0 k⟩)
    · rcases R.rc_last π (c := c) (L := p.1) (v := p.2.1) (p := p.2.2) (k := k) (R.fuel π c) with h | h
      · exact Or.inr ⟨p, hp, h.symm⟩
      · exact Or.inl (Or.inl (R.thin_home h))
    · exact Or.inl (Or.inl (R.thin_home (R.thin_last π _ (show ovCalls R.G q.1 = ovCalls R.G q.1 from rfl))))
    · exact Or.inl (Or.inl (R.thin_home (R.thin_last π _ trivial)))
  refine (Finset.card_le_card hsub).trans ?_
  refine (Finset.card_union_le _ _).trans ?_
  exact Nat.add_le_add ((Finset.card_union_le _ _).trans (Nat.add_le_add (R.card_thinSet) Finset.card_image_le))
    Finset.card_image_le

end P3SegT

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainJointSeg ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

section Joint

variable {N n wc : ℕ}

/-- Segment `s`'s labeller queries. -/
noncomputable def labTr (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (ω : P3COmega n wc) (s : Fin N) : List (p3ChainModel n wc).Qry :=
  (Tr.trace ((p3ChainModel n wc).answer ω) (labProg (tags s) G (W s))).map Prod.snd

/-- **The segments' labellers ask their queries one segment after another.** -/
theorem segsProg_trace (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (f : (p3ChainModel n wc).Qry → (p3ChainModel n wc).Ans) :
    ∀ ss : List (Fin N), (Tr.trace f (segsProg tags G W ss)).map Prod.snd =
      ss.flatMap (fun s => (Tr.trace f (labProg (tags s) G (W s))).map Prod.snd)
  | [] => rfl
  | s :: ss => by
    show (Tr.trace f (pbind (labProg (tags s) G (W s)) fun _ => segsProg tags G W ss)).map Prod.snd = _
    rw [lab_trace_pbind, segsProg_trace tags G W f ss, List.flatMap_cons]

/-- **Segment `t` of the 14 GB run**: all `N·n` threads in joint order; the tail is all `N` labellers, with the other
segments' queries before and after segment `t`'s. -/
noncomputable def jointSeg (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
    (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q : ℕ) (t : Fin N) : P3SegT n wc (Fin N × Fin n) where
  toP3Replay := segReplay A tags G W D Q t
  ths := jointThreads N n
  hnodup := jointThreads_nodup
  hmem := mem_jointThreads
  tailP := labProgJ tags G W
  pre ω := ((List.finRange N).take t.val).flatMap (labTr tags G W ω)
  post ω := ((List.finRange N).drop (t.val + 1)).flatMap (labTr tags G W ω)
  hsplit ω := by
    show (Tr.trace _ (segsProg tags G W (List.finRange N))).map Prod.snd = _
    rw [segsProg_trace]
    conv_lhs => rw [P3SegT.finRange_split' t]
    rw [List.flatMap_append, List.flatMap_cons]
    simp only [List.append_assoc]
    rfl

variable (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256) (G : TopoDAG n)
  (W : Fin N → Fin n → Lab n wc) (D Q : ℕ)


end Joint

section Good

variable {N n wc : ℕ} (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)) (tags : Fin N → Bits 256)
  (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q : ℕ)

include A D Q in
/-- **A segment's labeller query is a forward query at one of its honest points.** -/
theorem mem_labTr {ω : P3COmega n wc} {s : Fin N} {q : (p3ChainModel n wc).Qry} (hq : q ∈ labTr tags G W ω s) :
    ∃ (L : Fin 2) (u : Fin n), (∃ p, 1 ≤ p ∧ p ≤ ovCalls G u ∧ q = .inl (.inl ((baseReplay tags G W s).xin ω L u p))) ∨
      ∃ a, q = .inr ((tags s, L, u), .inl a) := by
  have e := labProg_trace ω (jointSeg A tags G W D Q s).toP3Replay
  change q ∈ (Tr.trace ((p3ChainModel n wc).answer ω) (labProg (tags s) G (W s))).map Prod.snd at hq
  rw [show labProg (tags s) G (W s) = labProg (jointSeg A tags G W D Q s).tag (jointSeg A tags G W D Q s).G
    (jointSeg A tags G W D Q s).W from rfl, e] at hq
  rcases List.mem_append.1 hq with hm | hm
  · obtain ⟨u, hu⟩ := (jointSeg A tags G W D Q s).mem_all_rows hm
    rcases hu with h | h
    · exact ⟨0, u, Or.inl h⟩
    · exact ⟨0, u, Or.inr ⟨_, h⟩⟩
  · obtain ⟨u, hu⟩ := (jointSeg A tags G W D Q s).mem_all_rows hm
    rcases hu with h | h
    · exact ⟨1, u, Or.inl h⟩
    · exact ⟨1, u, Or.inr ⟨_, h⟩⟩

theorem mem_drop_finRange {k : ℕ} {u : Fin N} (h : u ∈ (List.finRange N).drop k) : k ≤ u.val := by
  obtain ⟨i, hi, hu⟩ := List.mem_iff_getElem.1 h
  rw [List.getElem_drop, List.getElem_finRange] at hu
  rw [← hu]
  simp

/-- **Off `JBad`, with injective tags, every segment is `Good`.** -/
theorem good_of_not_JBad (htags : Function.Injective tags) (t : Fin N) (π : Oracle (P3Alpha n wc))
    (h : ¬ JBad tags G W ((omegaEquiv n wc).symm π)) : (jointSeg A tags G W D Q t).Good π := by
  refine ⟨fun L L' v v' p p' h1 h2 h3 h4 hne => ?_, ?_⟩
  · exact xin_ne_of_not_JBad h (s := t) (s' := t) h1 h2 h3 h4
      (fun e => hne (by simp only [Prod.mk.injEq] at e ⊢; exact e.2))
  · intro q hq x hx
    -- another segment's labeller query
    obtain ⟨s, hst, hqs⟩ : ∃ s : Fin N, s ≠ t ∧ q ∈ labTr tags G W ((omegaEquiv n wc).symm π) s := by
      rcases List.mem_append.1 hq with hm | hm
      · obtain ⟨s, hs, hq'⟩ := List.mem_flatMap.1 hm
        exact ⟨s, fun e => by subst e; exact absurd (P3SegT.mem_take_finRange.1 hs) (lt_irrefl _), hq'⟩
      · obtain ⟨s, hs, hq'⟩ := List.mem_flatMap.1 hm
        exact ⟨s, fun e => by subst e; exact absurd (mem_drop_finRange hs) (by omega), hq'⟩
    obtain ⟨L', u, hform⟩ := mem_labTr A tags G W D Q hqs
    constructor
    · intro e
      rcases hform with ⟨p', hp1, hp2, rfl⟩ | ⟨a, rfl⟩
      · rcases x with ⟨L, v, p⟩ | w | u'
        · simp only [enc, HPt.comp, HPt.val] at e
          have e2 := eq_of_heq (Sigma.mk.inj_iff.1 e).2
          exact xin_ne_of_not_JBad h (s := s) (s' := t) hp1 hp2 hx.1 hx.2
            (fun e' => hst (by simp only [Prod.mk.injEq] at e'; exact e'.1)) (Sum.inl.inj e2)
        · have e1 := congrArg Sigma.fst e; simp [enc, HPt.comp] at e1
        · have e1 := congrArg Sigma.fst e; simp [enc, HPt.comp] at e1
      · rcases x with ⟨L, v, p⟩ | w | u'
        · have e1 := congrArg Sigma.fst e; simp [enc, HPt.comp] at e1
        · have e1 := congrArg Sigma.fst e; simp [enc, HPt.comp] at e1
          exact hst (htags e1.1)
        · have e1 := congrArg Sigma.fst e; simp [enc, HPt.comp] at e1
          exact hst (htags e1.1)
    · intro e
      have hl := congrArg (fun z : Qry (P3Alpha n wc) => z.2.isLeft) e
      rcases hform with ⟨p', _, _, rfl⟩ | ⟨a, rfl⟩ <;> simp [enc] at hl

end Good

section Count

variable {n wc : ℕ} {ι : Type} [DecidableEq ι]

/-- **The price in bits**: a valid holding's `wc·size` is its cells' total width. -/
theorem price_bits (R : P3SegT n wc ι) {K : P3ChainKnow n} (hV : R.ValidK K) (hwc : 0 < wc) :
    (wc : ℚ) * K.size 512 wc = ((wc * (n * K.tops.card + K.cols.card + n * K.hs.card + n * K.rs.card + K.kc.card +
      K.pc.card) + 512 * K.hs.card : ℕ) : ℚ) := by
  have hf : K.hs.filter (fun p => p.2.2 ≠ 0) = K.hs :=
    Finset.filter_true_of_mem fun p hp => by have := (hV.1 p hp).1; omega
  unfold P3ChainKnow.size
  rw [hf]
  have : (wc : ℚ) ≠ 0 := by exact_mod_cast hwc.ne'
  push_cast
  field_simp
  ring

/-- **The count as a function of the table.** For a good segment and any cut `c`, the table lists every credit of
the cut holding `K`. `ι` charges them all: the pairs where their chains end number at most `4n + #hs + #rs`, and
their pinned widths total at least `K`'s price in bits. -/
theorem seg_count (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc)) (hA : ∀ v, (R.A v).Bounded R.D R.Q)
    (hnb : R.Good π) {c : ℕ} (hc : c ≤ (P3SegT.sched R π).length) :
    ((R.cellsOf (R.Kfull π c)).image (fun z => (R.endOf π c z).home)).card ≤
        4 * n + (R.Kfull π c).hs.card + (R.Kfull π c).rs.card ∧
      wc * (n * (R.Kfull π c).tops.card + (R.Kfull π c).cols.card + n * (R.Kfull π c).hs.card +
          n * (R.Kfull π c).rs.card + (R.Kfull π c).kc.card + (R.Kfull π c).pc.card) + 512 * (R.Kfull π c).hs.card ≤
        ∑ x ∈ (R.cellsOf (R.Kfull π c)).image (fun z => (R.endOf π c z).home), R.PW π c x := by
  have hV := R.validK_onlineHC ((omegaEquiv n wc).symm π) c (R.D + 1)
  exact ⟨R.card_ends π, (R.sum_bits_cellsOf hV).symm.le.trans
    (R.charge_count π hA hnb hc (P3ChainKnow.Le.rfl' _) hV)⟩

/-- **The count at the full cut, in the table's terms.** With `whole = #tops + #hs + #rs` whole credits of the full
cut holding `K` (which is `onlineH`): at most `4n + 3·whole` charged pairs, of total pinned width at least
`wc·n·whole` and at least `wc·size(onlineH)`. -/
theorem seg_count_full (R : P3SegT n wc ι) (π : Oracle (P3Alpha n wc)) (hA : ∀ v, (R.A v).Bounded R.D R.Q)
    (hnb : R.Good π) (hwc : 0 < wc) :
    ((R.cellsOf (R.Kfull π (P3SegT.sched R π).length)).image
        (fun z => (R.endOf π (P3SegT.sched R π).length z).home)).card ≤
      4 * n + 3 * ((R.Kfull π (P3SegT.sched R π).length).tops.card + (R.Kfull π (P3SegT.sched R π).length).hs.card +
        (R.Kfull π (P3SegT.sched R π).length).rs.card) ∧
    wc * n * ((R.Kfull π (P3SegT.sched R π).length).tops.card + (R.Kfull π (P3SegT.sched R π).length).hs.card +
        (R.Kfull π (P3SegT.sched R π).length).rs.card) ≤
      ∑ x ∈ (R.cellsOf (R.Kfull π (P3SegT.sched R π).length)).image
        (fun z => (R.endOf π (P3SegT.sched R π).length z).home), R.PW π (P3SegT.sched R π).length x ∧
    (wc : ℚ) * (R.toP3Replay.onlineH ((omegaEquiv n wc).symm π) (R.D + 1)).size 512 wc ≤
      ((∑ x ∈ (R.cellsOf (R.Kfull π (P3SegT.sched R π).length)).image
        (fun z => (R.endOf π (P3SegT.sched R π).length z).home), R.PW π (P3SegT.sched R π).length x : ℕ) : ℚ) := by
  obtain ⟨h1, h2⟩ := seg_count R π hA hnb (c := (P3SegT.sched R π).length) le_rfl
  have hV := R.validK_onlineHC ((omegaEquiv n wc).symm π) (P3SegT.sched R π).length (R.D + 1)
  refine ⟨by omega, le_trans (by nlinarith) h2, ?_⟩
  have hfull : R.Kfull π (P3SegT.sched R π).length = R.toP3Replay.onlineH ((omegaEquiv n wc).symm π) (R.D + 1) := by
    refine R.onlineHC_full ((omegaEquiv n wc).symm π) hA ?_ (R.D + 1)
    rw [R.cutFull_eq ((omegaEquiv n wc).symm π) hA, ← P3SegT.sched_eq]
  rw [← hfull, price_bits R hV hwc]
  exact_mod_cast h2

end Count

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainRoundDet ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι)

theorem rstart_eq (π : Oracle (P3Alpha n wc)) (ρ : ℕ) :
    R.rstart π ρ = ((List.range ρ).flatMap (R.rqAll ((omegaEquiv n wc).symm π))).length := by
  unfold rstart
  split_ifs with h
  · subst h; rfl
  · unfold P3Seg.roundEnd
    rw [Nat.sub_add_cancel (by omega)]

theorem rstart_le_off (π : Oracle (P3Alpha n wc)) (ρ : ℕ) (v : ι) :
    R.rstart π ρ ≤ R.off ((omegaEquiv n wc).symm π) ρ v := by
  rw [rstart_eq]; unfold P3Seg.off; omega

theorem rstart_mono (π : Oracle (P3Alpha n wc)) {ρ ρ' : ℕ} (h : ρ ≤ ρ') : R.rstart π ρ ≤ R.rstart π ρ' := by
  rw [rstart_eq, rstart_eq]
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [List.range_add, List.flatMap_append, List.length_append]
  omega

theorem roundEnd_eq_rstart (π : Oracle (P3Alpha n wc)) (ρ : ℕ) :
    R.roundEnd ((omegaEquiv n wc).symm π) ρ = R.rstart π (ρ + 1) := by
  rw [rstart_eq]; rfl

/-- **Positions have one round.** -/
theorem round_unique (ω : P3COmega n wc) {τ τ' i i' : ℕ} {v v' : ι} (hi : i < (R.rq ω τ v).length)
    (hi' : i' < (R.rq ω τ' v').length) (h : R.off ω τ v + i = R.off ω τ' v' + i') : τ = τ' := by
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hlt
  · have h1 := R.off_add_lt ω τ v hi
    have h2 : R.roundEnd ω τ ≤ R.off ω τ' v' := by
      have := R.rstart_le_off ((omegaEquiv n wc) ω) τ' v'
      rw [Equiv.symm_apply_apply] at this
      exact ((R.roundEnd_eq_rstart _ τ).trans_le (R.rstart_mono _ (show τ + 1 ≤ τ' by omega))).trans
        (by simpa using this)
    omega
  · have h1 := R.off_add_lt ω τ' v' hi'
    have h2 : R.roundEnd ω τ' ≤ R.off ω τ v := by
      have := R.rstart_le_off ((omegaEquiv n wc) ω) τ v
      rw [Equiv.symm_apply_apply] at this
      exact ((R.roundEnd_eq_rstart _ τ').trans_le (R.rstart_mono _ (show τ' + 1 ≤ τ by omega))).trans
        (by simpa using this)
    omega

variable {π π' : Oracle (P3Alpha n wc)} {c j : ℕ}

/-- The untruncated histories agree up to `min j c`. -/
theorem strat_hist_det (hc : c ≤ (sched R π).length) (hc' : c ≤ (sched R π').length)
    (hh : (stratC R c).hist π' j = (stratC R c).hist π j) :
    R.strat.hist π' (min j c) = R.strat.hist π (min j c) := by
  have h1 := (stratC R c).hist_eq_of_le hh (min_le_left j c)
  rw [stratC_hist_le R π hc _ (min_le_right j c), stratC_hist_le R π' hc' _ (min_le_right j c)] at h1
  exact h1

/-- **A round that starts by `min j c` is asked alike.** -/
theorem rq_det (hc : c ≤ (sched R π).length) (hc' : c ≤ (sched R π').length)
    (hh : (stratC R c).hist π' j = (stratC R c).hist π j) {ρ : ℕ} (hρ : R.rstart π ρ ≤ min j c) (hρD : ρ ≤ R.D)
    (v : ι) : R.rq ((omegaEquiv n wc).symm π') ρ v = R.rq ((omegaEquiv n wc).symm π) ρ v := by
  have hd := ofRounds_roundQs_det (ths := R.ths) R.hnodup (P := fun i => toRProg (R.A i)) (enc := enc n wc)
    (dec := dec n wc) (tail := tailOf R.tailP) (π := π) (π' := π') (j := min j c) hρD ?_ ?_
    (R.strat_hist_det hc hc' hh) (R.hmem v)
  · unfold P3Seg.rq
    rw [← trueAns_symm, ← trueAns_symm]
    exact hd
  · have := R.rstart_eq π ρ
    unfold P3Seg.rqAll P3Seg.rq at this
    rw [← trueAns_symm] at this
    exact this ▸ hρ
  · exact (min_le_right j c).trans hc

/-- **Offsets and round ends of rounds that start by `min j c` agree.** -/
theorem off_det (hc : c ≤ (sched R π).length) (hc' : c ≤ (sched R π').length)
    (hh : (stratC R c).hist π' j = (stratC R c).hist π j) {τ : ℕ} (hτ : R.rstart π τ ≤ min j c) (hτD : τ ≤ R.D)
    (v : ι) : R.off ((omegaEquiv n wc).symm π') τ v = R.off ((omegaEquiv n wc).symm π) τ v ∧
      ∀ ρ ≤ τ, R.rqAll ((omegaEquiv n wc).symm π') ρ = R.rqAll ((omegaEquiv n wc).symm π) ρ := by
  have hall : ∀ ρ ≤ τ, ∀ v, R.rq ((omegaEquiv n wc).symm π') ρ v = R.rq ((omegaEquiv n wc).symm π) ρ v :=
    fun ρ hρ v => R.rq_det hc hc' hh ((R.rstart_mono π hρ).trans hτ) (by omega) v
  have hA : ∀ ρ ≤ τ, R.rqAll ((omegaEquiv n wc).symm π') ρ = R.rqAll ((omegaEquiv n wc).symm π) ρ := by
    intro ρ hρ
    unfold P3Seg.rqAll
    exact List.flatMap_congr fun v _ => hall ρ hρ v
  refine ⟨?_, hA⟩
  unfold P3Seg.off
  have h1 : (List.range τ).flatMap (R.rqAll ((omegaEquiv n wc).symm π')) =
      (List.range τ).flatMap (R.rqAll ((omegaEquiv n wc).symm π)) :=
    List.flatMap_congr fun ρ hρ => hA ρ (by simp at hρ; omega)
  have h2 : (R.ths.take (R.ths.idxOf v)).flatMap (R.rq ((omegaEquiv n wc).symm π') τ) =
      (R.ths.take (R.ths.idxOf v)).flatMap (R.rq ((omegaEquiv n wc).symm π) τ) :=
    List.flatMap_congr fun v' _ => hall τ le_rfl v'
  rw [h1, h2]

/-- **The schedule's query at a position of a round that starts by `min j c` agrees.** -/
theorem sched_det (hc : c ≤ (sched R π).length) (hc' : c ≤ (sched R π').length)
    (hh : (stratC R c).hist π' j = (stratC R c).hist π j) {τ i : ℕ} {v : ι}
    (hi : i < (R.rq ((omegaEquiv n wc).symm π) τ v).length) (hτ : R.rstart π τ ≤ min j c) (hτD : τ < R.D) :
    (sched R π')[R.off ((omegaEquiv n wc).symm π) τ v + i]? = (sched R π)[R.off ((omegaEquiv n wc).symm π) τ v + i]? := by
  obtain ⟨ho, _⟩ := R.off_det hc hc' hh hτ hτD.le v
  have hq := R.rq_det hc hc' hh hτ hτD.le v
  have e1 := R.roundsSeq_off ((omegaEquiv n wc).symm π) hτD v hi
  have e2 := R.roundsSeq_off ((omegaEquiv n wc).symm π') hτD v (by rw [hq]; exact hi)
  rw [← P3SegT.sched_eq] at e1 e2
  rw [ho] at e2
  rw [e1, e2]
  simp [hq]

/-- **The round of a program step is fixed.** -/
theorem rnd_det (hc : c ≤ (sched R π).length) (hc' : c ≤ (sched R π').length)
    (hh : (stratC R c).hist π' j = (stratC R c).hist π j) (hjc : j < c) : R.rnd π' j = R.rnd π j := by
  obtain ⟨hD, v, i, hi, he⟩ := R.rnd_spec π (by omega : j < (sched R π).length)
  have hst : R.rstart π (R.rnd π j) ≤ min j c := by
    rw [min_eq_left hjc.le]
    have := R.rstart_le_off π (R.rnd π j) v
    omega
  obtain ⟨ho, _⟩ := R.off_det hc hc' hh hst hD.le v
  have hq := R.rq_det hc hc' hh hst hD.le v
  obtain ⟨_, v', i', hi', he'⟩ := R.rnd_spec π' (by omega : j < (sched R π').length)
  exact R.round_unique ((omegaEquiv n wc).symm π') hi' (by rw [hq]; exact hi) (he'.symm.trans (by rw [ho]; exact he))

/-- **A program whose rounds all start by `min j c` returns the same output at the same depth.** -/
theorem run_det (hc : c ≤ (sched R π).length) (hc' : c ≤ (sched R π').length)
    (hh : (stratC R c).hist π' j = (stratC R c).hist π j) (v : ι) {ρ : ℕ}
    (hd : (R.A v).depth ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π)) ≤ ρ) (hρ : R.rstart π ρ ≤ min j c)
    (hρD : ρ ≤ R.D) :
    (R.A v).run ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π')) =
        (R.A v).run ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π)) ∧
      (R.A v).depth ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π')) =
        (R.A v).depth ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π)) := by
  refine Tr.run_stable _ _ (R.A v) ρ (fun e he hlt => ?_) hd
  -- the query is on the schedule, before `min j c`
  have hmem : e.2 ∈ R.rq ((omegaEquiv n wc).symm π) e.1 v := (R.mem_rq_iff _).2 ⟨e, he, rfl, rfl⟩
  obtain ⟨i, hi, hiq⟩ := List.getElem_of_mem hmem
  have hD : e.1 < R.D := by omega
  have hpos := R.roundsSeq_off ((omegaEquiv n wc).symm π) hD v hi
  rw [← P3SegT.sched_eq] at hpos
  have hlt' : R.off ((omegaEquiv n wc).symm π) e.1 v + i < min j c := by
    have h1 := R.off_add_lt ((omegaEquiv n wc).symm π) e.1 v hi
    have h2 := (R.roundEnd_eq_rstart π e.1).trans_le (R.rstart_mono π (show e.1 + 1 ≤ ρ by omega))
    omega
  have hin := R.sched_mem_hist π hc (min_le_right j c) hlt' (hiq ▸ hpos)
  have hin' : qEntry π (enc n wc) e.2 ∈ (stratC R c).hist π' j := by
    rw [hh]; exact (stratC R c).hist_prefix π (min_le_left j c) |>.subset hin
  have h1 : ans π (enc n wc e.2) = ans π' (enc n wc e.2) := (stratC R c).mem_hist hin'
  rw [← trueAns_symm, ← trueAns_symm]
  show dec n wc ⟨enc n wc e.2, ans π (enc n wc e.2)⟩ = dec n wc ⟨enc n wc e.2, ans π' (enc n wc e.2)⟩
  rw [h1]

end P3SegT

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainTable ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

/-- **Value names**: the honest values a table can list (`hs`/`rs` at calls `p + 1`). -/
inductive VName (n : ℕ) where
  | low (w : Fin n)
  | key2 (u : Fin n)
  | pin2 (u : Fin n)
  | top (u : Fin n)
  | hs (L : Fin 2) (v : Fin n) (p : Fin n)
  | rs (L : Fin 2) (v : Fin n) (p : Fin n)
  deriving DecidableEq, Fintype

/-- The whole values: tops, chaining values, dropped parts. -/
def VName.whole {n : ℕ} : VName n → Bool
  | .top _ => true
  | .hs .. => true
  | .rs .. => true
  | _ => false

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι)

/-- A value's items meet a holding. -/
def meets (K : P3ChainKnow n) : VName n → Prop
  | .low w => ∃ u, (w, u) ∈ K.cols
  | .key2 u => ∃ w, (u, w) ∈ K.kc
  | .pin2 u => ∃ w, (u, w) ∈ K.pc
  | .top u => u ∈ K.tops
  | .hs L v p => (L, v, p.val + 1) ∈ K.hs
  | .rs L v p => (L, v, p.val + 1) ∈ K.rs

omit [DecidableEq ι] in
theorem meets_mono {K K' : P3ChainKnow n} (h : P3ChainKnow.Le K K') {V : VName n} (hV : meets K V) :
    meets K' V := by
  cases V with
  | low w => obtain ⟨u, hu⟩ := hV; exact ⟨u, h.2.1 hu⟩
  | key2 u => obtain ⟨w, hw⟩ := hV; exact ⟨w, h.2.2.2.2.1 hw⟩
  | pin2 u => obtain ⟨w, hw⟩ := hV; exact ⟨w, h.2.2.2.2.2 hw⟩
  | top u => exact h.1 hV
  | hs L v p => exact h.2.2.1 hV
  | rs L v p => exact h.2.2.2.1 hV

open Classical in
/-- **The holding of a set of values**: all their items. -/
noncomputable def holdOf (S : Finset (VName n)) : P3ChainKnow n where
  tops := Finset.univ.filter fun u => VName.top u ∈ S
  cols := Finset.univ.filter fun q => VName.low q.1 ∈ S
  hs := (Finset.univ.filter fun q : Fin 2 × Fin n × Fin n => VName.hs q.1 q.2.1 q.2.2 ∈ S).image
    fun q => (q.1, q.2.1, q.2.2.val + 1)
  rs := (Finset.univ.filter fun q : Fin 2 × Fin n × Fin n => VName.rs q.1 q.2.1 q.2.2 ∈ S).image
    fun q => (q.1, q.2.1, q.2.2.val + 1)
  kc := Finset.univ.filter fun q => VName.key2 q.1 ∈ S
  pc := Finset.univ.filter fun q => VName.pin2 q.1 ∈ S

omit [DecidableEq ι] in

/-- **A value's items are in the holding of any set containing it.** -/
theorem meets_holdOf {K : P3ChainKnow n} {S : Finset (VName n)} (hV : R.ValidK K)
    (hS : ∀ V, meets K V → V ∈ S) : P3ChainKnow.Le K (holdOf S) := by
  classical
  refine ⟨fun u hu => ?_, fun q hq => ?_, fun p hp => ?_, fun p hp => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · exact Finset.mem_filter.2 ⟨Finset.mem_univ _, hS (.top u) hu⟩
  · exact Finset.mem_filter.2 ⟨Finset.mem_univ _, hS (.low q.1) ⟨q.2, hq⟩⟩
  · obtain ⟨L, v, q⟩ := p
    have h1 : 1 ≤ q ∧ q ≤ ovCalls R.G v := hV.1 _ hp
    have hq : q - 1 < n := by have := ovCalls_le R.G v; omega
    refine Finset.mem_image.2 ⟨(L, v, ⟨q - 1, hq⟩), Finset.mem_filter.2 ⟨Finset.mem_univ _, hS (.hs L v ⟨q - 1, hq⟩) ?_⟩,
      ?_⟩
    · show (L, v, (q - 1) + 1) ∈ K.hs; rw [Nat.sub_add_cancel h1.1]; exact hp
    · simp only [Prod.mk.injEq, true_and]; omega
  · obtain ⟨L, v, q⟩ := p
    have h1 : 1 ≤ q ∧ q ≤ ovCalls R.G v := ⟨(hV.2 _ hp).1, (hV.2 _ hp).2.1⟩
    have hq : q - 1 < n := by have := ovCalls_le R.G v; omega
    refine Finset.mem_image.2 ⟨(L, v, ⟨q - 1, hq⟩), Finset.mem_filter.2 ⟨Finset.mem_univ _, hS (.rs L v ⟨q - 1, hq⟩) ?_⟩,
      ?_⟩
    · show (L, v, (q - 1) + 1) ∈ K.rs; rw [Nat.sub_add_cancel h1.1]; exact hp
    · simp only [Prod.mk.injEq, true_and]; omega
  · exact Finset.mem_filter.2 ⟨Finset.mem_univ _, hS (.key2 q.1) ⟨q.2, hq⟩⟩
  · exact Finset.mem_filter.2 ⟨Finset.mem_univ _, hS (.pin2 q.1) ⟨q.2, hq⟩⟩


/-- A query shows value `V`'s honest value. -/
def shownBy (ω : P3COmega n wc) : VName n → (p3ChainModel n wc).Qry → Prop
  | .low w, q => showLab q = some (R.c1 ω w)
  | .top u, q => showLab q = some (R.c2 ω u)
  | .key2 u, q => showR q = some (R.rval ω 1 u (ovCalls R.G u))
  | .pin2 u, q => showPin q = some ((R.tag, 1, u), R.pin2 ω u)
  | .hs L v p, q => showH q = some (R.hval ω L v (p.val + 1))
  | .rs L v p, q => showR q = some (R.rval ω L v (p.val + 1)) ∨
      (L = 0 ∧ p.val + 1 = ovCalls R.G v ∧ showPin q = some ((R.tag, 0, v), R.pin1 ω v))

/-- A program's output shows value `V`'s honest value (labels only). -/
def outBy (ω : P3COmega n wc) : VName n → Lab n wc → Prop
  | .low w, x => x = R.c1 ω w
  | .top u, x => x = R.c2 ω u
  | _, _ => False

/-- **Value `V` is shown at code `κ`**: by the schedule's query at `κ < c`, or by thread `ths[κ − c]`'s output. -/
def CShow (π : Oracle (P3Alpha n wc)) (c : ℕ) (V : VName n) (κ : ℕ) : Prop :=
  (κ < c ∧ ∃ q, (sched R π)[κ]? = some q ∧ R.shownBy ((omegaEquiv n wc).symm π) V q) ∨
    (c ≤ κ ∧ ∃ h : κ - c < R.ths.length,
      R.outBy ((omegaEquiv n wc).symm π) V ((R.A (R.ths[κ - c])).run ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π))))

/-- The round of a code: its query's round, or the output's depth. -/
noncomputable def codeRound (π : Oracle (P3Alpha n wc)) (c κ : ℕ) : ℕ :=
  if κ < c then R.rnd π κ
  else if h : κ - c < R.ths.length then
    (R.A (R.ths[κ - c])).depth ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π))
  else 0

/-- **A code is available at step `j`**: `j` is past the cut, or the code's round is at most `j`'s. -/
def Avail (π : Oracle (P3Alpha n wc)) (c j κ : ℕ) : Prop := c ≤ j ∨ R.codeRound π c κ ≤ R.rnd π j


variable (π : Oracle (P3Alpha n wc))

theorem query_code (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c τ i : ℕ} {v : ι} (hc : c ≤ (sched R π).length)
    (hi : i < (R.rq ((omegaEquiv n wc).symm π) τ v).length) (hlt : R.off ((omegaEquiv n wc).symm π) τ v + i < c) :
    (sched R π)[R.off ((omegaEquiv n wc).symm π) τ v + i]? = some (R.rq ((omegaEquiv n wc).symm π) τ v)[i] ∧
      R.codeRound π c (R.off ((omegaEquiv n wc).symm π) τ v + i) = τ := by
  have hD := R.rq_lt_D π hA hi
  refine ⟨?_, ?_⟩
  · have := R.roundsSeq_off ((omegaEquiv n wc).symm π) hD v hi
    rw [← P3SegT.sched_eq] at this
    exact this
  · unfold codeRound
    rw [if_pos hlt]
    obtain ⟨_, v', i', hi', he⟩ := R.rnd_spec π (j := R.off ((omegaEquiv n wc).symm π) τ v + i) (by omega)
    exact (R.round_unique _ hi hi' he).symm

theorem output_code (c : ℕ) (v : ι) :
    ∃ h : c + R.ths.idxOf v - c < R.ths.length, R.ths[c + R.ths.idxOf v - c] = v ∧
      R.codeRound π c (c + R.ths.idxOf v) =
        (R.A v).depth ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π)) := by
  have hlt : R.ths.idxOf v < R.ths.length := List.idxOf_lt_length_iff.2 (R.hmem v)
  have e : c + R.ths.idxOf v - c = R.ths.idxOf v := by omega
  have hv : R.ths[c + R.ths.idxOf v - c]'(by omega) = v := by
    simp only [e]; exact List.getElem_idxOf hlt
  refine ⟨by omega, hv, ?_⟩
  unfold codeRound
  rw [if_neg (by omega), dif_pos (by omega), hv]


omit [DecidableEq ι] in
theorem meets_union {A B : P3ChainKnow n} {V : VName n} (h : meets (A.union B) V) : meets A V ∨ meets B V := by
  cases V with
  | low w => obtain ⟨u, hu⟩ := h; rcases Finset.mem_union.1 hu with h | h; exact Or.inl ⟨u, h⟩; exact Or.inr ⟨u, h⟩
  | key2 u => obtain ⟨w, hw⟩ := h; rcases Finset.mem_union.1 hw with h | h; exact Or.inl ⟨w, h⟩; exact Or.inr ⟨w, h⟩
  | pin2 u => obtain ⟨w, hw⟩ := h; rcases Finset.mem_union.1 hw with h | h; exact Or.inl ⟨w, h⟩; exact Or.inr ⟨w, h⟩
  | top u => exact Finset.mem_union.1 h
  | hs L v p => exact Finset.mem_union.1 h
  | rs L v p => exact Finset.mem_union.1 h

omit [DecidableEq ι] in
theorem meets_fresh {S K : P3ChainKnow n} {V : VName n} (h : meets (P3ChainKnow.fresh S K) V) : meets S V := by
  have hf := P3ChainKnow.fresh_sub S K
  cases V with
  | low w => obtain ⟨u, hu⟩ := h; exact ⟨u, (hf.2.1 _ hu).1⟩
  | key2 u => obtain ⟨w, hw⟩ := h; exact ⟨w, (hf.2.2.2.2.1 _ hw).1⟩
  | pin2 u => obtain ⟨w, hw⟩ := h; exact ⟨w, (hf.2.2.2.2.2 _ hw).1⟩
  | top u => exact (hf.1 _ h).1
  | hs L v p => exact (hf.2.2.1 _ h).1
  | rs L v p => exact (hf.2.2.2.1 _ h).1

open Classical in
/-- **A value's first credit round.** -/
noncomputable def firstRound (c : ℕ) (V : VName n) : ℕ :=
  if h : ∃ τ, meets (R.onlineHC ((omegaEquiv n wc).symm π) c (τ + 1)) V then Nat.find h else 0

theorem firstRound_le {c τ : ℕ} {V : VName n} (h : meets (R.onlineHC ((omegaEquiv n wc).symm π) c (τ + 1)) V) :
    R.firstRound π c V ≤ τ := by
  classical
  unfold firstRound
  rw [dif_pos ⟨τ, h⟩]
  exact Nat.find_min' _ h

/-- **At its first credit round, a value is shown before the cut.** -/
theorem firstRound_shown {c : ℕ} {V : VName n} (h : meets (R.onlineHC ((omegaEquiv n wc).symm π) c (R.D + 1)) V) :
    meets (R.shownAtC ((omegaEquiv n wc).symm π) c (R.firstRound π c V)) V := by
  classical
  have hex : ∃ τ, meets (R.onlineHC ((omegaEquiv n wc).symm π) c (τ + 1)) V := ⟨R.D, h⟩
  have h1 : meets (R.onlineHC ((omegaEquiv n wc).symm π) c (R.firstRound π c V + 1)) V := by
    unfold firstRound; rw [dif_pos hex]; exact Nat.find_spec hex
  have h0 : ¬ meets (R.onlineHC ((omegaEquiv n wc).symm π) c (R.firstRound π c V)) V := by
    intro hm
    rcases Nat.eq_zero_or_pos (R.firstRound π c V) with hz | hz
    · rw [hz] at hm
      cases V <;> simp [meets, onlineHC, P3ChainKnow.empty] at hm
    · have := R.firstRound_le π (τ := R.firstRound π c V - 1) (by rw [Nat.sub_add_cancel hz]; exact hm)
      omega
  change meets ((R.onlineHC ((omegaEquiv n wc).symm π) c _).union _) V at h1
  rcases meets_union h1 with h' | h'
  · exact absurd h' h0
  · exact meets_fresh h'

/-- **Every credited value has a code of its first credit round.** -/
theorem code_exists (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c : ℕ} (hc : c ≤ (sched R π).length) {V : VName n}
    (hV : meets (R.onlineHC ((omegaEquiv n wc).symm π) c (R.D + 1)) V) :
    ∃ κ, κ < c + R.ths.length ∧ R.CShow π c V κ ∧ R.codeRound π c κ = R.firstRound π c V := by
  classical
  have hS := R.firstRound_shown π hV
  set τ := R.firstRound π c V
  -- a query show
  have hq : ∀ {v : ι} {i : ℕ} (hi : i < (R.rq ((omegaEquiv n wc).symm π) τ v).length),
      R.off ((omegaEquiv n wc).symm π) τ v + i < c →
      R.shownBy ((omegaEquiv n wc).symm π) V (R.rq ((omegaEquiv n wc).symm π) τ v)[i] →
      ∃ κ, κ < c + R.ths.length ∧ R.CShow π c V κ ∧ R.codeRound π c κ = τ := by
    intro v i hi hlt hsh
    obtain ⟨e1, e2⟩ := R.query_code π hA hc hi hlt
    exact ⟨_, by omega, Or.inl ⟨hlt, _, e1, hsh⟩, e2⟩
  -- an output show
  have ho : ∀ (v : ι), R.outBy ((omegaEquiv n wc).symm π) V
        ((R.A v).run ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π))) →
      (R.A v).depth ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π)) = τ →
      ∃ κ, κ < c + R.ths.length ∧ R.CShow π c V κ ∧ R.codeRound π c κ = τ := by
    intro v hout hd
    obtain ⟨hlt, hv, hr⟩ := R.output_code π c v
    refine ⟨c + R.ths.idxOf v, by omega, Or.inr ⟨by omega, hlt, ?_⟩, hr.trans hd⟩
    rw [hv]; exact hout
  cases V with
  | low w =>
    obtain ⟨u, hu⟩ := hS
    obtain ⟨v, ⟨i, hi, hlt, hsh⟩ | ⟨hr, hd, _⟩⟩ := (Finset.mem_filter.1 hu).2
    · exact hq hi hlt hsh
    · exact ho v hr hd
  | top u =>
    obtain ⟨v, ⟨i, hi, hlt, hsh⟩ | ⟨hr, hd, _⟩⟩ := (Finset.mem_filter.1 hS).2
    · exact hq hi hlt hsh
    · exact ho v hr hd
  | key2 u =>
    obtain ⟨w, hw⟩ := hS
    obtain ⟨v, i, hi, hlt, hsh⟩ := (Finset.mem_filter.1 hw).2
    exact hq hi hlt hsh
  | pin2 u =>
    obtain ⟨w, hw⟩ := hS
    obtain ⟨v, i, hi, hlt, hsh⟩ := (Finset.mem_filter.1 hw).2
    exact hq hi hlt hsh
  | hs L v' p =>
    obtain ⟨_, _, _, v, i, hi, hlt, hsh⟩ := Finset.mem_filter.1 hS
    exact hq hi hlt hsh
  | rs L v' p =>
    obtain ⟨_, _, _, h3⟩ := Finset.mem_filter.1 hS
    rcases h3 with ⟨⟨v, i, hi, hlt, hsh⟩, _⟩ | ⟨hL, hp, v, i, hi, hlt, hsh⟩
    · exact hq hi hlt (Or.inl hsh)
    · exact hq hi hlt (Or.inr ⟨hL, hp, hsh⟩)

open Classical in
/-- **A credited value's code**: a show of it at its first credit round. -/
noncomputable def codeOf (c : ℕ) (V : VName n) : ℕ :=
  Classical.epsilon fun κ => κ < c + R.ths.length ∧ R.CShow π c V κ ∧ R.codeRound π c κ = R.firstRound π c V

theorem codeOf_spec (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c : ℕ} (hc : c ≤ (sched R π).length) {V : VName n}
    (hV : meets (R.onlineHC ((omegaEquiv n wc).symm π) c (R.D + 1)) V) :
    R.codeOf π c V < c + R.ths.length ∧ R.CShow π c V (R.codeOf π c V) ∧
      R.codeRound π c (R.codeOf π c V) = R.firstRound π c V :=
  Classical.epsilon_spec (R.code_exists π hA hc hV)


/-- **Tables**: `3n + k` slots, each an optional value name and a code `≤ M`; `k` counts the whole values. -/
abbrev Sig (n M : ℕ) : Type :=
  Σ k : Fin (Fintype.card (VName n) + 1), (Fin (3 * n + k) → Option (VName n) × Fin (M + 1))

/-- The number of whole values of a table. -/
def Sig.whole {n M : ℕ} (σ : Sig n M) : ℕ := σ.1

/-- The thin value named by slot `i < 3n`. -/
def thinAt (i : ℕ) (hi : i < 3 * n) : VName n :=
  if h : i < n then .low ⟨i, h⟩
  else if h' : i - n < n then .key2 ⟨i - n, h'⟩
  else .pin2 ⟨i - 2 * n, by omega⟩

omit [DecidableEq ι] in
theorem thinAt_spec {V : VName n} (hV : V.whole = false) : ∃ i, ∃ hi : i < 3 * n, thinAt i hi = V := by
  cases V with
  | low w => exact ⟨w, by omega, by simp [thinAt, w.isLt]⟩
  | key2 u => exact ⟨n + u, by omega, by simp [thinAt]⟩
  | pin2 u =>
    refine ⟨2 * n + u, by omega, ?_⟩
    simp only [thinAt]
    rw [dif_neg (by omega), dif_neg (by omega)]
    exact congrArg VName.pin2 (Fin.ext (by simp))
  | top u => simp [VName.whole] at hV
  | hs L v p => simp [VName.whole] at hV
  | rs L v p => simp [VName.whole] at hV

/-- The listed values: those with a credited item. -/
def Listed (c : ℕ) (V : VName n) : Prop := meets (R.onlineHC ((omegaEquiv n wc).symm π) c (R.D + 1)) V

open Classical in
/-- The whole listed values, in some order. -/
noncomputable def wholeList (c : ℕ) : List (VName n) :=
  (Finset.univ.filter fun V : VName n => V.whole = true ∧ R.Listed π c V).toList

theorem wholeList_length_le (c : ℕ) : (R.wholeList π c).length < Fintype.card (VName n) + 1 := by
  classical
  unfold wholeList
  rw [Finset.length_toList]
  exact Nat.lt_succ_of_le (Finset.card_le_univ _)

open Classical in
/-- **The realized table**: the thin values by slot, then the whole ones, each with its code (`≤ M`). -/
noncomputable def tableOf (c M : ℕ) : Sig n M :=
  ⟨⟨(R.wholeList π c).length, R.wholeList_length_le π c⟩, fun i =>
    if h0 : i.val < 3 * n then
      (if R.Listed π c (thinAt i.val h0) then
        (some (thinAt i.val h0), ⟨min (R.codeOf π c (thinAt i.val h0)) M, by omega⟩) else (none, 0))
    else if h : i.val - 3 * n < (R.wholeList π c).length then
      (some (R.wholeList π c)[i.val - 3 * n], ⟨min (R.codeOf π c (R.wholeList π c)[i.val - 3 * n]) M, by omega⟩)
    else (none, 0)⟩

/-- **A slot of the realized table names a listed value with its code.** -/
theorem tableOf_slot {c M : ℕ} (hM : c + R.ths.length ≤ M + 1) (hA : ∀ v, (R.A v).Bounded R.D R.Q)
    (hc : c ≤ (sched R π).length) {i : Fin (3 * n + (R.tableOf π c M).1)} {V : VName n}
    (h : ((R.tableOf π c M).2 i).1 = some V) :
    R.Listed π c V ∧ (((R.tableOf π c M).2 i).2 : ℕ) = R.codeOf π c V := by
  classical
  have hcode : ∀ {V'}, R.Listed π c V' → min (R.codeOf π c V') M = R.codeOf π c V' := fun hl =>
    min_eq_left (by have := (R.codeOf_spec π hA hc hl).1; omega)
  simp only [tableOf] at h ⊢
  by_cases h1 : i.val < 3 * n
  · rw [dif_pos h1] at h ⊢
    by_cases h2 : R.Listed π c (thinAt i.val h1)
    · rw [if_pos h2] at h ⊢
      obtain rfl := Option.some_inj.1 h
      exact ⟨h2, hcode h2⟩
    · rw [if_neg h2] at h; simp at h
  · rw [dif_neg h1] at h ⊢
    by_cases h3 : i.val - 3 * n < (R.wholeList π c).length
    · rw [dif_pos h3] at h ⊢
      obtain rfl := Option.some_inj.1 h
      have hl : R.Listed π c (R.wholeList π c)[i.val - 3 * n] := by
        have := List.getElem_mem h3
        unfold wholeList at this
        exact (Finset.mem_filter.1 (Finset.mem_toList.1 this)).2.2
      exact ⟨hl, hcode hl⟩
    · rw [dif_neg h3] at h; simp at h

/-- **Every listed value has a slot.** -/
theorem tableOf_listed {c M : ℕ} {V : VName n} (hV : R.Listed π c V) :
    ∃ i, ((R.tableOf π c M).2 i).1 = some V := by
  classical
  cases hw : V.whole with
  | false =>
    obtain ⟨i, hi, rfl⟩ := thinAt_spec hw
    refine ⟨⟨i, by omega⟩, ?_⟩
    simp only [tableOf]
    rw [dif_pos hi, if_pos hV]
  | true =>
    have hm : V ∈ R.wholeList π c := by
      unfold wholeList; exact Finset.mem_toList.2 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hw, hV⟩)
    obtain ⟨j, hj, hjV⟩ := List.mem_iff_getElem.1 hm
    refine ⟨⟨3 * n + j, show 3 * n + j < 3 * n + (R.wholeList π c).length by omega⟩, ?_⟩
    simp only [tableOf]
    rw [dif_neg (show ¬ 3 * n + j < 3 * n by omega), dif_pos (show 3 * n + j - 3 * n < (R.wholeList π c).length by omega)]
    simp [hjV]

/-- **The targets' holding at step `j`**: every value a table lists at an available code. -/
noncomputable def KatT {M : ℕ} (σ : Sig n M) (c j : ℕ) : P3ChainKnow n := by
  classical
  exact holdOf (Finset.univ.filter fun V => ∃ i, (σ.2 i).1 = some V ∧ R.Avail π c j ((σ.2 i).2 : ℕ))

/-- **The targets' holding contains the credits readable at `j`.** -/
theorem kat_le_katT (hA : ∀ v, (R.A v).Bounded R.D R.Q) {c M : ℕ} (hc : c ≤ (sched R π).length)
    (hM : c + R.ths.length ≤ M + 1) (j : ℕ) :
    P3ChainKnow.Le (R.Kat π c j) (R.KatT π (R.tableOf π c M) c j) := by
  classical
  unfold KatT
  refine R.meets_holdOf (R.validK_onlineHC _ c _) fun V hV => ?_
  have hl : R.Listed π c V := by
    unfold Kat at hV
    split_ifs at hV with hj
    · have hr := (R.rnd_spec π (show j < (sched R π).length by omega)).1
      exact meets_mono (R.onlineHC_mono _ c (show R.rnd π j + 1 ≤ R.D + 1 by omega)) hV
    · exact hV
  obtain ⟨i, hi⟩ := R.tableOf_listed π (M := M) hl
  refine Finset.mem_filter.2 ⟨Finset.mem_univ _, i, hi, ?_⟩
  rw [(R.tableOf_slot π hM hA hc hi).2]
  unfold Avail
  rcases le_or_gt c j with hj | hj
  · exact Or.inl hj
  · refine Or.inr ?_
    rw [(R.codeOf_spec π hA hc hl).2.2]
    unfold Kat at hV
    rw [if_pos hj] at hV
    exact R.firstRound_le π hV


/-- Two oracles give a value the same honest value. -/
def VAgree (ω ω' : P3COmega n wc) : VName n → Prop
  | .low w => R.c1 ω w = R.c1 ω' w
  | .top u => R.c2 ω u = R.c2 ω' u
  | .key2 u => R.rval ω 1 u (ovCalls R.G u) = R.rval ω' 1 u (ovCalls R.G u)
  | .pin2 u => R.pin2 ω u = R.pin2 ω' u
  | .hs L v p => R.hval ω L v (p.val + 1) = R.hval ω' L v (p.val + 1)
  | .rs L v p => R.rval ω L v (p.val + 1) = R.rval ω' L v (p.val + 1)

omit [DecidableEq ι] in
theorem shown_agree {ω ω' : P3COmega n wc} {V : VName n} {q : (p3ChainModel n wc).Qry}
    (h : R.shownBy ω V q) (h' : R.shownBy ω' V q) : R.VAgree ω ω' V := by
  cases V with
  | low w => exact Option.some_inj.1 (h.symm.trans h')
  | top u => exact Option.some_inj.1 (h.symm.trans h')
  | key2 u => exact Option.some_inj.1 (h.symm.trans h')
  | pin2 u =>
    have := Option.some_inj.1 (h.symm.trans h')
    exact (Prod.mk.inj this).2
  | hs L v p => exact Option.some_inj.1 (h.symm.trans h')
  | rs L v p =>
    rcases h with h | ⟨hL, hp, h⟩ <;> rcases h' with h' | ⟨hL', hp', h'⟩
    · exact Option.some_inj.1 (h.symm.trans h')
    · rcases q with (x | y) | ⟨T, a | b⟩ <;> simp [showR, showPin] at h h'
    · rcases q with (x | y) | ⟨T, a | b⟩ <;> simp [showR, showPin] at h h'
    · have e := (Prod.mk.inj (Option.some_inj.1 (h.symm.trans h'))).2
      have hk := R.key_of_pin1 e
      show R.rval ω L v (p.val + 1) = R.rval ω' L v (p.val + 1)
      subst hL
      rw [hp]
      have h1 : R.rval ω 0 v (ovCalls R.G v) = codeEquiv n wc (R.key ω 0 v) := by simp [P3Replay.key]
      have h2 : R.rval ω' 0 v (ovCalls R.G v) = codeEquiv n wc (R.key ω' 0 v) := by simp [P3Replay.key]
      rw [h1, h2, hk]

omit [DecidableEq ι] in
theorem out_agree {ω ω' : P3COmega n wc} {V : VName n} {x : Lab n wc} (h : R.outBy ω V x)
    (h' : R.outBy ω' V x) : R.VAgree ω ω' V := by
  cases V with
  | low w => exact h.symm.trans h'
  | top u => exact h.symm.trans h'
  | _ => exact absurd h id

/-- **Agreeing on values is agreeing on their holding.** -/
theorem agree_holdOf {ω ω' : P3COmega n wc} {S : Finset (VName n)} (h : ∀ V ∈ S, R.VAgree ω ω' V) :
    R.Agree ω ω' (holdOf S) := by
  classical
  refine ⟨fun u hu => h _ (Finset.mem_filter.1 hu).2, fun q hq => congrFun (h _ (Finset.mem_filter.1 hq).2) q.2,
    fun p hp _ _ => ?_, fun p hp _ _ => ?_, fun q hq => ?_, fun q hq => congrFun (h _ (Finset.mem_filter.1 hq).2) q.2⟩
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.1 hp
    exact h _ (Finset.mem_filter.1 hq).2
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.1 hp
    exact h _ (Finset.mem_filter.1 hq).2
  · have e : R.rval ω 1 q.1 (ovCalls R.G q.1) = R.rval ω' 1 q.1 (ovCalls R.G q.1) := h _ (Finset.mem_filter.1 hq).2
    show R.key ω 1 q.1 q.2 = R.key ω' 1 q.1 q.2
    unfold P3Replay.key
    rw [e]

variable {π' : Oracle (P3Alpha n wc)} {c j : ℕ}

/-- **An available code stays available, with the same round, under an oracle with the same history.** -/
theorem avail_det (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hc : c ≤ (sched R π).length)
    (hc' : c ≤ (sched R π').length) (hh : (stratC R c).hist π' j = (stratC R c).hist π j) {κ : ℕ}
    (hκ : κ < c + R.ths.length) (h : R.Avail π c j κ) :
    R.Avail π' c j κ ∧ (j < c → R.codeRound π' c κ = R.codeRound π c κ) := by
  rcases h with h | h
  · exact ⟨Or.inl h, fun h' => absurd h (by omega)⟩
  rcases le_or_gt c j with hj | hj
  · exact ⟨Or.inl hj, fun h' => absurd hj (by omega)⟩
  have hrj := R.rnd_det hc hc' hh hj
  obtain ⟨hDj, v₀, i₀, hi₀, he₀⟩ := R.rnd_spec π (show j < (sched R π).length by omega)
  have hsj : R.rstart π (R.rnd π j) ≤ min j c := by
    rw [min_eq_left hj.le]; have := R.rstart_le_off π (R.rnd π j) v₀; omega
  have hcr : R.codeRound π' c κ = R.codeRound π c κ := by
    by_cases hκc : κ < c
    · have e1 : R.codeRound π c κ = R.rnd π κ := by unfold codeRound; rw [if_pos hκc]
      have e2 : R.codeRound π' c κ = R.rnd π' κ := by unfold codeRound; rw [if_pos hκc]
      rw [e1] at h
      rw [e1, e2]
      obtain ⟨hDκ, v, i, hi, he⟩ := R.rnd_spec π (show κ < (sched R π).length by omega)
      have hs : R.rstart π (R.rnd π κ) ≤ min j c := (R.rstart_mono π h).trans hsj
      obtain ⟨ho, _⟩ := R.off_det hc hc' hh hs hDκ.le v
      have hq := R.rq_det hc hc' hh hs hDκ.le v
      obtain ⟨_, v', i', hi', he'⟩ := R.rnd_spec π' (show κ < (sched R π').length by omega)
      have hi2 : i < (R.rq ((omegaEquiv n wc).symm π') (R.rnd π κ) v).length := by rw [hq]; exact hi
      have he2 : R.off ((omegaEquiv n wc).symm π') (R.rnd π' κ) v' + i' =
          R.off ((omegaEquiv n wc).symm π') (R.rnd π κ) v + i := by rw [← he', ho]; exact he
      exact R.round_unique _ hi' hi2 he2
    · by_cases hl : κ - c < R.ths.length
      · have e1 : R.codeRound π c κ = (R.A (R.ths[κ - c])).depth
            ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π)) := by
          unfold codeRound; rw [if_neg hκc, dif_pos hl]
        have e2 : R.codeRound π' c κ = (R.A (R.ths[κ - c])).depth
            ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π')) := by
          unfold codeRound; rw [if_neg hκc, dif_pos hl]
        rw [e1] at h
        rw [e1, e2]
        exact (R.run_det hc hc' hh _ h hsj hDj.le).2
      · have e1 : R.codeRound π c κ = 0 := by unfold codeRound; rw [if_neg hκc, dif_neg hl]
        have e2 : R.codeRound π' c κ = 0 := by unfold codeRound; rw [if_neg hκc, dif_neg hl]
        rw [e1, e2]
  exact ⟨Or.inr (by rw [hcr, hrj]; exact h), fun _ => hcr⟩

theorem rstart_D : R.rstart π R.D = (sched R π).length := by
  rw [rstart_eq, P3SegT.sched_eq, LazyPerm.roundsSeq_eq R.hnodup]
  rfl

/-- **A value shown at an available code has the same honest value under an oracle with the same history**, at
the full cut. -/
theorem value_det (hA : ∀ v, (R.A v).Bounded R.D R.Q) (hc : c ≤ (sched R π).length)
    (hc' : c ≤ (sched R π').length) (hcf : (sched R π).length ≤ c)
    (hh : (stratC R c).hist π' j = (stratC R c).hist π j) {V : VName n} {κ : ℕ}
    (h : R.CShow π c V κ) (h' : R.CShow π' c V κ) (hav : R.Avail π c j κ) :
    R.VAgree ((omegaEquiv n wc).symm π) ((omegaEquiv n wc).symm π') V := by
  rcases h with ⟨hκc, q, hq, hsh⟩ | ⟨hκc, hl, hout⟩
  · rcases h' with ⟨_, q', hq', hsh'⟩ | ⟨hκc', _⟩
    · obtain ⟨hD, v, i, hi, he⟩ := R.rnd_spec π (show κ < (sched R π).length by omega)
      have hsr : R.rstart π (R.rnd π κ) ≤ min j c := by
        have h1 : R.rstart π (R.rnd π κ) ≤ κ := by have := R.rstart_le_off π (R.rnd π κ) v; omega
        rcases le_or_gt c j with hj | hj
        · rw [min_eq_right hj]; omega
        · rw [min_eq_left hj.le]
          have hr : R.rnd π κ ≤ R.rnd π j := by
            rcases hav with h | h
            · omega
            · unfold codeRound at h; rwa [if_pos hκc] at h
          obtain ⟨_, v₀, i₀, hi₀, he₀⟩ := R.rnd_spec π (show j < (sched R π).length by omega)
          have := R.rstart_le_off π (R.rnd π j) v₀
          have := R.rstart_mono π hr
          omega
      have := R.sched_det hc hc' hh hi hsr hD
      rw [← he, hq, hq'] at this
      obtain rfl := Option.some_inj.1 this
      exact R.shown_agree hsh hsh'
    · omega
  · rcases h' with ⟨hκc', _⟩ | ⟨_, hl', hout'⟩
    · omega
    · have key : ∃ ρ, (R.A (R.ths[κ - c])).depth ((p3ChainModel n wc).answer ((omegaEquiv n wc).symm π)) ≤ ρ ∧
          R.rstart π ρ ≤ min j c ∧ ρ ≤ R.D := by
        rcases le_or_gt c j with hj | hj
        · refine ⟨R.D, ((hA _) _).1, ?_, le_rfl⟩
          rw [min_eq_right hj, R.rstart_D π]
          exact hcf
        · obtain ⟨hDj, v₀, i₀, hi₀, he₀⟩ := R.rnd_spec π (show j < (sched R π).length by omega)
          refine ⟨R.rnd π j, ?_, ?_, hDj.le⟩
          · rcases hav with h | h
            · omega
            · unfold codeRound at h; rwa [if_neg (by omega), dif_pos hl] at h
          · rw [min_eq_left hj.le]; have := R.rstart_le_off π (R.rnd π j) v₀; omega
      obtain ⟨ρ, hd, hρ, hρD⟩ := key
      have hr := (R.run_det hc hc' hh (R.ths[κ - c]) hd hρ hρD).1
      rw [hr] at hout'
      exact R.out_agree hout hout'

/-- A slot's code is below `c + |ths|`, and the value is shown there. -/
theorem slot_show (hA : ∀ v, (R.A v).Bounded R.D R.Q) {M : ℕ} (hM : c + R.ths.length ≤ M + 1)
    (hc : c ≤ (sched R π).length) {i : Fin (3 * n + (R.tableOf π c M).1)} {V : VName n}
    (h : ((R.tableOf π c M).2 i).1 = some V) :
    (((R.tableOf π c M).2 i).2 : ℕ) < c + R.ths.length ∧ R.CShow π c V (((R.tableOf π c M).2 i).2 : ℕ) := by
  obtain ⟨hl, he⟩ := R.tableOf_slot π hM hA hc h
  have := R.codeOf_spec π hA hc hl
  rw [he]
  exact ⟨this.1, this.2.1⟩

/-- **The history at `j` fixes the targets' holding and its values**, for two oracles that realize the same table at
the full cut. -/
theorem katT_det (hA : ∀ v, (R.A v).Bounded R.D R.Q) {M : ℕ} (hM : c + R.ths.length ≤ M + 1)
    (hc : c ≤ (sched R π).length) (hc' : c ≤ (sched R π').length) (hcf : (sched R π).length ≤ c)
    (hcf' : (sched R π').length ≤ c) (hh : (stratC R c).hist π' j = (stratC R c).hist π j)
    (hσ : R.tableOf π' c M = R.tableOf π c M) :
    R.KatT π' (R.tableOf π c M) c j = R.KatT π (R.tableOf π c M) c j ∧
      R.Agree ((omegaEquiv n wc).symm π) ((omegaEquiv n wc).symm π') (R.KatT π (R.tableOf π c M) c j) := by
  classical
  have hπ : ∀ {i} {V : VName n}, ((R.tableOf π c M).2 i).1 = some V →
      (((R.tableOf π c M).2 i).2 : ℕ) < c + R.ths.length ∧ R.CShow π c V (((R.tableOf π c M).2 i).2 : ℕ) :=
    fun h => R.slot_show π hA hM hc h
  have hπ' : ∀ {i} {V : VName n}, ((R.tableOf π c M).2 i).1 = some V →
      R.CShow π' c V (((R.tableOf π c M).2 i).2 : ℕ) := by
    intro i V h
    have key : ∀ (σ : Sig n M) (e : R.tableOf π' c M = σ) (i : Fin (3 * n + σ.1)), (σ.2 i).1 = some V →
        R.CShow π' c V ((σ.2 i).2 : ℕ) := by
      intro σ e i h
      subst e
      exact (R.slot_show π' hA hM hc' h).2
    exact key _ hσ i h
  refine ⟨?_, ?_⟩
  · unfold KatT
    congr 1
    refine Finset.filter_congr fun V _ => ⟨fun ⟨i, hi, ha⟩ => ⟨i, hi, ?_⟩, fun ⟨i, hi, ha⟩ => ⟨i, hi, ?_⟩⟩
    · exact (R.avail_det π' hA hc' hc hh.symm (hπ hi).1 ha).1
    · exact (R.avail_det π hA hc hc' hh (hπ hi).1 ha).1
  · unfold KatT
    refine R.agree_holdOf fun V hV => ?_
    obtain ⟨i, hi, ha⟩ := (Finset.mem_filter.1 hV).2
    exact R.value_det π hA hc hc' hcf hh (hπ hi).2 (hπ' hi) ha

end P3SegT

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3ChainTarget ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge LazyPerm PousP3ConcreteMulti

section Blocks

variable {n wc : ℕ}

/-- The bits of cell `k` of a `Π₂` answer. -/
def blockC (n wc k : ℕ) : Finset (Fin (n * wc + (n * wc + 512))) :=
  if h : k < n then Finset.univ.image fun b : Fin wc => Fin.castAdd (n * wc + 512) (finProdFinEquiv (⟨k, h⟩, b))
  else if h' : k - n < n then
    Finset.univ.image fun b : Fin wc => Fin.natAdd (n * wc) (Fin.castAdd 512 (finProdFinEquiv (⟨k - n, h'⟩, b)))
  else if k = 2 * n then Finset.univ.image fun b : Fin 512 => Fin.natAdd (n * wc) (Fin.natAdd (n * wc) b)
  else ∅

/-- The bits of cell `k` of a `P` answer. -/
def blockP (n wc k : ℕ) : Finset (Fin n × Fin wc) :=
  if h : k < n then Finset.univ.image fun b : Fin wc => (⟨k, h⟩, b) else ∅

/-- The cell a `Π₂` answer bit belongs to. -/
def cellIdxC (n wc : ℕ) (i : Fin (n * wc + (n * wc + 512))) : ℕ :=
  if i.val < n * wc then i.val / wc else if i.val < n * wc + n * wc then n + (i.val - n * wc) / wc else 2 * n

theorem cellIdx_blockC {k : ℕ} {i : Fin (n * wc + (n * wc + 512))} (hi : i ∈ blockC n wc k) :
    cellIdxC n wc i = k := by
  unfold blockC at hi
  split_ifs at hi with h1 h2 h3
  · obtain ⟨b, _, rfl⟩ := Finset.mem_image.1 hi
    have hb := b.isLt
    have hv : (finProdFinEquiv ((⟨k, h1⟩ : Fin n), b)).val = b.val + wc * k := by
      simp [finProdFinEquiv_apply_val]
    have hlt : b.val + wc * k < n * wc := by nlinarith
    unfold cellIdxC
    simp only [Fin.coe_castAdd, hv, if_pos hlt]
    rw [Nat.add_mul_div_left _ _ (by omega), Nat.div_eq_of_lt hb, zero_add]
  · obtain ⟨b, _, rfl⟩ := Finset.mem_image.1 hi
    have hb := b.isLt
    have hv : (finProdFinEquiv ((⟨k - n, h2⟩ : Fin n), b)).val = b.val + wc * (k - n) := by
      simp [finProdFinEquiv_apply_val]
    have hlt : b.val + wc * (k - n) < n * wc := by nlinarith
    unfold cellIdxC
    simp only [Fin.coe_natAdd, Fin.coe_castAdd, hv]
    rw [if_neg (by omega), if_pos (by omega), show n * wc + (b.val + wc * (k - n)) - n * wc = b.val + wc * (k - n) by omega,
      Nat.add_mul_div_left _ _ (by omega), Nat.div_eq_of_lt hb, zero_add]
    omega
  · obtain ⟨b, _, rfl⟩ := Finset.mem_image.1 hi
    unfold cellIdxC
    simp only [Fin.coe_natAdd]
    rw [if_neg (by omega), if_neg (by omega)]
    omega
  · simp at hi

theorem blockC_disjoint {k k' : ℕ} (h : k ≠ k') : Disjoint (blockC n wc k) (blockC n wc k') :=
  Finset.disjoint_left.2 fun i h1 h2 => h ((cellIdx_blockC h1).symm.trans (cellIdx_blockC h2))

theorem blockP_disjoint {k k' : ℕ} (h : k ≠ k') : Disjoint (blockP n wc k) (blockP n wc k') := by
  refine Finset.disjoint_left.2 fun i h1 h2 => h ?_
  unfold blockP at h1 h2
  split_ifs at h1 h2 with ha hb
  · obtain ⟨b, _, rfl⟩ := Finset.mem_image.1 h1
    obtain ⟨b', _, e⟩ := Finset.mem_image.1 h2
    simp only [Prod.mk.injEq, Fin.mk.injEq] at e
    exact e.1.symm
  all_goals simp at h1 h2

theorem card_blockC {k : ℕ} (hk : k < 2 * n + 1) : (blockC n wc k).card = HCell.bitsAt n wc k := by
  unfold blockC HCell.bitsAt
  split_ifs with h1 h2 h3 h4
  · omega
  · rw [Finset.card_image_of_injective _ (fun a b e => by
      simpa using (finProdFinEquiv.injective (Fin.castAdd_injective _ _ e)))]
    simp
  · omega
  · rw [Finset.card_image_of_injective _ (fun a b e => by
      simpa using (finProdFinEquiv.injective (Fin.castAdd_injective _ _ (Fin.natAdd_injective _ _ e))))]
    simp
  · rw [Finset.card_image_of_injective _ (fun a b e => Fin.natAdd_injective _ _ (Fin.natAdd_injective _ _ e))]
    simp
  all_goals omega

theorem card_blockP {k : ℕ} (hk : k < n) : (blockP n wc k).card = wc := by
  unfold blockP
  rw [dif_pos hk, Finset.card_image_of_injective _ (fun a b e => by simpa using e)]
  simp

/-- **Pinned cells pin their widths' worth of bits.** -/
theorem card_pinC {S : Finset ℕ} (hS : ∀ k ∈ S, k < 2 * n + 1) :
    (S.biUnion (blockC n wc)).card = ∑ k ∈ S, HCell.bitsAt n wc k := by
  rw [Finset.card_biUnion fun a _ b _ h => blockC_disjoint h]
  exact Finset.sum_congr rfl fun k hk => card_blockC (hS k hk)

theorem card_pinP {S : Finset ℕ} (hS : ∀ k ∈ S, k < n) :
    (S.biUnion (blockP n wc)).card = ∑ k ∈ S, HCell.bitsAt n wc k := by
  rw [Finset.card_biUnion fun a _ b _ h => blockP_disjoint h]
  refine Finset.sum_congr rfl fun k hk => ?_
  rw [card_blockP (hS k hk)]
  unfold HCell.bitsAt
  rw [if_neg (by have := hS k hk; omega)]

end Blocks

theorem codeEquiv_symm_apply {n wc : ℕ} (r : Bits (n * wc)) (k : Fin n) (b : Fin wc) :
    (codeEquiv n wc).symm r k b = r (finProdFinEquiv (k, b)) := by
  simp [codeEquiv, Equiv.arrowCongr, Equiv.curry]

theorem codeEquiv_apply {n wc : ℕ} (f : Fin n → Bits wc) (k : Fin n) (b : Fin wc) :
    codeEquiv n wc f (finProdFinEquiv (k, b)) = f k b := by
  have := codeEquiv_symm_apply (codeEquiv n wc f) k b
  rw [Equiv.symm_apply_apply] at this
  exact this.symm

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι)

/-- **The honest answer of a chain call's query**: its output (`o = true`) or its input. -/
noncomputable def hAnsC (ω : P3COmega n wc) (L : Fin 2) (v : Fin n) (p : ℕ) (o : Bool) :
    Bits (n * wc + (n * wc + 512)) :=
  if o then ω.2 (R.xin ω L v p) else R.xin ω L v p

/-- **The honest answer of a `P` pair's query**: its output (`o = true`) or its input. -/
noncomputable def hAnsP (ω : P3COmega n wc) : HPt n → Bool → Lab n wc
  | .low w, o => if o then R.c1 ω w else R.pin1 ω w
  | .top u, o => if o then R.c2 ω u else R.pin2 ω u
  | .chain .., _ => fun _ _ => false

omit [DecidableEq ι] in
theorem hAnsC_true (ω : P3COmega n wc) (L : Fin 2) (v : Fin n) (p : ℕ) :
    R.hAnsC ω L v p true = ω.2 (R.xin ω L v p) := rfl

omit [DecidableEq ι] in
theorem hAnsC_false (ω : P3COmega n wc) (L : Fin 2) (v : Fin n) (p : ℕ) :
    R.hAnsC ω L v p false = R.xin ω L v p := rfl

omit [DecidableEq ι] in
theorem xin_ovH_one (ω : P3COmega n wc) (L : Fin 2) (v : Fin n) :
    ovH (R.xin ω L v 1) = iv (domP3 R.tag L v) := by
  unfold P3Replay.xin xinAt
  rw [ovH_append]
  simp [stAfter]

omit [DecidableEq ι] in
/-- **On a pinned cell's block, a chain answer's bits agree** for two oracles agreeing on the holding. -/
theorem bitC_agree {ω ω' : P3COmega n wc} {K : P3ChainKnow n} (hA : R.Agree ω ω' K) {L : Fin 2} {v : Fin n}
    {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ ovCalls R.G v) {o : Bool} {k : ℕ}
    (hk : ∀ y, cellAt R.G (.chain L v p) o k = some y → y.known R.G K) {i : Fin (n * wc + (n * wc + 512))}
    (hi : i ∈ blockC n wc k) : R.hAnsC ω L v p o i = R.hAnsC ω' L v p o i := by
  unfold blockC at hi
  split_ifs at hi with h1 h2 h3
  · obtain ⟨b, _, rfl⟩ := Finset.mem_image.1 hi
    rcases o with _ | _
    · -- the input's block
      show ovR (R.xin ω L v p) (finProdFinEquiv (⟨k, h1⟩, b)) = ovR (R.xin ω' L v p) (finProdFinEquiv (⟨k, h1⟩, b))
      cases hb : ovBlock R.G v p with
      | none =>
        have e : ∀ ω : P3COmega n wc, ovR (R.xin ω L v p) = padBlk := fun ω => by
          unfold P3Replay.xin; rw [xinAt_ovR, rowBlocks_getD_pad _ _ _ hb]
        rw [e ω, e ω']
      | some u =>
        rw [R.xin_ovR ω hb, R.xin_ovR ω' hb, codeEquiv_apply, codeEquiv_apply]
        have hy := hk (.lab L u ⟨k, h1⟩) (by simp [cellAt, h1, hb])
        by_cases hL : L = 0
        · subst hL
          simp only [HCell.known, reduceIte] at hy
          simp only [P3Replay.lab, reduceIte]
          rw [hA.2.1 _ hy]
        · simp only [HCell.known, hL, reduceIte] at hy
          simp only [P3Replay.lab, hL, reduceIte]
          rw [hA.1 _ hy]
    · -- the output's dropped part
      show R.rval ω L v p (finProdFinEquiv (⟨k, h1⟩, b)) = R.rval ω' L v p (finProdFinEquiv (⟨k, h1⟩, b))
      have hy := hk (.rc L v p ⟨k, h1⟩) (by simp [cellAt, h1])
      simp only [HCell.known] at hy
      split_ifs at hy with htp
      · obtain ⟨rfl, rfl⟩ := htp
        have e := congrFun (hA.2.2.2.2.1 _ hy) b
        simp only [P3Replay.key, codeEquiv_symm_apply] at e
        exact e
      · rw [hA.2.2.2.1 _ hy hp1 hp]
  · obtain ⟨b, _, rfl⟩ := Finset.mem_image.1 hi
    rcases o with _ | _
    · show ovH (R.xin ω L v p) (Fin.castAdd 512 (finProdFinEquiv (⟨k - n, h2⟩, b))) =
        ovH (R.xin ω' L v p) (Fin.castAdd 512 (finProdFinEquiv (⟨k - n, h2⟩, b)))
      rcases Nat.lt_or_ge p 2 with hp2 | hp2
      · obtain rfl : p = 1 := by omega
        rw [R.xin_ovH_one, R.xin_ovH_one]
      · have e : ∀ ω : P3COmega n wc, ovH (R.xin ω L v p) = R.hval ω L v (p - 1) := fun ω => by
          have := R.xin_ovH ω (L := L) (v := v) (p := p - 1) (by omega) (by omega)
          rwa [Nat.sub_add_cancel (by omega)] at this
        rw [e ω, e ω']
        have hy := hk (.hc L v (p - 1) ⟨k - n, by omega⟩) (by
          simp only [cellAt]; rw [dif_neg h1, if_neg (by omega), dif_pos (by omega)])
        rw [hA.2.2.1 _ hy (show 1 ≤ p - 1 by omega) (show p - 1 ≤ ovCalls R.G v by omega)]
    · show R.hval ω L v p (Fin.castAdd 512 (finProdFinEquiv (⟨k - n, h2⟩, b))) =
        R.hval ω' L v p (Fin.castAdd 512 (finProdFinEquiv (⟨k - n, h2⟩, b)))
      have hy := hk (.hc L v p ⟨k - n, by omega⟩) (by simp only [cellAt]; rw [dif_neg h1, dif_pos (by omega)])
      rw [hA.2.2.1 _ hy hp1 hp]
  · obtain ⟨b, _, rfl⟩ := Finset.mem_image.1 hi
    rcases o with _ | _
    · show ovH (R.xin ω L v p) (Fin.natAdd (n * wc) b) = ovH (R.xin ω' L v p) (Fin.natAdd (n * wc) b)
      rcases Nat.lt_or_ge p 2 with hp2 | hp2
      · obtain rfl : p = 1 := by omega
        rw [R.xin_ovH_one, R.xin_ovH_one]
      · have e : ∀ ω : P3COmega n wc, ovH (R.xin ω L v p) = R.hval ω L v (p - 1) := fun ω => by
          have := R.xin_ovH ω (L := L) (v := v) (p := p - 1) (by omega) (by omega)
          rwa [Nat.sub_add_cancel (by omega)] at this
        rw [e ω, e ω']
        have hy := hk (.hc L v (p - 1) ⟨k - n, by omega⟩) (by
          simp only [cellAt]; rw [dif_neg h1, if_neg (by omega), dif_pos (by omega)])
        rw [hA.2.2.1 _ hy (show 1 ≤ p - 1 by omega) (show p - 1 ≤ ovCalls R.G v by omega)]
    · show R.hval ω L v p (Fin.natAdd (n * wc) b) = R.hval ω' L v p (Fin.natAdd (n * wc) b)
      have hy := hk (.hc L v p ⟨k - n, by omega⟩) (by simp only [cellAt]; rw [dif_neg h1, dif_pos (by omega)])
      rw [hA.2.2.1 _ hy hp1 hp]
  · simp at hi

omit [DecidableEq ι] in
/-- **On a pinned cell's block, a `P` answer's bits agree** for two oracles agreeing on the holding. -/
theorem bitP_agree {ω ω' : P3COmega n wc} {K : P3ChainKnow n} (hA : R.Agree ω ω' K) {x : HPt n}
    {o : Bool} {k : ℕ} (hk : ∀ y, cellAt R.G x o k = some y → y.known R.G K) {i : Fin n × Fin wc}
    (hi : i ∈ blockP n wc k) : R.hAnsP ω x o i.1 i.2 = R.hAnsP ω' x o i.1 i.2 := by
  unfold blockP at hi
  split_ifs at hi with h1
  · obtain ⟨b, _, rfl⟩ := Finset.mem_image.1 hi
    rcases x with ⟨L, v, p⟩ | w | u <;> rcases o with _ | _
    · rfl
    · rfl
    · have hy := hk (.rc 0 w (ovCalls R.G w) ⟨k, h1⟩) (by simp [cellAt, h1])
      simp only [HCell.known] at hy
      rw [if_neg (by simp)] at hy
      have e := hA.2.2.2.1 _ hy (ovCalls_pos R.G w) le_rfl
      show (labXor (R.W w) (R.key ω 0 w)) ⟨k, h1⟩ b = (labXor (R.W w) (R.key ω' 0 w)) ⟨k, h1⟩ b
      simp only [P3Replay.key] at *
      rw [e]
    · have hy := hk (.lab 0 w ⟨k, h1⟩) (by simp [cellAt, h1])
      simp only [HCell.known, reduceIte] at hy
      show R.c1 ω w ⟨k, h1⟩ b = R.c1 ω' w ⟨k, h1⟩ b
      rw [hA.2.1 _ hy]
    · have hy := hk (.pin2 u ⟨k, h1⟩) (by simp [cellAt, h1])
      show R.pin2 ω u ⟨k, h1⟩ b = R.pin2 ω' u ⟨k, h1⟩ b
      rw [hA.2.2.2.2.2 _ hy]
    · have hy := hk (.lab 1 u ⟨k, h1⟩) (by simp [cellAt, h1])
      simp only [HCell.known] at hy
      rw [if_neg (by simp)] at hy
      show R.c2 ω u ⟨k, h1⟩ b = R.c2 ω' u ⟨k, h1⟩ b
      rw [hA.1 _ hy]
  · simp at hi

end P3SegT


/-- The honest pairs, finitely: chain calls `p + 1 ≤ n`, and the two `P` layers. -/
abbrev FPt (n : ℕ) : Type := (Fin 2 × Fin n × Fin n) ⊕ Fin n ⊕ Fin n

/-- The pair a finite name denotes. -/
def FPt.pt {n : ℕ} : FPt n → HPt n
  | .inl q => .chain q.1 q.2.1 (q.2.2.val + 1)
  | .inr (.inl w) => .low w
  | .inr (.inr u) => .top u

/-- **Kinds**: the pair, the number of pinned components (minus one) and whether the capacity is pinned. -/
abbrev Kind (n : ℕ) : Type := FPt n × Fin (2 * n) × Bool

/-- A kind's width in bits: at least one component. -/
def Kind.w {n : ℕ} (wc : ℕ) (κ : Kind n) : ℕ := (κ.2.1.val + 1) * wc + if κ.2.2 then 512 else 0

theorem card_kind {n : ℕ} (hn : 0 < n) : 0 < Fintype.card (Kind n) ∧ Fintype.card (Kind n) ≤ 16 * n ^ 3 + 16 := by
  simp only [Fintype.card_prod, Fintype.card_sum, Fintype.card_fin, Fintype.card_bool]
  constructor
  · positivity
  · nlinarith [sq_nonneg n, hn]

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι)

open Classical in
/-- **The pinned cells** of pair `x`'s answer side `o`: its cells known in `K`, or public constants. -/
noncomputable def PinT (K : P3ChainKnow n) (x : HPt n) (o : Bool) : Finset ℕ :=
  (Finset.range (posN x)).filter fun k => ∀ y, cellAt R.G x o k = some y → y.known R.G K

/-- A kind matches a set of pinned cells: the component count and the capacity. -/
def KindOk (S : Finset ℕ) (κ : Kind n) : Prop :=
  (S.filter (· ≠ 2 * n)).card = κ.2.1.val + 1 ∧ (2 * n ∈ S ↔ κ.2.2 = true)

omit [DecidableEq ι] in
theorem sum_bits_of_kindOk {S : Finset ℕ} {κ : Kind n} (h : KindOk S κ) :
    ∑ k ∈ S, HCell.bitsAt n wc k = κ.w wc := by
  classical
  rw [← Finset.sum_filter_add_sum_filter_not S (· ≠ 2 * n)]
  have h1 : ∑ k ∈ S.filter (· ≠ 2 * n), HCell.bitsAt n wc k = (S.filter (· ≠ 2 * n)).card * wc := by
    rw [Finset.card_eq_sum_ones, Finset.sum_mul, one_mul]
    exact Finset.sum_congr rfl fun k hk => by
      unfold HCell.bitsAt; rw [if_neg (Finset.mem_filter.1 hk).2]
  have h2 : ∑ k ∈ S.filter (fun k => ¬ k ≠ 2 * n), HCell.bitsAt n wc k = if κ.2.2 then 512 else 0 := by
    have e : S.filter (fun k => ¬ k ≠ 2 * n) = if 2 * n ∈ S then {2 * n} else ∅ := by
      ext k
      simp only [Finset.mem_filter, not_not]
      split_ifs with hm
      · simp only [Finset.mem_singleton]; constructor
        · exact fun h => h.2
        · rintro rfl; exact ⟨hm, rfl⟩
      · simp only [Finset.notMem_empty, iff_false]; rintro ⟨hk, rfl⟩; exact hm hk
    rw [e]
    by_cases hm : 2 * n ∈ S
    · rw [if_pos hm, if_pos (h.2.1 hm), Finset.sum_singleton]; unfold HCell.bitsAt; rw [if_pos rfl]
    · have : κ.2.2 = false := by
        cases hk : κ.2.2
        · rfl
        · exact absurd (h.2.2 hk) hm
      rw [if_neg hm, this, Finset.sum_empty]; rfl
  rw [h1, h2, h.1]
  rfl


open Classical in
/-- **The target of one oracle**: the answers that agree with its honest answer on the pinned cells. -/
noncomputable def tgt (ω : P3COmega n wc) (K : P3ChainKnow n) (x : HPt n) :
    (q : Qry (P3Alpha n wc)) → Finset (P3Alpha n wc q.1)
  | ⟨.inr _, qv⟩ =>
    match x with
    | .chain L v p => agreeSet ((R.PinT K x qv.isLeft).biUnion (blockC n wc)) (R.hAnsC ω L v p qv.isLeft)
    | _ => ∅
  | ⟨.inl T, qv⟩ =>
    if (Sum.inl T : P3Idx n) = x.comp R.tag ∧ (∀ L v p, x ≠ .chain L v p) then
      (agreeSet ((R.PinT K x qv.isLeft).biUnion (blockP n wc)) (fun i => R.hAnsP ω x qv.isLeft i.1 i.2)).map
        (Equiv.curry (Fin n) (Fin wc) Bool).toEmbedding
    else ∅

/-- The holding a target reads: the step-level closure of `h` with the table's values available there. -/
noncomputable def knT {M : ℕ} (π' : Oracle (P3Alpha n wc)) (σ : Sig n M) (c : ℕ) (h : History (P3Alpha n wc)) :
    P3ChainKnow n :=
  R.svc ((omegaEquiv n wc).symm π') h (R.KatT π' σ c h.length)

/-- An oracle realizes a table at the full cut. -/
def Real {M : ℕ} (c : ℕ) (σ : Sig n M) (π' : Oracle (P3Alpha n wc)) : Prop :=
  σ = R.tableOf π' c M ∧ (sched R π').length = c

open Classical in
/-- **The uniform target**: under an oracle realizing the table with the same history, the answers agreeing with its
honest answer on the pinned cells, when the kind matches them. -/
noncomputable def Tgt {M : ℕ} (c : ℕ) (σ : Sig n M) (κ : Kind n) (h : History (P3Alpha n wc))
    (q : Qry (P3Alpha n wc)) : Finset (P3Alpha n wc q.1) :=
  readAtP (R.stratC c) h (R.Real c σ) fun π' =>
    if KindOk (R.PinT (R.knT π' σ c h) κ.1.pt q.2.isLeft) κ then
      R.tgt ((omegaEquiv n wc).symm π') (R.knT π' σ c h) κ.1.pt q
    else ∅

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι)

omit [DecidableEq ι] in
theorem pinT_range {K : P3ChainKnow n} {x : HPt n} {o : Bool} {k : ℕ} (hk : k ∈ R.PinT K x o) : k < posN x := by
  classical
  unfold PinT at hk
  exact Finset.mem_range.1 (Finset.mem_filter.1 hk).1

theorem mem_agreeSet {X : Type} [Fintype X] [DecidableEq X] {S : Finset X} {c f : X → Bool} :
    f ∈ agreeSet S c ↔ ∀ x ∈ S, f x = c x := by
  unfold agreeSet; simp

theorem agreeSet_congr {X : Type} [Fintype X] [DecidableEq X] {S : Finset X} {c c' : X → Bool}
    (h : ∀ x ∈ S, c x = c' x) : agreeSet S c = agreeSet S c' := by
  unfold agreeSet
  exact Finset.filter_congr fun f _ => ⟨fun hf x hx => (hf x hx).trans (h x hx), fun hf x hx => (hf x hx).trans (h x hx).symm⟩

open Classical in
omit [DecidableEq ι] in
theorem tgt_inl (ω : P3COmega n wc) (K : P3ChainKnow n) (x : HPt n) (T : Tweak n)
    (qv : P3Alpha n wc (Sum.inl T) ⊕ P3Alpha n wc (Sum.inl T)) :
    R.tgt ω K x ⟨.inl T, qv⟩ =
      if (Sum.inl T : P3Idx n) = x.comp R.tag ∧ (∀ L v p, x ≠ .chain L v p) then
        (agreeSet ((R.PinT K x qv.isLeft).biUnion (blockP n wc)) (fun i => R.hAnsP ω x qv.isLeft i.1 i.2)).map
          (Equiv.curry (Fin n) (Fin wc) Bool).toEmbedding
      else ∅ := rfl

omit [DecidableEq ι] in
theorem tgt_chain (ω : P3COmega n wc) (K : P3ChainKnow n) (L : Fin 2) (v : Fin n) (p : ℕ) (u : Unit)
    (qv : P3Alpha n wc (Sum.inr u) ⊕ P3Alpha n wc (Sum.inr u)) :
    R.tgt ω K (.chain L v p) ⟨.inr u, qv⟩ =
      agreeSet ((R.PinT K (.chain L v p) qv.isLeft).biUnion (blockC n wc)) (R.hAnsC ω L v p qv.isLeft) := rfl

omit [DecidableEq ι] in
theorem tgt_low (ω : P3COmega n wc) (K : P3ChainKnow n) (w : Fin n) (u : Unit)
    (qv : P3Alpha n wc (Sum.inr u) ⊕ P3Alpha n wc (Sum.inr u)) : R.tgt ω K (.low w) ⟨.inr u, qv⟩ = ∅ := rfl

omit [DecidableEq ι] in
theorem tgt_top (ω : P3COmega n wc) (K : P3ChainKnow n) (w : Fin n) (u : Unit)
    (qv : P3Alpha n wc (Sum.inr u) ⊕ P3Alpha n wc (Sum.inr u)) : R.tgt ω K (.top w) ⟨.inr u, qv⟩ = ∅ := rfl

omit [DecidableEq ι] in
/-- **A matched target fixes the kind's width.** -/
theorem tgt_card {ω : P3COmega n wc} {K : P3ChainKnow n} {x : HPt n} {κ : Kind n} {q : Qry (P3Alpha n wc)}
    (hk : KindOk (R.PinT K x q.2.isLeft) κ) (nPos : ℕ) :
    (R.tgt ω K x q).card * (2 ^ κ.w wc - nPos) ≤ Fintype.card (P3Alpha n wc q.1) - nPos := by
  classical
  obtain ⟨i, qv⟩ := q
  rcases i with T | u
  · by_cases hc : (Sum.inl T : P3Idx n) = x.comp R.tag ∧ (∀ L v p, x ≠ .chain L v p)
    · have e : (R.tgt ω K x ⟨.inl T, qv⟩).card = (agreeSet ((R.PinT K x qv.isLeft).biUnion (blockP n wc))
          (fun i => R.hAnsP ω x qv.isLeft i.1 i.2)).card := by
        rw [tgt_inl, if_pos hc]; exact Finset.card_map _
      have hcard : Fintype.card (P3Alpha n wc (⟨Sum.inl T, qv⟩ : Qry (P3Alpha n wc)).1) = 2 ^ (n * wc) := by
        show Fintype.card (Fin n → Fin wc → Bool) = _
        rw [Fintype.card_fun, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin, Fintype.card_fin, ← pow_mul,
          mul_comm]
      have hP := card_pinP (wc := wc) (S := R.PinT K x qv.isLeft) fun k hk => by
        have := R.pinT_range hk
        rcases x with ⟨L, v, p⟩ | w | u
        · exact absurd rfl (hc.2 L v p)
        · exact this
        · exact this
      have hk' : KindOk (R.PinT K x qv.isLeft) κ := hk
      have hw : κ.w wc ≤ n * wc := by
        rw [← sum_bits_of_kindOk hk', ← hP]
        exact (Finset.card_le_univ _).trans (by rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin])
      rw [e, hcard, card_agreeSet, hP, sum_bits_of_kindOk hk', Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]
      exact pin_target_le hw le_rfl
    · have e : (R.tgt ω K x ⟨.inl T, qv⟩).card = 0 := by rw [tgt_inl, if_neg hc]; rfl
      rw [e, zero_mul]; exact Nat.zero_le _
  · rcases x with ⟨L, v, p⟩ | w | u'
    · have e : (R.tgt ω K (.chain L v p) ⟨.inr u, qv⟩).card = (agreeSet ((R.PinT K (.chain L v p) qv.isLeft).biUnion
          (blockC n wc)) (R.hAnsC ω L v p qv.isLeft)).card := by rw [tgt_chain]; rfl
      have hcard : Fintype.card (P3Alpha n wc (⟨Sum.inr u, qv⟩ : Qry (P3Alpha n wc)).1) =
          2 ^ (n * wc + (n * wc + 512)) := by
        show Fintype.card (Bits (n * wc + (n * wc + 512))) = _
        exact card_bits _
      have hk' : KindOk (R.PinT K (.chain L v p) qv.isLeft) κ := hk
      have hP := card_pinC (wc := wc) (S := R.PinT K (.chain L v p) qv.isLeft) fun k hk => R.pinT_range hk
      have hw : κ.w wc ≤ n * wc + (n * wc + 512) := by
        rw [← sum_bits_of_kindOk hk', ← hP]
        exact (Finset.card_le_univ _).trans (by rw [Fintype.card_fin])
      rw [e, hcard, card_agreeSet, hP, sum_bits_of_kindOk hk', Fintype.card_fin]
      exact pin_target_le hw le_rfl
    · have e : (R.tgt ω K (.low w) ⟨.inr u, qv⟩).card = 0 := by rw [tgt_low]; rfl
      rw [e, zero_mul]; exact Nat.zero_le _
    · have e : (R.tgt ω K (.top u') ⟨.inr u, qv⟩).card = 0 := by rw [tgt_top]; rfl
      rw [e, zero_mul]; exact Nat.zero_le _

/-- **`hT`: every uniform target fixes its kind's width.** -/
theorem Tgt_card {M c : ℕ} (σ : Sig n M) (κ : Kind n) (h : History (P3Alpha n wc)) (q : Qry (P3Alpha n wc))
    (nPos : ℕ) : (R.Tgt c σ κ h q).card * (2 ^ κ.w wc - nPos) ≤ Fintype.card (P3Alpha n wc q.1) - nPos := by
  classical
  unfold Tgt readAtP
  split_ifs with hex
  · dsimp only
    split_ifs with hk
    · exact R.tgt_card hk nPos
    · have e : (∅ : Finset (P3Alpha n wc q.1)).card = 0 := Finset.card_empty
      rw [e, zero_mul]; exact Nat.zero_le _
  · have e : (default : Finset (P3Alpha n wc q.1)).card = 0 := Finset.card_empty
    rw [e, zero_mul]; exact Nat.zero_le _

end P3SegT

namespace P3SegT

open P3Replay P3Seg

variable {n wc : ℕ} {ι : Type} [DecidableEq ι] (R : P3SegT n wc ι)

omit [DecidableEq ι] in
theorem mem_pinT {K : P3ChainKnow n} {x : HPt n} {o : Bool} {k : ℕ} (hk : k ∈ R.PinT K x o) :
    ∀ y, cellAt R.G x o k = some y → y.known R.G K := by
  classical
  unfold PinT at hk
  exact (Finset.mem_filter.1 hk).2

omit [DecidableEq ι] in
/-- **A target depends on the oracle only through the pinned cells' values.** -/
theorem tgt_congr {ω ω' : P3COmega n wc} {K : P3ChainKnow n} (hA : R.Agree ω ω' K) {x : HPt n}
    (hx : x.Valid R.G) (q : Qry (P3Alpha n wc)) : R.tgt ω' K x q = R.tgt ω K x q := by
  classical
  obtain ⟨i, qv⟩ := q
  rcases i with T | u
  · rw [tgt_inl, tgt_inl]
    split_ifs with hc
    · congr 1
      refine agreeSet_congr fun p hp => ?_
      obtain ⟨k, hk, hpk⟩ := Finset.mem_biUnion.1 hp
      exact (R.bitP_agree hA (R.mem_pinT hk) hpk).symm
    · rfl
  · rcases x with ⟨L, v, p⟩ | w | u'
    · rw [tgt_chain, tgt_chain]
      refine agreeSet_congr fun b hb => ?_
      obtain ⟨k, hk, hbk⟩ := Finset.mem_biUnion.1 hb
      exact (R.bitC_agree hA hx.1 hx.2 (R.mem_pinT hk) hbk).symm
    · rfl
    · rfl

variable {π : Oracle (P3Alpha n wc)}

set_option maxRecDepth 100000 in
/-- **The true answer of an honest pair's fresh query is in its oracle's target.** -/
theorem ans_mem_tgt {K : P3ChainKnow n} {x : HPt n} {q : Qry (P3Alpha n wc)}
    (hqq : q = ⟨x.comp R.tag, .inl (x.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩ ∨
      q = ⟨x.comp R.tag, .inr (π (x.comp R.tag) (x.val R.toP3Replay ((omegaEquiv n wc).symm π)))⟩) :
    ans π q ∈ R.tgt ((omegaEquiv n wc).symm π) K x q := by
  rcases x with ⟨L, v, p⟩ | w | u <;> rcases hqq with rfl | rfl
  · show ans π ⟨Sum.inr (), Sum.inl (R.xin ((omegaEquiv n wc).symm π) L v p)⟩ ∈
      R.tgt ((omegaEquiv n wc).symm π) K (.chain L v p) ⟨Sum.inr (), Sum.inl (R.xin ((omegaEquiv n wc).symm π) L v p)⟩
    rw [tgt_chain]
    have e : ans π ⟨Sum.inr (), Sum.inl (R.xin ((omegaEquiv n wc).symm π) L v p)⟩ = R.hAnsC ((omegaEquiv n wc).symm π) L v p true := by
      have h2 : ((omegaEquiv n wc).symm π).2 = π (Sum.inr ()) := rfl
      rw [hAnsC_true, h2]
      rfl
    exact mem_agreeSet.2 fun b _ => congrFun e b
  · show ans π ⟨Sum.inr (), Sum.inr (π (Sum.inr ()) (R.xin ((omegaEquiv n wc).symm π) L v p))⟩ ∈
      R.tgt ((omegaEquiv n wc).symm π) K (.chain L v p) ⟨Sum.inr (), Sum.inr (π (Sum.inr ()) (R.xin ((omegaEquiv n wc).symm π) L v p))⟩
    rw [tgt_chain]
    have e : ans π ⟨Sum.inr (), Sum.inr (π (Sum.inr ()) (R.xin ((omegaEquiv n wc).symm π) L v p))⟩ = R.hAnsC ((omegaEquiv n wc).symm π) L v p false := by
      rw [hAnsC_false]
      exact Equiv.symm_apply_apply (π (Sum.inr ())) (R.xin ((omegaEquiv n wc).symm π) L v p)
    exact mem_agreeSet.2 fun b _ => congrFun e b
  · show ans π ⟨Sum.inl (R.tag, 0, w), Sum.inl (R.pin1 ((omegaEquiv n wc).symm π) w)⟩ ∈ R.tgt ((omegaEquiv n wc).symm π) K (.low w) ⟨Sum.inl (R.tag, 0, w), Sum.inl (R.pin1 ((omegaEquiv n wc).symm π) w)⟩
    rw [tgt_inl, if_pos ⟨rfl, fun _ _ _ h => by simp at h⟩]
    have ha : (ans π ⟨Sum.inl (R.tag, 0, w), Sum.inl (R.pin1 ((omegaEquiv n wc).symm π) w)⟩ : Fin n → Fin wc → Bool) = R.hAnsP ((omegaEquiv n wc).symm π) (.low w) true := by
      show π (Sum.inl (R.tag, 0, w)) (R.pin1 ((omegaEquiv n wc).symm π) w) = R.c1 ((omegaEquiv n wc).symm π) w
      rw [R.c1_eq]; rfl
    refine Finset.mem_map.2 ⟨Function.uncurry (ans π ⟨Sum.inl (R.tag, 0, w), Sum.inl (R.pin1 ((omegaEquiv n wc).symm π) w)⟩ : Fin n → Fin wc → Bool),
      mem_agreeSet.2 fun i _ => ?_, Function.curry_uncurry _⟩
    exact congrFun (congrFun ha i.1) i.2
  · show ans π ⟨Sum.inl (R.tag, 0, w), Sum.inr (π (Sum.inl (R.tag, 0, w)) (R.pin1 ((omegaEquiv n wc).symm π) w))⟩ ∈ R.tgt ((omegaEquiv n wc).symm π) K (.low w) ⟨Sum.inl (R.tag, 0, w), Sum.inr (π (Sum.inl (R.tag, 0, w)) (R.pin1 ((omegaEquiv n wc).symm π) w))⟩
    rw [tgt_inl, if_pos ⟨rfl, fun _ _ _ h => by simp at h⟩]
    have ha : (ans π ⟨Sum.inl (R.tag, 0, w), Sum.inr (π (Sum.inl (R.tag, 0, w)) (R.pin1 ((omegaEquiv n wc).symm π) w))⟩ : Fin n → Fin wc → Bool) = R.hAnsP ((omegaEquiv n wc).symm π) (.low w) false :=
      Equiv.symm_apply_apply (π (Sum.inl (R.tag, 0, w))) (R.pin1 ((omegaEquiv n wc).symm π) w)
    refine Finset.mem_map.2 ⟨Function.uncurry (ans π ⟨Sum.inl (R.tag, 0, w), Sum.inr (π (Sum.inl (R.tag, 0, w)) (R.pin1 ((omegaEquiv n wc).symm π) w))⟩ : Fin n → Fin wc → Bool),
      mem_agreeSet.2 fun i _ => ?_, Function.curry_uncurry _⟩
    exact congrFun (congrFun ha i.1) i.2
  · show ans π ⟨Sum.inl (R.tag, 1, u), Sum.inl (R.pin2 ((omegaEquiv n wc).symm π) u)⟩ ∈ R.tgt ((omegaEquiv n wc).symm π) K (.top u) ⟨Sum.inl (R.tag, 1, u), Sum.inl (R.pin2 ((omegaEquiv n wc).symm π) u)⟩
    rw [tgt_inl, if_pos ⟨rfl, fun _ _ _ h => by simp at h⟩]
    have ha : (ans π ⟨Sum.inl (R.tag, 1, u), Sum.inl (R.pin2 ((omegaEquiv n wc).symm π) u)⟩ : Fin n → Fin wc → Bool) = R.hAnsP ((omegaEquiv n wc).symm π) (.top u) true := by
      show π (Sum.inl (R.tag, 1, u)) (R.pin2 ((omegaEquiv n wc).symm π) u) = R.c2 ((omegaEquiv n wc).symm π) u
      rw [R.c2_eq]; rfl
    refine Finset.mem_map.2 ⟨Function.uncurry (ans π ⟨Sum.inl (R.tag, 1, u), Sum.inl (R.pin2 ((omegaEquiv n wc).symm π) u)⟩ : Fin n → Fin wc → Bool),
      mem_agreeSet.2 fun i _ => ?_, Function.curry_uncurry _⟩
    exact congrFun (congrFun ha i.1) i.2
  · show ans π ⟨Sum.inl (R.tag, 1, u), Sum.inr (π (Sum.inl (R.tag, 1, u)) (R.pin2 ((omegaEquiv n wc).symm π) u))⟩ ∈ R.tgt ((omegaEquiv n wc).symm π) K (.top u) ⟨Sum.inl (R.tag, 1, u), Sum.inr (π (Sum.inl (R.tag, 1, u)) (R.pin2 ((omegaEquiv n wc).symm π) u))⟩
    rw [tgt_inl, if_pos ⟨rfl, fun _ _ _ h => by simp at h⟩]
    have ha : (ans π ⟨Sum.inl (R.tag, 1, u), Sum.inr (π (Sum.inl (R.tag, 1, u)) (R.pin2 ((omegaEquiv n wc).symm π) u))⟩ : Fin n → Fin wc → Bool) = R.hAnsP ((omegaEquiv n wc).symm π) (.top u) false :=
      Equiv.symm_apply_apply (π (Sum.inl (R.tag, 1, u))) (R.pin2 ((omegaEquiv n wc).symm π) u)
    refine Finset.mem_map.2 ⟨Function.uncurry (ans π ⟨Sum.inl (R.tag, 1, u), Sum.inr (π (Sum.inl (R.tag, 1, u)) (R.pin2 ((omegaEquiv n wc).symm π) u))⟩ : Fin n → Fin wc → Bool),
      mem_agreeSet.2 fun i _ => ?_, Function.curry_uncurry _⟩
    exact congrFun (congrFun ha i.1) i.2

/-- **`h_target`: the true answer is in the uniform target** at the pair's first fresh step. -/
theorem target_mem (hA : ∀ v, (R.A v).Bounded R.D R.Q) {M c : ℕ} (hM : c + R.ths.length ≤ M + 1)
    (hc : c ≤ (sched R π).length) (hcf : (sched R π).length ≤ c) {x : HPt n} (hx : x.Valid R.G) {j : ℕ}
    {κ : Kind n} (hκx : κ.1.pt = x) {q : Qry (P3Alpha n wc)}
    (hq : (R.stratC c).next ((R.stratC c).hist π j) = some q)
    (hqq : q = ⟨x.comp R.tag, .inl (x.val R.toP3Replay ((omegaEquiv n wc).symm π))⟩ ∨
      q = ⟨x.comp R.tag, .inr (π (x.comp R.tag) (x.val R.toP3Replay ((omegaEquiv n wc).symm π)))⟩)
    (hκ : KindOk (R.PinT (R.knT π (R.tableOf π c M) c ((R.stratC c).hist π j)) x q.2.isLeft) κ) :
    ans π q ∈ R.Tgt c (R.tableOf π c M) κ ((R.stratC c).hist π j) q := by
  classical
  have hlen : ((R.stratC c).hist π j).length = j := (R.stratC c).length_hist_of_next hq
  unfold Tgt
  rw [readAtP_eq (R.stratC c) (R.Real c (R.tableOf π c M)) _ ⟨rfl, le_antisymm hcf hc⟩ ?_ hlen]
  · rw [hκx, if_pos (hκx ▸ hκ)]
    exact R.ans_mem_tgt hqq
  · intro π' hh hreal
    have hc' : c ≤ (sched R π').length := hreal.2.ge
    obtain ⟨e1, e2⟩ := R.katT_det π hA hM hc hc' hcf hreal.2.le hh hreal.1.symm
    have hcons : Cons2 ((omegaEquiv n wc).symm π) ((omegaEquiv n wc).symm π') ((R.stratC c).hist π j) := by
      refine ⟨fun e he => ?_, fun e he => ?_⟩
      · rw [Equiv.apply_symm_apply]; exact (R.stratC c).mem_hist he
      · rw [Equiv.apply_symm_apply]; exact (R.stratC c).mem_hist (hh ▸ he)
    have hsv := R.agree_svc hcons e2
    have hK : R.knT π' (R.tableOf π c M) c ((R.stratC c).hist π j) =
        R.knT π (R.tableOf π c M) c ((R.stratC c).hist π j) := by
      unfold knT
      rw [hlen, e1, ← hsv.1]
    have hA' : R.Agree ((omegaEquiv n wc).symm π) ((omegaEquiv n wc).symm π')
        (R.knT π (R.tableOf π c M) c ((R.stratC c).hist π j)) := by
      unfold knT; rw [hlen]; exact hsv.2
    rw [hK, hκx, R.tgt_congr hA' hx]

end P3SegT

