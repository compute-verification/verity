section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm
open Pous.BandChain.KeyRule

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)


/-- Every coordinate of `K` is in `VCTarget`. -/
def TargetsAll (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (hist : History (BandAlpha ℓ c))
    (H K : ChainKnow B) : Prop :=
  (∀ v ∈ K.labs, R.VCTarget π hist H (.lab v)) ∧
    (∀ q ∈ K.rs, R.VCTarget π hist H (.r q)) ∧ (∀ q ∈ K.hs, R.VCTarget π hist H (.h q))

theorem targetsAll_read' {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {hist : History (BandAlpha ℓ c)}
    {H K : ChainKnow B} (hK : R.TargetsAll π hist H K) :
    R.TargetsAll π hist H (read' R.G K) := by
  refine ⟨fun v hv => ?_, fun q hq => ?_, fun q hq => hK.2.2 q hq⟩
  · rcases (mem_read'_labs R.G K v).1 hv with hv | hv
    · exact hK.1 v hv
    · exact .padLabel (hK.2.1 _ hv)
  · rcases (mem_read'_rs R.G K q).1 hq with hq | ⟨v, hv, rfl⟩
    · exact hK.2.1 q hq
    · exact .padR (hK.1 v hv)

theorem targetsAll_vcStepAt {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {hist : History (BandAlpha ℓ c)}
    {H K : ChainKnow B} {ρ : ℕ}
    (hdom : ∀ q ∈ R.posSet, R.revealedAt π ρ q → R.xin π q.1 q.2 ∈ hist.dom ())
    (hK : R.TargetsAll π hist H K) : R.TargetsAll π hist H (R.vcStepAt π ρ K) := by
  classical
  refine ⟨fun u hu => ?_, fun q hq => ?_, fun q hq => ?_⟩
  · simp only [vcStepAt, Finset.mem_union, Finset.mem_filter, Finset.mem_univ,
      true_and] at hu
    rcases hu with hu | ⟨q, hqh, hqr, hpos, hrev, hb⟩
    · exact hK.1 u hu
    · exact .inverseLab hpos (hdom q hpos hrev) (hK.2.1 q hqr) (hK.2.2 q hqh) hb
  · simp only [vcStepAt, Finset.mem_union, Finset.mem_filter] at hq
    rcases hq with hq | ⟨hpos, hrev, hc⟩
    · exact hK.2.1 q hq
    · obtain ⟨-, -, hbl, hprev⟩ := hc
      have hblock : ∀ u, ovBlock R.G q.1 q.2 = some u → R.VCTarget π hist H (.lab u) :=
        fun u hu => hK.1 u (hbl u hu)
      by_cases hq1 : q.2 = 1
      · exact .forwardRFirst hpos hq1 (hdom q hpos hrev) hblock
      · rcases hprev with h1 | hprev
        · exact absurd h1 hq1
        · exact .forwardRPrev hpos (by have := (R.mem_posSet.1 hpos).1; omega)
            (hdom q hpos hrev) hblock (hK.2.2 _ hprev)
  · simp only [vcStepAt, Finset.mem_union, Finset.mem_filter] at hq
    rcases hq with hq | ⟨hpos, ⟨hrev, hc⟩ | ⟨hn, hrev, hh, hr⟩⟩
    · exact hK.2.2 q hq
    · obtain ⟨-, -, hbl, hprev⟩ := hc
      have hblock : ∀ u, ovBlock R.G q.1 q.2 = some u → R.VCTarget π hist H (.lab u) :=
        fun u hu => hK.1 u (hbl u hu)
      by_cases hq1 : q.2 = 1
      · exact .forwardHFirst hpos hq1 (hdom q hpos hrev) hblock
      · rcases hprev with h1 | hprev
        · exact absurd h1 hq1
        · exact .forwardHPrev hpos (by have := (R.mem_posSet.1 hpos).1; omega)
            (hdom q hpos hrev) hblock (hK.2.2 _ hprev)
    · have hq1 := (R.mem_posSet.1 hpos).1
      have hpos' : (q.1, q.2 + 1) ∈ R.posSet := R.mem_posSet.2 ⟨by omega, hn⟩
      have ht := VCTarget.inverseH (R := R) (π := π) (hist := hist) (H := H)
        (q := (q.1, q.2 + 1)) hpos' (by simp only; omega) (hdom _ hpos' hrev)
        (hK.2.1 _ hr) (hK.2.2 _ hh)
      simpa using ht

/-- **Credit soundness, target form.** When every pair revealed before round `τ` is fixed in
`hist`, all of `vcCredit τ H` lies in `VCTarget hist H`. -/
theorem targetsAll_vcCredit (R : ChainReplay B ℓ c) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hist : History (BandAlpha ℓ c)) (H : ChainKnow B) :
    ∀ τ, (∀ ρ < τ, ∀ q ∈ R.posSet, R.revealedAt π ρ q → R.xin π q.1 q.2 ∈ hist.dom ()) →
      R.TargetsAll π hist H (R.vcCredit π τ H)
  | 0, _ => R.targetsAll_read' ⟨fun _ h => .heldLab h, fun _ h => .heldR h, fun _ h => .heldH h⟩
  | τ + 1, hdom =>
      R.targetsAll_read' (R.targetsAll_vcStepAt (hdom τ (Nat.lt_succ_self τ))
        (R.targetsAll_vcCredit π hist H τ fun ρ hρ => hdom ρ (by omega)))


theorem chainR_trace_inl {X : Type}
    (f : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c)))
    (k : Bits ℓ × Bits (ℓ + c) →
      LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) (Bits (ℓ + (ℓ + c))) X)
    (hk : ∀ p, ∀ e ∈ (k p).trace f, e.2.isLeft) :
    ∀ (blks : List (Bits ℓ)) (p : Bits ℓ × Bits (ℓ + c)),
      ∀ e ∈ (PousSpongeChain.chainR p blks k).trace f, e.2.isLeft
  | [], p, e, he => hk p e he
  | blk :: blks, p, e, he => by
      simp only [PousSpongeChain.chainR, LazyPerm.RProg.trace, List.mem_append, List.mem_map,
        List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false] at he
      rcases he with ⟨x, rfl, rfl⟩ | ⟨e', he', rfl⟩
      · rfl
      · exact chainR_trace_inl f k hk blks _ e' he'

theorem labR_trace_inl (f : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) :
    ∀ (n : ℕ) (k : ℕ) (acc : Fin B → Bits ℓ), B - k = n →
      ∀ e ∈ (R.labR k acc).trace f, e.2.isLeft := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
      intro k acc hn e he
      rw [labR] at he
      split at he
      · rename_i hk
        exact chainR_trace_inl f _ (fun p e' he' =>
          ih (B - (k + 1)) (by omega) (k + 1) _ rfl e' he') _ _ e he
      · simp [LazyPerm.RProg.trace] at he

theorem labTail_inl {h : History (BandAlpha ℓ c)} {q : Qry (BandAlpha ℓ c)}
    (hq : R.labTail h = some q) : ∃ x, q = ⟨(), .inl x⟩ := by
  unfold labTail at hq
  obtain ⟨d, hd, rfl⟩ := Option.map_eq_some_iff.1 hq
  have hmem := List.mem_of_find?_eq_some hd
  obtain ⟨e, he, rfl⟩ := List.mem_map.1 hmem
  have hl := R.labR_trace_inl (R.bandAnsOf h) _ 0 (fun _ _ => false) rfl e he
  rcases e with ⟨r, x | y⟩
  · exact ⟨x, rfl⟩
  · simp at hl


theorem programSteps_eq_roundStart_D (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.programSteps π = R.roundStart π R.D := by
  rw [R.programSteps_eq_advSched, R.advSched_eq_advSeq, R.sc_roundStart_eq_advPrefix hP π R.D]
  rfl

theorem advThenLab_hist_src_before (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {m : ℕ} (hm : m ≤ R.programSteps π)
    {e : Entry (BandAlpha ℓ c)} (he : e ∈ R.advThenLab.hist (fun _ : Unit => π) m) :
    ∃ i, ∃ te ∈ R.tr π i, R.roundStart π te.1 < m ∧
      e = qEntry (fun _ : Unit => π) bandEnc te.2 := by
  classical
  have hex : ∃ τ, m ≤ R.roundStart π τ :=
    ⟨R.D, by rw [← R.programSteps_eq_roundStart_D hP π]; exact hm⟩
  let τ := Nat.find hex
  have hτ : m ≤ R.roundStart π τ := Nat.find_spec hex
  have hτD : τ ≤ R.D := Nat.find_min' hex (by rw [← R.programSteps_eq_roundStart_D hP π]; exact hm)
  have he' : e ∈ R.advThenLab.hist (fun _ : Unit => π) (R.roundStart π τ) :=
    (R.advThenLab.hist_prefix _ hτ).subset he
  obtain ⟨i, te, hte, hlt, rfl⟩ := R.advThenLab_hist_roundStart_src hP π hτD
    (R.roundStart_le_programSteps π hτD) he'
  refine ⟨i, te, hte, ?_, rfl⟩
  have := Nat.find_min hex hlt
  omega

theorem qEntry_inpAt_revealPt (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (d : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) :
    (qEntry (fun _ : Unit => π) bandEnc d).inpAt () = some (revealPt π d) := by
  rcases d with x | y <;> simp [qEntry, bandEnc, Entry.inpAt, Entry.inp, ans, revealPt]

/-- Pairs revealed before round `ρ` are fixed in every truncated history past `roundStart ρ`. -/
theorem revealed_dom_stratC (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {cut j ρ : ℕ} (hcut : cut ≤ R.programSteps π)
    (hρD : ρ ≤ R.D) (hρcut : R.roundStart π ρ ≤ cut) (hρj : R.roundStart π ρ ≤ j) :
    ∀ ρ' < ρ, ∀ q ∈ R.posSet, R.revealedAt π ρ' q →
      R.xin π q.1 q.2 ∈ ((R.stratC cut).hist (fun _ : Unit => π) j).dom () := by
  intro ρ' hρ' q _ hrev
  obtain ⟨i, te, hte, hteρ, hpt⟩ := hrev
  have hmem := R.sc_trace_query_mem_advThenLab hP π (le_refl (R.roundStart π ρ))
    (R.roundStart_le_programSteps π hρD) hρD hte (by omega)
  rw [R.sc_advThenLab_hist_eq_stratC_take π hcut hρcut hρj] at hmem
  refine History.mem_dom.2 ⟨_, List.mem_of_mem_take hmem, ?_⟩
  rw [qEntry_inpAt_revealPt, hpt]

/-- Shows of a round ending by the cut are credited against the full cut holding. -/
theorem atomIn_vcCredit_cut {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {cut ρ : ℕ}
    (hρD : ρ ≤ R.D) (hend : R.roundStart π (ρ + 1) ≤ cut)
    {x : VCommit B R.Q} (hx : x ∈ R.basisAt π ρ) :
    AtomIn x.atom (R.vcCredit π ρ (R.seedsAtCut π cut)) := by
  classical
  have hrec := R.mem_showRecords_of hρD hx
  unfold seedsAtCut
  split
  · rw [← R.showRecords_fold_eq_v6SeedsThrough π]
    exact R.atomIn_vcCredit_recordsFold π _ _ _ hrec
  · refine R.atomIn_vcCredit_recordsFold π _ _ (R.commitCut π ρ x, (ρ, x))
      (List.mem_filter.2 ⟨hrec, ?_⟩)
    have := R.sc_roundStart_succ π ρ
    simp only [commitCut]
    exact decide_eq_true (by omega)


theorem commit_fwd_block {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {i : Fin B} {k : ℕ}
    {te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))} (hk : (R.tr π i)[k]? = some te)
    (hkQ : k < R.Q) {q : Fin B × ℕ} (hq : q ∈ R.posSet)
    (hd : te.2 = .inl (R.xin π q.1 q.2)) {u : Fin B} (hu : ovBlock R.G q.1 q.2 = some u) :
    R.commitMatches π te.1 ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), .r (u, ovCalls R.G u)⟩ := by
  obtain ⟨hp1, hp⟩ := R.mem_posSet.1 hq
  obtain ⟨p, hpq⟩ : ∃ p, q.2 = p + 1 := ⟨q.2 - 1, by omega⟩
  have hb := hu
  rw [hpq] at hb
  unfold ovBlock at hb
  simp only [Nat.add_sub_cancel] at hb
  obtain ⟨hpi, hget⟩ := List.getElem?_eq_some_iff.1 hb
  have hovR : ovR (R.xin π q.1 q.2) = labelG R.G (fun x => π x) R.dom R.Wb u := by
    rw [hpq, Reach.ChainReplayR.xin_succ R π q.1 p (by omega), ovR_append,
      Reach.ChainReplayR.blks_getElem_parent R π q.1 p hpi, hget]
  unfold commitMatches obsR obsFoldKey
  simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKey]
  rw [hovR, R.label_eq_pad_r π u, PousB5Chain.bxor_cancel]

theorem commit_fwd_prev {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {i : Fin B} {k : ℕ}
    {te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))} (hk : (R.tr π i)[k]? = some te)
    (hkQ : k < R.Q) {q : Fin B × ℕ} (hq : q ∈ R.posSet)
    (hd : te.2 = .inl (R.xin π q.1 q.2)) (h2 : 2 ≤ q.2) :
    R.commitMatches π te.1 ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), .h (q.1, q.2 - 1)⟩ := by
  obtain ⟨hp1, hp⟩ := R.mem_posSet.1 hq
  have hovH : ovH (R.xin π q.1 q.2) = R.hVal π (q.1, q.2 - 1) := by
    have hxs := Reach.ChainReplayR.xin_succ R π q.1 (q.2 - 1) (by omega)
    rw [Nat.sub_add_cancel hp1] at hxs
    rw [hxs, ovH_append]
    have hs := Reach.ChainReplayR.chainH_succ R π q.1 (q.2 - 2) (by omega)
    have hsEq : q.2 - 2 + 1 = q.2 - 1 := by omega
    rw [hsEq] at hs
    simpa [hVal] using hs
  unfold commitMatches obsKeyH
  simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKeyH]
  rw [hovH]

theorem commit_inv {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {i : Fin B} {k : ℕ}
    {te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))} (hk : (R.tr π i)[k]? = some te)
    (hkQ : k < R.Q) {a : VAtom B}
    (hd : te.2 = .inr (π (R.xin π a.pair.1 a.pair.2))) :
    R.commitMatches π te.1 ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), a⟩ := by
  rcases a with ⟨q'⟩ | ⟨q'⟩
  · unfold commitMatches obsR
    by_cases hpad : q'.2 = ovCalls R.G q'.1
    · simp only [hpad, ↓reduceIte]
      unfold obsFoldKey
      simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKey]
      rfl
    · simp only [hpad, ↓reduceIte, hkQ]
      unfold obsKey
      simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKey]
      rfl
  · unfold commitMatches obsKeyH
    simp only [hkQ, ↓reduceIte, hk, Option.map_some, hd, qKeyH]
    rfl


set_option maxHeartbeats 2000000 in
/-- **Backing.** A transfer's partner is decided no earlier than the inverse step that transfers
to it. -/
theorem pinNext_step_le (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {cut τc : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcut : cut ≤ R.programSteps π) (hend : cut = R.roundStart π (τc + 1)) (hτc : τc ≤ R.D)
    {z b : VAtom B} (hz : R.atomValid z) (h : R.pinNext cut π z = some b) :
    R.pairStep cut π z.pair ≤ R.pairStep cut π b.pair := by
  classical
  obtain ⟨hf, hp, hk⟩ := R.pinNext_some h
  have hbv : R.atomValid b := R.pinPartner_target_valid hp
  by_contra hlt
  have hlt' : R.pairStep cut π b.pair + 1 ≤ R.pairStep cut π z.pair := by omega
  -- The transferring step is an adversary inverse query.
  have hs := R.pairStep_spec π hcut (R.atomValid_pair hz)
  obtain ⟨q, hq, -, hcase⟩ := (R.stratC cut).first_fix hs.2.1 hs.2.2
  have hinv : q = ⟨(), .inr (π (R.xin π z.pair.1 z.pair.2))⟩ := by
    rcases hcase with hcase | hcase
    · unfold pairForward at hf
      rw [hq, hcase] at hf
      simp at hf
    · exact hcase
  have hscut : R.pairStep cut π z.pair < cut := by
    by_contra hge
    have hlen := (R.stratC cut).length_hist_of_next hq
    have hle : cut ≤ ((R.stratC cut).hist (fun _ : Unit => π) (R.pairStep cut π z.pair)).length := by
      omega
    rw [R.stratC_next_tail hle] at hq
    obtain ⟨x, hx⟩ := R.labTail_inl hq
    rw [hinv] at hx
    simp at hx
  -- The partner's pair was fixed earlier, by a program query of some round `ρ`.
  have hbs := R.pairStep_spec π hcut (R.atomValid_pair hbv)
  set sb := R.pairStep cut π b.pair
  set s := R.pairStep cut π z.pair
  have hfix : R.xin π b.pair.1 b.pair.2 ∈
      ((R.stratC cut).hist (fun _ : Unit => π) (sb + 1)).dom () := hbs.2.2
  have hhist := R.sc_stratC_take_eq_advThenLab_hist π hcut (by omega : sb + 1 ≤ cut)
    (le_refl (sb + 1))
  rw [List.take_of_length_le ((R.stratC _).hist_length_le _ _)] at hhist
  rw [hhist] at hfix
  obtain ⟨e, he, hex⟩ := History.mem_dom.1 hfix
  obtain ⟨i, te, hte, hteρ, rfl⟩ :=
    R.advThenLab_hist_src_before hP π (by omega : sb + 1 ≤ R.programSteps π) he
  have hdir := qEntry_inpAt_eq hex
  obtain ⟨k, hk'⟩ : ∃ k, (R.tr π i)[k]? = some te := List.mem_iff_getElem?.1 hte
  obtain ⟨hkQ, hkb⟩ := R.mem_queryBasisAt_of_tr hP π hk'
  have hρτc : te.1 < τc + 1 := by
    by_contra hge
    have := R.sc_roundStart_mono π (Nat.le_of_not_lt hge)
    omega
  have hρD : te.1 ≤ R.D := by omega
  have hend' : R.roundStart π (te.1 + 1) ≤ cut := by
    rw [hend]
    exact R.sc_roundStart_mono π (by omega)
  have hstart : R.roundStart π te.1 ≤ cut := by
    have := R.sc_roundStart_mono π (Nat.le_succ te.1)
    omega
  -- Everything credited by round `ρ` is in the target closure at the transferring step.
  have htargets := R.targetsAll_vcCredit π ((R.stratC cut).hist (fun _ : Unit => π) s)
    (R.seedsAtCut π cut) te.1
    (R.revealed_dom_stratC hP π hcut hρD hstart (by omega))
  have hshown : ∀ x : VAtom B, R.atomValid x →
      R.commitMatches π te.1 ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), x⟩ →
      R.VCTarget π ((R.stratC cut).hist (fun _ : Unit => π) s) (R.seedsAtCut π cut)
        (DAtom.ofVAtom x) := by
    intro x hxv hm
    have hin := R.atomIn_vcCredit_cut hρD hend' (R.commit_mem_basisAt hkb hxv hm)
    rcases x with ⟨q'⟩ | ⟨q'⟩
    · exact htargets.2.1 q' hin
    · exact htargets.2.2 q' hin
  have hknown : R.VCTarget π ((R.stratC cut).hist (fun _ : Unit => π) s) (R.seedsAtCut π cut)
      (DAtom.ofVAtom b) := by
    rcases hdir with hd | hd
    · -- Forward: the partner's pair inputs were shown, and the pair is fixed before `s`.
      have hbq := R.atomValid_pair hbv
      obtain ⟨hp1, hpv⟩ := R.mem_posSet.1 hbq
      have hdomb : R.xin π b.pair.1 b.pair.2 ∈
          ((R.stratC cut).hist (fun _ : Unit => π) s).dom () :=
        (R.stratC cut).dom_mono _ hlt' () hbs.2.2
      have hblock : ∀ u, ovBlock R.G b.pair.1 b.pair.2 = some u →
          R.VCTarget π ((R.stratC cut).hist (fun _ : Unit => π) s) (R.seedsAtCut π cut)
            (.lab u) := by
        intro u hu
        have hupos : (u, ovCalls R.G u) ∈ R.posSet :=
          R.mem_posSet.2 ⟨by unfold ovCalls; omega, le_rfl⟩
        exact .padLabel (hshown (.r (u, ovCalls R.G u)) hupos
          (R.commit_fwd_block hk' hkQ hbq hd hu))
      have hprev : 2 ≤ b.pair.2 →
          R.VCTarget π ((R.stratC cut).hist (fun _ : Unit => π) s) (R.seedsAtCut π cut)
            (.h (b.pair.1, b.pair.2 - 1)) := by
        intro h2
        have hpp : (b.pair.1, b.pair.2 - 1) ∈ R.posSet :=
          R.mem_posSet.2 ⟨by omega, by change b.pair.2 - 1 ≤ ovCalls R.G b.pair.1; omega⟩
        exact hshown (.h (b.pair.1, b.pair.2 - 1)) hpp (R.commit_fwd_prev hk' hkQ hbq hd h2)
      rcases b with ⟨qb⟩ | ⟨qb⟩ <;> simp only [VAtom.pair] at hp1 hbq hdomb hblock hprev
      · by_cases h1 : qb.2 = 1
        · exact .forwardRFirst hbq h1 hdomb hblock
        · exact .forwardRPrev hbq (by omega) hdomb hblock (hprev (by omega))
      · by_cases h1 : qb.2 = 1
        · exact .forwardHFirst hbq h1 hdomb hblock
        · exact .forwardHPrev hbq (by omega) hdomb hblock (hprev (by omega))
    · -- Inverse: the partner itself was shown.
      exact hshown b hbv (R.commit_inv hk' hkQ hd)
  exact hk (Or.inl hknown)

theorem pinCell_step_ge (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {cut τc : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcut : cut ≤ R.programSteps π) (hend : cut = R.roundStart π (τc + 1)) (hτc : τc ≤ R.D) :
    ∀ {a : VAtom B}, R.atomValid a →
      R.pairStep cut π a.pair ≤ R.pairStep cut π (R.pinCell cut π a).pair := by
  intro a ha
  induction n : Birthday.posKey a.pair using Nat.strong_induction_on generalizing a with
  | _ n ih =>
      rw [pinCell]
      cases h : R.pinNext cut π a with
      | none => exact le_rfl
      | some b =>
          have hp := (R.pinNext_some h).2.1
          exact (R.pinNext_step_le hP hcut hend hτc ha h).trans
            (ih _ (n ▸ R.pinPartner_rank_lt hp) (R.pinPartner_target_valid hp) rfl)

/-- **`sourceRound ≤ chargeRound`.** The selected show's round starts no later than the approved
charge step, direct or transfer. -/
theorem v6_source_round_le_charge
    (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)
    (a : {a // a ∈ R.realizedSeeds s π}) :
    R.roundStart π (R.sourceCommitRound hP s π hcross a) ≤
      (R.chargePin (R.firstCrossing s π) π a.1).step := by
  obtain ⟨a', ha'⟩ := (R.sourceCommitExact hP s π hcross).hits_cut
  have hsrc := R.sourceCommitRound_spec hP s π hcross a'
  have hend : R.firstCrossing s π =
      R.roundStart π (R.sourceCommitRound hP s π hcross a' + 1) := by
    rw [← ha']
    unfold commitCut
    rw [R.sc_roundStart_succ]
  exact (R.v6_source_round_le_home_step hP s π hcross a).trans
    (R.pinCell_step_ge hP (R.firstCrossing_le s π hcross) hend hsrc.1
      (R.realized_atom_valid s π a.2))

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Names ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

set_option maxHeartbeats 2000000 in
/-- A basis commit's program slot is readable exactly from its commit cut on, provided that cut
is no later than the first crossing. -/
theorem basis_positionReady_iff
    (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)
    {τ : ℕ} {x : VCommit B R.Q} {o : Fin B × Fin (R.Q + 1)}
    (hτ : τ ≤ R.D) (hx : x ∈ R.basisAt π τ) (hpos : x.pos = .inl o)
    (hsourceCut : R.commitCut π τ x ≤ R.firstCrossing s π) (j : ℕ) :
    R.positionReady ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) j) o ↔
      R.commitCut π τ x ≤ j := by
  classical
  have hexact := R.programPosCut_eq_commitCut hx hpos
  have hfirstProg :
      R.firstCrossing s π ≤ R.programSteps π :=
    R.firstCrossing_le s π hcross
  constructor
  · intro hready
    by_cases hjcut : R.firstCrossing s π ≤ j
    · exact hsourceCut.trans hjcut
    · rcases hready with ⟨π', m, hmh, hmprog, hh, hpc'⟩
      have hmj : m ≤ j :=
        hmh.trans ((R.stratC (R.firstCrossing s π)).hist_length_le
          (fun _ : Unit => π) j)
      have hjle : j ≤ R.firstCrossing s π := by omega
      have htake := R.sc_stratC_take_eq_advThenLab_hist π
        hfirstProg hjle hmj
      have hhist :
          R.advThenLab.hist (fun _ : Unit => π) m =
            R.advThenLab.hist (fun _ : Unit => π') m :=
        (hh.trans htake).symm
      rcases hO : o with ⟨i, k⟩
      rw [hO] at hpos hpc'
      rcases R.sc_basis_program_pos_spec hx hpos with hq | hg
      · obtain ⟨hk, e, he, her⟩ := hq
        simp only [programPosCut, dite_eq_left hk] at hpc'
        cases he' : (R.tr π' i)[k.val]? with
        | none =>
            rw [he'] at hpc'
            change R.programSteps π' + 1 ≤ m at hpc'
            omega
        | some e' =>
            rw [he'] at hpc'
            change R.roundStart π' (e'.1 + 1) ≤ m at hpc'
            have he'mem : e' ∈ R.tr π' i := List.mem_of_getElem? he'
            have herD : e'.1 < R.D :=
              (PousB5Chain.round_lt_depth
                ((idealPerm (ℓ + (ℓ + c))).answer π')
                (R.P i) e' he'mem).trans_le (hP i π').1
            have hag := R.sc_agreeBefore_of_hist hP π' π
              (τ := e'.1) (by omega)
              ((R.sc_roundStart_mono π' (by omega)).trans hpc')
              hmprog hhist i
            have hstable := PousB5Chain.trace_stable
              ((idealPerm (ℓ + (ℓ + c))).answer π')
              ((idealPerm (ℓ + (ℓ + c))).answer π)
              (R.P i) e'.1 hag
            have heActual := hstable.1 k.val e' he' le_rfl
            have heq : e = e' := by
              change (R.tr π i)[k.val]? = some e' at heActual
              rw [he] at heActual
              exact Option.some.inj heActual
            have hr' : e'.1 =
                τ := by
              rw [← heq]
              exact her
            have hre := R.sc_roundEnd_eq_of_hist hP π' π
              (τ := e'.1) (by omega) hpc' hmprog hhist
            have hend :
                R.roundStart π
                    (τ + 1) ≤ m := by
              rw [← hr', hre]
              exact hpc'
            rw [← hexact, hO]
            simpa [programPosCut, hk, he, her] using hend.trans hmj
      · obtain ⟨hkQ, hd⟩ := hg
        have hn : ¬ k.val < R.Q := by omega
        simp only [programPosCut, dite_eq_right hn] at hpc'
        let d' :=
          (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π')
        have hd'D : d' ≤ R.D := (hP i π').1
        have hag := R.sc_agreeBefore_of_hist hP π' π
          (τ := d') hd'D
          ((R.sc_roundStart_mono π' (by omega)).trans hpc')
          hmprog hhist i
        have hrun := PousB5Chain.run_stable
          ((idealPerm (ℓ + (ℓ + c))).answer π')
          ((idealPerm (ℓ + (ℓ + c))).answer π)
          (R.P i) d' hag le_rfl
        have hdEq : d' = τ := by
          have hdepth :
              (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π) = d' :=
            hrun.2
          omega
        have hre := R.sc_roundEnd_eq_of_hist hP π' π
          (τ := d') hd'D hpc' hmprog hhist
        have hend :
            R.roundStart π
                (τ + 1) ≤ m := by
          rw [← hdEq, hre]
          exact hpc'
        rw [← hexact, hO]
        simpa [programPosCut, hn, hd] using hend.trans hmj
  · intro hdj
    let d := R.commitCut π (τ)
      (x)
    have hdcut : d ≤ R.firstCrossing s π := hsourceCut
    have hdprog : d ≤ R.programSteps π := by
      exact R.commitCut_le_programSteps hP π hτ hx
    have hpref := R.sc_advThenLab_hist_eq_stratC_take π
      hfirstProg hdcut (by simpa [d] using hdj)
    have hlen :
        (R.advThenLab.hist (fun _ : Unit => π) d).length = d := by
      unfold advThenLab
      rw [Strategy.ofRounds_hist _ _ _ _ _ _ _ d (by
          simpa [programSteps] using hdprog),
        List.length_map, List.length_take, min_eq_left]
      simpa [programSteps] using hdprog
    have htakeLen := congrArg List.length hpref
    rw [hlen, List.length_take] at htakeLen
    have hdhist :
        d ≤ ((R.stratC (R.firstCrossing s π)).hist
          (fun _ : Unit => π) j).length := by omega
    refine ⟨π, d, hdhist, hdprog, hpref, ?_⟩
    simpa [d] using Nat.le_of_eq hexact

open Classical in
/-- The end of the program round containing adversary step `t` (past the schedule if none). -/
noncomputable def stepRoundEnd (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (t : ℕ) : ℕ :=
  if h : ∃ τ, t < R.roundStart π (τ + 1) then R.roundStart π (Nat.find h + 1)
  else R.programSteps π + 1

/-- An adversary-step name is readable once its step's round has ended. -/
def stepReady (h : History (BandAlpha ℓ c)) (t : ℕ) : Prop :=
  ∃ (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (j : ℕ), j ≤ h.length ∧
    j ≤ R.programSteps π ∧
    R.advThenLab.hist (fun _ : Unit => π) j = h.take j ∧
    R.stepRoundEnd π t ≤ j

theorem stepRoundEnd_spec {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {t τ : ℕ}
    (ht : t < R.roundStart π (τ + 1)) :
    ∃ τ' ≤ τ, t < R.roundStart π (τ' + 1) ∧ R.stepRoundEnd π t = R.roundStart π (τ' + 1) := by
  classical
  have hex : ∃ τ, t < R.roundStart π (τ + 1) := ⟨τ, ht⟩
  refine ⟨Nat.find hex, Nat.find_min' hex ht, Nat.find_spec hex, ?_⟩
  unfold stepRoundEnd
  rw [dif_pos hex]

theorem stepRoundEnd_le {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {t σ : ℕ}
    (ht : t < R.roundStart π (σ + 1)) : R.stepRoundEnd π t ≤ R.roundStart π (σ + 1) := by
  classical
  have hex : ∃ τ, t < R.roundStart π (τ + 1) := ⟨σ, ht⟩
  unfold stepRoundEnd
  rw [dif_pos hex]
  exact R.sc_roundStart_mono π (Nat.succ_le_succ (Nat.find_min' hex ht))

theorem advThenLab_hist_length (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {d : ℕ}
    (hd : d ≤ R.programSteps π) :
    (R.advThenLab.hist (fun _ : Unit => π) d).length = d := by
  unfold advThenLab
  rw [Strategy.ofRounds_hist _ _ _ _ _ _ _ d (by simpa [programSteps] using hd),
    List.length_map, List.length_take, min_eq_left]
  simpa [programSteps] using hd

set_option maxHeartbeats 2000000 in
/-- An adversary step before the cut is readable exactly from the end of its round. -/
theorem stepReady_iff (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {cut τc : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcut : cut ≤ R.programSteps π) (hend : cut = R.roundStart π (τc + 1)) (hτc : τc ≤ R.D)
    {t : ℕ} (ht : t < cut) (j : ℕ) :
    R.stepReady ((R.stratC cut).hist (fun _ : Unit => π) j) t ↔ R.stepRoundEnd π t ≤ j := by
  classical
  obtain ⟨τ, hττc, htτ, hre⟩ := R.stepRoundEnd_spec (τ := τc) (by rw [← hend]; exact ht)
  have hrecut : R.stepRoundEnd π t ≤ cut := by
    rw [hre, hend]
    exact R.sc_roundStart_mono π (by omega)
  constructor
  · rintro ⟨π', j', hj'len, hj'prog, hpref, hre'⟩
    by_cases hjcut : cut ≤ j
    · omega
    have hj'j : j' ≤ j := hj'len.trans ((R.stratC cut).hist_length_le _ j)
    have hπ : R.advThenLab.hist (fun _ : Unit => π) j' =
        ((R.stratC cut).hist (fun _ : Unit => π) j).take j' :=
      R.sc_advThenLab_hist_eq_stratC_take π hcut (by omega) hj'j
    have hh : R.advThenLab.hist (fun _ : Unit => π) j' =
        R.advThenLab.hist (fun _ : Unit => π') j' := hπ.trans hpref.symm
    -- In `π'`, step `t` lies in a round ending by `j'`; round ends agree with `π`.
    have hex' : ∃ τ, t < R.roundStart π' (τ + 1) := by
      by_contra hno
      unfold stepRoundEnd at hre'
      rw [dif_neg hno] at hre'
      omega
    have hD1 : t < R.roundStart π' R.D := by
      have hsp := R.programSteps_eq_roundStart_D hP π'
      have hlt : t < R.stepRoundEnd π' t := by
        obtain ⟨τ', -, h1, h2⟩ := R.stepRoundEnd_spec (π := π') (Nat.find_spec hex')
        omega
      omega
    obtain ⟨τ', hτ'le, htτ', hre'eq⟩ := R.stepRoundEnd_spec (π := π') (τ := R.D - 1) (by
      have : R.D - 1 + 1 = R.D := by
        rcases Nat.eq_zero_or_pos R.D with h0 | h0
        · rw [h0] at hD1
          simp [roundStart] at hD1
        · omega
      rw [this]
      exact hD1)
    have hτ'D : τ' ≤ R.D := by omega
    have heq := R.sc_roundEnd_eq_of_hist hP π' π hτ'D (by rw [← hre'eq]; exact hre') hj'prog hh
    calc
      R.stepRoundEnd π t ≤ R.roundStart π (τ' + 1) := R.stepRoundEnd_le (by rw [heq]; exact htτ')
      _ = R.roundStart π' (τ' + 1) := heq
      _ = R.stepRoundEnd π' t := hre'eq.symm
      _ ≤ j' := hre'
      _ ≤ j := hj'j
  · intro hdj
    let d := R.stepRoundEnd π t
    have hdprog : d ≤ R.programSteps π := hrecut.trans hcut
    have hdj' : d ≤ j := hdj
    have hpref := R.sc_advThenLab_hist_eq_stratC_take π hcut hrecut hdj'
    have htakeLen := congrArg List.length hpref
    rw [R.advThenLab_hist_length π hdprog, List.length_take] at htakeLen
    have hdhist : d ≤ ((R.stratC cut).hist (fun _ : Unit => π) j).length := by omega
    exact ⟨π, d, hdhist, hdprog, hpref, le_rfl⟩

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6SlotDet ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

theorem getElem?_filter_le_of_sorted {α : Type} (f : α → ℕ) (τ : ℕ) :
    ∀ {l : List α}, l.Pairwise (fun a b => f a ≤ f b) →
      ∀ {k : ℕ} {x : α}, l[k]? = some x → f x ≤ τ →
        (l.filter fun e => decide (f e ≤ τ))[k]? = some x
  | [], _, _, _, h, _ => by simp at h
  | a :: l, hl, k, x, h, hx => by
      rw [List.pairwise_cons] at hl
      cases k with
      | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at h
          subst h
          simp [List.filter_cons, hx]
      | succ k =>
          simp only [List.getElem?_cons_succ] at h
          have hax : f a ≤ τ := (hl.1 x (List.mem_of_getElem? h)).trans hx
          simp only [List.filter_cons, hax, decide_true, ↓reduceIte, List.getElem?_cons_succ]
          exact getElem?_filter_le_of_sorted f τ hl.2 h hx

theorem getElem?_of_filter_le_of_sorted {α : Type} (f : α → ℕ) (τ : ℕ) :
    ∀ {l : List α}, l.Pairwise (fun a b => f a ≤ f b) →
      ∀ {k : ℕ} {x : α}, (l.filter fun e => decide (f e ≤ τ))[k]? = some x → l[k]? = some x
  | [], _, _, _, h => by simp at h
  | a :: l, hl, k, x, h => by
      rw [List.pairwise_cons] at hl
      by_cases ha : f a ≤ τ
      · simp only [List.filter_cons, ha, decide_true, ↓reduceIte] at h
        cases k with
        | zero => simpa using h
        | succ k =>
            simp only [List.getElem?_cons_succ] at h ⊢
            exact getElem?_of_filter_le_of_sorted f τ hl.2 h
      · have hnil : (l.filter fun e => decide (f e ≤ τ)) = [] := by
          rw [List.filter_eq_nil_iff]
          intro b hb
          have := hl.1 b hb
          simp only [decide_eq_true_eq]
          omega
        simp only [List.filter_cons, ha, decide_false, Bool.false_eq_true, ↓reduceIte,
          hnil] at h
        simp at h

theorem tr_pairwise_round (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) :
    (R.tr π i).Pairwise (fun a b => a.1 ≤ b.1) := by
  have h := rtrace_pairwise (bandAnswer π) (toRProgI (R.P i))
  rwa [R.advTrace_eq] at h

/-- **Slot determinism.** A transcript entry of round `≤ τ` is the same under any oracle whose
program-prefix history agrees through the start of round `τ`. -/
theorem v6_slot_query_det (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π₀ π₁ : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {m τ : ℕ}
    (hτ : τ ≤ R.D) (hstart : R.roundStart π₀ τ ≤ m) (hm : m ≤ R.programSteps π₀)
    (hh : R.advThenLab.hist (fun _ : Unit => π₁) m =
      R.advThenLab.hist (fun _ : Unit => π₀) m)
    {i : Fin B} {k : ℕ} {te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))}
    (hk : (R.tr π₀ i)[k]? = some te) (hte : te.1 ≤ τ) :
    (R.tr π₁ i)[k]? = some te := by
  have hA := R.sc_agreeBefore_of_hist hP π₀ π₁ hτ hstart hm hh i
  have hF := LazyPerm.RProg.trace_le_congr (bandAnswer π₀) (bandAnswer π₁)
    (toRProgI (R.P i)) τ (by
      rw [R.advTrace_eq]
      intro e he her
      rw [bandAnswer_eq, bandAnswer_eq]
      exact hA e he her)
  rw [R.advTrace_eq, R.advTrace_eq] at hF
  have h1 := getElem?_filter_le_of_sorted Prod.fst τ (R.tr_pairwise_round π₀ i) hk hte
  rw [hF] at h1
  exact getElem?_of_filter_le_of_sorted Prod.fst τ (R.tr_pairwise_round π₁ i) h1

/-- **Output determinism.** A thread whose depth is at most `τ` returns the same output at the
same depth under any oracle agreeing through the start of round `τ`. -/
theorem v6_slot_output_det (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π₀ π₁ : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {m τ : ℕ}
    (hτ : τ ≤ R.D) (hstart : R.roundStart π₀ τ ≤ m) (hm : m ≤ R.programSteps π₀)
    (hh : R.advThenLab.hist (fun _ : Unit => π₁) m =
      R.advThenLab.hist (fun _ : Unit => π₀) m)
    (i : Fin B) (hd : (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π₀) ≤ τ) :
    (R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π₁) =
        (R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π₀) ∧
      (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π₁) =
        (R.P i).depth ((idealPerm (ℓ + (ℓ + c))).answer π₀) :=
  PousB5Chain.run_stable _ _ (R.P i) τ (R.sc_agreeBefore_of_hist hP π₀ π₁ hτ hstart hm hh i) hd


end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Target ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

def HistCons (R : ChainReplay B ℓ c) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (h : History (BandAlpha ℓ c)) : Prop :=
  ∀ e ∈ h, e.2 = ans (fun _ : Unit => π) e.1

def DAgree (π π' : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : DAtom B → Prop
  | .lab v =>
      labelG R.G (fun x => π x) R.dom R.Wb v =
        labelG R.G (fun x => π' x) R.dom R.Wb v
  | .r q => R.rVal π q = R.rVal π' q
  | .h q => R.hVal π q = R.hVal π' q

theorem append_ovR_ovH_v6 (x : Bits (ℓ + (ℓ + c))) :
    Fin.append (ovR x) (ovH x) = x := by
  funext j
  refine Fin.addCases (fun i => ?_) (fun i => ?_) j
  · rw [Fin.append_left]; rfl
  · rw [Fin.append_right]; rfl


def pinR (c : ℕ) (r₀ : Bits ℓ) : Finset (Bits (ℓ + (ℓ + c))) :=
  Finset.univ.filter fun y => ovR y = r₀

def pinH (ℓ : ℕ) (h₀ : Bits (ℓ + c)) : Finset (Bits (ℓ + (ℓ + c))) :=
  Finset.univ.filter fun y => ovH y = h₀

def pinRH (c : ℕ) (r₀ : Bits ℓ) (h₀ : Bits (ℓ + c)) : Finset (Bits (ℓ + (ℓ + c))) :=
  Finset.univ.filter fun y => ovR y = r₀ ∧ ovH y = h₀

def pinREquiv (c : ℕ) (r₀ : Bits ℓ) : {y : Bits (ℓ + (ℓ + c)) // ovR y = r₀} ≃ Bits (ℓ + c) where
  toFun y := @ovH ℓ c y
  invFun h := ⟨Fin.append r₀ h, ovR_append _ _⟩
  left_inv y := by
    apply Subtype.ext
    change Fin.append r₀ (@ovH ℓ c y.1) = y.1
    calc
      _ = Fin.append (@ovR ℓ c y.1) (@ovH ℓ c y.1) := by rw [y.2]
      _ = y.1 := append_ovR_ovH_v6 y.1
  right_inv h := @ovH_append ℓ c r₀ h

def pinHEquiv (ℓ : ℕ) (h₀ : Bits (ℓ + c)) : {y : Bits (ℓ + (ℓ + c)) // ovH y = h₀} ≃ Bits ℓ where
  toFun y := @ovR ℓ c y
  invFun r := ⟨Fin.append r h₀, ovH_append _ _⟩
  left_inv y := by
    apply Subtype.ext
    change Fin.append (@ovR ℓ c y.1) h₀ = y.1
    calc
      _ = Fin.append (@ovR ℓ c y.1) (@ovH ℓ c y.1) := by rw [y.2]
      _ = y.1 := append_ovR_ovH_v6 y.1
  right_inv r := @ovR_append ℓ c r h₀

theorem card_pinR (r₀ : Bits ℓ) : (pinR c r₀).card = 2 ^ (ℓ + c) := by
  rw [show (pinR c r₀).card = Fintype.card {y : Bits (ℓ + (ℓ + c)) // ovR y = r₀} by
    rw [Fintype.card_subtype]; rfl]
  rw [Fintype.card_congr (pinREquiv c r₀)]
  simp [Bits]

theorem card_pinH (h₀ : Bits (ℓ + c)) : (pinH ℓ h₀).card = 2 ^ ℓ := by
  rw [show (pinH ℓ h₀).card = Fintype.card {y : Bits (ℓ + (ℓ + c)) // ovH y = h₀} by
    rw [Fintype.card_subtype]; rfl]
  rw [Fintype.card_congr (pinHEquiv ℓ h₀)]
  simp [Bits]

theorem card_pinRH (r₀ : Bits ℓ) (h₀ : Bits (ℓ + c)) :
    (pinRH c r₀ h₀).card = 1 := by
  classical
  have heq : pinRH c r₀ h₀ = {Fin.append r₀ h₀} := by
    ext y
    simp only [pinRH, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton]
    constructor
    · intro h
      rw [← append_ovR_ovH_v6 y, h.1, h.2]
    · rintro rfl
      exact ⟨ovR_append _ _, ovH_append _ _⟩
  rw [heq, Finset.card_singleton]

def slotWidth (parts : Finset V6Part) : ℕ :=
  (if .r ∈ parts then ℓ else 0) + (if .h ∈ parts then ℓ + c else 0)

def slotTarget
    (vr : History (BandAlpha ℓ c) → Qry (BandAlpha ℓ c) → Bits ℓ)
    (vh : History (BandAlpha ℓ c) → Qry (BandAlpha ℓ c) → Bits (ℓ + c))
    (parts : Finset V6Part) (hist : History (BandAlpha ℓ c))
    (q : Qry (BandAlpha ℓ c)) : Finset (Bits (ℓ + (ℓ + c))) :=
  Finset.univ.filter fun y =>
    (.r ∈ parts → ovR y = vr hist q) ∧
    (.h ∈ parts → ovH y = vh hist q)

theorem slotWidth_le (parts : Finset V6Part) :
    slotWidth (ℓ := ℓ) (c := c) parts ≤ ℓ + (ℓ + c) := by
  unfold slotWidth
  split_ifs <;> omega

theorem card_slotTarget_le
    (vr : History (BandAlpha ℓ c) → Qry (BandAlpha ℓ c) → Bits ℓ)
    (vh : History (BandAlpha ℓ c) → Qry (BandAlpha ℓ c) → Bits (ℓ + c))
    (parts : Finset V6Part) (hist : History (BandAlpha ℓ c))
    (q : Qry (BandAlpha ℓ c)) :
    (slotTarget vr vh parts hist q).card ≤
      2 ^ ((ℓ + (ℓ + c)) - slotWidth (ℓ := ℓ) (c := c) parts) := by
  classical
  by_cases hr : .r ∈ parts <;> by_cases hh : .h ∈ parts
  · have heq : slotTarget vr vh parts hist q = pinRH c (vr hist q) (vh hist q) := by
      ext y
      simp [slotTarget, pinRH, hr, hh]
    rw [heq, card_pinRH]
    simp [slotWidth, hr, hh]
  · have heq : slotTarget vr vh parts hist q = pinR c (vr hist q) := by
      ext y
      simp [slotTarget, pinR, hr, hh]
    rw [heq, card_pinR]
    simp [slotWidth, hr, hh]
  · have heq : slotTarget vr vh parts hist q = pinH ℓ (vh hist q) := by
      ext y
      simp [slotTarget, pinH, hr, hh]
    rw [heq, card_pinH]
    simp [slotWidth, hr, hh]
  · have heq : slotTarget vr vh parts hist q = Finset.univ := by
      ext y
      simp [slotTarget, hr, hh]
    rw [heq]
    simp [slotWidth, hr, hh, Bits]

theorem v6_slot_target_le
    (vr : History (BandAlpha ℓ c) → Qry (BandAlpha ℓ c) → Bits ℓ)
    (vh : History (BandAlpha ℓ c) → Qry (BandAlpha ℓ c) → Bits (ℓ + c))
    (parts : Finset V6Part) (hist : History (BandAlpha ℓ c))
    (q : Qry (BandAlpha ℓ c)) (nP : ℕ) :
    (slotTarget vr vh parts hist q).card *
        (2 ^ slotWidth (ℓ := ℓ) (c := c) parts - nP) ≤
      Fintype.card (Bits (ℓ + (ℓ + c))) - nP := by
  rw [show Fintype.card (Bits (ℓ + (ℓ + c))) = 2 ^ (ℓ + (ℓ + c)) by simp [Bits]]
  exact LazyPerm.pin_target_le (slotWidth_le parts) (card_slotTarget_le vr vh parts hist q)

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6StopHits ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace LazyPerm

open scoped ENNReal

variable {ι : Type} [Fintype ι] [DecidableEq ι] {α : ι → Type} [∀ i, Fintype (α i)]
  [∀ i, DecidableEq (α i)]

namespace Strategy

variable (S : Strategy α)

/-- Step `n` hits the target of whichever item the history before it assigns. -/
def HitAt {K : Type} (A : ℕ → History α → Option K)
    (T : K → History α → (q : Qry α) → Finset (α q.1)) (n : ℕ) (π : Oracle α) : Prop :=
  ∀ k, A n (S.hist π n) = some k → S.Hit (T k) n π

/-- Items assigned before step `n`. -/
def assignedBefore {K : Type} [DecidableEq K] (P : Finset K) (A : ℕ → History α → Option K)
    (n : ℕ) (π : Oracle α) : Finset K :=
  P.filter fun k => ∃ m < n, A m (S.hist π m) = some k

theorem assignedBefore_congr {K : Type} [DecidableEq K] (P : Finset K) (A : ℕ → History α → Option K)
    {n : ℕ} {π π' : Oracle α} (h : S.hist π n = S.hist π' n) :
    S.assignedBefore P A n π = S.assignedBefore P A n π' := by
  unfold assignedBefore
  refine Finset.filter_congr fun k _ => ?_
  constructor
  · rintro ⟨m, hm, hk⟩
    exact ⟨m, hm, by rw [S.hist_eq_of_le h.symm hm.le]; exact hk⟩
  · rintro ⟨m, hm, hk⟩
    exact ⟨m, hm, by rw [S.hist_eq_of_le h hm.le]; exact hk⟩

theorem hitsAt_congr {K : Type} (A : ℕ → History α → Option K)
    (T : K → History α → (q : Qry α) → Finset (α q.1)) {n : ℕ} {π π' : Oracle α}
    (h : S.hist π n = S.hist π' n) :
    (∀ m < n, S.HitAt A T m π) → ∀ m < n, S.HitAt A T m π' := by
  intro hπ m hm k hk
  have hmh := S.hist_eq_of_le h.symm hm.le
  rw [hmh] at hk
  exact (S.hit_congr (T k) hm h).1 (hπ m hm k hk)


end Strategy

end LazyPerm

end


/-! ════ ChainEPFV6StopHitsW ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace LazyPerm

open scoped ENNReal

variable {ι : Type} [Fintype ι] [DecidableEq ι] {α : ι → Type} [∀ i, Fintype (α i)]
  [∀ i, DecidableEq (α i)]

namespace Strategy

variable (S : Strategy α)

open Classical in
/-- The step of a run at which item `k` is assigned (`0` if it never is). -/
noncomputable def assignStep {K : Type} (A : ℕ → History α → Option K) (k : K) (π : Oracle α) :
    ℕ :=
  if h : ∃ m, A m (S.hist π m) = some k then Nat.find h else 0

theorem assignStep_eq {K : Type} {A : ℕ → History α → Option K}
    (huniq : ∀ π k m n, A m (S.hist π m) = some k → A n (S.hist π n) = some k → m = n)
    {k : K} {π : Oracle α} {m : ℕ} (h : A m (S.hist π m) = some k) : S.assignStep A k π = m := by
  classical
  have hex : ∃ m, A m (S.hist π m) = some k := ⟨m, h⟩
  unfold assignStep
  rw [dif_pos hex]
  exact huniq π k _ _ (Nat.find_spec hex) h

open Classical in
/-- **The weighted product bound**: each item pays the weight of the history at its own step. -/
theorem card_hitsAt_hist_le {K : Type} [DecidableEq K] (P : Finset K)
    (A : ℕ → History α → Option K) (T : K → History α → (q : Qry α) → Finset (α q.1))
    (a : K → ℕ) (b : K → History α → ℕ) (N : ℕ)
    (hA : ∀ n h k, A n h = some k → k ∈ P)
    (huniq : ∀ π k m n, A m (S.hist π m) = some k → A n (S.hist π n) = some k → m = n)
    (hT : ∀ k ∈ P, ∀ n < N, ∀ h q,
      (T k h q).card * b k h ≤ a k * (Fintype.card (α q.1) - n)) :
    ∑ π ∈ Finset.univ.filter (fun π => (∀ n < N, S.HitAt A T n π) ∧
        ∀ k ∈ P, ∃ n < N, A n (S.hist π n) = some k),
      ∏ k ∈ P, b k (S.hist π (S.assignStep A k π))
      ≤ (∏ k ∈ P, a k) * Fintype.card (Oracle α) := by
  let D := S.assignedBefore P A
  let bw : K → Oracle α → ℕ := fun k π => b k (S.hist π (S.assignStep A k π))
  let w : ℕ → Oracle α → ℕ := fun n π => (∏ k ∈ D n π, bw k π) * ∏ k ∈ P \ D n π, a k
  let G : ℕ → Finset (Oracle α) := fun n =>
    Finset.univ.filter fun π => ∀ m < n, S.HitAt A T m π
  have hD0 : ∀ π, D 0 π = ∅ := fun π => by
    simp [D, assignedBefore]
  have hstep : ∀ n < N, ∑ π ∈ G (n + 1), w (n + 1) π ≤ ∑ π ∈ G n, w n π := by
    intro n hnN
    let t := Finset.univ.image fun π => S.hist π n
    rw [← Finset.sum_fiberwise_of_maps_to (s := G (n + 1)) (t := t)
        (g := fun π => S.hist π n) (fun π _ => Finset.mem_image_of_mem _ (Finset.mem_univ _)),
      ← Finset.sum_fiberwise_of_maps_to (s := G n) (t := t)
        (g := fun π => S.hist π n) (fun π _ => Finset.mem_image_of_mem _ (Finset.mem_univ _))]
    refine Finset.sum_le_sum fun h _ => ?_
    have hDfib : ∀ π, S.hist π n = h → ∀ π', S.hist π' n = h → D n π = D n π' :=
      fun π hπ π' hπ' => S.assignedBefore_congr P A (hπ.trans hπ'.symm)
    have hbwfib : ∀ π, S.hist π n = h → ∀ π', S.hist π' n = h →
        ∀ k' ∈ D n π, bw k' π = bw k' π' := by
      intro π hπ π' hπ' k' hk'
      obtain ⟨-, m, hm, hmk⟩ := Finset.mem_filter.1 hk'
      have hhm : S.hist π' m = S.hist π m := S.hist_eq_of_le (hπ'.trans hπ.symm) hm.le
      have hmk' : A m (S.hist π' m) = some k' := by rw [hhm]; exact hmk
      simp only [bw, S.assignStep_eq huniq hmk, S.assignStep_eq huniq hmk', hhm]
    cases hAh : A n h with
    | none =>
        have hG : (G (n + 1)).filter (fun π => S.hist π n = h) =
            (G n).filter (fun π => S.hist π n = h) := by
          ext π
          simp only [G, Finset.mem_filter, Finset.mem_univ, true_and]
          constructor
          · rintro ⟨hπ, rfl⟩
            exact ⟨fun m hm => hπ m (by omega), rfl⟩
          · rintro ⟨hπ, rfl⟩
            refine ⟨fun m hm => ?_, rfl⟩
            rcases Nat.lt_succ_iff_lt_or_eq.1 hm with hm | rfl
            · exact hπ m hm
            · intro k hk
              rw [hAh] at hk
              exact absurd hk (by simp)
        rw [hG]
        refine Finset.sum_le_sum fun π hπ => ?_
        have hπh := (Finset.mem_filter.1 hπ).2
        have hD : D (n + 1) π = D n π := by
          simp only [D, assignedBefore]
          refine Finset.filter_congr fun k _ => ⟨?_, ?_⟩
          · rintro ⟨m, hm, hk⟩
            rcases Nat.lt_succ_iff_lt_or_eq.1 hm with hm | rfl
            · exact ⟨m, hm, hk⟩
            · rw [hπh, hAh] at hk
              exact absurd hk (by simp)
          · rintro ⟨m, hm, hk⟩
            exact ⟨m, by omega, hk⟩
        simp only [w, hD, le_refl]
    | some k =>
        have hkP : k ∈ P := hA n h k hAh
        let F : Oracle α → Prop := fun π => ∀ m < n, S.HitAt A T m π
        have hF : ∀ π π', S.hist π n = S.hist π' n → F π → F π' :=
          fun π π' h hπ => S.hitsAt_congr A T h hπ
        let T' : History α → (q : Qry α) → Finset (α q.1) :=
          fun h' q => if h' = h then T k h' q else ∅
        have hT' : ∀ h' q, (T' h' q).card * b k h ≤ a k * (Fintype.card (α q.1) - n) := by
          intro h' q
          by_cases hh : h' = h
          · subst hh
            simp only [T', if_pos rfl]
            exact hT k hkP n hnN h' q
          · simp [T', hh]
        have hfib := S.card_step_fiber n F hF T' (a k) (b k h) hT' h
        have hHit : Finset.univ.filter (fun π => (F π ∧ S.Hit (T k) n π) ∧ S.hist π n = h) =
            Finset.univ.filter (fun π => (F π ∧ S.Hit T' n π) ∧ S.hist π n = h) := by
          refine Finset.filter_congr fun π _ => ?_
          constructor
          · rintro ⟨⟨hFπ, q, hq, hfr, hmem⟩, hπh⟩
            refine ⟨⟨hFπ, q, hq, hfr, ?_⟩, hπh⟩
            simp only [T', if_pos hπh]
            exact hmem
          · rintro ⟨⟨hFπ, q, hq, hfr, hmem⟩, hπh⟩
            refine ⟨⟨hFπ, q, hq, hfr, ?_⟩, hπh⟩
            simpa only [T', if_pos hπh] using hmem
        have hG1 : (G (n + 1)).filter (fun π => S.hist π n = h) =
            Finset.univ.filter (fun π => (F π ∧ S.Hit (T k) n π) ∧ S.hist π n = h) := by
          ext π
          simp only [G, F, Finset.mem_filter, Finset.mem_univ, true_and]
          constructor
          · rintro ⟨hπ, rfl⟩
            exact ⟨⟨fun m hm => hπ m (by omega), hπ n (Nat.lt_succ_self n) k hAh⟩, rfl⟩
          · rintro ⟨⟨hπ, hhit⟩, rfl⟩
            refine ⟨fun m hm => ?_, rfl⟩
            rcases Nat.lt_succ_iff_lt_or_eq.1 hm with hm | rfl
            · exact hπ m hm
            · intro k' hk'
              rw [hAh] at hk'
              obtain rfl := Option.some.inj hk'
              exact hhit
        have hG0 : (G n).filter (fun π => S.hist π n = h) =
            Finset.univ.filter (fun π => F π ∧ S.hist π n = h) := by
          ext π
          simp only [G, F, Finset.mem_filter, Finset.mem_univ, true_and]
        rw [hG1, hG0]
        have hknot : ∀ π, S.hist π n = h → k ∉ D n π := by
          intro π hπ hk
          obtain ⟨-, m, hm, hmk⟩ := Finset.mem_filter.1 hk
          have hnk : A n (S.hist π n) = some k := by rw [hπ]; exact hAh
          have := huniq π k m n hmk hnk
          omega
        have hDsucc : ∀ π, S.hist π n = h → D (n + 1) π = insert k (D n π) := by
          intro π hπ
          ext k'
          simp only [D, assignedBefore, Finset.mem_filter, Finset.mem_insert]
          constructor
          · rintro ⟨hk'P, m, hm, hk'⟩
            rcases Nat.lt_succ_iff_lt_or_eq.1 hm with hm | rfl
            · exact Or.inr ⟨hk'P, m, hm, hk'⟩
            · rw [hπ, hAh] at hk'
              exact Or.inl (Option.some.inj hk').symm
          · rintro (rfl | ⟨hk'P, m, hm, hk'⟩)
            · exact ⟨hkP, n, Nat.lt_succ_self n, by rw [hπ]; exact hAh⟩
            · exact ⟨hk'P, m, by omega, hk'⟩
        have hbwk : ∀ π, S.hist π n = h → bw k π = b k h := by
          intro π hπ
          have hnk : A n (S.hist π n) = some k := by rw [hπ]; exact hAh
          simp only [bw, S.assignStep_eq huniq hnk, hπ]
        let cf : Oracle α → ℕ := fun π =>
          (∏ k' ∈ D n π, bw k' π) * ∏ k' ∈ (P \ D n π).erase k, a k'
        have hw0 : ∀ π, S.hist π n = h → w n π = cf π * a k := by
          intro π hπ
          have hkm : k ∈ P \ D n π := Finset.mem_sdiff.2 ⟨hkP, hknot π hπ⟩
          simp only [w, cf]
          rw [← Finset.mul_prod_erase _ _ hkm]
          ring
        have hw1 : ∀ π, S.hist π n = h → w (n + 1) π = cf π * b k h := by
          intro π hπ
          simp only [w, cf]
          rw [hDsucc π hπ, Finset.prod_insert (hknot π hπ), hbwk π hπ]
          have hsd : P \ insert k (D n π) = (P \ D n π).erase k := by
            ext k'
            simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_erase]
            tauto
          rw [hsd]
          ring
        by_cases hne : (Finset.univ.filter (fun π => F π ∧ S.hist π n = h)).Nonempty
        · obtain ⟨π₀, hπ₀⟩ := hne
          have hπ₀h := (Finset.mem_filter.1 hπ₀).2.2
          have hc : ∀ π, S.hist π n = h → cf π = cf π₀ := by
            intro π hπ
            simp only [cf]
            rw [hDfib π hπ π₀ hπ₀h]
            congr 1
            refine Finset.prod_congr rfl fun k' hk' => ?_
            rw [← hDfib π hπ π₀ hπ₀h] at hk'
            exact hbwfib π hπ π₀ hπ₀h k' hk'
          calc
            ∑ π ∈ Finset.univ.filter (fun π => (F π ∧ S.Hit (T k) n π) ∧ S.hist π n = h),
                w (n + 1) π
                = ∑ π ∈ Finset.univ.filter (fun π => (F π ∧ S.Hit (T k) n π) ∧ S.hist π n = h),
                    cf π₀ * b k h := by
                  refine Finset.sum_congr rfl fun π hπ => ?_
                  have hπh := (Finset.mem_filter.1 hπ).2.2
                  rw [hw1 π hπh, hc π hπh]
            _ = cf π₀ * ((Finset.univ.filter
                  (fun π => (F π ∧ S.Hit (T k) n π) ∧ S.hist π n = h)).card * b k h) := by
                  rw [Finset.sum_const, smul_eq_mul]
                  ring
            _ ≤ cf π₀ * (a k * (Finset.univ.filter (fun π => F π ∧ S.hist π n = h)).card) := by
                  rw [hHit]
                  exact Nat.mul_le_mul_left _ (by
                    convert hfib using 3 <;> (ext π; simp only [Finset.mem_filter]))
            _ = ∑ π ∈ Finset.univ.filter (fun π => F π ∧ S.hist π n = h), cf π₀ * a k := by
                  rw [Finset.sum_const, smul_eq_mul]
                  ring
            _ = ∑ π ∈ Finset.univ.filter (fun π => F π ∧ S.hist π n = h), w n π := by
                  refine Finset.sum_congr rfl fun π hπ => ?_
                  have hπh := (Finset.mem_filter.1 hπ).2.2
                  rw [hw0 π hπh, hc π hπh]
        · rw [Finset.not_nonempty_iff_eq_empty] at hne
          have hsub : Finset.univ.filter
              (fun π => (F π ∧ S.Hit (T k) n π) ∧ S.hist π n = h) = ∅ := by
            rw [Finset.eq_empty_iff_forall_notMem]
            intro π hπ
            have hπ' := Finset.mem_filter.1 hπ
            have : π ∈ Finset.univ.filter (fun π => F π ∧ S.hist π n = h) :=
              Finset.mem_filter.2 ⟨Finset.mem_univ _, hπ'.2.1.1, hπ'.2.2⟩
            rw [hne] at this
            exact Finset.notMem_empty _ this
          rw [hsub, hne]
          simp
  have hsum : ∀ n ≤ N, ∑ π ∈ G n, w n π ≤ (∏ k ∈ P, a k) * Fintype.card (Oracle α) := by
    intro n
    induction n with
    | zero =>
        intro _
        have hG : G 0 = Finset.univ := by
          ext π
          simp [G]
        rw [hG]
        have hw : ∀ π, w 0 π = ∏ k ∈ P, a k := fun π => by
          simp only [w, hD0 π, Finset.prod_empty, one_mul, Finset.sdiff_empty]
        simp only [hw, Finset.sum_const, Finset.card_univ, smul_eq_mul]
        exact le_of_eq (Nat.mul_comm _ _)
    | succ n ih =>
        intro hn
        exact (hstep n (by omega)).trans (ih (by omega))
  refine le_trans ?_ (hsum N le_rfl)
  have hsubset : Finset.univ.filter (fun π => (∀ n < N, S.HitAt A T n π) ∧
      ∀ k ∈ P, ∃ n < N, A n (S.hist π n) = some k) ⊆ G N := by
    intro π hπ
    simp only [G, Finset.mem_filter, Finset.mem_univ, true_and] at hπ ⊢
    exact hπ.1
  calc
    ∑ π ∈ Finset.univ.filter (fun π => (∀ n < N, S.HitAt A T n π) ∧
        ∀ k ∈ P, ∃ n < N, A n (S.hist π n) = some k),
        ∏ k ∈ P, b k (S.hist π (S.assignStep A k π))
        = ∑ π ∈ Finset.univ.filter (fun π => (∀ n < N, S.HitAt A T n π) ∧
            ∀ k ∈ P, ∃ n < N, A n (S.hist π n) = some k), w N π := by
          refine Finset.sum_congr rfl fun π hπ => ?_
          have hall := (Finset.mem_filter.1 hπ).2.2
          have hDN : D N π = P := by
            simp only [D, assignedBefore]
            exact Finset.filter_true_of_mem fun k hk => hall k hk
          simp only [w, bw, hDN, Finset.sdiff_self, Finset.prod_empty, mul_one]
    _ ≤ ∑ π ∈ G N, w N π := Finset.sum_le_sum_of_subset hsubset

open Classical in
/-- **`prob_pattern_le` with history-dependent widths.** An event inside "every item assigned and
every assigned step hits" costs at most any bound on the product of the finite-population factors
read at the run's own assignment steps. -/
theorem prob_hitsAt_hist_le {K : Type} [DecidableEq K] (P : Finset K)
    (A : ℕ → History α → Option K) (T : K → History α → (q : Qry α) → Finset (α q.1))
    (w : K → History α → ℕ) (nPos : ℕ)
    (hA : ∀ n h k, A n h = some k → k ∈ P)
    (huniq : ∀ π k m n, A m (S.hist π m) = some k → A n (S.hist π n) = some k → m = n)
    (hT : ∀ κ h q, (T κ h q).card * (2 ^ w κ h - nPos) ≤ Fintype.card (α q.1) - nPos)
    (E : Oracle α → Prop)
    (hE : ∀ π, E π → (∀ n < nPos, S.HitAt A T n π) ∧
      ∀ k ∈ P, ∃ n < nPos, A n (S.hist π n) = some k)
    (β : ℝ≥0∞)
    (hβ : ∀ π, E π →
      ∏ k ∈ P, (((2 ^ w k (S.hist π (S.assignStep A k π)) - nPos : ℕ) : ℝ≥0∞))⁻¹ ≤ β) :
    prob E ≤ β := by
  let bw : Oracle α → ℕ := fun π => ∏ k ∈ P, (2 ^ w k (S.hist π (S.assignStep A k π)) - nPos)
  have hc := S.card_hitsAt_hist_le P A T (fun _ => 1) (fun k h => 2 ^ w k h - nPos) nPos hA huniq
    (fun k _ n hn h q => by
      rw [one_mul]
      exact (hT k h q).trans (Nat.sub_le_sub_left hn.le _))
  simp only [Finset.prod_const_one, one_mul] at hc
  have hsub : Finset.univ.filter E ⊆ Finset.univ.filter (fun π => (∀ n < nPos, S.HitAt A T n π) ∧
      ∀ k ∈ P, ∃ n < nPos, A n (S.hist π n) = some k) := by
    intro π hπ
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hπ ⊢
    exact hE π hπ
  have hsumE : ∑ π ∈ Finset.univ.filter E, bw π ≤ Fintype.card (Oracle α) :=
    (Finset.sum_le_sum_of_subset hsub).trans hc
  by_cases hEe : (Finset.univ.filter E).Nonempty
  swap
  · rw [Finset.not_nonempty_iff_eq_empty] at hEe
    unfold prob
    rw [hEe, Finset.card_empty, Nat.cast_zero, ENNReal.zero_div]
    exact zero_le
  by_cases hβt : β = ⊤
  · rw [hβt]; exact le_top
  have hΩ0 : (Fintype.card (Oracle α) : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hΩt : (Fintype.card (Oracle α) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hinv : ∀ π, E π → β⁻¹ ≤ (bw π : ℝ≥0∞) := by
    intro π hπ
    have h1 := hβ π hπ
    rw [← ENNReal.prod_inv_distrib (fun _ _ _ _ _ => Or.inr (ENNReal.natCast_ne_top _)),
      ← Nat.cast_prod] at h1
    exact ENNReal.inv_le_iff_inv_le.1 h1
  obtain ⟨π₀, hπ₀⟩ := hEe
  have hβ0 : β ≠ 0 := by
    intro h0
    have h1 := hinv π₀ (Finset.mem_filter.1 hπ₀).2
    rw [h0, ENNReal.inv_zero, top_le_iff] at h1
    exact ENNReal.natCast_ne_top _ h1
  have hcard : ((Finset.univ.filter E).card : ℝ≥0∞) * β⁻¹ ≤ Fintype.card (Oracle α) := by
    calc
      ((Finset.univ.filter E).card : ℝ≥0∞) * β⁻¹ = ∑ π ∈ Finset.univ.filter E, β⁻¹ := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ ∑ π ∈ Finset.univ.filter E, (bw π : ℝ≥0∞) :=
          Finset.sum_le_sum fun π hπ => hinv π (Finset.mem_filter.1 hπ).2
      _ = ((∑ π ∈ Finset.univ.filter E, bw π : ℕ) : ℝ≥0∞) := by rw [Nat.cast_sum]
      _ ≤ Fintype.card (Oracle α) := by exact_mod_cast hsumE
  unfold prob
  rw [ENNReal.div_le_iff hΩ0 hΩt]
  calc
    ((Finset.univ.filter E).card : ℝ≥0∞)
        = ((Finset.univ.filter E).card : ℝ≥0∞) * β⁻¹ * β := by
          rw [mul_assoc, ENNReal.inv_mul_cancel hβ0 hβt, mul_one]
    _ ≤ Fintype.card (Oracle α) * β := mul_le_mul_left hcard β
    _ = β * Fintype.card (Oracle α) := mul_comm _ _

end Strategy

end LazyPerm

end


/-! ════ ChainEPFV6Read ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- What a value pointer reads. -/
inductive V6Src where
  | raw
  | inp
  | out
  | run
  | padC
  | ivC
deriving DecidableEq

/-- A reading instruction: the source, the pinned coordinate, and an optional row fold `⊕ Wb row`. -/
structure V6Instr (B : ℕ) where
  src : V6Src
  part : V6Part
  row : Option (Fin B)

/-- The query at a program slot. -/
def slotQ (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (o : Fin B × Fin (R.Q + 1)) :
    Option (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) :=
  ((R.tr π o.1)[o.2.val]?).map Prod.snd

def slotFwd (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (o : Fin B × Fin (R.Q + 1)) : Bool :=
  match R.slotQ π o with
  | some (.inl _) => true
  | _ => false

def qFwd (q : Qry (BandAlpha ℓ c)) : Bool :=
  match q.2 with
  | .inl _ => true
  | .inr _ => false

/-- **The (c′) code table.** `fwd` is the direction of the charged query, `sfwd` that of the
pointed slot. -/
def v6Decode (code : V6Part × Fin B) (fwd : Bool) (ptr : R.V6Pointer) (sfwd : Bool) :
    V6Instr B :=
  match ptr with
  | .inr _ => match code.1 with
    | .r => ⟨.padC, .r, none⟩
    | .h => ⟨.ivC, .h, none⟩
  | .inl o =>
    if o.2.val = R.Q then (if fwd then ⟨.run, .r, some code.2⟩ else ⟨.run, .r, none⟩)
    else if fwd then
      if sfwd then
        match code.1 with
        | .r => ⟨.raw, .r, some code.2⟩
        | .h => if code.2.val = 0 then ⟨.raw, .h, none⟩ else ⟨.raw, .r, none⟩
      else
        match code.1 with
        | .r => if code.2.val + 1 = B then ⟨.raw, .r, none⟩ else ⟨.inp, .r, some code.2⟩
        | .h => if code.2.val = 0 then ⟨.raw, .h, none⟩ else ⟨.inp, .h, none⟩
    else
      match code.1 with
      | .r => if code.2.val + 1 = B then ⟨.inp, .r, none⟩ else ⟨.out, .r, some code.2⟩
      | .h => if code.2.val = 0 then ⟨.out, .h, none⟩ else ⟨.inp, .h, none⟩

def rowXor (row : Option (Fin B)) (x : Bits ℓ) : Bits ℓ :=
  match row with
  | some v => bxor x (R.Wb v)
  | none => x

/-- The point a slot source reads. -/
noncomputable def slotPoint (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (src : V6Src)
    (o : Fin B × Fin (R.Q + 1)) : Bits (ℓ + (ℓ + c)) :=
  match R.slotQ π o with
  | none => fun _ => false
  | some d => match src with
    | .inp => revealPt π d
    | .out => π (revealPt π d)
    | _ => Sum.elim id id d

noncomputable def readR (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ins : V6Instr B)
    (ptr : R.V6Pointer) : Bits ℓ :=
  match ptr with
  | .inr _ => padBlk
  | .inl o => R.rowXor ins.row (match ins.src with
    | .run => (R.P o.1).run ((idealPerm (ℓ + (ℓ + c))).answer π)
    | .padC => padBlk
    | s => ovR (R.slotPoint π s o))

noncomputable def readH (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ins : V6Instr B)
    (ptr : R.V6Pointer) : Bits (ℓ + c) :=
  match ptr with
  | .inr q => iv (R.dom q.1.1.val)
  | .inl o => ovH (R.slotPoint π ins.src o)

/-- Equality of one coordinate of two whole answers. -/
def coordEq (p : V6Part) (y y' : Bits (ℓ + (ℓ + c))) : Prop :=
  match p with
  | .r => ovR y = ovR y'
  | .h => ovH y = ovH y'

/-- The value an instruction reads, as a pin on the charged coordinate of `y`. -/
def PinReads (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (ins : V6Instr B) (ptr : R.V6Pointer)
    (y : Bits (ℓ + (ℓ + c))) : Prop :=
  match ins.part with
  | .r => ovR y = R.readR π ins ptr
  | .h => ovH y = R.readH π ins ptr

/-- The reader needs the slot's answer: the chain input of an inverse slot, or the image of a
forward one. -/
def NeedsAns (src : V6Src) (d : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) : Prop :=
  (src = .inp ∧ d.isRight) ∨ (src = .out ∧ d.isLeft)

/-- What a reader needs about its slot under the realized oracle: the slot's round is at most
`τ`, and, if the reader uses the answer, the slot's entry is in `h`. -/
def SlotAccess (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (τ : ℕ) (h : History (BandAlpha ℓ c))
    (ins : V6Instr B) : R.V6Pointer → Prop
  | .inr _ => True
  | .inl o =>
    if o.2.val < R.Q then
      ins.src ≠ .run ∧ ∃ te, (R.tr π o.1)[o.2.val]? = some te ∧ te.1 ≤ τ ∧
        (NeedsAns ins.src te.2 → qEntry (fun _ : Unit => π) bandEnc te.2 ∈ h)
    else (R.P o.1).depth ((idealPerm (ℓ + (ℓ + c))).answer π) ≤ τ

theorem qEntry_ans_eq {π π' : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {h : History (BandAlpha ℓ c)}
    (hc' : R.HistCons π' h) {d : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))}
    (hd : qEntry (fun _ : Unit => π) bandEnc d ∈ h) :
    ans (fun _ : Unit => π') (bandEnc d) = ans (fun _ : Unit => π) (bandEnc d) :=
  (hc' _ hd).symm

set_option maxHeartbeats 1000000 in
/-- **Reader determinacy.** Two oracles whose program-prefix histories agree through the start of
round `τ`, and that are both consistent with `h`, read the same slot direction and values. -/
theorem read_det (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π π' : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {m τ : ℕ}
    (hτ : τ ≤ R.D) (hstart : R.roundStart π τ ≤ m) (hm : m ≤ R.programSteps π)
    (hh : R.advThenLab.hist (fun _ : Unit => π') m = R.advThenLab.hist (fun _ : Unit => π) m)
    {h : History (BandAlpha ℓ c)} (hc' : R.HistCons π' h)
    (ins : V6Instr B) (ptr : R.V6Pointer) (hacc : R.SlotAccess π τ h ins ptr) :
    (∀ o, ptr = .inl o → R.slotFwd π' o = R.slotFwd π o) ∧
      R.readR π' ins ptr = R.readR π ins ptr ∧ R.readH π' ins ptr = R.readH π ins ptr := by
  rcases ptr with o | q
  · simp only [SlotAccess] at hacc
    by_cases hk : o.2.val < R.Q
    · rw [if_pos hk] at hacc
      obtain ⟨hnrun, te, hte, hteτ, hans⟩ := hacc
      have hte' := R.v6_slot_query_det hP π π' hτ hstart hm hh hte hteτ
      have hq0 : R.slotQ π o = some te.2 := by simp [slotQ, hte]
      have hq1 : R.slotQ π' o = some te.2 := by simp [slotQ, hte']
      have hpt : ∀ s : V6Src, (s = ins.src ∨ s = .raw) →
          R.slotPoint π' s o = R.slotPoint π s o := by
        intro s hs
        simp only [slotPoint, hq0, hq1]
        rcases hd : te.2 with x | y
        · cases s
          · rfl
          · rfl
          · have hn : NeedsAns ins.src te.2 := by
              rcases hs with hs | hs
              · exact Or.inr ⟨hs.symm, by simp [hd]⟩
              · cases hs
            have := R.qEntry_ans_eq hc' (hans hn)
            rw [hd] at this
            simpa [bandEnc, ans, revealPt] using this
          · rfl
          · rfl
          · rfl
        · cases s
          · rfl
          · have hn : NeedsAns ins.src te.2 := by
              rcases hs with hs | hs
              · exact Or.inl ⟨hs.symm, by simp [hd]⟩
              · cases hs
            have := R.qEntry_ans_eq hc' (hans hn)
            rw [hd] at this
            simpa [bandEnc, ans, revealPt] using this
          · simp [revealPt]
          · rfl
          · rfl
          · rfl
      refine ⟨fun o' ho' => ?_, ?_, ?_⟩
      · cases ho'
        simp only [slotFwd, hq0, hq1]
      · simp only [readR]
        congr 1
        rcases hs : ins.src with _ | _ | _ | _ | _ | _
        · exact congrArg ovR (hpt .raw (Or.inr rfl))
        · exact congrArg ovR (hpt .inp (Or.inl hs.symm))
        · exact congrArg ovR (hpt .out (Or.inl hs.symm))
        · exact (hnrun hs).elim
        · rfl
        · exact congrArg ovR (hpt .ivC (Or.inl hs.symm))
      · simp only [readH]
        exact congrArg ovH (hpt ins.src (Or.inl rfl))
    · rw [if_neg hk] at hacc
      obtain ⟨hrun, -⟩ := R.v6_slot_output_det hP π π' hτ hstart hm hh o.1 hacc
      have hnil : ∀ ρ : Equiv.Perm (Bits (ℓ + (ℓ + c))), R.slotQ ρ o = none := by
        intro ρ
        have hlen := R.tr_length_le hP ρ o.1
        have := o.2.isLt
        simp only [slotQ]
        rw [List.getElem?_eq_none (by omega)]
        rfl
      refine ⟨fun o' ho' => ?_, ?_, ?_⟩
      · cases ho'
        simp only [slotFwd, hnil]
      · simp only [readR]
        congr 1
        rcases ins.src with _ | _ | _ | _ | _ | _ <;>
          simp only [slotPoint, hnil, hrun]
      · simp only [readH, slotPoint, hnil]
  · exact ⟨fun o ho => (by cases ho), rfl, rfl⟩


/-- A chain input fixed in the program prefix of the truncated run was fixed by a program slot's
query, whose entry is in that history and whose round starts before it. -/
theorem slot_of_dom (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {cut m : ℕ} (hcut : cut ≤ R.programSteps π)
    (hm : m ≤ cut) {X : Bits (ℓ + (ℓ + c))}
    (hX : X ∈ ((R.stratC cut).hist (fun _ : Unit => π) m).dom ()) :
    ∃ (o : Fin B × Fin (R.Q + 1)) (te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))),
      o.2.val < R.Q ∧ (R.tr π o.1)[o.2.val]? = some te ∧ R.roundStart π te.1 < m ∧
      te.1 ≤ R.D ∧
      qEntry (fun _ : Unit => π) bandEnc te.2 ∈ (R.stratC cut).hist (fun _ : Unit => π) m ∧
      revealPt π te.2 = X := by
  have hhist := R.stratC_hist_le (π := fun _ : Unit => π)
    (by rw [← R.programSteps_eq_advSched]; exact hcut) m hm
  rw [hhist] at hX ⊢
  obtain ⟨e, he, hex⟩ := History.mem_dom.1 hX
  obtain ⟨i, te, hte, hteρ, rfl⟩ := R.advThenLab_hist_src_before hP π (hm.trans hcut) he
  obtain ⟨k, hk⟩ : ∃ k, (R.tr π i)[k]? = some te := List.mem_iff_getElem?.1 hte
  obtain ⟨hkQ, -⟩ := R.mem_queryBasisAt_of_tr hP π hk
  have hρD : te.1 ≤ R.D := by
    by_contra hgt
    have h1 := R.sc_roundStart_mono π (show R.D + 1 ≤ te.1 by omega)
    have h2 := R.programSteps_eq_roundStart_D hP π
    have h3 := R.sc_roundStart_mono π (show R.D ≤ R.D + 1 by omega)
    omega
  refine ⟨(i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), te, hkQ, hk, hteρ, hρD, he, ?_⟩
  rw [qEntry_inpAt_revealPt π te.2] at hex
  exact Option.some.inj hex

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Class ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

def row0 (v : Fin B) : Fin B := ⟨0, by have := v.isLt; omega⟩
def row1 (v : Fin B) : Fin B := ⟨min 1 (B - 1), by have := v.isLt; omega⟩
def rowLast (v : Fin B) : Fin B := ⟨B - 1, by have := v.isLt; omega⟩

theorem pinNextN_valid {cut : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} :
    ∀ (k : ℕ) {a y : VAtom B}, R.atomValid a → R.pinNextN cut π k a = some y → R.atomValid y
  | 0, a, y, ha, h => by
      simp only [pinNextN, Option.some.injEq] at h
      exact h ▸ ha
  | k + 1, a, y, ha, h => by
      obtain ⟨z, hz, hy⟩ := R.pinNextN_succ.1 h
      exact R.pinPartner_target_valid (R.pinNext_some hy).2.1

open Classical in
/-- The atom before the charge cell on a seed's transfer chain (the seed itself if none). -/
noncomputable def prevCell (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (a : VAtom B) :
    VAtom B :=
  if h : ∃ k y, R.pinNextN cut π k a = some y ∧ R.pinNext cut π y = some (R.pinCell cut π a) then
    Classical.choose (Classical.choose_spec h)
  else a

theorem prevCell_spec (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {a : VAtom B}
    (hne : R.pinCell cut π a ≠ a) :
    ∃ k, R.pinNextN cut π k a = some (R.prevCell cut π a) ∧
      R.pinNext cut π (R.prevCell cut π a) = some (R.pinCell cut π a) := by
  classical
  have hex : ∃ k y, R.pinNextN cut π k a = some y ∧
      R.pinNext cut π y = some (R.pinCell cut π a) := by
    obtain ⟨k, hk, -⟩ := R.pinCell_spec cut π a
    rcases k with _ | k
    · simp only [pinNextN, Option.some.injEq] at hk
      exact absurd hk.symm hne
    · obtain ⟨y, hy, he⟩ := R.pinNextN_succ.1 hk
      exact ⟨k, y, hy, he⟩
  unfold prevCell
  rw [dif_pos hex]
  exact ⟨_, (Classical.choose_spec (Classical.choose_spec hex)).1,
    (Classical.choose_spec (Classical.choose_spec hex)).2⟩

/-- Program slot `o` fixed chain input `X` before step `m` of the truncated run. -/
def FixSlot (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (m : ℕ) (X : Bits (ℓ + (ℓ + c)))
    (o : Fin B × Fin (R.Q + 1)) : Prop :=
  ∃ te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))),
    o.2.val < R.Q ∧ (R.tr π o.1)[o.2.val]? = some te ∧ R.roundStart π te.1 < m ∧
      te.1 ≤ R.D ∧
      qEntry (fun _ : Unit => π) bandEnc te.2 ∈ (R.stratC cut).hist (fun _ : Unit => π) m ∧
      revealPt π te.2 = X

open Classical in
noncomputable def fixSlot (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (m : ℕ)
    (X : Bits (ℓ + (ℓ + c))) (dflt : R.V6Pointer) : R.V6Pointer :=
  if h : ∃ o, R.FixSlot cut π m X o then .inl (Classical.choose h) else dflt

theorem fixSlot_spec (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {cut m : ℕ} (hcut : cut ≤ R.programSteps π)
    (hm : m ≤ cut) {X : Bits (ℓ + (ℓ + c))}
    (hX : X ∈ ((R.stratC cut).hist (fun _ : Unit => π) m).dom ()) (dflt : R.V6Pointer) :
    ∃ o, R.fixSlot cut π m X dflt = .inl o ∧ R.FixSlot cut π m X o := by
  classical
  have hex : ∃ o, R.FixSlot cut π m X o := by
    obtain ⟨o, te, hk, hte, hρ, hD, hmem, hrev⟩ := R.slot_of_dom hP hcut hm hX
    exact ⟨o, te, hk, hte, hρ, hD, hmem, hrev⟩
  refine ⟨Classical.choose hex, ?_, Classical.choose_spec hex⟩
  unfold fixSlot
  rw [dif_pos hex]

/-- A child pair of `b` was fixed before step `n`. -/
def ChildO (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (n : ℕ) (b : VAtom B) : Prop :=
  ∃ z, R.pinPartner z = some b ∧
    R.xin π z.pair.1 z.pair.2 ∈ ((R.stratC cut).hist (fun _ : Unit => π) n).dom ()

/-- `b`'s own pair was fixed before step `n`. -/
def OwnO (cut : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (n : ℕ) (b : VAtom B) : Prop :=
  R.xin π b.pair.1 b.pair.2 ∈ ((R.stratC cut).hist (fun _ : Unit => π) n).dom ()

section Class

variable (hP : ∀ i, (R.P i).Bounded R.D R.Q) (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
  (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)

theorem realizedSeed_cell_valid (a : {a // a ∈ R.realizedSeeds s π}) :
    R.atomValid (R.pinCell (R.firstCrossing s π) π a.1) :=
  R.pinCell_valid _ π (R.realized_atom_valid s π a.2)

open Classical in
/-- **The (c′) value pointer** of a realized seed. -/
noncomputable def v6Ptr (a : {a // a ∈ R.realizedSeeds s π}) : R.V6Pointer :=
  let cut := R.firstCrossing s π
  let e := R.pinCell cut π a.1
  let n := R.pairStep cut π e.pair
  let dflt : R.V6Pointer := .inr ⟨e.pair, R.atomValid_pair (R.realizedSeed_cell_valid s π a)⟩
  if R.pairForward cut π e.pair then
    if e = a.1 then .inl (R.sourceCommitProgramPos hP s π hcross a)
    else
      let y := R.prevCell cut π a.1
      R.fixSlot cut π (R.pairStep cut π y.pair + 1) (R.xin π y.pair.1 y.pair.2) dflt
  else
    match R.pinPartner e with
    | none => dflt
    | some b =>
      if hc : R.ChildO cut π n b then
        R.fixSlot cut π n (R.xin π (Classical.choose hc).pair.1 (Classical.choose hc).pair.2) dflt
      else if R.OwnO cut π n b then R.fixSlot cut π n (R.xin π b.pair.1 b.pair.2) dflt
      else if hb : b ∈ R.realizedSeeds s π then
        .inl (R.sourceCommitProgramPos hP s π hcross ⟨b, hb⟩)
      else dflt

open Classical in
/-- **The (c′) code** of a realized seed. -/
noncomputable def v6Code (a : {a // a ∈ R.realizedSeeds s π}) : V6Part × Fin B :=
  let cut := R.firstCrossing s π
  let e := R.pinCell cut π a.1
  let n := R.pairStep cut π e.pair
  let v := a.1.pair.1
  if R.pairForward cut π e.pair then
    if e = a.1 then
      match a.1 with
      | .r q =>
        let o := R.sourceCommitProgramPos hP s π hcross a
        if o.2.val = R.Q then (.r, q.1)
        else if R.slotFwd π o then
          (if q.2 = ovCalls R.G q.1 then (.r, q.1) else (.h, row1 v))
        else (.r, rowLast v)
      | .h _ => (.h, row0 v)
    else
      match e with
      | .r q => (.r, q.1)
      | .h _ => (.h, row1 v)
  else
    match R.pinPartner e with
    | none => (e.part, row0 v)
    | some b =>
      match e.part with
      | .r =>
        if R.ChildO cut π n b then (.r, rowLast v)
        else if R.OwnO cut π n b then (.r, b.pair.1)
        else if hb : b ∈ R.realizedSeeds s π then
          (let o := R.sourceCommitProgramPos hP s π hcross ⟨b, hb⟩
           if o.2.val = R.Q ∨ R.slotFwd π o then (.r, rowLast v) else (.r, b.pair.1))
        else (.r, rowLast v)
      | .h =>
        if R.ChildO cut π n b then (.h, row1 v)
        else if R.OwnO cut π n b then (.h, row0 v)
        else if hb : b ∈ R.realizedSeeds s π then
          (if R.slotFwd π (R.sourceCommitProgramPos hP s π hcross ⟨b, hb⟩) then (.h, row1 v)
           else (.h, row0 v))
        else (.h, row0 v)

end Class

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Sound ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm
open Pous.BandChain.KeyRule

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)


theorem charge_query {cut : ℕ} (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcut : cut ≤ R.programSteps π) {p : Fin B × ℕ} (hp : p ∈ R.posSet) :
    ∃ q, (R.stratC cut).next ((R.stratC cut).hist (fun _ : Unit => π) (R.pairStep cut π p)) =
        some q ∧ Fresh ((R.stratC cut).hist (fun _ : Unit => π) (R.pairStep cut π p)) q ∧
      (q = ⟨(), .inl (R.xin π p.1 p.2)⟩ ∨ q = ⟨(), .inr (π (R.xin π p.1 p.2))⟩) ∧
      R.pairForward cut π p = qFwd q := by
  have hs := R.pairStep_spec π hcut hp
  obtain ⟨q, hq, hf, hcase⟩ := (R.stratC cut).first_fix hs.2.1 hs.2.2
  refine ⟨q, hq, hf, hcase, ?_⟩
  unfold pairForward
  rw [hq]
  rcases hcase with rfl | rfl <;> rfl


theorem ans_charge_inv (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (X : Bits (ℓ + (ℓ + c))) :
    ans (fun _ : Unit => π) (⟨(), .inr (π X)⟩ : Qry (BandAlpha ℓ c)) = X := by
  simp [ans]

/-- An inverse-decided pair is decided by a program query, before the cut. -/
theorem inverse_step_lt_cut {cut : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcut : cut ≤ R.programSteps π) {p : Fin B × ℕ} (hp : p ∈ R.posSet)
    (hf : R.pairForward cut π p = false) : R.pairStep cut π p < cut := by
  obtain ⟨q, hq, -, hcase, hdir⟩ := R.charge_query π hcut hp
  have hinv : q = ⟨(), .inr (π (R.xin π p.1 p.2))⟩ := by
    rcases hcase with rfl | h
    · rw [hf] at hdir; simp [qFwd] at hdir
    · exact h
  by_contra hge
  have hlen := (R.stratC cut).length_hist_of_next hq
  have hle : cut ≤ ((R.stratC cut).hist (fun _ : Unit => π) (R.pairStep cut π p)).length := by
    omega
  rw [R.stratC_next_tail hle] at hq
  obtain ⟨x, hx⟩ := R.labTail_inl hq
  rw [hinv] at hx
  simp at hx


theorem ovR_xin_block (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ}
    (hq : q ∈ R.posSet) {u : Fin B} (hu : ovBlock R.G q.1 q.2 = some u) :
    ovR (R.xin π q.1 q.2) = labelG R.G (fun x => π x) R.dom R.Wb u := by
  obtain ⟨hp1, hp⟩ := R.mem_posSet.1 hq
  obtain ⟨p, hpq⟩ : ∃ p, q.2 = p + 1 := ⟨q.2 - 1, by omega⟩
  have hb := hu
  rw [hpq] at hb
  unfold ovBlock at hb
  simp only [Nat.add_sub_cancel] at hb
  obtain ⟨hpi, hget⟩ := List.getElem?_eq_some_iff.1 hb
  rw [hpq, Reach.ChainReplayR.xin_succ R π q.1 p (by omega), ovR_append,
    Reach.ChainReplayR.blks_getElem_parent R π q.1 p hpi, hget]

theorem ovR_xin_pad (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ}
    (hq : q ∈ R.posSet) (hu : ovBlock R.G q.1 q.2 = none) :
    ovR (R.xin π q.1 q.2) = padBlk := by
  obtain ⟨hp1, hp⟩ := R.mem_posSet.1 hq
  obtain ⟨p, hpq⟩ : ∃ p, q.2 = p + 1 := ⟨q.2 - 1, by omega⟩
  have hb := hu
  rw [hpq] at hb
  unfold ovBlock at hb
  simp only [Nat.add_sub_cancel] at hb
  have hpl : p = (parentsDesc R.G q.1).length := by
    have := List.getElem?_eq_none_iff.1 hb
    unfold ovCalls at hp
    omega
  rw [hpq, Reach.ChainReplayR.xin_succ R π q.1 p (by omega), ovR_append]
  subst hpl
  exact Reach.ChainReplayR.blks_getElem_pad R π q.1

theorem ovH_xin_prev (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ}
    (hq : q ∈ R.posSet) (h2 : 2 ≤ q.2) :
    ovH (R.xin π q.1 q.2) = R.hVal π (q.1, q.2 - 1) := by
  obtain ⟨hp1, hp⟩ := R.mem_posSet.1 hq
  have hxs := Reach.ChainReplayR.xin_succ R π q.1 (q.2 - 1) (by omega)
  rw [Nat.sub_add_cancel hp1] at hxs
  rw [hxs, ovH_append]
  have hs := Reach.ChainReplayR.chainH_succ R π q.1 (q.2 - 2) (by omega)
  have hsEq : q.2 - 2 + 1 = q.2 - 1 := by omega
  rw [hsEq] at hs
  simpa [hVal] using hs

theorem ovH_xin_first (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ}
    (hq : q ∈ R.posSet) (h1 : q.2 = 1) :
    ovH (R.xin π q.1 q.2) = iv (R.dom q.1.val) := by
  obtain ⟨hp1, hp⟩ := R.mem_posSet.1 hq
  have hxs := Reach.ChainReplayR.xin_succ R π q.1 0 (by omega)
  rw [h1, hxs, ovH_append, Reach.ChainReplayR.chainH_zero]

theorem rVal_pad_eq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (u : Fin B) :
    R.rVal π (u, ovCalls R.G u) = bxor (labelG R.G (fun x => π x) R.dom R.Wb u) (R.Wb u) := by
  rw [R.label_eq_pad_r π u, PousB5Chain.bxor_cancel]

theorem bxor_bxor_self (x y : Bits ℓ) : bxor (bxor x y) y = x := PousB5Chain.bxor_cancel x y

/-- A row that is a parent of some thread is not the last row. -/
theorem parent_row_lt {q : Fin B × ℕ} {u : Fin B} (hu : ovBlock R.G q.1 q.2 = some u) :
    u.val + 1 < B := by
  have humem : u ∈ parentsDesc R.G q.1 := List.mem_iff_getElem?.2 ⟨q.2 - 1, hu⟩
  have huv : u.val < q.1.val := parentsDesc_lt R.G humem
  have := q.1.isLt
  omega

/-- A thread with a second call has a parent, so `B ≥ 2`. -/
theorem two_le_B_of_calls {q : Fin B × ℕ} (hq : q ∈ R.posSet) (h : q.2 < ovCalls R.G q.1) :
    2 ≤ B := by
  obtain ⟨hp1, -⟩ := R.mem_posSet.1 hq
  have hlen : 0 < (parentsDesc R.G q.1).length := by unfold ovCalls at h; omega
  obtain ⟨u, hu⟩ : ∃ u, (parentsDesc R.G q.1)[0]? = some u := by
    cases hl : parentsDesc R.G q.1 with
    | nil => rw [hl] at hlen; simp at hlen
    | cons u _ => exact ⟨u, rfl⟩
  have huv : u.val < q.1.val := parentsDesc_lt R.G (List.mem_of_getElem? hu)
  have := q.1.isLt
  omega

theorem row1_val {v : Fin B} (hB : 2 ≤ B) : (row1 v).val = 1 := by
  simp only [row1]; omega


/-- The origin of a determined value: it is held, its own pair is fixed, or a child pair (whose
input carries it) is fixed. -/
def VOrigin (hist : History (BandAlpha ℓ c)) (H : ChainKnow B) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    DAtom B → Prop
  | .lab v => v ∈ H.labs ∨ (v, ovCalls R.G v) ∈ H.rs ∨
      R.xin π v (ovCalls R.G v) ∈ hist.dom () ∨
      ∃ q ∈ R.posSet, ovBlock R.G q.1 q.2 = some v ∧ R.xin π q.1 q.2 ∈ hist.dom ()
  | .r q => q ∈ H.rs ∨ R.xin π q.1 q.2 ∈ hist.dom () ∨
      (q.2 = ovCalls R.G q.1 ∧ (q.1 ∈ H.labs ∨
        ∃ q' ∈ R.posSet, ovBlock R.G q'.1 q'.2 = some q.1 ∧ R.xin π q'.1 q'.2 ∈ hist.dom ()))
  | .h q => q ∈ H.hs ∨ R.xin π q.1 q.2 ∈ hist.dom () ∨
      ∃ q' ∈ R.posSet, 2 ≤ q'.2 ∧ (q'.1, q'.2 - 1) = q ∧ R.xin π q'.1 q'.2 ∈ hist.dom ()

theorem vcTarget_origin {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {hist : History (BandAlpha ℓ c)}
    {H : ChainKnow B} {d : DAtom B} (ht : R.VCTarget π hist H d) : R.VOrigin hist H π d := by
  induction ht with
  | heldLab h => exact Or.inl h
  | heldR h => exact Or.inl h
  | heldH h => exact Or.inl h
  | @padLabel v _ ih =>
      rcases ih with h | h | ⟨-, h⟩
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (Or.inl h))
      · rcases h with h | h
        · exact Or.inl h
        · exact Or.inr (Or.inr (Or.inr h))
  | @padR v _ ih =>
      rcases ih with h | h | h | h
      · exact Or.inr (Or.inr ⟨rfl, Or.inl h⟩)
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr ⟨rfl, Or.inr h⟩)
  | forwardRFirst _ _ hdom _ _ => exact Or.inr (Or.inl hdom)
  | forwardRPrev _ _ hdom _ _ _ _ => exact Or.inr (Or.inl hdom)
  | forwardHFirst _ _ hdom _ _ => exact Or.inr (Or.inl hdom)
  | forwardHPrev _ _ hdom _ _ _ _ => exact Or.inr (Or.inl hdom)
  | @inverseLab q u hpos hdom _ _ hb _ _ => exact Or.inr (Or.inr (Or.inr ⟨q, hpos, hb, hdom⟩))
  | @inverseH q hpos hp2 hdom _ _ _ _ => exact Or.inr (Or.inr ⟨q, hpos, hp2, rfl, hdom⟩)

/-- For a known partner, a not-held value has its own pair or a child pair fixed. -/
theorem pinKnownAt_origin {cut j : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcut : cut ≤ R.programSteps π) {b : VAtom B} (hbv : R.atomValid b) (hk : R.pinKnownAt cut π j b) :
    b ∈ R.seedAtoms (R.cutHolding cut π) ∨ R.OwnO cut π j b ∨ R.ChildO cut π j b := by
  have hlab : (R.cutHolding cut π).labs = ∅ := R.seedsAtCut_labs_empty π cut
  rcases hk with hk | ⟨z, hz, hzj⟩
  · have ho := R.vcTarget_origin hk
    rcases b with ⟨q⟩ | ⟨q⟩
    · simp only [DAtom.ofVAtom, VOrigin] at ho
      rcases ho with h | h | ⟨hpad, h | ⟨q', hq', hb, hdom⟩⟩
      · exact Or.inl (R.mem_seedAtoms_of_atomIn hbv h)
      · exact Or.inr (Or.inl h)
      · rw [hlab] at h; simp at h
      · refine Or.inr (Or.inr ⟨.r q', ?_, hdom⟩)
        simp only [pinPartner, hq', if_true, hb]
        rw [← hpad]
    · simp only [DAtom.ofVAtom, VOrigin] at ho
      rcases ho with h | h | ⟨q', hq', h2, heq, hdom⟩
      · exact Or.inl (R.mem_seedAtoms_of_atomIn hbv h)
      · exact Or.inr (Or.inl h)
      · refine Or.inr (Or.inr ⟨.h q', ?_, hdom⟩)
        simp only [pinPartner, hq', h2, and_self, if_true, heq]
  · have hs := R.pairStep_spec π hcut (R.atomValid_pair (R.pinPartner_source_valid hz))
    exact Or.inr (Or.inr ⟨z, hz, (R.stratC cut).dom_mono _ hzj () hs.2.2⟩)


theorem read'_lab_pad (K : ChainKnow B) {u : Fin B} (hu : u ∈ (read' R.G K).labs) :
    (u, ovCalls R.G u) ∈ (read' R.G K).rs := by
  rw [mem_read'_rs]
  rw [mem_read'_labs] at hu
  rcases hu with hu | hu
  · exact Or.inr ⟨u, hu, rfl⟩
  · exact Or.inl hu

set_option maxHeartbeats 4000000 in
/-- **`valueSlot_round_le` for a held partner.** If an inverse step fixes the pair of a cell whose
partner `b` is a realized seed, `b`'s selected show starts no later than that step: once the pair
is revealed, its input atoms are credited in the next round, so `b` cannot be fresh later. -/
theorem v6_partner_round_le
    (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)
    (b : {b // b ∈ R.realizedSeeds s π}) {e : VAtom B} (hev : R.atomValid e)
    (hpart : R.pinPartner e = some b.1) :
    R.roundStart π (R.sourceCommitRound hP s π hcross b) ≤
      R.pairStep (R.firstCrossing s π) π e.pair := by
  classical
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  have hsrc := R.sourceCommitRound_spec hP s π hcross b
  have hτ₀D : R.sourceCommitRound hP s π hcross b ≤ R.D := hsrc.1
  have hstart : R.roundStart π (R.sourceCommitRound hP s π hcross b) ≤ R.firstCrossing s π := by
    have h := hsrc.2.2.2
    unfold commitCut at h
    omega
  have hbv : R.atomValid b.1 := R.realized_atom_valid s π b.2
  have hq : e.pair ∈ R.posSet := R.atomValid_pair hev
  by_contra hlt
  have hlt' : R.pairStep (R.firstCrossing s π) π e.pair + 1 ≤
      R.roundStart π (R.sourceCommitRound hP s π hcross b) := by omega
  have hps := R.pairStep_spec π hcut hq
  have hfix : R.xin π e.pair.1 e.pair.2 ∈
      ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π)
        (R.roundStart π (R.sourceCommitRound hP s π hcross b))).dom () :=
    (R.stratC (R.firstCrossing s π)).dom_mono _ hlt' () hps.2.2
  have hhist := R.sc_stratC_take_eq_advThenLab_hist π hcut hstart
    (le_refl (R.roundStart π (R.sourceCommitRound hP s π hcross b)))
  rw [List.take_of_length_le ((R.stratC _).hist_length_le _ _)] at hhist
  rw [hhist] at hfix
  obtain ⟨en, hen, hex⟩ := History.mem_dom.1 hfix
  obtain ⟨i, te, hte, hteρ, rfl⟩ :=
    R.advThenLab_hist_roundStart_src hP π hτ₀D (hstart.trans hcut) hen
  have hdir := qEntry_inpAt_eq hex
  obtain ⟨k, hk⟩ : ∃ k, (R.tr π i)[k]? = some te := List.mem_iff_getElem?.1 hte
  obtain ⟨hkQ, hkb⟩ := R.mem_queryBasisAt_of_tr hP π hk
  have hρD : te.1 ≤ R.D := by omega
  have hrev : R.revealedAt π te.1 e.pair := by
    refine ⟨i, te, hte, rfl, ?_⟩
    rcases hdir with hd | hd <;> rw [hd] <;> simp [revealPt]
  have hfull : R.seedsAtCut π (R.programSteps π) =
      (R.showRecords π).foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2)
        PousSpongeChain.ChainKnow.empty := by
    unfold seedsAtCut
    rw [if_pos (le_refl _)]
    exact (R.showRecords_fold_eq_v6SeedsThrough π).symm
  have hAin : AtomIn b.1 ((R.showRecords π).foldl
      (fun K x => R.seedBasisStep π x.2.1 K x.2.2) PousSpongeChain.ChainKnow.empty) := by
    rw [← hfull]
    apply R.atomIn_of_mem_seedAtoms (R.seedsAtCut_labs_empty π _)
    exact R.sc_seedAtoms_mono (R.sc_seedsAtCut_mono hP π hcut le_rfl) b.2
  rcases R.recordsFold_fresh π _ _ hAin with h0 | ⟨pre, rec, post, heq, hatom, hfresh, hmem⟩
  · rcases b with ⟨⟨q'⟩ | ⟨q'⟩, _⟩ <;>
      simp [AtomIn, PousSpongeChain.ChainKnow.empty] at h0
  have hrecShow : rec ∈ R.showRecords π := by
    rw [heq]
    exact List.mem_append_right _ List.mem_cons_self
  have hpShow : pre ++ [rec] <+: R.showRecords π := ⟨post, by rw [heq]; simp⟩
  have hpCut : pre ++ [rec] <+:
      (R.showRecords π).filter (fun x => x.1 ≤ rec.1) :=
    R.prefix_filter_of_prefix hpShow (R.prefix_through_le (R.showRecords_pairwise π) heq)
  have hle : Le ((pre ++ [rec]).foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2)
      PousSpongeChain.ChainKnow.empty) (R.seedsAtCut π rec.1) := by
    unfold seedsAtCut
    split
    · rw [← R.showRecords_fold_eq_v6SeedsThrough π]
      exact R.recordsFold_le_of_prefix π hpShow _
    · exact R.recordsFold_le_of_prefix π hpCut _
  unfold showRecords at hrecShow
  obtain ⟨τ₁, hτ₁, hx⟩ := List.mem_flatMap.1 hrecShow
  obtain ⟨x₁, hx₁, hrec⟩ := List.mem_map.1 hx
  subst hrec
  have hτ₁D : τ₁ ≤ R.D := by simp at hτ₁; omega
  have hcs : R.CausalSource hP s π hcross b (R.commitCut π τ₁ x₁) τ₁ x₁ :=
    ⟨hτ₁D, hx₁, hatom, rfl, R.mem_seedAtoms_of_atomIn hbv (atomIn_mono hle hmem)⟩
  have hτ₀τ₁ := R.sourceCommitRound_le_of_causal hP s π hcross b hcs
  have hρτ₁ : te.1 < τ₁ := by omega
  set Hp := pre.foldl (fun K x => R.seedBasisStep π x.2.1 K x.2.2)
    PousSpongeChain.ChainKnow.empty with hHp
  have hshown : ∀ x : VAtom B, R.atomValid x →
      R.commitMatches π te.1 ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), x⟩ →
      AtomIn x (R.vcCredit π te.1 Hp) := fun x hx hm =>
    R.atomIn_pre_of_shown (x := ⟨_, x⟩) heq hρD hρτ₁ (R.commit_mem_basisAt hkb hx hm)
  have hcredit : AtomIn b.1 (R.vcCredit π τ₁ Hp) := by
    rcases hdir with hd | hd
    · -- A forward query on the pair's input shows the partner, which is an input atom.
      have hm : R.commitMatches π te.1 ⟨.inl (i, ⟨k, Nat.lt_succ_of_lt hkQ⟩), b.1⟩ := by
        rcases e with ⟨qe⟩ | ⟨qe⟩
        · have hqe : qe ∈ R.posSet := hq
          simp only [pinPartner, hqe, if_true] at hpart
          cases hb : ovBlock R.G qe.1 qe.2 with
          | none => rw [hb] at hpart; simp at hpart
          | some u =>
              rw [hb] at hpart
              simp only [Option.some.injEq] at hpart
              rw [← hpart]
              exact R.commit_fwd_block hk hkQ hqe hd hb
        · have hqe : qe ∈ R.posSet := hq
          simp only [pinPartner] at hpart
          split at hpart
          · rename_i h2
            simp only [Option.some.injEq] at hpart
            rw [← hpart]
            exact R.commit_fwd_prev hk hkQ hqe hd h2.2
          · simp at hpart
      exact atomIn_mono (R.vcCredit_mono_round π Hp hρτ₁.le) (hshown _ hbv hm)
    · -- An inverse query on the pair's output shows both of its atoms; the pair's input atoms,
      -- among them the partner, are credited the next round.
      have hr : e.pair ∈ (R.vcCredit π te.1 Hp).rs :=
        hshown (.r e.pair) hq (R.commit_inv (a := .r e.pair) hk hkQ hd)
      have hh : e.pair ∈ (R.vcCredit π te.1 Hp).hs :=
        hshown (.h e.pair) hq (R.commit_inv (a := .h e.pair) hk hkQ hd)
      have hc := (R.vc_band_complete π te.1 Hp hq hrev).2 hh hr
      have hin : AtomIn b.1 (R.vcCredit π (te.1 + 1) Hp) := by
        rcases e with ⟨qe⟩ | ⟨qe⟩
        · have hqe : qe ∈ R.posSet := hq
          simp only [pinPartner, hqe, if_true] at hpart
          cases hb : ovBlock R.G qe.1 qe.2 with
          | none => rw [hb] at hpart; simp at hpart
          | some u =>
              rw [hb] at hpart
              simp only [Option.some.injEq] at hpart
              rw [← hpart]
              exact R.read'_lab_pad (R.vcStepAt π te.1 (R.vcCredit π te.1 Hp)) (hc.1 u hb)
        · simp only [pinPartner] at hpart
          split at hpart
          · rename_i h2
            simp only [Option.some.injEq] at hpart
            rw [← hpart]
            exact hc.2 h2.2
          · simp at hpart
      exact atomIn_mono (R.vcCredit_mono_round π Hp hρτ₁) hin
  exact hfresh hcredit

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Sound2 ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm
open Pous.BandChain.KeyRule

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

def ptrFwd (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.V6Pointer → Bool
  | .inl o => R.slotFwd π o
  | .inr _ => false

/-- What the fiber bound needs of one seed's name. -/
def SeedSound (cut n : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (code : V6Part × Fin B)
    (ptr : R.V6Pointer) (part : V6Part) : Prop :=
  ∃ q, (R.stratC cut).next ((R.stratC cut).hist (fun _ : Unit => π) n) = some q ∧
    Fresh ((R.stratC cut).hist (fun _ : Unit => π) n) q ∧
    (R.v6Decode code (qFwd q) ptr (R.ptrFwd π ptr)).part = part ∧
    R.PinReads π (R.v6Decode code (qFwd q) ptr (R.ptrFwd π ptr)) ptr (ans (fun _ : Unit => π) q) ∧
    ∃ τ ≤ R.D, R.roundStart π τ ≤ n ∧ R.roundStart π τ ≤ cut ∧
      R.SlotAccess π τ ((R.stratC cut).hist (fun _ : Unit => π) n)
        (R.v6Decode code (qFwd q) ptr (R.ptrFwd π ptr)) ptr

theorem seedSound_intro {cut n : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {code : V6Part × Fin B} {ptr : R.V6Pointer} {part : V6Part} {q : Qry (BandAlpha ℓ c)}
    (hq : (R.stratC cut).next ((R.stratC cut).hist (fun _ : Unit => π) n) = some q)
    (hfr : Fresh ((R.stratC cut).hist (fun _ : Unit => π) n) q) (ins : V6Instr B)
    (hins : R.v6Decode code (qFwd q) ptr (R.ptrFwd π ptr) = ins) (hpart : ins.part = part)
    (hpin : R.PinReads π ins ptr (ans (fun _ : Unit => π) q)) (τ : ℕ) (hτ : τ ≤ R.D)
    (h1 : R.roundStart π τ ≤ n) (h2 : R.roundStart π τ ≤ cut)
    (hacc : R.SlotAccess π τ ((R.stratC cut).hist (fun _ : Unit => π) n) ins ptr) :
    R.SeedSound cut n π code ptr part :=
  ⟨q, hq, hfr, by rw [hins]; exact hpart, by rw [hins]; exact hpin, τ, hτ, h1, h2,
    by rw [hins]; exact hacc⟩

theorem commitMatches_of_mem_basisAt {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {τ : ℕ}
    {x : VCommit B R.Q} (h : x ∈ R.basisAt π τ) : R.commitMatches π τ x := by
  classical
  unfold basisAt at h
  obtain ⟨o, -, hx⟩ := List.mem_flatMap.1 h
  obtain ⟨a, -, hsome⟩ := List.mem_filterMap.1 hx
  split at hsome
  · obtain rfl := Option.some.inj hsome
    assumption
  · simp at hsome

/-- A seed's selected show, read as a slot: an r atom's observed value, or an h atom's. -/
theorem source_obs (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)
    (a : {a // a ∈ R.realizedSeeds s π}) :
    R.commitMatches π (R.sourceCommitRound hP s π hcross a)
      ⟨.inl (R.sourceCommitProgramPos hP s π hcross a), a.1⟩ := by
  have hs := R.sourceCommitRound_spec hP s π hcross a
  have hm := R.commitMatches_of_mem_basisAt hs.2.1
  have hpos := R.sourceCommitProgramPos_spec hP s π hcross a
  have hx : R.sourceCommit hP s π hcross a =
      ⟨.inl (R.sourceCommitProgramPos hP s π hcross a), a.1⟩ := by
    rw [← hpos, ← hs.2.2.1]
  rw [hx] at hm
  exact hm

theorem sourceRound_start_le_cut (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)
    (a : {a // a ∈ R.realizedSeeds s π}) :
    R.roundStart π (R.sourceCommitRound hP s π hcross a) ≤ R.firstCrossing s π := by
  have h := (R.sourceCommitRound_spec hP s π hcross a).2.2.2
  unfold commitCut at h
  omega

/-- The values a show commits, per slot kind. -/
theorem commit_r_obs {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {τ : ℕ}
    {o : Fin B × Fin (R.Q + 1)} {q : Fin B × ℕ}
    (hm : R.commitMatches π τ ⟨.inl o, .r q⟩) :
    (o.2.val = R.Q ∧ q.2 = ovCalls R.G q.1 ∧
        R.rVal π q = bxor ((R.P o.1).run ((idealPerm (ℓ + (ℓ + c))).answer π)) (R.Wb q.1) ∧
        (R.P o.1).depth ((idealPerm (ℓ + (ℓ + c))).answer π) = τ) ∨
      (o.2.val < R.Q ∧ ∃ te, (R.tr π o.1)[o.2.val]? = some te ∧ te.1 = τ ∧
        ((∃ x, te.2 = .inl x ∧
            R.rVal π q = if q.2 = ovCalls R.G q.1 then bxor (ovR x) (R.Wb q.1) else ovR x) ∨
          (∃ y, te.2 = .inr y ∧ R.rVal π q = ovR y))) := by
  obtain ⟨i, k⟩ := o
  unfold commitMatches obsR at hm
  simp only at hm
  by_cases hk : k.val < R.Q
  · right
    refine ⟨hk, ?_⟩
    by_cases hpad : q.2 = ovCalls R.G q.1
    · simp only [hpad, ↓reduceIte, obsFoldKey, hk] at hm
      cases htr : (R.tr π i)[k.val]? with
      | none => rw [htr] at hm; simp at hm
      | some te =>
          rw [htr] at hm
          simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hm
          refine ⟨te, rfl, hm.2, ?_⟩
          rcases hd : te.2 with x | y
          · rw [hd] at hm
            exact Or.inl ⟨x, rfl, by simp only [hpad, ↓reduceIte]; exact hm.1.symm.trans rfl⟩
          · rw [hd] at hm
            exact Or.inr ⟨y, rfl, hm.1.symm.trans rfl⟩
    · simp only [hpad, ↓reduceIte, hk, obsKey] at hm
      cases htr : (R.tr π i)[k.val]? with
      | none => rw [htr] at hm; simp at hm
      | some te =>
          rw [htr] at hm
          simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hm
          refine ⟨te, rfl, hm.2, ?_⟩
          rcases hd : te.2 with x | y
          · rw [hd] at hm
            exact Or.inl ⟨x, rfl, by simp only [hpad, ↓reduceIte]; exact hm.1.symm.trans rfl⟩
          · rw [hd] at hm
            exact Or.inr ⟨y, rfl, hm.1.symm.trans rfl⟩
  · left
    have hkQ : k.val = R.Q := by have := k.isLt; omega
    by_cases hpad : q.2 = ovCalls R.G q.1
    · simp only [hpad, ↓reduceIte, obsFoldKey, hk, Option.some.injEq, Prod.mk.injEq] at hm
      exact ⟨hkQ, hpad, hm.1.symm, hm.2⟩
    · simp [hpad, hk] at hm

theorem commit_h_obs {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {τ : ℕ}
    {o : Fin B × Fin (R.Q + 1)} {q : Fin B × ℕ}
    (hm : R.commitMatches π τ ⟨.inl o, .h q⟩) :
    o.2.val < R.Q ∧ ∃ te, (R.tr π o.1)[o.2.val]? = some te ∧ te.1 = τ ∧
      R.hVal π q = qKeyH te.2 := by
  obtain ⟨i, k⟩ := o
  unfold commitMatches obsKeyH at hm
  simp only at hm
  by_cases hk : k.val < R.Q
  · simp only [hk, ↓reduceIte] at hm
    cases htr : (R.tr π i)[k.val]? with
    | none => rw [htr] at hm; simp at hm
    | some te =>
        rw [htr] at hm
        simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hm
        exact ⟨hk, te, rfl, hm.2, hm.1.symm⟩
  · simp [hk] at hm

section Classes

variable (hP : ∀ i, (R.P i).Bounded R.D R.Q) (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
  (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)

theorem slotFwd_of_tr {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {o : Fin B × Fin (R.Q + 1)}
    {te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))} (hte : (R.tr π o.1)[o.2.val]? = some te) :
    R.slotFwd π o = te.2.isLeft ∧ R.slotQ π o = some te.2 := by
  have hq : R.slotQ π o = some te.2 := by simp [slotQ, hte]
  refine ⟨?_, hq⟩
  simp only [slotFwd, hq]
  rcases te.2 with x | y <;> rfl

set_option maxHeartbeats 2000000 in
/-- **Direct charges** read the seed's crediting show. -/
theorem sound_direct (a : {a // a ∈ R.realizedSeeds s π})
    (hf : R.pairForward (R.firstCrossing s π) π
      (R.pinCell (R.firstCrossing s π) π a.1).pair = true)
    (he : R.pinCell (R.firstCrossing s π) π a.1 = a.1) :
    R.SeedSound (R.firstCrossing s π)
      (R.pairStep (R.firstCrossing s π) π (R.pinCell (R.firstCrossing s π) π a.1).pair) π
      (R.v6Code hP s π hcross a) (R.v6Ptr hP s π hcross a) a.1.part := by
  classical
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  have hev := R.realizedSeed_cell_valid s π a
  obtain ⟨q, hq, hfr, hcase, hdir⟩ := R.charge_query π hcut (R.atomValid_pair hev)
  have hqf : q = ⟨(), .inl (R.xin π (R.pinCell (R.firstCrossing s π) π a.1).pair.1
      (R.pinCell (R.firstCrossing s π) π a.1).pair.2)⟩ := by
    rcases hcase with h | h
    · exact h
    · rw [h, hf] at hdir; simp [qFwd] at hdir
  have hf' : R.pairForward (R.firstCrossing s π) π a.1.pair = true := he ▸ hf
  have hqF : qFwd q = true := by rw [← hdir]; exact hf
  have hptr : R.v6Ptr hP s π hcross a = .inl (R.sourceCommitProgramPos hP s π hcross a) := by
    simp only [v6Ptr, hf, he, hf', ↓reduceIte]
  have hsrcR : R.roundStart π (R.sourceCommitRound hP s π hcross a) ≤
      R.pairStep (R.firstCrossing s π) π (R.pinCell (R.firstCrossing s π) π a.1).pair :=
    R.v6_source_round_le_charge hP s π hcross a
  have hstart := R.sourceRound_start_le_cut hP s π hcross a
  have hτD := (R.sourceCommitRound_spec hP s π hcross a).1
  have hsrc := R.source_obs hP s π hcross a
  have hans : ans (fun _ : Unit => π) q = π (R.xin π a.1.pair.1 a.1.pair.2) := by
    rw [hqf, he]; rfl
  rw [hptr]
  obtain ⟨a₀, ha₀⟩ := a
  rcases a₀ with ⟨qa⟩ | ⟨qa⟩
  · -- an `r` seed
    have hcode : R.v6Code hP s π hcross ⟨.r qa, ha₀⟩ =
        (let o := R.sourceCommitProgramPos hP s π hcross ⟨.r qa, ha₀⟩
         if o.2.val = R.Q then (.r, qa.1)
         else if R.slotFwd π o then
           (if qa.2 = ovCalls R.G qa.1 then (.r, qa.1) else (.h, row1 qa.1))
         else (.r, rowLast qa.1)) := by
      simp only [v6Code, hf, he, hf', ↓reduceIte]
      rfl
    rw [hcode]
    have hqa : qa ∈ R.posSet := R.realized_atom_valid s π ha₀
    rcases R.commit_r_obs hsrc with ⟨hkQ, hpad, hval, hdep⟩ | ⟨hkQ, te, hte, hteτ, hcases⟩
    · refine R.seedSound_intro hq hfr ⟨.run, .r, some qa.1⟩ ?_ rfl ?_
        (R.sourceCommitRound hP s π hcross ⟨.r qa, ha₀⟩) hτD hsrcR hstart ?_
      · simp only [hkQ, ↓reduceIte, v6Decode, hqF]
      · simp only [PinReads, readR, rowXor, hans]
        change R.rVal π qa = _
        exact hval
      · simp only [SlotAccess, hkQ, lt_irrefl, ↓reduceIte]
        exact hdep.le
    · have hk' : ¬ (R.sourceCommitProgramPos hP s π hcross ⟨.r qa, ha₀⟩).2.val = R.Q := by omega
      obtain ⟨hsf, hsq⟩ := R.slotFwd_of_tr hte
      have hacc : ∀ ins : V6Instr B, ins.src = .raw →
          R.SlotAccess π (R.sourceCommitRound hP s π hcross ⟨.r qa, ha₀⟩)
            ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π)
              (R.pairStep (R.firstCrossing s π) π
                (R.pinCell (R.firstCrossing s π) π (VAtom.r qa)).pair)) ins
            (.inl (R.sourceCommitProgramPos hP s π hcross ⟨.r qa, ha₀⟩)) := by
        intro ins hraw
        simp only [SlotAccess, hkQ, ↓reduceIte]
        refine ⟨by rw [hraw]; decide, te, hte, hteτ.le, fun hn => ?_⟩
        rcases hn with ⟨h, -⟩ | ⟨h, -⟩ <;> rw [hraw] at h <;> cases h
      rcases hcases with ⟨x, hx, hv⟩ | ⟨y, hy, hv⟩
      · have hsf' : R.slotFwd π (R.sourceCommitProgramPos hP s π hcross ⟨.r qa, ha₀⟩) = true := by
          rw [hsf, hx]; rfl
        have hpt : R.slotPoint π .raw (R.sourceCommitProgramPos hP s π hcross ⟨.r qa, ha₀⟩) = x := by
          simp only [slotPoint, hsq, hx]; rfl
        by_cases hpad : qa.2 = ovCalls R.G qa.1
        · refine R.seedSound_intro hq hfr ⟨.raw, .r, some qa.1⟩ ?_ rfl ?_
            (R.sourceCommitRound hP s π hcross ⟨.r qa, ha₀⟩) hτD hsrcR hstart (hacc _ rfl)
          · simp only [hk', hsf', hpad, ↓reduceIte, v6Decode, hqF, ptrFwd]
          · simp only [PinReads, readR, rowXor, hans, hpt]
            change R.rVal π qa = _
            rw [hv, if_pos hpad]
        · have hB : 2 ≤ B := R.two_le_B_of_calls hqa (by
            have := (R.mem_posSet.1 hqa).2; omega)
          have h1 : (row1 qa.1).val ≠ 0 := by rw [row1_val hB]; omega
          refine R.seedSound_intro hq hfr ⟨.raw, .r, none⟩ ?_ rfl ?_
            (R.sourceCommitRound hP s π hcross ⟨.r qa, ha₀⟩) hτD hsrcR hstart (hacc _ rfl)
          · simp only [hk', hsf', hpad, ↓reduceIte, v6Decode, hqF, ptrFwd, h1]
          · simp only [PinReads, readR, rowXor, hans, hpt]
            change R.rVal π qa = _
            rw [hv, if_neg hpad]
      · have hsf' : R.slotFwd π (R.sourceCommitProgramPos hP s π hcross ⟨.r qa, ha₀⟩) = false := by
          rw [hsf, hy]; rfl
        have hpt : R.slotPoint π .raw (R.sourceCommitProgramPos hP s π hcross ⟨.r qa, ha₀⟩) = y := by
          simp only [slotPoint, hsq, hy]; rfl
        have hlast : (rowLast qa.1).val + 1 = B := by
          simp only [rowLast]; have := qa.1.isLt; omega
        refine R.seedSound_intro hq hfr ⟨.raw, .r, none⟩ ?_ rfl ?_
          (R.sourceCommitRound hP s π hcross ⟨.r qa, ha₀⟩) hτD hsrcR hstart (hacc _ rfl)
        · simp only [hk', hsf', ↓reduceIte, v6Decode, hqF, ptrFwd, hlast, Bool.false_eq_true]
        · simp only [PinReads, readR, rowXor, hans, hpt]
          exact hv
  · -- an `h` seed
    have hcode : R.v6Code hP s π hcross ⟨.h qa, ha₀⟩ = (.h, row0 qa.1) := by
      simp only [v6Code, hf, he, hf', ↓reduceIte] <;> rfl
    rw [hcode]
    obtain ⟨hkQ, te, hte, hteτ, hv⟩ := R.commit_h_obs hsrc
    have hk' : ¬ (R.sourceCommitProgramPos hP s π hcross ⟨.h qa, ha₀⟩).2.val = R.Q := by omega
    obtain ⟨hsf, hsq⟩ := R.slotFwd_of_tr hte
    have hpt : R.slotPoint π .raw (R.sourceCommitProgramPos hP s π hcross ⟨.h qa, ha₀⟩) =
        Sum.elim id id te.2 := by
      simp only [slotPoint, hsq]
    have hdec : R.v6Decode (.h, row0 qa.1) (qFwd q)
        (.inl (R.sourceCommitProgramPos hP s π hcross ⟨.h qa, ha₀⟩))
        (R.ptrFwd π (.inl (R.sourceCommitProgramPos hP s π hcross ⟨.h qa, ha₀⟩))) =
        ⟨.raw, .h, none⟩ := by
      have h0 : (row0 qa.1).val = 0 := rfl
      cases hs : R.slotFwd π (R.sourceCommitProgramPos hP s π hcross ⟨.h qa, ha₀⟩) <;>
        simp only [hk', hs, ↓reduceIte, v6Decode, hqF, ptrFwd, h0, Bool.false_eq_true]
    refine R.seedSound_intro hq hfr ⟨.raw, .h, none⟩ hdec rfl ?_
      (R.sourceCommitRound hP s π hcross ⟨.h qa, ha₀⟩) hτD hsrcR hstart ?_
    · simp only [PinReads, readH, hans, hpt]
      rw [show ovH (π (R.xin π (VAtom.h qa).pair.1 (VAtom.h qa).pair.2)) = R.hVal π qa from rfl, hv]
      rcases te.2 with x | y <;> rfl
    · simp only [SlotAccess, hkQ, ↓reduceIte]
      refine ⟨by decide, te, hte, hteτ.le, fun hn => ?_⟩
      rcases hn with ⟨h, -⟩ | ⟨h, -⟩ <;> cases h

theorem pinPartner_r_some {q : Fin B × ℕ} {b : VAtom B} (h : R.pinPartner (.r q) = some b) :
    q ∈ R.posSet ∧ ∃ u, ovBlock R.G q.1 q.2 = some u ∧ b = .r (u, ovCalls R.G u) := by
  simp only [pinPartner] at h
  split at h
  · rename_i hq
    cases hb : ovBlock R.G q.1 q.2 with
    | none => rw [hb] at h; simp at h
    | some u =>
        rw [hb] at h
        exact ⟨hq, u, rfl, (Option.some.inj h).symm⟩
  · simp at h

theorem pinPartner_h_some {q : Fin B × ℕ} {b : VAtom B} (h : R.pinPartner (.h q) = some b) :
    q ∈ R.posSet ∧ 2 ≤ q.2 ∧ b = .h (q.1, q.2 - 1) := by
  simp only [pinPartner] at h
  split at h
  · rename_i hq
    exact ⟨hq.1, hq.2, (Option.some.inj h).symm⟩
  · simp at h

include hP hcross in
theorem firstCrossing_roundEnd : ∃ τc ≤ R.D, R.firstCrossing s π = R.roundStart π (τc + 1) := by
  obtain ⟨a', ha'⟩ := (R.sourceCommitExact hP s π hcross).hits_cut
  have hsrc := R.sourceCommitRound_spec hP s π hcross a'
  refine ⟨_, hsrc.1, ?_⟩
  rw [← ha']
  unfold commitCut
  rw [R.sc_roundStart_succ]

/-- The slot of a fixing step: the step's own entry, if the input was not fixed before it. -/
theorem fixSlot_last {cut d : ℕ} (hcut : cut ≤ R.programSteps π) {X : Bits (ℓ + (ℓ + c))}
    {qd : Qry (BandAlpha ℓ c)}
    (hqd : (R.stratC cut).next ((R.stratC cut).hist (fun _ : Unit => π) d) = some qd)
    (h0 : X ∉ ((R.stratC cut).hist (fun _ : Unit => π) d).dom ())
    {te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))}
    (hmem : qEntry (fun _ : Unit => π) bandEnc te.2 ∈
      (R.stratC cut).hist (fun _ : Unit => π) (d + 1))
    (hrev : revealPt π te.2 = X) : bandEnc te.2 = qd := by
  rw [(R.stratC cut).hist_succ_of_some hqd] at hmem
  rcases List.mem_append.1 hmem with h | h
  · exfalso
    apply h0
    refine History.mem_dom.2 ⟨_, h, ?_⟩
    rw [qEntry_inpAt_revealPt π te.2, hrev]
  · have h := List.mem_singleton.1 h
    exact (Sigma.mk.inj_iff.1 h).1

set_option maxHeartbeats 4000000 in
/-- **Transfers** read the answer of the chain's last inverse step. -/
theorem sound_transfer (a : {a // a ∈ R.realizedSeeds s π})
    (hf : R.pairForward (R.firstCrossing s π) π
      (R.pinCell (R.firstCrossing s π) π a.1).pair = true)
    (he : R.pinCell (R.firstCrossing s π) π a.1 ≠ a.1) :
    R.SeedSound (R.firstCrossing s π)
      (R.pairStep (R.firstCrossing s π) π (R.pinCell (R.firstCrossing s π) π a.1).pair) π
      (R.v6Code hP s π hcross a) (R.v6Ptr hP s π hcross a) a.1.part := by
  classical
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  have hev := R.realizedSeed_cell_valid s π a
  obtain ⟨q, hq, hfr, hcase, hdir⟩ := R.charge_query π hcut (R.atomValid_pair hev)
  have hqF : qFwd q = true := by rw [← hdir]; exact hf
  have hqf : q = ⟨(), .inl (R.xin π (R.pinCell (R.firstCrossing s π) π a.1).pair.1
      (R.pinCell (R.firstCrossing s π) π a.1).pair.2)⟩ := by
    rcases hcase with h | h
    · exact h
    · rw [h] at hqF; simp [qFwd] at hqF
  obtain ⟨k, hk, hy⟩ := R.prevCell_spec (R.firstCrossing s π) π he
  set e := R.pinCell (R.firstCrossing s π) π a.1 with he_def
  set y := R.prevCell (R.firstCrossing s π) π a.1 with hy_def
  have hyv : R.atomValid y := R.pinNextN_valid k (R.realized_atom_valid s π a.2) hk
  obtain ⟨hyf, hyp, -⟩ := R.pinNext_some hy
  have hyq := R.atomValid_pair hyv
  have hdcut := R.inverse_step_lt_cut hcut hyq hyf
  obtain ⟨qd, hqd, -, hcased, hdird⟩ := R.charge_query π hcut hyq
  have hqdi : qd = ⟨(), .inr (π (R.xin π y.pair.1 y.pair.2))⟩ := by
    rcases hcased with h | h
    · rw [h, hyf] at hdird; simp [qFwd] at hdird
    · exact h
  obtain ⟨τc, hτc, hend⟩ := R.firstCrossing_roundEnd hP s π hcross
  have hdle := R.pinNext_step_le hP hcut hend hτc hyv hy
  have hdn : R.pairStep (R.firstCrossing s π) π y.pair <
      R.pairStep (R.firstCrossing s π) π e.pair := by
    rcases Nat.lt_or_eq_of_le hdle with h | h
    · exact h
    · exfalso
      rw [h, hq] at hqd
      obtain rfl := Option.some.inj hqd
      rw [hqdi] at hqF
      simp [qFwd] at hqF
  have hyfix := (R.pairStep_spec π hcut hyq)
  have hptr0 : R.v6Ptr hP s π hcross a =
      R.fixSlot (R.firstCrossing s π) π (R.pairStep (R.firstCrossing s π) π y.pair + 1)
        (R.xin π y.pair.1 y.pair.2) (.inr ⟨e.pair, R.atomValid_pair hev⟩) := by
    simp only [v6Ptr, ← he_def, ← hy_def, hf, he, ↓reduceIte]
  obtain ⟨o, hptr, te, hkQ, hte, hρ, hD, hmem, hrev⟩ :=
    R.fixSlot_spec hP hcut (by omega) hyfix.2.2 (.inr ⟨e.pair, R.atomValid_pair hev⟩)
  rw [hptr0, hptr]
  have hbe := R.fixSlot_last π hcut hqd hyfix.2.1 hmem hrev
  have hte2 : te.2 = .inr (π (R.xin π y.pair.1 y.pair.2)) := by
    rw [hqdi] at hbe
    simp only [bandEnc, Sigma.mk.inj_iff, heq_eq_eq, true_and] at hbe
    exact hbe
  obtain ⟨hsf, hsq⟩ := R.slotFwd_of_tr hte
  have hsf' : R.slotFwd π o = false := by rw [hsf, hte2]; rfl
  have hk' : ¬ o.2.val = R.Q := by omega
  have hpt : R.slotPoint π .inp o = R.xin π y.pair.1 y.pair.2 := by
    simp only [slotPoint, hsq, hte2, revealPt, Equiv.symm_apply_apply]
  have hans : ans (fun _ : Unit => π) q = π (R.xin π e.pair.1 e.pair.2) := by rw [hqf]; rfl
  have hpartE : e.part = a.1.part := R.pinCell_part _ π a.1
  have hacc : ∀ ins : V6Instr B, ins.src = .inp →
      R.SlotAccess π te.1 ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π)
        (R.pairStep (R.firstCrossing s π) π e.pair)) ins (.inl o) := by
    intro ins hinp
    simp only [SlotAccess, hkQ, ↓reduceIte]
    refine ⟨by rw [hinp]; decide, te, hte, le_rfl, fun _ => ?_⟩
    exact ((R.stratC _).hist_prefix _ (by omega)).subset hmem
  rcases hyc : y with ⟨qy⟩ | ⟨qy⟩
  · -- `r` transfer: the partner is the parent's pad key
    rw [hyc] at hyp
    obtain ⟨hqy, u, hu, heu⟩ := R.pinPartner_r_some hyp
    have hcode : R.v6Code hP s π hcross a = (.r, u) := by
      simp only [v6Code, ← he_def, hf, he, ↓reduceIte]
      simp only [heu]
    rw [hcode]
    have hu1 := R.parent_row_lt hu
    have hu1' : ¬ u.val + 1 = B := by omega
    refine R.seedSound_intro hq hfr ⟨.inp, .r, some u⟩ ?_ ?_ ?_ te.1 hD (by omega) (by omega)
      (hacc _ rfl)
    · simp only [hk', hsf', ↓reduceIte, v6Decode, hqF, ptrFwd, hu1', Bool.false_eq_true]
    · rw [← hpartE, heu]; rfl
    · simp only [PinReads, readR, rowXor, hans, hpt]
      rw [heu]
      change R.rVal π (u, ovCalls R.G u) = _
      rw [R.rVal_pad_eq, hyc]
      exact congrArg (fun z => bxor z (R.Wb u)) (R.ovR_xin_block π hqy hu).symm
  · -- `h` transfer: the partner is the previous chaining value
    rw [hyc] at hyp
    obtain ⟨hqy, h2, heh⟩ := R.pinPartner_h_some hyp
    have hB : 2 ≤ B := R.two_le_B_of_calls (q := (qy.1, qy.2 - 1))
      (R.mem_posSet.2 ⟨by omega, by have := (R.mem_posSet.1 hqy).2; simp; omega⟩)
      (by have := (R.mem_posSet.1 hqy).2; simp; omega)
    have hcode : R.v6Code hP s π hcross a = (.h, row1 a.1.pair.1) := by
      simp only [v6Code, ← he_def, hf, he, ↓reduceIte]
      simp only [heh]
    rw [hcode]
    have h1 : ¬ (row1 a.1.pair.1).val = 0 := by rw [row1_val hB]; omega
    refine R.seedSound_intro hq hfr ⟨.inp, .h, none⟩ ?_ ?_ ?_ te.1 hD (by omega) (by omega)
      (hacc _ rfl)
    · simp only [hk', hsf', ↓reduceIte, v6Decode, hqF, ptrFwd, h1, Bool.false_eq_true]
    · rw [← hpartE, heh]; rfl
    · simp only [PinReads, readH, hans, hpt]
      rw [heh, hyc]
      exact (R.ovH_xin_prev π hqy h2).symm

