set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# The band game as one lazy-perm strategy: adversary threads, then the honest labeller

Work file of `bc-a359729a`, for `bc-35b053cc`'s band `pr_EvR` (`internal/p3-instantiation/chain-epf-interface.md`, split
of 06:49Z). It edits no file of `bc-35b053cc`.

**The strategy** (`bandStrategy R`). It is `LazyPerm.Strategy.ofRounds` over the threads `ths = [some 0, …, some (B−1),
none]`, for `D + |posSet|` rounds:
- thread `some i` is the adversary's program `R.P i` (`toRProg`);
- thread `none` is the **honest labeller** (`labThread`). It stays idle for the `D` online rounds, then computes the
  chain block by block in topological order (`labR`): one forward `Π₂` query per chain input, each block's label
  passed forward to its children.

**What it gives.**
- `bandSeq_eq`: the query sequence is every adversary query, round by round and thread by thread, then the honest
  chain points in order, `honestSeq = chainInputList 0 ++ … ++ chainInputList (B−1)`.
- `labeller_hist` and `labeller_next`: at step `|advSeq| + k` the history is the adversary part followed by the first
  `k` honest points, and the next query is honest point `k`.
- `xin_mem_honestSeq`: every chain point `xin v p` with `(v, p) ∈ posSet` is an honest point.
- `labeller_fresh`: a point the adversary never asks is `Fresh` at its first honest step. So a committed but never-asked
  item is charged at the step that first samples its point.
- `bandSeq_length`: there are `Σ |tr i| + |posSet|` steps in all (`≤ nPos` by `steps_le_nPos`).
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

/-! ### Round programs -/

/-- `idealPerm`'s answers, as a plain function: forward `σ x`, inverse `σ⁻¹ y`. -/
def bandAnswer {n : ℕ} (σ : Equiv.Perm (Bits n)) : Bits n ⊕ Bits n → Bits n
  | .inl x => σ x
  | .inr y => σ.symm y

theorem bandAnswer_eq {n : ℕ} (σ : Equiv.Perm (Bits n)) : bandAnswer σ = (idealPerm n).answer σ := by
  funext q; cases q <;> rfl

/-- The thread order: the adversary's threads, then the labeller. -/
def bandThs (B : ℕ) : List (Option (Fin B)) := (List.finRange B).map some ++ [none]

/-- A Pous program as a lazy-perm round program. -/
def toRProg {M : IdealModel} {X : Type} : Prog M X → LazyPerm.RProg M.Qry M.Ans X
  | .ret x => .ret x
  | .round qs k => .round qs (fun as => toRProg (k as))

theorem trace_toRProg {M : IdealModel} {X : Type} (f : M.Qry → M.Ans) (P : Prog M X) :
    (toRProg P).trace f = PousB5Chain.trace f P := by
  induction P with
  | ret x => rfl
  | round qs k ih => simp only [toRProg, LazyPerm.RProg.trace, PousB5Chain.trace, ih]

/-- An `idealPerm` program as a round program over explicit `Bits` queries and answers. -/
def toRProgI {n : ℕ} {X : Type} : Prog (idealPerm n) X → LazyPerm.RProg (Bits n ⊕ Bits n) (Bits n) X
  | .ret x => .ret x
  | .round qs k => .round qs (fun as => toRProgI (k as))

theorem trace_toRProgI {n : ℕ} {X : Type} (f : Bits n ⊕ Bits n → Bits n) (P : Prog (idealPerm n) X) :
    (toRProgI P).trace f = PousB5Chain.trace f P := by
  induction P with
  | ret x => rfl
  | round qs k ih =>
    exact congrArg (fun L => qs.map (fun x => (0, x)) ++ L.map (fun e => (e.1 + 1, e.2))) (ih (qs.map f))

/-- Idle for `d` rounds (rounds with no query), then run `P`. -/
def idle {Q A X : Type} : ℕ → LazyPerm.RProg Q A X → LazyPerm.RProg Q A X
  | 0, P => P
  | d + 1, P => .round [] (fun _ => idle d P)

section Labeller

variable {ℓ c : ℕ}

/-- The overwrite chain as rounds: one forward query per block, then `k` on the final pair. -/
def chainR {X : Type} (p : Bits ℓ × Bits (ℓ + c)) :
    List (Bits ℓ) → (Bits ℓ × Bits (ℓ + c) → LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))
      (Bits (ℓ + (ℓ + c))) X) → LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) (Bits (ℓ + (ℓ + c))) X
  | [], k => k p
  | blk :: blks, k => .round [.inl (Fin.append blk p.2)] fun ys =>
      chainR (ovR (ys.headD (Fin.append blk p.2)), ovH (ys.headD (Fin.append blk p.2))) blks k

theorem ret_roundQs {Q A X : Type} (f : Q → A) (x : X) :
    ∀ ρ, (LazyPerm.RProg.ret x : LazyPerm.RProg Q A X).roundQs f ρ = []
  | 0 => rfl
  | ρ + 1 => ret_roundQs f x ρ

theorem idle_roundQs {Q A X : Type} (f : Q → A) (P : LazyPerm.RProg Q A X) :
    ∀ (d ρ : ℕ), (idle d P).roundQs f ρ = if ρ < d then [] else P.roundQs f (ρ - d)
  | 0, ρ => by simp [idle]
  | d + 1, 0 => by simp [idle, LazyPerm.RProg.roundQs_zero, LazyPerm.RProg.qs]
  | d + 1, ρ + 1 => by
    rw [LazyPerm.RProg.roundQs_succ]
    show (idle d P).roundQs f ρ = _
    rw [idle_roundQs f P d ρ]
    simp only [Nat.add_lt_add_iff_right, Nat.add_sub_add_right]

/-- **The chain's rounds.** Round `j < |blks|` asks the `j`-th overwrite input; later rounds are the continuation's. -/
theorem chainR_roundQs {X : Type} (f : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c)))
    (k : Bits ℓ × Bits (ℓ + c) → LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) (Bits (ℓ + (ℓ + c))) X) :
    ∀ (blks : List (Bits ℓ)) (p : Bits ℓ × Bits (ℓ + c)) (j : ℕ),
      (chainR p blks k).roundQs f j =
        if j < blks.length then ((ovInputs (fun x => f (.inl x)) p blks)[j]?).toList.map Sum.inl
        else (k (blks.foldl (ovStep (fun x => f (.inl x))) p)).roundQs f (j - blks.length)
  | [], p, j => by simp [chainR]
  | blk :: blks, p, 0 => by
    simp [chainR, LazyPerm.RProg.roundQs_zero, LazyPerm.RProg.qs, ovInputs]
  | blk :: blks, p, j + 1 => by
    rw [LazyPerm.RProg.roundQs_succ]
    show (chainR (ovR (([Sum.inl (Fin.append blk p.2)].map f).headD (Fin.append blk p.2)),
      ovH (([Sum.inl (Fin.append blk p.2)].map f).headD (Fin.append blk p.2))) blks k).roundQs f j = _
    rw [chainR_roundQs f k blks _ j]
    simp only [List.map_cons, List.map_nil, List.headD_cons, List.length_cons, Nat.add_lt_add_iff_right,
      ovInputs, List.getElem?_cons_succ, List.foldl_cons, Nat.add_sub_add_right]
    rfl

end Labeller

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- **The labeller from block `k` on.** `acc` holds the labels of the blocks before `k`. Block `k`'s chain absorbs its
parents' labels, newest first, then the pad; its label (`r` of the pad call `⊕ Wb k`) is passed on. -/
def labR : (k : ℕ) → (Fin B → Bits ℓ) →
    LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) (Bits (ℓ + (ℓ + c))) (Bits ℓ)
  | k, acc =>
    if hk : k < B then
      chainR (fun _ => false, iv (R.dom k)) (absorbedG R.G acc ⟨k, hk⟩) fun p =>
        labR (k + 1) (Function.update acc ⟨k, hk⟩ (bxor p.1 (R.Wb ⟨k, hk⟩)))
    else .ret (fun _ => false)
  termination_by k => B - k

/-- The honest labeller thread: idle for the `D` online rounds, then the chain. -/
def labThread : LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) (Bits (ℓ + (ℓ + c))) (Bits ℓ) :=
  idle R.D (R.labR 0 (fun _ _ => false))

/-- The labeller's queries from block `k` on, when forward queries are answered by `f'` (`labR`'s fold, flattened). -/
def honestFrom (f' : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) : (k : ℕ) → (Fin B → Bits ℓ) →
    List (Bits (ℓ + (ℓ + c)))
  | k, acc =>
    if hk : k < B then
      ovInputs f' (fun _ => false, iv (R.dom k)) (absorbedG R.G acc ⟨k, hk⟩) ++
        honestFrom f' (k + 1) (Function.update acc ⟨k, hk⟩
          (bxor ((absorbedG R.G acc ⟨k, hk⟩).foldl (ovStep f') (fun _ => false, iv (R.dom k))).1 (R.Wb ⟨k, hk⟩)))
    else []
  termination_by k => B - k

/-- **The labeller's rounds**: round `j` asks the `j`-th entry of `honestFrom`. -/
theorem labR_roundQs (f : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) :
    ∀ (k : ℕ) (acc : Fin B → Bits ℓ) (j : ℕ),
      (R.labR k acc).roundQs f j = ((R.honestFrom (fun x => f (.inl x)) k acc)[j]?).toList.map Sum.inl := by
  intro k
  induction h : B - k using Nat.strong_induction_on generalizing k with
  | _ n ih =>
    intro acc j
    rw [labR, honestFrom]
    by_cases hk : k < B
    · simp only [hk, ↓reduceDIte]
      rw [chainR_roundQs]
      by_cases hj : j < (absorbedG R.G acc ⟨k, hk⟩).length
      · rw [ite_eq_left hj, List.getElem?_append_left (by rw [ovInputs_length]; exact hj)]
      · rw [ite_eq_right hj, ih (B - (k + 1)) (by omega) (k + 1) rfl,
          List.getElem?_append_right (by rw [ovInputs_length]; omega), ovInputs_length]
    · simp only [hk, ↓reduceDIte]
      rw [ret_roundQs]
      simp

/-- The labeller thread's rounds: idle before `D`, then `honestFrom`. -/
theorem labThread_roundQs (f : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (ρ : ℕ) :
    R.labThread.roundQs f ρ =
      if ρ < R.D then [] else ((R.honestFrom (fun x => f (.inl x)) 0 (fun _ _ => false))[ρ - R.D]?).toList.map Sum.inl := by
  rw [labThread, idle_roundQs, R.labR_roundQs]

/-- **The labeller's queries are the honest chain points.** Under a permutation, `honestFrom` from block `k` (with the
true labels before `k`) is the chain inputs of blocks `k, …, B−1`. -/
theorem honestFrom_eq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    ∀ (k : ℕ) (acc : Fin B → Bits ℓ), (∀ u : Fin B, u.val < k → acc u = labelG R.G (fun x => π x) R.dom R.Wb u) →
      R.honestFrom (fun x => π x) k acc = ((List.finRange B).drop k).flatMap (R.chainInputList π) := by
  intro k
  induction h : B - k using Nat.strong_induction_on generalizing k with
  | _ n ih =>
    intro acc hacc
    rw [honestFrom]
    by_cases hk : k < B
    · simp only [hk, ↓reduceDIte]
      have habs : absorbedG R.G acc ⟨k, hk⟩ = absorbedG R.G (labelG R.G (fun x => π x) R.dom R.Wb) ⟨k, hk⟩ := by
        unfold absorbedG
        congr 1
        exact List.map_congr_left fun u hu => hacc u (parentsDesc_lt R.G hu)
      have hlab : bxor ((absorbedG R.G acc ⟨k, hk⟩).foldl (ovStep (fun x => π x)) (fun _ => false, iv (R.dom k))).1
          (R.Wb ⟨k, hk⟩) = labelG R.G (fun x => π x) R.dom R.Wb ⟨k, hk⟩ := by
        rw [labelG_eq, habs]
        rfl
      rw [hlab, ih (B - (k + 1)) (by omega) (k + 1) rfl _ (fun u hu => ?_)]
      · rw [List.drop_eq_getElem_cons (i := k) (l := List.finRange B) (by simp; exact hk), List.flatMap_cons, List.getElem_finRange]
        simp only [Fin.cast_mk]
        rw [habs]
        rfl
      · by_cases huk : u = ⟨k, hk⟩
        · rw [huk, Function.update_self]
        · rw [Function.update_of_ne huk]
          exact hacc u (lt_of_le_of_ne (Nat.lt_succ_iff.1 hu) (fun h => huk (Fin.ext h)))
    · simp only [hk, ↓reduceDIte]
      rw [List.drop_eq_nil_of_le (by simp; omega), List.flatMap_nil]

/-- The threads: the adversary's `B` programs (`some i`) and the labeller (`none`). -/
def bandThreads : Option (Fin B) →
    LazyPerm.RProg (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) (Bits (ℓ + (ℓ + c))) (Bits ℓ)
  | some i => toRProgI (R.P i)
  | none => R.labThread


/-- The one-component oracle of the band game. -/
abbrev BandAlpha (ℓ c : ℕ) : Unit → Type := fun _ => Bits (ℓ + (ℓ + c))

/-- A band query as a lazy-perm query. -/
def bandEnc (q : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) : LazyPerm.Qry (BandAlpha ℓ c) := ⟨(), q⟩

/-- A lazy-perm answer as a band answer. -/
def bandDec (e : LazyPerm.Entry (BandAlpha ℓ c)) : Bits (ℓ + (ℓ + c)) := e.2

/-- **The band game as one strategy**: the adversary's threads and the labeller, in lockstep, for `D + |posSet|` rounds. -/
def bandStrategy : LazyPerm.Strategy (BandAlpha ℓ c) :=
  LazyPerm.Strategy.ofRounds (bandThs B) (R.D + R.posSet.card) R.bandThreads bandEnc bandDec (fun _ => none)

/-- The answers the strategy's threads see: `idealPerm`'s (`bandAnswer_eq`), for `π ()`. -/
theorem bandAns (π : LazyPerm.Oracle (BandAlpha ℓ c)) :
    (fun q => bandDec (LazyPerm.qEntry π bandEnc q)) = bandAnswer (π ()) := by
  funext q; cases q <;> rfl

/-- The honest chain points, block by block: `chainInputList 0 ++ … ++ chainInputList (B−1)`. -/
noncomputable def honestSeq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : List (Bits (ℓ + (ℓ + c))) :=
  (List.finRange B).flatMap (R.chainInputList π)

/-- The adversary's queries, round by round and thread by thread. -/
noncomputable def advSeq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : List (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) :=
  (List.range R.D).flatMap fun ρ => (List.finRange B).flatMap fun i =>
    (toRProgI (R.P i)).roundQs (bandAnswer π) ρ

theorem bandThs_nodup (B : ℕ) : (bandThs B).Nodup := by
  unfold bandThs
  rw [List.nodup_append]
  refine ⟨(List.nodup_finRange B).map (fun _ _ h => Option.some_injective _ h), List.nodup_singleton _, ?_⟩
  intro a ha b hb hab
  rw [List.mem_singleton] at hb
  obtain ⟨i, -, rfl⟩ := List.mem_map.1 ha
  rw [hb] at hab
  exact Option.some_ne_none _ hab

/-- An adversary thread's round-program trace is its transcript `R.tr`. -/
theorem advTrace_eq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B) :
    (toRProgI (R.P i)).trace (bandAnswer π) = R.tr π i :=
  trace_toRProgI (bandAnswer π) (R.P i)

/-- A `(D, Q)`-bounded adversary thread asks nothing from round `D` on. -/
theorem adv_roundQs_nil (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (i : Fin B)
    {ρ : ℕ} (hρ : R.D ≤ ρ) : (toRProgI (R.P i)).roundQs (bandAnswer π) ρ = [] := by
  rw [LazyPerm.RProg.roundQs_eq_trace, R.advTrace_eq, List.filterMap_eq_nil_iff]
  intro e he
  have h1 := PousB5Chain.round_lt_depth ((idealPerm (ℓ + (ℓ + c))).answer π) (R.P i) e he
  have h2 := (hP i π).1
  rw [ite_eq_right_iff]
  intro heq
  omega

theorem flatMap_range_getElem? {α β : Type} (g : α → β) :
    ∀ H : List α, (List.range H.length).flatMap (fun k => (H[k]?).toList.map g) = H.map g
  | [] => rfl
  | a :: H => by
    rw [List.length_cons, List.range_succ_eq_map, List.flatMap_cons, List.flatMap_map]
    simp only [List.getElem?_cons_zero, Option.toList_some, List.map_cons, List.map_nil, Function.comp_def,
      List.getElem?_cons_succ, List.singleton_append, List.map_cons]
    rw [flatMap_range_getElem? g H]

/-- The number of chain positions is the number of chain calls. -/
theorem card_posSet_eq : R.posSet.card = ∑ v : Fin B, ovCalls R.G v := by
  classical
  have heq : R.posSet = Finset.univ.biUnion
      (fun v : Fin B => (Finset.Icc 1 (ovCalls R.G v)).image (fun p => (v, p))) := by
    ext q
    simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_image, Finset.mem_Icc, R.mem_posSet]
    constructor
    · rintro ⟨h1, h2⟩; exact ⟨q.1, q.2, ⟨h1, h2⟩, rfl⟩
    · rintro ⟨v, p, ⟨h1, h2⟩, rfl⟩; exact ⟨h1, h2⟩
  rw [heq, Finset.card_biUnion]
  · refine Finset.sum_congr rfl (fun v _ => ?_)
    rw [Finset.card_image_of_injective _ (fun a b h => (Prod.mk.inj h).2), Nat.card_Icc]
    omega
  · intro v _ w _ hvw
    simp only [Function.onFun, Finset.disjoint_left, Finset.mem_image]
    rintro q ⟨p, _, rfl⟩ ⟨p', _, h⟩
    exact hvw (congrArg Prod.fst h).symm

/-- There is one honest point per chain position. -/
theorem honestSeq_length (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : (R.honestSeq π).length = R.posSet.card := by
  rw [R.card_posSet_eq, honestSeq, List.length_flatMap, Fin.sum_univ_def]
  congr 1
  exact List.map_congr_left fun v _ => R.chainInputList_length π v

theorem honestFrom_zero (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    R.honestFrom (fun x => π x) 0 (fun _ _ => false) = R.honestSeq π := by
  rw [R.honestFrom_eq π 0 _ (fun u hu => absurd hu (Nat.not_lt_zero _)), List.drop_zero]
  rfl

/-- **The query sequence**: the adversary's queries, then the honest chain points. -/
theorem bandSeq_eq (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : LazyPerm.Oracle (BandAlpha ℓ c)) :
    LazyPerm.roundsSeq (bandThs B) (fun q => bandDec (LazyPerm.qEntry π bandEnc q)) (R.D + R.posSet.card)
        R.bandThreads
      = R.advSeq (π ()) ++ (R.honestSeq (π ())).map Sum.inl := by
  rw [bandAns, LazyPerm.roundsSeq_eq (bandThs_nodup B), List.range_add, List.flatMap_append]
  congr 1
  · unfold advSeq
    refine List.flatMap_congr (fun ρ hρ => ?_)
    rw [List.mem_range] at hρ
    simp only [bandThs, List.flatMap_append, List.flatMap_map, List.flatMap_cons, List.flatMap_nil, List.append_nil]
    rw [show R.bandThreads none = R.labThread from rfl, labThread_roundQs, ite_eq_left hρ, List.append_nil]
    rfl
  · rw [List.flatMap_map]
    have hrest : ∀ k ∈ List.range R.posSet.card,
        (bandThs B).flatMap (fun t => (R.bandThreads t).roundQs (bandAnswer (π ())) (R.D + k))
          = ((R.honestSeq (π ()))[k]?).toList.map Sum.inl := by
      intro k _
      simp only [bandThs, List.flatMap_append, List.flatMap_map, List.flatMap_cons, List.flatMap_nil,
        List.append_nil]
      have hadv : (List.finRange B).flatMap (fun i => (R.bandThreads (some i)).roundQs
          (bandAnswer (π ())) (R.D + k)) = [] :=
        List.flatMap_eq_nil_iff.2 fun i _ => R.adv_roundQs_nil hP (π ()) i (Nat.le_add_right _ _)
      rw [hadv, List.nil_append]
      rw [show R.bandThreads none = R.labThread from rfl, labThread_roundQs, ite_eq_right (by omega),
        Nat.add_sub_cancel_left]
      rw [show (fun x => bandAnswer (π ()) (Sum.inl x)) = fun x => (π ()) x from rfl,
        R.honestFrom_zero]
    rw [List.flatMap_congr hrest, ← R.honestSeq_length (π ()), flatMap_range_getElem?]

theorem len_flatMap_range {β : Type} (g : ℕ → List β) :
    ∀ D, ((List.range D).flatMap g).length = ∑ ρ ∈ Finset.range D, (g ρ).length
  | 0 => rfl
  | D + 1 => by
    rw [List.range_succ, List.flatMap_append, List.length_append, len_flatMap_range g D, Finset.sum_range_succ]
    simp

theorem len_flatMap_finRange {β : Type} (g : Fin B → List β) :
    ((List.finRange B).flatMap g).length = ∑ i : Fin B, (g i).length := by
  rw [List.length_flatMap, Fin.sum_univ_def]

theorem sum_filterMap_round {Q : Type} {D : ℕ} :
    ∀ (L : List (ℕ × Q)), (∀ e ∈ L, e.1 < D) →
      ∑ ρ ∈ Finset.range D, (L.filterMap (fun e => if e.1 = ρ then some e.2 else none)).length = L.length
  | [], _ => by simp
  | e :: L, hL => by
    have hstep : ∀ ρ, ((e :: L).filterMap (fun e => if e.1 = ρ then some e.2 else none)).length
        = (if e.1 = ρ then 1 else 0) + (L.filterMap (fun e => if e.1 = ρ then some e.2 else none)).length := by
      intro ρ
      by_cases h : e.1 = ρ
      · simp [List.filterMap_cons, h]; omega
      · simp [List.filterMap_cons, h]
    simp only [hstep, Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.mem_range,
      hL e (List.mem_cons_self), ↓reduceIte, sum_filterMap_round L (fun e' he' => hL e' (List.mem_cons_of_mem _ he')),
      List.length_cons]
    omega

/-- The number of steps: all adversary queries plus one per chain position. -/
theorem bandSeq_length (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : LazyPerm.Oracle (BandAlpha ℓ c)) :
    (R.advSeq (π ())).length + (R.honestSeq (π ())).length
      = (∑ i : Fin B, (R.tr (π ()) i).length) + R.posSet.card := by
  rw [R.honestSeq_length]
  congr 1
  unfold advSeq
  rw [len_flatMap_range]
  simp only [len_flatMap_finRange]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  simp only [LazyPerm.RProg.roundQs_eq_trace, R.advTrace_eq]
  refine sum_filterMap_round _ (fun e he => ?_)
  exact lt_of_lt_of_le (PousB5Chain.round_lt_depth ((idealPerm (ℓ + (ℓ + c))).answer (π ())) (R.P i) e he)
    (hP i (π ())).1

/-- Every adversary query is in the adversary's transcript. -/
theorem mem_advSeq {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {q : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))}
    (hq : q ∈ R.advSeq π) : ∃ i, ∃ e ∈ R.tr π i, e.2 = q := by
  unfold advSeq at hq
  obtain ⟨ρ, -, hq⟩ := List.mem_flatMap.1 hq
  obtain ⟨i, -, hq⟩ := List.mem_flatMap.1 hq
  rw [LazyPerm.RProg.roundQs_eq_trace, R.advTrace_eq, List.mem_filterMap] at hq
  obtain ⟨e, he, hsome⟩ := hq
  refine ⟨i, e, he, ?_⟩
  by_cases h : e.1 = ρ
  · rw [ite_eq_left h] at hsome; exact Option.some.inj hsome
  · rw [ite_eq_right h] at hsome; exact absurd hsome (by simp)

/-- **Every chain point is an honest point.** -/
theorem xin_mem_honestSeq (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) {q : Fin B × ℕ} (hq : q ∈ R.posSet) :
    R.xin π q.1 q.2 ∈ R.honestSeq π := by
  obtain ⟨h1, h2⟩ := R.mem_posSet.1 hq
  have hlt : q.2 - 1 < (R.chainInputList π q.1).length := by rw [R.chainInputList_length]; omega
  have hx : R.xin π q.1 q.2 = (R.chainInputList π q.1)[q.2 - 1] := by
    rw [xin, List.getElem?_eq_getElem hlt]; rfl
  rw [hx]
  exact List.mem_flatMap.2 ⟨q.1, List.mem_finRange _, List.getElem_mem hlt⟩

/-- **The labeller's history.** At step `|advSeq| + k` (for `k ≤ |honestSeq|`), the history is the adversary part
followed by the first `k` honest points, each with its answer. -/
theorem labeller_hist (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : LazyPerm.Oracle (BandAlpha ℓ c)) {k : ℕ}
    (hk : k ≤ (R.honestSeq (π ())).length) :
    R.bandStrategy.hist π ((R.advSeq (π ())).length + k)
      = (R.advSeq (π ())).map (LazyPerm.qEntry π bandEnc)
        ++ ((R.honestSeq (π ())).take k).map (fun x => LazyPerm.qEntry π bandEnc (.inl x)) := by
  have hlen : (R.advSeq (π ())).length + k ≤ (LazyPerm.roundsSeq (bandThs B)
      (fun q => bandDec (LazyPerm.qEntry π bandEnc q)) (R.D + R.posSet.card) R.bandThreads).length := by
    rw [R.bandSeq_eq hP π, List.length_append, List.length_map]; omega
  unfold bandStrategy
  rw [LazyPerm.Strategy.ofRounds_hist _ _ _ _ _ _ π _ hlen, R.bandSeq_eq hP π, List.take_append,
    List.take_of_length_le (by omega), Nat.add_sub_cancel_left, List.map_append, ← List.map_take, List.map_map]
  rfl

/-- **The labeller's step.** At step `|advSeq| + k` the next query is honest point `k`, forward. -/
theorem labeller_next (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : LazyPerm.Oracle (BandAlpha ℓ c)) {k : ℕ}
    (hk : k < (R.honestSeq (π ())).length) :
    R.bandStrategy.next (R.bandStrategy.hist π ((R.advSeq (π ())).length + k))
      = some (bandEnc (.inl ((R.honestSeq (π ()))[k]))) := by
  have hn : (R.advSeq (π ())).length + k < (LazyPerm.roundsSeq (bandThs B)
      (fun q => bandDec (LazyPerm.qEntry π bandEnc q)) (R.D + R.posSet.card) R.bandThreads).length := by
    rw [R.bandSeq_eq hP π, List.length_append, List.length_map]; omega
  have e1 : (LazyPerm.roundsSeq (bandThs B) (fun q => bandDec (LazyPerm.qEntry π bandEnc q)) (R.D + R.posSet.card)
      R.bandThreads)[(R.advSeq (π ())).length + k]? = some (Sum.inl ((R.honestSeq (π ()))[k])) := by
    rw [R.bandSeq_eq hP π, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left, List.getElem?_map,
      List.getElem?_eq_getElem hk]
    rfl
  rw [List.getElem?_eq_getElem hn] at e1
  unfold bandStrategy
  rw [LazyPerm.Strategy.ofRounds_next _ _ _ _ _ _ π hn, Option.some.inj e1]

/-- The input an entry fixes is the point its query reveals. -/
theorem inpAt_qEntry (π : LazyPerm.Oracle (BandAlpha ℓ c)) (q : Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))) :
    (LazyPerm.qEntry π bandEnc q).inpAt () = some (revealPt (π ()) q) := by
  cases q <;> rfl

/-- **A never-asked point is `Fresh` at its first honest step.** If the adversary never asks honest point `k`, and no
earlier honest point equals it, then its labeller query is `Fresh`. -/
theorem labeller_fresh (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : LazyPerm.Oracle (BandAlpha ℓ c)) {k : ℕ}
    (hk : k < (R.honestSeq (π ())).length)
    (hnever : ∀ ρ, ¬ R.askedPt (π ()) ((R.honestSeq (π ()))[k]) ρ)
    (hfirst : ∀ k' (hk' : k' < k), (R.honestSeq (π ()))[k']'(lt_trans hk' hk) ≠ (R.honestSeq (π ()))[k]) :
    LazyPerm.Fresh (R.bandStrategy.hist π ((R.advSeq (π ())).length + k)) (bandEnc (.inl ((R.honestSeq (π ()))[k]))) := by
  rw [R.labeller_hist hP π hk.le]
  show (R.honestSeq (π ()))[k] ∉ LazyPerm.History.dom (α := BandAlpha ℓ c) _ ()
  intro hmem
  obtain ⟨e, he, hin⟩ := LazyPerm.History.mem_dom.1 hmem
  rcases List.mem_append.1 he with h | h
  · obtain ⟨q, hq, rfl⟩ := List.mem_map.1 h
    rw [inpAt_qEntry] at hin
    obtain ⟨i, e', he', rfl⟩ := R.mem_advSeq hq
    exact hnever e'.1 ⟨i, e', he', rfl, Option.some.inj hin⟩
  · obtain ⟨x, hx, rfl⟩ := List.mem_map.1 h
    rw [inpAt_qEntry] at hin
    obtain ⟨k', hk', hkx⟩ := List.mem_iff_getElem.1 hx
    rw [List.getElem_take] at hkx
    rw [List.length_take] at hk'
    exact hfirst k' (by omega) (hkx.trans (Option.some.inj hin))

end ChainReplay

end PousSpongeChain

end


