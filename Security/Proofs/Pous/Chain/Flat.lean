variable {N n wc : ℕ} (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc))


/-- **Segment `s`'s replay of the joint family**: segment `s`'s tag and data, and all `N·n` programs. -/
def segReplay (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q : ℕ) (s : Fin N) :
    P3Replay n wc (Fin N × Fin n) :=
  ⟨tags s, G, W s, D, Q, fun i => A i.1 i.2⟩

variable (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc) (D Q : ℕ) (ω : P3COmega n wc)


/-- **Every segment wins**: at least `k` of segment `s`'s programs return their top label, for every `s`. -/
def WinC (k : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc)
    (A : Fin N → Fin n → OracleProg (p3ChainModel n wc) (Lab n wc)) (ω : P3COmega n wc) : Prop :=
  ∀ s : Fin N, k ≤ (Finset.univ.filter fun v =>
    (A s v).run ((p3ChainModel n wc).answer ω) = topLabelC (tags s) G (W s) ω v).card

/-- **The joint price.** A joint win forces, in every segment, an online holding (against all segments' reveals)
priced at least `(k − X)·n` columns: `win_price_on` on the segment replays, answer map `v ↦ (s, v)`. -/
theorem joint_win_price (hA : ∀ s v, (A s v).Bounded D Q) {c k X : ℕ} (hard : P3ChainHard G c wc D k X)
    (hw : WinC k tags G W A ω) (s : Fin N) :
    (((k - X : ℕ) : ℚ) * n) ≤ ((segReplay A tags G W D Q s).onlineH ω (D + 1)).size c wc := by
  classical
  refine (segReplay A tags G W D Q s).win_price_on ω (fun i => hA i.1 i.2) (fun v => (s, v)) hard
    ((hw s).trans ?_)
  refine Finset.card_le_card fun v hv => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv ⊢
  exact hv


end Joint

end PousP3ConcreteMulti

