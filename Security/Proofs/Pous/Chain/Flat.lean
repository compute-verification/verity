/-!
# `ChainExPostFactoG` — the assembly: the reduction, the minimal fresh set, and the numeric bound

Work file of `bc-a359729a`. It edits no file of `bc-35b053cc`.

1. `correct_mem_reach`: a correctly answered block is in the reach of the fresh seeds after `D` rounds (observation-round
   freshness: asked, via `mem_reach_of_asked_obs`; never asked, via the thread's guess slot).
2. `size_freshHolding_gt`: `ChainHard` then forces the fresh holding's size above `s`.
3. `exists_minimal`: at most `s + 1` of those items already carry more than `ℓ·s` bits of width. A label is `ℓ` bits and
   a chaining value is `ℓ + c`.
4. The numeric side: `geom_sum_le`, and `rhs_ge_one` for the degenerate case `2·nPos > 2^ℓ`.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-! ### The reduction -/

/-- The contract's fresh holding is the observation-round holding of `ChainEPFReach`. -/
theorem freshHolding_eq_obs (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.freshHolding π = R.freshHoldingObs π := rfl

/-- **A correct block is in the reach of the fresh seeds.** If its pad input is asked, `mem_reach_of_asked_obs`.
Otherwise the thread's guess slot shows its label before any ask, so it is a fresh seed. -/
theorem correct_mem_reach (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {v : Fin B}
    (hcorr : (R.P v).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG R.G (fun x => π x) R.dom R.Wb v) :
    v ∈ (ChainKnow.reach R.G (R.freshHolding π) R.D).labs := by
  classical
  by_cases h : ∃ ρ < R.D, R.askedPt π (R.realPt π v) ρ
  · obtain ⟨ρ, hρ, hask⟩ := h
    exact R.mem_reach_of_asked_obs hP hρ hask
  · push Not at h
    refine labs_subset_reach R.G _ R.D (Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩)
    refine ⟨.inl (v, ⟨R.Q, Nat.lt_succ_self _⟩), (R.P v).depth ((idealPerm (ℓ + (ℓ + c))).answer π),
      (R.P v).run ((idealPerm (ℓ + (ℓ + c))).answer π), ?_, Or.inl (hcorr.trans (R.labelG_eq_realPt π v)),
      fun ρ _ hask => h ρ (R.askedPt_lt_D hP hask) hask⟩
    simp only [obsKey, lt_irrefl, ↓reduceIte]

/-- **Winning forces more than `s` fresh size.** Every correct block is in the reach (`correct_mem_reach`), so a holding
of size at most `s` would contradict `ChainHard`. -/
theorem size_freshHolding_gt (hP : ∀ i, (R.P i).Bounded R.D R.Q) {s : ℚ} {k : ℕ}
    (hard : ChainHard R.G Finset.univ c ℓ s R.D k) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hwin : k ≤ (Finset.univ.filter fun i =>
      (R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG R.G (fun x => π x) R.dom R.Wb i).card) :
    s < (R.freshHolding π).size c ℓ := by
  by_contra hle
  push Not at hle
  have h1 := hard (R.freshHolding π) hle
  have h2 : (Finset.univ.filter fun i =>
      (R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG R.G (fun x => π x) R.dom R.Wb i) ⊆
      Finset.univ.filter fun v => v ∈ (ChainKnow.reach R.G (R.freshHolding π) R.D).labs := by
    intro v hv
    exact Finset.mem_filter.2 ⟨Finset.mem_univ _, R.correct_mem_reach hP (Finset.mem_filter.1 hv).2⟩
  have := Finset.card_le_card h2
  omega

/-- The fresh holding's size, in label units: its labels plus `1 + c/ℓ` per chaining value. -/
theorem size_freshHolding (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (R.freshHolding π).size c ℓ =
      (R.freshHolding π).labs.card + (1 + (c : ℚ) / ℓ) * (R.freshHolding π).hs.card := by
  classical
  unfold ChainKnow.size
  have hfil : ((R.freshHolding π).hs.filter fun p => p.2 ≠ 0) = (R.freshHolding π).hs := by
    refine Finset.filter_true_of_mem fun q hq => ?_
    have := (Finset.mem_filter.1 hq).2.1
    omega
  simp [hfil, freshHolding]

end ChainReplay

/-! ### The minimal fresh set -/

/-- **A minimal set.** From labels `L` and chaining values `H` whose size `|L| + (1 + c/ℓ)|H|` exceeds `s` (`ℓ ≥ 1`),
choose `L' ⊆ L` and `H' ⊆ H` with at most `s + 1` items and width `ℓ|L'| + (ℓ+c)|H'| ≥ ℓ·s + 1`: take chaining values
first, then labels, and stop once the width passes `ℓ·s`. -/
theorem exists_minimal {α β : Type} [DecidableEq α] [DecidableEq β] {ℓ c s : ℕ} (hℓ : 1 ≤ ℓ)
    (L : Finset α) (H : Finset β) (hsize : (s : ℚ) < L.card + (1 + (c : ℚ) / ℓ) * H.card) :
    ∃ L' ⊆ L, ∃ H' ⊆ H, L'.card + H'.card ≤ s + 1 ∧ ℓ * s + 1 ≤ ℓ * L'.card + (ℓ + c) * H'.card := by
  have hwidth : ℓ * s < ℓ * L.card + (ℓ + c) * H.card := by
    have hℓq : (0 : ℚ) < ℓ := by exact_mod_cast hℓ
    have : (ℓ : ℚ) * s < ℓ * L.card + (ℓ + c) * H.card := by
      have e : (ℓ : ℚ) * (L.card + (1 + (c : ℚ) / ℓ) * H.card) = ℓ * L.card + (ℓ + c) * H.card := by
        field_simp
      rw [← e]
      exact mul_lt_mul_of_pos_left hsize hℓq
    exact_mod_cast this
  by_cases hH : s + 1 ≤ H.card
  · obtain ⟨H', hH'sub, hH'card⟩ := Finset.exists_subset_card_eq hH
    refine ⟨∅, Finset.empty_subset _, H', hH'sub, by simp [hH'card], ?_⟩
    rw [hH'card, Finset.card_empty, mul_zero, zero_add]
    nlinarith
  · push Not at hH
    by_cases hL : s + 1 - H.card ≤ L.card
    · obtain ⟨L', hL'sub, hL'card⟩ := Finset.exists_subset_card_eq hL
      refine ⟨L', hL'sub, H, le_rfl, by omega, ?_⟩
      rw [hL'card]
      have : ℓ * (s + 1 - H.card) + ℓ * H.card = ℓ * (s + 1) := by
        rw [← mul_add]; congr 1; omega
      nlinarith
    · push Not at hL
      exact ⟨L, le_rfl, H, le_rfl, by omega, by omega⟩

/-! ### The numeric side -/

/-- **Geometric sum.** For `X ≥ 2`, `Σ_{j ≤ n} X^j ≤ 2·X^n`. -/
theorem geom_sum_le (X : ℕ) (hX : 2 ≤ X) : ∀ n, ∑ j ∈ Finset.range (n + 1), X ^ j ≤ 2 * X ^ n
  | 0 => by simp
  | n + 1 => by
      rw [Finset.sum_range_succ]
      have ih := geom_sum_le X hX n
      have : 2 * X ^ n ≤ X ^ (n + 1) := by rw [pow_succ']; exact Nat.mul_le_mul_right _ hX
      rw [pow_succ']
      rw [pow_succ'] at this
      omega

/-- **The degenerate case.** If `2·nPos > 2^ℓ` (and `nPos ≥ 1`, `B ≥ 1`), the first term of the right-hand side is at
least 1, so the bound holds trivially. -/
theorem rhs_ge_one {m ℓ s nP B : ℕ} (hB : 1 ≤ B) (hn : 1 ≤ nP) (hbig : 2 ^ ℓ < 2 * nP) :
    1 ≤ 2 ^ m * 2 * (((nP ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * s) := by
  have hX : 2 ^ ℓ ≤ nP ^ 2 * B * 2 := by
    have h1 : nP ≤ nP ^ 2 := by nlinarith
    have h2 : nP ^ 2 ≤ nP ^ 2 * B := Nat.le_mul_of_pos_right _ hB
    omega
  have hpow : 2 ^ (ℓ * s) ≤ (nP ^ 2 * B * 2) ^ (s + 1) := by
    calc 2 ^ (ℓ * s) = (2 ^ ℓ) ^ s := by rw [pow_mul]
      _ ≤ (nP ^ 2 * B * 2) ^ s := Nat.pow_le_pow_left hX s
      _ ≤ (nP ^ 2 * B * 2) ^ (s + 1) := Nat.pow_le_pow_right (by positivity) (Nat.le_succ s)
  rw [ENNReal.le_div_iff_mul_le (Or.inl (by positivity)) (Or.inl (by simp)), one_mul]
  calc (2 : ℝ≥0∞) ^ (ℓ * s) = ((2 ^ (ℓ * s) : ℕ) : ℝ≥0∞) := by push_cast; ring
    _ ≤ (((nP ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) := by exact_mod_cast hpow
    _ ≤ 2 ^ m * 2 * (((nP ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) := by
        refine le_mul_of_one_le_left' ?_
        calc (1 : ℝ≥0∞) = 1 * 1 := by ring
          _ ≤ 2 ^ m * 2 := mul_le_mul' (one_le_pow₀ (by norm_num)) (by norm_num)

/-! ### The union over patterns -/

/-- A product of per-item factors `2·2^{-w}` is `2^j·2^{-Σw}`. -/
theorem prod_two_inv_pow {j : ℕ} (w : Fin j → ℕ) :
    ∏ t, (2 * (2⁻¹ : ℝ≥0∞) ^ w t) = 2 ^ j * (2⁻¹ : ℝ≥0∞) ^ (∑ t, w t) := by
  rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin, Finset.prod_pow_eq_pow_sum]

/-- **The union over patterns.** Patterns are lists of `j ≤ s + 1` names from a set of at most `N` names (`N ≥ 1`). A
pattern whose width reaches `ℓ·s + 1` costs at most `∏ 2·2^{-w}`, and the others cost nothing. In total at most
`(2N)^{s+1}·2^{-ℓs}`: each term is at most `2^j·2^{-(ℓs+1)}`, with `N^j` patterns of length `j`, and the sum over `j`
is geometric (`geom_sum_le`). -/
theorem sum_patterns_le {ι : Type} [Fintype ι] (w : ι → ℕ) (ℓ s N : ℕ) (hN : Fintype.card ι ≤ N) (hN1 : 1 ≤ N) :
    ∑ j ∈ Finset.range (s + 2), ∑ f : Fin j → ι,
      (if ℓ * s + 1 ≤ ∑ t, w (f t) then ∏ t, (2 * (2⁻¹ : ℝ≥0∞) ^ w (f t)) else 0)
      ≤ (((2 * N) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s) := by
  have hterm : ∀ j (f : Fin j → ι),
      (if ℓ * s + 1 ≤ ∑ t, w (f t) then ∏ t, (2 * (2⁻¹ : ℝ≥0∞) ^ w (f t)) else 0)
        ≤ 2 ^ j * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s + 1) := by
    intro j f
    split_ifs with h
    · rw [prod_two_inv_pow (fun t => w (f t))]
      exact mul_le_mul' le_rfl (pow_le_pow_right_of_le_one' (by norm_num) h)
    · exact zero_le
  have hgeom := geom_sum_le (2 * N) (by omega) (s + 1)
  calc _ ≤ ∑ j ∈ Finset.range (s + 2), ∑ _f : Fin j → ι, 2 ^ j * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s + 1) :=
        Finset.sum_le_sum fun j _ => Finset.sum_le_sum fun f _ => hterm j f
    _ = ∑ j ∈ Finset.range (s + 2), ((Fintype.card ι ^ j : ℕ) : ℝ≥0∞) * (2 ^ j * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s + 1)) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin, nsmul_eq_mul]
    _ ≤ ∑ j ∈ Finset.range (s + 2), (((2 * N) ^ j : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s + 1) := by
        refine Finset.sum_le_sum fun j _ => ?_
        rw [← mul_assoc]
        refine mul_le_mul' ?_ le_rfl
        have : Fintype.card ι ^ j * 2 ^ j ≤ (2 * N) ^ j := by
          rw [mul_pow, mul_comm (2 ^ j)]
          exact Nat.mul_le_mul_right _ (Nat.pow_le_pow_left hN j)
        exact_mod_cast this
    _ = ((∑ j ∈ Finset.range (s + 2), (2 * N) ^ j : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s + 1) := by
        rw [← Finset.sum_mul]; push_cast; rfl
    _ ≤ ((2 * (2 * N) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s + 1) := by
        gcongr
    _ = (((2 * N) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s) := by
        have h22 : (2 : ℝ≥0∞) * 2⁻¹ = 1 := ENNReal.mul_inv_cancel (by norm_num) (by norm_num)
        rw [pow_succ (2⁻¹ : ℝ≥0∞) (ℓ * s)]
        push_cast
        calc (2 : ℝ≥0∞) * (2 * (N : ℝ≥0∞)) ^ (s + 1) * ((2⁻¹ : ℝ≥0∞) ^ (ℓ * s) * 2⁻¹)
            = (2 * (N : ℝ≥0∞)) ^ (s + 1) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s) * (2 * 2⁻¹) := by ring
          _ = _ := by rw [h22, mul_one]

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- **Naming an item**: a showing position and a chain position (the pad position names the label). At most
`nPos²·B` names. -/
theorem card_names_le : Fintype.card (R.Pos × R.posSet) ≤ nPos B R.Q ^ 2 * B := by
  rw [Fintype.card_prod, Fintype.card_coe]
  have hPos : Fintype.card R.Pos = B * (R.Q + 1) + B := by
    simp [ChainReplay.Pos, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
  rw [hPos]
  have hM2 := R.card_posSet_le_half
  set M := R.posSet.card
  rcases Nat.eq_zero_or_pos B with hB | hB
  · subst hB; simp
  have hnP : B * (R.Q + 1) + M ≤ nPos B R.Q := by unfold nPos; omega
  have hsq : (B * (R.Q + 1) + M) ^ 2 ≤ nPos B R.Q ^ 2 := Nat.pow_le_pow_left hnP 2
  have hkey : (R.Q + 2) * M ≤ (B * (R.Q + 1) + M) ^ 2 := by
    have hQ : R.Q + 1 ≤ B * (R.Q + 1) := Nat.le_mul_of_pos_left _ hB
    have h1 : (R.Q + 2) * M ≤ 2 * (B * (R.Q + 1)) * M := Nat.mul_le_mul_right _ (by omega)
    have h2 : 2 * (B * (R.Q + 1)) * M ≤ (B * (R.Q + 1) + M) ^ 2 := by rw [add_sq]; omega
    exact h1.trans h2
  calc (B * (R.Q + 1) + B) * M = B * ((R.Q + 2) * M) := by ring
    _ ≤ B * nPos B R.Q ^ 2 := Nat.mul_le_mul_left _ (hkey.trans hsq)
    _ = nPos B R.Q ^ 2 * B := mul_comm _ _

end ChainReplay

end PousSpongeChain

end


