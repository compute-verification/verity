section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# `ChainExPostFactoG` — v5 existence from the reduction's foldable witnesses

Work file of `bc-a359729a`. It edits no file of `bc-35b053cc`. Contract: `internal/p3-instantiation/
chain-epf-interface.md`, sections 06:15Z and 06:23Z (`ChainEPFLazy.lean`, sha `93045be2`).

- **Route.** The label witnesses must be foldable (`obsFoldKey`). So the reduction is re-run with a **folded** fresh
  holding `freshHoldingF`. Its labels are those some position commits in folded form before `realPt v` is asked.
- **Generic simulation.** `sim_of` and `correct_mem_reach_of` are `ChainEPFReach.sim` and
  `ChainEPFAssembly.correct_mem_reach` generalized to any seed holding satisfying `SeedOK`. `SeedOK` asks for the
  reduction's three label witnesses (a forward absorption, an inverse query on the key, a guess) and its chaining
  witnesses.
  - `seedOK_freshHoldingF`: the folded holding satisfies it. The fold accepts exactly these witnesses: forward and
    guess in label form, inverse in key form.
  - `size_freshHoldingF_gt`: winning forces the folded holding above `s`.
- **The pattern bound is the observation round.** `icondV5'` and `bEvV5'` are `icondV5`/`bEvV5` with the commitment's
  freshness bounded by its round `τ` (no ask before `τ`), not by `itemRound`. `icondV5` asks the honest point to be
  unasked until `itemRound ≥ D`, which excludes every fresh item the adversary asks after committing, and so fails
  existence. Committing before the deciding sample is what lazy sampling charges.
  - `exists_bEvV5'`: existence of the pattern.
  - `win_to_bEvV5'`: the full fixed-σ reduction to it.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

open Reach Reach.ChainReplayR

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-! ### The simulation over any seed holding -/

/-- **The seeds the reduction uses.** `K₀` holds every label that a forward absorption, an inverse query on its key,
or its own thread's guess shows before `realPt` is asked. It also holds every chaining value shown before its point is
asked. -/
structure SeedOK (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (K₀ : ChainKnow B) : Prop where
  lab_fwd : ∀ (u i : Fin B) (e : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))) (x : Bits (ℓ + (ℓ + c))),
    e ∈ R.tr π i → e.2 = .inl x → ovR x = labelG R.G (fun x => π x) R.dom R.Wb u →
    (∀ ρ < e.1, ¬ R.askedPt π (R.realPt π u) ρ) → u ∈ K₀.labs
  lab_inv : ∀ (u i : Fin B) (e : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))),
    e ∈ R.tr π i → e.2 = .inr (π (R.realPt π u)) →
    (∀ ρ < e.1, ¬ R.askedPt π (R.realPt π u) ρ) → u ∈ K₀.labs
  lab_guess : ∀ v : Fin B,
    (R.P v).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG R.G (fun x => π x) R.dom R.Wb v →
    (∀ ρ < (R.P v).depth ((idealPerm (ℓ + (ℓ + c))).answer π), ¬ R.askedPt π (R.realPt π v) ρ) → v ∈ K₀.labs
  hs : ∀ (v : Fin B) (q : ℕ) (o : R.Pos) (τ : ℕ), 1 ≤ q → q < ovCalls R.G v →
    R.obsKeyH π o = some (ovH (π (R.xin π v q)), τ) → (∀ ρ < τ, ¬ R.askedPt π (R.xin π v q) ρ) → (v, q) ∈ K₀.hs

/-- **The simulation over any seed holding** (`ChainEPFReach.sim`, generalized). -/
theorem sim_of (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {K₀ : ChainKnow B}
    (hK : R.SeedOK π K₀) :
    ∀ ρ (v : Fin B) (p' : ℕ), p' < ovCalls R.G v →
      (∃ i, ∃ e ∈ R.tr π i, e.1 = ρ ∧ e.2 = .inl (R.xin π v (p' + 1))) →
      (v, p' + 1) ∈ (ChainKnow.reach R.G K₀ (ρ + 1)).hs ∧
      (v, p' + 1) ∈ (ChainKnow.reach R.G K₀ (ρ + 1)).rs := by
  classical
  intro ρ
  induction ρ using Nat.strong_induction_on with
  | _ ρ ih =>
    intro v p' hp' ⟨i, e, he, hρ, hx⟩
    set K := ChainKnow.reach R.G K₀ ρ
    obtain ⟨o, -, hoH⟩ := R.obs_of_mem_tr hP he
    rw [hx, hρ] at hoH
    have hxin := xin_succ R π v p' hp'
    -- a label absorbed by this call is known by round `ρ`
    have hlab : ∀ u : Fin B, ovR (R.xin π v (p' + 1)) = labelG R.G (fun x => π x) R.dom R.Wb u → u ∈ K.labs := by
      intro u hu
      by_cases hearly : ∃ ρ' < ρ, R.askedPt π (R.realPt π u) ρ'
      · obtain ⟨ρ₁, hρ₁, hask₁, hfirst⟩ := R.exists_first_ask hearly
        obtain ⟨i₁, e₁, he₁, hr₁, hcase⟩ := R.askedPt_cases hask₁
        rcases hcase with hf | hb
        · rw [realPt_eq_xin] at hf
          obtain ⟨j, hj⟩ : ∃ j, ovCalls R.G u = j + 1 := ⟨ovCalls R.G u - 1, by unfold ovCalls; omega⟩
          rw [hj] at hf
          have := (ih ρ₁ hρ₁ u j (by omega) ⟨i₁, e₁, he₁, hr₁, hf⟩).2
          rw [← hj] at this
          exact (reach_mono R.G _ (by omega : ρ₁ + 1 ≤ ρ)).1 (mem_labs_of_pad R.G _ _ u this)
        · exact (labs_subset_reach R.G _ ρ) (hK.lab_inv u i₁ e₁ he₁ hb (by rw [hr₁]; exact hfirst))
      · push Not at hearly
        exact (labs_subset_reach R.G _ ρ) (hK.lab_fwd u i e _ he hx hu (by rw [hρ]; exact hearly))
    -- a chaining value shown in round `ρ` is known by round `ρ`
    have hch : ∀ q : ℕ, 1 ≤ q → q < ovCalls R.G v →
        (∃ o : R.Pos, R.obsKeyH π o = some (ovH (π (R.xin π v q)), ρ)) → (v, q) ∈ K.hs := by
      intro q hq1 hq ⟨o', ho'⟩
      by_cases hearly : ∃ ρ' < ρ, R.askedPt π (R.xin π v q) ρ'
      · obtain ⟨ρ₁, hρ₁, hask₁, hfirst⟩ := R.exists_first_ask hearly
        obtain ⟨i₁, e₁, he₁, hr₁, hcase⟩ := R.askedPt_cases hask₁
        rcases hcase with hf | hb
        · obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩
          exact (reach_mono R.G _ (by omega : ρ₁ + 1 ≤ ρ)).2.1
            (ih ρ₁ hρ₁ v j (by omega) ⟨i₁, e₁, he₁, hr₁, hf⟩).1
        · obtain ⟨o₁, -, ho₁⟩ := R.obs_of_mem_tr hP he₁
          rw [hb, hr₁] at ho₁
          exact hs_subset_reach R.G _ ρ (hK.hs v q o₁ ρ₁ hq1 hq ho₁ hfirst)
      · push Not at hearly
        exact hs_subset_reach R.G _ ρ (hK.hs v q o' ρ hq1 hq ho' hearly)
    refine mem_reach_succ_of_canCall R.G _ ρ v (p' + 1) ⟨by omega, by omega, ?_, ?_⟩
    · intro u hu
      have hlt : p' < (parentsDesc R.G v).length := (List.getElem?_eq_some_iff.1 hu).1
      have hu' : (parentsDesc R.G v)[p'] = u := (List.getElem?_eq_some_iff.1 hu).2
      refine hlab u ?_
      rw [hxin, ovR_append, blks_getElem_parent R π v p' hlt, hu']
    · rcases Nat.eq_zero_or_pos p' with h0 | hpos
      · left; omega
      · right
        obtain ⟨q', rfl⟩ : ∃ q', p' = q' + 1 := ⟨p' - 1, by omega⟩
        refine hch (q' + 1) (by omega) hp' ⟨o, ?_⟩
        rw [hoH]
        simp only [qKeyH, hxin, ovH_append, chainH_succ R π v q' (by omega)]

/-- **`mem_reach_of_asked` over any seed holding.** -/
theorem mem_reach_of_asked_of (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {K₀ : ChainKnow B} (hK : R.SeedOK π K₀) {v : Fin B} {ρ : ℕ} (hρ : ρ < R.D)
    (hask : R.askedPt π (R.realPt π v) ρ) : v ∈ (ChainKnow.reach R.G K₀ R.D).labs := by
  classical
  obtain ⟨ρ₁, hρ₁, hask₁, hfirst⟩ := R.exists_first_ask (ρ := ρ + 1) ⟨ρ, Nat.lt_succ_self _, hask⟩
  obtain ⟨i₁, e₁, he₁, hr₁, hcase⟩ := R.askedPt_cases hask₁
  rcases hcase with hf | hb
  · rw [realPt_eq_xin] at hf
    obtain ⟨j, hj⟩ : ∃ j, ovCalls R.G v = j + 1 := ⟨ovCalls R.G v - 1, by unfold ovCalls; omega⟩
    rw [hj] at hf
    have := (R.sim_of hP hK ρ₁ v j (by omega) ⟨i₁, e₁, he₁, hr₁, hf⟩).2
    rw [← hj] at this
    exact (reach_mono R.G _ (by omega : ρ₁ + 1 ≤ R.D)).1 (mem_labs_of_pad R.G _ _ v this)
  · exact (labs_subset_reach R.G _ R.D) (hK.lab_inv v i₁ e₁ he₁ hb (by rw [hr₁]; exact hfirst))

/-- **A correct block is in the reach**, over any seed holding. -/
theorem correct_mem_reach_of (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    {K₀ : ChainKnow B} (hK : R.SeedOK π K₀) {v : Fin B}
    (hcorr : (R.P v).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG R.G (fun x => π x) R.dom R.Wb v) :
    v ∈ (ChainKnow.reach R.G K₀ R.D).labs := by
  classical
  by_cases h : ∃ ρ < R.D, R.askedPt π (R.realPt π v) ρ
  · obtain ⟨ρ, hρ, hask⟩ := h
    exact R.mem_reach_of_asked_of hP hK hρ hask
  · push Not at h
    exact labs_subset_reach R.G _ R.D (hK.lab_guess v hcorr fun ρ _ hask => h ρ (R.askedPt_lt_D hP hask) hask)

/-! ### The folded fresh holding -/

/-- **Folded label freshness.** Some position commits block `v`'s key in folded form (`obsFoldKey`) before `realPt v`
is asked. -/
def bfreshLabelF (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (v : Fin B) : Prop :=
  ∃ (o : R.Pos) (τ : ℕ), R.obsFoldKey π o v = some (ovR (π (R.realPt π v)), τ) ∧
    ∀ ρ < τ, ¬ R.askedPt π (R.realPt π v) ρ

open Classical in
/-- The folded fresh holding: folded-fresh labels, and the chaining values of `freshHolding`. -/
noncomputable def freshHoldingF (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : ChainKnow B where
  labs := Finset.univ.filter (fun v => R.bfreshLabelF π v)
  hs := (R.freshHolding π).hs
  rs := ∅

/-- A transcript entry's folded commitment at its query slot. -/
theorem obsFold_of_mem_tr (hP : ∀ i, (R.P i).Bounded R.D R.Q) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {i : Fin B}
    {e : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))} (he : e ∈ R.tr π i) (v : Fin B) :
    ∃ o : R.Pos, R.obsFoldKey π o v =
      some ((match e.2 with | .inl _ => bxor (qKey e.2) (R.Wb v) | .inr _ => qKey e.2), e.1) := by
  obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 he
  have hkQ : k < R.Q := lt_of_lt_of_le (List.getElem?_eq_some_iff.1 hk).1 (R.tr_length_le hP π i)
  refine ⟨.inl (i, ⟨k, by omega⟩), ?_⟩
  simp only [obsFoldKey, hkQ, ↓reduceIte, hk, Option.map_some]

/-- **The folded holding satisfies the reduction's seed conditions.** -/
theorem seedOK_freshHoldingF (hP : ∀ i, (R.P i).Bounded R.D R.Q) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    R.SeedOK π (R.freshHoldingF π) where
  lab_fwd := by
    classical
    intro u i e x he hx hlab hfresh
    obtain ⟨o, ho⟩ := R.obsFold_of_mem_tr hP he u
    refine Finset.mem_filter.2 ⟨Finset.mem_univ _, o, e.1, ?_, hfresh⟩
    rw [ho]
    simp only [hx, qKey, hlab, R.labelG_eq_realPt, bxor_self_right]
  lab_inv := by
    classical
    intro u i e he hy hfresh
    obtain ⟨o, ho⟩ := R.obsFold_of_mem_tr hP he u
    refine Finset.mem_filter.2 ⟨Finset.mem_univ _, o, e.1, ?_, hfresh⟩
    rw [ho]
    simp only [hy, qKey]
  lab_guess := by
    classical
    intro v hcorr hfresh
    refine Finset.mem_filter.2 ⟨Finset.mem_univ _, .inl (v, ⟨R.Q, Nat.lt_succ_self _⟩),
      (R.P v).depth ((idealPerm (ℓ + (ℓ + c))).answer π), ?_, hfresh⟩
    simp only [obsFoldKey, lt_irrefl, ↓reduceIte, hcorr, R.labelG_eq_realPt, bxor_self_right]
  hs := by
    classical
    intro v q o τ hq1 hq ho hfresh
    refine Finset.mem_filter.2 ⟨?_, hq1, hq, o, τ, ho, hfresh⟩
    exact Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_range.2 (by have := R.ovCalls_lt v; omega)⟩

/-- The folded holding's size, in label units. -/
theorem size_freshHoldingF (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) :
    (R.freshHoldingF π).size c ℓ =
      (R.freshHoldingF π).labs.card + (1 + (c : ℚ) / ℓ) * (R.freshHoldingF π).hs.card := by
  classical
  unfold ChainKnow.size
  have hfil : ((R.freshHoldingF π).hs.filter fun p => p.2 ≠ 0) = (R.freshHoldingF π).hs := by
    refine Finset.filter_true_of_mem fun q hq => ?_
    have := (Finset.mem_filter.1 hq).2.1
    omega
  simp [hfil, freshHoldingF]

/-- **Winning forces the folded holding above `s`.** -/
theorem size_freshHoldingF_gt (hP : ∀ i, (R.P i).Bounded R.D R.Q) {s : ℚ} {k : ℕ}
    (hard : ChainHard R.G Finset.univ c ℓ s R.D k) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hwin : k ≤ (Finset.univ.filter fun i =>
      (R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG R.G (fun x => π x) R.dom R.Wb i).card) :
    s < (R.freshHoldingF π).size c ℓ := by
  by_contra hle
  push Not at hle
  have h1 := hard (R.freshHoldingF π) hle
  have h2 : (Finset.univ.filter fun i =>
      (R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG R.G (fun x => π x) R.dom R.Wb i) ⊆
      Finset.univ.filter fun v => v ∈ (ChainKnow.reach R.G (R.freshHoldingF π) R.D).labs := by
    intro v hv
    exact Finset.mem_filter.2 ⟨Finset.mem_univ _,
      R.correct_mem_reach_of hP (R.seedOK_freshHoldingF hP π) (Finset.mem_filter.1 hv).2⟩
  have := Finset.card_le_card h2
  omega

/-! ### The v5 pattern with the observation-round bound -/

/-- **The v5 item condition, bounded by the commitment's round.** Item `(v, p)` observed at `o`: `o` commits the honest
quantity (the folded key for the label `p = ovCalls v`, the `(ℓ+c)`-bit `ovH (π (xin v p))` for a chaining value) at
some round `τ`, and the deciding point `xin v p` is unasked before `τ`. -/
def icondV5' (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (o : R.Pos) (q : Fin B × ℕ) : Prop :=
  if q.2 = ovCalls R.G q.1 then
    ∃ τ, R.obsFoldKey π o q.1 = some (ovR (π (R.xin π q.1 q.2)), τ) ∧
      ∀ ρ < τ, ¬ R.askedPt π (R.xin π q.1 q.2) ρ
  else
    ∃ τ, R.obsKeyH π o = some (ovH (π (R.xin π q.1 q.2)), τ) ∧ ∀ ρ < τ, ¬ R.askedPt π (R.xin π q.1 q.2) ρ

/-- **The v5 pattern, bounded by the commitment's round**: chain positions satisfying `icondV5'`, at pairwise distinct
deciding points. -/
def bEvV5' (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (φ : List (R.Pos × (Fin B × ℕ))) : Prop :=
  (∀ t ∈ φ, t.2 ∈ R.posSet ∧ R.icondV5' π t.1 t.2) ∧
    φ.Pairwise (fun t t' => R.decidePt π t.2 ≠ R.decidePt π t'.2)

/-- An item's width, read off its position: `ℓ` for the label, `ℓ + c` for a chaining value. -/
def posWidth (q : Fin B × ℕ) : ℕ := if q.2 = ovCalls R.G q.1 then ℓ else ℓ + c

theorem one_le_ovCalls (v : Fin B) : 1 ≤ ovCalls R.G v := by unfold ovCalls; omega

/-- **v5 existence.** Folded-fresh labels `L'` and fresh chaining values `H'`, without a collision, give a v5 pattern of
exactly those items, of total width `ℓ|L'| + (ℓ+c)|H'|`. -/
theorem exists_bEvV5' (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (L' : Finset (Fin B)) (H' : Finset (Fin B × ℕ))
    (hL' : L' ⊆ (R.freshHoldingF π).labs) (hH' : H' ⊆ (R.freshHolding π).hs) (hnc : R.NoCollU π) :
    ∃ φ : List (R.Pos × (Fin B × ℕ)), φ.length = L'.card + H'.card ∧ R.bEvV5' π φ ∧
      (φ.map (fun t => R.posWidth t.2)).sum = ℓ * L'.card + (ℓ + c) * H'.card := by
  classical
  have hLf : ∀ v : L', R.bfreshLabelF π v.1 := fun v => (Finset.mem_filter.1 (hL' v.2)).2
  have hHf : ∀ q : H', 1 ≤ q.1.2 ∧ q.1.2 < ovCalls R.G q.1.1 ∧ R.bfreshChaining π q.1.1 q.1.2 := fun q => by
    have := hH' q.2
    simp only [freshHolding, Finset.mem_filter] at this
    exact this.2
  choose oL τL hoL hfL using hLf
  choose oH τH hoH hfH using fun q : H' => (hHf q).2.2
  let φL : List (R.Pos × (Fin B × ℕ)) := L'.attach.toList.map fun v => (oL v, (v.1, ovCalls R.G v.1))
  let φH : List (R.Pos × (Fin B × ℕ)) := H'.attach.toList.map fun q => (oH q, q.1)
  have hmemL : ∀ t ∈ φL, ∃ v : L', t = (oL v, (v.1, ovCalls R.G v.1)) := fun t ht => by
    obtain ⟨v, -, rfl⟩ := List.mem_map.1 ht; exact ⟨v, rfl⟩
  have hmemH : ∀ t ∈ φH, ∃ q : H', t = (oH q, q.1) := fun t ht => by
    obtain ⟨q, -, rfl⟩ := List.mem_map.1 ht; exact ⟨q, rfl⟩
  have hitems : ∀ t ∈ φL ++ φH, t.2 ∈ R.posSet ∧ R.icondV5' π t.1 t.2 := by
    intro t ht
    rcases List.mem_append.1 ht with h | h
    · obtain ⟨v, rfl⟩ := hmemL t h
      refine ⟨R.mem_posSet.2 ⟨R.one_le_ovCalls v.1, le_rfl⟩, ?_⟩
      show if ovCalls R.G v.1 = ovCalls R.G v.1 then _ else _
      rw [ite_eq_left rfl, R.xin_pad]
      exact ⟨τL v, hoL v, hfL v⟩
    · obtain ⟨q, rfl⟩ := hmemH t h
      obtain ⟨hq1, hq2, -⟩ := hHf q
      refine ⟨R.mem_posSet.2 ⟨hq1, hq2.le⟩, ?_⟩
      show if q.1.2 = ovCalls R.G q.1.1 then _ else _
      rw [ite_eq_right (by omega)]
      exact ⟨τH q, hoH q, hfH q⟩
  have hnd : ((φL ++ φH).map Prod.snd).Nodup := by
    rw [List.map_append, List.nodup_append]
    refine ⟨?_, ?_, ?_⟩
    · rw [List.map_map]
      refine List.Nodup.map (fun a b hab => Subtype.ext ?_) (Finset.nodup_toList _)
      exact (Prod.ext_iff.1 hab).1
    · rw [List.map_map]
      exact List.Nodup.map (fun a b hab => Subtype.ext hab) (Finset.nodup_toList _)
    · intro x hx y hy hxy
      obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hx
      obtain ⟨t', ht', rfl⟩ := List.mem_map.1 hy
      obtain ⟨v, rfl⟩ := hmemL t ht
      obtain ⟨q, rfl⟩ := hmemH t' ht'
      have hq := (hHf q).2.1
      have e1 : (q.1).1 = v.1 := (congrArg Prod.fst hxy).symm
      have e2 : (q.1).2 = ovCalls R.G v.1 := (congrArg Prod.snd hxy).symm
      rw [e1, e2] at hq
      exact lt_irrefl _ hq
  refine ⟨φL ++ φH, ?_, ⟨hitems, ?_⟩, ?_⟩
  · simp only [φL, φH, List.length_append, List.length_map, Finset.length_toList, Finset.card_attach]
  · refine R.pairwise_decidePt_of_noColl hnc (fun t ht => (hitems t ht).1) ?_
    exact List.pairwise_map.1 (List.nodup_iff_pairwise_ne.1 hnd) |>.imp id
  · have hwL : ∀ v : L', R.posWidth (v.1, ovCalls R.G v.1) = ℓ := fun v => by simp [posWidth]
    have hwH : ∀ q : H', R.posWidth q.1 = ℓ + c := fun q => by
      have := (hHf q).2.1
      simp only [posWidth]
      rw [ite_eq_right (by omega)]
    simp only [φL, φH, List.map_append, List.sum_append, List.map_map, Function.comp_def, hwL, hwH,
      List.map_const', List.sum_replicate, Finset.length_toList, Finset.card_attach, smul_eq_mul]
    ring

/-- **The fixed-σ reduction to a v5 pattern.** Without a collision, winning on `k` blocks gives a v5 pattern of at most
`s+1` items and total width at least `ℓ·s + 1`. -/
theorem win_to_bEvV5' (hP : ∀ i, (R.P i).Bounded R.D R.Q) (hℓ : 1 ≤ ℓ) {s k : ℕ}
    (hard : ChainHard R.G Finset.univ c ℓ (s : ℚ) R.D k) {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hnc : R.NoCollU π)
    (hwin : k ≤ (Finset.univ.filter fun i =>
      (R.P i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG R.G (fun x => π x) R.dom R.Wb i).card) :
    ∃ φ : List (R.Pos × (Fin B × ℕ)), φ.length ≤ s + 1 ∧ R.bEvV5' π φ ∧
      ℓ * s + 1 ≤ (φ.map (fun t => R.posWidth t.2)).sum := by
  have hgt := R.size_freshHoldingF_gt hP hard hwin
  rw [R.size_freshHoldingF] at hgt
  obtain ⟨L', hL', H', hH', hcard, hwidth⟩ := exists_minimal hℓ _ _ hgt
  obtain ⟨φ, hlen, hEv, hsum⟩ := R.exists_bEvV5' π L' H' hL' hH' hnc
  exact ⟨φ, hlen ▸ hcard, hEv, hsum ▸ hwidth⟩

end ChainReplay

end PousSpongeChain

end


