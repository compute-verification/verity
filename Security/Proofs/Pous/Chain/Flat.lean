/-! ════ Freshness.LuckyRoutes ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The routes: hit enumeration and the one-time pad (`ZeroAdvicePlan.md`, M7; §29 points 2 and 3)

**Point 2, `HitEnumeration`.** For one permutation `π` with honest pair `x ↦ y` and `z₀ = π⁻¹(x)`, the queries answered
by an honest value, or by `z₀`, are exactly four (`answer_honest_iff`):
- forward at `x` (answer `y`);
- forward at `z₀` (answer `x`: the hit);
- inverse at `y` (answer `x`);
- inverse at `x` (answer `z₀`).

Resampling the honest output, `π' = swap(y, y') ∘ π`, changes no answer except forward at `x` or at `π⁻¹(y')`, and
inverse at `y` or at `y'` (`swapOut_forward`, `swapOut_inverse`). So there is no higher-order preimage leak. A chain of
queries reaches `x` or `y` only through one of the four queries, and `z₀` is the only non-honest forward point.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame

/-! ### Point 2: one permutation, its honest pair, and resampling the output -/

section Enumeration

variable {α : Type} [DecidableEq α] (π : Equiv.Perm α) (x : α)

/-- **The four queries touching the honest pair `x ↦ π x`.** -/
theorem answer_honest_iff (z w : α) :
    (π z = π x ↔ z = x) ∧ (π z = x ↔ z = π.symm x) ∧ (π.symm w = x ↔ w = π x) ∧
      (π.symm w = π.symm x ↔ w = x) := by
  refine ⟨π.injective.eq_iff, ?_, ?_, π.symm.injective.eq_iff⟩
  · exact ⟨fun h => by rw [← h, Equiv.symm_apply_apply], fun h => by rw [h, Equiv.apply_symm_apply]⟩
  · exact ⟨fun h => by rw [← h, Equiv.apply_symm_apply], fun h => by rw [h, Equiv.symm_apply_apply]⟩

/-- Resampling the honest output to `y'`: `π' = swap(π x, y') ∘ π`. -/
def swapOut (y' : α) : Equiv.Perm α := π.trans (Equiv.swap (π x) y')

theorem swapOut_apply_x (y' : α) : swapOut π x y' x = y' := by
  simp [swapOut, Equiv.swap_apply_left]

/-- **Forward answers survive the resampling**, except at `x` and at `π⁻¹(y')`. -/
theorem swapOut_forward (y' z : α) (hzx : z ≠ x) (hz' : z ≠ π.symm y') : swapOut π x y' z = π z := by
  have h1 : π z ≠ π x := fun h => hzx (π.injective h)
  have h2 : π z ≠ y' := fun h => hz' (by rw [← h, Equiv.symm_apply_apply])
  simp [swapOut, Equiv.swap_apply_of_ne_of_ne h1 h2]

/-- **Inverse answers survive the resampling**, except at `π x` and at `y'`. -/
theorem swapOut_inverse (y' w : α) (hwy : w ≠ π x) (hw' : w ≠ y') : (swapOut π x y').symm w = π.symm w := by
  simp [swapOut, Equiv.swap_apply_of_ne_of_ne hwy hw']

end Enumeration

/-! ### Point 3: what the labels read of `H` -/

section CongrH

variable {n wc : ℕ} (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
  (P : Tweak n → Equiv.Perm (Lab n wc))

/-- `c1T` reads `H` only at layer-0 points. -/
theorem c1T_congrH {Hf Hf' : KQ' n wc → Lab n wc} (h : ∀ q : KQ' n wc, q.2.1 = 0 → Hf q = Hf' q) :
    ∀ v : Fin n, c1T tag G Hf P W v = c1T tag G Hf' P W v
  | v => by
    have hin : (fun u => if _h : u ∈ G.par v then some (c1T tag G Hf P W u) else none)
             = (fun u => if _h : u ∈ G.par v then some (c1T tag G Hf' P W u) else none) := by
      funext u
      by_cases hu : u ∈ G.par v
      · rw [dif_pos hu, dif_pos hu, c1T_congrH h u]
      · rw [dif_neg hu, dif_neg hu]
    rw [c1T, c1T, hin, h _ rfl]
  termination_by v => v.val
  decreasing_by exact G.par_lt v u hu

/-- `c2T v` reads `H` only at layer-0 points and at layer-1 points of nodes `≤ v`. -/
theorem c2T_congrH {Hf Hf' : KQ' n wc → Lab n wc} (h0 : ∀ q : KQ' n wc, q.2.1 = 0 → Hf q = Hf' q) :
    ∀ v : Fin n, (∀ q : KQ' n wc, q.2.1 = 1 → q.2.2.1.val ≤ v.val → Hf q = Hf' q) →
      c2T tag G Hf P W v = c2T tag G Hf' P W v
  | v => fun h1 => by
    have htrans : transpose (c1T tag G Hf P W) v = transpose (c1T tag G Hf' P W) v := by
      funext u
      show c1T tag G Hf P W u v = c1T tag G Hf' P W u v
      rw [c1T_congrH tag G W P h0 u]
    have hin : (fun u => if _h : u ∈ G.par v then some (c2T tag G Hf P W u) else none)
             = (fun u => if _h : u ∈ G.par v then some (c2T tag G Hf' P W u) else none) := by
      funext u
      by_cases hu : u ∈ G.par v
      · rw [dif_pos hu, dif_pos hu,
          c2T_congrH h0 u (fun q hq hqu => h1 q hq (hqu.trans (G.par_lt v u hu).le))]
      · rw [dif_neg hu, dif_neg hu]
    rw [c2T, c2T, htrans, hin, h1 _ rfl le_rfl]
  termination_by v => v.val
  decreasing_by exact G.par_lt v u hu

end CongrH

/-! ### Point 3: the one-time pad on `k²_u` -/

theorem labXor_assoc {n wc : ℕ} (a b c : Lab n wc) : labXor (labXor a b) c = labXor a (labXor b c) := by
  funext v j
  simp [labXor, Labelling.bxor, Bool.xor_assoc]

section Pad

variable {n wc : ℕ} (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (ω : (p3ModelT n wc).Ω)

open Classical in
/-- `ω` with the key `k²_u = H(hk2 u)` shifted by `δ`, and nothing else changed. -/
noncomputable def padShift (u : Fin n) (δ : Lab n wc) : (p3ModelT n wc).Ω :=
  (Function.update ω.1 (hk2 τ G W ω u) (labXor (ω.1 (hk2 τ G W ω u)) δ), ω.2)

open Classical in
/-- **`OneTimePad`** (§29, point 3). Shifting `k²_u` by `δ`:
- leaves every lower label unchanged, so the columns `(·, u)` too;
- leaves every top of index `< u` unchanged, so the honest key input `hk2 u` too;
- shifts the answer `in2 u` of `qI2 u` by exactly `δ`;
- changes `H` at no other point, so `k²_u` enters the view only through `qH2 u`.

So, with the columns fixed, `in2 u` takes each value for exactly one key: it says nothing about the columns while
`k²_u` is unqueried. -/
theorem oneTimePad (u : Fin n) (δ : Lab n wc) :
    c1 τ G W (padShift τ G W ω u δ) = c1 τ G W ω ∧
    (∀ v : Fin n, v.val < u.val → c2 τ G W (padShift τ G W ω u δ) v = c2 τ G W ω v) ∧
    hk2 τ G W (padShift τ G W ω u δ) u = hk2 τ G W ω u ∧
    in2 τ G W (padShift τ G W ω u δ) u = labXor (in2 τ G W ω u) δ ∧
    (∀ q, q ≠ hk2 τ G W ω u → (padShift τ G W ω u δ).1 q = ω.1 q) := by
  have hne0 : ∀ q : KQ' n wc, q.2.1 = 0 → q ≠ hk2 τ G W ω u := by
    intro q hq hqe
    rw [hqe] at hq
    exact absurd hq (by simp [hk2])
  have h0 : ∀ q : KQ' n wc, q.2.1 = 0 → ω.1 q = (padShift τ G W ω u δ).1 q := fun q hq => by
    simp only [padShift]
    rw [Function.update_of_ne (hne0 q hq)]
  have hc1 : c1 τ G W (padShift τ G W ω u δ) = c1 τ G W ω := by
    funext v
    exact (c1T_congrH τ G W ω.2 h0 v).symm
  have hc2 : ∀ v : Fin n, v.val < u.val → c2 τ G W (padShift τ G W ω u δ) v = c2 τ G W ω v := by
    intro v hv
    refine (c2T_congrH τ G W ω.2 h0 v fun q hq hqv => ?_).symm
    have hne : q ≠ hk2 τ G W ω u := by
      intro hqe
      have : q.2.2.1 = u := by rw [hqe]; rfl
      rw [this] at hqv
      omega
    simp only [padShift]
    rw [Function.update_of_ne hne]
  have hhk : hk2 τ G W (padShift τ G W ω u δ) u = hk2 τ G W ω u := by
    simp only [hk2]
    congr 1
    congr 1
    congr 1
    funext v
    by_cases hv : v ∈ G.par u
    · rw [dif_pos hv, dif_pos hv, hc2 v (G.par_lt u v hv)]
    · rw [dif_neg hv, dif_neg hv]
  refine ⟨hc1, hc2, hhk, ?_, fun q hq => by simp only [padShift]; rw [Function.update_of_ne hq]⟩
  simp only [in2]
  rw [hhk, hc1]
  simp only [padShift, Function.update_self]
  exact (labXor_assoc _ _ _).symm

end Pad

end PousKnowledge

end


/-! ════ Freshness.LuckyFibre ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Fibres (`ZeroAdvicePlan.md` §5b, M8b)

- `fibre_mul_card_le` (model-free): if `f` maps a class `E` into `Y`, and every fibre over `Y` injects into every
  other, then each fibre has at most `|E|/|Y|` elements.
- The three resampling moves on `Ω = H × (Tweak → Perm Lab)` that make fibres equinumerous:
  - `updH q v`: set `H(q) := v`;
  - `movF t x y'`: `P_t := swapOut P_t x y'`, which resamples a forward answer (point 2's `swapOut`);
  - `movI t w x'`: `P_t := swapIn P_t w x'`, which resamples an inverse answer.

  Each maps its fibre over `v` into the fibre over `v'` injectively, and changes no answer outside the listed points
  (`swapIn_forward`, `swapIn_inverse`, with point 2's `swapOut_forward`, `swapOut_inverse`).
-/

namespace PousLuckyChain

open Classical

/-- **Equal fibres.** Each fibre over `Y` injects into every other, so `|fibre a| · |Y| ≤ |E|`. -/
theorem fibre_mul_card_le {Ω V : Type} [DecidableEq V] (E : Finset Ω) (f : Ω → V) (Y : Finset V)
    (hmaps : ∀ ω ∈ E, f ω ∈ Y)
    (hle : ∀ y ∈ Y, ∀ y' ∈ Y, (E.filter fun ω => f ω = y).card ≤ (E.filter fun ω => f ω = y').card) (a : V) :
    (E.filter fun ω => f ω = a).card * Y.card ≤ E.card := by
  by_cases ha : a ∈ Y
  · rw [Finset.card_eq_sum_card_fiberwise (f := f) (t := Y) hmaps]
    calc (E.filter fun ω => f ω = a).card * Y.card = ∑ _y ∈ Y, (E.filter fun ω => f ω = a).card := by
          rw [Finset.sum_const, smul_eq_mul, mul_comm]
      _ ≤ ∑ y ∈ Y, (E.filter fun ω => f ω = y).card := Finset.sum_le_sum fun y hy => hle a ha y hy
  · have : E.filter (fun ω => f ω = a) = ∅ :=
      Finset.filter_false_of_mem fun ω hω h => ha (h ▸ hmaps ω hω)
    rw [this, Finset.card_empty, zero_mul]
    exact Nat.zero_le _

/-- A fibre injects into another when a map sends one into the other injectively. -/
theorem fibre_le_of_map {Ω V : Type} [DecidableEq V] (E : Finset Ω) (f : Ω → V) (y y' : V) (φ : Ω → Ω)
    (hmem : ∀ ω ∈ E, f ω = y → φ ω ∈ E ∧ f (φ ω) = y')
    (hinj : ∀ ω₁ ∈ E, ∀ ω₂ ∈ E, f ω₁ = y → f ω₂ = y → φ ω₁ = φ ω₂ → ω₁ = ω₂) :
    (E.filter fun ω => f ω = y).card ≤ (E.filter fun ω => f ω = y').card := by
  refine Finset.card_le_card_of_injOn φ (fun ω hω => ?_) (fun ω₁ h₁ ω₂ h₂ h => ?_)
  · obtain ⟨hE, hy⟩ := Finset.mem_filter.1 hω
    obtain ⟨h1, h2⟩ := hmem ω hE hy
    exact Finset.mem_filter.2 ⟨h1, h2⟩
  · have h₁' := Finset.mem_filter.1 (Finset.mem_coe.1 h₁)
    have h₂' := Finset.mem_filter.1 (Finset.mem_coe.1 h₂)
    exact hinj ω₁ h₁'.1 ω₂ h₂'.1 h₁'.2 h₂'.2 h

end PousLuckyChain

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked

/-! ### Resampling an inverse answer (the inverse side of point 2) -/

section SwapIn

variable {α : Type} [DecidableEq α] (π : Equiv.Perm α) (w : α)

/-- Resampling the inverse answer at `w` to `x'`: `π' = π ∘ swap(π⁻¹ w, x')`. -/
def swapIn (x' : α) : Equiv.Perm α := (Equiv.swap (π.symm w) x').trans π

theorem swapIn_symm_apply_w (x' : α) : (swapIn π w x').symm w = x' := by
  simp [swapIn, Equiv.swap_apply_left]

/-- **Forward answers survive**, except at `π⁻¹ w` and `x'`. -/
theorem swapIn_forward (x' z : α) (hz : z ≠ π.symm w) (hz' : z ≠ x') : swapIn π w x' z = π z := by
  simp [swapIn, Equiv.swap_apply_of_ne_of_ne hz hz']

/-- **Inverse answers survive**, except at `w` and `π x'`. -/
theorem swapIn_inverse (x' v : α) (hv : v ≠ w) (hv' : v ≠ π x') : (swapIn π w x').symm v = π.symm v := by
  have h1 : π.symm v ≠ π.symm w := fun h => hv (π.symm.injective h)
  have h2 : π.symm v ≠ x' := fun h => hv' (by rw [← h, Equiv.apply_symm_apply])
  simp [swapIn, Equiv.swap_apply_of_ne_of_ne h1 h2]

end SwapIn

end PousKnowledge

end


/-! ════ Freshness.LuckyResolve ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `CreditResolved → AdaptiveMinEntropyPool` (`ZeroAdvicePlan.md` §5b, M8e)

For a class `S`, `CreditResolved` gives a counting chain whose weight bounds every member's lucky bits. The chain lemma
`chain_sum_le` bounds the total weight by `|Ω|`, so the class's lucky bits sum to at most `(2M/(M − 2Q_tot))^{|S|}·|Ω|`.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge PousLuckyChain
open PousLuckyCount

open Classical in
/-- **M8e: `AdaptiveMinEntropyPool` from `CreditResolved`.** -/
theorem adaptiveMinEntropyPool_of_creditResolved (hcr : CreditResolved) : AdaptiveMinEntropyPool := by
  intro n wc D Q tag G W p hn hpool hb S
  obtain ⟨m, X, P, A, hdet, hfib, hpay⟩ := hcr n wc D Q tag G W p hn hpool hb S
  set a : ℝ := (((2 ^ (n * wc) - 2 * (n * (Q + 1) + 2 * n) : ℕ) : ℝ) ^ S.card) with ha
  set b : ℝ := ((2 * 2 ^ (n * wc) : ℕ) : ℝ) ^ S.card with hb'
  have hb0 : 0 ≤ b := by positivity
  have hchain := chain_sum_le X P A hdet hfib m
  have hreal : (∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S),
        (2 ^ luckyBits p ω tag G W D : ℝ)) * a ≤ b * Fintype.card (p3ModelT n wc).Ω := by
    rw [Finset.sum_mul]
    calc ∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S), (2 ^ luckyBits p ω tag G W D : ℝ) * a
        ≤ ∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S),
            b * ∏ ℓ ∈ Finset.range m, w X P A ℓ ω :=
          Finset.sum_le_sum fun ω hω => hpay ω (Finset.mem_filter.1 hω).2
      _ ≤ ∑ ω, b * ∏ ℓ ∈ Finset.range m, w X P A ℓ ω :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) fun ω _ _ =>
            mul_nonneg hb0 (Finset.prod_nonneg fun ℓ _ => w_nonneg X P A ℓ ω)
      _ = b * ∑ ω, ∏ ℓ ∈ Finset.range m, w X P A ℓ ω := by rw [Finset.mul_sum]
      _ ≤ b * Fintype.card (p3ModelT n wc).Ω := mul_le_mul_of_nonneg_left hchain hb0
  have : ((∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S), 2 ^ luckyBits p ω tag G W D) *
      (2 ^ (n * wc) - 2 * (n * (Q + 1) + 2 * n)) ^ S.card : ℕ) ≤
        ((2 * 2 ^ (n * wc)) ^ S.card * Fintype.card (p3ModelT n wc).Ω : ℕ) := by
    have e1 : (((∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S), 2 ^ luckyBits p ω tag G W D) *
        (2 ^ (n * wc) - 2 * (n * (Q + 1) + 2 * n)) ^ S.card : ℕ) : ℝ) =
        (∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S),
          (2 ^ luckyBits p ω tag G W D : ℝ)) * a := by
      rw [ha]; push_cast; rfl
    have e2 : (((2 * 2 ^ (n * wc)) ^ S.card * Fintype.card (p3ModelT n wc).Ω : ℕ) : ℝ) =
        b * Fintype.card (p3ModelT n wc).Ω := by
      rw [hb']; push_cast; rfl
    exact_mod_cast (e1 ▸ e2 ▸ hreal)
  exact this

/-- **`n10prime` at `10n`, on `okLucky`'s instances, from `CreditResolved`.** -/
theorem n10prime_of_creditResolved (h : CreditResolved) : N10primeAtIf okLucky posLucky :=
  n10prime_of_adaptiveMinEntropyPool (adaptiveMinEntropyPool_of_creditResolved h)

open Classical in
/-- **A typed class's weight** from `CreditResolvedTyped`: `Σ_{luckySet = S, hitSlotSet = H} 2^{bits} ≤ 2·|Ω|`. -/
theorem typed_weight_le (hcr : CreditResolvedTyped) {n wc D Q : ℕ} (tag : Bits 256) (G : Labelling.TopoDAG n)
    (W : Fin n → Lab n wc) (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (hn : 0 < n)
    (hpool : 64 * n * (n * (Q + 1) + 2 * n) ≤ 2 ^ (n * wc)) (hb : ∀ c, (p c).Bounded D Q)
    (S H : Finset (ℕ × ℕ)) :
    (∑ ω ∈ (Finset.univ.filter fun ω => luckySet p ω tag G W D Q = S).filter
        (fun ω => hitSlotSet p ω tag G W D = H), (2 ^ luckyBits p ω tag G W D : ℝ)) ≤
      2 * Fintype.card (p3ModelT n wc).Ω := by
  obtain ⟨m, X, P, A, hdet, hfib, hpay⟩ := hcr n wc D Q tag G W p hn hpool hb S H
  have hchain := chain_sum_le X P A hdet hfib m
  calc ∑ ω ∈ (Finset.univ.filter fun ω => luckySet p ω tag G W D Q = S).filter
          (fun ω => hitSlotSet p ω tag G W D = H), (2 ^ luckyBits p ω tag G W D : ℝ)
      ≤ ∑ ω ∈ (Finset.univ.filter fun ω => luckySet p ω tag G W D Q = S).filter
          (fun ω => hitSlotSet p ω tag G W D = H), 2 * ∏ ℓ ∈ Finset.range m, w X P A ℓ ω := by
        refine Finset.sum_le_sum fun ω hω => ?_
        obtain ⟨hω1, hω2⟩ := Finset.mem_filter.1 hω
        exact hpay ω (Finset.mem_filter.1 hω1).2 hω2
    _ ≤ ∑ ω, 2 * ∏ ℓ ∈ Finset.range m, w X P A ℓ ω :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) fun ω _ _ =>
          mul_nonneg (by norm_num) (Finset.prod_nonneg fun ℓ _ => w_nonneg X P A ℓ ω)
    _ = 2 * ∑ ω, ∏ ℓ ∈ Finset.range m, w X P A ℓ ω := by rw [Finset.mul_sum]
    _ ≤ 2 * Fintype.card (p3ModelT n wc).Ω := mul_le_mul_of_nonneg_left hchain (by norm_num)

open Classical in
/-- **A class's weight** from `CreditResolvedTyped`: summing over the `2^{|S|}` hit sets,
`Σ_{luckySet = S} 2^{bits} ≤ 2^{|S|+1}·|Ω|`. -/
theorem class_weight_of_typed (hcr : CreditResolvedTyped) {n wc D Q : ℕ} (tag : Bits 256)
    (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (hn : 0 < n)
    (hpool : 64 * n * (n * (Q + 1) + 2 * n) ≤ 2 ^ (n * wc)) (hb : ∀ c, (p c).Bounded D Q)
    (S : Finset (ℕ × ℕ)) :
    ∑ ω ∈ Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S), 2 ^ luckyBits p ω tag G W D ≤
      2 ^ (S.card + 1) * Fintype.card (p3ModelT n wc).Ω := by
  set cls := Finset.univ.filter (fun ω => luckySet p ω tag G W D Q = S)
  have hmaps : ∀ ω ∈ cls, hitSlotSet p ω tag G W D ∈ S.powerset := fun ω hω => by
    rw [Finset.mem_powerset, ← (Finset.mem_filter.1 hω).2]
    exact hitSlotSet_subset p ω tag G W D Q
  have hreal : (∑ ω ∈ cls, (2 ^ luckyBits p ω tag G W D : ℝ)) ≤
      (2 : ℝ) ^ S.card * (2 * Fintype.card (p3ModelT n wc).Ω) := by
    rw [← Finset.sum_fiberwise_of_maps_to hmaps]
    calc ∑ H ∈ S.powerset, ∑ ω ∈ cls.filter (fun ω => hitSlotSet p ω tag G W D = H),
            (2 ^ luckyBits p ω tag G W D : ℝ)
        ≤ ∑ _H ∈ S.powerset, 2 * (Fintype.card (p3ModelT n wc).Ω : ℝ) :=
          Finset.sum_le_sum fun H _ => typed_weight_le hcr tag G W p hn hpool hb S H
      _ = (2 : ℝ) ^ S.card * (2 * Fintype.card (p3ModelT n wc).Ω) := by
          rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul]; push_cast; ring
  have e : ((2 ^ (S.card + 1) * Fintype.card (p3ModelT n wc).Ω : ℕ) : ℝ) =
      (2 : ℝ) ^ S.card * (2 * Fintype.card (p3ModelT n wc).Ω) := by push_cast; ring
  have h2 : ((∑ ω ∈ cls, 2 ^ luckyBits p ω tag G W D : ℕ) : ℝ) ≤
      ((2 ^ (S.card + 1) * Fintype.card (p3ModelT n wc).Ω : ℕ) : ℝ) := by
    rw [e]; push_cast; exact hreal
  exact_mod_cast h2

open Classical in
/-- **`ZeroAdviceLucky` from `CreditResolvedTyped`**, by the union bound over lucky sets. -/
theorem zeroAdviceLucky_of_creditResolvedTyped (hcr : CreditResolvedTyped) : ZeroAdviceLucky := by
  intro n wc D Q k X tag G W p ⟨hn, hQ, hpool⟩ _hwc _hXk hard hb
  set N := 1 * (n * (Q + 1) + 2 * n) with hN
  have hNge : 20490 * n ≤ N := by
    have : 20490 ≤ Q + 3 := by omega
    calc 20490 * n ≤ (Q + 3) * n := Nat.mul_le_mul_right _ this
      _ = N := by rw [hN]; ring
  have hub := union_bound (fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω)
    (fun ω => luckySet p ω tag G W D Q) (fun ω => luckyBits p ω tag G W D)
    (Finset.range n ×ˢ Finset.range (Q + 1)) (9 * n) ((k - X) * (n * wc))
    (2 ^ (9 * n + 1) * Fintype.card (p3ModelT n wc).Ω)
    (fun ω hω => ⟨luckySet_subset p ω tag G W hb, card_luckySet_le p ω tag G W D Q,
      luckyBits_ge p ω tag G W hard hω.1⟩)
    (fun S _ hS => (class_weight_of_typed hcr tag G W p hn hpool hb S).trans
      (Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by norm_num) (by omega))))
  have hT : (Finset.range n ×ˢ Finset.range (Q + 1)).card = n * (Q + 1) := by simp
  rw [hT] at hub
  have hsum : ∑ j ∈ Finset.range (9 * n + 1), Nat.choose (n * (Q + 1)) j ≤ 2 * Nat.choose N (9 * n) :=
    (Finset.sum_le_sum fun j _ => Nat.choose_le_choose j (by rw [hN]; omega)).trans
      (sum_choose_le_two (by omega))
  calc (Finset.univ.filter fun ω => WinZ k tag G W p ω ∧ ¬ labCollT tag G W ω).card * 2 ^ ((k - X) * (n * wc))
      ≤ (∑ j ∈ Finset.range (9 * n + 1), Nat.choose (n * (Q + 1)) j) *
          (2 ^ (9 * n + 1) * Fintype.card (p3ModelT n wc).Ω) := by
        convert hub using 3; ext; simp only [Finset.mem_filter]
    _ ≤ 2 * Nat.choose N (9 * n) * (2 ^ (9 * n + 1) * Fintype.card (p3ModelT n wc).Ω) :=
        Nat.mul_le_mul_right _ hsum
    _ = 2 ^ (9 * n + 2) * Nat.choose N (9 * n) * Fintype.card (p3ModelT n wc).Ω := by ring
    _ ≤ Nat.choose N (10 * n) * Fintype.card (p3ModelT n wc).Ω :=
        Nat.mul_le_mul_right _ (choose_ten_ge hn hNge)
    _ = Nat.choose N (posLucky n) * Fintype.card (p3ModelT n wc).Ω := rfl

/-- **`n10prime` at `10n`, on `okLucky`'s instances, from `CreditResolvedTyped`.** -/
theorem n10prime_of_creditResolvedTyped (h : CreditResolvedTyped) : N10primeAtIf okLucky posLucky :=
  n10prime_of_zeroAdviceLucky (zeroAdviceLucky_of_creditResolvedTyped h)

end PousAssembly

end


/-! ════ Freshness.LuckyChainP3 ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The concrete counting chain, Part A: the answers (`credit-resolved.md` §2, stage 1)

Part A's variable at `(i, c, j)` is the answer to the `j`-th query of program `c`'s round `i` (`ansVar`), or the
all-false label if there is none. Round `i`'s queries are fixed by the answers of rounds `< i`
(`rounds_take_eq_of_ansVar`). So the chain's later variables may read the earlier queries.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousRounds

variable {n wc : ℕ} (p : Fin n → Prog (p3ModelT n wc) (Lab n wc))

/-- The `j`-th query of program `c`'s round `i` under `ω`, if any. -/
noncomputable def qAt (ω : (p3ModelT n wc).Ω) (i : ℕ) (c : Fin n) (j : ℕ) : Option (p3ModelT n wc).Qry :=
  ((rounds ((p3ModelT n wc).answer ω) (p c)).getD i [])[j]?

/-- **Part A's variable**: the answer to program `c`'s `j`-th query of round `i`, or the all-false label. -/
noncomputable def ansVar (ω : (p3ModelT n wc).Ω) (i : ℕ) (c : Fin n) (j : ℕ) : Lab n wc :=
  match qAt p ω i c j with
  | some q => (p3ModelT n wc).answer ω q
  | none => fun _ _ => false

theorem mem_upTo_iff {M : IdealModel} {α : Type} (f : M.Qry → M.Ans) (pr : Prog M α) (t : ℕ) (q : M.Qry) :
    q ∈ upTo f pr t ↔ ∃ i < t, ∃ j : ℕ, ((rounds f pr).getD i [])[j]? = some q := by
  unfold upTo
  simp only [List.mem_flatten, List.getD_eq_getElem?_getD]
  constructor
  · rintro ⟨l, hl, hq⟩
    obtain ⟨i, hi⟩ := List.mem_iff_getElem?.1 hl
    rw [List.getElem?_take] at hi
    split_ifs at hi with hit
    · obtain ⟨j, hj⟩ := List.mem_iff_getElem?.1 hq
      exact ⟨i, hit, j, by rw [hi]; exact hj⟩
  · rintro ⟨i, hi, j, hj⟩
    cases hr : (rounds f pr)[i]? with
    | none => rw [hr] at hj; simp at hj
    | some l =>
      rw [hr] at hj
      refine ⟨l, List.mem_iff_getElem?.2 ⟨i, ?_⟩, List.mem_iff_getElem?.2 ⟨j, hj⟩⟩
      rw [List.getElem?_take, if_pos hi, hr]

/-- **Round `i`'s queries are fixed by the earlier answers.** If `ω` and `ω'` agree on every Part A variable of
program `c` before round `i`, the first `i` rounds agree. -/
theorem rounds_take_eq_of_ansVar {ω ω' : (p3ModelT n wc).Ω} (c : Fin n) :
    ∀ i, (∀ i' < i, ∀ j, ansVar p ω i' c j = ansVar p ω' i' c j) →
      (rounds ((p3ModelT n wc).answer ω) (p c)).take i = (rounds ((p3ModelT n wc).answer ω') (p c)).take i
  | 0, _ => by simp
  | i + 1, h => by
    have ih := rounds_take_eq_of_ansVar c i fun i' hi' j => h i' (by omega) j
    refine rounds_congr (p c) i fun q hq => ?_
    obtain ⟨i', hi', j, hj⟩ := (mem_upTo_iff _ _ _ q).1 hq
    have hq' : qAt p ω' i' c j = some q := by
      have : ((rounds ((p3ModelT n wc).answer ω') (p c)).getD i' []) =
          ((rounds ((p3ModelT n wc).answer ω) (p c)).getD i' []) := by
        have e := congrArg (fun l => l[i']?) ih
        simp only [List.getElem?_take, if_pos hi'] at e
        simp only [List.getD_eq_getElem?_getD, e]
      unfold qAt
      rw [this]
      exact hj
    have hv := h i' (by omega) j
    unfold ansVar at hv
    rw [show qAt p ω i' c j = some q from hj, hq'] at hv
    exact hv

/-! ### Rounds have at most `Q` queries, so positions `j < Q` cover them -/

theorem length_le_of_mem_rounds {M : IdealModel} {α : Type} (f : M.Qry → M.Ans) (pr : Prog M α)
    {l : List M.Qry} (hl : l ∈ rounds f pr) : l.length ≤ pr.work f := by
  have h : l.length ≤ (rounds f pr).flatten.length := by
    rw [List.length_flatten]
    exact List.le_sum_of_mem (List.mem_map_of_mem hl)
  rw [← progTrace_eq_flatten, progTrace_length] at h
  exact h

theorem qAt_eq_none_of_ge {D Q : ℕ} (hb : ∀ c, (p c).Bounded D Q) (ω : (p3ModelT n wc).Ω) (i : ℕ) (c : Fin n)
    {j : ℕ} (hj : Q ≤ j) : qAt p ω i c j = none := by
  unfold qAt
  rw [List.getD_eq_getElem?_getD]
  cases hr : (rounds ((p3ModelT n wc).answer ω) (p c))[i]? with
  | none => simp
  | some l =>
    simp only [Option.getD_some]
    have hl : l ∈ rounds ((p3ModelT n wc).answer ω) (p c) := List.mem_of_getElem? hr
    have := length_le_of_mem_rounds _ _ hl
    have hw := (hb c ω).2
    exact List.getElem?_eq_none (by omega)

theorem ansVar_eq_of_ge {D Q : ℕ} (hb : ∀ c, (p c).Bounded D Q) (ω ω' : (p3ModelT n wc).Ω) (i : ℕ)
    (c : Fin n) {j : ℕ} (hj : Q ≤ j) : ansVar p ω i c j = ansVar p ω' i c j := by
  unfold ansVar
  rw [qAt_eq_none_of_ge p hb ω i c hj, qAt_eq_none_of_ge p hb ω' i c hj]

/-- Round `i` itself is fixed by the answers of rounds `< i`. -/
theorem qAt_eq_of_ansVar {ω ω' : (p3ModelT n wc).Ω} (c : Fin n) (i : ℕ)
    (h : ∀ i' < i, ∀ j, ansVar p ω i' c j = ansVar p ω' i' c j) (j : ℕ) : qAt p ω i c j = qAt p ω' i c j := by
  have htake := rounds_take_eq_of_ansVar p c i h
  have hsucc : (rounds ((p3ModelT n wc).answer ω) (p c)).take (i + 1) =
      (rounds ((p3ModelT n wc).answer ω') (p c)).take (i + 1) := by
    refine rounds_congr (p c) i fun q hq => ?_
    obtain ⟨i', hi', j', hj'⟩ := (mem_upTo_iff _ _ _ q).1 hq
    have hq' : qAt p ω' i' c j' = some q := by
      have : ((rounds ((p3ModelT n wc).answer ω') (p c)).getD i' []) =
          ((rounds ((p3ModelT n wc).answer ω) (p c)).getD i' []) := by
        have e := congrArg (fun l => l[i']?) htake
        simp only [List.getElem?_take, if_pos hi'] at e
        simp only [List.getD_eq_getElem?_getD, e]
      unfold qAt
      rw [this]
      exact hj'
    have hv := h i' hi' j'
    unfold ansVar at hv
    rw [show qAt p ω i' c j' = some q from hj', hq'] at hv
    exact hv
  have e := congrArg (fun l => l[i]?) hsucc
  simp only [List.getElem?_take, if_pos (Nat.lt_succ_self i)] at e
  unfold qAt
  simp only [List.getD_eq_getElem?_getD, e]

/-! ### The Part A index, round-major -/

/-- The chain index of `(i, c, j)`: `i·(n·Q) + c·Q + j`. -/
def encA (n Q i : ℕ) (c : Fin n) (j : ℕ) : ℕ := i * (n * Q) + c * Q + j

theorem encA_lt_of_round_lt {Q i i' : ℕ} (c c' : Fin n) {j j' : ℕ} (hi : i' < i) (hj' : j' < Q) :
    encA n Q i' c' j' < encA n Q i c j := by
  unfold encA
  have hc : (c' : ℕ) * Q + j' < n * Q := by
    have h1 : (c' : ℕ) + 1 ≤ n := c'.isLt
    calc (c' : ℕ) * Q + j' < (c' : ℕ) * Q + Q := by omega
      _ = ((c' : ℕ) + 1) * Q := by ring
      _ ≤ n * Q := Nat.mul_le_mul_right _ h1
  have h2 : i' * (n * Q) + n * Q ≤ i * (n * Q) := by
    calc i' * (n * Q) + n * Q = (i' + 1) * (n * Q) := by ring
      _ ≤ i * (n * Q) := Nat.mul_le_mul_right _ hi
  omega

theorem encA_div {Q i : ℕ} (c : Fin n) {j : ℕ} (hj : j < Q) : encA n Q i c j / (n * Q) = i := by
  unfold encA
  have hc : (c : ℕ) * Q + j < n * Q := by
    have h1 : (c : ℕ) + 1 ≤ n := c.isLt
    calc (c : ℕ) * Q + j < (c : ℕ) * Q + Q := by omega
      _ = ((c : ℕ) + 1) * Q := by ring
      _ ≤ n * Q := Nat.mul_le_mul_right _ h1
  have hpos : 0 < n * Q := by omega
  rw [add_assoc, Nat.add_comm, Nat.add_mul_div_right _ _ hpos, Nat.div_eq_of_lt hc, zero_add]

theorem encA_mod {Q i : ℕ} (c : Fin n) {j : ℕ} (hj : j < Q) : encA n Q i c j % (n * Q) = c * Q + j := by
  unfold encA
  have hc : (c : ℕ) * Q + j < n * Q := by
    have h1 : (c : ℕ) + 1 ≤ n := c.isLt
    calc (c : ℕ) * Q + j < (c : ℕ) * Q + Q := by omega
      _ = ((c : ℕ) + 1) * Q := by ring
      _ ≤ n * Q := Nat.mul_le_mul_right _ h1
  rw [add_assoc, Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hc]

theorem encA_lt {D Q i : ℕ} (c : Fin n) {j : ℕ} (hi : i < D) (hj : j < Q) : encA n Q i c j < D * (n * Q) := by
  have hc : (c : ℕ) * Q + j < n * Q := by
    have h1 : (c : ℕ) + 1 ≤ n := c.isLt
    calc (c : ℕ) * Q + j < (c : ℕ) * Q + Q := by omega
      _ = ((c : ℕ) + 1) * Q := by ring
      _ ≤ n * Q := Nat.mul_le_mul_right _ h1
  have h2 : (i + 1) * (n * Q) ≤ D * (n * Q) := Nat.mul_le_mul_right _ hi
  unfold encA
  nlinarith

/-! ### The chain: Part A decoded, then Part B -/

section Chain

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (D Q : ℕ)

/-- Part B's variables, by index `b < 4n`: `K1_v` and `Y1_v` for each lower `v`, then `K2_u` and `Y2_u` for each
top `u`. -/
noncomputable def partB (ω : (p3ModelT n wc).Ω) (b : ℕ) : Lab n wc :=
  if h : b < 2 * n then
    if b % 2 = 0 then ω.1 (hk1 τ G W ω ⟨b / 2, by omega⟩) else c1 τ G W ω ⟨b / 2, by omega⟩
  else if h' : b < 4 * n then
    if b % 2 = 0 then ω.1 (hk2 τ G W ω ⟨(b - 2 * n) / 2, by omega⟩)
    else c2 τ G W ω ⟨(b - 2 * n) / 2, by omega⟩
  else fun _ _ => false

theorem partA_c_lt {ℓ : ℕ} (h : ℓ < D * (n * Q)) : ℓ % (n * Q) / Q < n := by
  have hpos : 0 < n * Q := by
    rcases Nat.eq_zero_or_pos (n * Q) with h0 | h0
    · rw [h0, mul_zero] at h; omega
    · exact h0
  have hQ : 0 < Q := Nat.pos_of_mul_pos_left hpos
  exact (Nat.div_lt_iff_lt_mul hQ).2 (Nat.mod_lt _ hpos)

/-- **The chain**: Part A (answers, round-major), then Part B (honest sources, topological). -/
noncomputable def chainX (ℓ : ℕ) (ω : (p3ModelT n wc).Ω) : Lab n wc :=
  if h : ℓ < D * (n * Q) then
    ansVar p ω (ℓ / (n * Q)) ⟨ℓ % (n * Q) / Q, partA_c_lt D Q h⟩ (ℓ % Q)
  else partB τ G W ω (ℓ - D * (n * Q))

theorem chainX_encA {i : ℕ} (c : Fin n) {j : ℕ} (hi : i < D) (hj : j < Q) (ω : (p3ModelT n wc).Ω) :
    chainX p τ G W D Q (encA n Q i c j) ω = ansVar p ω i c j := by
  have hlt := encA_lt (D := D) c hi hj
  unfold chainX
  rw [dif_pos hlt]
  have hdiv := encA_div (i := i) c hj
  have hmod := encA_mod (i := i) c hj
  have hQpos : 0 < Q := by omega
  have hc : (c * Q + j) / Q = c := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hQpos, Nat.div_eq_of_lt hj, zero_add]
  have hj' : encA n Q i c j % Q = j := by
    unfold encA
    rw [Nat.add_mod, Nat.add_mod (i * (n * Q)), show i * (n * Q) = (i * n) * Q by ring, Nat.mul_mod_left,
      Nat.mul_mod_left, Nat.mod_eq_of_lt hj]
    simp [Nat.mod_eq_of_lt hj]
  have hfin : (⟨encA n Q i c j % (n * Q) / Q, partA_c_lt D Q hlt⟩ : Fin n) = c := by
    ext; simp only [hmod, hc]
  rw [hdiv, hfin, hj']

/-- **A Part A variable's query is fixed by the earlier chain variables.** -/
theorem qAt_eq_of_prefix (hb : ∀ c, (p c).Bounded D Q) {i : ℕ} (c : Fin n) {j : ℕ} (hi : i < D) (hj : j < Q)
    {ω ω' : (p3ModelT n wc).Ω} (h : PousLuckyChain.PrefixEq (chainX p τ G W D Q) (encA n Q i c j) ω ω') :
    qAt p ω i c j = qAt p ω' i c j := by
  refine qAt_eq_of_ansVar p c i (fun i' hi' j' => ?_) j
  rcases Nat.lt_or_ge j' Q with hj' | hj'
  · have e := h (encA n Q i' c j') (encA_lt_of_round_lt c c hi' hj')
    rwa [chainX_encA p τ G W D Q c (hi'.trans hi) hj', chainX_encA p τ G W D Q c (hi'.trans hi) hj'] at e
  · exact ansVar_eq_of_ge p hb ω ω' i' c hj'

/-- The query of chain index `ℓ` (Part A only). -/
noncomputable def qIdx (ω : (p3ModelT n wc).Ω) (ℓ : ℕ) : Option (p3ModelT n wc).Qry :=
  if h : ℓ < D * (n * Q) then qAt p ω (ℓ / (n * Q)) ⟨ℓ % (n * Q) / Q, partA_c_lt D Q h⟩ (ℓ % Q) else none

theorem encA_decode {ℓ : ℕ} (h : ℓ < D * (n * Q)) :
    encA n Q (ℓ / (n * Q)) ⟨ℓ % (n * Q) / Q, partA_c_lt D Q h⟩ (ℓ % Q) = ℓ := by
  unfold encA
  have hdvd : Q ∣ n * Q := Dvd.intro_left n rfl
  have h1 := Nat.div_add_mod ℓ (n * Q)
  have h2 := Nat.div_add_mod (ℓ % (n * Q)) Q
  rw [Nat.mod_mod_of_dvd ℓ hdvd] at h2
  simp only
  nlinarith

theorem decode_lt {ℓ : ℕ} (h : ℓ < D * (n * Q)) : ℓ / (n * Q) < D := by
  have hpos : 0 < n * Q := by
    rcases Nat.eq_zero_or_pos (n * Q) with h0 | h0
    · rw [h0, mul_zero] at h; omega
    · exact h0
  exact (Nat.div_lt_iff_lt_mul hpos).2 h

theorem mod_Q_lt {ℓ : ℕ} (h : ℓ < D * (n * Q)) : ℓ % Q < Q := by
  have hpos : 0 < n * Q := by
    rcases Nat.eq_zero_or_pos (n * Q) with h0 | h0
    · rw [h0, mul_zero] at h; omega
    · exact h0
  exact Nat.mod_lt _ (Nat.pos_of_mul_pos_left hpos)

/-- On Part A, the chain variable is the answer to `qIdx`, or the all-false label. -/
theorem chainX_partA {ℓ : ℕ} (h : ℓ < D * (n * Q)) (ω : (p3ModelT n wc).Ω) :
    chainX p τ G W D Q ℓ ω =
      match qIdx p D Q ω ℓ with
      | some q => (p3ModelT n wc).answer ω q
      | none => fun _ _ => false := by
  unfold chainX qIdx ansVar
  rw [dif_pos h, dif_pos h]

/-- **`qIdx` is fixed by the earlier chain variables.** -/
theorem qIdx_eq_of_prefix (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} {ω ω' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX p τ G W D Q) ℓ ω ω') : qIdx p D Q ω ℓ = qIdx p D Q ω' ℓ := by
  unfold qIdx
  by_cases hl : ℓ < D * (n * Q)
  · rw [dif_pos hl, dif_pos hl]
    have he := encA_decode D Q hl
    refine qAt_eq_of_prefix p τ G W D Q hb _ (decode_lt D Q hl) (mod_Q_lt D Q hl) ?_
    rw [he]; exact h
  · rw [dif_neg hl, dif_neg hl]

end Chain

end PousKnowledge

end


/-! ════ Freshness.LuckyChainPools ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Free sets and pools of the concrete chain (`credit-resolved.md` §2, stage 1)

- `knownPairs ω ℓ`: the (query, answer) pairs of the Part A variables before `ℓ`. It is fixed by the prefix
  (`knownPairs_eq_of_prefix`).
- `freeOf K q`: the values a query `q` can still take given known pairs `K`:
  - an `H` point already asked gives its answer;
  - a fresh `H` point gives `Lab`;
  - a `P_t` input (output) already known gives its partner;
  - a fresh one gives `Lab` minus the known outputs (inputs) of `t`.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousRounds
open Classical

variable {n wc : ℕ} (p : Fin n → Prog (p3ModelT n wc) (Lab n wc))
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (D Q : ℕ)

/-- The (query, answer) pairs of the Part A variables before `ℓ`. -/
noncomputable def knownPairs (ω : (p3ModelT n wc).Ω) (ℓ : ℕ) : Finset ((p3ModelT n wc).Qry × Lab n wc) :=
  (Finset.range ℓ).biUnion fun ℓ' =>
    match qIdx p D Q ω ℓ' with
    | some q => {(q, chainX p τ G W D Q ℓ' ω)}
    | none => ∅

theorem prefixEq_mono {X : ℕ → (p3ModelT n wc).Ω → Lab n wc} {ℓ ℓ' : ℕ} (hle : ℓ' ≤ ℓ)
    {ω ω' : (p3ModelT n wc).Ω} (h : PousLuckyChain.PrefixEq X ℓ ω ω') : PousLuckyChain.PrefixEq X ℓ' ω ω' :=
  fun i hi => h i (lt_of_lt_of_le hi hle)

/-- **The known pairs are fixed by the prefix.** -/
theorem knownPairs_eq_of_prefix (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} {ω ω' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX p τ G W D Q) ℓ ω ω') :
    knownPairs p τ G W D Q ω ℓ = knownPairs p τ G W D Q ω' ℓ := by
  unfold knownPairs
  refine Finset.biUnion_congr rfl fun ℓ' hℓ' => ?_
  have hlt := Finset.mem_range.1 hℓ'
  rw [qIdx_eq_of_prefix p τ G W D Q hb (prefixEq_mono hlt.le h), h ℓ' hlt]

/-! ### Free sets of a query, given known pairs -/

/-- The known `(input, output)` pairs of `P_t`. -/
noncomputable def knownIO (K : Finset ((p3ModelT n wc).Qry × Lab n wc)) (t : Tweak n) :
    Finset (Lab n wc × Lab n wc) :=
  K.biUnion fun qa =>
    match qa.1 with
    | Sum.inr (Sum.inl ty) => if ty.1 = t then {(ty.2, qa.2)} else ∅
    | Sum.inr (Sum.inr tz) => if tz.1 = t then {(qa.2, tz.2)} else ∅
    | Sum.inl _ => ∅

/-- The known answers at `H` point `h`. -/
noncomputable def knownHAt (K : Finset ((p3ModelT n wc).Qry × Lab n wc)) (h : KQ' n wc) : Finset (Lab n wc) :=
  (K.filter fun qa => qa.1 = Sum.inl h).image Prod.snd

/-- **The free set of query `q`** given known pairs `K`. -/
noncomputable def freeOf (K : Finset ((p3ModelT n wc).Qry × Lab n wc)) : (p3ModelT n wc).Qry → Finset (Lab n wc)
  | Sum.inl h => if (knownHAt K h).Nonempty then knownHAt K h else Finset.univ
  | Sum.inr (Sum.inl ty) =>
      if ((knownIO K ty.1).filter fun io => io.1 = ty.2).Nonempty then
        ((knownIO K ty.1).filter fun io => io.1 = ty.2).image Prod.snd
      else Finset.univ \ (knownIO K ty.1).image Prod.snd
  | Sum.inr (Sum.inr tz) =>
      if ((knownIO K tz.1).filter fun io => io.2 = tz.2).Nonempty then
        ((knownIO K tz.1).filter fun io => io.2 = tz.2).image Prod.fst
      else Finset.univ \ (knownIO K tz.1).image Prod.fst

/-! ### Part B's variables, by index -/

theorem chainX_K1 (v : Fin n) (ω : (p3ModelT n wc).Ω) :
    chainX p τ G W D Q (D * (n * Q) + 2 * v) ω = ω.1 (hk1 τ G W ω v) := by
  unfold chainX partB
  rw [dif_neg (by omega), show D * (n * Q) + 2 * (v : ℕ) - D * (n * Q) = 2 * v by omega, dif_pos (by omega),
    if_pos (by omega)]
  congr 3
  ext; simp

theorem chainX_Y1 (v : Fin n) (ω : (p3ModelT n wc).Ω) :
    chainX p τ G W D Q (D * (n * Q) + (2 * v + 1)) ω = c1 τ G W ω v := by
  unfold chainX partB
  rw [dif_neg (by omega), show D * (n * Q) + (2 * (v : ℕ) + 1) - D * (n * Q) = 2 * v + 1 by omega,
    dif_pos (by omega), if_neg (by omega)]
  congr 1
  ext; simp <;> omega

theorem chainX_K2 (u : Fin n) (ω : (p3ModelT n wc).Ω) :
    chainX p τ G W D Q (D * (n * Q) + (2 * n + 2 * u)) ω = ω.1 (hk2 τ G W ω u) := by
  unfold chainX partB
  rw [dif_neg (by omega), show D * (n * Q) + (2 * n + 2 * (u : ℕ)) - D * (n * Q) = 2 * n + 2 * u by omega,
    dif_neg (by omega), dif_pos (by omega), if_pos (by omega)]
  congr 3
  ext; simp <;> omega

theorem chainX_Y2 (u : Fin n) (ω : (p3ModelT n wc).Ω) :
    chainX p τ G W D Q (D * (n * Q) + (2 * n + 2 * u + 1)) ω = c2 τ G W ω u := by
  unfold chainX partB
  rw [dif_neg (by omega),
    show D * (n * Q) + (2 * n + 2 * (u : ℕ) + 1) - D * (n * Q) = 2 * n + 2 * u + 1 by omega,
    dif_neg (by omega), dif_pos (by omega), if_neg (by omega)]
  congr 1
  ext; simp <;> omega

/-! ### Honest locations are fixed by the earlier variables -/

variable {p τ G W D Q}

theorem hk1_eq_of_prefix (v : Fin n) {ω ω' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX p τ G W D Q) (D * (n * Q) + 2 * v) ω ω') :
    hk1 τ G W ω v = hk1 τ G W ω' v := by
  unfold hk1
  congr 3
  funext u
  by_cases hu : u ∈ G.par v
  · rw [dif_pos hu, dif_pos hu]
    have hlt := G.par_lt v u hu
    have e := h (D * (n * Q) + (2 * u + 1)) (by omega)
    rw [chainX_Y1, chainX_Y1] at e
    rw [e]
  · rw [dif_neg hu, dif_neg hu]

theorem in1_eq_of_prefix (v : Fin n) {ω ω' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX p τ G W D Q) (D * (n * Q) + (2 * v + 1)) ω ω') :
    in1 τ G W ω v = in1 τ G W ω' v := by
  unfold in1
  have e := h (D * (n * Q) + 2 * v) (by omega)
  rw [chainX_K1, chainX_K1] at e
  rw [e]

theorem hk2_eq_of_prefix (u : Fin n) {ω ω' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX p τ G W D Q) (D * (n * Q) + (2 * n + 2 * u)) ω ω') :
    hk2 τ G W ω u = hk2 τ G W ω' u := by
  unfold hk2
  congr 3
  funext v
  by_cases hv : v ∈ G.par u
  · rw [dif_pos hv, dif_pos hv]
    have hlt := G.par_lt u v hv
    have e := h (D * (n * Q) + (2 * n + 2 * v + 1)) (by omega)
    rw [chainX_Y2, chainX_Y2] at e
    rw [e]
  · rw [dif_neg hv, dif_neg hv]

theorem in2_eq_of_prefix (u : Fin n) {ω ω' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX p τ G W D Q) (D * (n * Q) + (2 * n + 2 * u + 1)) ω ω') :
    in2 τ G W ω u = in2 τ G W ω' u := by
  unfold in2
  have hc : c1 τ G W ω = c1 τ G W ω' := by
    funext w
    have e := h (D * (n * Q) + (2 * w + 1)) (by omega)
    rwa [chainX_Y1, chainX_Y1] at e
  have e := h (D * (n * Q) + (2 * n + 2 * u)) (by omega)
  rw [chainX_K2, chainX_K2] at e
  rw [hc, e]

/-! ### The chain's free sets and pools -/

variable (p τ G W D Q)

/-- **The free set of chain variable `ℓ`.** Part A: `freeOf` of its query given the earlier pairs. Part B: `freeOf` of
the honest source's query (`H` at `hk`, or `P_t` forward at the honest input) given all Part A pairs. -/
noncomputable def Fr (ℓ : ℕ) (ω : (p3ModelT n wc).Ω) : Finset (Lab n wc) :=
  if ℓ < D * (n * Q) then
    match qIdx p D Q ω ℓ with
    | some q => freeOf (knownPairs p τ G W D Q ω ℓ) q
    | none => {fun _ _ => false}
  else if h : ℓ - D * (n * Q) < 2 * n then
    if (ℓ - D * (n * Q)) % 2 = 0 then
      freeOf (knownPairs p τ G W D Q ω (D * (n * Q)))
        (Sum.inl (hk1 τ G W ω ⟨(ℓ - D * (n * Q)) / 2, by omega⟩))
    else freeOf (knownPairs p τ G W D Q ω (D * (n * Q)))
        (qP1 τ G W ω ⟨(ℓ - D * (n * Q)) / 2, by omega⟩)
  else if h' : ℓ - D * (n * Q) < 4 * n then
    if (ℓ - D * (n * Q)) % 2 = 0 then
      freeOf (knownPairs p τ G W D Q ω (D * (n * Q)))
        (Sum.inl (hk2 τ G W ω ⟨(ℓ - D * (n * Q) - 2 * n) / 2, by omega⟩))
    else freeOf (knownPairs p τ G W D Q ω (D * (n * Q)))
        (qP2 τ G W ω ⟨(ℓ - D * (n * Q) - 2 * n) / 2, by omega⟩)
  else {fun _ _ => false}

/-- The pool of chain variable `ℓ`: the size of its free set. -/
noncomputable def Pool (ℓ : ℕ) (ω : (p3ModelT n wc).Ω) : ℕ := (Fr p τ G W D Q ℓ ω).card

variable {p τ G W D Q}

/-- **The free sets are fixed by the prefix.** -/
theorem Fr_eq_of_prefix (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} {ω ω' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX p τ G W D Q) ℓ ω ω') : Fr p τ G W D Q ℓ ω = Fr p τ G W D Q ℓ ω' := by
  unfold Fr
  by_cases hA : ℓ < D * (n * Q)
  · rw [if_pos hA, if_pos hA, qIdx_eq_of_prefix p τ G W D Q hb h, knownPairs_eq_of_prefix p τ G W D Q hb h]
  rw [if_neg hA, if_neg hA]
  have hK : knownPairs p τ G W D Q ω (D * (n * Q)) = knownPairs p τ G W D Q ω' (D * (n * Q)) :=
    knownPairs_eq_of_prefix p τ G W D Q hb (prefixEq_mono (by omega) h)
  rw [hK]
  by_cases hB : ℓ - D * (n * Q) < 2 * n
  · rw [dif_pos hB, dif_pos hB]
    set v : Fin n := ⟨(ℓ - D * (n * Q)) / 2, by omega⟩
    by_cases hpar : (ℓ - D * (n * Q)) % 2 = 0
    · rw [if_pos hpar, if_pos hpar]
      have hl : ℓ = D * (n * Q) + 2 * v := by simp only [v]; omega
      rw [hk1_eq_of_prefix v (hl ▸ h)]
    · rw [if_neg hpar, if_neg hpar]
      have hl : ℓ = D * (n * Q) + (2 * v + 1) := by simp only [v]; omega
      unfold qP1
      rw [in1_eq_of_prefix v (hl ▸ h)]
  rw [dif_neg hB, dif_neg hB]
  by_cases hC : ℓ - D * (n * Q) < 4 * n
  · rw [dif_pos hC, dif_pos hC]
    set u : Fin n := ⟨(ℓ - D * (n * Q) - 2 * n) / 2, by omega⟩
    by_cases hpar : (ℓ - D * (n * Q)) % 2 = 0
    · rw [if_pos hpar, if_pos hpar]
      have hl : ℓ = D * (n * Q) + (2 * n + 2 * u) := by simp only [u]; omega
      rw [hk2_eq_of_prefix u (hl ▸ h)]
    · rw [if_neg hpar, if_neg hpar]
      have hl : ℓ = D * (n * Q) + (2 * n + 2 * u + 1) := by simp only [u]; omega
      unfold qP2
      rw [in2_eq_of_prefix u (hl ▸ h)]
  · rw [dif_neg hC, dif_neg hC]

theorem Pool_eq_of_prefix (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} {ω ω' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX p τ G W D Q) ℓ ω ω') :
    Pool p τ G W D Q ℓ ω = Pool p τ G W D Q ℓ ω' := by
  unfold Pool; rw [Fr_eq_of_prefix hb h]

end PousKnowledge

end


/-! ════ Freshness.LuckyChainFibre ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The concrete chain's fibre property (`credit-resolved.md` §2, stage 1)

1. Known pairs are consistent with `ω` (`knownPairs_answer`, `knownIO_apply`, `knownHAt_eq`).
2. Every chain variable lies in its free set (`chainX_mem_Fr`).
3. Moves: resampling a fresh variable keeps its prefix class, maps fibres injectively (`fibre_chain`).
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousRounds

variable {n wc : ℕ} {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)}
  {τ : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc} {D Q : ℕ}

/-! ### 1. Known pairs are consistent -/

theorem mem_knownPairs {ω : (p3ModelT n wc).Ω} {ℓ : ℕ} {q : (p3ModelT n wc).Qry} {a : Lab n wc}
    (h : (q, a) ∈ knownPairs p τ G W D Q ω ℓ) :
    a = (p3ModelT n wc).answer ω q ∧ ∃ ℓ' < ℓ, qIdx p D Q ω ℓ' = some q := by
  classical
  unfold knownPairs at h
  obtain ⟨ℓ', hℓ', hm⟩ := Finset.mem_biUnion.1 h
  have hlt := Finset.mem_range.1 hℓ'
  cases hq : qIdx p D Q ω ℓ' with
  | none => rw [hq] at hm; simp at hm
  | some q' =>
    rw [hq] at hm
    simp only [Finset.mem_singleton, Prod.mk.injEq] at hm
    obtain ⟨rfl, rfl⟩ := hm
    have hA : ℓ' < D * (n * Q) := by
      by_contra hc
      unfold qIdx at hq
      rw [dif_neg hc] at hq
      cases hq
    rw [chainX_partA p τ G W D Q hA, hq]
    exact ⟨rfl, ℓ', hlt, hq⟩

theorem knownPairs_answer {ω : (p3ModelT n wc).Ω} {ℓ : ℕ} {q : (p3ModelT n wc).Qry} {a : Lab n wc}
    (h : (q, a) ∈ knownPairs p τ G W D Q ω ℓ) : a = (p3ModelT n wc).answer ω q :=
  (mem_knownPairs h).1

theorem knownIO_apply {ω : (p3ModelT n wc).Ω} {ℓ : ℕ} {t : Tweak n} {io : Lab n wc × Lab n wc}
    (h : io ∈ knownIO (knownPairs p τ G W D Q ω ℓ) t) : ω.2 t io.1 = io.2 := by
  classical
  unfold knownIO at h
  obtain ⟨⟨q, a⟩, hqa, hm⟩ := Finset.mem_biUnion.1 h
  have ha := knownPairs_answer hqa
  rcases q with hq | ⟨ty⟩ | ⟨tz⟩
  · simp at hm
  · simp only at hm
    split_ifs at hm with ht
    · rw [Finset.mem_singleton] at hm
      subst hm
      rw [← ht, ha]
      rfl
    · simp at hm
  · simp only at hm
    split_ifs at hm with ht
    · rw [Finset.mem_singleton] at hm
      subst hm
      rw [← ht, ha]
      show ω.2 tz.1 ((ω.2 tz.1).symm tz.2) = tz.2
      exact Equiv.apply_symm_apply _ _
    · simp at hm

theorem knownHAt_eq {ω : (p3ModelT n wc).Ω} {ℓ : ℕ} {hq : KQ' n wc} {a : Lab n wc}
    (h : a ∈ knownHAt (knownPairs p τ G W D Q ω ℓ) hq) : a = ω.1 hq := by
  classical
  unfold knownHAt at h
  obtain ⟨⟨q, a'⟩, hm, rfl⟩ := Finset.mem_image.1 h
  obtain ⟨hmem, hqe⟩ := Finset.mem_filter.1 hm
  simp only at hqe
  subst hqe
  exact knownPairs_answer hmem

/-! ### 2. Every answer lies in the free set of its query -/

theorem answer_mem_freeOf {ω : (p3ModelT n wc).Ω} {ℓ : ℕ} (q : (p3ModelT n wc).Qry) :
    (p3ModelT n wc).answer ω q ∈ freeOf (knownPairs p τ G W D Q ω ℓ) q := by
  classical
  rcases q with hq | ⟨ty⟩ | ⟨tz⟩
  · change (ω.1 hq : Lab n wc) ∈ freeOf (knownPairs p τ G W D Q ω ℓ) (Sum.inl hq)
    simp only [freeOf]
    split_ifs with hne
    · obtain ⟨a, ha⟩ := hne
      rw [← knownHAt_eq ha]
      exact ha
    · exact Finset.mem_univ _
  · change (ω.2 ty.1 ty.2 : Lab n wc) ∈ freeOf (knownPairs p τ G W D Q ω ℓ) (Sum.inr (Sum.inl ty))
    simp only [freeOf]
    split_ifs with hne
    · obtain ⟨io, hio⟩ := hne
      obtain ⟨hmem, hin⟩ := Finset.mem_filter.1 hio
      refine Finset.mem_image.2 ⟨io, hio, ?_⟩
      rw [← knownIO_apply hmem, hin]
    · refine Finset.mem_sdiff.2 ⟨Finset.mem_univ _, fun hout => hne ?_⟩
      obtain ⟨io, hio, hio2⟩ := Finset.mem_image.1 hout
      have hap := knownIO_apply hio
      have : io.1 = ty.2 := by
        apply (ω.2 ty.1).injective
        rw [hap, hio2]
      exact ⟨io, Finset.mem_filter.2 ⟨hio, this⟩⟩
  · change ((ω.2 tz.1).symm tz.2 : Lab n wc) ∈ freeOf (knownPairs p τ G W D Q ω ℓ) (Sum.inr (Sum.inr tz))
    simp only [freeOf]
    split_ifs with hne
    · obtain ⟨io, hio⟩ := hne
      obtain ⟨hmem, hout⟩ := Finset.mem_filter.1 hio
      refine Finset.mem_image.2 ⟨io, hio, ?_⟩
      have hap := knownIO_apply hmem
      rw [← hout, ← hap, Equiv.symm_apply_apply]
    · refine Finset.mem_sdiff.2 ⟨Finset.mem_univ _, fun hin => hne ?_⟩
      obtain ⟨io, hio, hio1⟩ := Finset.mem_image.1 hin
      have hap := knownIO_apply hio
      have : io.2 = tz.2 := by
        rw [← hap, hio1, Equiv.apply_symm_apply]
      exact ⟨io, Finset.mem_filter.2 ⟨hio, this⟩⟩

/-- `c¹_v` is `P_{(τ,0,v)}` at the honest input (`c2_eq` is in `KnowledgeSimProof.lean`). -/
theorem c1_eq (ω : (p3ModelT n wc).Ω) (v : Fin n) : c1 τ G W ω v = ω.2 (τ, 0, v) (in1 τ G W ω v) := by
  show c1T τ G ω.1 ω.2 W v = _
  rw [c1T]
  rfl

/-- **Every chain variable lies in its free set.** -/
theorem chainX_mem_Fr (ℓ : ℕ) (ω : (p3ModelT n wc).Ω) : chainX p τ G W D Q ℓ ω ∈ Fr p τ G W D Q ℓ ω := by
  unfold Fr
  by_cases hA : ℓ < D * (n * Q)
  · rw [if_pos hA, chainX_partA p τ G W D Q hA]
    cases hq : qIdx p D Q ω ℓ with
    | none => exact Finset.mem_singleton_self _
    | some q => exact answer_mem_freeOf q
  rw [if_neg hA]
  by_cases hB : ℓ - D * (n * Q) < 2 * n
  · rw [dif_pos hB]
    set v : Fin n := ⟨(ℓ - D * (n * Q)) / 2, by omega⟩
    by_cases hpar : (ℓ - D * (n * Q)) % 2 = 0
    · rw [if_pos hpar]
      have hl : ℓ = D * (n * Q) + 2 * v := by simp only [v]; omega
      rw [hl, chainX_K1]
      exact answer_mem_freeOf (Sum.inl (hk1 τ G W ω v))
    · rw [if_neg hpar]
      have hl : ℓ = D * (n * Q) + (2 * v + 1) := by simp only [v]; omega
      rw [hl, chainX_Y1, c1_eq]
      exact answer_mem_freeOf (qP1 τ G W ω v)
  rw [dif_neg hB]
  by_cases hC : ℓ - D * (n * Q) < 4 * n
  · rw [dif_pos hC]
    set u : Fin n := ⟨(ℓ - D * (n * Q) - 2 * n) / 2, by omega⟩
    by_cases hpar : (ℓ - D * (n * Q)) % 2 = 0
    · rw [if_pos hpar]
      have hl : ℓ = D * (n * Q) + (2 * n + 2 * u) := by simp only [u]; omega
      rw [hl, chainX_K2]
      exact answer_mem_freeOf (Sum.inl (hk2 τ G W ω u))
    · rw [if_neg hpar]
      have hl : ℓ = D * (n * Q) + (2 * n + 2 * u + 1) := by simp only [u]; omega
      rw [hl, chainX_Y2, c2_eq τ G W ω u]
      exact answer_mem_freeOf (qP2 τ G W ω u)
  · rw [dif_neg hC]
    unfold chainX partB
    rw [dif_neg hA, dif_neg hB, dif_neg hC]
    exact Finset.mem_singleton_self _

/-! ### 3a. Agreeing on the known queries keeps the Part A prefix -/

/-- If `ω''` answers every known query before `ℓ` as `ω'` does, and `ℓ` is within Part A, they share the prefix. -/
theorem prefix_of_agree (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} (hℓ : ℓ ≤ D * (n * Q))
    {ω' ω'' : (p3ModelT n wc).Ω}
    (hag : ∀ q a, (q, a) ∈ knownPairs p τ G W D Q ω' ℓ →
      (p3ModelT n wc).answer ω'' q = (p3ModelT n wc).answer ω' q) :
    PousLuckyChain.PrefixEq (chainX p τ G W D Q) ℓ ω' ω'' := by
  classical
  suffices H : ∀ m ≤ ℓ, PousLuckyChain.PrefixEq (chainX p τ G W D Q) m ω' ω'' from H ℓ le_rfl
  intro m
  induction m with
  | zero => intro _ i hi; omega
  | succ m ih =>
    intro hm i hi
    have hpre := ih (by omega)
    rcases Nat.lt_or_ge i m with him | him
    · exact hpre i him
    have hie : i = m := by omega
    subst hie
    have hA : i < D * (n * Q) := by omega
    rw [chainX_partA p τ G W D Q hA, chainX_partA p τ G W D Q hA,
      ← qIdx_eq_of_prefix p τ G W D Q hb hpre]
    cases hq : qIdx p D Q ω' i with
    | none => rfl
    | some q =>
      have hmem : (q, chainX p τ G W D Q i ω') ∈ knownPairs p τ G W D Q ω' ℓ := by
        unfold knownPairs
        refine Finset.mem_biUnion.2 ⟨i, Finset.mem_range.2 (by omega), ?_⟩
        rw [hq]
        exact Finset.mem_singleton_self _
      exact (hag q _ hmem).symm

/-! ### 3b. The three moves on `Ω`, and the answers they keep -/

section Moves

open Classical

/-- Set `H(h) := y`. -/
noncomputable def updHΩ (h : KQ' n wc) (y : Lab n wc) (ω : (p3ModelT n wc).Ω) : (p3ModelT n wc).Ω :=
  (Function.update ω.1 h y, ω.2)

/-- Resample `P_t`'s forward answer at `z` to `y`: `P_t := swapOut P_t z y`. -/
noncomputable def movFΩ (t : Tweak n) (z y : Lab n wc) (ω : (p3ModelT n wc).Ω) : (p3ModelT n wc).Ω :=
  (ω.1, Function.update ω.2 t (swapOut (ω.2 t) z y))

/-- Resample `P_t`'s inverse answer at `w` to `x`: `P_t := swapIn P_t w x`. -/
noncomputable def movIΩ (t : Tweak n) (w x : Lab n wc) (ω : (p3ModelT n wc).Ω) : (p3ModelT n wc).Ω :=
  (ω.1, Function.update ω.2 t (swapIn (ω.2 t) w x))

theorem answer_updHΩ_self (h : KQ' n wc) (y : Lab n wc) (ω : (p3ModelT n wc).Ω) :
    (p3ModelT n wc).answer (updHΩ h y ω) (Sum.inl h) = y := by
  show Function.update ω.1 h y h = y
  exact Function.update_self _ _ _

theorem answer_updHΩ_ne (h : KQ' n wc) (y : Lab n wc) (ω : (p3ModelT n wc).Ω) {q : (p3ModelT n wc).Qry}
    (hq : q ≠ Sum.inl h) : (p3ModelT n wc).answer (updHΩ h y ω) q = (p3ModelT n wc).answer ω q := by
  rcases q with h' | ⟨ty⟩ | ⟨tz⟩
  · have : h' ≠ h := fun e => hq (by rw [e])
    show Function.update ω.1 h y h' = ω.1 h'
    exact Function.update_of_ne this _ _
  · rfl
  · rfl

theorem answer_movFΩ_self (t : Tweak n) (z y : Lab n wc) (ω : (p3ModelT n wc).Ω) :
    (p3ModelT n wc).answer (movFΩ t z y ω) (Sum.inr (Sum.inl (t, z))) = y := by
  show Function.update ω.2 t (swapOut (ω.2 t) z y) t z = y
  rw [Function.update_self]
  exact swapOut_apply_x _ _ _

/-- `movFΩ t z y` keeps every answer except forward at `z` or at `P_t⁻¹(y)`, and inverse at `P_t z` or at `y`. -/
theorem answer_movFΩ_keep (t : Tweak n) (z y : Lab n wc) (ω : (p3ModelT n wc).Ω) (q : (p3ModelT n wc).Qry)
    (hf : ∀ z', q = Sum.inr (Sum.inl (t, z')) → z' ≠ z ∧ z' ≠ (ω.2 t).symm y)
    (hi : ∀ w, q = Sum.inr (Sum.inr (t, w)) → w ≠ ω.2 t z ∧ w ≠ y) :
    (p3ModelT n wc).answer (movFΩ t z y ω) q = (p3ModelT n wc).answer ω q := by
  rcases q with h' | ⟨⟨t', z'⟩⟩ | ⟨⟨t', w⟩⟩
  · rfl
  · show Function.update ω.2 t (swapOut (ω.2 t) z y) t' z' = ω.2 t' z'
    by_cases ht : t' = t
    · subst ht
      rw [Function.update_self]
      obtain ⟨h1, h2⟩ := hf z' rfl
      exact swapOut_forward _ _ _ _ h1 h2
    · rw [Function.update_of_ne ht]
  · show (Function.update ω.2 t (swapOut (ω.2 t) z y) t').symm w = (ω.2 t').symm w
    by_cases ht : t' = t
    · subst ht
      rw [Function.update_self]
      obtain ⟨h1, h2⟩ := hi w rfl
      exact swapOut_inverse _ _ _ _ h1 h2
    · rw [Function.update_of_ne ht]

theorem answer_movIΩ_self (t : Tweak n) (w x : Lab n wc) (ω : (p3ModelT n wc).Ω) :
    (p3ModelT n wc).answer (movIΩ t w x ω) (Sum.inr (Sum.inr (t, w))) = x := by
  show (Function.update ω.2 t (swapIn (ω.2 t) w x) t).symm w = x
  rw [Function.update_self]
  exact swapIn_symm_apply_w _ _ _

/-- `movIΩ t w x` keeps every answer except forward at `P_t⁻¹ w` or at `x`, and inverse at `w` or at `P_t x`. -/
theorem answer_movIΩ_keep (t : Tweak n) (w x : Lab n wc) (ω : (p3ModelT n wc).Ω) (q : (p3ModelT n wc).Qry)
    (hf : ∀ z, q = Sum.inr (Sum.inl (t, z)) → z ≠ (ω.2 t).symm w ∧ z ≠ x)
    (hi : ∀ v, q = Sum.inr (Sum.inr (t, v)) → v ≠ w ∧ v ≠ ω.2 t x) :
    (p3ModelT n wc).answer (movIΩ t w x ω) q = (p3ModelT n wc).answer ω q := by
  rcases q with h' | ⟨⟨t', z⟩⟩ | ⟨⟨t', v⟩⟩
  · rfl
  · show Function.update ω.2 t (swapIn (ω.2 t) w x) t' z = ω.2 t' z
    by_cases ht : t' = t
    · subst ht
      rw [Function.update_self]
      obtain ⟨h1, h2⟩ := hf z rfl
      exact swapIn_forward _ _ _ _ h1 h2
    · rw [Function.update_of_ne ht]
  · show (Function.update ω.2 t (swapIn (ω.2 t) w x) t').symm v = (ω.2 t').symm v
    by_cases ht : t' = t
    · subst ht
      rw [Function.update_self]
      obtain ⟨h1, h2⟩ := hi v rfl
      exact swapIn_inverse _ _ _ _ h1 h2
    · rw [Function.update_of_ne ht]

end Moves

/-! ### 3c. Part A fibres -/

theorem prefixEq_trans {X : ℕ → (p3ModelT n wc).Ω → Lab n wc} {ℓ : ℕ} {ω ω' ω'' : (p3ModelT n wc).Ω}
    (h1 : PousLuckyChain.PrefixEq X ℓ ω ω') (h2 : PousLuckyChain.PrefixEq X ℓ ω' ω'') :
    PousLuckyChain.PrefixEq X ℓ ω ω'' :=
  fun i hi => (h1 i hi).trans (h2 i hi)

/-- A move that answers the known queries as before, and answers `q` with `y'`, maps the prefix class of `ω` into
itself and gives the Part A variable at `ℓ` the value `y'`. -/
theorem move_mem_cls (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} (hA : ℓ < D * (n * Q)) {ω ω' : (p3ModelT n wc).Ω}
    (hω' : ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω) {q : (p3ModelT n wc).Qry}
    (hq : qIdx p D Q ω ℓ = some q) (φ : (p3ModelT n wc).Ω) {y' : Lab n wc}
    (hag : ∀ q' a, (q', a) ∈ knownPairs p τ G W D Q ω ℓ →
      (p3ModelT n wc).answer φ q' = (p3ModelT n wc).answer ω' q')
    (hval : (p3ModelT n wc).answer φ q = y') :
    φ ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω ∧ chainX p τ G W D Q ℓ φ = y' := by
  have hpre : PousLuckyChain.PrefixEq (chainX p τ G W D Q) ℓ ω ω' := PousLuckyChain.mem_cls.1 hω'
  have hK : knownPairs p τ G W D Q ω ℓ = knownPairs p τ G W D Q ω' ℓ :=
    knownPairs_eq_of_prefix p τ G W D Q hb hpre
  have hpre2 : PousLuckyChain.PrefixEq (chainX p τ G W D Q) ℓ ω' φ :=
    prefix_of_agree hb hA.le fun q' a h => hag q' a (hK ▸ h)
  have hpre3 := prefixEq_trans hpre hpre2
  refine ⟨PousLuckyChain.mem_cls.2 hpre3, ?_⟩
  rw [chainX_partA p τ G W D Q hA, ← qIdx_eq_of_prefix p τ G W D Q hb hpre3, hq]
  exact hval

theorem mem_knownIO_of_fwd {K : Finset ((p3ModelT n wc).Qry × Lab n wc)} {t : Tweak n} {z a : Lab n wc}
    (h : (Sum.inr (Sum.inl (t, z)), a) ∈ K) : (z, a) ∈ knownIO K t := by
  classical
  unfold knownIO
  exact Finset.mem_biUnion.2 ⟨_, h, by simp⟩

theorem mem_knownIO_of_inv {K : Finset ((p3ModelT n wc).Qry × Lab n wc)} {t : Tweak n} {w a : Lab n wc}
    (h : (Sum.inr (Sum.inr (t, w)), a) ∈ K) : (a, w) ∈ knownIO K t := by
  classical
  unfold knownIO
  exact Finset.mem_biUnion.2 ⟨_, h, by simp⟩

/-- The value of the Part A variable at `ℓ` is the answer to its query. -/
theorem chainX_of_qIdx {ℓ : ℕ} (hA : ℓ < D * (n * Q)) {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry}
    (hq : qIdx p D Q ω ℓ = some q) : chainX p τ G W D Q ℓ ω = (p3ModelT n wc).answer ω q := by
  rw [chainX_partA p τ G W D Q hA, hq]

theorem qIdx_of_mem_cls (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} {ω ω' : (p3ModelT n wc).Ω}
    (hω' : ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω) : qIdx p D Q ω' ℓ = qIdx p D Q ω ℓ :=
  (qIdx_eq_of_prefix p τ G W D Q hb (PousLuckyChain.mem_cls.1 hω')).symm

theorem knownPairs_of_mem_cls (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} {ω ω' : (p3ModelT n wc).Ω}
    (hω' : ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω) :
    knownPairs p τ G W D Q ω' ℓ = knownPairs p τ G W D Q ω ℓ :=
  (knownPairs_eq_of_prefix p τ G W D Q hb (PousLuckyChain.mem_cls.1 hω')).symm

/-- **Part A, a fresh `H` query**: all fibres are equinumerous (the move `updHΩ`). -/
theorem fibre_le_partA_H (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} (hA : ℓ < D * (n * Q)) (ω : (p3ModelT n wc).Ω)
    {h : KQ' n wc} (hq : qIdx p D Q ω ℓ = some (Sum.inl h))
    (hfresh : ¬ (knownHAt (knownPairs p τ G W D Q ω ℓ) h).Nonempty) (y y' : Lab n wc) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y).card ≤
      ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y').card := by
  classical
  refine PousLuckyChain.fibre_le_of_map _ _ y y' (updHΩ h y') (fun ω' hω' _ => ?_) (fun ω₁ h₁ ω₂ h₂ hy₁ hy₂ he => ?_)
  · refine move_mem_cls hb hA hω' hq _ (fun q' a hqa => ?_) (answer_updHΩ_self h y' ω')
    refine answer_updHΩ_ne h y' ω' fun hq' => hfresh ⟨a, ?_⟩
    subst hq'
    unfold knownHAt
    exact Finset.mem_image.2 ⟨_, Finset.mem_filter.2 ⟨hqa, rfl⟩, rfl⟩
  · have e₁ : ω₁.1 h = y := by
      rw [← hy₁, chainX_of_qIdx hA ((qIdx_of_mem_cls hb h₁).trans hq)]; rfl
    have e₂ : ω₂.1 h = y := by
      rw [← hy₂, chainX_of_qIdx hA ((qIdx_of_mem_cls hb h₂).trans hq)]; rfl
    have h1 := congrArg Prod.fst he
    have h2 := congrArg Prod.snd he
    simp only [updHΩ] at h1 h2
    refine Prod.ext (funext fun x => ?_) h2
    by_cases hx : x = h
    · rw [hx, e₁, e₂]
    · have := congrFun h1 x
      rwa [Function.update_of_ne hx, Function.update_of_ne hx] at this

theorem swapOut_cancel {α : Type} [DecidableEq α] {π₁ π₂ : Equiv.Perm α} {z y' : α} (hz : π₁ z = π₂ z)
    (h : swapOut π₁ z y' = swapOut π₂ z y') : π₁ = π₂ := by
  unfold swapOut at h
  rw [hz] at h
  exact Equiv.ext fun x => (Equiv.swap (π₂ z) y').injective (congrFun (congrArg DFunLike.coe h) x)

theorem swapIn_cancel {α : Type} [DecidableEq α] {π₁ π₂ : Equiv.Perm α} {w x' : α}
    (hw : π₁.symm w = π₂.symm w) (h : swapIn π₁ w x' = swapIn π₂ w x') : π₁ = π₂ := by
  unfold swapIn at h
  rw [hw] at h
  refine Equiv.ext fun x => ?_
  have := congrFun (congrArg DFunLike.coe h) (Equiv.swap (π₂.symm w) x' x)
  simpa [Equiv.swap_apply_self] using this

/-- **Part A, a fresh forward query** at `(t, z)`: fibres over the free outputs are equinumerous (`movFΩ`). -/
theorem fibre_le_partA_F (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} (hA : ℓ < D * (n * Q)) (ω : (p3ModelT n wc).Ω)
    {t : Tweak n} {z : Lab n wc} (hq : qIdx p D Q ω ℓ = some (Sum.inr (Sum.inl (t, z))))
    (hfresh : ¬ ((knownIO (knownPairs p τ G W D Q ω ℓ) t).filter fun io => io.1 = z).Nonempty)
    (y y' : Lab n wc) (hy' : y' ∉ (knownIO (knownPairs p τ G W D Q ω ℓ) t).image Prod.snd) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y).card ≤
      ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y').card := by
  classical
  refine PousLuckyChain.fibre_le_of_map _ _ y y' (movFΩ t z y') (fun ω' hω' _ => ?_)
    (fun ω₁ h₁ ω₂ h₂ hy₁ hy₂ he => ?_)
  · have hK := knownPairs_of_mem_cls hb hω'
    refine move_mem_cls hb hA hω' hq _ (fun q' a hqa => ?_) (answer_movFΩ_self t z y' ω')
    rw [← hK] at hqa
    refine answer_movFΩ_keep t z y' ω' q' (fun z' hz' => ?_) (fun w hw => ?_)
    · subst hz'
      have hio := mem_knownIO_of_fwd hqa
      refine ⟨fun hzz => hfresh ⟨(z', a), ?_⟩, fun hzy => hy' ?_⟩
      · rw [← hK]; exact Finset.mem_filter.2 ⟨hio, hzz⟩
      · have hap := knownIO_apply hio
        simp only at hap
        rw [← hK]
        refine Finset.mem_image.2 ⟨(z', a), hio, ?_⟩
        show a = y'
        rw [← hap]
        show ω'.2 t z' = y'
        rw [hzy, Equiv.apply_symm_apply]
    · subst hw
      have hio := mem_knownIO_of_inv hqa
      have hap := knownIO_apply hio
      simp only at hap
      refine ⟨fun hwz => hfresh ⟨(a, w), ?_⟩, fun hwy => hy' ?_⟩
      · rw [← hK]
        refine Finset.mem_filter.2 ⟨hio, ?_⟩
        show a = z
        apply (ω'.2 t).injective
        rw [hap, hwz]
      · rw [← hK]; exact Finset.mem_image.2 ⟨(a, w), hio, hwy⟩
  · have e₁ : ω₁.2 t z = y := by
      rw [← hy₁, chainX_of_qIdx hA ((qIdx_of_mem_cls hb h₁).trans hq)]; rfl
    have e₂ : ω₂.2 t z = y := by
      rw [← hy₂, chainX_of_qIdx hA ((qIdx_of_mem_cls hb h₂).trans hq)]; rfl
    have h1 := congrArg Prod.fst he
    have h2 := congrArg Prod.snd he
    simp only [movFΩ] at h1 h2
    have ht : ω₁.2 t = ω₂.2 t := by
      have := congrFun h2 t
      rw [Function.update_self, Function.update_self] at this
      exact swapOut_cancel (e₁.trans e₂.symm) this
    refine Prod.ext h1 (funext fun t' => ?_)
    by_cases htt : t' = t
    · rw [htt, ht]
    · have := congrFun h2 t'
      rwa [Function.update_of_ne htt, Function.update_of_ne htt] at this

/-- **Part A, a fresh inverse query** at `(t, w)`: fibres over the free inputs are equinumerous (`movIΩ`). -/
theorem fibre_le_partA_I (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} (hA : ℓ < D * (n * Q)) (ω : (p3ModelT n wc).Ω)
    {t : Tweak n} {w : Lab n wc} (hq : qIdx p D Q ω ℓ = some (Sum.inr (Sum.inr (t, w))))
    (hfresh : ¬ ((knownIO (knownPairs p τ G W D Q ω ℓ) t).filter fun io => io.2 = w).Nonempty)
    (y y' : Lab n wc) (hy' : y' ∉ (knownIO (knownPairs p τ G W D Q ω ℓ) t).image Prod.fst) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y).card ≤
      ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y').card := by
  classical
  refine PousLuckyChain.fibre_le_of_map _ _ y y' (movIΩ t w y') (fun ω' hω' _ => ?_)
    (fun ω₁ h₁ ω₂ h₂ hy₁ hy₂ he => ?_)
  · have hK := knownPairs_of_mem_cls hb hω'
    refine move_mem_cls hb hA hω' hq _ (fun q' a hqa => ?_) (answer_movIΩ_self t w y' ω')
    rw [← hK] at hqa
    refine answer_movIΩ_keep t w y' ω' q' (fun z' hz' => ?_) (fun v hv => ?_)
    · subst hz'
      have hio := mem_knownIO_of_fwd hqa
      have hap := knownIO_apply hio
      simp only at hap
      refine ⟨fun hzw => hfresh ⟨(z', a), ?_⟩, fun hzy => hy' ?_⟩
      · rw [← hK]
        refine Finset.mem_filter.2 ⟨hio, ?_⟩
        show a = w
        rw [← hap]
        show ω'.2 t z' = w
        rw [hzw, Equiv.apply_symm_apply]
      · rw [← hK]; exact Finset.mem_image.2 ⟨(z', a), hio, hzy⟩
    · subst hv
      have hio := mem_knownIO_of_inv hqa
      have hap := knownIO_apply hio
      simp only at hap
      refine ⟨fun hvw => hfresh ⟨(a, v), ?_⟩, fun hvy => hy' ?_⟩
      · rw [← hK]; exact Finset.mem_filter.2 ⟨hio, hvw⟩
      · rw [← hK]
        refine Finset.mem_image.2 ⟨(a, v), hio, ?_⟩
        show a = y'
        apply (ω'.2 t).injective
        rw [hap, hvy]
  · have e₁ : (ω₁.2 t).symm w = y := by
      rw [← hy₁, chainX_of_qIdx hA ((qIdx_of_mem_cls hb h₁).trans hq)]; rfl
    have e₂ : (ω₂.2 t).symm w = y := by
      rw [← hy₂, chainX_of_qIdx hA ((qIdx_of_mem_cls hb h₂).trans hq)]; rfl
    have h1 := congrArg Prod.fst he
    have h2 := congrArg Prod.snd he
    simp only [movIΩ] at h1 h2
    have ht : ω₁.2 t = ω₂.2 t := by
      have := congrFun h2 t
      rw [Function.update_self, Function.update_self] at this
      exact swapIn_cancel (e₁.trans e₂.symm) this
    refine Prod.ext h1 (funext fun t' => ?_)
    by_cases htt : t' = t
    · rw [htt, ht]
    · have := congrFun h2 t'
      rwa [Function.update_of_ne htt, Function.update_of_ne htt] at this

/-- **The fibre bound for every Part A variable.** -/
theorem fibre_partA (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} (hA : ℓ < D * (n * Q)) (ω : (p3ModelT n wc).Ω)
    (a : Lab n wc) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = a).card *
      Pool p τ G W D Q ℓ ω ≤ (PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).card := by
  classical
  unfold Pool
  refine PousLuckyChain.fibre_mul_card_le _ _ _ (fun ω' hω' => ?_) (fun y hy y' hy' => ?_) a
  · rw [Fr_eq_of_prefix hb (PousLuckyChain.mem_cls.1 hω')]
    exact chainX_mem_Fr ℓ ω'
  · unfold Fr at hy hy'
    rw [if_pos hA] at hy hy'
    cases hq : qIdx p D Q ω ℓ with
    | none =>
      rw [hq] at hy hy'
      rw [Finset.mem_singleton.1 hy, Finset.mem_singleton.1 hy']
    | some q =>
      rw [hq] at hy hy'
      rcases q with h | ⟨⟨t, z⟩⟩ | ⟨⟨t, w⟩⟩
      · simp only [freeOf] at hy hy'
        split_ifs at hy hy' with hne
        · rw [knownHAt_eq hy, knownHAt_eq hy']
        · exact fibre_le_partA_H hb hA ω hq hne y y'
      · simp only [freeOf] at hy hy'
        split_ifs at hy hy' with hne
        · obtain ⟨io, hio, rfl⟩ := Finset.mem_image.1 hy
          obtain ⟨io', hio', rfl⟩ := Finset.mem_image.1 hy'
          obtain ⟨hm, h1⟩ := Finset.mem_filter.1 hio
          obtain ⟨hm', h1'⟩ := Finset.mem_filter.1 hio'
          rw [← knownIO_apply hm, ← knownIO_apply hm', h1, h1']
        · exact fibre_le_partA_F hb hA ω hq hne y y' (Finset.mem_sdiff.1 hy').2
      · simp only [freeOf] at hy hy'
        split_ifs at hy hy' with hne
        · obtain ⟨io, hio, rfl⟩ := Finset.mem_image.1 hy
          obtain ⟨io', hio', rfl⟩ := Finset.mem_image.1 hy'
          obtain ⟨hm, h1⟩ := Finset.mem_filter.1 hio
          obtain ⟨hm', h1'⟩ := Finset.mem_filter.1 hio'
          have e := knownIO_apply hm
          have e' := knownIO_apply hm'
          rw [h1] at e
          rw [h1'] at e'
          exact le_of_eq (by rw [(ω.2 t).injective (e.trans e'.symm)])
        · exact fibre_le_partA_I hb hA ω hq hne y y' (Finset.mem_sdiff.1 hy').2

end PousKnowledge

end


/-! ════ Freshness.LuckyChainFibreB ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The concrete chain's fibre property, Part B (`credit-resolved.md` §2, stage 1)

Each Part B variable is resampled by one move, and the move keeps every earlier variable:
- `K1_v`: `H` at `hk1 v` is updated. Lower labels below `v` read `H` only at layer-0 points of nodes `≤` theirs
  (`c1T_congrH_le`).
- `Y1_v`: `P_{(τ,0,v)}` is swapped at `x¹_v`. Lower labels below `v` read only earlier layer-0 tweaks (`c1T_congr`).
- `K2_u`: `H` at `hk2 u` is updated. This is **point 3**, `oneTimePad`: no lower label, no earlier top and not
  `hk2 u` changes.
- `Y2_u`: `P_{(τ,1,u)}` is swapped at `x²_u`. Earlier tops read only earlier layer-1 tweaks (`c2T_congr`).
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousRounds PousLabelBirthday

variable {n wc : ℕ}

/-- `c1T v` reads `H` only at layer-0 points of nodes `≤ v`. -/
theorem c1T_congrH_le (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (P : Tweak n → Equiv.Perm (Lab n wc)) {Hf Hf' : KQ' n wc → Lab n wc} :
    ∀ v : Fin n, (∀ q : KQ' n wc, q.2.1 = 0 → q.2.2.1.val ≤ v.val → Hf q = Hf' q) →
      c1T tag G Hf P W v = c1T tag G Hf' P W v
  | v => fun h => by
    have hin : (fun u => if _h : u ∈ G.par v then some (c1T tag G Hf P W u) else none)
             = (fun u => if _h : u ∈ G.par v then some (c1T tag G Hf' P W u) else none) := by
      funext u
      by_cases hu : u ∈ G.par v
      · rw [dif_pos hu, dif_pos hu,
          c1T_congrH_le tag G W P u (fun q hq hqu => h q hq (hqu.trans (G.par_lt v u hu).le))]
      · rw [dif_neg hu, dif_neg hu]
    rw [c1T, c1T, hin, h _ rfl le_rfl]
  termination_by v => v.val
  decreasing_by exact G.par_lt v u hu

theorem labXor_cancel_left {n wc : ℕ} (a b : Lab n wc) : labXor a (labXor a b) = b := by
  funext v j
  simp [labXor, Labelling.bxor]

section Invariance

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

theorem hk1_congr_c1 {ω ω' : (p3ModelT n wc).Ω} (v : Fin n)
    (h : ∀ u : Fin n, u ∈ G.par v → c1 τ G W ω u = c1 τ G W ω' u) : hk1 τ G W ω v = hk1 τ G W ω' v := by
  unfold hk1
  congr 3
  funext u
  by_cases hu : u ∈ G.par v
  · rw [dif_pos hu, dif_pos hu, h u hu]
  · rw [dif_neg hu, dif_neg hu]

theorem hk2_congr_c2 {ω ω' : (p3ModelT n wc).Ω} (u : Fin n)
    (h : ∀ v : Fin n, v ∈ G.par u → c2 τ G W ω v = c2 τ G W ω' v) : hk2 τ G W ω u = hk2 τ G W ω' u := by
  unfold hk2
  congr 3
  funext v
  by_cases hv : v ∈ G.par u
  · rw [dif_pos hv, dif_pos hv, h v hv]
  · rw [dif_neg hv, dif_neg hv]

theorem hk1_node (ω : (p3ModelT n wc).Ω) (v : Fin n) : (hk1 τ G W ω v).2.1 = 0 ∧ (hk1 τ G W ω v).2.2.1 = v :=
  ⟨rfl, rfl⟩

theorem hk2_node (ω : (p3ModelT n wc).Ω) (u : Fin n) : (hk2 τ G W ω u).2.1 = 1 ∧ (hk2 τ G W ω u).2.2.1 = u :=
  ⟨rfl, rfl⟩

open Classical in
/-- **The `K1_v` move** (`H` at `hk1 v` set to `y`) keeps the lower labels below `v`, the honest key inputs up to `v`,
and the keys below `v`, and sets `K1_v = y`. -/
theorem updH_K1_inv (ω' : (p3ModelT n wc).Ω) (v : Fin n) (y : Lab n wc) :
    (∀ u : Fin n, u.val < v.val → c1 τ G W (updHΩ (hk1 τ G W ω' v) y ω') u = c1 τ G W ω' u) ∧
    (∀ u : Fin n, u.val ≤ v.val → hk1 τ G W (updHΩ (hk1 τ G W ω' v) y ω') u = hk1 τ G W ω' u) ∧
    (∀ u : Fin n, u.val < v.val →
      (updHΩ (hk1 τ G W ω' v) y ω').1 (hk1 τ G W (updHΩ (hk1 τ G W ω' v) y ω') u) = ω'.1 (hk1 τ G W ω' u)) ∧
    (updHΩ (hk1 τ G W ω' v) y ω').1 (hk1 τ G W (updHΩ (hk1 τ G W ω' v) y ω') v) = y := by
  set φ := updHΩ (hk1 τ G W ω' v) y ω' with hφ
  have hc1 : ∀ u : Fin n, u.val < v.val → c1 τ G W φ u = c1 τ G W ω' u := by
    intro u hu
    refine (c1T_congrH_le τ G W ω'.2 u fun q hq hqu => ?_).symm
    have hne : q ≠ hk1 τ G W ω' v := by
      intro hqe
      have : q.2.2.1 = v := by rw [hqe]; rfl
      rw [this] at hqu
      omega
    show ω'.1 q = Function.update ω'.1 (hk1 τ G W ω' v) y q
    rw [Function.update_of_ne hne]
  have hhk : ∀ u : Fin n, u.val ≤ v.val → hk1 τ G W φ u = hk1 τ G W ω' u := fun u hu =>
    hk1_congr_c1 τ G W u fun w hw => hc1 w ((G.par_lt u w hw).trans_le hu)
  refine ⟨hc1, hhk, fun u hu => ?_, ?_⟩
  · rw [hhk u hu.le]
    have hne : hk1 τ G W ω' u ≠ hk1 τ G W ω' v := by
      intro he
      have : u = v := congrArg (fun q : KQ' n wc => q.2.2.1) he
      rw [this] at hu
      omega
    show Function.update ω'.1 (hk1 τ G W ω' v) y (hk1 τ G W ω' u) = ω'.1 (hk1 τ G W ω' u)
    rw [Function.update_of_ne hne]
  · rw [hhk v le_rfl]
    show Function.update ω'.1 (hk1 τ G W ω' v) y (hk1 τ G W ω' v) = y
    exact Function.update_self _ _ _

open Classical in
/-- **The `Y1_v` move** (`P_{(τ,0,v)}` swapped at `x¹_v` to `y`) keeps `H`, the lower labels below `v`, and the
honest key inputs up to `v`, and sets `c¹_v = y`. -/
theorem movF_Y1_inv (ω' : (p3ModelT n wc).Ω) (v : Fin n) (y : Lab n wc) :
    (movFΩ (τ, 0, v) (in1 τ G W ω' v) y ω').1 = ω'.1 ∧
    (∀ u : Fin n, u.val < v.val → c1 τ G W (movFΩ (τ, 0, v) (in1 τ G W ω' v) y ω') u = c1 τ G W ω' u) ∧
    (∀ u : Fin n, u.val ≤ v.val →
      hk1 τ G W (movFΩ (τ, 0, v) (in1 τ G W ω' v) y ω') u = hk1 τ G W ω' u) ∧
    c1 τ G W (movFΩ (τ, 0, v) (in1 τ G W ω' v) y ω') v = y := by
  set φ := movFΩ (τ, 0, v) (in1 τ G W ω' v) y ω' with hφ
  have hH : φ.1 = ω'.1 := rfl
  have hc1 : ∀ u : Fin n, u.val < v.val → c1 τ G W φ u = c1 τ G W ω' u := by
    intro u hu
    refine (c1T_congr τ G ω'.1 W u fun w hw => ?_).symm
    have hne : ((τ, 0, w) : Tweak n) ≠ (τ, 0, v) := by
      intro he
      have : w = v := by simpa using he
      rw [this] at hw
      omega
    show ω'.2 (τ, 0, w) = Function.update ω'.2 (τ, 0, v) _ (τ, 0, w)
    rw [Function.update_of_ne hne]
  have hhk : ∀ u : Fin n, u.val ≤ v.val → hk1 τ G W φ u = hk1 τ G W ω' u := fun u hu =>
    hk1_congr_c1 τ G W u fun w hw => hc1 w ((G.par_lt u w hw).trans_le hu)
  refine ⟨hH, hc1, hhk, ?_⟩
  rw [c1_eq]
  have hin : in1 τ G W φ v = in1 τ G W ω' v := by
    unfold in1; rw [hhk v le_rfl, hH]
  rw [hin]
  show Function.update ω'.2 (τ, 0, v) (swapOut (ω'.2 (τ, 0, v)) (in1 τ G W ω' v) y) (τ, 0, v)
      (in1 τ G W ω' v) = y
  rw [Function.update_self]
  exact swapOut_apply_x _ _ _

open Classical in
/-- The `K2_u` move is `oneTimePad`'s shift, with `δ = k²_u ⊕ y`. -/
theorem updH_K2_eq_padShift (ω' : (p3ModelT n wc).Ω) (u : Fin n) (y : Lab n wc) :
    updHΩ (hk2 τ G W ω' u) y ω' = padShift τ G W ω' u (labXor (ω'.1 (hk2 τ G W ω' u)) y) := by
  unfold updHΩ padShift
  rw [labXor_cancel_left]

open Classical in
/-- **The `K2_u` move** (point 3 wired: via `oneTimePad`) keeps every lower label and lower key, the tops below `u`,
the honest key inputs up to `u`, and the top keys below `u`, and sets `K2_u = y`. -/
theorem updH_K2_inv (ω' : (p3ModelT n wc).Ω) (u : Fin n) (y : Lab n wc) :
    c1 τ G W (updHΩ (hk2 τ G W ω' u) y ω') = c1 τ G W ω' ∧
    (∀ w : Fin n, (updHΩ (hk2 τ G W ω' u) y ω').1 (hk1 τ G W (updHΩ (hk2 τ G W ω' u) y ω') w) =
      ω'.1 (hk1 τ G W ω' w)) ∧
    (∀ v : Fin n, v.val < u.val → c2 τ G W (updHΩ (hk2 τ G W ω' u) y ω') v = c2 τ G W ω' v) ∧
    (∀ v : Fin n, v.val ≤ u.val → hk2 τ G W (updHΩ (hk2 τ G W ω' u) y ω') v = hk2 τ G W ω' v) ∧
    (∀ v : Fin n, v.val < u.val →
      (updHΩ (hk2 τ G W ω' u) y ω').1 (hk2 τ G W (updHΩ (hk2 τ G W ω' u) y ω') v) = ω'.1 (hk2 τ G W ω' v)) ∧
    (updHΩ (hk2 τ G W ω' u) y ω').1 (hk2 τ G W (updHΩ (hk2 τ G W ω' u) y ω') u) = y := by
  rw [updH_K2_eq_padShift]
  set φ := padShift τ G W ω' u (labXor (ω'.1 (hk2 τ G W ω' u)) y) with hφ
  obtain ⟨hc1, hc2, hhk, -, hH⟩ := oneTimePad τ G W ω' u (labXor (ω'.1 (hk2 τ G W ω' u)) y)
  have hhk1 : ∀ w, hk1 τ G W φ w = hk1 τ G W ω' w := fun w =>
    hk1_congr_c1 τ G W w fun x _ => by rw [hc1]
  have hhk2 : ∀ v : Fin n, v.val ≤ u.val → hk2 τ G W φ v = hk2 τ G W ω' v := by
    intro v hv
    rcases lt_or_eq_of_le hv with hv | hv
    · exact hk2_congr_c2 τ G W v fun x hx => hc2 x ((G.par_lt v x hx).trans hv)
    · have : v = u := Fin.ext hv
      subst this; exact hhk
  refine ⟨hc1, fun w => ?_, hc2, hhk2, fun v hv => ?_, ?_⟩
  · rw [hhk1 w]
    refine hH _ fun he => ?_
    have := congrArg (fun q : KQ' n wc => q.2.1) he
    exact absurd this (by simp [hk1, hk2])
  · rw [hhk2 v hv.le]
    refine hH _ fun he => ?_
    have : v = u := congrArg (fun q : KQ' n wc => q.2.2.1) he
    rw [this] at hv
    omega
  · rw [hhk]
    simp only [hφ, padShift, Function.update_self, labXor_cancel_left]

open Classical in
/-- **The `Y2_u` move** (`P_{(τ,1,u)}` swapped at `x²_u` to `y`) keeps `H`, every lower label, the tops below `u`,
and the honest key inputs up to `u`, and sets `c²_u = y`. -/
theorem movF_Y2_inv (ω' : (p3ModelT n wc).Ω) (u : Fin n) (y : Lab n wc) :
    (movFΩ (τ, 1, u) (in2 τ G W ω' u) y ω').1 = ω'.1 ∧
    c1 τ G W (movFΩ (τ, 1, u) (in2 τ G W ω' u) y ω') = c1 τ G W ω' ∧
    (∀ v : Fin n, v.val < u.val → c2 τ G W (movFΩ (τ, 1, u) (in2 τ G W ω' u) y ω') v = c2 τ G W ω' v) ∧
    (∀ v : Fin n, v.val ≤ u.val →
      hk2 τ G W (movFΩ (τ, 1, u) (in2 τ G W ω' u) y ω') v = hk2 τ G W ω' v) ∧
    c2 τ G W (movFΩ (τ, 1, u) (in2 τ G W ω' u) y ω') u = y := by
  set φ := movFΩ (τ, 1, u) (in2 τ G W ω' u) y ω' with hφ
  have hH : φ.1 = ω'.1 := rfl
  have hP0 : ∀ w : Fin n, φ.2 (τ, 0, w) = ω'.2 (τ, 0, w) := fun w => by
    have hne : ((τ, 0, w) : Tweak n) ≠ (τ, 1, u) := by simp
    show Function.update ω'.2 (τ, 1, u) _ (τ, 0, w) = ω'.2 (τ, 0, w)
    rw [Function.update_of_ne hne]
  have hc1 : c1 τ G W φ = c1 τ G W ω' := by
    funext w
    exact c1T_congr τ G ω'.1 W w fun x _ => hP0 x
  have hc2 : ∀ v : Fin n, v.val < u.val → c2 τ G W φ v = c2 τ G W ω' v := by
    intro v hv
    refine c2T_congr τ G ω'.1 W hP0 v fun w hw => ?_
    have hne : ((τ, 1, w) : Tweak n) ≠ (τ, 1, u) := by
      intro he
      have : w = u := by simpa using he
      rw [this] at hw
      omega
    show Function.update ω'.2 (τ, 1, u) _ (τ, 1, w) = ω'.2 (τ, 1, w)
    rw [Function.update_of_ne hne]
  have hhk2 : ∀ v : Fin n, v.val ≤ u.val → hk2 τ G W φ v = hk2 τ G W ω' v := fun v hv =>
    hk2_congr_c2 τ G W v fun x hx => hc2 x ((G.par_lt v x hx).trans_le hv)
  refine ⟨hH, hc1, hc2, hhk2, ?_⟩
  rw [c2_eq τ G W φ u]
  have hin : in2 τ G W φ u = in2 τ G W ω' u := by
    unfold in2; rw [hc1, hhk2 u le_rfl, hH]
  rw [hin]
  show Function.update ω'.2 (τ, 1, u) (swapOut (ω'.2 (τ, 1, u)) (in2 τ G W ω' u) y) (τ, 1, u)
      (in2 τ G W ω' u) = y
  rw [Function.update_self]
  exact swapOut_apply_x _ _ _

end Invariance

/-! ### Agreement: a move at a fresh point answers every known query as before -/

section Agree

variable {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)}
  {τ : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc} {D Q : ℕ}

theorem agree_updH {ω' : (p3ModelT n wc).Ω} {L : ℕ} {h : KQ' n wc}
    (hfresh : ¬ (knownHAt (knownPairs p τ G W D Q ω' L) h).Nonempty) (y : Lab n wc) :
    ∀ q a, (q, a) ∈ knownPairs p τ G W D Q ω' L →
      (p3ModelT n wc).answer (updHΩ h y ω') q = (p3ModelT n wc).answer ω' q := by
  classical
  intro q a hqa
  refine answer_updHΩ_ne h y ω' fun hq' => hfresh ⟨a, ?_⟩
  subst hq'
  unfold knownHAt
  exact Finset.mem_image.2 ⟨_, Finset.mem_filter.2 ⟨hqa, rfl⟩, rfl⟩

theorem agree_movF {ω' : (p3ModelT n wc).Ω} {L : ℕ} {t : Tweak n} {z : Lab n wc}
    (hfresh : ¬ ((knownIO (knownPairs p τ G W D Q ω' L) t).filter fun io => io.1 = z).Nonempty)
    {y : Lab n wc} (hy : y ∉ (knownIO (knownPairs p τ G W D Q ω' L) t).image Prod.snd) :
    ∀ q a, (q, a) ∈ knownPairs p τ G W D Q ω' L →
      (p3ModelT n wc).answer (movFΩ t z y ω') q = (p3ModelT n wc).answer ω' q := by
  classical
  intro q a hqa
  refine answer_movFΩ_keep t z y ω' q (fun z' hz' => ?_) (fun w hw => ?_)
  · subst hz'
    have hio := mem_knownIO_of_fwd hqa
    refine ⟨fun hzz => hfresh ⟨(z', a), Finset.mem_filter.2 ⟨hio, hzz⟩⟩, fun hzy => hy ?_⟩
    have hap := knownIO_apply hio
    simp only at hap
    refine Finset.mem_image.2 ⟨(z', a), hio, ?_⟩
    show a = y
    rw [← hap, hzy, Equiv.apply_symm_apply]
  · subst hw
    have hio := mem_knownIO_of_inv hqa
    have hap := knownIO_apply hio
    simp only at hap
    refine ⟨fun hwz => hfresh ⟨(a, w), Finset.mem_filter.2 ⟨hio, ?_⟩⟩,
      fun hwy => hy (Finset.mem_image.2 ⟨(a, w), hio, hwy⟩)⟩
    show a = z
    apply (ω'.2 t).injective
    rw [hap, hwz]

theorem chainX_partB' {ℓ : ℕ} (hB : ¬ ℓ < D * (n * Q)) (ω : (p3ModelT n wc).Ω) :
    chainX p τ G W D Q ℓ ω = partB τ G W ω (ℓ - D * (n * Q)) := by
  unfold chainX; rw [dif_neg hB]

/-- A prefix into Part B: the Part A prefix and the earlier Part B variables. -/
theorem prefix_of_partB {b : ℕ} {ω' φ : (p3ModelT n wc).Ω}
    (hA : PousLuckyChain.PrefixEq (chainX p τ G W D Q) (D * (n * Q)) ω' φ)
    (hB : ∀ b' < b, partB τ G W φ b' = partB τ G W ω' b') :
    PousLuckyChain.PrefixEq (chainX p τ G W D Q) (D * (n * Q) + b) ω' φ := by
  intro i hi
  by_cases hiA : i < D * (n * Q)
  · exact hA i hiA
  · rw [chainX_partB' hiA, chainX_partB' hiA]
    exact (hB (i - D * (n * Q)) (by omega)).symm

end Agree

/-! ### Each move keeps the earlier Part B variables -/

section PartBKeep

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

open Classical in
theorem partB_K1_keep (ω' : (p3ModelT n wc).Ω) (v : Fin n) (y : Lab n wc) :
    ∀ b' < 2 * (v : ℕ), partB τ G W (updHΩ (hk1 τ G W ω' v) y ω') b' = partB τ G W ω' b' := by
  intro b' hb'
  obtain ⟨-, -, hK, -⟩ := updH_K1_inv τ G W ω' v y
  obtain ⟨hc, -, -, -⟩ := updH_K1_inv τ G W ω' v y
  have h2n : b' < 2 * n := by have := v.isLt; omega
  unfold partB
  rw [dif_pos h2n, dif_pos h2n]
  split_ifs
  · exact hK _ (by simp; omega)
  · exact hc _ (by simp; omega)

open Classical in
theorem partB_Y1_keep (ω' : (p3ModelT n wc).Ω) (v : Fin n) (y : Lab n wc) :
    ∀ b' < 2 * (v : ℕ) + 1,
      partB τ G W (movFΩ (τ, 0, v) (in1 τ G W ω' v) y ω') b' = partB τ G W ω' b' := by
  intro b' hb'
  obtain ⟨hH, hc, hhk, -⟩ := movF_Y1_inv τ G W ω' v y
  have h2n : b' < 2 * n := by have := v.isLt; omega
  unfold partB
  rw [dif_pos h2n, dif_pos h2n]
  split_ifs with hpar
  · rw [hH, hhk _ (by simp; omega)]
  · exact hc _ (by simp; omega)

open Classical in
theorem partB_K2_keep (ω' : (p3ModelT n wc).Ω) (u : Fin n) (y : Lab n wc) :
    ∀ b' < 2 * n + 2 * (u : ℕ), partB τ G W (updHΩ (hk2 τ G W ω' u) y ω') b' = partB τ G W ω' b' := by
  intro b' hb'
  obtain ⟨hc1, hK1, hc2, -, hK2, -⟩ := updH_K2_inv τ G W ω' u y
  unfold partB
  by_cases h2n : b' < 2 * n
  · rw [dif_pos h2n, dif_pos h2n]
    split_ifs
    · exact hK1 _
    · rw [hc1]
  · have h4n : b' < 4 * n := by have := u.isLt; omega
    rw [dif_neg h2n, dif_neg h2n, dif_pos h4n, dif_pos h4n]
    split_ifs
    · exact hK2 _ (by simp; omega)
    · exact hc2 _ (by simp; omega)

open Classical in
theorem partB_Y2_keep (ω' : (p3ModelT n wc).Ω) (u : Fin n) (y : Lab n wc) :
    ∀ b' < 2 * n + 2 * (u : ℕ) + 1,
      partB τ G W (movFΩ (τ, 1, u) (in2 τ G W ω' u) y ω') b' = partB τ G W ω' b' := by
  intro b' hb'
  obtain ⟨hH, hc1, hc2, hhk2, -⟩ := movF_Y2_inv τ G W ω' u y
  have hhk1 : ∀ w, hk1 τ G W (movFΩ (τ, 1, u) (in2 τ G W ω' u) y ω') w = hk1 τ G W ω' w := fun w =>
    hk1_congr_c1 τ G W w fun x _ => by rw [hc1]
  unfold partB
  by_cases h2n : b' < 2 * n
  · rw [dif_pos h2n, dif_pos h2n]
    split_ifs
    · rw [hH, hhk1]
    · rw [hc1]
  · have h4n : b' < 4 * n := by have := u.isLt; omega
    rw [dif_neg h2n, dif_neg h2n, dif_pos h4n, dif_pos h4n]
    split_ifs with hpar
    · rw [hH, hhk2 _ (by simp; omega)]
    · exact hc2 _ (by simp; omega)

end PartBKeep

/-! ### Generic fibre bounds for a move that keeps the class -/

section Generic

variable {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)}
  {τ : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc} {D Q : ℕ}

open Classical in
/-- If the variable at `ℓ` is `H(h)` on the class of `ω`, and setting `H(h)` keeps the class, fibres are equal. -/
theorem fibre_le_updH {ℓ : ℕ} {ω : (p3ModelT n wc).Ω} {h : KQ' n wc}
    (hval : ∀ ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω, chainX p τ G W D Q ℓ ω' = ω'.1 h)
    (hkeep : ∀ ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω, ∀ y' : Lab n wc,
      updHΩ h y' ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω) (y y' : Lab n wc) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y).card ≤
      ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y').card := by
  refine PousLuckyChain.fibre_le_of_map _ _ y y' (updHΩ h y') (fun ω' hω' _ => ?_)
    (fun ω₁ h₁ ω₂ h₂ hy₁ hy₂ he => ?_)
  · have hm := hkeep ω' hω' y'
    refine ⟨hm, ?_⟩
    rw [hval _ hm]
    show Function.update ω'.1 h y' h = y'
    exact Function.update_self _ _ _
  · have e₁ : ω₁.1 h = y := by rw [← hval _ h₁, hy₁]
    have e₂ : ω₂.1 h = y := by rw [← hval _ h₂, hy₂]
    have h1 := congrArg Prod.fst he
    have h2 := congrArg Prod.snd he
    simp only [updHΩ] at h1 h2
    refine Prod.ext (funext fun x => ?_) h2
    by_cases hx : x = h
    · rw [hx, e₁, e₂]
    · have := congrFun h1 x
      rwa [Function.update_of_ne hx, Function.update_of_ne hx] at this

open Classical in
/-- If the variable at `ℓ` is `P_t(z)` on the class of `ω`, and swapping `P_t` at `z` to any `y'` in `Y` keeps the
class, fibres over `Y` are equal. -/
theorem fibre_le_movF {ℓ : ℕ} {ω : (p3ModelT n wc).Ω} {t : Tweak n} {z : Lab n wc}
    (hval : ∀ ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω, chainX p τ G W D Q ℓ ω' = ω'.2 t z)
    {Y : Finset (Lab n wc)}
    (hkeep : ∀ ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω, ∀ y' ∈ Y,
      movFΩ t z y' ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω) (y : Lab n wc) {y' : Lab n wc}
    (hy' : y' ∈ Y) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y).card ≤
      ((PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω).filter fun ω' => chainX p τ G W D Q ℓ ω' = y').card := by
  refine PousLuckyChain.fibre_le_of_map _ _ y y' (movFΩ t z y') (fun ω' hω' _ => ?_)
    (fun ω₁ h₁ ω₂ h₂ hy₁ hy₂ he => ?_)
  · have hm := hkeep ω' hω' y' hy'
    refine ⟨hm, ?_⟩
    rw [hval _ hm]
    show Function.update ω'.2 t (swapOut (ω'.2 t) z y') t z = y'
    rw [Function.update_self]
    exact swapOut_apply_x _ _ _
  · have e₁ : ω₁.2 t z = y := by rw [← hval _ h₁, hy₁]
    have e₂ : ω₂.2 t z = y := by rw [← hval _ h₂, hy₂]
    have h1 := congrArg Prod.fst he
    have h2 := congrArg Prod.snd he
    simp only [movFΩ] at h1 h2
    have ht : ω₁.2 t = ω₂.2 t := by
      have := congrFun h2 t
      rw [Function.update_self, Function.update_self] at this
      exact swapOut_cancel (e₁.trans e₂.symm) this
    refine Prod.ext h1 (funext fun t' => ?_)
    by_cases htt : t' = t
    · rw [htt, ht]
    · have := congrFun h2 t'
      rwa [Function.update_of_ne htt, Function.update_of_ne htt] at this

end Generic

/-! ### Part B fibres -/

section FibreB

variable {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)}
  {τ : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc} {D Q : ℕ}

theorem Fr_K1 (ω : (p3ModelT n wc).Ω) (v : Fin n) :
    Fr p τ G W D Q (D * (n * Q) + 2 * v) ω =
      freeOf (knownPairs p τ G W D Q ω (D * (n * Q))) (Sum.inl (hk1 τ G W ω v)) := by
  unfold Fr
  rw [if_neg (by omega), dif_pos (by have := v.isLt; omega), if_pos (by omega)]
  congr 3
  ext; simp <;> omega

theorem Fr_Y1 (ω : (p3ModelT n wc).Ω) (v : Fin n) :
    Fr p τ G W D Q (D * (n * Q) + (2 * v + 1)) ω =
      freeOf (knownPairs p τ G W D Q ω (D * (n * Q))) (qP1 τ G W ω v) := by
  unfold Fr
  rw [if_neg (by omega), dif_pos (by have := v.isLt; omega), if_neg (by omega)]
  congr 2
  ext; simp <;> omega

theorem Fr_K2 (ω : (p3ModelT n wc).Ω) (u : Fin n) :
    Fr p τ G W D Q (D * (n * Q) + (2 * n + 2 * u)) ω =
      freeOf (knownPairs p τ G W D Q ω (D * (n * Q))) (Sum.inl (hk2 τ G W ω u)) := by
  unfold Fr
  rw [if_neg (by omega), dif_neg (by omega), dif_pos (by have := u.isLt; omega), if_pos (by omega)]
  congr 3
  ext; simp <;> omega

theorem Fr_Y2 (ω : (p3ModelT n wc).Ω) (u : Fin n) :
    Fr p τ G W D Q (D * (n * Q) + (2 * n + 2 * u + 1)) ω =
      freeOf (knownPairs p τ G W D Q ω (D * (n * Q))) (qP2 τ G W ω u) := by
  unfold Fr
  rw [if_neg (by omega), dif_neg (by omega), dif_pos (by have := u.isLt; omega), if_neg (by omega)]
  congr 2
  ext; simp <;> omega

theorem knownPairsA_of_mem_cls (hb : ∀ c, (p c).Bounded D Q) {ℓ : ℕ} (hℓ : D * (n * Q) ≤ ℓ)
    {ω ω' : (p3ModelT n wc).Ω} (hω' : ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω) :
    knownPairs p τ G W D Q ω' (D * (n * Q)) = knownPairs p τ G W D Q ω (D * (n * Q)) :=
  (knownPairs_eq_of_prefix p τ G W D Q hb (prefixEq_mono hℓ (PousLuckyChain.mem_cls.1 hω'))).symm

/-- The fibre bound at `K1_v`. -/
theorem fibre_K1 (hb : ∀ c, (p c).Bounded D Q) (ω : (p3ModelT n wc).Ω) (v : Fin n) (a : Lab n wc) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) (D * (n * Q) + 2 * v) ω).filter
        fun ω' => chainX p τ G W D Q (D * (n * Q) + 2 * v) ω' = a).card *
      Pool p τ G W D Q (D * (n * Q) + 2 * v) ω ≤
        (PousLuckyChain.cls (chainX p τ G W D Q) (D * (n * Q) + 2 * v) ω).card := by
  classical
  set ℓ := D * (n * Q) + 2 * (v : ℕ) with hℓ
  unfold Pool
  refine PousLuckyChain.fibre_mul_card_le _ _ _ (fun ω' hω' => ?_) (fun y hy y' hy' => ?_) a
  · rw [Fr_eq_of_prefix hb (PousLuckyChain.mem_cls.1 hω')]; exact chainX_mem_Fr ℓ ω'
  rw [Fr_K1] at hy hy'
  simp only [freeOf] at hy hy'
  split_ifs at hy hy' with hne
  · rw [knownHAt_eq hy, knownHAt_eq hy']
  have hloc : ∀ ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω, hk1 τ G W ω' v = hk1 τ G W ω v :=
    fun ω' hω' => (hk1_eq_of_prefix v (PousLuckyChain.mem_cls.1 hω')).symm
  refine fibre_le_updH (h := hk1 τ G W ω v) (fun ω' hω' => ?_) (fun ω' hω' y'' => ?_) y y'
  · rw [hℓ, chainX_K1, hloc ω' hω']
  · have hpre := PousLuckyChain.mem_cls.1 hω'
    refine PousLuckyChain.mem_cls.2 (prefixEq_trans hpre ?_)
    rw [← hloc ω' hω']
    refine prefix_of_partB (b := 2 * v) ?_ (partB_K1_keep τ G W ω' v y'')
    refine prefix_of_agree hb le_rfl (agree_updH ?_ y'')
    rw [knownPairsA_of_mem_cls hb (by omega) hω', hloc ω' hω']
    exact hne

/-- The fibre bound at `Y1_v`. -/
theorem fibre_Y1 (hb : ∀ c, (p c).Bounded D Q) (ω : (p3ModelT n wc).Ω) (v : Fin n) (a : Lab n wc) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) (D * (n * Q) + (2 * v + 1)) ω).filter
        fun ω' => chainX p τ G W D Q (D * (n * Q) + (2 * v + 1)) ω' = a).card *
      Pool p τ G W D Q (D * (n * Q) + (2 * v + 1)) ω ≤
        (PousLuckyChain.cls (chainX p τ G W D Q) (D * (n * Q) + (2 * v + 1)) ω).card := by
  classical
  set ℓ := D * (n * Q) + (2 * (v : ℕ) + 1) with hℓ
  unfold Pool
  refine PousLuckyChain.fibre_mul_card_le _ _ _ (fun ω' hω' => ?_) (fun y hy y' hy' => ?_) a
  · rw [Fr_eq_of_prefix hb (PousLuckyChain.mem_cls.1 hω')]; exact chainX_mem_Fr ℓ ω'
  rw [Fr_Y1] at hy hy'
  unfold qP1 at hy hy'
  simp only [freeOf] at hy hy'
  split_ifs at hy hy' with hne
  · obtain ⟨io, hio, rfl⟩ := Finset.mem_image.1 hy
    obtain ⟨io', hio', rfl⟩ := Finset.mem_image.1 hy'
    obtain ⟨hm, h1⟩ := Finset.mem_filter.1 hio
    obtain ⟨hm', h1'⟩ := Finset.mem_filter.1 hio'
    rw [← knownIO_apply hm, ← knownIO_apply hm', h1, h1']
  have hloc : ∀ ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω, in1 τ G W ω' v = in1 τ G W ω v :=
    fun ω' hω' => (in1_eq_of_prefix v (PousLuckyChain.mem_cls.1 hω')).symm
  refine fibre_le_movF (t := (τ, 0, v)) (z := in1 τ G W ω v)
    (Y := Finset.univ \ (knownIO (knownPairs p τ G W D Q ω (D * (n * Q))) (τ, 0, v)).image Prod.snd)
    (fun ω' hω' => ?_) (fun ω' hω' y'' hy'' => ?_) y hy'
  · rw [hℓ, chainX_Y1, c1_eq, hloc ω' hω']
  · have hpre := PousLuckyChain.mem_cls.1 hω'
    refine PousLuckyChain.mem_cls.2 (prefixEq_trans hpre ?_)
    rw [← hloc ω' hω']
    refine prefix_of_partB (b := 2 * v + 1) ?_ (partB_Y1_keep τ G W ω' v y'')
    have hK := knownPairsA_of_mem_cls hb (by omega) hω'
    refine prefix_of_agree hb le_rfl (agree_movF ?_ ?_)
    · rw [hK, hloc ω' hω']; exact hne
    · rw [hK]; exact (Finset.mem_sdiff.1 hy'').2

/-- The fibre bound at `K2_u`. -/
theorem fibre_K2 (hb : ∀ c, (p c).Bounded D Q) (ω : (p3ModelT n wc).Ω) (u : Fin n) (a : Lab n wc) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) (D * (n * Q) + (2 * n + 2 * u)) ω).filter
        fun ω' => chainX p τ G W D Q (D * (n * Q) + (2 * n + 2 * u)) ω' = a).card *
      Pool p τ G W D Q (D * (n * Q) + (2 * n + 2 * u)) ω ≤
        (PousLuckyChain.cls (chainX p τ G W D Q) (D * (n * Q) + (2 * n + 2 * u)) ω).card := by
  classical
  set ℓ := D * (n * Q) + (2 * n + 2 * (u : ℕ)) with hℓ
  unfold Pool
  refine PousLuckyChain.fibre_mul_card_le _ _ _ (fun ω' hω' => ?_) (fun y hy y' hy' => ?_) a
  · rw [Fr_eq_of_prefix hb (PousLuckyChain.mem_cls.1 hω')]; exact chainX_mem_Fr ℓ ω'
  rw [Fr_K2] at hy hy'
  simp only [freeOf] at hy hy'
  split_ifs at hy hy' with hne
  · rw [knownHAt_eq hy, knownHAt_eq hy']
  have hloc : ∀ ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω, hk2 τ G W ω' u = hk2 τ G W ω u :=
    fun ω' hω' => (hk2_eq_of_prefix u (PousLuckyChain.mem_cls.1 hω')).symm
  refine fibre_le_updH (h := hk2 τ G W ω u) (fun ω' hω' => ?_) (fun ω' hω' y'' => ?_) y y'
  · rw [hℓ, chainX_K2, hloc ω' hω']
  · have hpre := PousLuckyChain.mem_cls.1 hω'
    refine PousLuckyChain.mem_cls.2 (prefixEq_trans hpre ?_)
    rw [← hloc ω' hω']
    refine prefix_of_partB (b := 2 * n + 2 * u) ?_ (partB_K2_keep τ G W ω' u y'')
    refine prefix_of_agree hb le_rfl (agree_updH ?_ y'')
    rw [knownPairsA_of_mem_cls hb (by omega) hω', hloc ω' hω']
    exact hne

/-- The fibre bound at `Y2_u`. -/
theorem fibre_Y2 (hb : ∀ c, (p c).Bounded D Q) (ω : (p3ModelT n wc).Ω) (u : Fin n) (a : Lab n wc) :
    ((PousLuckyChain.cls (chainX p τ G W D Q) (D * (n * Q) + (2 * n + 2 * u + 1)) ω).filter
        fun ω' => chainX p τ G W D Q (D * (n * Q) + (2 * n + 2 * u + 1)) ω' = a).card *
      Pool p τ G W D Q (D * (n * Q) + (2 * n + 2 * u + 1)) ω ≤
        (PousLuckyChain.cls (chainX p τ G W D Q) (D * (n * Q) + (2 * n + 2 * u + 1)) ω).card := by
  classical
  set ℓ := D * (n * Q) + (2 * n + 2 * (u : ℕ) + 1) with hℓ
  unfold Pool
  refine PousLuckyChain.fibre_mul_card_le _ _ _ (fun ω' hω' => ?_) (fun y hy y' hy' => ?_) a
  · rw [Fr_eq_of_prefix hb (PousLuckyChain.mem_cls.1 hω')]; exact chainX_mem_Fr ℓ ω'
  rw [Fr_Y2] at hy hy'
  unfold qP2 at hy hy'
  simp only [freeOf] at hy hy'
  split_ifs at hy hy' with hne
  · obtain ⟨io, hio, rfl⟩ := Finset.mem_image.1 hy
    obtain ⟨io', hio', rfl⟩ := Finset.mem_image.1 hy'
    obtain ⟨hm, h1⟩ := Finset.mem_filter.1 hio
    obtain ⟨hm', h1'⟩ := Finset.mem_filter.1 hio'
    rw [← knownIO_apply hm, ← knownIO_apply hm', h1, h1']
  have hloc : ∀ ω' ∈ PousLuckyChain.cls (chainX p τ G W D Q) ℓ ω, in2 τ G W ω' u = in2 τ G W ω u :=
    fun ω' hω' => (in2_eq_of_prefix u (PousLuckyChain.mem_cls.1 hω')).symm
  refine fibre_le_movF (t := (τ, 1, u)) (z := in2 τ G W ω u)
    (Y := Finset.univ \ (knownIO (knownPairs p τ G W D Q ω (D * (n * Q))) (τ, 1, u)).image Prod.snd)
    (fun ω' hω' => ?_) (fun ω' hω' y'' hy'' => ?_) y hy'
  · rw [hℓ, chainX_Y2, c2_eq τ G W ω' u, hloc ω' hω']
  · have hpre := PousLuckyChain.mem_cls.1 hω'
    refine PousLuckyChain.mem_cls.2 (prefixEq_trans hpre ?_)
    rw [← hloc ω' hω']
    refine prefix_of_partB (b := 2 * n + 2 * u + 1) ?_ (partB_Y2_keep τ G W ω' u y'')
    have hK := knownPairsA_of_mem_cls hb (by omega) hω'
    refine prefix_of_agree hb le_rfl (agree_movF ?_ ?_)
    · rw [hK, hloc ω' hω']; exact hne
    · rw [hK]; exact (Finset.mem_sdiff.1 hy'').2

/-- **`Fibre` for the concrete chain** (stage 1 done): every variable, Part A and Part B, takes each value on at most
a `1/Pool` share of its prefix class. -/
theorem fibre_chain (hb : ∀ c, (p c).Bounded D Q) :
    PousLuckyChain.Fibre (chainX p τ G W D Q) (Pool p τ G W D Q) := by
  classical
  intro ℓ ω a
  by_cases hA : ℓ < D * (n * Q)
  · exact fibre_partA hb hA ω a
  by_cases hB : ℓ - D * (n * Q) < 2 * n
  · by_cases hpar : (ℓ - D * (n * Q)) % 2 = 0
    · obtain ⟨v, rfl⟩ : ∃ v : Fin n, ℓ = D * (n * Q) + 2 * (v : ℕ) :=
        ⟨⟨(ℓ - D * (n * Q)) / 2, by omega⟩, by simp only; omega⟩
      exact fibre_K1 hb ω v a
    · obtain ⟨v, rfl⟩ : ∃ v : Fin n, ℓ = D * (n * Q) + (2 * (v : ℕ) + 1) :=
        ⟨⟨(ℓ - D * (n * Q)) / 2, by omega⟩, by simp only; omega⟩
      exact fibre_Y1 hb ω v a
  by_cases hC : ℓ - D * (n * Q) < 4 * n
  · by_cases hpar : (ℓ - D * (n * Q)) % 2 = 0
    · obtain ⟨u, rfl⟩ : ∃ u : Fin n, ℓ = D * (n * Q) + (2 * n + 2 * (u : ℕ)) :=
        ⟨⟨(ℓ - D * (n * Q) - 2 * n) / 2, by omega⟩, by simp only; omega⟩
      exact fibre_K2 hb ω u a
    · obtain ⟨u, rfl⟩ : ∃ u : Fin n, ℓ = D * (n * Q) + (2 * n + 2 * (u : ℕ) + 1) :=
        ⟨⟨(ℓ - D * (n * Q) - 2 * n) / 2, by omega⟩, by simp only; omega⟩
      exact fibre_Y2 hb ω u a
  · have hFr : Fr p τ G W D Q ℓ ω = {fun _ _ => false} := by
      unfold Fr; rw [if_neg hA, dif_neg hB, dif_neg hC]
    unfold Pool
    rw [hFr, Finset.card_singleton, mul_one]
    exact Finset.card_filter_le _ _

end FibreB

end PousKnowledge

end


/-! ════ Freshness.LuckyStage2 ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Stage 2: a source realized before its credit round is in the game (`credit-resolved.md` §9)

The backbone is `know_le_Cg`: what the answers have told the programs by round `r` is inside the game from the credits
and hits through round `r` (`Cg r`), at round `r`. This is `knowledgeSimHits` round by round, rather than only for the
final holding.

The per-source lemmas follow. Each says that if a source's revealing query was asked by round `r`, round `r + 1`
credits nothing on that source:
- `keyLow_of_asked_qH1`;
- `lowerWhole_of_asked_qP1`.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

section Stage2

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

/-- **Knowledge by round `r` is in the game from `Cg r` at round `r`.** -/
theorem know_le_Cg (r : ℕ) : Le (know ps ω τ G W r) (timedReachK G (Cg ps ω τ G W r) r) := by
  refine ⟨fun w hw => ?_, fun p hp => ?_, fun u hu => ?_⟩
  · obtain ⟨r1, hr1, hrt, hfirst⟩ := exists_firstAt ((mem_know_lowerWhole ps ω τ G W).1 hw)
    obtain ⟨r0, rfl⟩ : ∃ r0, r1 = r0 + 1 := ⟨r1 - 1, by omega⟩
    set C := Cg ps ω τ G W r0 with hC
    have hfin : ∀ {c : KState n}, KLe c (Cg ps ω τ G W (r0 + 1)) → ∀ {s}, s ≤ r0 + 1 →
        w ∈ (timedReachK G c s).lowerWhole → w ∈ (timedReachK G (Cg ps ω τ G W r) r).lowerWhole :=
      fun hc s hs hm => (tk_le (hc.trans (Cg_mono ps ω τ G W hrt)) (by omega)).1 hm
    by_cases hin : w ∈ (timedReachK G C r0).lowerWhole
    · exact hfin (Cg_mono ps ω τ G W (Nat.le_succ r0)) (Nat.le_succ r0) hin
    by_cases hk : keyLow G C (r0 + 1) w
    · exact hfin (Cg_mono ps ω τ G W (Nat.le_succ r0)) le_rfl (lower_move (by omega) hk)
    · have hkey : w ∈ (Cg ps ω τ G W (r0 + 1)).lowerKey := (round3_le ps ω τ G W r0).2.1 (by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨hfirst, by simpa using hin, hk⟩)
      exact hfin (KLe.refl _) le_rfl (lowerKey_mem (by omega) hkey)
  · obtain ⟨hI, hH⟩ := (mem_know_lowerCol ps ω τ G W).1 hp
    obtain ⟨r1, h11, h1t, hfirst₁⟩ := exists_firstAt hI
    obtain ⟨r2, h21, h2t, hfirst₂⟩ := exists_firstAt hH
    obtain ⟨a, rfl⟩ : ∃ a, r1 = a + 1 := ⟨r1 - 1, by omega⟩
    obtain ⟨b, rfl⟩ : ∃ b, r2 = b + 1 := ⟨r2 - 1, by omega⟩
    have htop : p.2 ∈ (timedReachK G (Cg ps ω τ G W (a + 1)) a).topWhole :=
      top_used3 ps ω τ G W fun h => by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨h, Or.inr (Or.inl hfirst₁)⟩
    have hpar : G.par p.2 ⊆ (timedReachK G (Cg ps ω τ G W (b + 1)) b).topWhole := fun v hv =>
      top_used3 ps ω τ G W fun h => by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨h, Or.inl ⟨p.2, hv, hfirst₂⟩⟩
    set m := max a b
    have hCm : ∀ {x}, x ≤ m → KLe (Cg ps ω τ G W (x + 1)) (Cg ps ω τ G W (m + 1)) :=
      fun hx => Cg_mono ps ω τ G W (by omega)
    have := rev_mem (w := p.1) ((tk_le (hCm (le_max_left a b)) (le_max_left a b)).2.2 htop)
      (hpar.trans (tk_le (hCm (le_max_right a b)) (le_max_right a b)).2.2)
    exact (tk_le (Cg_mono ps ω τ G W (by omega : m + 1 ≤ r)) (by omega)).2.1 this
  · obtain ⟨r1, hr1, hrt, hfirst⟩ := exists_firstAt ((mem_know_topWhole ps ω τ G W).1 hu)
    obtain ⟨r0, rfl⟩ : ∃ r0, r1 = r0 + 1 := ⟨r1 - 1, by omega⟩
    set C := Cg ps ω τ G W r0 with hC
    set C' := Cg ps ω τ G W (r0 + 1) with hC'
    have hCC' : KLe C C' := Cg_mono ps ω τ G W (Nat.le_succ r0)
    have hfin : ∀ {s}, s ≤ r0 + 1 → u ∈ (timedReachK G C' s).topWhole →
        u ∈ (timedReachK G (Cg ps ω τ G W r) r).topWhole :=
      fun hs hm => (tk_le (Cg_mono ps ω τ G W hrt) (by omega)).2.2 hm
    have hr' : r0 + 1 - 1 = r0 := by omega
    by_cases hin : u ∈ (timedReachK G C r0).topWhole
    · exact hfin (Nat.le_succ r0) ((timedReachK_mono_hold G hCC' r0).2.2 hin)
    by_cases hK : keyTop G C (r0 + 1) u <;> by_cases hcols : ∀ w, avail (timedReachK G C r0) w u
    · refine hfin le_rfl ((timedReachK_mono_hold G hCC' (r0 + 1)).2.2 (top_move (by omega) hK ?_))
      rwa [hr']
    · have hcols' : ∀ w, avail (timedReachK G C' r0) w u := by
        intro w
        by_cases hw : avail (timedReachK G C r0) w u
        · exact avail_mono (timedReachK_mono_hold G hCC' r0) hw
        · refine Or.inr ((hold_le r0).2.1 ((round3_le ps ω τ G W r0).1.2.1 ?_))
          simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
          refine ⟨by simpa using hw, Or.inr (Or.inr ⟨hfirst, by simpa using hin, hK⟩)⟩
      exact hfin le_rfl (top_move (by omega) (keyTop_mono hCC' hK) (by rwa [hr']))
    · have hkey : u ∈ C'.topKey := (round3_le ps ω τ G W r0).2.2 (by
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨hfirst, by simpa using hin, hK, by simpa using hcols⟩)
      exact hfin le_rfl (top_move (by omega) (Or.inl hkey)
        (by rw [hr']; exact fun w => avail_mono (timedReachK_mono_hold G hCC' r0) (hcols w)))
    · refine hfin (Nat.zero_le _) ((hold_le 0).2.2 ((round3_le ps ω τ G W r0).1.2.2 ?_))
      simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨by simpa using hin, Or.inr (Or.inr ⟨hfirst, hK, by simpa using hcols⟩)⟩

omit ps ω τ W in
/-- In the keyed game, a lower label with every column available is whole (every round promotes). -/
theorem timedReachK_whole_of_avail {c : KState n} {w : Fin n} :
    ∀ t, (∀ u, avail (timedReachK G c t) w u) → w ∈ (timedReachK G c t).lowerWhole
  | 0, h => mem_promote_of_avail h
  | 1, h => mem_promote_of_avail h
  | _ + 2, h => mem_promote_of_avail h

/-- **Stage 2, lower key.** If `H` at `hk1 w` was asked by round `r ≥ 1`, the key is available to round `r + 1`'s game:
`qH1 w`'s first ask credited every parent column not yet available, so every parent is whole by round `r − 1`. -/
theorem keyLow_of_asked_qH1 {r : ℕ} (hr : 1 ≤ r) {w : Fin n} (h : Asked ps ω (qH1 τ G W ω w) r) :
    keyLow G (Cg ps ω τ G W r) (r + 1) w := by
  obtain ⟨r1, hr1, hr1r, hfirst⟩ := exists_firstAt h
  obtain ⟨r0, rfl⟩ : ∃ r0, r1 = r0 + 1 := ⟨r1 - 1, by omega⟩
  refine Or.inr ⟨by omega, fun w' hw' => ?_⟩
  rw [show r + 1 - 2 = r - 1 by omega]
  refine timedReachK_whole_of_avail G (r - 1) fun u => ?_
  by_cases hav : avail (timedReachK G (Cg ps ω τ G W r0) r0) w' u
  · exact avail_mono (tk_le (Cg_mono ps ω τ G W (by omega : r0 ≤ r)) (by omega : r0 ≤ r - 1)) hav
  · refine Or.inr ((hold_le (r - 1)).2.1 ?_)
    have hcred : (w', u) ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r0) (r0 + 1)).hold.lowerCol := by
      simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨by simpa using hav, Or.inl ⟨w, hw', hfirst⟩⟩
    exact ((round3_le ps ω τ G W r0).trans (Cg_mono ps ω τ G W (by omega : r0 + 1 ≤ r))).1.2.1 hcred

/-- **Stage 2, lower label.** If `qP1 w` was asked by round `r`, lower `w` is whole in round `r`'s game from `Cg r`, so
round `r + 1` credits neither a column of `w` nor its key. -/
theorem lowerWhole_of_asked_qP1 {r : ℕ} {w : Fin n} (h : Asked ps ω (qP1 τ G W ω w) r) :
    w ∈ (timedReachK G (Cg ps ω τ G W r) r).lowerWhole :=
  (know_le_Cg ps ω τ G W r).1 ((mem_know_lowerWhole ps ω τ G W).2 h)

/-- **Stage 2, inverse at a lower label.** If `qI1 w` was asked by round `r`, every column of `w` is available in round
`r`'s game, so `w` is whole: its first ask credited the columns not yet available. -/
theorem lowerWhole_of_asked_qI1 {r : ℕ} {w : Fin n} (h : Asked ps ω (qI1 τ G W ω w) r) :
    w ∈ (timedReachK G (Cg ps ω τ G W r) r).lowerWhole := by
  obtain ⟨r1, hr1, hr1r, hfirst⟩ := exists_firstAt h
  obtain ⟨r0, rfl⟩ : ∃ r0, r1 = r0 + 1 := ⟨r1 - 1, by omega⟩
  refine timedReachK_whole_of_avail G r fun u => ?_
  by_cases hav : avail (timedReachK G (Cg ps ω τ G W r0) r0) w u
  · exact avail_mono (tk_le (Cg_mono ps ω τ G W (by omega : r0 ≤ r)) (by omega : r0 ≤ r)) hav
  · refine Or.inr ((hold_le r).2.1 ?_)
    have hcred : (w, u) ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r0) (r0 + 1)).hold.lowerCol := by
      simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨by simpa using hav, Or.inr (Or.inl hfirst)⟩
    exact ((round3_le ps ω τ G W r0).trans (Cg_mono ps ω τ G W (by omega : r0 + 1 ≤ r))).1.2.1 hcred

/-- **Stage 2, a lower hit.** A hit on `(0, w)` by round `r` holds `k¹_w`, so `w` is whole in every game round
`≥ 1` from `Cg r`. -/
theorem lowerWhole_of_hit {r t : ℕ} (ht : 1 ≤ t) {w : Fin n}
    (h : ((0 : Fin 2), w) ∈ hitsBy ps ω τ G W r) : w ∈ (timedReachK G (Cg ps ω τ G W r) t).lowerWhole := by
  classical
  refine lowerKey_mem ht (Finset.mem_union_right _ ?_)
  simp only [hitUnits, Finset.mem_filter, Finset.mem_univ, true_and]
  exact h

/-- **Stage 2, a top hit.** A hit on `(1, u)` by round `r` holds top `u`. -/
theorem topWhole_of_hit {r t : ℕ} {u : Fin n} (h : ((1 : Fin 2), u) ∈ hitsBy ps ω τ G W r) :
    u ∈ (timedReachK G (Cg ps ω τ G W r) t).topWhole := by
  classical
  refine (hold_le t).2.2 (Finset.mem_union_right _ ?_)
  simp only [hitUnits, Finset.mem_filter, Finset.mem_univ, true_and]
  exact h

/-- **Stage 2, forward at a top.** If `qP2 u` was asked by round `r`, top `u` is in round `r`'s game. -/
theorem topWhole_of_asked_qP2 {r : ℕ} {u : Fin n} (h : Asked ps ω (qP2 τ G W ω u) r) :
    u ∈ (timedReachK G (Cg ps ω τ G W r) r).topWhole :=
  (know_le_Cg ps ω τ G W r).2.2 ((mem_know_topWhole ps ω τ G W).2 h)

/-- **Stage 2, inverse at a top.** If `qI2 u` was asked by round `r`, top `u` is in round `r`'s game: its first ask
credited it, or it was already there. -/
theorem topWhole_of_asked_qI2 {r : ℕ} {u : Fin n} (h : Asked ps ω (qI2 τ G W ω u) r) :
    u ∈ (timedReachK G (Cg ps ω τ G W r) r).topWhole := by
  obtain ⟨r1, hr1, hr1r, hfirst⟩ := exists_firstAt h
  obtain ⟨r0, rfl⟩ : ∃ r0, r1 = r0 + 1 := ⟨r1 - 1, by omega⟩
  have := top_used3 ps ω τ G W (r := r0) (u := u) fun hn => by
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨hn, Or.inr (Or.inl hfirst)⟩
  exact (tk_le (Cg_mono ps ω τ G W (by omega : r0 + 1 ≤ r)) (by omega : r0 ≤ r)).2.2 this

/-- **Stage 2, top key.** If `H` at `hk2 u` was asked by round `r ≥ 1`, the key is available to round `r + 1`'s game:
`qH2 u`'s first ask credited every parent top not yet in the game. -/
theorem keyTop_of_asked_qH2 {r : ℕ} (hr : 1 ≤ r) {u : Fin n} (h : Asked ps ω (qH2 τ G W ω u) r) :
    keyTop G (Cg ps ω τ G W r) (r + 1) u := by
  obtain ⟨r1, hr1, hr1r, hfirst⟩ := exists_firstAt h
  obtain ⟨r0, rfl⟩ : ∃ r0, r1 = r0 + 1 := ⟨r1 - 1, by omega⟩
  refine Or.inr ⟨by omega, fun v hv => ?_⟩
  rw [show r + 1 - 2 = r - 1 by omega]
  have := top_used3 ps ω τ G W (r := r0) (u := v) fun hn => by
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨hn, Or.inl ⟨u, hv, hfirst⟩⟩
  exact (tk_le (Cg_mono ps ω τ G W (by omega : r0 + 1 ≤ r)) (by omega : r0 ≤ r - 1)).2.2 this

end Stage2

end PousKnowledge

end


/-! ════ Freshness.LuckyGame ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Game exclusions E7–E9 for the `ι` case table (`credit-resolved.md` §11.7)

- **E7** (`rev_avail`, `cols_avail_of_top`): the key-gated reverse move. A top in the game whose parents' tops are in the
  game, or whose key is held, gives every column one round later. So once `qH2 u` has been asked, and `qP2 u`, `qI2 u`
  or a hit on `(1, u)` has made top `u` known, every column `(·, u)` is available in the next round's game.
- **E8** (`inGame_*`, `not_credit_of_inGame`, the `*_rule` exclusions): the three `qP2` rules (T3, KT, C3) all fire at
  the first ask of `qP2 u`, which is one round (`firstAt_unique`), and their conditions exclude each other. After a
  top credit, a key credit, `qP2 u`, `qI2 u` or a hit, top `u` is in the game, so no later round credits it or its key,
  and every later column credit on `(·, u)` is by C1 or C2.
- **E9** (`col_avail_of_Rc1`): the first ask of `qH1 v` (`w ∈ par v`) or `qI1 w` credits column `(w, u)` or finds it
  available, so it is available in every later game.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

section Moves

variable {G : Labelling.TopoDAG n} {c : KState n}

/-- **E7, the key-gated reverse move.** A top in the game at `t`, whose parents' tops are in the game at `t` or whose
key is held, has every column available at `t + 1`. -/
theorem rev_avail {u : Fin n} {t : ℕ} (hu : u ∈ (timedReachK G c t).topWhole)
    (hk : G.par u ⊆ (timedReachK G c t).topWhole ∨ u ∈ c.topKey) (w : Fin n) :
    avail (timedReachK G c (t + 1)) w u := by
  refine Or.inr ?_
  rcases t with _ | s
  · show (w, u) ∈ (stepOneK G c (timedReachK G c 0)).lowerCol
    exact Finset.mem_union_right _
      (Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_filter.2 ⟨hu, hk⟩⟩)
  · show (w, u) ∈ (stepTwoK G c (timedReachK G c s) (timedReachK G c (s + 1))).lowerCol
    exact Finset.mem_union_right _
      (Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_filter.2 ⟨hu, hk⟩⟩)

end Moves

section Exclusions

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

theorem one_le_of_firstAt {q : (p3ModelT n wc).Qry} {r : ℕ} (h : FirstAt ps ω q r) : 1 ≤ r := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · exact absurd h.1 not_asked_zero
  · exact hr

/-- A query is first asked in one round only. -/
theorem firstAt_unique {q : (p3ModelT n wc).Qry} {r r' : ℕ} (h : FirstAt ps ω q r) (h' : FirstAt ps ω q r') :
    r = r' := by
  by_contra hne
  rcases Nat.lt_or_gt_of_ne hne with hlt | hlt
  · exact h'.2 (asked_mono (by omega) h.1)
  · exact h.2 (asked_mono (by omega) h'.1)

/-- The parents of `u` are in the game at `r − 1` once `qH2 u` has been asked by round `r`: its first ask credited
each parent top not yet in the game. -/
theorem par_inGame_of_asked_qH2 {r : ℕ} {u : Fin n} (h : Asked ps ω (qH2 τ G W ω u) r) :
    G.par u ⊆ (timedReachK G (Cg ps ω τ G W r) (r - 1)).topWhole := by
  obtain ⟨r1, hr1, hr1r, hfirst⟩ := exists_firstAt h
  obtain ⟨k, rfl⟩ : ∃ k, r1 = k + 1 := ⟨r1 - 1, by omega⟩
  intro v hv
  have := top_used3 ps ω τ G W (r := k) (u := v) fun hn => by
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨hn, Or.inl ⟨u, hv, hfirst⟩⟩
  exact (tk_le (Cg_mono ps ω τ G W (by omega : k + 1 ≤ r)) (by omega : k ≤ r - 1)).2.2 this

/-- **E7 for the credits.** If `qH2 u` has been asked by round `r`, and top `u` has been made known by round `r` (by
`qP2 u`, by `qI2 u` or by a hit on `(1, u)`), then every column `(·, u)` is available in round `r`'s game. So round
`r + 1` credits no column `(·, u)`. -/
theorem cols_avail_of_top {r : ℕ} {u : Fin n} (hK : Asked ps ω (qH2 τ G W ω u) r)
    (hT : Asked ps ω (qP2 τ G W ω u) r ∨ ((1 : Fin 2), u) ∈ hitsBy ps ω τ G W r ∨ Asked ps ω (qI2 τ G W ω u) r)
    (w : Fin n) : avail (timedReachK G (Cg ps ω τ G W r) r) w u := by
  obtain ⟨rK, hrK1, hrKr, -⟩ := exists_firstAt hK
  have hr1 : 1 ≤ r := by omega
  have hpar := par_inGame_of_asked_qH2 ps ω τ G W hK
  have fin : u ∈ (timedReachK G (Cg ps ω τ G W r) (r - 1)).topWhole →
      avail (timedReachK G (Cg ps ω τ G W r) r) w u := fun hu => by
    have := rev_avail hu (Or.inl hpar) w
    rwa [show r - 1 + 1 = r by omega] at this
  rcases hT with hP | hH | hI
  · obtain ⟨rP, hrP1, hrPr, hfP⟩ := exists_firstAt hP
    obtain ⟨k, rfl⟩ : ∃ k, rP = k + 1 := ⟨rP - 1, by omega⟩
    have hCk : KLe (Cg ps ω τ G W k) (Cg ps ω τ G W r) := Cg_mono ps ω τ G W (by omega)
    have hCk1 : KLe (Cg ps ω τ G W (k + 1)) (Cg ps ω τ G W r) := Cg_mono ps ω τ G W (by omega)
    by_cases hin : u ∈ (timedReachK G (Cg ps ω τ G W k) k).topWhole
    · exact fin ((tk_le hCk (by omega : k ≤ r - 1)).2.2 hin)
    by_cases hkt : keyTop G (Cg ps ω τ G W k) (k + 1) u
    · by_cases hw : avail (timedReachK G (Cg ps ω τ G W k) k) w u
      · exact avail_mono (tk_le hCk (by omega : k ≤ r)) hw
      · refine Or.inr ((hold_le r).2.1 (((round3_le ps ω τ G W k).trans hCk1).1.2.1 ?_))
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨by simpa using hw, Or.inr (Or.inr ⟨hfP, by simpa using hin, hkt⟩)⟩
    · by_cases hcols : ∀ w', avail (timedReachK G (Cg ps ω τ G W k) k) w' u
      · exact avail_mono (tk_le hCk (by omega : k ≤ r)) (hcols w)
      · refine fin ((hold_le (r - 1)).2.2 (((round3_le ps ω τ G W k).trans hCk1).1.2.2 ?_))
        simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨by simpa using hin, Or.inr (Or.inr ⟨hfP, hkt, hcols⟩)⟩
  · exact fin (topWhole_of_hit ps ω τ G W hH)
  · obtain ⟨rI, hrI1, hrIr, hfI⟩ := exists_firstAt hI
    obtain ⟨k, rfl⟩ : ∃ k, rI = k + 1 := ⟨rI - 1, by omega⟩
    have := top_used3 ps ω τ G W (r := k) (u := u) fun hn => by
      simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨hn, Or.inr (Or.inl hfI)⟩
    exact fin ((tk_le (Cg_mono ps ω τ G W (by omega : k + 1 ≤ r)) (by omega : k ≤ r - 1)).2.2 this)

/-- **E9.** After the first ask of `qH1 v` (`w ∈ par v`) or `qI1 w` in round `r'`, column `(w, u)` is available in the
game of every round `r ≥ r'`: that round credited it, or found it available. -/
theorem col_avail_of_Rc1 {w : Fin n} {r' r : ℕ} (hr : r' ≤ r)
    (hq : (∃ v, w ∈ G.par v ∧ FirstAt ps ω (qH1 τ G W ω v) r') ∨ FirstAt ps ω (qI1 τ G W ω w) r') (u : Fin n) :
    avail (timedReachK G (Cg ps ω τ G W r) r) w u := by
  have hr1 : 1 ≤ r' := by
    rcases hq with ⟨v, -, h⟩ | h
    · exact one_le_of_firstAt ps ω h
    · exact one_le_of_firstAt ps ω h
  obtain ⟨k, rfl⟩ : ∃ k, r' = k + 1 := ⟨r' - 1, by omega⟩
  by_cases hav : avail (timedReachK G (Cg ps ω τ G W k) k) w u
  · exact avail_mono (tk_le (Cg_mono ps ω τ G W (by omega : k ≤ r)) (by omega : k ≤ r)) hav
  · refine Or.inr ((hold_le r).2.1
      (((round3_le ps ω τ G W k).trans (Cg_mono ps ω τ G W (by omega : k + 1 ≤ r))).1.2.1 ?_))
    simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and]
    refine ⟨by simpa using hav, ?_⟩
    rcases hq with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)

/-! ### E8: the top credits exclude each other -/

/-- The T3 rule ("neither"): top `u` credited by the first ask of `qP2 u` in round `r + 1`. -/
def T3rule (r : ℕ) (u : Fin n) : Prop :=
  FirstAt ps ω (qP2 τ G W ω u) (r + 1) ∧ ¬ keyTop G (Cg ps ω τ G W r) (r + 1) u ∧
    ¬ ∀ w, avail (timedReachK G (Cg ps ω τ G W r) r) w u

/-- The KT rule: top `u`'s key credited by the first ask of `qP2 u` in round `r + 1`. -/
def KTrule (r : ℕ) (u : Fin n) : Prop :=
  FirstAt ps ω (qP2 τ G W ω u) (r + 1) ∧ u ∉ (timedReachK G (Cg ps ω τ G W r) r).topWhole ∧
    ¬ keyTop G (Cg ps ω τ G W r) (r + 1) u ∧ ∀ w, avail (timedReachK G (Cg ps ω τ G W r) r) w u

/-- The C3 rule: the missing columns `(·, u)` credited by the first ask of `qP2 u` in round `r + 1`, key available. -/
def C3rule (r : ℕ) (u : Fin n) : Prop :=
  FirstAt ps ω (qP2 τ G W ω u) (r + 1) ∧ u ∉ (timedReachK G (Cg ps ω τ G W r) r).topWhole ∧
    keyTop G (Cg ps ω τ G W r) (r + 1) u

theorem T3rule_not_KTrule {r : ℕ} {u : Fin n} (h : T3rule ps ω τ G W r u) : ¬ KTrule ps ω τ G W r u :=
  fun h' => h.2.2 h'.2.2.2

theorem C3rule_not_T3rule {r : ℕ} {u : Fin n} (h : C3rule ps ω τ G W r u) : ¬ T3rule ps ω τ G W r u :=
  fun h' => h'.2.1 h.2.2

theorem C3rule_not_KTrule {r : ℕ} {u : Fin n} (h : C3rule ps ω τ G W r u) : ¬ KTrule ps ω τ G W r u :=
  fun h' => h'.2.2.1 h.2.2

/-- **The three `qP2` rules fire in one round**: the round of `qP2 u`'s first ask. -/
theorem qP2rule_round {r r' : ℕ} {u : Fin n}
    (h : T3rule ps ω τ G W r u ∨ KTrule ps ω τ G W r u ∨ C3rule ps ω τ G W r u)
    (h' : T3rule ps ω τ G W r' u ∨ KTrule ps ω τ G W r' u ∨ C3rule ps ω τ G W r' u) : r = r' := by
  have f : ∀ {s}, (T3rule ps ω τ G W s u ∨ KTrule ps ω τ G W s u ∨ C3rule ps ω τ G W s u) →
      FirstAt ps ω (qP2 τ G W ω u) (s + 1) := fun h => by
    rcases h with h | h | h
    · exact h.1
    · exact h.1
    · exact h.1
  have := firstAt_unique ps ω (f h) (f h')
  omega

/-- **At most one of T3, KT and C3 fires on a top.** -/
theorem qP2rule_exclusive {r r' : ℕ} {u : Fin n} :
    (T3rule ps ω τ G W r u → ¬ KTrule ps ω τ G W r' u ∧ ¬ C3rule ps ω τ G W r' u) ∧
      (KTrule ps ω τ G W r u → ¬ C3rule ps ω τ G W r' u) := by
  refine ⟨fun h => ⟨fun h' => ?_, fun h' => ?_⟩, fun h h' => ?_⟩
  · have := qP2rule_round ps ω τ G W (Or.inl h) (Or.inr (Or.inl h'))
    subst this
    exact T3rule_not_KTrule ps ω τ G W h h'
  · have := qP2rule_round ps ω τ G W (Or.inl h) (Or.inr (Or.inr h'))
    subst this
    exact C3rule_not_T3rule ps ω τ G W h' h
  · have := qP2rule_round ps ω τ G W (Or.inr (Or.inl h)) (Or.inr (Or.inr h'))
    subst this
    exact C3rule_not_KTrule ps ω τ G W h' h

/-- A top credited in round `r + 1` is in the game from `Cg (r + 1)` at `r + 1`: it is held. -/
theorem inGame_of_top_credit {r : ℕ} {u : Fin n}
    (h : u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).hold.topWhole) :
    u ∈ (timedReachK G (Cg ps ω τ G W (r + 1)) (r + 1)).topWhole :=
  (hold_le (r + 1)).2.2 ((round3_le ps ω τ G W r).1.2.2 h)

/-- A top whose key is credited in round `r + 1` is in the game from `Cg (r + 1)` at `r + 1`: key held, columns
available. -/
theorem inGame_of_key_credit {r : ℕ} {u : Fin n}
    (h : u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).topKey) :
    u ∈ (timedReachK G (Cg ps ω τ G W (r + 1)) (r + 1)).topWhole := by
  have hkey : u ∈ (Cg ps ω τ G W (r + 1)).topKey := (round3_le ps ω τ G W r).2.2 h
  simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at h
  refine top_move (by omega) (Or.inl hkey) fun w => ?_
  rw [show r + 1 - 1 = r by omega]
  exact avail_mono (timedReachK_mono_hold G (Cg_mono ps ω τ G W (Nat.le_succ r)) r) (h.2.2.2 w)

/-- Being in the game persists to every later round's game. -/
theorem inGame_mono {r r' : ℕ} (hr : r ≤ r') {u : Fin n}
    (h : u ∈ (timedReachK G (Cg ps ω τ G W r) r).topWhole) :
    u ∈ (timedReachK G (Cg ps ω τ G W r') r').topWhole :=
  (tk_le (Cg_mono ps ω τ G W hr) hr).2.2 h

/-- **E8, no credit after the top is in the game.** If top `u` is in round `r + 1`'s game, round `r + 1` credits
neither `u` nor its key, and every column `(·, u)` it credits is by C1 or C2. -/
theorem not_credit_of_inGame {r : ℕ} {u : Fin n} (h : u ∈ (timedReachK G (Cg ps ω τ G W r) r).topWhole) :
    u ∉ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).hold.topWhole ∧
      u ∉ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).topKey ∧
      ∀ w, (w, u) ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).hold.lowerCol →
        (∃ v, w ∈ G.par v ∧ FirstAt ps ω (qH1 τ G W ω v) (r + 1)) ∨ FirstAt ps ω (qI1 τ G W ω w) (r + 1) := by
  have hr : r + 1 - 1 = r := by omega
  refine ⟨fun h' => ?_, fun h' => ?_, fun w h' => ?_⟩
  · simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, hr] at h'
    exact h'.1 h
  · simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, hr] at h'
    exact h'.2.1 h
  · simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and, hr] at h'
    rcases h'.2 with h1 | h2 | h3
    · exact Or.inl h1
    · exact Or.inr h2
    · exact absurd h h3.2.1

/-- **A top is credited in one round only.** -/
theorem top_credit_round {r r' : ℕ} {u : Fin n}
    (h : u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).hold.topWhole)
    (h' : u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r') (r' + 1)).hold.topWhole) : r = r' := by
  by_contra hne
  rcases Nat.lt_or_gt_of_ne hne with hlt | hlt
  · exact (not_credit_of_inGame ps ω τ G W
      (inGame_mono ps ω τ G W (by omega : r + 1 ≤ r') (inGame_of_top_credit ps ω τ G W h))).1 h'
  · exact (not_credit_of_inGame ps ω τ G W
      (inGame_mono ps ω τ G W (by omega : r' + 1 ≤ r) (inGame_of_top_credit ps ω τ G W h'))).1 h

/-- **A top key is credited in one round only**, and never after the top was credited. -/
theorem key_credit_round {r r' : ℕ} {u : Fin n}
    (h : u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).topKey)
    (h' : u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r') (r' + 1)).hold.topWhole ∨
      u ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r') (r' + 1)).topKey) : r' ≤ r := by
  by_contra hlt
  rw [not_le] at hlt
  have hg := inGame_mono ps ω τ G W (by omega : r + 1 ≤ r') (inGame_of_key_credit ps ω τ G W h)
  rcases h' with h' | h'
  · exact (not_credit_of_inGame ps ω τ G W hg).1 h'
  · exact (not_credit_of_inGame ps ω τ G W hg).2.1 h'

end Exclusions

end PousKnowledge

end


/-! ════ Freshness.LuckySplit ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Split rounds: inverse queries last (`credit-resolved.md` §10)

`splitProg` turns each round `qs` into two half-rounds: first `qs`'s non-inverse queries, then its inverse queries, and
continues on the merged answers. The program asks the same queries, round for round (`rounds_splitProg`), in twice
the rounds and the same work (`bounded_splitProg`).

The counting chain of `PinFamily` is `chainX` of the split family, at `2D` rounds. In it, every forward or `H` answer
of a round comes before the round's inverse answers. So a hit's forward query is sampled before a same-round
`P_t⁻¹(x_t)`, which the class does not constrain.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousRounds

variable {n wc : ℕ}

/-- Inverse queries. -/
def isInvQ : (p3ModelT n wc).Qry → Bool
  | Sum.inr (Sum.inr _) => true
  | _ => false

/-- The answers in `qs`'s order: non-inverse ones from `a`, inverse ones from `b`. -/
def mergeAns : List (p3ModelT n wc).Qry → List (p3ModelT n wc).Ans → List (p3ModelT n wc).Ans →
    List (p3ModelT n wc).Ans
  | [], _, _ => []
  | q :: qs, a, b =>
    if isInvQ q then b.headD (show Lab n wc from fun _ _ => false) :: mergeAns qs a b.tail
    else a.headD (show Lab n wc from fun _ _ => false) :: mergeAns qs a.tail b

theorem mergeAns_map (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) :
    ∀ qs : List (p3ModelT n wc).Qry,
      mergeAns qs ((qs.filter fun q => !isInvQ q).map f) ((qs.filter isInvQ).map f) = qs.map f
  | [] => rfl
  | q :: qs => by
    by_cases h : isInvQ q = true
    · rw [List.filter_cons_of_neg (by simp [h]), List.filter_cons_of_pos h, List.map_cons, List.map_cons]
      simp only [mergeAns, if_pos h, List.tail_cons]
      rw [mergeAns_map f qs]
      rfl
    · rw [List.filter_cons_of_pos (by simpa using h), List.filter_cons_of_neg h, List.map_cons, List.map_cons]
      simp only [mergeAns, h, Bool.false_eq_true, ite_false, List.tail_cons]
      rw [mergeAns_map f qs]
      rfl

/-- **The split program**: each round becomes its non-inverse half, then its inverse half. -/
def splitProg {α : Type} : Prog (p3ModelT n wc) α → Prog (p3ModelT n wc) α
  | .ret a => .ret a
  | .round qs k => .round (qs.filter fun q => !isInvQ q)
      fun a => .round (qs.filter isInvQ) fun b => splitProg (k (mergeAns qs a b))

/-- The split family. -/
def splitFam {α : Type} (p : Fin n → Prog (p3ModelT n wc) α) : Fin n → Prog (p3ModelT n wc) α :=
  fun c => splitProg (p c)

/-- Each round, as its two halves. -/
def splitRounds (rs : List (List (p3ModelT n wc).Qry)) : List (List (p3ModelT n wc).Qry) :=
  rs.flatMap fun qs => [qs.filter fun q => !isInvQ q, qs.filter isInvQ]

theorem rounds_splitProg {α : Type} (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) (p : Prog (p3ModelT n wc) α) :
    rounds f (splitProg p) = splitRounds (rounds f p) := by
  induction p with
  | ret a => rfl
  | round qs k ih =>
    show (qs.filter fun q => !isInvQ q) :: (qs.filter isInvQ) ::
        rounds f (splitProg (k (mergeAns qs ((qs.filter fun q => !isInvQ q).map f) ((qs.filter isInvQ).map f)))) =
      splitRounds (qs :: rounds f (k (qs.map f)))
    rw [mergeAns_map, ih]
    simp [splitRounds]

theorem length_filter_add (qs : List (p3ModelT n wc).Qry) :
    (qs.filter fun q => !isInvQ q).length + (qs.filter isInvQ).length = qs.length := by
  induction qs with
  | nil => rfl
  | cons q qs ih =>
    by_cases h : isInvQ q = true
    · simp only [List.filter_cons, h, Bool.not_true]; simp; omega
    · simp only [Bool.not_eq_true] at h
      simp only [List.filter_cons, h, Bool.not_false]; simp; omega

theorem depth_splitProg {α : Type} (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) (p : Prog (p3ModelT n wc) α) :
    (splitProg p).depth f = 2 * p.depth f := by
  induction p with
  | ret a => rfl
  | round qs k ih =>
    show (splitProg (k (mergeAns qs ((qs.filter fun q => !isInvQ q).map f)
        ((qs.filter isInvQ).map f)))).depth f + 1 + 1 = 2 * ((k (qs.map f)).depth f + 1)
    rw [mergeAns_map, ih]; ring

theorem work_splitProg {α : Type} (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) (p : Prog (p3ModelT n wc) α) :
    (splitProg p).work f = p.work f := by
  induction p with
  | ret a => rfl
  | round qs k ih =>
    show (qs.filter fun q => !isInvQ q).length + ((qs.filter isInvQ).length +
        (splitProg (k (mergeAns qs ((qs.filter fun q => !isInvQ q).map f)
          ((qs.filter isInvQ).map f)))).work f) = qs.length + (k (qs.map f)).work f
    rw [mergeAns_map, ih, ← length_filter_add qs]; ring

theorem run_splitProg {α : Type} (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) (p : Prog (p3ModelT n wc) α) :
    (splitProg p).run f = p.run f := by
  induction p with
  | ret a => rfl
  | round qs k ih =>
    show (splitProg (k (mergeAns qs ((qs.filter fun q => !isInvQ q).map f)
        ((qs.filter isInvQ).map f)))).run f = (k (qs.map f)).run f
    rw [mergeAns_map, ih]

theorem bounded_splitProg {α : Type} {D Q : ℕ} {p : Prog (p3ModelT n wc) α} (hb : p.Bounded D Q) :
    (splitProg p).Bounded (2 * D) Q := fun ω => by
  rw [depth_splitProg, work_splitProg]
  exact ⟨by have := (hb ω).1; omega, (hb ω).2⟩

theorem bounded_splitFam {α : Type} {D Q : ℕ} {p : Fin n → Prog (p3ModelT n wc) α}
    (hb : ∀ c, (p c).Bounded D Q) : ∀ c, (splitFam p c).Bounded (2 * D) Q :=
  fun c => bounded_splitProg (hb c)

/-! ### The split program asks the same queries -/

theorem take_splitRounds : ∀ (rs : List (List (p3ModelT n wc).Qry)) (t : ℕ),
    (splitRounds rs).take (2 * t) = splitRounds (rs.take t)
  | [], _ => by simp [splitRounds]
  | _ :: _, 0 => by simp [splitRounds]
  | qs :: rs, t + 1 => by
    have ih := take_splitRounds rs t
    simp only [splitRounds, List.flatMap_cons, List.take_succ_cons] at ih ⊢
    rw [show 2 * (t + 1) = 2 * t + 1 + 1 by ring]
    simp [ih]

theorem mem_flatten_splitRounds (q : (p3ModelT n wc).Qry) :
    ∀ rs : List (List (p3ModelT n wc).Qry), q ∈ (splitRounds rs).flatten ↔ q ∈ rs.flatten
  | [] => by simp [splitRounds]
  | qs :: rs => by
    have ih := mem_flatten_splitRounds q rs
    simp only [splitRounds, List.flatMap_cons, List.flatten_append, List.mem_append] at ih ⊢
    rw [ih]
    simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_append, List.mem_filter]
    by_cases h : isInvQ q = true
    · simp [h]
    · simp only [Bool.not_eq_true] at h
      simp [h]

theorem mem_upTo_splitProg {α : Type} (f : (p3ModelT n wc).Qry → (p3ModelT n wc).Ans) (p : Prog (p3ModelT n wc) α)
    (t : ℕ) (q : (p3ModelT n wc).Qry) : q ∈ upTo f (splitProg p) (2 * t) ↔ q ∈ upTo f p t := by
  unfold upTo
  rw [rounds_splitProg, take_splitRounds, mem_flatten_splitRounds]

/-! ### The split chain's prefix fixes the original rounds -/

section Chain

variable {τ : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc}

/-- **Answers agree on the first `i` rounds** when the prefix covers them. -/
theorem ans_eq_of_prefix {pc : Fin n → Prog (p3ModelT n wc) (Lab n wc)} {Dc Q : ℕ}
    (hb : ∀ c, (pc c).Bounded Dc Q) {i : ℕ} (hi : i ≤ Dc) {ω ω'' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX pc τ G W Dc Q) (i * (n * Q)) ω ω'') (c : Fin n) :
    ∀ q ∈ upTo ((p3ModelT n wc).answer ω) (pc c) i,
      (p3ModelT n wc).answer ω q = (p3ModelT n wc).answer ω'' q := by
  have hans : ∀ i' < i, ∀ j, ansVar pc ω i' c j = ansVar pc ω'' i' c j := by
    intro i' hi' j
    rcases Nat.lt_or_ge j Q with hj | hj
    · have hlt : encA n Q i' c j < i * (n * Q) := by
        have hc : (c : ℕ) * Q + j < n * Q := by
          have h1 : (c : ℕ) + 1 ≤ n := c.isLt
          calc (c : ℕ) * Q + j < (c : ℕ) * Q + Q := by omega
            _ = ((c : ℕ) + 1) * Q := by ring
            _ ≤ n * Q := Nat.mul_le_mul_right _ h1
        have h2 : (i' + 1) * (n * Q) ≤ i * (n * Q) := Nat.mul_le_mul_right _ hi'
        unfold encA; nlinarith
      have e := h _ hlt
      rwa [chainX_encA pc τ G W Dc Q c (lt_of_lt_of_le hi' hi) hj,
        chainX_encA pc τ G W Dc Q c (lt_of_lt_of_le hi' hi) hj] at e
    · exact ansVar_eq_of_ge pc hb ω ω'' i' c hj
  have htake := rounds_take_eq_of_ansVar pc c i hans
  intro q hq
  obtain ⟨i', hi', j', hj'⟩ := (mem_upTo_iff _ _ _ q).1 hq
  have hq' : qAt pc ω'' i' c j' = some q := by
    have : ((rounds ((p3ModelT n wc).answer ω'') (pc c)).getD i' []) =
        ((rounds ((p3ModelT n wc).answer ω) (pc c)).getD i' []) := by
      have e := congrArg (fun l => l[i']?) htake
      simp only [List.getElem?_take, if_pos hi'] at e
      simp only [List.getD_eq_getElem?_getD, e]
    unfold qAt
    rw [this]
    exact hj'
  have hv := hans i' hi' j'
  unfold ansVar at hv
  rw [show qAt pc ω i' c j' = some q from hj', hq'] at hv
  exact hv

/-- **The split chain's prefix at the start of round `i + 1` fixes rounds `≤ i + 1` of the original programs**: the
prefix covers the answers of both halves of every earlier round. -/
theorem rounds_take_eq_of_splitPrefix {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)} {D Q : ℕ}
    (hb : ∀ c, (p c).Bounded D Q) {i : ℕ} (hi : i ≤ D) {ω ω'' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX (splitFam p) τ G W (2 * D) Q) ((2 * i) * (n * Q)) ω ω'') (c : Fin n) :
    (rounds ((p3ModelT n wc).answer ω) (p c)).take (i + 1) =
      (rounds ((p3ModelT n wc).answer ω'') (p c)).take (i + 1) := by
  have hans := ans_eq_of_prefix (bounded_splitFam hb) (by omega : 2 * i ≤ 2 * D) h c
  exact rounds_congr (p c) i fun q hq => hans q ((mem_upTo_splitProg _ (p c) i q).2 hq)

end Chain

/-! ### What the re-indexing `D → 2D` preserves

The class, the credits and the hits of `PinFamily` are `p`'s, at `D`; only the chain is split. The split family's
half-round `2t` has asked exactly what `p` asked by round `t` (`asked_splitFam_even`), and its half-round `2t + 1` adds
round `t + 1`'s non-inverse queries (`asked_splitFam_odd`). So a non-inverse query is first asked by the split family
in half-round `2k + 1` exactly when `p` first asks it in round `k + 1` (`firstAt_splitFam_odd`), and an inverse query
in half-round `2k + 2` (`firstAt_splitFam_inv`). The hits coincide (`hitAt_splitFam`, `hitsBy_splitFam`), and so do
the outputs (`run_splitProg`). The split family's own credits and slots are not used: its game would run twice as many
rounds, and its traces are reordered within each round.
-/

theorem mem_take_splitRounds_odd (q : (p3ModelT n wc).Qry) :
    ∀ (rs : List (List (p3ModelT n wc).Qry)) (t : ℕ), q ∈ ((splitRounds rs).take (2 * t + 1)).flatten ↔
      q ∈ (rs.take t).flatten ∨ (isInvQ q = false ∧ q ∈ (rs.take (t + 1)).flatten)
  | [], _ => by simp [splitRounds]
  | qs :: rs, 0 => by
    simp only [splitRounds, List.flatMap_cons, Nat.mul_zero, Nat.zero_add, List.take_zero, List.flatten_nil,
      List.not_mem_nil, false_or, List.take_succ_cons]
    simp only [List.cons_append, List.take_succ_cons, List.take_zero, List.flatten_cons, List.flatten_nil,
      List.append_nil, List.mem_filter]
    by_cases h : isInvQ q = true <;> simp [h]
  | qs :: rs, t + 1 => by
    have ih := mem_take_splitRounds_odd q rs t
    have e : (splitRounds (qs :: rs)).take (2 * (t + 1) + 1) =
        (qs.filter fun q => !isInvQ q) :: (qs.filter isInvQ) :: (splitRounds rs).take (2 * t + 1) := by
      rw [show 2 * (t + 1) + 1 = 2 * t + 1 + 1 + 1 by ring]
      simp [splitRounds]
    rw [e]
    simp only [List.flatten_cons, List.mem_append, ih, List.take_succ_cons, List.mem_filter]
    by_cases h : isInvQ q = true
    · simp [h]
    · simp only [Bool.not_eq_true] at h
      simp only [h, Bool.not_false, and_true, Bool.false_eq_true, and_false, false_or, true_and]
      constructor
      · rintro (h1 | h2 | h3)
        exacts [Or.inl (Or.inl h1), Or.inl (Or.inr h2), Or.inr (Or.inr h3)]
      · rintro ((h1 | h2) | h1 | h3)
        exacts [Or.inl h1, Or.inr (Or.inl h2), Or.inl h1, Or.inr (Or.inr h3)]

variable {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)}

theorem asked_splitFam_even (ω : (p3ModelT n wc).Ω) (q : (p3ModelT n wc).Qry) (t : ℕ) :
    Asked (splitFam p) ω q (2 * t) ↔ Asked p ω q t := by
  unfold Asked
  exact exists_congr fun c => mem_upTo_splitProg _ (p c) t q

theorem asked_splitFam_odd (ω : (p3ModelT n wc).Ω) (q : (p3ModelT n wc).Qry) (t : ℕ) :
    Asked (splitFam p) ω q (2 * t + 1) ↔ Asked p ω q t ∨ (isInvQ q = false ∧ Asked p ω q (t + 1)) := by
  unfold Asked upTo
  simp only [splitFam, rounds_splitProg, mem_take_splitRounds_odd]
  constructor
  · rintro ⟨c, hc | ⟨hq, hc⟩⟩
    · exact Or.inl ⟨c, hc⟩
    · exact Or.inr ⟨hq, c, hc⟩
  · rintro (⟨c, hc⟩ | ⟨hq, c, hc⟩)
    · exact ⟨c, Or.inl hc⟩
    · exact ⟨c, Or.inr ⟨hq, hc⟩⟩

/-- **A non-inverse query is first asked in half-round `2k + 1` of the split family exactly when `p` first asks it in
round `k + 1`.** -/
theorem firstAt_splitFam_odd {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} (hq : isInvQ q = false) (k : ℕ) :
    FirstAt (splitFam p) ω q (2 * k + 1) ↔ FirstAt p ω q (k + 1) := by
  unfold FirstAt
  rw [show 2 * k + 1 - 1 = 2 * k by omega, show k + 1 - 1 = k by omega, asked_splitFam_odd, asked_splitFam_even]
  constructor
  · rintro ⟨h | ⟨-, h⟩, hn⟩
    · exact absurd h hn
    · exact ⟨h, hn⟩
  · rintro ⟨h, hn⟩
    exact ⟨Or.inr ⟨hq, h⟩, hn⟩

/-- A non-inverse query is never first asked in an even half-round. -/
theorem not_firstAt_splitFam_even {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} (hq : isInvQ q = false)
    (k : ℕ) : ¬ FirstAt (splitFam p) ω q (2 * k) := by
  rintro ⟨h, hn⟩
  rcases k with _ | k
  · exact not_asked_zero h
  · rw [asked_splitFam_even] at h
    rw [show 2 * (k + 1) - 1 = 2 * k + 1 by omega, asked_splitFam_odd] at hn
    exact hn (Or.inr ⟨hq, h⟩)

/-- **An inverse query is first asked in half-round `2k + 2` of the split family exactly when `p` first asks it in
round `k + 1`.** -/
theorem firstAt_splitFam_inv {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} (hq : isInvQ q = true) (k : ℕ) :
    FirstAt (splitFam p) ω q (2 * (k + 1)) ↔ FirstAt p ω q (k + 1) := by
  unfold FirstAt
  rw [show 2 * (k + 1) - 1 = 2 * k + 1 by omega, show k + 1 - 1 = k by omega, asked_splitFam_odd,
    asked_splitFam_even]
  simp [hq]

/-- An inverse query is never first asked in an odd half-round. -/
theorem not_firstAt_splitFam_inv_odd {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} (hq : isInvQ q = true)
    (k : ℕ) : ¬ FirstAt (splitFam p) ω q (2 * k + 1) := by
  rintro ⟨h, hn⟩
  rw [asked_splitFam_odd] at h
  rw [show 2 * k + 1 - 1 = 2 * k by omega, asked_splitFam_even] at hn
  rcases h with h | ⟨h', -⟩
  · exact hn h
  · rw [hq] at h'; exact Bool.noConfusion h'

section Hits

variable (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

/-- **Hits are preserved**: the split family hits `t` in half-round `r` exactly when `r = 2k + 1` and `p` hits `t` in
round `k + 1`. -/
theorem hitAt_splitFam (ω : (p3ModelT n wc).Ω) (t : Fin 2 × Fin n) (r : ℕ) :
    hitAt (splitFam p) ω τ G W t r ↔ ∃ k, r = 2 * k + 1 ∧ hitAt p ω τ G W t (k + 1) := by
  have hq : isInvQ (qHit τ G W ω t) = false := rfl
  constructor
  · rintro ⟨hf, hz, hn⟩
    obtain ⟨k, rfl | rfl⟩ := Nat.even_or_odd' r
    · exact absurd hf (not_firstAt_splitFam_even hq k)
    · refine ⟨k, rfl, (firstAt_splitFam_odd hq k).1 hf, hz, ?_⟩
      rw [show 2 * k + 1 - 1 = 2 * k by omega, asked_splitFam_even] at hn
      rwa [show k + 1 - 1 = k by omega]
  · rintro ⟨k, rfl, hf, hz, hn⟩
    refine ⟨(firstAt_splitFam_odd hq k).2 hf, hz, ?_⟩
    rw [show 2 * k + 1 - 1 = 2 * k by omega, asked_splitFam_even]
    rwa [show k + 1 - 1 = k by omega] at hn

/-- **`hitsBy` is preserved across `D → 2D`.** -/
theorem hitsBy_splitFam (ω : (p3ModelT n wc).Ω) (R : ℕ) :
    hitsBy (splitFam p) ω τ G W (2 * R) = hitsBy p ω τ G W R := by
  classical
  ext t
  simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and, hitAt_splitFam]
  constructor
  · rintro ⟨r, hr, k, rfl, hk⟩
    exact ⟨k + 1, by omega, hk⟩
  · rintro ⟨r, hr, hk⟩
    obtain ⟨k, rfl⟩ : ∃ k, r = k + 1 := ⟨r - 1, by
      rcases Nat.eq_zero_or_pos r with h0 | h0
      · subst h0; exact absurd hk.1.1 not_asked_zero
      · omega⟩
    exact ⟨2 * k + 1, by omega, k, rfl, hk⟩

end Hits

end PousKnowledge

end


/-! ════ Freshness.LuckyPins ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Semantic pins, and the reduction of `CreditResolvedTyped` to `PinFamily` (`credit-resolved.md` §9)

The pin at `ℓ` for the typed class `(S, H)` is `semPin ℓ ω`: the values of `X ℓ` over the class members sharing `ω`'s
prefix. The chain `X` is that of the split family (`splitFam p`, at `2D` rounds; `LuckySplit.lean`), while the class
is `p`'s. It is prefix-determined and holds on the class. If every class member sharing the prefix agrees with `ω` on
components `J`, the pin has at most `2^{wc·(n − |J|)}` values (`card_semPin_le`).
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

/-- The labels agreeing with `y` on the components `J`. -/
theorem card_agree_le (y : Lab n wc) (J : Finset (Fin n)) :
    (Finset.univ.filter fun x : Lab n wc => ∀ j ∈ J, x j = y j).card ≤ (2 ^ wc) ^ (n - J.card) := by
  classical
  let f : Lab n wc → ({j // j ∉ J} → Bits wc) := fun x j => x j.1
  have hinj : Set.InjOn f (Finset.univ.filter fun x : Lab n wc => ∀ j ∈ J, x j = y j) := by
    intro x hx x' hx' he
    have hx1 := (Finset.mem_filter.1 hx).2
    have hx2 := (Finset.mem_filter.1 hx').2
    funext j
    by_cases hj : j ∈ J
    · rw [hx1 j hj, hx2 j hj]
    · exact congrFun he ⟨j, hj⟩
  calc (Finset.univ.filter fun x : Lab n wc => ∀ j ∈ J, x j = y j).card
      ≤ (Finset.univ : Finset ({j // j ∉ J} → Bits wc)).card :=
        Finset.card_le_card_of_injOn f (fun _ _ => Finset.mem_coe.2 (Finset.mem_univ _)) hinj
    _ = (2 ^ wc) ^ (n - J.card) := by
        rw [Finset.card_univ, Fintype.card_fun, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
        congr 1
        rw [Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_coe]

section Pins

variable (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (τ : Bits 256) (G : Labelling.TopoDAG n)
  (W : Fin n → Lab n wc) (D Q : ℕ) (S H : Finset (ℕ × ℕ))

open Classical in
/-- **The semantic pin** at `ℓ` for the typed class `(S, H)`: the values of `X ℓ` over the class members sharing `ω`'s
prefix. -/
noncomputable def semPin (ℓ : ℕ) (ω : (p3ModelT n wc).Ω) : Finset (Lab n wc) :=
  ((PousLuckyChain.cls (chainX (splitFam p) τ G W (2 * D) Q) ℓ ω).filter fun ω'' =>
      luckySet p ω'' τ G W D Q = S ∧ hitSlotSet p ω'' τ G W D = H).image (chainX (splitFam p) τ G W (2 * D) Q ℓ)

variable {p τ G W D Q S H}

theorem semPin_prefixDet {ℓ : ℕ} {ω ω' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX (splitFam p) τ G W (2 * D) Q) ℓ ω ω') :
    semPin p τ G W D Q S H ℓ ω = semPin p τ G W D Q S H ℓ ω' := by
  unfold semPin
  rw [PousLuckyChain.cls_eq h]

theorem mem_semPin_self {ℓ : ℕ} {ω : (p3ModelT n wc).Ω} (hS : luckySet p ω τ G W D Q = S)
    (hH : hitSlotSet p ω τ G W D = H) : chainX (splitFam p) τ G W (2 * D) Q ℓ ω ∈ semPin p τ G W D Q S H ℓ ω := by
  classical
  unfold semPin
  exact Finset.mem_image.2 ⟨ω, Finset.mem_filter.2 ⟨PousLuckyChain.mem_cls.2 fun _ _ => rfl, hS, hH⟩, rfl⟩

theorem semPin_subset_Fr (hb : ∀ c, (p c).Bounded D Q) (ℓ : ℕ) (ω : (p3ModelT n wc).Ω) :
    semPin p τ G W D Q S H ℓ ω ⊆ Fr (splitFam p) τ G W (2 * D) Q ℓ ω := by
  classical
  intro x hx
  obtain ⟨ω'', hω'', rfl⟩ := Finset.mem_image.1 hx
  rw [Fr_eq_of_prefix (bounded_splitFam hb) (PousLuckyChain.mem_cls.1 (Finset.mem_filter.1 hω'').1)]
  exact chainX_mem_Fr ℓ ω''

/-- **The pin's size.** If every class member sharing the prefix agrees with `ω` on the components `J`, the pin has at
most `2^{wc·(n − |J|)}` values. -/
theorem card_semPin_le {ℓ : ℕ} {ω : (p3ModelT n wc).Ω} (J : Finset (Fin n))
    (hdet : ∀ ω'' ∈ PousLuckyChain.cls (chainX (splitFam p) τ G W (2 * D) Q) ℓ ω, luckySet p ω'' τ G W D Q = S →
      hitSlotSet p ω'' τ G W D = H →
        ∀ j ∈ J, chainX (splitFam p) τ G W (2 * D) Q ℓ ω'' j = chainX (splitFam p) τ G W (2 * D) Q ℓ ω j) :
    (semPin p τ G W D Q S H ℓ ω).card ≤ (2 ^ wc) ^ (n - J.card) := by
  classical
  refine le_trans (Finset.card_le_card fun x hx => ?_) (card_agree_le (chainX (splitFam p) τ G W (2 * D) Q ℓ ω) J)
  obtain ⟨ω'', hω'', rfl⟩ := Finset.mem_image.1 hx
  obtain ⟨hcls, hS, hH⟩ := Finset.mem_filter.1 hω''
  exact Finset.mem_filter.2 ⟨Finset.mem_univ _, hdet ω'' hcls hS hH⟩

end Pins

end PousKnowledge

end


/-! ════ Freshness.LuckyPinHyp ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `PinFamily`: the remaining gap of `CreditResolvedTyped` (assumptions module; `credit-resolved.md` §9)

For every member `ω` of a typed class `(S, H)`, there is a family `J ℓ ⊆ Fin n` of pinned components of the split
chain's variables such that:
- the chain is `chainX (splitFam p) … (2D) Q`: each round's inverse answers come after its other answers
  (`LuckySplit.lean`; `credit-resolved.md` §10 shows that the unsplit chain fails);
- there are `m = 2D·n·Q + 4n` variables.
The conditions are:
- **fixed**: every class member sharing `ω`'s prefix at `ℓ` agrees with `ω` on `J ℓ`;
- **fresh**: a pinned variable's pool is at least `M − Q_tot`;
- **few**: at most `32n` variables are pinned;
- **cover**: the pinned components number at least `ω`'s lucky units (`luckyBits = wc · luckyUnits`).

The pivot injection `ι` builds `J`: `J ℓ = {j | some credited unit maps to (ℓ, j)}`. Its injectivity gives the cover,
stage 2 gives freshness, and each credit rule's equation gives the fixing.
`creditResolvedTyped_of_pinFamily` (`LuckyPinGlue.lean`) proves `CreditResolvedTyped` from it.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge

/-- The lucky units of `ω`: its credited units, and `n` per hit. -/
noncomputable def luckyUnits {n wc : ℕ} (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
    (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (D : ℕ) : ℕ :=
  (cred3 p ω τ G W D).size + n * (hitsBy p ω τ G W D).card

theorem luckyBits_eq_units {n wc : ℕ} (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
    (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (D : ℕ) :
    luckyBits p ω τ G W D = wc * luckyUnits p ω τ G W D := by
  unfold luckyBits luckyUnits; ring

/-- `PinFamily`'s conclusion for one instance, typed class `(S, H)` and member `ω`: pinned components `J` that are
fixed, fresh, few and cover `ω`'s lucky units. -/
def PinsAt {n wc : ℕ} (D Q : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (S H : Finset (ℕ × ℕ)) (ω : (p3ModelT n wc).Ω) : Prop :=
  ∃ J : ℕ → Finset (Fin n),
    (∀ ℓ < 2 * D * (n * Q) + 4 * n, ∀ ω'' ∈ PousLuckyChain.cls (chainX (splitFam p) tag G W (2 * D) Q) ℓ ω,
      luckySet p ω'' tag G W D Q = S → hitSlotSet p ω'' tag G W D = H →
        ∀ j ∈ J ℓ, chainX (splitFam p) tag G W (2 * D) Q ℓ ω'' j = chainX (splitFam p) tag G W (2 * D) Q ℓ ω j) ∧
    (∀ ℓ < 2 * D * (n * Q) + 4 * n, (J ℓ).Nonempty →
      2 ^ (n * wc) - (n * (Q + 1) + 2 * n) ≤ Pool (splitFam p) tag G W (2 * D) Q ℓ ω) ∧
    ((Finset.range (2 * D * (n * Q) + 4 * n)).filter fun ℓ => (J ℓ).Nonempty).card ≤ 32 * n ∧
    luckyUnits p ω tag G W D ≤ ∑ ℓ ∈ Finset.range (2 * D * (n * Q) + 4 * n), (J ℓ).card

/-- **`PinFamily`** (the remaining gap; built by `ι`): `PinsAt` for every member of every typed class. -/
def PinFamily : Prop :=
  ∀ (n wc D Q : ℕ) (tag : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)
    (p : Fin n → Prog (p3ModelT n wc) (Lab n wc)), 0 < n →
    64 * n * (n * (Q + 1) + 2 * n) ≤ 2 ^ (n * wc) → (∀ c, (p c).Bounded D Q) →
    ∀ (S H : Finset (ℕ × ℕ)) (ω : (p3ModelT n wc).Ω), luckySet p ω tag G W D Q = S →
      hitSlotSet p ω tag G W D = H → PinsAt D Q tag G W p S H ω

end PousAssembly

end


/-! ════ Freshness.LuckyPinGlue ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# `PinFamily → CreditResolvedTyped` (`credit-resolved.md` §9)

The chain is `chainX` of the split family at `2D` rounds, the pools are its `Pool`, and the pins are `semPin S H`:
prefix-determined (`semPin_prefixDet`, `Pool_eq_of_prefix`), with `Fibre` from `fibre_chain` (stage 1, applied to
`splitFam p`, which is `(2D, Q)`-bounded). For a class member, `PinFamily`'s `J` bounds each weight:
- a pinned variable weighs `≥ c·(2^{wc})^{|J ℓ|}`, with `c = (M − Q_tot)/M`;
- an unpinned one weighs `≥ 1`.

So `Π w ≥ c^{32n}·2^{wc·units} ≥ 2^{bits}/2`, since `c^{32n} ≥ 1/2` by Bernoulli under the pool condition.
-/

namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge PousLuckyChain

variable {n wc : ℕ}

/-- A pinned variable's weight: `Pool/|semPin| ≥ c·(2^{wc})^{|J|}`, where `c·M = M − Q_tot ≤ Pool`,
`|semPin| ≤ (2^{wc})^{n − |J|}` and `M = (2^{wc})^n`. -/
theorem weight_pinned {M Pl card Qt k : ℕ} (hM : M = (2 ^ wc) ^ n) (hk : k ≤ n) (hcard0 : 1 ≤ card)
    (hcard : card ≤ (2 ^ wc) ^ (n - k)) (hPl : M - Qt ≤ Pl) (hQt : Qt ≤ M) :
    (((M - Qt : ℕ) : ℝ) / M) * ((2 ^ wc : ℕ) : ℝ) ^ k ≤ (Pl : ℝ) / card := by
  have hMpos : (0 : ℝ) < M := by rw [hM]; positivity
  have hcpos : (0 : ℝ) < card := by exact_mod_cast hcard0
  have hsplit : (M : ℝ) = ((2 ^ wc : ℕ) : ℝ) ^ (n - k) * ((2 ^ wc : ℕ) : ℝ) ^ k := by
    rw [← pow_add, Nat.sub_add_cancel hk, hM]; push_cast; ring
  rw [div_mul_eq_mul_div, div_le_div_iff₀ hMpos hcpos]
  have h1 : ((M - Qt : ℕ) : ℝ) ≤ Pl := by exact_mod_cast hPl
  have h2 : (card : ℝ) ≤ ((2 ^ wc : ℕ) : ℝ) ^ (n - k) := by exact_mod_cast hcard
  have h3 : (0 : ℝ) ≤ ((M - Qt : ℕ) : ℝ) := by positivity
  have h4 : (0 : ℝ) ≤ ((2 ^ wc : ℕ) : ℝ) ^ k := by positivity
  calc ((M - Qt : ℕ) : ℝ) * ((2 ^ wc : ℕ) : ℝ) ^ k * card
      ≤ ((M - Qt : ℕ) : ℝ) * ((2 ^ wc : ℕ) : ℝ) ^ k * ((2 ^ wc : ℕ) : ℝ) ^ (n - k) := by
        exact mul_le_mul_of_nonneg_left h2 (mul_nonneg h3 h4)
    _ = ((M - Qt : ℕ) : ℝ) * M := by rw [hsplit]; ring
    _ ≤ Pl * M := mul_le_mul_of_nonneg_right h1 hMpos.le

/-- Bernoulli: `((M − Q)/M)^k ≥ 1/2` when `2·k·Q ≤ M`. -/
theorem pool_pow_ge_half {M Qt k : ℕ} (hM : 0 < M) (h : 2 * k * Qt ≤ M) :
    (1 : ℝ) / 2 ≤ (((M - Qt : ℕ) : ℝ) / M) ^ k := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · norm_num
  have hQt : Qt ≤ M := by nlinarith
  have hMr : (0 : ℝ) < M := by exact_mod_cast hM
  have he : ((M - Qt : ℕ) : ℝ) / M = 1 + (-(Qt : ℝ) / M) := by
    rw [Nat.cast_sub hQt]; field_simp; ring
  rw [he]
  have ha : (-2 : ℝ) ≤ -(Qt : ℝ) / M := by
    rw [le_div_iff₀ hMr]
    have : (Qt : ℝ) ≤ M := by exact_mod_cast hQt
    linarith
  have hb := one_add_mul_le_pow ha k
  have hkq : (k : ℝ) * ((Qt : ℝ) / M) ≤ 1 / 2 := by
    rw [mul_div_assoc', div_le_div_iff₀ hMr (by norm_num)]
    have : ((2 * k * Qt : ℕ) : ℝ) ≤ M := by exact_mod_cast h
    push_cast at this
    linarith
  have : (1 : ℝ) + (k : ℝ) * (-(Qt : ℝ) / M) = 1 - (k : ℝ) * ((Qt : ℝ) / M) := by ring
  linarith

/-- The product of the per-variable lower bounds: `Π (pinned ? c·x^{|J|} : 1) = c^{#pinned} · x^{Σ |J|}`. -/
theorem prod_pin_bound {m : ℕ} (J : ℕ → Finset (Fin n)) (c x : ℝ) :
    ∏ ℓ ∈ Finset.range m, (if (J ℓ).Nonempty then c * x ^ (J ℓ).card else 1) =
      c ^ ((Finset.range m).filter fun ℓ => (J ℓ).Nonempty).card *
        x ^ (∑ ℓ ∈ Finset.range m, (J ℓ).card) := by
  classical
  rw [Finset.prod_ite, Finset.prod_const_one, mul_one, Finset.prod_mul_distrib, Finset.prod_const,
    Finset.prod_pow_eq_pow_sum]
  congr 2
  rw [Finset.sum_filter]
  refine Finset.sum_congr rfl fun ℓ _ => ?_
  split_ifs with h
  · rfl
  · rw [Finset.not_nonempty_iff_eq_empty.1 h, Finset.card_empty]

open Classical in
/-- **`CreditResolvedTyped` from `PinFamily`.** -/
theorem creditResolvedTyped_of_pinFamily (hpf : PinFamily) : CreditResolvedTyped := by
  intro n wc D Q tag G W p hn hpool hb S H
  refine ⟨2 * D * (n * Q) + 4 * n, chainX (splitFam p) tag G W (2 * D) Q, Pool (splitFam p) tag G W (2 * D) Q,
    semPin p tag G W D Q S H,
    fun ℓ ω ω' h => ⟨Pool_eq_of_prefix (bounded_splitFam hb) h, semPin_prefixDet h⟩,
    fibre_chain (bounded_splitFam hb), fun ω hS hH => ?_⟩
  obtain ⟨J, hdet, hfresh, hfew, hcover⟩ := hpf n wc D Q tag G W p hn hpool hb S H ω hS hH
  set m := 2 * D * (n * Q) + 4 * n with hm
  set M := 2 ^ (n * wc) with hMdef
  set Qt := n * (Q + 1) + 2 * n with hQtdef
  set c : ℝ := ((M - Qt : ℕ) : ℝ) / M with hc
  set x : ℝ := ((2 ^ wc : ℕ) : ℝ) with hx
  have hM : M = (2 ^ wc) ^ n := by rw [hMdef, ← pow_mul, mul_comm]
  have hMpos : 0 < M := by positivity
  have hQtM : Qt ≤ M := by
    have : Qt ≤ 64 * n * Qt := by nlinarith
    omega
  have hc0 : 0 ≤ c := by positivity
  have hc1 : c ≤ 1 := by
    rw [hc, div_le_one (by exact_mod_cast hMpos)]
    exact_mod_cast Nat.sub_le M Qt
  have hx1 : 1 ≤ x := by rw [hx]; exact_mod_cast Nat.one_le_two_pow
  have hw : ∀ ℓ ∈ Finset.range m, (if (J ℓ).Nonempty then c * x ^ (J ℓ).card else 1) ≤
      w (chainX (splitFam p) tag G W (2 * D) Q) (Pool (splitFam p) tag G W (2 * D) Q)
        (semPin p tag G W D Q S H) ℓ ω := by
    intro ℓ hℓ
    have hℓm := Finset.mem_range.1 hℓ
    have hmem := mem_semPin_self (ℓ := ℓ) hS hH
    unfold w
    rw [if_pos hmem]
    have hcard0 : 1 ≤ (semPin p tag G W D Q S H ℓ ω).card := Finset.card_pos.2 ⟨_, hmem⟩
    have hcardP : (semPin p tag G W D Q S H ℓ ω).card ≤ Pool (splitFam p) tag G W (2 * D) Q ℓ ω :=
      Finset.card_le_card (semPin_subset_Fr hb ℓ ω)
    split_ifs with hne
    · have hJn : (J ℓ).card ≤ n := (Finset.card_le_univ _).trans (by simp)
      exact weight_pinned hM hJn hcard0 (card_semPin_le (J ℓ) (hdet ℓ hℓm)) (hfresh ℓ hℓm hne) hQtM
    · rw [le_div_iff₀ (by exact_mod_cast hcard0), one_mul]
      exact_mod_cast hcardP
  have hprod : ∏ ℓ ∈ Finset.range m, (if (J ℓ).Nonempty then c * x ^ (J ℓ).card else 1) ≤
      ∏ ℓ ∈ Finset.range m,
        w (chainX (splitFam p) tag G W (2 * D) Q) (Pool (splitFam p) tag G W (2 * D) Q)
          (semPin p tag G W D Q S H) ℓ ω :=
    Finset.prod_le_prod₀ (fun ℓ _ => by split_ifs <;> positivity) hw
  rw [prod_pin_bound] at hprod
  have hcpow : (1 : ℝ) / 2 ≤ c ^ ((Finset.range m).filter fun ℓ => (J ℓ).Nonempty).card := by
    calc (1 : ℝ) / 2 ≤ c ^ (32 * n) := pool_pow_ge_half hMpos (by nlinarith)
      _ ≤ c ^ ((Finset.range m).filter fun ℓ => (J ℓ).Nonempty).card := pow_le_pow_of_le_one hc0 hc1 hfew
  have hbits : (2 ^ luckyBits p ω tag G W D : ℝ) ≤ x ^ (∑ ℓ ∈ Finset.range m, (J ℓ).card) := by
    rw [luckyBits_eq_units, pow_mul]
    have : ((2 : ℝ) ^ wc) = x := by rw [hx]; push_cast; rfl
    rw [this]
    exact pow_le_pow_right₀ hx1 hcover
  have hxpos : 0 ≤ x ^ (∑ ℓ ∈ Finset.range m, (J ℓ).card) := by positivity
  calc (2 ^ luckyBits p ω tag G W D : ℝ) ≤ x ^ (∑ ℓ ∈ Finset.range m, (J ℓ).card) := hbits
    _ = 2 * ((1 / 2) * x ^ (∑ ℓ ∈ Finset.range m, (J ℓ).card)) := by ring
    _ ≤ 2 * (c ^ ((Finset.range m).filter fun ℓ => (J ℓ).Nonempty).card *
          x ^ (∑ ℓ ∈ Finset.range m, (J ℓ).card)) := by
        gcongr
    _ ≤ 2 * ∏ ℓ ∈ Finset.range m,
          w (chainX (splitFam p) tag G W (2 * D) Q) (Pool (splitFam p) tag G W (2 * D) Q)
          (semPin p tag G W D Q S H) ℓ ω := by
        gcongr

/-- **`n10prime` at `10n`, on `okLucky`'s instances, from `PinFamily`.** -/
theorem n10prime_of_pinFamily (h : PinFamily) : N10primeAtIf okLucky posLucky :=
  n10prime_of_creditResolvedTyped (creditResolvedTyped_of_pinFamily h)

end PousAssembly

end


/-! ════ Freshness.LuckyTransfer ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Class transfer: a typed class's members share their honest queries (`credit-resolved.md` §9, toward `ι`)

Two members of the same typed class `(S, H)` that share the split chain's prefix up to the start of round `i` ask the
same queries in rounds `≤ i` (`rounds_take_eq_of_splitPrefix`, `LuckySplit.lean`), so their traces match there
(`trace_getElem?_eq`).

So an honest query first asked at a non-hit slot of `S` is, in the other member, that member's honest query of the same
kind: `transfer_honest`, and `transfer_honest_split` from the split chain's prefix. Every credit's equation therefore holds across the class, which gives `PinFamily`'s "fixed".
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ} {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)}
  {τ : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc} {D Q : ℕ}

/-- Matching trace entries: rounds that agree up to `k` give traces that agree on their first `k` rounds. -/
theorem trace_getElem?_eq {M : IdealModel} {α : Type} {f g : M.Qry → M.Ans} {pr : Prog M α} {k : ℕ}
    (h : (rounds f pr).take k = (rounds g pr).take k) {j : ℕ} (hj : j < ((rounds f pr).take k).flatten.length) :
    (progTrace f pr)[j]? = (progTrace g pr)[j]? := by
  rw [progTrace_eq_flatten, progTrace_eq_flatten, ← List.take_append_drop k (rounds f pr),
    ← List.take_append_drop k (rounds g pr), List.flatten_append, List.flatten_append,
    List.getElem?_append_left hj, List.getElem?_append_left (by rw [← h]; exact hj), h]

/-- The kind of a query's shape: `H` at layer `ℓ` is `ℓ`, forward at layer `ℓ` is `2 + ℓ`, inverse is `4 + ℓ`. -/
def kindOf : (p3ModelT n wc).Qry → ℕ
  | Sum.inl q => q.2.1
  | Sum.inr (Sum.inl ty) => 2 + ty.1.2.1
  | Sum.inr (Sum.inr tz) => 4 + tz.1.2.1

/-- The node of a query's shape. -/
def nodeOf : (p3ModelT n wc).Qry → ℕ
  | Sum.inl q => q.2.2.1
  | Sum.inr (Sum.inl ty) => ty.1.2.2
  | Sum.inr (Sum.inr tz) => tz.1.2.2

theorem kindOf_honestQ (ω : (p3ModelT n wc).Ω) (k : Fin 6) (v : Fin n) :
    kindOf (honestQ τ G W ω (k, v)) = k := by
  fin_cases k <;> rfl

theorem nodeOf_honestQ (ω : (p3ModelT n wc).Ω) (k : Fin 6) (v : Fin n) :
    nodeOf (honestQ τ G W ω (k, v)) = v := by
  fin_cases k <;> rfl

/-- **Honest queries are told apart by shape**: kind and node are read off the query. -/
theorem honestQ_shape {ω ω' : (p3ModelT n wc).Ω} {k k' : Fin 6} {v v' : Fin n}
    (h : honestQ τ G W ω (k, v) = honestQ τ G W ω' (k', v')) : k = k' ∧ v = v' := by
  have hk := congrArg kindOf h
  have hv := congrArg nodeOf h
  rw [kindOf_honestQ, kindOf_honestQ] at hk
  rw [nodeOf_honestQ, nodeOf_honestQ] at hv
  exact ⟨Fin.ext hk, Fin.ext hv⟩

open Classical in
/-- **The slot of an asked query**: the least asker in its first round, and its trace index there. -/
theorem slotOf_spec {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked p ω q r) :
    ∃ c : Fin n, slotOf p ω q = ((c : ℕ), (progTrace ((p3ModelT n wc).answer ω) (p c)).idxOf q) ∧
      q ∈ upTo ((p3ModelT n wc).answer ω) (p c) (firstRound p ω q) := by
  have hne : (askers p ω q (firstRound p ω q)).Nonempty := by
    obtain ⟨c, hc⟩ := asked_firstRound p ω h
    exact ⟨c, by simp [askers, hc]⟩
  refine ⟨(askers p ω q (firstRound p ω q)).min' hne, ?_, (Finset.mem_filter.1 (Finset.min'_mem _ hne)).2⟩
  unfold slotOf
  rw [dif_pos hne]

/-- The trace index of a query in its first rounds is below the length of those rounds. -/
theorem idxOf_lt_upTo {M : IdealModel} {α : Type} [DecidableEq M.Qry] {f : M.Qry → M.Ans} {pr : Prog M α}
    {k : ℕ} {q : M.Qry} (h : q ∈ upTo f pr k) :
    (progTrace f pr).idxOf q < ((rounds f pr).take k).flatten.length := by
  have hsplit : progTrace f pr = upTo f pr k ++ ((rounds f pr).drop k).flatten := by
    rw [progTrace_eq_flatten, upTo, ← List.flatten_append, List.take_append_drop]
  rw [hsplit, List.idxOf_append_of_mem h]
  exact List.idxOf_lt_length_of_mem h

theorem firstRound_pos {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked p ω q r) :
    1 ≤ firstRound p ω q := by
  by_contra hc
  have h0 : firstRound p ω q = 0 := by omega
  have := asked_firstRound p ω h
  rw [h0] at this
  exact not_asked_zero this

theorem asked_D (hb : ∀ c, (p c).Bounded D Q) {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} {r : ℕ}
    (h : Asked p ω q r) : Asked p ω q D := by
  rcases Nat.lt_or_ge r D with hr | hr
  · exact asked_mono hr.le h
  obtain ⟨c, hc⟩ := h
  refine ⟨c, ?_⟩
  have hlen := length_rounds_le (hb c) ω
  unfold upTo at hc ⊢
  rw [List.take_of_length_le (by omega)] at hc
  rwa [List.take_of_length_le hlen]

theorem firstRound_le_D (hb : ∀ c, (p c).Bounded D Q) {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry}
    (h : ∃ r, Asked p ω q r) : firstRound p ω q ≤ D := by
  classical
  obtain ⟨r, hr⟩ := h
  unfold firstRound
  rw [dif_pos ⟨r, hr⟩]
  exact Nat.find_min' _ (asked_D hb hr)

open Classical in
/-- **Transfer.** Let `h`, `ω`'s honest query of kind `(k, v)`, be asked, with its slot not a hit. If another member
`ω''` of the same typed class asks the same queries in rounds `≤` `h`'s first round, then `ω''`'s honest query of kind
`(k, v)` is the same query. -/
theorem transfer_honest (hb : ∀ c, (p c).Bounded D Q) {ω ω'' : (p3ModelT n wc).Ω}
    (hS : luckySet p ω τ G W D Q = luckySet p ω'' τ G W D Q) (hH : hitSlotSet p ω τ G W D = hitSlotSet p ω'' τ G W D)
    {k : Fin 6} {v : Fin n} (hask : ∃ r, Asked p ω (honestQ τ G W ω (k, v)) r)
    (hnohit : slotOf p ω (honestQ τ G W ω (k, v)) ∉ hitSlotSet p ω τ G W D)
    (hrounds : ∀ c, (rounds ((p3ModelT n wc).answer ω) (p c)).take (firstRound p ω (honestQ τ G W ω (k, v))) =
      (rounds ((p3ModelT n wc).answer ω'') (p c)).take (firstRound p ω (honestQ τ G W ω (k, v)))) :
    honestQ τ G W ω'' (k, v) = honestQ τ G W ω (k, v) := by
  set h := honestQ τ G W ω (k, v) with hhdef
  set r := firstRound p ω h with hr
  obtain ⟨c, hslot, hup⟩ := slotOf_spec hask
  have hmem : slotOf p ω h ∈ luckySet p ω'' τ G W D Q := by
    rw [← hS]
    unfold luckySet
    refine Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_image.2 ⟨(k, v), ?_, rfl⟩))
    exact Finset.mem_filter.2 ⟨Finset.mem_univ _, hask⟩
  have hjQ : (progTrace ((p3ModelT n wc).answer ω) (p c)).idxOf h < Q := by
    have h1 := List.idxOf_lt_length_of_mem (mem_progTrace_of_mem_upTo hup)
    rw [progTrace_length] at h1
    exact lt_of_lt_of_le h1 (hb c ω).2
  simp only [luckySet, Finset.mem_union, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and] at hmem
  rcases hmem with (⟨h', hask', heq⟩ | ⟨t, ht, heq⟩) | ⟨c', -, heq⟩
  · obtain ⟨c'', hslot'', hup''⟩ := slotOf_spec hask'
    rw [hslot'', hslot] at heq
    obtain ⟨hcc, hjj⟩ := Prod.mk.inj heq
    have hc : c'' = c := Fin.ext hcc
    subst hc
    have htake := hrounds c''
    have hj := idxOf_lt_upTo hup
    have he := trace_getElem?_eq htake hj
    rw [List.getElem?_eq_getElem (List.idxOf_lt_length_of_mem (mem_progTrace_of_mem_upTo hup)),
      List.getElem_idxOf] at he
    have hlen'' := List.idxOf_lt_length_of_mem (mem_progTrace_of_mem_upTo hup'')
    rw [← hjj, List.getElem?_eq_getElem hlen'', List.getElem_idxOf] at he
    have hq := Option.some_inj.1 he
    obtain ⟨hk, hv⟩ := honestQ_shape hq
    rw [hq, hk, hv]
  · exfalso
    refine hnohit ?_
    rw [hH]
    unfold hitSlotSet
    exact Finset.mem_image.2 ⟨t, ht, heq⟩
  · exfalso
    rw [hslot] at heq
    have := congrArg Prod.snd heq
    simp only at this
    omega

/-- **Transfer from the split chain's prefix** at the start of `h`'s first round. -/
theorem transfer_honest_split (hb : ∀ c, (p c).Bounded D Q) {ω ω'' : (p3ModelT n wc).Ω}
    (hS : luckySet p ω τ G W D Q = luckySet p ω'' τ G W D Q) (hH : hitSlotSet p ω τ G W D = hitSlotSet p ω'' τ G W D)
    {k : Fin 6} {v : Fin n} (hask : ∃ r, Asked p ω (honestQ τ G W ω (k, v)) r)
    (hnohit : slotOf p ω (honestQ τ G W ω (k, v)) ∉ hitSlotSet p ω τ G W D)
    (hpre : PousLuckyChain.PrefixEq (chainX (splitFam p) τ G W (2 * D) Q)
      ((2 * (firstRound p ω (honestQ τ G W ω (k, v)) - 1)) * (n * Q)) ω ω'') :
    honestQ τ G W ω'' (k, v) = honestQ τ G W ω (k, v) := by
  refine transfer_honest hb hS hH hask hnohit fun c => ?_
  have h1 := firstRound_pos hask
  have hD := firstRound_le_D hb hask
  have := rounds_take_eq_of_splitPrefix hb (by omega) hpre c
  rwa [Nat.sub_add_cancel h1] at this

end PousKnowledge

end


/-! ════ Freshness.LuckyReal ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Realizations on the split chain, and the type facts E10 (`credit-resolved.md` §11.1, §11.7)

- `fA ω q`: the first chain index whose query is `q`. It lies in the half-round of `q`'s first ask
  (`fA_bounds`). On the split chain, a non-inverse query first asked in round `r` lands in half-round `2r − 2`, and an
  inverse one in half-round `2r − 1` (`fA_split_fwd`, `fA_split_inv`).
- The types of a pair: `TypF` (`qP` first, same-round inverse later), `TypI` (`qI` strictly first), `TypY`
  (neither asked). Exactly one holds (`typ_cases`).
- **E10**: a credited lower key has type F (`typF1_of_lowerKey`); a credited output has type Y (`typY2_of_output`); the
  first ask of `qP2 u` with `u` outside the game (rules T3, KT and C3) has type F (`typF2_of_qP2`).
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ}

/-! ### Chain indices of queries -/

section Chain

variable {pc : Fin n → Prog (p3ModelT n wc) (Lab n wc)} {Dc Q : ℕ}

theorem qIdx_encA {i : ℕ} (c : Fin n) {j : ℕ} (hi : i < Dc) (hj : j < Q) (ω : (p3ModelT n wc).Ω) :
    qIdx pc Dc Q ω (encA n Q i c j) = qAt pc ω i c j := by
  have hlt := encA_lt (D := Dc) c hi hj
  unfold qIdx
  rw [dif_pos hlt]
  have hdiv := encA_div (i := i) c hj
  have hmod := encA_mod (i := i) c hj
  have hQpos : 0 < Q := by omega
  have hc : (c * Q + j) / Q = c := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hQpos, Nat.div_eq_of_lt hj, zero_add]
  have hj' : encA n Q i c j % Q = j := by
    unfold encA
    rw [Nat.add_mod, Nat.add_mod (i * (n * Q)), show i * (n * Q) = (i * n) * Q by ring, Nat.mul_mod_left,
      Nat.mul_mod_left, Nat.mod_eq_of_lt hj]
    simp [Nat.mod_eq_of_lt hj]
  have hfin : (⟨encA n Q i c j % (n * Q) / Q, partA_c_lt Dc Q hlt⟩ : Fin n) = c := by
    ext; simp only [hmod, hc]
  rw [hdiv, hfin, hj']

theorem qIdx_some {ω : (p3ModelT n wc).Ω} {ℓ : ℕ} {q : (p3ModelT n wc).Qry} (h : qIdx pc Dc Q ω ℓ = some q) :
    ∃ i c j, i < Dc ∧ j < Q ∧ ℓ = encA n Q i c j ∧ qAt pc ω i c j = some q := by
  unfold qIdx at h
  split_ifs at h with hl
  exact ⟨_, _, _, decode_lt Dc Q hl, mod_Q_lt Dc Q hl, (encA_decode Dc Q hl).symm, h⟩

theorem mem_upTo_of_qAt {ω : (p3ModelT n wc).Ω} {i : ℕ} {c : Fin n} {j : ℕ} {q : (p3ModelT n wc).Qry}
    (h : qAt pc ω i c j = some q) : q ∈ upTo ((p3ModelT n wc).answer ω) (pc c) (i + 1) :=
  (mem_upTo_iff _ _ _ q).2 ⟨i, Nat.lt_succ_self i, j, h⟩

theorem exists_qAt_of_mem_upTo (hb : ∀ c, (pc c).Bounded Dc Q) {ω : (p3ModelT n wc).Ω} {c : Fin n} {t : ℕ}
    {q : (p3ModelT n wc).Qry} (h : q ∈ upTo ((p3ModelT n wc).answer ω) (pc c) t) :
    ∃ i < t, ∃ j < Q, i < Dc ∧ qAt pc ω i c j = some q := by
  obtain ⟨i, hi, j, hj⟩ := (mem_upTo_iff _ _ _ q).1 h
  have hq : qAt pc ω i c j = some q := hj
  have hjQ : j < Q := by
    by_contra hc
    rw [qAt_eq_none_of_ge pc hb ω i c (by omega)] at hq
    cases hq
  have hiD : i < Dc := by
    by_contra hc
    have hlen : (rounds ((p3ModelT n wc).answer ω) (pc c)).length ≤ i := by
      have := length_rounds_le (hb c) ω
      omega
    unfold qAt at hq
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hlen] at hq
    simp at hq
  exact ⟨i, hi, j, hjQ, hiD, hq⟩

open Classical in
/-- **The first chain index asking `q`** (`0` if none). -/
noncomputable def fA (pc : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (Dc Q : ℕ) (ω : (p3ModelT n wc).Ω)
    (q : (p3ModelT n wc).Qry) : ℕ :=
  if h : ∃ ℓ, qIdx pc Dc Q ω ℓ = some q then Nat.find h else 0

theorem qIdx_fA {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} (h : ∃ ℓ, qIdx pc Dc Q ω ℓ = some q) :
    qIdx pc Dc Q ω (fA pc Dc Q ω q) = some q := by
  classical
  unfold fA
  rw [dif_pos h]
  exact Nat.find_spec h

theorem fA_le {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} {ℓ : ℕ} (h : qIdx pc Dc Q ω ℓ = some q) :
    fA pc Dc Q ω q ≤ ℓ := by
  classical
  unfold fA
  rw [dif_pos ⟨ℓ, h⟩]
  exact Nat.find_min' _ h

theorem not_qIdx_of_lt_fA {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} {ℓ : ℕ}
    (h : ℓ < fA pc Dc Q ω q) : qIdx pc Dc Q ω ℓ ≠ some q := fun h' => absurd (fA_le h') (by omega)

/-- A query is on the chain iff it is asked. -/
theorem exists_qIdx_iff (hb : ∀ c, (pc c).Bounded Dc Q) {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} :
    (∃ ℓ, qIdx pc Dc Q ω ℓ = some q) ↔ ∃ r, Asked pc ω q r := by
  constructor
  · rintro ⟨ℓ, h⟩
    obtain ⟨i, c, j, -, -, -, hq⟩ := qIdx_some h
    exact ⟨i + 1, c, mem_upTo_of_qAt hq⟩
  · rintro ⟨r, c, hc⟩
    obtain ⟨i, -, j, hj, hi, hq⟩ := exists_qAt_of_mem_upTo hb hc
    exact ⟨_, (qIdx_encA c hi hj ω).trans hq⟩

/-- **The first chain occurrence lies in the round of the first ask.** -/
theorem fA_bounds (hb : ∀ c, (pc c).Bounded Dc Q) {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} {h : ℕ}
    (hf : FirstAt pc ω q h) : (h - 1) * (n * Q) ≤ fA pc Dc Q ω q ∧ fA pc Dc Q ω q < h * (n * Q) := by
  obtain ⟨c, hc⟩ := hf.1
  obtain ⟨i, hih, j, hj, hi, hq⟩ := exists_qAt_of_mem_upTo hb hc
  have hex : ∃ ℓ, qIdx pc Dc Q ω ℓ = some q := ⟨_, (qIdx_encA c hi hj ω).trans hq⟩
  constructor
  · obtain ⟨i', c', j', -, -, he, hq'⟩ := qIdx_some (qIdx_fA hex)
    have hask : Asked pc ω q (i' + 1) := ⟨c', mem_upTo_of_qAt hq'⟩
    have hi' : h - 1 ≤ i' := by
      by_contra hlt
      exact hf.2 (asked_mono (by omega) hask)
    rw [he]
    unfold encA
    have := Nat.mul_le_mul_right (n * Q) hi'
    omega
  · have hle := fA_le ((qIdx_encA c hi hj ω).trans hq)
    have hlt : encA n Q i c j < (i + 1) * (n * Q) := by
      have hc' : (c : ℕ) * Q + j < n * Q := by
        have h1 : (c : ℕ) + 1 ≤ n := c.isLt
        calc (c : ℕ) * Q + j < (c : ℕ) * Q + Q := by omega
          _ = ((c : ℕ) + 1) * Q := by ring
          _ ≤ n * Q := Nat.mul_le_mul_right _ h1
      unfold encA; nlinarith
    have := Nat.mul_le_mul_right (n * Q) (show i + 1 ≤ h by omega)
    omega

end Chain

/-! ### On the split chain -/

section Split

variable {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)} {D Q : ℕ}

/-- A non-inverse query first asked in round `r` is first on the split chain in half-round `2r − 2`. -/
theorem fA_split_fwd (hb : ∀ c, (p c).Bounded D Q) {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} {r : ℕ}
    (hq : isInvQ q = false) (hf : FirstAt p ω q r) :
    (2 * (r - 1)) * (n * Q) ≤ fA (splitFam p) (2 * D) Q ω q ∧
      fA (splitFam p) (2 * D) Q ω q < (2 * (r - 1) + 1) * (n * Q) := by
  have hr := one_le_of_firstAt p ω hf
  have hf' := (firstAt_splitFam_odd (p := p) hq (r - 1)).2 (by rwa [show r - 1 + 1 = r by omega])
  have := fA_bounds (bounded_splitFam hb) hf'
  simpa using this

/-- An inverse query first asked in round `r` is first on the split chain in half-round `2r − 1`. -/
theorem fA_split_inv (hb : ∀ c, (p c).Bounded D Q) {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} {r : ℕ}
    (hq : isInvQ q = true) (hf : FirstAt p ω q r) :
    (2 * (r - 1) + 1) * (n * Q) ≤ fA (splitFam p) (2 * D) Q ω q ∧
      fA (splitFam p) (2 * D) Q ω q < (2 * (r - 1) + 2) * (n * Q) := by
  have hr := one_le_of_firstAt p ω hf
  have hf' := (firstAt_splitFam_inv (p := p) hq (r - 1)).2 (by rwa [show r - 1 + 1 = r by omega])
  have := fA_bounds (bounded_splitFam hb) hf'
  rw [show 2 * (r - 1 + 1) - 1 = 2 * (r - 1) + 1 by omega, show 2 * (r - 1 + 1) = 2 * (r - 1) + 2 by omega] at this
  exact this

end Split

/-! ### Types of a pair, and E10 -/

section Types

variable (ps : Fin n → Prog (p3ModelT n wc) (Lab n wc)) (ω : (p3ModelT n wc).Ω)
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc)

theorem firstRound_eq {q : (p3ModelT n wc).Qry} {r : ℕ} (h : FirstAt ps ω q r) : firstRound ps ω q = r := by
  classical
  have hex : ∃ r, Asked ps ω q r := ⟨r, h.1⟩
  have hfr := asked_firstRound ps ω hex
  have hle : firstRound ps ω q ≤ r := by
    unfold firstRound; rw [dif_pos hex]; exact Nat.find_min' _ h.1
  by_contra hne
  exact h.2 (asked_mono (by omega) hfr)

/-- Type F: the forward query is asked, in a round no later than every round asking the inverse query. -/
def TypF (qP qI : (p3ModelT n wc).Qry) : Prop :=
  (∃ r, Asked ps ω qP r) ∧ ((∃ r, Asked ps ω qI r) → firstRound ps ω qP ≤ firstRound ps ω qI)

/-- Type I: the inverse query is asked, in a round strictly before every round asking the forward query. -/
def TypI (qP qI : (p3ModelT n wc).Qry) : Prop :=
  (∃ r, Asked ps ω qI r) ∧ ((∃ r, Asked ps ω qP r) → firstRound ps ω qI < firstRound ps ω qP)

/-- Type Y: neither is asked. -/
def TypY (qP qI : (p3ModelT n wc).Qry) : Prop := ¬ (∃ r, Asked ps ω qP r) ∧ ¬ (∃ r, Asked ps ω qI r)

theorem typ_cases (qP qI : (p3ModelT n wc).Qry) :
    TypF ps ω qP qI ∨ TypI ps ω qP qI ∨ TypY ps ω qP qI := by
  by_cases hP : ∃ r, Asked ps ω qP r <;> by_cases hI : ∃ r, Asked ps ω qI r
  · rcases Nat.lt_or_ge (firstRound ps ω qI) (firstRound ps ω qP) with h | h
    · exact Or.inr (Or.inl ⟨hI, fun _ => h⟩)
    · exact Or.inl ⟨hP, fun _ => h⟩
  · exact Or.inl ⟨hP, fun h => absurd h hI⟩
  · exact Or.inr (Or.inl ⟨hI, fun h => absurd h hP⟩)
  · exact Or.inr (Or.inr ⟨hP, hI⟩)

theorem not_typF_typI (qP qI : (p3ModelT n wc).Qry) : ¬ (TypF ps ω qP qI ∧ TypI ps ω qP qI) := by
  rintro ⟨⟨hP, hF⟩, ⟨hI, hI'⟩⟩
  have := hF hI
  have := hI' hP
  omega

/-- **E10, a lower key.** A lower key credited in round `r + 1` has type F: `qI1 w` asked earlier would make `w`
whole. -/
theorem typF1_of_lowerKey {r : ℕ} {w : Fin n}
    (h : w ∈ (roundCred ps ω τ G W (Cg ps ω τ G W r) (r + 1)).lowerKey) :
    TypF ps ω (qP1 τ G W ω w) (qI1 τ G W ω w) := by
  simp only [roundCred, Finset.mem_filter, Finset.mem_univ, true_and] at h
  obtain ⟨hf, hw, -⟩ := h
  refine ⟨⟨_, hf.1⟩, fun hI => ?_⟩
  rw [firstRound_eq ps ω hf]
  by_contra hlt
  have hask := asked_mono (by omega : firstRound ps ω (qI1 τ G W ω w) ≤ r) (asked_firstRound ps ω hI)
  exact hw (lowerWhole_of_asked_qI1 ps ω τ G W hask)

/-- **E10, the `qP2` rules.** The first ask of `qP2 u` in round `r + 1` with `u` outside the game has type F: `qI2 u`
asked earlier would put `u` in the game. This covers T3, KT and C3. -/
theorem typF2_of_qP2 {r : ℕ} {u : Fin n} (hf : FirstAt ps ω (qP2 τ G W ω u) (r + 1))
    (hu : u ∉ (timedReachK G (Cg ps ω τ G W r) r).topWhole) :
    TypF ps ω (qP2 τ G W ω u) (qI2 τ G W ω u) := by
  refine ⟨⟨_, hf.1⟩, fun hI => ?_⟩
  rw [firstRound_eq ps ω hf]
  by_contra hlt
  have hask := asked_mono (by omega : firstRound ps ω (qI2 τ G W ω u) ≤ r) (asked_firstRound ps ω hI)
  exact hu (topWhole_of_asked_qI2 ps ω τ G W hask)

/-- **E10, an output.** A credited output has type Y: `qP2 u` or `qI2 u` asked would put `u` in the game at `D`. -/
theorem typY2_of_output {D Q : ℕ} (hb : ∀ c, (ps c).Bounded D Q) {u : Fin n}
    (hu : u ∉ (timedReachK G (Cg ps ω τ G W D) D).topWhole) :
    TypY ps ω (qP2 τ G W ω u) (qI2 τ G W ω u) := by
  refine ⟨fun ⟨r, hr⟩ => hu (topWhole_of_asked_qP2 ps ω τ G W (asked_D hb hr)),
    fun ⟨r, hr⟩ => hu (topWhole_of_asked_qI2 ps ω τ G W (asked_D hb hr))⟩

end Types

end PousKnowledge

end


/-! ════ Freshness.LuckyFresh ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Freshness of the realization variables (`credit-resolved.md` §11.1)

A realization samples a point nothing earlier has touched, so its pool is at least `M − n·Q`:
- `card_knownPairs_le`: at most `n·Q` (query, answer) pairs are known at any index, since the programs ask at most
  `n·Q` queries in all.
- `pool_fresh_H`, `pool_fresh_fwd`, `pool_fresh_inv` (Part A): the first chain occurrence of an `H` query, or of a
  `P_t` query whose partner query (the one touching the same pair) has not been asked before it.
- `pool_fresh_K1`, `pool_fresh_Y1`, `pool_fresh_K2`, `pool_fresh_Y2` (Part B): an honest source whose queries
  were never asked in Part A.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ} {pc : Fin n → Prog (p3ModelT n wc) (Lab n wc)}
  {τ : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc} {Dc Q : ℕ}

/-! ### At most `n·Q` known pairs -/

theorem card_knownPairs_le (hb : ∀ c, (pc c).Bounded Dc Q) (ω : (p3ModelT n wc).Ω) (ℓ : ℕ) :
    (knownPairs pc τ G W Dc Q ω ℓ).card ≤ n * Q := by
  classical
  have hsub : knownPairs pc τ G W Dc Q ω ℓ ⊆ Finset.univ.biUnion fun c : Fin n =>
      ((progTrace ((p3ModelT n wc).answer ω) (pc c)).toFinset).image fun q => (q, (p3ModelT n wc).answer ω q) := by
    rintro ⟨q, a⟩ hqa
    obtain ⟨ha, ℓ', -, hq⟩ := mem_knownPairs hqa
    obtain ⟨i, c, j, -, -, -, hq'⟩ := qIdx_some hq
    refine Finset.mem_biUnion.2 ⟨c, Finset.mem_univ _, Finset.mem_image.2 ⟨q, ?_, by rw [ha]⟩⟩
    exact List.mem_toFinset.2 (mem_progTrace_of_mem_upTo (mem_upTo_of_qAt hq'))
  refine (Finset.card_le_card hsub).trans (Finset.card_biUnion_le.trans ?_)
  calc _ ≤ ∑ _c : Fin n, Q := Finset.sum_le_sum fun c _ => by
        refine Finset.card_image_le.trans ((List.toFinset_card_le _).trans ?_)
        rw [progTrace_length]
        exact (hb c ω).2
    _ = n * Q := by simp

theorem card_knownIO_le (K : Finset ((p3ModelT n wc).Qry × Lab n wc)) (t : Tweak n) :
    (knownIO K t).card ≤ K.card := by
  classical
  unfold knownIO
  refine Finset.card_biUnion_le.trans ((Finset.sum_le_sum fun qa _ => ?_).trans (by simp : ∑ _qa ∈ K, 1 ≤ K.card))
  rcases qa with ⟨q, a⟩
  rcases q with h | ty | tz
  · simp
  · dsimp only; split_ifs <;> simp
  · dsimp only; split_ifs <;> simp

/-- A known pair of `P_t` comes from a forward or an inverse query. -/
theorem mem_knownIO_cases {K : Finset ((p3ModelT n wc).Qry × Lab n wc)} {t : Tweak n} {io : Lab n wc × Lab n wc}
    (h : io ∈ knownIO K t) :
    ((Sum.inr (Sum.inl (t, io.1)) : (p3ModelT n wc).Qry), io.2) ∈ K ∨
      ((Sum.inr (Sum.inr (t, io.2)) : (p3ModelT n wc).Qry), io.1) ∈ K := by
  classical
  unfold knownIO at h
  obtain ⟨⟨q, a⟩, hqa, hm⟩ := Finset.mem_biUnion.1 h
  rcases q with hq | ty | tz
  · simp at hm
  · simp only at hm
    split_ifs at hm with ht
    · rw [Finset.mem_singleton] at hm
      subst hm ht
      exact Or.inl hqa
    · simp at hm
  · simp only at hm
    split_ifs at hm with ht
    · rw [Finset.mem_singleton] at hm
      subst hm ht
      exact Or.inr hqa
    · simp at hm

/-! ### Free sets of a fresh query -/

theorem card_lab : Fintype.card (Lab n wc) = 2 ^ (n * wc) := by
  rw [Fintype.card_fun, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin, Fintype.card_fin, ← pow_mul,
    mul_comm]

theorem card_freeOf_H (K : Finset ((p3ModelT n wc).Qry × Lab n wc)) (h : KQ' n wc)
    (hK : ∀ qa ∈ K, qa.1 ≠ Sum.inl h) : (freeOf K (Sum.inl h)).card = 2 ^ (n * wc) := by
  classical
  have he : knownHAt K h = ∅ := by
    unfold knownHAt
    rw [Finset.image_eq_empty, Finset.filter_eq_empty_iff]
    exact fun qa hqa => hK qa hqa
  show (if (knownHAt K h).Nonempty then knownHAt K h else Finset.univ).card = _
  rw [he, if_neg Finset.not_nonempty_empty, Finset.card_univ, card_lab]

theorem card_freeOf_fwd (K : Finset ((p3ModelT n wc).Qry × Lab n wc)) (t : Tweak n) (x : Lab n wc)
    (hK : ∀ io ∈ knownIO K t, io.1 ≠ x) :
    2 ^ (n * wc) - K.card ≤ (freeOf K (Sum.inr (Sum.inl (t, x)))).card := by
  classical
  have he : ((knownIO K t).filter fun io => io.1 = x) = ∅ :=
    Finset.filter_eq_empty_iff.2 fun io hio => hK io hio
  unfold freeOf
  dsimp only
  rw [he, if_neg Finset.not_nonempty_empty, Finset.card_sdiff_of_subset (Finset.subset_univ _), Finset.card_univ,
    card_lab]
  have := (Finset.card_image_le (s := knownIO K t) (f := Prod.snd)).trans (card_knownIO_le K t)
  omega

theorem card_freeOf_inv (K : Finset ((p3ModelT n wc).Qry × Lab n wc)) (t : Tweak n) (y : Lab n wc)
    (hK : ∀ io ∈ knownIO K t, io.2 ≠ y) :
    2 ^ (n * wc) - K.card ≤ (freeOf K (Sum.inr (Sum.inr (t, y)))).card := by
  classical
  have he : ((knownIO K t).filter fun io => io.2 = y) = ∅ :=
    Finset.filter_eq_empty_iff.2 fun io hio => hK io hio
  unfold freeOf
  dsimp only
  rw [he, if_neg Finset.not_nonempty_empty, Finset.card_sdiff_of_subset (Finset.subset_univ _), Finset.card_univ,
    card_lab]
  have := (Finset.card_image_le (s := knownIO K t) (f := Prod.fst)).trans (card_knownIO_le K t)
  omega

/-! ### Pools of Part A realizations -/

theorem Fr_partA {ℓ : ℕ} (hA : ℓ < Dc * (n * Q)) {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry}
    (hq : qIdx pc Dc Q ω ℓ = some q) : Fr pc τ G W Dc Q ℓ ω = freeOf (knownPairs pc τ G W Dc Q ω ℓ) q := by
  unfold Fr
  rw [if_pos hA, hq]

/-- **The first ask of an `H` point is fresh**: its pool is all of `Lab`. -/
theorem pool_fresh_H {ℓ : ℕ} (hA : ℓ < Dc * (n * Q)) {ω : (p3ModelT n wc).Ω} {h : KQ' n wc}
    (hq : qIdx pc Dc Q ω ℓ = some (Sum.inl h)) (hfirst : ∀ ℓ' < ℓ, qIdx pc Dc Q ω ℓ' ≠ some (Sum.inl h)) :
    Pool pc τ G W Dc Q ℓ ω = 2 ^ (n * wc) := by
  unfold Pool
  rw [Fr_partA hA hq]
  refine card_freeOf_H _ h fun qa hqa he => ?_
  obtain ⟨q, a⟩ := qa
  obtain ⟨-, ℓ', hℓ', hq'⟩ := mem_knownPairs hqa
  simp only at he
  subst he
  exact hfirst ℓ' hℓ' hq'

/-- **A forward query is fresh** at its first occurrence if its partner inverse query was not asked before. -/
theorem pool_fresh_fwd (hb : ∀ c, (pc c).Bounded Dc Q) {ℓ : ℕ} (hA : ℓ < Dc * (n * Q))
    {ω : (p3ModelT n wc).Ω} {t : Tweak n} {x : Lab n wc}
    (hq : qIdx pc Dc Q ω ℓ = some (Sum.inr (Sum.inl (t, x))))
    (hfirst : ∀ ℓ' < ℓ, qIdx pc Dc Q ω ℓ' ≠ some (Sum.inr (Sum.inl (t, x))))
    (hpart : ∀ ℓ' < ℓ, qIdx pc Dc Q ω ℓ' ≠ some (Sum.inr (Sum.inr (t, ω.2 t x)))) :
    2 ^ (n * wc) - n * Q ≤ Pool pc τ G W Dc Q ℓ ω := by
  unfold Pool
  rw [Fr_partA hA hq]
  refine le_trans ?_ (card_freeOf_fwd _ t x fun io hio he => ?_)
  · have := card_knownPairs_le (τ := τ) (G := G) (W := W) hb ω ℓ
    omega
  · rcases mem_knownIO_cases hio with h | h
    · obtain ⟨-, ℓ', hℓ', hq'⟩ := mem_knownPairs h
      rw [he] at hq'
      exact hfirst ℓ' hℓ' hq'
    · obtain ⟨ha, ℓ', hℓ', hq'⟩ := mem_knownPairs h
      have hy : io.2 = ω.2 t x := by
        rw [← he, ha]
        exact (Equiv.apply_symm_apply _ _).symm
      rw [hy] at hq'
      exact hpart ℓ' hℓ' hq'

/-- **An inverse query is fresh** at its first occurrence if its partner forward query was not asked before. -/
theorem pool_fresh_inv (hb : ∀ c, (pc c).Bounded Dc Q) {ℓ : ℕ} (hA : ℓ < Dc * (n * Q))
    {ω : (p3ModelT n wc).Ω} {t : Tweak n} {y : Lab n wc}
    (hq : qIdx pc Dc Q ω ℓ = some (Sum.inr (Sum.inr (t, y))))
    (hfirst : ∀ ℓ' < ℓ, qIdx pc Dc Q ω ℓ' ≠ some (Sum.inr (Sum.inr (t, y))))
    (hpart : ∀ ℓ' < ℓ, qIdx pc Dc Q ω ℓ' ≠ some (Sum.inr (Sum.inl (t, (ω.2 t).symm y)))) :
    2 ^ (n * wc) - n * Q ≤ Pool pc τ G W Dc Q ℓ ω := by
  unfold Pool
  rw [Fr_partA hA hq]
  refine le_trans ?_ (card_freeOf_inv _ t y fun io hio he => ?_)
  · have := card_knownPairs_le (τ := τ) (G := G) (W := W) hb ω ℓ
    omega
  · rcases mem_knownIO_cases hio with h | h
    · obtain ⟨ha, ℓ', hℓ', hq'⟩ := mem_knownPairs h
      have hx : io.1 = (ω.2 t).symm y := by
        rw [← he, ha]
        exact (Equiv.symm_apply_apply _ _).symm
      rw [hx] at hq'
      exact hpart ℓ' hℓ' hq'
    · obtain ⟨-, ℓ', hℓ', hq'⟩ := mem_knownPairs h
      rw [he] at hq'
      exact hfirst ℓ' hℓ' hq'

/-! ### Pools of Part B realizations -/

theorem pool_fresh_K1 (w : Fin n) {ω : (p3ModelT n wc).Ω}
    (hno : ∀ ℓ' < Dc * (n * Q), qIdx pc Dc Q ω ℓ' ≠ some (Sum.inl (hk1 τ G W ω w))) :
    Pool pc τ G W Dc Q (Dc * (n * Q) + 2 * w) ω = 2 ^ (n * wc) := by
  unfold Pool Fr
  rw [if_neg (by omega), dif_pos (by omega), if_pos (by omega)]
  have hv : (⟨(Dc * (n * Q) + 2 * (w : ℕ) - Dc * (n * Q)) / 2, by omega⟩ : Fin n) = w := Fin.ext (by simp)
  rw [hv]
  refine card_freeOf_H _ _ fun qa hqa he => ?_
  obtain ⟨q, a⟩ := qa
  obtain ⟨-, ℓ', hℓ', hq'⟩ := mem_knownPairs hqa
  simp only at he
  subst he
  exact hno ℓ' hℓ' hq'

theorem pool_fresh_K2 (u : Fin n) {ω : (p3ModelT n wc).Ω}
    (hno : ∀ ℓ' < Dc * (n * Q), qIdx pc Dc Q ω ℓ' ≠ some (Sum.inl (hk2 τ G W ω u))) :
    Pool pc τ G W Dc Q (Dc * (n * Q) + (2 * n + 2 * u)) ω = 2 ^ (n * wc) := by
  unfold Pool Fr
  rw [if_neg (by omega), dif_neg (by omega), dif_pos (by omega), if_pos (by omega)]
  have hv : (⟨(Dc * (n * Q) + (2 * n + 2 * (u : ℕ)) - Dc * (n * Q) - 2 * n) / 2, by omega⟩ : Fin n) = u :=
    Fin.ext (by simp <;> omega)
  rw [hv]
  refine card_freeOf_H _ _ fun qa hqa he => ?_
  obtain ⟨q, a⟩ := qa
  obtain ⟨-, ℓ', hℓ', hq'⟩ := mem_knownPairs hqa
  simp only at he
  subst he
  exact hno ℓ' hℓ' hq'

theorem pool_fresh_Y1 (hb : ∀ c, (pc c).Bounded Dc Q) (w : Fin n) {ω : (p3ModelT n wc).Ω}
    (hnoP : ∀ ℓ' < Dc * (n * Q), qIdx pc Dc Q ω ℓ' ≠ some (qP1 τ G W ω w))
    (hnoI : ∀ ℓ' < Dc * (n * Q), qIdx pc Dc Q ω ℓ' ≠ some (qI1 τ G W ω w)) :
    2 ^ (n * wc) - n * Q ≤ Pool pc τ G W Dc Q (Dc * (n * Q) + (2 * w + 1)) ω := by
  unfold Pool Fr
  rw [if_neg (by omega), dif_pos (by omega), if_neg (by omega)]
  have hv : (⟨(Dc * (n * Q) + (2 * (w : ℕ) + 1) - Dc * (n * Q)) / 2, by omega⟩ : Fin n) = w :=
    Fin.ext (by simp <;> omega)
  rw [hv]
  refine le_trans ?_ (card_freeOf_fwd _ (τ, 0, w) (in1 τ G W ω w) fun io hio he => ?_)
  · have := card_knownPairs_le (τ := τ) (G := G) (W := W) hb ω (Dc * (n * Q))
    omega
  · rcases mem_knownIO_cases hio with h | h
    · obtain ⟨-, ℓ', hℓ', hq'⟩ := mem_knownPairs h
      rw [he] at hq'
      exact hnoP ℓ' hℓ' hq'
    · obtain ⟨ha, ℓ', hℓ', hq'⟩ := mem_knownPairs h
      have hy : io.2 = c1 τ G W ω w := by
        rw [c1_eq, ← he, ha]
        exact (Equiv.apply_symm_apply _ _).symm
      rw [hy] at hq'
      exact hnoI ℓ' hℓ' hq'

theorem pool_fresh_Y2 (hb : ∀ c, (pc c).Bounded Dc Q) (u : Fin n) {ω : (p3ModelT n wc).Ω}
    (hnoP : ∀ ℓ' < Dc * (n * Q), qIdx pc Dc Q ω ℓ' ≠ some (qP2 τ G W ω u))
    (hnoI : ∀ ℓ' < Dc * (n * Q), qIdx pc Dc Q ω ℓ' ≠ some (qI2 τ G W ω u)) :
    2 ^ (n * wc) - n * Q ≤ Pool pc τ G W Dc Q (Dc * (n * Q) + (2 * n + 2 * u + 1)) ω := by
  unfold Pool Fr
  rw [if_neg (by omega), dif_neg (by omega), dif_pos (by omega), if_neg (by omega)]
  have hv : (⟨(Dc * (n * Q) + (2 * n + 2 * (u : ℕ) + 1) - Dc * (n * Q) - 2 * n) / 2, by omega⟩ : Fin n) = u :=
    Fin.ext (by simp <;> omega)
  rw [hv]
  refine le_trans ?_ (card_freeOf_fwd _ (τ, 1, u) (in2 τ G W ω u) fun io hio he => ?_)
  · have := card_knownPairs_le (τ := τ) (G := G) (W := W) hb ω (Dc * (n * Q))
    omega
  · rcases mem_knownIO_cases hio with h | h
    · obtain ⟨-, ℓ', hℓ', hq'⟩ := mem_knownPairs h
      rw [he] at hq'
      exact hnoP ℓ' hℓ' hq'
    · obtain ⟨ha, ℓ', hℓ', hq'⟩ := mem_knownPairs h
      have hy : io.2 = c2 τ G W ω u := by
        rw [c2_eq, ← he, ha]
        exact (Equiv.apply_symm_apply _ _).symm
      rw [hy] at hq'
      exact hnoI ℓ' hℓ' hq'

end PousKnowledge

end


/-! ════ Freshness.LuckyTransfer2 ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Class transfer for hits and outputs (`credit-resolved.md` §11.3)

- `slot_transfer`: two members that ask the same queries through the first round of `q`, and whose asked queries `q`,
  `q''` have the same slot, ask the same query there. `transfer_honest` is its honest-query case.
- **Hits** (`transfer_hit`, `hit_answer_eq`): a member of `ω`'s hit class that shares the rounds through a hit's round
  has the same hit, with the same forward query `P_t(z₀_t)`, so its answer there is its own honest input `x_t`.
- **Outputs** (`transfer_output`, `c2_eq_of_output`): a member of `ω`'s class credits the same outputs. A member that
  shares the whole of Part A has the same runs, so the credited tops' labels are fixed from index `2D·n·Q` on.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ} {p : Fin n → Prog (p3ModelT n wc) (Lab n wc)}
  {τ : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc} {D Q : ℕ}

open Classical in
theorem slotOf_snd_lt (hb : ∀ c, (p c).Bounded D Q) {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry}
    (h : ∃ r, Asked p ω q r) : (slotOf p ω q).2 < Q := by
  obtain ⟨c, hslot, hup⟩ := slotOf_spec h
  rw [hslot]
  have h1 := List.idxOf_lt_length_of_mem (mem_progTrace_of_mem_upTo hup)
  rw [progTrace_length] at h1
  exact lt_of_lt_of_le h1 (hb c ω).2

open Classical in
/-- **Slot transfer.** Same rounds through `q`'s first round, same slot: same query. -/
theorem slot_transfer {ω ω'' : (p3ModelT n wc).Ω} {q q'' : (p3ModelT n wc).Qry} (hq : ∃ r, Asked p ω q r)
    (hq'' : ∃ r, Asked p ω'' q'' r) (hs : slotOf p ω'' q'' = slotOf p ω q)
    (hrounds : ∀ c, (rounds ((p3ModelT n wc).answer ω) (p c)).take (firstRound p ω q) =
      (rounds ((p3ModelT n wc).answer ω'') (p c)).take (firstRound p ω q)) : q'' = q := by
  obtain ⟨c, hslot, hup⟩ := slotOf_spec hq
  obtain ⟨c'', hslot'', hup''⟩ := slotOf_spec hq''
  rw [hslot'', hslot] at hs
  obtain ⟨hcc, hjj⟩ := Prod.mk.inj hs
  have hc : c'' = c := Fin.ext hcc
  subst hc
  have hj := idxOf_lt_upTo hup
  have he := trace_getElem?_eq (hrounds c'') hj
  rw [List.getElem?_eq_getElem (List.idxOf_lt_length_of_mem (mem_progTrace_of_mem_upTo hup)),
    List.getElem_idxOf] at he
  have hlen'' := List.idxOf_lt_length_of_mem (mem_progTrace_of_mem_upTo hup'')
  rw [← hjj, List.getElem?_eq_getElem hlen'', List.getElem_idxOf] at he
  exact (Option.some_inj.1 he).symm


theorem twk_injective : Function.Injective (twk (n := n) τ) := by
  intro t t' h
  simp only [twk, Prod.mk.injEq, true_and] at h
  exact Prod.ext h.1 h.2

/-- **Hit transfer.** A member of `ω`'s hit class sharing the rounds through a hit's round has the same hit, with the
same query. -/
theorem transfer_hit {ω ω'' : (p3ModelT n wc).Ω}
    (hH : hitSlotSet p ω τ G W D = hitSlotSet p ω'' τ G W D) {t : Fin 2 × Fin n} (ht : t ∈ hitsBy p ω τ G W D)
    (hrounds : ∀ c, (rounds ((p3ModelT n wc).answer ω) (p c)).take (firstRound p ω (qHit τ G W ω t)) =
      (rounds ((p3ModelT n wc).answer ω'') (p c)).take (firstRound p ω (qHit τ G W ω t))) :
    t ∈ hitsBy p ω'' τ G W D ∧ qHit τ G W ω'' t = qHit τ G W ω t := by
  classical
  have hmem : slotOf p ω (qHit τ G W ω t) ∈ hitSlotSet p ω'' τ G W D := by
    rw [← hH]; exact Finset.mem_image_of_mem _ ht
  obtain ⟨t', ht', hs⟩ := Finset.mem_image.1 hmem
  have hask : ∀ {ω₁ : (p3ModelT n wc).Ω} {t₁}, t₁ ∈ hitsBy p ω₁ τ G W D → ∃ r, Asked p ω₁ (qHit τ G W ω₁ t₁) r :=
    fun h => by
      simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at h
      obtain ⟨r, -, hr⟩ := h
      exact ⟨r, hr.1.1⟩
  have hq := slot_transfer (hask ht) (hask ht') hs hrounds
  have htw : twk τ t' = twk τ t := by
    have := congrArg (fun q : (p3ModelT n wc).Qry => match q with
      | Sum.inr (Sum.inl ty) => ty.1
      | _ => twk τ t) hq
    simpa [qHit] using this
  have htt := twk_injective htw
  subst htt
  exact ⟨ht', hq⟩

/-- **The hit's answer in a transferred member is its honest input.** -/
theorem hit_answer_eq {ω ω'' : (p3ModelT n wc).Ω} {t : Fin 2 × Fin n}
    (hq : qHit τ G W ω'' t = qHit τ G W ω t) :
    ω''.2 (twk τ t) (z0 τ G W ω t) = hin τ G W ω'' t := by
  have hz : z0 τ G W ω'' t = z0 τ G W ω t := by
    have := congrArg (fun q : (p3ModelT n wc).Qry => match q with
      | Sum.inr (Sum.inl ty) => ty.2
      | _ => z0 τ G W ω t) hq
    simpa [qHit] using this
  rw [← hz]
  show ω''.2 (twk τ t) ((ω''.2 (twk τ t)).symm (hin τ G W ω'' t)) = _
  exact Equiv.apply_symm_apply _ _

/-- **Output transfer.** A member of `ω`'s class credits every output `ω` credits. -/
theorem transfer_output (hb : ∀ c, (p c).Bounded D Q) {ω ω'' : (p3ModelT n wc).Ω}
    (hS : luckySet p ω τ G W D Q = luckySet p ω'' τ G W D Q) {u : Fin n} (hu : u ∈ creditedOut p ω τ G W D) :
    u ∈ creditedOut p ω'' τ G W D := by
  classical
  have hmem : ((u : ℕ), Q) ∈ luckySet p ω'' τ G W D Q := by
    rw [← hS]; unfold luckySet
    exact Finset.mem_union_right _ (Finset.mem_image_of_mem _ hu)
  simp only [luckySet, Finset.mem_union, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and] at hmem
  rcases hmem with (⟨h', hask', heq⟩ | ⟨t, ht, heq⟩) | ⟨c, hc, heq⟩
  · have := slotOf_snd_lt hb hask'
    rw [heq] at this
    exact absurd this (lt_irrefl _)
  · simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht
    obtain ⟨r, -, hr⟩ := ht
    have := slotOf_snd_lt hb ⟨r, hr.1.1⟩
    rw [heq] at this
    exact absurd this (lt_irrefl _)
  · have : c = u := Fin.ext (congrArg Prod.fst heq)
    subst this
    exact hc

/-- A member sharing all of Part A of the split chain has the same runs. -/
theorem run_eq_of_splitPrefix (hb : ∀ c, (p c).Bounded D Q) {ω ω'' : (p3ModelT n wc).Ω}
    (h : PousLuckyChain.PrefixEq (chainX (splitFam p) τ G W (2 * D) Q) ((2 * D) * (n * Q)) ω ω'') (c : Fin n) :
    (p c).run ((p3ModelT n wc).answer ω'') = (p c).run ((p3ModelT n wc).answer ω) := by
  have hans := ans_eq_of_prefix (bounded_splitFam hb) (le_refl (2 * D)) h c
  refine (run_congr (p c) fun q hq => ?_).symm
  have hup : q ∈ upTo ((p3ModelT n wc).answer ω) (p c) D := by
    unfold upTo
    rw [List.take_of_length_le (length_rounds_le (hb c) ω), ← progTrace_eq_flatten]
    exact hq
  exact hans q ((mem_upTo_splitProg _ (p c) D q).2 hup)

/-- **A credited output's label is class-fixed from Part B on.** -/
theorem c2_eq_of_output (hb : ∀ c, (p c).Bounded D Q) {ω ω'' : (p3ModelT n wc).Ω}
    (hS : luckySet p ω τ G W D Q = luckySet p ω'' τ G W D Q) {u : Fin n} (hu : u ∈ creditedOut p ω τ G W D)
    (h : PousLuckyChain.PrefixEq (chainX (splitFam p) τ G W (2 * D) Q) ((2 * D) * (n * Q)) ω ω'') :
    c2 τ G W ω'' u = c2 τ G W ω u := by
  classical
  have hu'' := transfer_output hb hS hu
  simp only [creditedOut, Finset.mem_filter, Finset.mem_univ, true_and] at hu hu''
  rw [← hu''.1, ← hu.1]
  exact run_eq_of_splitPrefix hb h u

end PousKnowledge

end


/-! ════ Freshness.LuckyIdx ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Realization indices on the split chain (`credit-resolved.md` §11.1)

`eR r = 2(r − 1)·n·Q` is the chain index where round `r` of `p` starts. A source's realization index is the first chain
index sampling it: `RK1 w`, `RP1 w`, `RK2 u`, `RP2 u` for the honest sources, and `RB t` for a hit.

The group exclusions read "realized before `eR r`" as "asked by round `r − 1`":
- `asked_of_RK1_lt`, `asked_of_RK2_lt`;
- `asked_of_RP1_lt`, `asked_of_RP2_lt`;
- `hit_of_RB_lt`.
-/

namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ} (p : Fin n → Prog (p3ModelT n wc) (Lab n wc))
  (τ : Bits 256) (G : Labelling.TopoDAG n) (W : Fin n → Lab n wc) (D Q : ℕ) (ω : (p3ModelT n wc).Ω)

/-- The chain index where round `r` starts. -/
def eR (n Q r : ℕ) : ℕ := (2 * (r - 1)) * (n * Q)

open Classical in
/-- The realization of `κ¹_w`: the first ask of `qH1 w`, else Part B's `K1_w`. -/
noncomputable def RK1 (w : Fin n) : ℕ :=
  if ∃ r, Asked p ω (qH1 τ G W ω w) r then fA (splitFam p) (2 * D) Q ω (qH1 τ G W ω w)
  else 2 * D * (n * Q) + 2 * w

open Classical in
/-- The realization of the pair `x¹_w ↦ c¹_w`: `qP1 w` (type F), `qI1 w` (type I), else Part B's `Y1_w`. -/
noncomputable def RP1 (w : Fin n) : ℕ :=
  if TypF p ω (qP1 τ G W ω w) (qI1 τ G W ω w) then fA (splitFam p) (2 * D) Q ω (qP1 τ G W ω w)
  else if TypI p ω (qP1 τ G W ω w) (qI1 τ G W ω w) then fA (splitFam p) (2 * D) Q ω (qI1 τ G W ω w)
  else 2 * D * (n * Q) + (2 * w + 1)

open Classical in
/-- The realization of `κ²_u`. -/
noncomputable def RK2 (u : Fin n) : ℕ :=
  if ∃ r, Asked p ω (qH2 τ G W ω u) r then fA (splitFam p) (2 * D) Q ω (qH2 τ G W ω u)
  else 2 * D * (n * Q) + (2 * n + 2 * u)

open Classical in
/-- The realization of the pair `x²_u ↦ c²_u`. -/
noncomputable def RP2 (u : Fin n) : ℕ :=
  if TypF p ω (qP2 τ G W ω u) (qI2 τ G W ω u) then fA (splitFam p) (2 * D) Q ω (qP2 τ G W ω u)
  else if TypI p ω (qP2 τ G W ω u) (qI2 τ G W ω u) then fA (splitFam p) (2 * D) Q ω (qI2 τ G W ω u)
  else 2 * D * (n * Q) + (2 * n + 2 * u + 1)

/-- The realization of a hit pair: the first ask of `qHit t`. -/
noncomputable def RB (t : Fin 2 × Fin n) : ℕ := fA (splitFam p) (2 * D) Q ω (qHit τ G W ω t)

variable {p τ G W D Q ω}

theorem eR_lt_eR {r r' : ℕ} (hnQ : 0 < n * Q) (hr : 1 ≤ r) (h : eR n Q r < eR n Q r') : r < r' := by
  unfold eR at h
  by_contra hc
  have : 2 * (r' - 1) ≤ 2 * (r - 1) := by omega
  have := Nat.mul_le_mul_right (n * Q) this
  omega

/-- The first chain occurrence of an asked query is at or after the start of its first round. -/
theorem eR_le_fA (hb : ∀ c, (p c).Bounded D Q) {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked p ω q r) :
    eR n Q (firstRound p ω q) ≤ fA (splitFam p) (2 * D) Q ω q := by
  have hf : FirstAt p ω q (firstRound p ω q) := by
    refine ⟨asked_firstRound p ω h, fun h' => ?_⟩
    classical
    have hle : firstRound p ω q ≤ firstRound p ω q - 1 := by
      unfold firstRound; rw [dif_pos h]
      exact Nat.find_min' _ (by unfold firstRound at h'; rwa [dif_pos h] at h')
    have := firstRound_pos (p := p) h
    omega
  unfold eR
  rcases hq : isInvQ q
  · exact (fA_split_fwd hb hq hf).1
  · have := (fA_split_inv hb hq hf).1
    nlinarith

/-- A first chain occurrence of an asked query lies in Part A. -/
theorem fA_lt_partB (hb : ∀ c, (p c).Bounded D Q) {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked p ω q r) :
    fA (splitFam p) (2 * D) Q ω q < 2 * D * (n * Q) := by
  have hf : FirstAt p ω q (firstRound p ω q) := by
    refine ⟨asked_firstRound p ω h, fun h' => ?_⟩
    classical
    have hle : firstRound p ω q ≤ firstRound p ω q - 1 := by
      unfold firstRound; rw [dif_pos h]
      exact Nat.find_min' _ (by unfold firstRound at h'; rwa [dif_pos h] at h')
    have := firstRound_pos (p := p) h
    omega
  have hD := firstRound_le_D hb h
  have h1 := firstRound_pos (p := p) h
  rcases hq : isInvQ q
  · have := (fA_split_fwd hb hq hf).2
    have h2 : (2 * (firstRound p ω q - 1) + 1) * (n * Q) ≤ 2 * D * (n * Q) :=
      Nat.mul_le_mul_right _ (by omega)
    omega
  · have := (fA_split_inv hb hq hf).2
    have h2 : (2 * (firstRound p ω q - 1) + 2) * (n * Q) ≤ 2 * D * (n * Q) :=
      Nat.mul_le_mul_right _ (by omega)
    omega

/-- A query first on the chain before `eR r` was asked by round `r − 1`. -/
theorem asked_of_fA_lt (hb : ∀ c, (p c).Bounded D Q) {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked p ω q r) {r : ℕ}
    (hlt : fA (splitFam p) (2 * D) Q ω q < eR n Q r) : Asked p ω q (r - 1) := by
  have hle := eR_le_fA hb h
  have hnQ : 0 < n * Q := by
    rcases Nat.eq_zero_or_pos (n * Q) with h0 | h0
    · unfold eR at hlt; rw [h0] at hlt; omega
    · exact h0
  have hr := eR_lt_eR hnQ (firstRound_pos (p := p) h) (lt_of_le_of_lt hle hlt)
  exact asked_mono (by omega) (asked_firstRound p ω h)

theorem eR_le_partB {r : ℕ} (hr : r ≤ D) : eR n Q r ≤ 2 * D * (n * Q) := by
  unfold eR
  exact Nat.mul_le_mul_right _ (by omega)

/-- `κ¹_w` realized before round `r` means `qH1 w` was asked by round `r − 1`. -/
theorem asked_of_RK1_lt (hb : ∀ c, (p c).Bounded D Q) {w : Fin n} {r : ℕ} (hr : r ≤ D)
    (h : RK1 p τ G W D Q ω w < eR n Q r) : Asked p ω (qH1 τ G W ω w) (r - 1) := by
  classical
  unfold RK1 at h
  split_ifs at h with hq
  · exact asked_of_fA_lt hb hq h
  · have := eR_le_partB (n := n) (Q := Q) hr; omega

theorem asked_of_RK2_lt (hb : ∀ c, (p c).Bounded D Q) {u : Fin n} {r : ℕ} (hr : r ≤ D)
    (h : RK2 p τ G W D Q ω u < eR n Q r) : Asked p ω (qH2 τ G W ω u) (r - 1) := by
  classical
  unfold RK2 at h
  split_ifs at h with hq
  · exact asked_of_fA_lt hb hq h
  · have := eR_le_partB (n := n) (Q := Q) hr; omega

/-- The pair of `w` realized before round `r` means `qP1 w` or `qI1 w` was asked by round `r − 1`. -/
theorem asked_of_RP1_lt (hb : ∀ c, (p c).Bounded D Q) {w : Fin n} {r : ℕ} (hr : r ≤ D)
    (h : RP1 p τ G W D Q ω w < eR n Q r) :
    Asked p ω (qP1 τ G W ω w) (r - 1) ∨ Asked p ω (qI1 τ G W ω w) (r - 1) := by
  classical
  unfold RP1 at h
  split_ifs at h with hF hI
  · exact Or.inl (asked_of_fA_lt hb hF.1 h)
  · exact Or.inr (asked_of_fA_lt hb hI.1 h)
  · have := eR_le_partB (n := n) (Q := Q) hr; omega

theorem asked_of_RP2_lt (hb : ∀ c, (p c).Bounded D Q) {u : Fin n} {r : ℕ} (hr : r ≤ D)
    (h : RP2 p τ G W D Q ω u < eR n Q r) :
    Asked p ω (qP2 τ G W ω u) (r - 1) ∨ Asked p ω (qI2 τ G W ω u) (r - 1) := by
  classical
  unfold RP2 at h
  split_ifs at h with hF hI
  · exact Or.inl (asked_of_fA_lt hb hF.1 h)
  · exact Or.inr (asked_of_fA_lt hb hI.1 h)
  · have := eR_le_partB (n := n) (Q := Q) hr; omega

/-- A hit realized before round `r` happened by round `r − 1`. -/
theorem hit_of_RB_lt (hb : ∀ c, (p c).Bounded D Q) {t : Fin 2 × Fin n} (ht : t ∈ hitsBy p ω τ G W D) {r : ℕ}
    (h : RB p τ G W D Q ω t < eR n Q r) : t ∈ hitsBy p ω τ G W (r - 1) := by
  classical
  simp only [hitsBy, Finset.mem_filter, Finset.mem_univ, true_and] at ht ⊢
  obtain ⟨rh, -, hhit⟩ := ht
  have hask : ∃ r, Asked p ω (qHit τ G W ω t) r := ⟨rh, hhit.1.1⟩
  have hfr := firstRound_eq p ω hhit.1
  have hle := eR_le_fA hb hask
  rw [hfr] at hle
  have hnQ : 0 < n * Q := by
    rcases Nat.eq_zero_or_pos (n * Q) with h0 | h0
    · unfold RB at h; unfold eR at h; rw [h0] at h; omega
    · exact h0
  have := eR_lt_eR hnQ (one_le_of_firstAt p ω hhit.1) (lt_of_le_of_lt hle h)
  exact ⟨rh, by omega, hhit⟩

end PousKnowledge

end


