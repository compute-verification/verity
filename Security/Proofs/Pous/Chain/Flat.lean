/-! ════ ChainEPFV6Names2 ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# Band v6 (c′): step-split names and the pattern cut

A (c′) name stores an adversary charge's absolute step (`< B(Q+1)`) and a labeller charge as
`B(Q+1)` plus its offset after the cut. An adversary-step name is ready at the end of its step's
round; a labeller-step name at its value pointer's round end. `realizedPattern6_done_iff`: the
realized pattern is done exactly from the first crossing on, so the pattern strategy runs the
realized truncated run.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm
open Pous.BandChain.KeyRule

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

theorem programSteps_le_BQ (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : R.programSteps π ≤ B * R.Q := by
  rw [R.programSteps_eq_advSched π, R.advSched_eq_advSeq]
  have hlen := R.bandSeq_length hP (fun _ : Unit => π)
  rw [R.honestSeq_length π] at hlen
  have hsum : ∑ i : Fin B, (R.tr π i).length ≤ ∑ _i : Fin B, R.Q :=
    Finset.sum_le_sum fun i _ => R.tr_length_le hP π i
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at hsum
  omega

/-- The (c′) step field. -/
def stepField (cut n : ℕ) : ℕ := if n < cut then n else B * (R.Q + 1) + (n - cut)

theorem stepField_lt (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {cut n : ℕ} (hcut : cut ≤ R.programSteps π)
    (hn : n < R.chargeBound cut) : R.stepField cut n < nPos B R.Q := by
  have h1 := R.programSteps_le_BQ hP π
  have h2 := R.card_posSet_le_half
  unfold stepField
  unfold chargeBound at hn
  unfold nPos
  split_ifs with h
  · have : B * R.Q ≤ B * (R.Q + 1) := Nat.mul_le_mul_left _ (Nat.le_succ _)
    omega
  · omega

theorem stepField_adv (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {cut n : ℕ} (hcut : cut ≤ R.programSteps π)
    (hn : n < cut) : R.stepField cut n = n ∧ n < B * (R.Q + 1) := by
  have h1 := R.programSteps_le_BQ hP π
  have : B * R.Q ≤ B * (R.Q + 1) := Nat.mul_le_mul_left _ (Nat.le_succ _)
  unfold stepField
  rw [if_pos hn]
  exact ⟨rfl, by omega⟩

theorem stepField_lab {cut n : ℕ} (hn : ¬ n < cut) :
    R.stepField cut n = B * (R.Q + 1) + (n - cut) := by
  unfold stepField
  rw [if_neg hn]

theorem stepField_inj (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))} {cut n n' : ℕ} (hcut : cut ≤ R.programSteps π)
    (h : R.stepField cut n = R.stepField cut n') : n = n' := by
  by_cases hn : n < cut <;> by_cases hn' : n' < cut
  · rw [(R.stepField_adv hP hcut hn).1, (R.stepField_adv hP hcut hn').1] at h; exact h
  · have := R.stepField_adv hP hcut hn
    rw [this.1, R.stepField_lab hn'] at h; omega
  · have := R.stepField_adv hP hcut hn'
    rw [this.1, R.stepField_lab hn] at h; omega
  · rw [R.stepField_lab hn, R.stepField_lab hn'] at h; omega

section Names

variable (hP : ∀ i, (R.P i).Bounded R.D R.Q) (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
  (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)

include hcross in
theorem chargeStep_lt_bound (a : {a // a ∈ R.realizedSeeds s π}) :
    (R.chargePin (R.firstCrossing s π) π a.1).step < R.chargeBound (R.firstCrossing s π) :=
  (R.pairStep_spec π (R.firstCrossing_le s π hcross)
    (R.atomValid_pair (R.realizedSeed_cell_valid s π a))).1

/-- A realized seed's (c′) name. -/
noncomputable def realizedName6 (i : Fin (R.realizedSeeds s π).card) :
    Fin (nPos B R.Q) × R.V6SeedName :=
  let a := R.seedAtIndex s π i
  (⟨R.stepField (R.firstCrossing s π) (R.chargePin (R.firstCrossing s π) π a.1).step,
      R.stepField_lt hP (R.firstCrossing_le s π hcross) (R.chargeStep_lt_bound s π hcross a)⟩,
    (R.v6Code hP s π hcross a).1, R.v6Ptr hP s π hcross a, (R.v6Code hP s π hcross a).2)

noncomputable def realizedPattern6 : R.V6Pattern where
  names := List.ofFn (R.realizedName6 hP s π hcross)

end Names

/-- (c′) readiness: an adversary-step name at its step's round end, a labeller-step name at its
value pointer's round end. A labeller-step name with an `.inr` pointer is never ready; that is harmless, since realized
labeller names always carry `.inl` (`realizedPattern6_done_iff`). -/
def nameReady6 (h : History (BandAlpha ℓ c)) (nm : Fin (nPos B R.Q) × R.V6SeedName) : Prop :=
  if nm.1.val < B * (R.Q + 1) then R.stepReady h nm.1.val
  else match nm.2.2.1 with
    | .inl o => R.positionReady h o
    | .inr _ => False

def PatternDone6 (P : R.V6Pattern) (h : History (BandAlpha ℓ c)) : Prop :=
  ∀ nm ∈ P.names, R.nameReady6 h nm

open Classical in
noncomputable def stratP6 (P : R.V6Pattern) : Strategy (BandAlpha ℓ c) where
  next h := if R.PatternDone6 P h then R.labTail h else R.advThenLab.next h

theorem stratP6_hist_eq_stratC_of_patternDone_iff
    (P : R.V6Pattern) {cut : ℕ} {π : Oracle (BandAlpha ℓ c)}
    (hcut : cut ≤ (R.advSched π).length)
    (hdone : ∀ j, R.PatternDone6 P ((R.stratC cut).hist π j) ↔ cut ≤ j) :
    ∀ j, (R.stratP6 P).hist π j = (R.stratC cut).hist π j := by
  classical
  intro j
  induction j with
  | zero => rfl
  | succ j ih =>
      by_cases hj : cut ≤ j
      · have hle : cut ≤ ((R.stratC cut).hist π j).length :=
          (R.stratC_cut_le_hist_length_iff hcut).2 hj
        simp only [Strategy.hist, ih]
        rw [show (R.stratP6 P).next ((R.stratC cut).hist π j) =
            (R.stratC cut).next ((R.stratC cut).hist π j) by
          rw [R.stratC_next_tail hle]
          simp [stratP6, (hdone j).2 hj]]
      · have hjlt : j < cut := by omega
        have hlen : ((R.stratC cut).hist π j).length < cut :=
          lt_of_le_of_lt ((R.stratC cut).hist_length_le π j) hjlt
        have hnot : ¬ R.PatternDone6 P ((R.stratC cut).hist π j) := by
          intro h
          exact hj ((hdone j).1 h)
        simp only [Strategy.hist, ih]
        rw [show (R.stratP6 P).next ((R.stratC cut).hist π j) =
            (R.stratC cut).next ((R.stratC cut).hist π j) by
          have hp : (R.stratP6 P).next ((R.stratC cut).hist π j) =
              R.advThenLab.next ((R.stratC cut).hist π j) := by
            simp [stratP6, hnot]
          have hc : (R.stratC cut).next ((R.stratC cut).hist π j) =
              R.advThenLab.next ((R.stratC cut).hist π j) := by
            change (if _ < cut then _ else _) = _
            simp only [hlen, ↓reduceIte]
          exact hp.trans hc.symm]

theorem pinNextN_step_ge (R : ChainReplay B ℓ c) (hP : ∀ i, (R.P i).Bounded R.D R.Q)
    {cut τc : ℕ} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hcut : cut ≤ R.programSteps π) (hend : cut = R.roundStart π (τc + 1)) (hτc : τc ≤ R.D) :
    ∀ k {a y : VAtom B}, R.atomValid a → R.pinNextN cut π k a = some y →
      R.pairStep cut π a.pair ≤ R.pairStep cut π y.pair
  | 0, a, y, _, h => by
      simp only [pinNextN, Option.some.injEq] at h
      rw [h]
  | k + 1, a, y, ha, h => by
      obtain ⟨z, hz, hy⟩ := R.pinNextN_succ.1 h
      exact (R.pinNextN_step_ge hP hcut hend hτc k ha hz).trans
        (R.pinNext_step_le hP hcut hend hτc (R.pinNextN_valid k ha hz) hy)

section Ready

variable (hP : ∀ i, (R.P i).Bounded R.D R.Q) (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
  (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)

set_option maxHeartbeats 4000000 in
/-- A transfer's pointer is the slot of its last inverse step `d`: that step's own entry. -/
theorem transfer_slot (a : {a // a ∈ R.realizedSeeds s π})
    (hf : R.pairForward (R.firstCrossing s π) π
      (R.pinCell (R.firstCrossing s π) π a.1).pair = true)
    (he : R.pinCell (R.firstCrossing s π) π a.1 ≠ a.1) :
    ∃ (o : Fin B × Fin (R.Q + 1)) (te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c)))) (d : ℕ),
      R.v6Ptr hP s π hcross a = .inl o ∧ o.2.val < R.Q ∧ (R.tr π o.1)[o.2.val]? = some te ∧
      R.roundStart π te.1 ≤ d ∧ d < R.firstCrossing s π ∧
      R.pairStep (R.firstCrossing s π) π a.1.pair ≤ d ∧
      (∃ X, te.2 = .inr (π X) ∧
        X ∉ ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) d).dom ()) := by
  classical
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  have hev := R.realizedSeed_cell_valid s π a
  obtain ⟨k, hk, hy⟩ := R.prevCell_spec (R.firstCrossing s π) π he
  set e := R.pinCell (R.firstCrossing s π) π a.1 with he_def
  set y := R.prevCell (R.firstCrossing s π) π a.1 with hy_def
  have hyv : R.atomValid y := R.pinNextN_valid k (R.realized_atom_valid s π a.2) hk
  obtain ⟨hyf, -, -⟩ := R.pinNext_some hy
  have hyq := R.atomValid_pair hyv
  have hdcut := R.inverse_step_lt_cut hcut hyq hyf
  obtain ⟨qd, hqd, -, hcased, hdird⟩ := R.charge_query π hcut hyq
  have hqdi : qd = ⟨(), .inr (π (R.xin π y.pair.1 y.pair.2))⟩ := by
    rcases hcased with h | h
    · rw [h, hyf] at hdird; simp [qFwd] at hdird
    · exact h
  obtain ⟨τc, hτc, hend⟩ := R.firstCrossing_roundEnd hP s π hcross
  have hyfix := (R.pairStep_spec π hcut hyq)
  have hptr0 : R.v6Ptr hP s π hcross a =
      R.fixSlot (R.firstCrossing s π) π (R.pairStep (R.firstCrossing s π) π y.pair + 1)
        (R.xin π y.pair.1 y.pair.2) (.inr ⟨e.pair, R.atomValid_pair hev⟩) := by
    simp only [v6Ptr, ← he_def, ← hy_def, hf, he, ↓reduceIte]
  obtain ⟨o, hptr, te, hkQ, hte, hρ, hD, hmem, hrev⟩ :=
    R.fixSlot_spec hP hcut (by omega) hyfix.2.2 (.inr ⟨e.pair, R.atomValid_pair hev⟩)
  have hbe := R.fixSlot_last π hcut hqd hyfix.2.1 hmem hrev
  have hte2 : te.2 = .inr (π (R.xin π y.pair.1 y.pair.2)) := by
    rw [hqdi] at hbe
    simp only [bandEnc, Sigma.mk.inj_iff, heq_eq_eq, true_and] at hbe
    exact hbe
  refine ⟨o, te, R.pairStep (R.firstCrossing s π) π y.pair, hptr0.trans hptr, hkQ, hte,
    by omega, hdcut, R.pinNextN_step_ge hP hcut hend hτc k (R.realized_atom_valid s π a.2) hk,
    _, hte2, hyfix.2.1⟩

set_option maxHeartbeats 4000000 in
/-- **Exact readiness of one realized name.** It is ready from a point `X ≤ cut` on, and exactly
from the cut for a seed whose show commits at the cut. -/
theorem seed_ready6 (i : Fin (R.realizedSeeds s π).card) :
    ∃ X ≤ R.firstCrossing s π,
      (∀ j, R.nameReady6 ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) j)
          (R.realizedName6 hP s π hcross i) ↔ X ≤ j) ∧
      (R.commitCut π (R.sourceCommitRound hP s π hcross (R.seedAtIndex s π i))
          (R.sourceCommit hP s π hcross (R.seedAtIndex s π i)) = R.firstCrossing s π →
        X = R.firstCrossing s π) := by
  classical
  set a := R.seedAtIndex s π i with ha_def
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  obtain ⟨τc, hτc, hend⟩ := R.firstCrossing_roundEnd hP s π hcross
  have hev := R.realizedSeed_cell_valid s π a
  set n := (R.chargePin (R.firstCrossing s π) π a.1).step with hn_def
  have hname1 : (R.realizedName6 hP s π hcross i).1.val = R.stepField (R.firstCrossing s π) n := rfl
  have hname2 : (R.realizedName6 hP s π hcross i).2.2.1 = R.v6Ptr hP s π hcross a := rfl
  have hsrcR : R.roundStart π (R.sourceCommitRound hP s π hcross a) ≤ n :=
    R.v6_source_round_le_charge hP s π hcross a
  have hcommit : ∀ {τa : ℕ}, τa = R.sourceCommitRound hP s π hcross a →
      R.commitCut π τa (R.sourceCommit hP s π hcross a) = R.roundStart π (τa + 1) := by
    intro τa _
    unfold commitCut
    rw [R.sc_roundStart_succ]
  by_cases hn : n < R.firstCrossing s π
  · obtain ⟨hsf, hlt⟩ := R.stepField_adv hP hcut hn
    have hready : ∀ j, R.nameReady6 ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) j)
        (R.realizedName6 hP s π hcross i) ↔ R.stepRoundEnd π n ≤ j := by
      intro j
      unfold nameReady6
      rw [hname1, hsf, if_pos hlt]
      exact R.stepReady_iff hP hcut hend hτc hn j
    refine ⟨R.stepRoundEnd π n, ?_, hready, fun hcc => ?_⟩
    · rw [hend]; exact R.stepRoundEnd_le (by rw [← hend]; exact hn)
    · have hcc' := (hcommit rfl).symm.trans hcc
      obtain ⟨τ', hτ', hnτ', hre⟩ := R.stepRoundEnd_spec
        (τ := R.sourceCommitRound hP s π hcross a) (by rw [hcc']; exact hn)
      rw [hre, ← hcc']
      by_contra hne
      have hlt' : τ' < R.sourceCommitRound hP s π hcross a := by
        rcases Nat.lt_or_eq_of_le hτ' with h | h
        · exact h
        · exact absurd (by rw [h]) hne
      have := R.sc_roundStart_mono π (show τ' + 1 ≤ R.sourceCommitRound hP s π hcross a by omega)
      omega
  · have hlab := R.stepField_lab hn
    have hge : ¬ R.stepField (R.firstCrossing s π) n < B * (R.Q + 1) := by rw [hlab]; omega
    have hf : R.pairForward (R.firstCrossing s π) π
        (R.pinCell (R.firstCrossing s π) π a.1).pair = true := by
      by_contra hf
      exact hn (R.inverse_step_lt_cut hcut (R.atomValid_pair hev) (by simpa using hf))
    have hready : ∀ o, R.v6Ptr hP s π hcross a = .inl o → ∀ j,
        R.nameReady6 ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) j)
          (R.realizedName6 hP s π hcross i) ↔
        R.positionReady ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) j) o := by
      intro o ho j
      unfold nameReady6
      rw [hname1, if_neg hge, hname2, ho]
    by_cases he : R.pinCell (R.firstCrossing s π) π a.1 = a.1
    · have hptr : R.v6Ptr hP s π hcross a = .inl (R.sourceCommitProgramPos hP s π hcross a) := by
        have hf' : R.pairForward (R.firstCrossing s π) π a.1.pair = true := he ▸ hf
        simp only [v6Ptr, hf, he, hf', ↓reduceIte]
      have hS := R.sourceCommitExact hP s π hcross
      refine ⟨R.commitCut π (R.sourceCommitRound hP s π hcross a) (R.sourceCommit hP s π hcross a),
        (R.sourceCommitRound_spec hP s π hcross a).2.2.2, fun j => ?_, fun h => h⟩
      rw [hready _ hptr j]
      exact hS.ready_iff a j
    · obtain ⟨o, te, d, hptr, hkQ, hte, hρd, hdcut, hda, X, hte2, hX⟩ :=
        R.transfer_slot hP s π hcross a hf he
      have hkb := R.mem_queryBasisAt_of_tr hP π hte
      obtain ⟨hkQ', hkb⟩ := hkb
      have hoeq : (⟨o.2.val, Nat.lt_succ_of_lt hkQ'⟩ : Fin (R.Q + 1)) = o.2 := Fin.ext rfl
      rw [hoeq] at hkb
      have hτ1 : te.1 ≤ τc := by
        by_contra hgt
        have := R.sc_roundStart_mono π (show τc + 1 ≤ te.1 by omega)
        omega
      have hτD : te.1 ≤ R.D := hτ1.trans hτc
      -- the basis commit of the transferring slot
      have hxin : ∃ q ∈ R.posSet, X = R.xin π q.1 q.2 := by
        obtain ⟨k, hk, hy⟩ := R.prevCell_spec (R.firstCrossing s π) π he
        refine ⟨(R.prevCell (R.firstCrossing s π) π a.1).pair,
          R.atomValid_pair (R.pinNextN_valid k (R.realized_atom_valid s π a.2) hk), ?_⟩
        have hptr' := hptr
        exact (by
          have h1 : ∀ Y, te.2 = .inr (π Y) → Y = X := fun Y hY => by
            rw [hte2] at hY
            exact π.injective (Sum.inr.inj hY).symm
          -- the chosen slot's entry reveals `xin y.pair`
          obtain ⟨o', hptr'', te', hkQ'', hte', -, -, -, hrev'⟩ :=
            R.fixSlot_spec hP hcut (show R.pairStep (R.firstCrossing s π) π
              (R.prevCell (R.firstCrossing s π) π a.1).pair + 1 ≤ R.firstCrossing s π by
                have hyv := R.pinNextN_valid k (R.realized_atom_valid s π a.2) hk
                have := R.inverse_step_lt_cut hcut (R.atomValid_pair hyv) (R.pinNext_some hy).1
                omega)
              (R.pairStep_spec π hcut (R.atomValid_pair
                (R.pinNextN_valid k (R.realized_atom_valid s π a.2) hk))).2.2
              (.inr ⟨(R.pinCell (R.firstCrossing s π) π a.1).pair, R.atomValid_pair hev⟩)
          have hsame : R.v6Ptr hP s π hcross a = .inl o' := by
            rw [← hptr'']
            simp only [v6Ptr, hf, he, ↓reduceIte]
          rw [hptr] at hsame
          obtain rfl := Sum.inl.inj hsame
          rw [hte] at hte'
          obtain rfl := Option.some.inj hte'
          rw [hte2] at hrev'
          simpa [revealPt] using hrev')
      obtain ⟨q, hq, rfl⟩ := hxin
      have hm : R.commitMatches π te.1 ⟨.inl o, .r q⟩ := by
        have := R.commit_inv (a := .r q) (i := o.1) (k := o.2.val) hte hkQ' hte2
        rwa [hoeq] at this
      have hx := R.commit_mem_basisAt hkb (show R.atomValid (.r q) from hq) hm
      have hcc : R.commitCut π te.1 ⟨.inl o, .r q⟩ = R.roundStart π (te.1 + 1) := by
        unfold commitCut; rw [R.sc_roundStart_succ]
      have hXcut : R.commitCut π te.1 ⟨.inl o, .r q⟩ ≤ R.firstCrossing s π := by
        rw [hcc, hend]; exact R.sc_roundStart_mono π (by omega)
      refine ⟨R.commitCut π te.1 ⟨.inl o, .r q⟩, hXcut, fun j => ?_, fun hcc' => ?_⟩
      · rw [hready _ hptr j]
        exact R.basis_positionReady_iff hP s π hcross hτD hx rfl hXcut j
      · -- the source round is the transferring slot's round
        set τa := R.sourceCommitRound hP s π hcross a
        have hτaD : τa ≤ R.D := (R.sourceCommitRound_spec hP s π hcross a).1
        have hcut' : R.firstCrossing s π = R.roundStart π (τa + 1) := (hcommit rfl).symm.trans hcc' |>.symm
        have hle1 : te.1 ≤ τa := by
          by_contra hgt
          have := R.sc_roundStart_mono π (show τa + 1 ≤ te.1 by omega)
          omega
        have hle2 : τa ≤ te.1 := by
          by_contra hlt
          have hhome : R.roundStart π τa ≤ R.pairStep (R.firstCrossing s π) π a.1.pair :=
            R.v6_source_round_le_home_step hP s π hcross a
          have hstart : R.roundStart π τa ≤ R.firstCrossing s π := by
            rw [hcut']; exact R.sc_roundStart_mono π (Nat.le_succ _)
          have hmem := R.sc_trace_query_mem_advThenLab hP π (le_refl (R.roundStart π τa))
            (hstart.trans hcut) hτaD (List.mem_of_getElem? hte) (by omega)
          rw [← R.stratC_hist_le (π := fun _ : Unit => π)
            (by rw [← R.programSteps_eq_advSched]; exact hcut) _ hstart] at hmem
          have hmem' := ((R.stratC (R.firstCrossing s π)).hist_prefix (fun _ : Unit => π)
            (show R.roundStart π τa ≤ d by omega)).subset hmem
          apply hX
          refine History.mem_dom.2 ⟨_, hmem', ?_⟩
          rw [qEntry_inpAt_revealPt π te.2, hte2]
          simp [revealPt]
        have hτeq : te.1 = τa := le_antisymm hle1 hle2
        rw [hcc, hτeq, ← hcut']

/-- **The realized (c′) pattern is done exactly from the first crossing on.** -/
theorem realizedPattern6_done_iff (j : ℕ) :
    R.PatternDone6 (R.realizedPattern6 hP s π hcross)
        ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) j) ↔
      R.firstCrossing s π ≤ j := by
  classical
  constructor
  · intro hdone
    obtain ⟨a, ha⟩ := (R.sourceCommitExact hP s π hcross).hits_cut
    let i : Fin (R.realizedSeeds s π).card := Finset.equivFin (R.realizedSeeds s π) a
    have hai : R.seedAtIndex s π i = a :=
      (Finset.equivFin (R.realizedSeeds s π)).symm_apply_apply a
    have hmem : R.realizedName6 hP s π hcross i ∈ (R.realizedPattern6 hP s π hcross).names :=
      (List.mem_ofFn).2 ⟨i, rfl⟩
    obtain ⟨X, -, hiff, hexact⟩ := R.seed_ready6 hP s π hcross i
    have h1 := (hiff j).1 (hdone _ hmem)
    have h2 := hexact (by rw [hai]; exact ha)
    omega
  · intro hj nm hnm
    obtain ⟨i, rfl⟩ := (List.mem_ofFn).1 hnm
    obtain ⟨X, hX, hiff, -⟩ := R.seed_ready6 hP s π hcross i
    exact (hiff j).2 (hX.trans hj)

theorem stratP6_realized_hist_eq :
    ∀ j, (R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π) j =
      (R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) j :=
  R.stratP6_hist_eq_stratC_of_patternDone_iff _
    (by rw [← R.programSteps_eq_advSched]; exact R.firstCrossing_le s π hcross)
    (R.realizedPattern6_done_iff hP s π hcross)

/-- **The (c′) names of one run are distinct.** Same field, same step, same pair; the same code and
pointer decode to the same part; so the same charge pin, hence the same seed. -/
theorem realizedName6_injective (hnc : R.NoCollU π) :
    Function.Injective (R.realizedName6 hP s π hcross) := by
  classical
  intro i i' h
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  set a := R.seedAtIndex s π i with ha_def
  set a' := R.seedAtIndex s π i' with ha'_def
  have hf : R.stepField (R.firstCrossing s π) (R.chargePin (R.firstCrossing s π) π a.1).step =
      R.stepField (R.firstCrossing s π) (R.chargePin (R.firstCrossing s π) π a'.1).step :=
    congrArg (fun nm => nm.1.val) h
  have hstep := R.stepField_inj hP hcut hf
  have hva := R.realizedSeed_cell_valid s π a
  have hva' := R.realizedSeed_cell_valid s π a'
  have hpair : (R.pinCell (R.firstCrossing s π) π a.1).pair =
      (R.pinCell (R.firstCrossing s π) π a'.1).pair :=
    R.pairStep_inj hcut hnc (R.atomValid_pair hva) (R.atomValid_pair hva') hstep
  have hcode : R.v6Code hP s π hcross a = R.v6Code hP s π hcross a' := by
    have h1 := congrArg (fun nm => nm.2.1) h
    have h2 := congrArg (fun nm => nm.2.2.2) h
    exact Prod.ext h1 h2
  have hptr : R.v6Ptr hP s π hcross a = R.v6Ptr hP s π hcross a' := congrArg (fun nm => nm.2.2.1) h
  have hpart : a.1.part = a'.1.part := by
    obtain ⟨q, hq, -, hp, -⟩ := R.v6_seed_sound hP s π hcross a
    obtain ⟨q', hq', -, hp', -⟩ := R.v6_seed_sound hP s π hcross a'
    rw [← hpair] at hq'
    have hqq : q = q' := Option.some.inj (hq.symm.trans hq')
    rw [← hp, ← hp', hqq, hcode, hptr]
  have hcp : R.chargePin (R.firstCrossing s π) π a.1 = R.chargePin (R.firstCrossing s π) π a'.1 := by
    simp only [chargePin, hpair, R.pinCell_part, hpart]
  have haa := R.v6_charge_pin_injective s π hcross hnc a.2 a'.2 hcp
  apply (Finset.equivFin (R.realizedSeeds s π)).symm.injective
  exact Subtype.ext haa

end Ready

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Fibers ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# Band v6 (c′): fixed-pattern fibers

For a fixed (c′) pattern `P`, the pattern strategy `stratP6 P` assigns each step field of `P` to
one step: an adversary field to its absolute step, a labeller field to the first `PatternDone6`
time of the history plus its offset (`assign6`). An oracle realizing `P` hits, at each assigned
step, the target read from any other realizing oracle with the same history (`v6_fiber_det`).
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm
open Pous.BandChain.KeyRule
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

theorem v6_pr_eq_prob {n : ℕ} (P : Equiv.Perm (Bits n) → Prop) :
    Pous.pr P = LazyPerm.prob (fun ω : LazyPerm.Oracle (fun _ : Unit => Bits n) => P (ω ())) := by
  classical
  have h := LazyPerm.prob_congr (Equiv.funUnique Unit (Equiv.Perm (Bits n))).symm
    (fun ω : LazyPerm.Oracle (fun _ : Unit => Bits n) => P (ω ()))
  rw [← h]
  rfl

theorem hist_length_le_add (S : Strategy (BandAlpha ℓ c)) (π : Oracle (BandAlpha ℓ c)) (m : ℕ) :
    ∀ k, (S.hist π (m + k)).length ≤ (S.hist π m).length + k
  | 0 => le_rfl
  | k + 1 => by
      have ih := hist_length_le_add S π m k
      rw [show m + (k + 1) = (m + k) + 1 by omega]
      cases hq : S.next (S.hist π (m + k)) with
      | none => rw [S.hist_succ_of_none hq]; omega
      | some q => rw [S.hist_succ_of_some hq, List.length_append]; simp; omega

theorem hist_take_of_length (S : Strategy (BandAlpha ℓ c)) {π : Oracle (BandAlpha ℓ c)} {n m : ℕ}
    (hn : (S.hist π n).length = n) (hm : m ≤ n) : (S.hist π n).take m = S.hist π m := by
  have hpre := S.hist_prefix π hm
  have hl := hist_length_le_add S π m (n - m)
  rw [show m + (n - m) = n by omega, hn] at hl
  have hlm := S.hist_length_le π m
  have hlen : (S.hist π m).length = m := by omega
  rw [List.prefix_iff_eq_take.1 hpre, hlen]

open Classical in
/-- The first `PatternDone6` time of a history. -/
noncomputable def doneAt (P : R.V6Pattern) (h : History (BandAlpha ℓ c)) : Option ℕ :=
  if hx : ∃ m, m ≤ h.length ∧ R.PatternDone6 P (h.take m) then some (Nat.find hx) else none

theorem doneAt_prefix (P : R.V6Pattern) {h₁ h₂ : History (BandAlpha ℓ c)} (hp : h₁ <+: h₂)
    {t : ℕ} (ht : R.doneAt P h₁ = some t) : R.doneAt P h₂ = some t := by
  classical
  unfold doneAt at ht ⊢
  split at ht
  · rename_i hx₁
    obtain rfl := Option.some.inj ht
    have htk : ∀ m, m ≤ h₁.length → h₂.take m = h₁.take m := by
      intro m hm
      rw [List.prefix_iff_eq_take.1 hp, List.take_take, min_eq_left hm]
    have hspec := Nat.find_spec hx₁
    have hlen := hp.length_le
    have hx₂ : ∃ m, m ≤ h₂.length ∧ R.PatternDone6 P (h₂.take m) :=
      ⟨Nat.find hx₁, hspec.1.trans hlen, by rw [htk _ hspec.1]; exact hspec.2⟩
    rw [dif_pos hx₂]
    congr 1
    apply le_antisymm
    · exact Nat.find_min' hx₂ ⟨hspec.1.trans hlen, by rw [htk _ hspec.1]; exact hspec.2⟩
    · by_contra hlt
      push Not at hlt
      have h2 := Nat.find_spec hx₂
      exact Nat.find_min hx₁ hlt ⟨by omega, by rw [← htk _ (by omega)]; exact h2.2⟩
  · simp at ht

/-- The step a field names, read from the history. -/
noncomputable def stepOf6 (P : R.V6Pattern) (f : Fin (nPos B R.Q)) (h : History (BandAlpha ℓ c)) :
    Option ℕ :=
  if f.val < B * (R.Q + 1) then some f.val
  else (R.doneAt P h).map (· + (f.val - B * (R.Q + 1)))

def fields6 (P : R.V6Pattern) : Finset (Fin (nPos B R.Q)) := (P.names.map Prod.fst).toFinset

open Classical in
/-- The item assigned at step `n`: the field of `P` that names it. -/
noncomputable def assign6 (P : R.V6Pattern) (n : ℕ) (h : History (BandAlpha ℓ c)) :
    Option (Fin (nPos B R.Q)) :=
  if hx : ∃ f ∈ R.fields6 P, R.stepOf6 P f h = some n then some (Classical.choose hx) else none

theorem assign6_spec {P : R.V6Pattern} {n : ℕ} {h : History (BandAlpha ℓ c)} {f : Fin (nPos B R.Q)}
    (hA : R.assign6 P n h = some f) : f ∈ R.fields6 P ∧ R.stepOf6 P f h = some n := by
  classical
  unfold assign6 at hA
  split at hA
  · rename_i hx
    obtain rfl := Option.some.inj hA
    exact Classical.choose_spec hx
  · simp at hA

theorem stepOf6_uniq (P : R.V6Pattern) (S : Strategy (BandAlpha ℓ c)) (π : Oracle (BandAlpha ℓ c))
    (f : Fin (nPos B R.Q)) {m n : ℕ} (hm : R.stepOf6 P f (S.hist π m) = some m)
    (hn : R.stepOf6 P f (S.hist π n) = some n) : m = n := by
  unfold stepOf6 at hm hn
  split at hm
  · rename_i hf
    rw [if_pos hf] at hn
    exact (Option.some.inj hm).symm.trans (Option.some.inj hn)
  · rename_i hf
    rw [if_neg hf] at hn
    obtain ⟨t, ht, rfl⟩ := Option.map_eq_some_iff.1 hm
    obtain ⟨t', ht', htn⟩ := Option.map_eq_some_iff.1 hn
    have htt : t = t' := by
      rcases le_total (t + (f.val - B * (R.Q + 1))) n with hle | hle
      · have := R.doneAt_prefix P (S.hist_prefix π hle) ht
        rw [ht'] at this
        exact (Option.some.inj this).symm
      · have := R.doneAt_prefix P (S.hist_prefix π hle) ht'
        rw [ht] at this
        exact Option.some.inj this
    omega

theorem assign6_uniq (P : R.V6Pattern) (S : Strategy (BandAlpha ℓ c)) :
    ∀ π f m n, R.assign6 P m (S.hist π m) = some f → R.assign6 P n (S.hist π n) = some f →
      m = n := by
  intro π f m n hm hn
  exact R.stepOf6_uniq P S π f (R.assign6_spec hm).2 (R.assign6_spec hn).2

theorem next_of_hist_eq {S S' : Strategy (BandAlpha ℓ c)} {π : Oracle (BandAlpha ℓ c)}
    (h : ∀ j, S.hist π j = S'.hist π j) {n : ℕ} {q : Qry (BandAlpha ℓ c)}
    (hq : S'.next (S'.hist π n) = some q) : S.next (S.hist π n) = some q := by
  have h1 := h (n + 1)
  rw [S'.hist_succ_of_some hq] at h1
  cases hs : S.next (S.hist π n) with
  | none =>
      rw [S.hist_succ_of_none hs, h n] at h1
      have := congrArg List.length h1
      simp at this
  | some q' =>
      rw [S.hist_succ_of_some hs, h n] at h1
      have h2 := List.append_cancel_left h1
      simp only [List.cons.injEq, and_true] at h2
      exact congrArg some (Sigma.mk.inj_iff.1 h2).1

def qFwdO : Option (Qry (BandAlpha ℓ c)) → Bool
  | some q => qFwd q
  | none => false

section Real

variable (hP : ∀ i, (R.P i).Bounded R.D R.Q) (s : ℕ)

/-- `π` realizes the (c′) pattern `P`. -/
def Realizes6 (P : R.V6Pattern) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) : Prop :=
  ∃ hcross : (∃ cut ≤ R.programSteps π, R.crosses s π cut),
    R.NoCollU π ∧ R.realizedPattern6 hP s π hcross = P

/-- The part a name pins under `π`, read from the history before its step. -/
noncomputable def decodedPart (P : R.V6Pattern) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
    (nm : Fin (nPos B R.Q) × R.V6SeedName) (h : History (BandAlpha ℓ c)) : V6Part :=
  (R.v6Decode (nm.2.1, nm.2.2.2) (qFwdO ((R.stratP6 P).next h)) nm.2.2.1
    (R.ptrFwd π nm.2.2.1)).part

variable (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)

/-- The charged step of the `i`-th realized seed. -/
noncomputable def stepAt6 (i : Fin (R.realizedSeeds s π).card) : ℕ :=
  (R.chargePin (R.firstCrossing s π) π (R.seedAtIndex s π i).1).step

theorem stepAt6_sound (i : Fin (R.realizedSeeds s π).card) :
    ∃ q, (R.stratP6 (R.realizedPattern6 hP s π hcross)).next
        ((R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π)
          (R.stepAt6 s π i)) = some q ∧
      Fresh ((R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π)
          (R.stepAt6 s π i)) q ∧
      R.SeedSound (R.firstCrossing s π) (R.stepAt6 s π i) π
        (R.v6Code hP s π hcross (R.seedAtIndex s π i)) (R.v6Ptr hP s π hcross (R.seedAtIndex s π i))
        (R.seedAtIndex s π i).1.part := by
  have hS := R.v6_seed_sound hP s π hcross (R.seedAtIndex s π i)
  obtain ⟨q, hq, hfr, -⟩ := id hS
  have hh := R.stratP6_realized_hist_eq hP s π hcross
  refine ⟨q, next_of_hist_eq hh hq, by rw [hh]; exact hfr, hS⟩

theorem doneAt_realized {n : ℕ} (hn : R.firstCrossing s π ≤ n)
    (hlen : ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) n).length = n) :
    R.doneAt (R.realizedPattern6 hP s π hcross)
      ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) n) = some (R.firstCrossing s π) := by
  classical
  have htake : ∀ m ≤ n, ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) n).take m =
      (R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) m :=
    fun m hm => hist_take_of_length _ hlen hm
  have hx : ∃ m, m ≤ ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) n).length ∧
      R.PatternDone6 (R.realizedPattern6 hP s π hcross)
        (((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) n).take m) :=
    ⟨R.firstCrossing s π, by omega, by
      rw [htake _ hn]; exact (R.realizedPattern6_done_iff hP s π hcross _).2 le_rfl⟩
  unfold doneAt
  rw [dif_pos hx]
  congr 1
  apply le_antisymm
  · exact Nat.find_min' hx ⟨by omega, by
      rw [htake _ hn]; exact (R.realizedPattern6_done_iff hP s π hcross _).2 le_rfl⟩
  · have h := Nat.find_spec hx
    rw [htake _ (by omega)] at h
    exact (R.realizedPattern6_done_iff hP s π hcross _).1 h.2

/-- Each realized name's field names its seed's charged step. -/
theorem stepOf6_realized (i : Fin (R.realizedSeeds s π).card) :
    R.stepOf6 (R.realizedPattern6 hP s π hcross) (R.realizedName6 hP s π hcross i).1
      ((R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π)
        (R.stepAt6 s π i)) = some (R.stepAt6 s π i) := by
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  obtain ⟨q, hq, -, -⟩ := R.stepAt6_sound hP s π hcross i
  have hh := R.stratP6_realized_hist_eq hP s π hcross
  have hlen := (R.stratP6 _).length_hist_of_next hq
  have hf : (R.realizedName6 hP s π hcross i).1.val =
      R.stepField (R.firstCrossing s π) (R.stepAt6 s π i) := rfl
  unfold stepOf6
  by_cases hn : R.stepAt6 s π i < R.firstCrossing s π
  · obtain ⟨hsf, hlt⟩ := R.stepField_adv hP hcut hn
    rw [hf, hsf, if_pos hlt]
  · rw [hf, R.stepField_lab hn, if_neg (by omega), hh]
    rw [hh] at hlen
    rw [R.doneAt_realized hP s π hcross (by omega) hlen]
    simp only [Option.map_some]
    congr 1
    omega

theorem histCons_of_hist (S : Strategy (BandAlpha ℓ c)) (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (n : ℕ) :
    R.HistCons π (S.hist (fun _ : Unit => π) n) :=
  fun _ he => S.mem_hist he

set_option maxHeartbeats 4000000 in
/-- **Fiber determinacy.** Two oracles realizing the same pattern, with one history before a
named step, pin the same part of that step's answer to the same value. -/
theorem v6_fiber_det {P : R.V6Pattern} {π π₀ : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hr : R.Realizes6 hP s P π) (hr₀ : R.Realizes6 hP s P π₀) {n : ℕ}
    (hh : (R.stratP6 P).hist (fun _ : Unit => π) n = (R.stratP6 P).hist (fun _ : Unit => π₀) n)
    {nm : Fin (nPos B R.Q) × R.V6SeedName} (hnm : nm ∈ P.names)
    (hstep : R.stepOf6 P nm.1 ((R.stratP6 P).hist (fun _ : Unit => π) n) = some n) :
    ∃ q, (R.stratP6 P).next ((R.stratP6 P).hist (fun _ : Unit => π) n) = some q ∧
      Fresh ((R.stratP6 P).hist (fun _ : Unit => π) n) q ∧
      R.decodedPart P π nm ((R.stratP6 P).hist (fun _ : Unit => π) n) =
        R.decodedPart P π₀ nm ((R.stratP6 P).hist (fun _ : Unit => π) n) ∧
      coordEq (R.decodedPart P π nm ((R.stratP6 P).hist (fun _ : Unit => π) n))
        (ans (fun _ : Unit => π) q) (ans (fun _ : Unit => π₀) q) := by
  classical
  obtain ⟨hcross, hnc, rfl⟩ := hr
  obtain ⟨hcross₀, hnc₀, hP₀⟩ := hr₀
  obtain ⟨i, rfl⟩ := (List.mem_ofFn).1 hnm
  have hnm₀ : R.realizedName6 hP s π hcross i ∈ (R.realizedPattern6 hP s π₀ hcross₀).names := by
    rw [hP₀]; exact hnm
  obtain ⟨i₀, hi₀⟩ := (List.mem_ofFn).1 hnm₀
  set S := R.stratP6 (R.realizedPattern6 hP s π hcross) with hS
  have hni : n = R.stepAt6 s π i :=
    R.stepOf6_uniq _ S _ _ hstep (R.stepOf6_realized hP s π hcross i)
  have hstep₀ : R.stepOf6 (R.realizedPattern6 hP s π hcross) (R.realizedName6 hP s π hcross i).1
      (S.hist (fun _ : Unit => π₀) n) = some n := by rw [← hh]; exact hstep
  have hr₀' := R.stepOf6_realized hP s π₀ hcross₀ i₀
  rw [hP₀, hi₀] at hr₀'
  have hn₀ : n = R.stepAt6 s π₀ i₀ := R.stepOf6_uniq _ S _ _ hstep₀ hr₀'
  have hhist := R.stratP6_realized_hist_eq hP s π hcross
  have hhist₀ := R.stratP6_realized_hist_eq hP s π₀ hcross₀
  rw [hP₀] at hhist₀
  obtain ⟨q, hq, hfr, hsound⟩ := R.stepAt6_sound hP s π hcross i
  obtain ⟨q₀, hq₀, -, hsound₀⟩ := R.stepAt6_sound hP s π₀ hcross₀ i₀
  rw [hP₀] at hq₀
  rw [← hS] at hq hfr hq₀
  rw [← hni] at hq hfr hsound
  rw [← hn₀] at hq₀ hsound₀
  have hqq : q₀ = q := by
    rw [← hh] at hq₀
    exact Option.some.inj (hq₀.symm.trans hq)
  subst q₀
  refine ⟨q, hq, hfr, ?_⟩
  obtain ⟨q', hq', -, hpart, hpin, τ, hτD, hτn, hτc, hacc⟩ := hsound
  obtain ⟨q'', hq'', -, -, hpin₀, -⟩ := hsound₀
  have hq'eq : q' = q := by
    have := next_of_hist_eq hhist hq'
    exact Option.some.inj (this.symm.trans hq)
  have hq''eq : q'' = q := by
    have := next_of_hist_eq hhist₀ hq''
    rw [← hh] at this
    exact Option.some.inj (this.symm.trans hq)
  subst q'
  subst q''
  -- the two names coincide componentwise
  have hcode : R.v6Code hP s π₀ hcross₀ (R.seedAtIndex s π₀ i₀) =
      R.v6Code hP s π hcross (R.seedAtIndex s π i) := by
    have h1 := congrArg (fun nm => nm.2.1) hi₀
    have h2 := congrArg (fun nm => nm.2.2.2) hi₀
    exact Prod.ext h1 h2
  have hptr : R.v6Ptr hP s π₀ hcross₀ (R.seedAtIndex s π₀ i₀) =
      R.v6Ptr hP s π hcross (R.seedAtIndex s π i) := congrArg (fun nm => nm.2.2.1) hi₀
  rw [hcode, hptr] at hpin₀
  -- the histories of the two program prefixes agree through `min n cut`
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  have hcut₀ : R.firstCrossing s π₀ ≤ R.programSteps π₀ := R.firstCrossing_le s π₀ hcross₀
  have hlen : (S.hist (fun _ : Unit => π) n).length = n := S.length_hist_of_next hq
  have hdone : ∀ ρ (hc : ∃ cut ≤ R.programSteps ρ, R.crosses s ρ cut),
      R.realizedPattern6 hP s ρ hc = R.realizedPattern6 hP s π hcross →
      (R.PatternDone6 (R.realizedPattern6 hP s π hcross) (S.hist (fun _ : Unit => ρ) n) ↔
        R.firstCrossing s ρ ≤ n) := by
    intro ρ hc hPe
    have := R.stratP6_realized_hist_eq hP s ρ hc
    rw [hPe] at this
    rw [this, ← hPe]
    exact R.realizedPattern6_done_iff hP s ρ hc n
  have hiff : R.firstCrossing s π ≤ n ↔ R.firstCrossing s π₀ ≤ n := by
    rw [← hdone π hcross rfl, ← hdone π₀ hcross₀ hP₀, hh]
  obtain ⟨m, hmn, hmc, hA⟩ : ∃ m, m ≤ n ∧ m ≤ R.firstCrossing s π ∧
      R.advThenLab.hist (fun _ : Unit => π₀) m = R.advThenLab.hist (fun _ : Unit => π) m ∧
      (R.roundStart π τ ≤ m) := by
    by_cases hn : n < R.firstCrossing s π
    · have hn₀ : n < R.firstCrossing s π₀ := by
        by_contra h
        have := hiff.2 (by omega)
        omega
      refine ⟨n, le_rfl, hn.le, ?_, hτn⟩
      rw [← R.stratC_hist_le (π := fun _ : Unit => π₀)
          (by rw [← R.programSteps_eq_advSched]; exact hcut₀) n hn₀.le,
        ← R.stratC_hist_le (π := fun _ : Unit => π)
          (by rw [← R.programSteps_eq_advSched]; exact hcut) n hn.le,
        ← hhist, ← hhist₀, hh]
    · have hge : R.firstCrossing s π ≤ n := by omega
      have hge₀ := hiff.1 hge
      have hlen' : ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) n).length = n := by
        rw [← hhist]; exact hlen
      have hlen₀ : ((R.stratC (R.firstCrossing s π₀)).hist (fun _ : Unit => π₀) n).length = n := by
        rw [← hhist₀, ← hh]; exact hlen
      have hd := R.doneAt_realized hP s π hcross hge hlen'
      have hd₀ := R.doneAt_realized hP s π₀ hcross₀ hge₀ hlen₀
      rw [hP₀, ← hhist₀, ← hh, hhist] at hd₀
      have hcc : R.firstCrossing s π₀ = R.firstCrossing s π :=
        Option.some.inj (hd₀.symm.trans hd)
      refine ⟨R.firstCrossing s π, hge, le_rfl, ?_, hτc⟩
      have e1 := R.stratC_hist_le (π := fun _ : Unit => π)
        (by rw [← R.programSteps_eq_advSched]; exact hcut) _ (le_refl (R.firstCrossing s π))
      have e1₀ := R.stratC_hist_le (π := fun _ : Unit => π₀)
        (by rw [← R.programSteps_eq_advSched]; exact hcut₀) _ (le_refl (R.firstCrossing s π₀))
      have e2 := hist_take_of_length _ hlen' hge
      have e2₀ := hist_take_of_length _ hlen₀ hge₀
      calc R.advThenLab.hist (fun _ : Unit => π₀) (R.firstCrossing s π)
          = R.advThenLab.hist (fun _ : Unit => π₀) (R.firstCrossing s π₀) := by rw [hcc]
        _ = (S.hist (fun _ : Unit => π₀) n).take (R.firstCrossing s π₀) := by
            rw [← e1₀, ← e2₀, hhist₀]
        _ = (S.hist (fun _ : Unit => π) n).take (R.firstCrossing s π) := by rw [hh, hcc]
        _ = R.advThenLab.hist (fun _ : Unit => π) (R.firstCrossing s π) := by
            rw [← e1, ← e2, hhist]
  have hc' : R.HistCons π₀ ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) n) := by
    rw [← hhist, hh]; exact R.histCons_of_hist S π₀ n
  obtain ⟨hdir, hrR, hrH⟩ := R.read_det hP π π₀ hτD hA.2 (hmc.trans hcut) hA.1 hc' _ _ hacc
  have hpf : R.ptrFwd π₀ (R.v6Ptr hP s π hcross (R.seedAtIndex s π i)) =
      R.ptrFwd π (R.v6Ptr hP s π hcross (R.seedAtIndex s π i)) := by
    cases hp : R.v6Ptr hP s π hcross (R.seedAtIndex s π i) with
    | inl o => exact hdir o hp
    | inr _ => rfl
  rw [hpf] at hpin₀
  have hdp : R.decodedPart (R.realizedPattern6 hP s π hcross) π (R.realizedName6 hP s π hcross i)
      (S.hist (fun _ : Unit => π) n) =
      (R.v6Decode (R.v6Code hP s π hcross (R.seedAtIndex s π i)) (qFwd q)
        (R.v6Ptr hP s π hcross (R.seedAtIndex s π i))
        (R.ptrFwd π (R.v6Ptr hP s π hcross (R.seedAtIndex s π i)))).part := by
    simp only [decodedPart, ← hS, hq, qFwdO]
    rfl
  have hdp₀ : R.decodedPart (R.realizedPattern6 hP s π hcross) π₀ (R.realizedName6 hP s π hcross i)
      (S.hist (fun _ : Unit => π) n) =
      (R.v6Decode (R.v6Code hP s π hcross (R.seedAtIndex s π i)) (qFwd q)
        (R.v6Ptr hP s π hcross (R.seedAtIndex s π i))
        (R.ptrFwd π (R.v6Ptr hP s π hcross (R.seedAtIndex s π i)))).part := by
    simp only [decodedPart, ← hS, hq, qFwdO]
    change (R.v6Decode _ _ (R.v6Ptr hP s π hcross (R.seedAtIndex s π i))
      (R.ptrFwd π₀ (R.v6Ptr hP s π hcross (R.seedAtIndex s π i)))).part = _
    rw [hpf]
    rfl
  refine ⟨hdp.trans hdp₀.symm, ?_⟩
  rw [hdp]
  revert hpin hpin₀ hrR hrH
  generalize R.v6Decode (R.v6Code hP s π hcross (R.seedAtIndex s π i)) (qFwd q)
    (R.v6Ptr hP s π hcross (R.seedAtIndex s π i))
    (R.ptrFwd π (R.v6Ptr hP s π hcross (R.seedAtIndex s π i))) = ins
  intro hpin hpin₀ hrR hrH
  unfold PinReads at hpin hpin₀
  unfold coordEq
  rcases hip : ins.part with _ | _
  · rw [hip] at hpin hpin₀
    rw [hpin, hpin₀, hrR]
  · rw [hip] at hpin hpin₀
    rw [hpin, hpin₀, hrH]

end Real

section Targets

variable (hP : ∀ i, (R.P i).Bounded R.D R.Q) (s : ℕ)

open Classical in
/-- The realizing oracle a history is read against, if any. -/
noncomputable def repOf (P : R.V6Pattern) (h : History (BandAlpha ℓ c)) :
    Option (Equiv.Perm (Bits (ℓ + (ℓ + c)))) :=
  if hx : ∃ π, R.Realizes6 hP s P π ∧ (R.stratP6 P).hist (fun _ : Unit => π) h.length = h then
    some (Classical.choose hx)
  else none

theorem repOf_spec {P : R.V6Pattern} {h : History (BandAlpha ℓ c)}
    {π₀ : Equiv.Perm (Bits (ℓ + (ℓ + c)))} (hr : R.repOf hP s P h = some π₀) :
    R.Realizes6 hP s P π₀ ∧ (R.stratP6 P).hist (fun _ : Unit => π₀) h.length = h := by
  classical
  unfold repOf at hr
  split at hr
  · rename_i hx
    obtain rfl := Option.some.inj hr
    exact Classical.choose_spec hx
  · simp at hr

open Classical in
/-- The parts field `f` pins at history `h`. -/
noncomputable def partsAt (P : R.V6Pattern) (f : Fin (nPos B R.Q)) (h : History (BandAlpha ℓ c)) :
    Finset V6Part :=
  match R.repOf hP s P h with
  | some π₀ => ((P.names.filter (fun nm => nm.1 = f)).map
      (fun nm => R.decodedPart P π₀ nm h)).toFinset
  | none => ∅

noncomputable def wAt (P : R.V6Pattern) (f : Fin (nPos B R.Q)) (h : History (BandAlpha ℓ c)) : ℕ :=
  slotWidth (ℓ := ℓ) (c := c) (R.partsAt hP s P f h)

/-- The target of field `f`: its pinned parts of the answer equal the representative's. -/
noncomputable def tgtAt (P : R.V6Pattern) (f : Fin (nPos B R.Q)) (h : History (BandAlpha ℓ c))
    (q : Qry (BandAlpha ℓ c)) : Finset (BandAlpha ℓ c q.1) :=
  match R.repOf hP s P h with
  | some π₀ => slotTarget (fun _ q' => ovR (ans (fun _ : Unit => π₀) q'))
      (fun _ q' => ovH (ans (fun _ : Unit => π₀) q')) (R.partsAt hP s P f h) h q
  | none => ∅

theorem tgtAt_card (P : R.V6Pattern) (nP : ℕ) (f : Fin (nPos B R.Q)) (h : History (BandAlpha ℓ c))
    (q : Qry (BandAlpha ℓ c)) :
    (R.tgtAt hP s P f h q).card * (2 ^ R.wAt hP s P f h - nP) ≤
      Fintype.card (BandAlpha ℓ c q.1) - nP := by
  unfold tgtAt wAt
  cases hr : R.repOf hP s P h with
  | none => simp
  | some π₀ =>
      exact v6_slot_target_le _ _ (R.partsAt hP s P f h) h q nP

set_option maxHeartbeats 4000000 in
/-- **A realizing oracle hits every assigned step and is assigned every field.** -/
theorem realizes6_hits {P : R.V6Pattern} {π : Equiv.Perm (Bits (ℓ + (ℓ + c)))}
    (hr : R.Realizes6 hP s P π) :
    (∀ n < nPos B R.Q, (R.stratP6 P).HitAt (R.assign6 P) (R.tgtAt hP s P) n (fun _ : Unit => π)) ∧
      ∀ f ∈ R.fields6 P, ∃ n < nPos B R.Q,
        R.assign6 P n ((R.stratP6 P).hist (fun _ : Unit => π) n) = some f := by
  classical
  refine ⟨fun n _ f hA => ?_, fun f hf => ?_⟩
  · obtain ⟨hfP, hstep⟩ := R.assign6_spec hA
    obtain ⟨nm, hnm, rfl⟩ : ∃ nm ∈ P.names, nm.1 = f := by
      simpa [fields6] using hfP
    set h := (R.stratP6 P).hist (fun _ : Unit => π) n with hh_def
    obtain ⟨q, hq, hfr, -, -⟩ := R.v6_fiber_det hP s hr hr rfl hnm hstep
    have hlen : h.length = n := (R.stratP6 P).length_hist_of_next hq
    have hx : ∃ π', R.Realizes6 hP s P π' ∧ (R.stratP6 P).hist (fun _ : Unit => π') h.length = h :=
      ⟨π, hr, by rw [hlen]⟩
    obtain ⟨π₀, hrep⟩ : ∃ π₀, R.repOf hP s P h = some π₀ := by
      unfold repOf; rw [dif_pos hx]; exact ⟨_, rfl⟩
    obtain ⟨hr₀, hh₀⟩ := R.repOf_spec hP s hrep
    rw [hlen] at hh₀
    refine ⟨q, hq, hfr, ?_⟩
    unfold tgtAt
    rw [hrep]
    simp only [slotTarget, Finset.mem_filter, Finset.mem_univ, true_and]
    have hpart : ∀ p ∈ R.partsAt hP s P nm.1 h,
        coordEq p (ans (fun _ : Unit => π) q) (ans (fun _ : Unit => π₀) q) := by
      intro p hp
      unfold partsAt at hp
      rw [hrep] at hp
      simp only [List.mem_toFinset, List.mem_map, List.mem_filter, decide_eq_true_eq] at hp
      obtain ⟨nm', ⟨hnm', hf'⟩, rfl⟩ := hp
      have hstep' : R.stepOf6 P nm'.1 h = some n := by rw [hf']; exact hstep
      obtain ⟨q', hq', -, hdp, hce⟩ := R.v6_fiber_det hP s hr hr₀ hh₀.symm hnm' hstep'
      rw [hq] at hq'
      obtain rfl := Option.some.inj hq'
      rw [← hdp]
      exact hce
    exact ⟨fun hr' => hpart .r hr', fun hh' => hpart .h hh'⟩
  · obtain ⟨hcross, hnc, rfl⟩ := hr
    obtain ⟨nm, hnm, rfl⟩ : ∃ nm ∈ (R.realizedPattern6 hP s π hcross).names, nm.1 = f := by
      simpa [fields6] using hf
    obtain ⟨i, rfl⟩ := (List.mem_ofFn).1 hnm
    have hstep := R.stepOf6_realized hP s π hcross i
    refine ⟨R.stepAt6 s π i, R.chargePin_step_lt_nPos hP hcross (R.seedAtIndex s π i).2, ?_⟩
    have hx : ∃ f ∈ R.fields6 (R.realizedPattern6 hP s π hcross),
        R.stepOf6 (R.realizedPattern6 hP s π hcross) f
          ((R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π)
            (R.stepAt6 s π i)) = some (R.stepAt6 s π i) :=
      ⟨_, by simp only [fields6, List.mem_toFinset, List.mem_map]; exact ⟨_, hnm, rfl⟩, hstep⟩
    cases hA : R.assign6 (R.realizedPattern6 hP s π hcross) (R.stepAt6 s π i)
        ((R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π)
          (R.stepAt6 s π i)) with
    | none =>
        unfold assign6 at hA
        rw [dif_pos hx] at hA
        simp at hA
    | some f' =>
        obtain ⟨hf'P, hstep'⟩ := R.assign6_spec hA
        obtain ⟨nm', hnm', rfl⟩ : ∃ nm' ∈ (R.realizedPattern6 hP s π hcross).names, nm'.1 = f' := by
          simpa [fields6] using hf'P
        obtain ⟨i', rfl⟩ := (List.mem_ofFn).1 hnm'
        have hii := R.stepOf6_uniq _ _ _ _ hstep' (R.stepOf6_realized hP s π hcross i')
        congr 1
        apply Fin.ext
        change R.stepField (R.firstCrossing s π) (R.stepAt6 s π i') =
          R.stepField (R.firstCrossing s π) (R.stepAt6 s π i)
        rw [hii]

end Targets

end ChainReplay

end PousSpongeChain

end


/-! ════ ChainEPFV6Fibers2 ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# Band v6 (c′): width accounting and the fixed-pattern bound

For an oracle realizing `P`, the widths the fiber pays at each field's own step add up to the
realized seed width (`fields_width_sum`), so `prob_hitsAt_hist_le` and the finite-population
product give `pr (Realizes6 P) ≤ 2·2^{-W}` for any `W` below every realization's seed width.
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain LazyPerm
open Pous.BandChain.KeyRule
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

def partW (ℓ c : ℕ) : V6Part → ℕ
  | .r => ℓ
  | .h => ℓ + c

theorem slotWidth_eq_sum (S : Finset V6Part) :
    slotWidth (ℓ := ℓ) (c := c) S = ∑ p ∈ S, partW ℓ c p := by
  classical
  have hS : S = Finset.univ.filter (· ∈ S) := by ext p; simp
  rw [hS, Finset.sum_filter, show (Finset.univ : Finset V6Part) = {.r, .h} from rfl,
    Finset.sum_insert (by decide), Finset.sum_singleton]
  simp [slotWidth, partW]

theorem atomWidth_eq_partW (a : VAtom B) : atomWidth ℓ c a = partW ℓ c a.part := by
  cases a <;> rfl

section Account

variable (hP : ∀ i, (R.P i).Bounded R.D R.Q) (s : ℕ) (π : Equiv.Perm (Bits (ℓ + (ℓ + c))))
  (hcross : ∃ cut ≤ R.programSteps π, R.crosses s π cut)

theorem decodedPart_realized (i : Fin (R.realizedSeeds s π).card) :
    R.decodedPart (R.realizedPattern6 hP s π hcross) π (R.realizedName6 hP s π hcross i)
      ((R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π) (R.stepAt6 s π i)) =
    (R.seedAtIndex s π i).1.part := by
  obtain ⟨q, hq, -, q', hq', -, hpart, -⟩ := R.stepAt6_sound hP s π hcross i
  have hqq : q' = q := by
    have := next_of_hist_eq (R.stratP6_realized_hist_eq hP s π hcross) hq'
    exact Option.some.inj (this.symm.trans hq)
  subst q'
  unfold decodedPart
  rw [hq]
  exact hpart

/-- The parts of the seeds whose names carry field `f`. -/
noncomputable def partsSeeds (f : Fin (nPos B R.Q)) : Finset V6Part :=
  (Finset.univ.filter (fun i => (R.realizedName6 hP s π hcross i).1 = f)).image
    (fun i => (R.seedAtIndex s π i).1.part)

theorem field_eq_step {i i' : Fin (R.realizedSeeds s π).card}
    (h : (R.realizedName6 hP s π hcross i).1 = (R.realizedName6 hP s π hcross i').1) :
    R.stepAt6 s π i = R.stepAt6 s π i' :=
  R.stepField_inj hP (R.firstCrossing_le s π hcross) (congrArg Fin.val h)

/-- Two seeds with one field and one part are the same seed. -/
theorem field_part_inj (hnc : R.NoCollU π) {i i' : Fin (R.realizedSeeds s π).card}
    (hf : (R.realizedName6 hP s π hcross i).1 = (R.realizedName6 hP s π hcross i').1)
    (hp : (R.seedAtIndex s π i).1.part = (R.seedAtIndex s π i').1.part) : i = i' := by
  classical
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  have hstep := R.field_eq_step hP s π hcross hf
  have hva := R.realizedSeed_cell_valid s π (R.seedAtIndex s π i)
  have hva' := R.realizedSeed_cell_valid s π (R.seedAtIndex s π i')
  have hpair := R.pairStep_inj hcut hnc (R.atomValid_pair hva) (R.atomValid_pair hva') hstep
  have hcp : R.chargePin (R.firstCrossing s π) π (R.seedAtIndex s π i).1 =
      R.chargePin (R.firstCrossing s π) π (R.seedAtIndex s π i').1 := by
    simp only [chargePin, hpair, R.pinCell_part, hp]
  have haa := R.v6_charge_pin_injective s π hcross hnc (R.seedAtIndex s π i).2
    (R.seedAtIndex s π i').2 hcp
  apply (Finset.equivFin (R.realizedSeeds s π)).symm.injective
  exact Subtype.ext haa

theorem mem_fields6_realized {f : Fin (nPos B R.Q)} :
    f ∈ R.fields6 (R.realizedPattern6 hP s π hcross) ↔
      ∃ i, (R.realizedName6 hP s π hcross i).1 = f := by
  simp only [fields6, realizedPattern6, List.mem_toFinset, List.mem_map, List.mem_ofFn']
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i, rfl⟩
  · rintro ⟨i, rfl⟩; exact ⟨_, ⟨i, rfl⟩, rfl⟩

/-- **Width accounting.** The fields' slot widths add up to the realized seed width. -/
theorem fields_width_sum (hnc : R.NoCollU π) :
    ∑ f ∈ R.fields6 (R.realizedPattern6 hP s π hcross),
        slotWidth (ℓ := ℓ) (c := c) (R.partsSeeds hP s π hcross f) =
      ∑ a ∈ R.realizedSeeds s π, atomWidth ℓ c a := by
  classical
  have hre : ∑ a ∈ R.realizedSeeds s π, atomWidth ℓ c a =
      ∑ i : Fin (R.realizedSeeds s π).card, atomWidth ℓ c (R.seedAtIndex s π i).1 := by
    rw [← Finset.sum_coe_sort]
    exact (Fintype.sum_equiv (Finset.equivFin (R.realizedSeeds s π)).symm _ _
      (fun _ => rfl)).symm
  rw [hre, ← Finset.sum_fiberwise_of_maps_to (s := Finset.univ)
    (t := R.fields6 (R.realizedPattern6 hP s π hcross))
    (g := fun i => (R.realizedName6 hP s π hcross i).1)
    (fun i _ => (R.mem_fields6_realized hP s π hcross).2 ⟨i, rfl⟩)]
  refine Finset.sum_congr rfl fun f _ => ?_
  rw [slotWidth_eq_sum, partsSeeds, Finset.sum_image]
  · exact Finset.sum_congr rfl fun i _ => (atomWidth_eq_partW _).symm
  · intro i hi i' hi' hp
    simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hi hi'
    exact R.field_part_inj hP s π hcross hnc (hi.trans hi'.symm) hp

set_option maxHeartbeats 2000000 in
/-- At a field's step, the representative's decoded parts are the realized seeds' parts. -/
theorem partsAt_realized (hnc : R.NoCollU π) {f : Fin (nPos B R.Q)} {n : ℕ}
    (hf : f ∈ R.fields6 (R.realizedPattern6 hP s π hcross))
    (hstep : R.stepOf6 (R.realizedPattern6 hP s π hcross) f
      ((R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π) n) = some n) :
    R.partsAt hP s (R.realizedPattern6 hP s π hcross) f
        ((R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π) n) =
      R.partsSeeds hP s π hcross f := by
  classical
  have hr : R.Realizes6 hP s (R.realizedPattern6 hP s π hcross) π := ⟨hcross, hnc, rfl⟩
  obtain ⟨i, rfl⟩ := (R.mem_fields6_realized hP s π hcross).1 hf
  have hni : n = R.stepAt6 s π i :=
    R.stepOf6_uniq _ _ _ _ hstep (R.stepOf6_realized hP s π hcross i)
  subst hni
  set h := (R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π)
    (R.stepAt6 s π i) with hh_def
  obtain ⟨q, hq, -⟩ := R.stepAt6_sound hP s π hcross i
  have hlen : h.length = R.stepAt6 s π i := (R.stratP6 _).length_hist_of_next hq
  have hx : ∃ π', R.Realizes6 hP s (R.realizedPattern6 hP s π hcross) π' ∧
      (R.stratP6 (R.realizedPattern6 hP s π hcross)).hist (fun _ : Unit => π') h.length = h :=
    ⟨π, hr, by rw [hlen]⟩
  obtain ⟨π₀, hrep⟩ : ∃ π₀, R.repOf hP s (R.realizedPattern6 hP s π hcross) h = some π₀ := by
    unfold repOf; rw [dif_pos hx]; exact ⟨_, rfl⟩
  obtain ⟨hr₀, hh₀⟩ := R.repOf_spec hP s hrep
  rw [hlen] at hh₀
  unfold partsAt
  rw [hrep]
  ext p
  simp only [List.mem_toFinset, List.mem_map, List.mem_filter, decide_eq_true_eq, partsSeeds,
    Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨nm, ⟨hnm, hf'⟩, rfl⟩
    obtain ⟨i', rfl⟩ := (List.mem_ofFn).1 hnm
    refine ⟨i', hf', ?_⟩
    have hstep' : R.stepOf6 (R.realizedPattern6 hP s π hcross) (R.realizedName6 hP s π hcross i').1
        h = some (R.stepAt6 s π i) := by rw [hf']; exact hstep
    obtain ⟨-, -, -, hdp, -⟩ := R.v6_fiber_det hP s hr hr₀ hh₀.symm hnm hstep'
    rw [← hh_def] at hdp
    rw [← hdp, hh_def, R.field_eq_step hP s π hcross hf'.symm]
    exact (R.decodedPart_realized hP s π hcross i').symm
  · rintro ⟨i', hf', rfl⟩
    have hnm : R.realizedName6 hP s π hcross i' ∈ (R.realizedPattern6 hP s π hcross).names :=
      (List.mem_ofFn).2 ⟨i', rfl⟩
    refine ⟨_, ⟨hnm, hf'⟩, ?_⟩
    have hstep' : R.stepOf6 (R.realizedPattern6 hP s π hcross) (R.realizedName6 hP s π hcross i').1
        h = some (R.stepAt6 s π i) := by rw [hf']; exact hstep
    obtain ⟨-, -, -, hdp, -⟩ := R.v6_fiber_det hP s hr hr₀ hh₀.symm hnm hstep'
    rw [← hh_def] at hdp
    rw [← hdp, hh_def, R.field_eq_step hP s π hcross hf'.symm]
    exact R.decodedPart_realized hP s π hcross i'

theorem slotWidth_ge {S : Finset V6Part} (hS : S.Nonempty) : ℓ ≤ slotWidth (ℓ := ℓ) (c := c) S := by
  rw [slotWidth_eq_sum]
  obtain ⟨p, hp⟩ := hS
  refine le_trans ?_ (Finset.single_le_sum (fun _ _ => Nat.zero_le _) hp)
  cases p <;> simp [partW]

theorem partsSeeds_nonempty {f : Fin (nPos B R.Q)}
    (hf : f ∈ R.fields6 (R.realizedPattern6 hP s π hcross)) :
    (R.partsSeeds hP s π hcross f).Nonempty := by
  obtain ⟨i, rfl⟩ := (R.mem_fields6_realized hP s π hcross).1 hf
  exact ⟨_, Finset.mem_image.2 ⟨i, by simp, rfl⟩⟩

/-- With one thread there is one honest pair, so all realized names share one field. -/
theorem fields6_card_B1 (hB : B = 1) :
    (R.fields6 (R.realizedPattern6 hP s π hcross)).card ≤ 1 := by
  classical
  have hpos : ∀ q ∈ R.posSet, q = (⟨0, by omega⟩, 1) := by
    intro q hq
    obtain ⟨h1, h2⟩ := R.mem_posSet.1 hq
    have hnil : (parentsDesc R.G q.1).length = 0 := by
      rw [List.length_eq_zero_iff, List.eq_nil_iff_forall_not_mem]
      intro u hu
      have := parentsDesc_lt R.G hu
      have hu1 := u.isLt
      have hq1 := q.1.isLt
      change u.val < q.1.val at this
      omega
    have hc : ovCalls R.G q.1 = 1 := by unfold ovCalls; omega
    ext
    · have := q.1.isLt; simp; omega
    · simp; omega
  rw [Finset.card_le_one]
  intro f hf f' hf'
  obtain ⟨i, rfl⟩ := (R.mem_fields6_realized hP s π hcross).1 hf
  obtain ⟨i', rfl⟩ := (R.mem_fields6_realized hP s π hcross).1 hf'
  apply Fin.ext
  change R.stepField (R.firstCrossing s π) (R.stepAt6 s π i) =
    R.stepField (R.firstCrossing s π) (R.stepAt6 s π i')
  have hv := R.atomValid_pair (R.realizedSeed_cell_valid s π (R.seedAtIndex s π i))
  have hv' := R.atomValid_pair (R.realizedSeed_cell_valid s π (R.seedAtIndex s π i'))
  unfold stepAt6
  simp only [chargePin]
  rw [hpos _ hv, hpos _ hv']

end Account

/-- One slot pays at most twice its ideal factor once `2·nPos ≤ 2^ℓ`. -/
theorem v6_fp_small {ι : Type} [DecidableEq ι] (Z : Finset ι) (w : ι → ℕ) (nP ℓ : ℕ)
    (hw : ∀ z ∈ Z, ℓ ≤ w z) (hcard : Z.card ≤ 1) (hpop : 2 * nP ≤ 2 ^ ℓ) :
    ∏ z ∈ Z, (((2 ^ w z - nP : ℕ) : ℝ≥0∞))⁻¹ ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ (∑ z ∈ Z, w z) := by
  rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hcard with h0 | h1
  · rw [Finset.card_eq_zero.1 h0]
    simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, mul_one]
    norm_num
  · obtain ⟨z, rfl⟩ := Finset.card_eq_one.1 h1
    simp only [Finset.prod_singleton, Finset.sum_singleton]
    have hwz := hw z (Finset.mem_singleton_self z)
    have hle : 2 ^ ℓ ≤ 2 ^ w z := Nat.pow_le_pow_right (by norm_num) hwz
    rcases Nat.eq_zero_or_pos nP with rfl | hnP
    · simp only [Nat.sub_zero, Nat.cast_pow, Nat.cast_ofNat, ENNReal.inv_pow]
      exact le_mul_of_one_le_left' (by norm_num)
    · have hw1 : 1 ≤ w z := by
        by_contra h
        have : w z = 0 := by omega
        rw [this] at hle
        omega
      obtain ⟨k, hk⟩ : ∃ k, w z = k + 1 := ⟨w z - 1, by omega⟩
      rw [hk] at hle ⊢
      have hkey : 2 ^ k ≤ 2 ^ (k + 1) - nP := by rw [pow_succ]; omega
      calc (((2 ^ (k + 1) - nP : ℕ) : ℝ≥0∞))⁻¹
          ≤ (((2 ^ k : ℕ) : ℝ≥0∞))⁻¹ := ENNReal.inv_le_inv.2 (by exact_mod_cast hkey)
        _ = 2 * (2⁻¹ : ℝ≥0∞) ^ (k + 1) := by
            have h2 : (2 : ℝ≥0∞) * (2⁻¹) ^ (k + 1) = (2⁻¹) ^ k := by
              rw [pow_succ, mul_comm ((2 : ℝ≥0∞)⁻¹ ^ k), ← mul_assoc,
                ENNReal.mul_inv_cancel two_ne_zero ENNReal.ofNat_ne_top, one_mul]
            rw [h2, ← ENNReal.inv_pow, Nat.cast_pow, Nat.cast_ofNat]

set_option maxHeartbeats 2000000 in
/-- **The fixed-pattern bound.** Realizing a (c′) pattern whose realizations all have seed width at
least `W` costs at most `2·2^{-W}`. -/
theorem prob_realizes6_le (hP : ∀ i, (R.P i).Bounded R.D R.Q) (s : ℕ) (P : R.V6Pattern) (W : ℕ)
    (hW : ∀ π, R.Realizes6 hP s P π → W ≤ ∑ a ∈ R.realizedSeeds s π, atomWidth ℓ c a)
    (hpop : 4 * nPos B R.Q ^ 2 ≤ 2 ^ ℓ ∨ (B = 1 ∧ 2 * nPos B R.Q ≤ 2 ^ ℓ)) :
    Pous.pr (R.Realizes6 hP s P) ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ W := by
  classical
  rw [v6_pr_eq_prob]
  refine (R.stratP6 P).prob_hitsAt_hist_le (R.fields6 P) (R.assign6 P) (R.tgtAt hP s P)
    (R.wAt hP s P) (nPos B R.Q) (fun n h k hk => (R.assign6_spec hk).1) (R.assign6_uniq P _)
    (fun κ h q => R.tgtAt_card hP s P _ κ h q) _ ?_ _ ?_
  · intro ω hω
    have hωe : ω = fun _ : Unit => ω () := funext fun u => by cases u; rfl
    rw [hωe]
    exact R.realizes6_hits hP s hω
  · intro ω hω
    have hωe : ω = fun _ : Unit => ω () := funext fun u => by cases u; rfl
    rw [hωe]
    have hW' := hW _ hω
    obtain ⟨hcross, hnc, rfl⟩ := hω
    have hwf : ∀ f ∈ R.fields6 (R.realizedPattern6 hP s (ω ()) hcross),
        R.wAt hP s (R.realizedPattern6 hP s (ω ()) hcross) f
          ((R.stratP6 (R.realizedPattern6 hP s (ω ()) hcross)).hist (fun _ : Unit => ω ())
            ((R.stratP6 (R.realizedPattern6 hP s (ω ()) hcross)).assignStep
              (R.assign6 (R.realizedPattern6 hP s (ω ()) hcross)) f (fun _ : Unit => ω ()))) =
        slotWidth (ℓ := ℓ) (c := c) (R.partsSeeds hP s (ω ()) hcross f) := by
      intro f hf
      obtain ⟨-, hall⟩ := R.realizes6_hits hP s ⟨hcross, hnc, rfl⟩
      obtain ⟨n, -, hA⟩ := hall f hf
      rw [(R.stratP6 _).assignStep_eq (R.assign6_uniq _ _) hA]
      unfold wAt
      rw [R.partsAt_realized hP s (ω ()) hcross hnc hf (R.assign6_spec hA).2]
    rw [Finset.prod_congr rfl (fun f hf => by rw [hwf f hf])]
    have hsum := R.fields_width_sum hP s (ω ()) hcross hnc
    have hwge : ∀ f ∈ R.fields6 (R.realizedPattern6 hP s (ω ()) hcross),
        ℓ ≤ slotWidth (ℓ := ℓ) (c := c) (R.partsSeeds hP s (ω ()) hcross f) :=
      fun f hf => slotWidth_ge (R.partsSeeds_nonempty hP s (ω ()) hcross hf)
    have hfp : ∏ f ∈ R.fields6 (R.realizedPattern6 hP s (ω ()) hcross),
        (((2 ^ slotWidth (ℓ := ℓ) (c := c) (R.partsSeeds hP s (ω ()) hcross f) - nPos B R.Q : ℕ) :
          ℝ≥0∞))⁻¹ ≤
        2 * (2⁻¹ : ℝ≥0∞) ^ (∑ f ∈ R.fields6 (R.realizedPattern6 hP s (ω ()) hcross),
          slotWidth (ℓ := ℓ) (c := c) (R.partsSeeds hP s (ω ()) hcross f)) := by
      rcases hpop with hpop | ⟨hB1, hpop⟩
      · exact v6_finite_population_product_le _ _ _ ℓ hwge
          (by simpa using Finset.card_le_univ (R.fields6 (R.realizedPattern6 hP s (ω ()) hcross)))
          hpop
      · exact v6_fp_small _ _ _ ℓ hwge (R.fields6_card_B1 hP s (ω ()) hcross hB1) hpop
    refine hfp.trans ?_
    rw [hsum]
    exact mul_le_mul_right (pow_le_pow_right_of_le_one' (by norm_num) hW') 2

