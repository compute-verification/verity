/-! ════ Thm1.Theorem1iiSeq ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# Report Theorem 1(ii), sequential: `PousTargetsChain.theorem1_ii_seq`, as drafted

For a history `h` of fewer than `k` indices, `st h` is the state the responder reaches after answering `h`, and
round `|h|` predicts block `i` by `step |h| (st h) i`, a `(D, Q)`-bounded program. `E` is the event that, for
some history, the wrong predictions fit: `S + B + #wrong·ℓ ≤ β`.

1. Off `E`, every round is answered correctly with probability at most `p₀` given any history
   (`pr_good_le_p₀`). The chain rule over the `k` rounds (`pr_seq_le`) gives `p₀^k`, and conditioning on the
   setup (`pr_prod_le`) gives `Pr[accept] ≤ Pr[E] + p₀^k`.
2. For each fixed history, the patch compressor (`pr_fits_le`: the state and the wrong blocks, a `β`-bit code
   by counting) against `TimedINC` bounds the event by `π`. A union bound over the `B^j` histories of each
   length `j < k` (`pr_exists_le`) gives `Pr[E] ≤ (Σ_{j<k} B^j)·π`.
-/

namespace PousThm1Chain

open Pous
open scoped ENNReal

/-! ### Uniform probability -/

/-- `pr` does not depend on how the sample space is labelled. -/
theorem pr_equiv {α β : Type} [Fintype α] [Fintype β] (e : α ≃ β) (P : β → Prop) :
    pr (fun a => P (e a)) = pr P := by
  classical
  rw [pr_def, pr_def, Fintype.card_congr e]
  congr 2
  rw [← Fintype.card_subtype, ← Fintype.card_subtype]
  exact Fintype.card_congr (e.subtypeEquiv fun _ => Iff.rfl)

theorem pr_le_one {α : Type} [Fintype α] (P : α → Prop) : pr P ≤ 1 := by
  classical
  rw [pr_def]
  refine ENNReal.div_le_of_le_mul ?_
  rw [one_mul]
  exact_mod_cast (Finset.card_filter_le _ _).trans (Finset.card_univ).le

/-- **Union bound.** -/
theorem pr_exists_le {α ι : Type} [Fintype α] (s : Finset ι) (P : ι → α → Prop) :
    pr (fun a => ∃ x ∈ s, P x a) ≤ ∑ x ∈ s, pr (P x) := by
  classical
  simp only [pr_def, div_eq_mul_inv]
  rw [← Finset.sum_mul]
  gcongr
  have : (Finset.univ.filter fun a => ∃ x ∈ s, P x a) = s.biUnion fun x => Finset.univ.filter (P x) := by
    ext a; simp
  rw [this]
  exact_mod_cast Finset.card_biUnion_le

/-- **Conditioning on the first coordinate.** If every fibre off `E` has probability at most `c`, the product event
has probability at most `Pr[E] + c`. -/
theorem pr_prod_le {α β : Type} [Fintype α] [Fintype β] [Nonempty α] [Nonempty β]
    (P : α → β → Prop) (E : α → Prop) (c : ℝ≥0∞) (h : ∀ a, ¬ E a → pr (P a) ≤ c) :
    pr (fun x : α × β => P x.1 x.2) ≤ pr E + c := by
  classical
  have hα0 : (Fintype.card α : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hβ0 : (Fintype.card β : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hαt : (Fintype.card α : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hβt : (Fintype.card β : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hfib : ∀ a, ((Finset.univ.filter (P a)).card : ℝ≥0∞) ≤
      (if E a then 1 else 0) * Fintype.card β + c * Fintype.card β := by
    intro a
    by_cases ha : E a
    · simp only [ha, ite_true, one_mul]
      refine le_add_right ?_
      exact_mod_cast (Finset.card_filter_le _ _).trans (Finset.card_univ).le
    · simp only [ha, ite_false, zero_mul, zero_add]
      have := h a ha
      rwa [pr_def, ENNReal.div_le_iff hβ0 hβt] at this
  have hcount : ((Finset.univ.filter fun x : α × β => P x.1 x.2).card : ℝ≥0∞) =
      ∑ a, ((Finset.univ.filter (P a)).card : ℝ≥0∞) := by
    rw [Finset.natCast_card_filter, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.natCast_card_filter]
  have hE : ((Finset.univ.filter E).card : ℝ≥0∞) = ∑ a, (if E a then 1 else 0 : ℝ≥0∞) :=
    Finset.natCast_card_filter _ _
  rw [pr_def, pr_def, hcount, Fintype.card_prod, Nat.cast_mul, ENNReal.div_le_iff (mul_ne_zero hα0 hβ0)
    (ENNReal.mul_ne_top hαt hβt)]
  calc ∑ a, ((Finset.univ.filter (P a)).card : ℝ≥0∞)
      ≤ ∑ a, ((if E a then 1 else 0) * Fintype.card β + c * Fintype.card β) :=
        Finset.sum_le_sum fun a _ => hfib a
    _ = ((Finset.univ.filter E).card : ℝ≥0∞) * Fintype.card β +
          Fintype.card α * (c * Fintype.card β) := by
        rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← hE, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    _ = (((Finset.univ.filter E).card : ℝ≥0∞) / Fintype.card α + c) *
          (Fintype.card α * Fintype.card β) := by
        rw [add_mul, ← mul_assoc (_ / (Fintype.card α : ℝ≥0∞)), ENNReal.div_mul_cancel hα0 hαt]
        ring

/-- **Chain rule, as a bound.** A first-coordinate event of probability at most `c₁`, then a second-coordinate
event of conditional probability at most `c₂`. -/
theorem pr_and_le {α β : Type} [Fintype α] [Fintype β] [Nonempty α] [Nonempty β]
    (P : α → Prop) (R : α → β → Prop) (c₁ c₂ : ℝ≥0∞) (h₁ : pr P ≤ c₁) (h₂ : ∀ a, pr (R a) ≤ c₂) :
    pr (fun x : α × β => P x.1 ∧ R x.1 x.2) ≤ c₁ * c₂ := by
  classical
  have hα0 : (Fintype.card α : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hβ0 : (Fintype.card β : ℝ≥0∞) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hαt : (Fintype.card α : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hβt : (Fintype.card β : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have hfib : ∀ a, ((Finset.univ.filter fun b => P a ∧ R a b).card : ℝ≥0∞) ≤
      (if P a then 1 else 0) * (c₂ * Fintype.card β) := by
    intro a
    by_cases ha : P a
    · simp only [ha, true_and, ite_true, one_mul]
      have := h₂ a
      rwa [pr_def, ENNReal.div_le_iff hβ0 hβt] at this
    · simp [ha]
  have hcount : ((Finset.univ.filter fun x : α × β => P x.1 ∧ R x.1 x.2).card : ℝ≥0∞) =
      ∑ a, ((Finset.univ.filter fun b => P a ∧ R a b).card : ℝ≥0∞) := by
    rw [Finset.natCast_card_filter, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.natCast_card_filter]
  have hP : ((Finset.univ.filter P).card : ℝ≥0∞) = ∑ a, (if P a then 1 else 0 : ℝ≥0∞) :=
    Finset.natCast_card_filter _ _
  have h1 := h₁
  rw [pr_def, ENNReal.div_le_iff hα0 hαt] at h1
  rw [pr_def, hcount, Fintype.card_prod, Nat.cast_mul, ENNReal.div_le_iff (mul_ne_zero hα0 hβ0)
    (ENNReal.mul_ne_top hαt hβt)]
  calc ∑ a, ((Finset.univ.filter fun b => P a ∧ R a b).card : ℝ≥0∞)
      ≤ ∑ a, (if P a then 1 else 0) * (c₂ * Fintype.card β) := Finset.sum_le_sum fun a _ => hfib a
    _ = ((Finset.univ.filter P).card : ℝ≥0∞) * (c₂ * Fintype.card β) := by rw [← Finset.sum_mul, ← hP]
    _ ≤ (c₁ * Fintype.card α) * (c₂ * Fintype.card β) := by gcongr
    _ = c₁ * c₂ * (Fintype.card α * Fintype.card β) := by ring

/-! ### The threshold `p₀` -/

/-- If `g` of `B` blocks are right and the other `b` do not fit, `S + B + b·ℓ > β`, then `g ≤ p₀·B`. -/
theorem good_le_p₀ (B ℓ β S g b : ℕ) (hB : 0 < B) (hgb : g + b = B) (h : β < S + B + b * ℓ) :
    (g : ℝ) ≤ p₀ β S B ℓ * B := by
  unfold p₀
  rcases Nat.eq_zero_or_pos ℓ with rfl | hℓ
  · simp only [Nat.cast_zero, mul_zero, div_zero, sub_zero, one_mul]
    exact_mod_cast (by omega : g ≤ B)
  · have hB' : (0 : ℝ) < B := by exact_mod_cast hB
    have hℓ' : (0 : ℝ) < ℓ := by exact_mod_cast hℓ
    have hgb' : (g : ℝ) + b = B := by exact_mod_cast hgb
    have h' : (β : ℝ) < S + B + b * ℓ := by exact_mod_cast h
    have key : (1 - ((β : ℝ) - S - B) / (B * ℓ)) * B = B - ((β : ℝ) - S - B) / ℓ := by
      field_simp
    rw [key]
    have : ((β : ℝ) - S - B) / ℓ < b := by
      rw [div_lt_iff₀ hℓ']; linarith
    linarith

open Classical in
/-- One block: if the wrong blocks do not fit, a uniform block is right with probability at most `p₀`. -/
theorem pr_good_le_p₀ (B ℓ β S : ℕ) (hB : 0 < B) (good : Fin B → Prop)
    (h : ¬ S + B + (Finset.univ.filter fun i => ¬ good i).card * ℓ ≤ β) :
    pr good ≤ ENNReal.ofReal (p₀ β S B ℓ) := by
  have hgb := Finset.card_filter_add_card_filter_not (s := Finset.univ) good
  rw [Finset.card_univ, Fintype.card_fin] at hgb
  have hr := good_le_p₀ B ℓ β S _ _ hB hgb (by omega)
  have hB0 : (B : ℝ≥0∞) ≠ 0 := by exact_mod_cast hB.ne'
  rw [pr_def, Fintype.card_fin, ENNReal.div_le_iff hB0 (ENNReal.natCast_ne_top _)]
  calc ((Finset.univ.filter good).card : ℝ≥0∞)
      = ENNReal.ofReal ((Finset.univ.filter good).card : ℝ) := (ENNReal.ofReal_natCast _).symm
    _ ≤ ENNReal.ofReal (p₀ β S B ℓ * B) := ENNReal.ofReal_le_ofReal hr
    _ = ENNReal.ofReal (p₀ β S B ℓ) * B := by
        rw [ENNReal.ofReal_mul' (Nat.cast_nonneg _), ENNReal.ofReal_natCast]

/-! ### Programs -/

/-- Post-process a program's output; the queries are unchanged. -/
def progMap {M : IdealModel} {α β : Type} (g : α → β) : Prog M α → Prog M β
  | .ret a => .ret (g a)
  | .round qs k => .round qs fun as => progMap g (k as)

section progMap

variable {M : IdealModel} {α β : Type} (g : α → β) (f : M.Qry → M.Ans)

theorem run_progMap (p : Prog M α) : (progMap g p).run f = g (p.run f) := by
  induction p with
  | ret a => rfl
  | round qs k ih => exact ih _

theorem depth_progMap (p : Prog M α) : (progMap g p).depth f = p.depth f := by
  induction p with
  | ret a => rfl
  | round qs k ih => exact congrArg (· + 1) (ih _)

theorem work_progMap (p : Prog M α) : (progMap g p).work f = p.work f := by
  induction p with
  | ret a => rfl
  | round qs k ih => exact congrArg (qs.length + ·) (ih _)

theorem bounded_progMap {D Q : ℕ} {p : Prog M α} (h : p.Bounded D Q) : (progMap g p).Bounded D Q :=
  fun ω => by rw [depth_progMap, work_progMap]; exact h ω

end progMap

/-! ### Compression against `TimedINC` -/

/-- **Codes from counting.** A set of at most `2^β` points has a `β`-bit code that decodes every point of it. -/
theorem exists_code {X : Type} [Fintype X] [Nonempty X] (T : Finset X) (β : ℕ) (h : T.card ≤ 2 ^ β) :
    ∃ (c : X → Bits β) (d : Bits β → X), ∀ x ∈ T, d (c x) = x := by
  classical
  obtain ⟨e⟩ := Function.Embedding.nonempty_of_card_le (α := T) (β := Bits β) (by simpa using h)
  refine ⟨fun x => if hx : x ∈ T then e ⟨x, hx⟩ else fun _ => false,
    fun w => if hw : ∃ y, e y = w then hw.choose.1 else Classical.arbitrary X, fun x hx => ?_⟩
  have hex : ∃ y, e y = e ⟨x, hx⟩ := ⟨_, rfl⟩
  simp only [hx, dite_true, hex]
  exact congrArg Subtype.val (e.injective hex.choose_spec)

/-- **Counting patches.** Assignments of an optional `ℓ`-bit block to each of `B` positions, with at most `L` bits
of blocks in total: at most `2^B · 2^L`. -/
theorem card_patches_le (B ℓ L : ℕ) :
    (Finset.univ.filter fun g : Fin B → Option (Bits ℓ) =>
      (Finset.univ.filter fun i => g i ≠ none).card * ℓ ≤ L).card ≤ 2 ^ B * 2 ^ L := by
  classical
  let t : Finset (Fin B) → (i : Fin B) → Finset (Option (Bits ℓ)) := fun D i =>
    if i ∈ D then Finset.univ.erase none else {none}
  have hsub : (Finset.univ.filter fun g : Fin B → Option (Bits ℓ) =>
      (Finset.univ.filter fun i => g i ≠ none).card * ℓ ≤ L) ⊆
      (Finset.univ.filter fun D : Finset (Fin B) => D.card * ℓ ≤ L).biUnion
        fun D => Fintype.piFinset (t D) := by
    intro g hg
    rw [Finset.mem_filter] at hg
    rw [Finset.mem_biUnion]
    refine ⟨Finset.univ.filter fun i => g i ≠ none, by simpa using hg.2, ?_⟩
    rw [Fintype.mem_piFinset]
    intro i
    by_cases hi : g i = none <;> simp [t, hi]
  refine (Finset.card_le_card hsub).trans ((Finset.card_biUnion_le).trans ?_)
  have hD : ∀ D ∈ (Finset.univ.filter fun D : Finset (Fin B) => D.card * ℓ ≤ L),
      (Fintype.piFinset (t D)).card ≤ 2 ^ L := by
    intro D hD
    rw [Finset.mem_filter] at hD
    rw [Fintype.card_piFinset]
    have : ∀ i, (t D i).card = if i ∈ D then 2 ^ ℓ else 1 := by
      intro i
      by_cases hi : i ∈ D
      · simp [t, hi, Finset.card_erase_of_mem, Fintype.card_option]
      · simp [t, hi]
    simp_rw [this]
    rw [Finset.prod_ite_mem, Finset.univ_inter, Finset.prod_const, ← pow_mul]
    exact Nat.pow_le_pow_right (by norm_num) (by rw [mul_comm]; exact hD.2)
  refine (Finset.sum_le_card_nsmul _ _ _ hD).trans ?_
  rw [smul_eq_mul]
  refine Nat.mul_le_mul_right _ ?_
  refine (Finset.card_filter_le _ _).trans ?_
  rw [Finset.card_univ, Fintype.card_finset, Fintype.card_fin]

/-- The compressor's message: the responder's state, and a replacement for each block it gets wrong. -/
abbrev Desc (S B ℓ : ℕ) : Type := Bits S × (Fin B → Option (Bits ℓ))

/-- The messages that fit in `β` bits: `S` for the state, `B` for the set of replaced blocks, `ℓ` per replaced
block. -/
def fits (S B ℓ β : ℕ) : Finset (Desc S B ℓ) :=
  Finset.univ.filter fun x => S + B + (Finset.univ.filter fun i => x.2 i ≠ none).card * ℓ ≤ β

/-- At most `2^β` messages fit: `2^S` states times `2^B·2^(β−S−B)` patches (none if `β < S + B`). -/
theorem card_fits_le (S B ℓ β : ℕ) : (fits S B ℓ β).card ≤ 2 ^ β := by
  by_cases hβ : S + B ≤ β
  · have hsub : fits S B ℓ β ⊆ Finset.univ ×ˢ (Finset.univ.filter fun g : Fin B → Option (Bits ℓ) =>
        (Finset.univ.filter fun i => g i ≠ none).card * ℓ ≤ β - S - B) := by
      intro x hx
      rw [fits, Finset.mem_filter] at hx
      rw [Finset.mem_product, Finset.mem_filter]
      exact ⟨Finset.mem_univ _, Finset.mem_univ _, by omega⟩
    refine (Finset.card_le_card hsub).trans ?_
    rw [Finset.card_product, Finset.card_univ, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
    calc 2 ^ S * _ ≤ 2 ^ S * (2 ^ B * 2 ^ (β - S - B)) := Nat.mul_le_mul_left _ (card_patches_le B ℓ _)
      _ = 2 ^ β := by rw [← pow_add, ← pow_add]; congr 1; omega
  · have : fits S B ℓ β = ∅ := by
      ext x
      rw [fits, Finset.mem_filter]
      simp only [Finset.mem_univ, true_and, Finset.notMem_empty, iff_false]
      omega
    rw [this, Finset.card_empty]
    exact Nat.zero_le _

/-- Replace every block where the prediction `P` differs from `C`. -/
def patch {B ℓ : ℕ} (P C : Fin B → Bits ℓ) : Fin B → Option (Bits ℓ) :=
  fun i => if P i = C i then none else some (C i)

/-- The patched block where there is one, else the prediction: this is `C`. -/
theorem patch_getD {B ℓ : ℕ} (P C : Fin B → Bits ℓ) (i : Fin B) : (patch P C i).getD (P i) = C i := by
  by_cases h : P i = C i <;> simp [patch, h]

/-- If the blocks where `P` differs from `C` fit (`S + B + #wrong·ℓ ≤ β`), so does the message `(σ, patch P C)`. -/
theorem mem_fits_patch {S B ℓ β : ℕ} (σ : Bits S) (P C : Fin B → Bits ℓ) {_ : DecidablePred fun i => ¬ P i = C i}
    (h : S + B + (Finset.univ.filter fun i => ¬ P i = C i).card * ℓ ≤ β) : (σ, patch P C) ∈ fits S B ℓ β := by
  rw [fits, Finset.mem_filter]
  refine ⟨Finset.mem_univ _, ?_⟩
  convert h using 4
  ext i
  by_cases hi : P i = C i <;> simp [patch, hi]

open Classical in
/-- **The timed patch compressor.** Let `st` pick an `S`-bit state from the setup (any function of it) and `pred`
predict each block from `(W, pp, state)` within `(D, Q)`. Then the wrong predictions fit in `β` bits,
`S + B + #wrong·ℓ ≤ β`, with probability at most `π` under `TimedINC D Q β π`. -/
theorem pr_fits_le {M : IdealModel} (sch : Scheme M) (D Q β S : ℕ) (π : ℝ≥0∞) (hinc : TimedINC sch D Q β π)
    (W : Bits sch.n) (st : Bits sch.n → Bits sch.t → sch.Code → M.Ω → Bits S)
    (pred : Bits sch.n → Bits sch.t → Bits S → Fin sch.B → Prog M (Bits sch.ℓ))
    (hpred : ∀ W pp σ i, (pred W pp σ i).Bounded D Q) :
    pr (fun a : M.Ω × sch.Coins => S + sch.B + (Finset.univ.filter fun i =>
      ¬ (pred W (sch.enc W a.1 a.2).1 (st W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) i).run
        (M.answer a.1) = (sch.enc W a.1 a.2).2 i).card * sch.ℓ ≤ β) ≤ π := by
  obtain ⟨c, d, hcd⟩ := exists_code (fits S sch.B sch.ℓ β) β (card_fits_le S sch.B sch.ℓ β)
  let cmp : Bits sch.n → Bits sch.t → sch.Code → M.Ω → Bits β :=
    fun W pp C ω => c (st W pp C ω, patch (fun i => (pred W pp (st W pp C ω) i).run (M.answer ω)) C)
  let exp : Bits sch.n → Bits sch.t → Bits β → Fin sch.B → Prog M (Bits sch.ℓ) :=
    fun W pp w i => ((d w).2 i).elim (pred W pp (d w).1 i) Prog.ret
  have hexp : ∀ W pp w i, (exp W pp w i).Bounded D Q := by
    intro W pp w i
    cases h : (d w).2 i with
    | none => simp only [exp, h, Option.elim]; exact hpred _ _ _ _
    | some b => simp only [exp, h, Option.elim]; exact ret_bounded _ _ _
  refine le_trans (pr_mono fun a ha => ?_) (hinc W cmp exp hexp)
  have hfit := mem_fits_patch (st W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1)
    (fun i => (pred W (sch.enc W a.1 a.2).1 (st W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) i).run
      (M.answer a.1))
    (sch.enc W a.1 a.2).2 ha
  show ∀ i, (exp W _ (cmp W _ _ a.1) i).run (M.answer a.1) = _
  intro i
  simp only [exp, cmp, hcd _ hfit]
  rw [← patch_getD (fun i => (pred W (sch.enc W a.1 a.2).1
    (st W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) i).run (M.answer a.1)) (sch.enc W a.1 a.2).2 i]
  cases patch _ _ i <;> rfl

/-! ### Sequential responders -/

/-- The state a sequential responder reaches after answering the history `h` from round `j` in state `σ`. -/
def seqState {M : IdealModel} {ℓ S B : ℕ} (f : M.Qry → M.Ans)
    (step : ℕ → Bits S → Fin B → Prog M (Bits ℓ × Bits S)) : ℕ → List (Fin B) → Bits S → Bits S
  | _, [], σ => σ
  | j, i :: is, σ => seqState f step (j + 1) is ((step j σ i).run f).2

/-- **Chain rule for sequential audits.** If after every history of fewer than `k` indices a uniform next index is
answered correctly with probability at most `c`, all `k` rounds are with probability at most `c^k`. -/
theorem pr_seq_le {M : IdealModel} {ℓ S B : ℕ} [NeZero B] (f : M.Qry → M.Ans)
    (step : ℕ → Bits S → Fin B → Prog M (Bits ℓ × Bits S)) (C : Fin B → Bits ℓ) (c : ℝ≥0∞) :
    ∀ (k j : ℕ) (σ : Bits S),
      (∀ h : List (Fin B), h.length < k →
        pr (fun i : Fin B => ((step (j + h.length) (seqState f step j h σ) i).run f).1 = C i) ≤ c) →
      pr (fun I : Fin k → Fin B => seqAnswers f step j (List.ofFn I) σ = List.ofFn fun t => C (I t)) ≤ c ^ k
  | 0, _, _, _ => by rw [pow_zero]; exact pr_le_one _
  | k + 1, j, σ, hyp => by
      rw [← pr_equiv (Fin.consEquiv fun _ : Fin (k + 1) => Fin B :
        Fin B × (Fin k → Fin B) ≃ (Fin (k + 1) → Fin B))]
      simp only [Fin.consEquiv_apply, List.ofFn_succ, Fin.cons_zero, Fin.cons_succ, seqAnswers, List.cons.injEq]
      rw [pow_succ']
      refine pr_and_le (α := Fin B) (β := Fin k → Fin B) (fun i₀ => ((step j σ i₀).run f).1 = C i₀)
        (fun i₀ I => seqAnswers f step (j + 1) (List.ofFn fun i => I i) ((step j σ i₀).run f).2 =
          List.ofFn fun i => C (I i)) c (c ^ k) ?_ fun i₀ => ?_
      · simpa [seqState] using hyp [] (Nat.succ_pos k)
      · refine pr_seq_le f step C c k (j + 1) _ fun h hh => ?_
        have := hyp (i₀ :: h) (by simp only [List.length_cons]; omega)
        simpa [seqState, Nat.add_assoc, Nat.add_comm 1] using this

end PousThm1Chain

namespace PousTargetsChain

open Pous PousThm1Chain
open scoped ENNReal

/-- Theorem 1(ii) for stateful sequential responders: one compressor per history of fewer than `k` indices, then a
union bound (the plug-in of tradeoff Theorem 1). -/
theorem theorem1_ii_seq {M : IdealModel} (sch : Scheme M) (D Q β S k : ℕ) (π : ℝ≥0∞)
    (hinc : TimedINC sch D Q β π) (W : Bits sch.n) (A₁ : Preprocessor sch S) (A₂ : SeqResponder sch S D Q) :
    pr (seqAccepts sch k W A₁ A₂) ≤
      (∑ j ∈ Finset.range k, (sch.B : ℝ≥0∞) ^ j) * π + ENNReal.ofReal (p₀ β S sch.B sch.ℓ) ^ k := by
  classical
  -- the state after history `h`, and whether round `|h|` answers block `i` correctly from it
  let st : List (Fin sch.B) → Bits sch.n → Bits sch.t → sch.Code → M.Ω → Bits S :=
    fun h W pp C ω => seqState (M.answer ω) (A₂.step W pp) 0 h (A₁ W pp C ω)
  let pred : List (Fin sch.B) → Bits sch.n → Bits sch.t → Bits S → Fin sch.B → Prog M (Bits sch.ℓ) :=
    fun h W pp σ i => progMap Prod.fst (A₂.step W pp h.length σ i)
  let good : List (Fin sch.B) → M.Ω × sch.Coins → Fin sch.B → Prop := fun h a i =>
    (pred h W (sch.enc W a.1 a.2).1 (st h W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) i).run
      (M.answer a.1) = (sch.enc W a.1 a.2).2 i
  let E : M.Ω × sch.Coins → Prop := fun a => ∃ j ∈ Finset.range k, ∃ v ∈ (Finset.univ : Finset (Fin j → Fin sch.B)),
    S + sch.B + (Finset.univ.filter fun i => ¬ good (List.ofFn v) a i).card * sch.ℓ ≤ β
  have hre : pr (seqAccepts sch k W A₁ A₂) = pr (fun x : (M.Ω × sch.Coins) × (Fin k → Fin sch.B) =>
      seqAnswers (M.answer x.1.1) (A₂.step W (sch.enc W x.1.1 x.1.2).1) 0 (List.ofFn x.2)
        (A₁ W (sch.enc W x.1.1 x.1.2).1 (sch.enc W x.1.1 x.1.2).2 x.1.1) =
      List.ofFn fun t => (sch.enc W x.1.1 x.1.2).2 (x.2 t)) :=
    pr_equiv (Equiv.prodAssoc _ _ _).symm (fun x : (M.Ω × sch.Coins) × (Fin k → Fin sch.B) =>
      seqAnswers (M.answer x.1.1) (A₂.step W (sch.enc W x.1.1 x.1.2).1) 0 (List.ofFn x.2)
        (A₁ W (sch.enc W x.1.1 x.1.2).1 (sch.enc W x.1.1 x.1.2).2 x.1.1) =
      List.ofFn fun t => (sch.enc W x.1.1 x.1.2).2 (x.2 t))
  rw [hre]
  have : Nonempty (Fin sch.B) := ⟨⟨0, sch.B_pos⟩⟩
  refine (pr_prod_le (α := M.Ω × sch.Coins) (β := Fin k → Fin sch.B)
    (fun a I => seqAnswers (M.answer a.1) (A₂.step W (sch.enc W a.1 a.2).1) 0 (List.ofFn I)
        (A₁ W (sch.enc W a.1 a.2).1 (sch.enc W a.1 a.2).2 a.1) =
      List.ofFn fun t => (sch.enc W a.1 a.2).2 (I t))
    E (ENNReal.ofReal (p₀ β S sch.B sch.ℓ) ^ k) fun a ha => ?_).trans (add_le_add ?_ le_rfl)
  · -- no history's wrong blocks fit: every round is right with probability at most `p₀`
    refine pr_seq_le _ _ _ _ k 0 _ fun h hh => ?_
    have hnf : ¬ S + sch.B + (Finset.univ.filter fun i => ¬ good h a i).card * sch.ℓ ≤ β := by
      intro hf
      refine ha ⟨h.length, Finset.mem_range.2 hh, h.get, Finset.mem_univ _, ?_⟩
      rwa [List.ofFn_get]
    have := pr_good_le_p₀ sch.B sch.ℓ β S sch.B_pos (good h a) (by convert hnf)
    simpa only [good, pred, st, run_progMap, Nat.zero_add] using this
  · -- one compressor per history, then a union bound
    calc pr E ≤ ∑ j ∈ Finset.range k, pr (fun a => ∃ v ∈ (Finset.univ : Finset (Fin j → Fin sch.B)),
          S + sch.B + (Finset.univ.filter fun i => ¬ good (List.ofFn v) a i).card * sch.ℓ ≤ β) :=
          pr_exists_le _ _
      _ ≤ ∑ j ∈ Finset.range k, ∑ _v : Fin j → Fin sch.B, π := by
          refine Finset.sum_le_sum fun j _ => (pr_exists_le _ _).trans (Finset.sum_le_sum fun v _ => ?_)
          exact pr_fits_le sch D Q β S π hinc W (st (List.ofFn v)) (pred (List.ofFn v))
            fun W pp σ i => bounded_progMap _ (A₂.bounded _ _ _ _ _)
      _ = (∑ j ∈ Finset.range k, (sch.B : ℝ≥0∞) ^ j) * π := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin,
            nsmul_eq_mul, Nat.cast_pow]

end PousTargetsChain

end


/-! ════ P3Concrete.P3ConcreteModel ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# P3 with a concrete `H`: the model, the scheme, the chain-column game and the targets

Definitions and targets only; `P3Concrete.lean` proves what is proved. This lifts P3 out of the random-oracle model for
`H`. `H` is the overwrite chain of `docs/p3-instantiation.md` §1 on an ideal `Π₂` of `2m + 512` bits
(`Pous.Sponge.keyP3c`), and `P` is tweakable per `(tag, layer, node)`. The model is `Pous.Sponge.p3ChainModel`: `Π₂`,
`Π₂⁻¹`, `P_T` and `P_T⁻¹` queries, the two-permutation model the design note asks for. The labels are
`Pous.Sponge.c1c`, `c2c` and `topLabelC`. They are imported from `sponge-dense/SpongeDense.lean` unchanged.

**Why the random-oracle proof does not transfer.** The random-oracle chain (`n10prime_lucky`, `jointClassWeightJ`)
reads `H` through four facts. Each fails or changes for the chain:
1. **A key is known only after its exact `H` query** (the knowledge simulation, the `KQ'` slots). Over the chain, a
   key is `r` of the pad call. It is also reachable from a held chaining value `h_{L,v,j}` of `m + 512` bits, which
   is priced `1 + 512/m` labels and has no random-oracle counterpart.
2. **Part B's honest keys `K1_v`, `K2_u` are fresh uniform labels** (`LuckyChainPools`, `LuckyFresh`). Over the
   chain they are `Π₂` answer parts, and every chaining value of a row becomes a Part B source of `m + 512` bits.
3. **Resampling one key moves nothing else** (`updHΩ`, `LuckyChainFibre`/`FibreB`). Over the chain, the move is a
   `Π₂` transposition that keeps the chained part (`sponge-dense`'s `resampH`, `resampT`).
4. **The column game prices a key at nothing beyond its parents** (`ColumnHard`, the key-gated reverse move). Over
   the chain, a key costs a row of `min(v, d) + 1` sequential `Π₂` calls, or a held seed.

**The game (§3).** `P3ChainKnow` is the column game (`Pous.ColumnAware.ColState`) crossed with the chain game
(`Pous.Sponge.ChainKnow`) on both layers. It holds top labels, lower columns, and per row the chaining values `h` and
dropped parts `r`. A lower label is known when all its columns are.
- One round makes every `Π₂` call whose input is known, and inverts every call whose whole output is known.
- In the same round, it makes every `P` call:
  - forward lower, from a key;
  - forward top, from a key and the whole column;
  - inverse lower, which gives a key, since `W` is public;
  - inverse top, which gives the column from the key, or the key from the column.
- The price is in columns: a label is `n`, a chaining value `n + c/wc`, a dropped `r` `n`.

**The certificate target (`P3ChainCert`).** On `B(220, 12)` at `D = 10`, a row of the band has `min(v, 12) + 1`
calls, so rows `v ≥ 9` cannot finish within `D` rounds without a seed. A top recovered without holding it needs its
whole lower column, of which at most 8 rows can be computed in time. So all 220 tops cost at least
`220² − 9·8` columns, which is above `219·220`: `X = 1`, against the random-oracle `X = 3`
(`chain_column_game.py` confirms this shape on small bands, with and without held keys; see `NOTES.md`).

**The ex post facto targets (§4).** `P3ChainEPF` (one segment) and `P3ChainEPFMulti` (the joint event over `N`
segments that `Meets` consumes). They have the shape of `n10prime`, with the chain game in place of `ColumnHard`. The
bound is taken one label weaker than the random-oracle one, `(k − X − 1)` labels, as `ChainExPostFactoG` is one label
weaker than B5. Positions are `14n` per segment over `nPosC`, and there are two collision terms: the `Π₂` birthday
(chaining values) and the label birthday.
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Meets PousP3Base
open scoped ENNReal

/-! ## 1. Oracle access in `p3ChainModel` -/

section Access

variable {n wc : ℕ}



end Access

/-! ## 2. The scheme over the chain -/


variable (wc : ℕ) (Gr : TopoDAG 220)


variable (N : ℕ) [NeZero N]


/-! ## 3. The chain-column game -/

/-- **What the adversary knows in P3's chain game**, per segment: top labels; lower columns `(w, u)` (component `u` of
`c¹_w`); and, per row `(L, v)` of layer `L`, the chaining values `h_{L,v,j}` and dropped parts `r_{L,v,j}` after call
`j ≥ 1` (`h_{L,v,0}` is the IV, always known; `r` of the pad call `j = ovCalls G v` is the row's key); and the top-key
components `(u, w)`, component `w` of `key²_u` (`pin2 u = transpose(c¹)_u ⊕ key²_u` holds component by component). -/
structure P3ChainKnow (n : ℕ) where
  tops : Finset (Fin n)
  cols : Finset (Fin n × Fin n)
  hs : Finset (Fin 2 × Fin n × ℕ)
  rs : Finset (Fin 2 × Fin n × ℕ)
  /-- Top-key components `(u, w)`: component `w` of top row `u`'s key `key²_u`. -/
  kc : Finset (Fin n × Fin n)
  /-- Top-input components `(u, w)`: component `w` of `pin2 u = transpose(c¹)_u ⊕ key²_u`. -/
  pc : Finset (Fin n × Fin n)

namespace P3ChainKnow

variable {n : ℕ} (G : TopoDAG n) (K : P3ChainKnow n)

/-- Lower label `w` is known: all its columns are. -/
def lowKnown (w : Fin n) : Prop := ∀ u, (w, u) ∈ K.cols

/-- Lower column `u` (component `u` of every lower label, i.e. `transpose(c¹)_u`) is known. -/
def colKnown (u : Fin n) : Prop := ∀ w, (w, u) ∈ K.cols

/-- A label of layer `L` is known (a whole lower label, or a top). -/
def labKnown (L : Fin 2) (u : Fin n) : Prop := if L = 0 then K.lowKnown u else u ∈ K.tops

/-- Row `(L, v)`'s key is known: `r` of its pad call. -/
def keyKnown (L : Fin 2) (v : Fin n) : Prop := (L, v, ovCalls G v) ∈ K.rs

/-- Call `j` of row `(L, v)` can be made: it exists, its block (a parent label of layer `L`, or the pad) is known,
and the chaining value before it is known. -/
def canCall (L : Fin 2) (v : Fin n) (j : ℕ) : Prop :=
  1 ≤ j ∧ j ≤ ovCalls G v ∧ (∀ u, ovBlock G v j = some u → K.labKnown L u) ∧ (j = 1 ∨ (L, v, j - 1) ∈ K.hs)

/-- Candidate chain positions `(L, v, j)`, `j ≤ n + 1`. -/
def pos (n : ℕ) : Finset (Fin 2 × Fin n × ℕ) := Finset.univ ×ˢ Finset.univ ×ˢ Finset.range (n + 2)

open Classical in
/-- **The moves of one round of P3's chain game.** Every move reads the knowledge at the start of the round.
- `Π₂`: make every call whose input is known (its `r` and `h`); invert every call whose output `(r, h)` is known (its
  block, a whole parent label of its layer, and the chaining value before it).
- `P` forward: a lower key gives the lower label; a top key and the whole lower column give the top.
- `P⁻¹`: a known lower label gives its key (`W` is public). A known top gives, through `pin2 = transpose(c¹) ⊕ key²`
  component by component: its column from its key, its key from its column, the key component `(u, w)` from the entry
  `(w, u)`, the entry `(w, u)` from the key component `(u, w)`, and every component of `pin2 u`; and all of `pin2 u` gives
  the top (`P` forward). -/
noncomputable def step : P3ChainKnow n where
  tops := K.tops ∪ Finset.univ.filter (fun u => (K.keyKnown G 1 u ∧ K.colKnown u) ∨
    (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 1 ∧ ovBlock G p.2.1 p.2.2 = some u) ∨ ∀ w, (u, w) ∈ K.pc)
  cols := K.cols ∪ Finset.univ.filter (fun q : Fin n × Fin n => K.keyKnown G 0 q.1 ∨
    (q.2 ∈ K.tops ∧ K.keyKnown G 1 q.2) ∨ (∃ p ∈ K.hs, p ∈ K.rs ∧ p.1 = 0 ∧ ovBlock G p.2.1 p.2.2 = some q.1) ∨
    (q.2 ∈ K.tops ∧ (q.2, q.1) ∈ K.kc))
  hs := K.hs ∪ (pos n).filter (fun p => K.canCall G p.1 p.2.1 p.2.2 ∨
    (1 ≤ p.2.2 ∧ (p.1, p.2.1, p.2.2 + 1) ∈ K.hs ∧ (p.1, p.2.1, p.2.2 + 1) ∈ K.rs))
  rs := K.rs ∪ (pos n).filter (fun p => K.canCall G p.1 p.2.1 p.2.2 ∨
    (p.2.2 = ovCalls G p.2.1 ∧ ((p.1 = 0 ∧ K.lowKnown p.2.1) ∨ (p.1 = 1 ∧ p.2.1 ∈ K.tops ∧ K.colKnown p.2.1))))
  kc := K.kc ∪ Finset.univ.filter (fun q : Fin n × Fin n => q.1 ∈ K.tops ∧ (q.2, q.1) ∈ K.cols)
  pc := K.pc ∪ Finset.univ.filter (fun q : Fin n × Fin n => q.1 ∈ K.tops)

open Classical in
/-- The key components known once whole top keys are split. -/
noncomputable def kc1 : Finset (Fin n × Fin n) :=
  K.kc ∪ Finset.univ.filter fun q : Fin n × Fin n => ((1 : Fin 2), q.1, ovCalls G q.1) ∈ K.rs

open Classical in
/-- **The instantaneous closure** at the end of a round (and at round 0), one pass:
- a whole top key gives all its components;
- `pin2_u(w) = c¹_w(u) ⊕ key²_u(w)`: any two of the entry `(w, u)`, `kc (u, w)` and `pc (u, w)` give the third (each
  coordinate is its own triple, so one pass closes);
- a top row's key is known as soon as all its components are. -/
noncomputable def assemble : P3ChainKnow n where
  tops := K.tops
  cols := K.cols ∪ Finset.univ.filter fun q : Fin n × Fin n => (q.2, q.1) ∈ K.pc ∧ (q.2, q.1) ∈ K.kc1 G
  hs := K.hs
  rs := K.rs ∪ ((Finset.univ.filter fun v : Fin n => ∀ w, (v, w) ∈ K.kc1 G ∨ ((v, w) ∈ K.pc ∧ (w, v) ∈ K.cols)).image
      (fun v => ((1 : Fin 2), v, ovCalls G v)))
  kc := K.kc1 G ∪ Finset.univ.filter fun q : Fin n × Fin n => q ∈ K.pc ∧ (q.2, q.1) ∈ K.cols
  pc := K.pc ∪ Finset.univ.filter fun q : Fin n × Fin n => (q.2, q.1) ∈ K.cols ∧ q ∈ K.kc1 G

/-- **One round of P3's chain game**: the moves, then key assembly. -/
noncomputable def round : P3ChainKnow n := (K.step G).assemble G

/-- The knowledge after `t` rounds from the holding `K₀`. -/
noncomputable def reach (K₀ : P3ChainKnow n) : ℕ → P3ChainKnow n
  | 0 => K₀.assemble G
  | t + 1 => (reach K₀ t).round G

/-- **The price of a holding, in columns** (`wc` bits each): a top or a dropped `r` is `n`, a lower column, a top-key
component or a top-input component 1, a chaining value `n + c/wc` (`m + c` bits); the IVs `h_{L,v,0}` are free. -/
noncomputable def size (c wc : ℕ) : ℚ :=
  (n : ℚ) * K.tops.card + K.cols.card + ((n : ℚ) + (c : ℚ) / wc) * (K.hs.filter fun p => p.2.2 ≠ 0).card +
    (n : ℚ) * K.rs.card + K.kc.card + K.pc.card

end P3ChainKnow

/-- **`P3ChainHard G c wc D k X`**: every holding that knows `k` tops after `D` rounds of P3's chain game is priced at
least `(k − X)·n` columns. The chain-game counterpart of `Pous.ColumnAware.ColumnHard G D k X`. -/
def P3ChainHard {n : ℕ} (G : TopoDAG n) (c wc D k X : ℕ) : Prop :=
  ∀ K₀ : P3ChainKnow n, k ≤ ((P3ChainKnow.reach G K₀ D).tops).card → (((k - X : ℕ) : ℚ) * n) ≤ K₀.size c wc

/-- **Target: the deployment certificate.** `B(220, 12)` at `D = 10` chain rounds, 64 KB labels, capacity 512:
recovering all 220 tops costs at least `219·220` columns (`X = 1`). -/
def P3ChainCert : Prop := P3ChainHard (Pous.P3Column.bandGraph 220 12) 512 2384 10 220 1

/-! ## 4. The ex post facto targets -/

/-- Query positions of one segment: the programs' `n·(Q + 1)`, the labeller's `Π₂` calls (at most `n(n+1)/2` per
layer on any DAG), and its `2n` `P` calls. -/
def nPosC (n Q : ℕ) : ℕ := n * (Q + 1) + n * (n + 1) + 2 * n

/-- **Target: the concrete-`H` `n10prime`**, one segment. If P3's chain game is `(k, X)`-hard at `D` rounds, an `m`-bit
preprocessor and `(D, Q)`-bounded programs recover `k` tops with probability at most
`2^m · nPosC^{14n} / 2^{(k−X−1)·n·wc}`, plus the `Π₂` and label birthdays. `n ≤ 2^255` keeps the row domains `domP3`
distinct (`2v + L < 2^256`); above it rows `v` and `v + 2^255` share their IV (`domP3_shift`). `2·nPosC ≤ 2^wc` makes
one column wider than twice the positions, so that a lazily sampled column is pinned (`LazyPerm.pin_mul_le`).
`(2·nPosC)^40 ≤ 2^wc` (C2) makes a column pay for the naming of about 40 charged steps and slots per whole credit. -/
def P3ChainEPF : Prop :=
  ∀ (n wc m D Q k X : ℕ) (tag : Bits 256) (G : TopoDAG n) (W : Fin n → Lab n wc),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * nPosC n Q ≤ 2 ^ wc → (2 * nPosC n Q) ^ 40 ≤ 2 ^ wc → X + 1 ≤ k →
    P3ChainHard G 512 wc D k X →
    ∀ (A₁ : P3COmega n wc → Bits m) (A₂ : Bits m → Fin n → Prog (p3ChainModel n wc) (Lab n wc)),
      (∀ σ v, (A₂ σ v).Bounded D Q) →
      pr (fun ω : P3COmega n wc => k ≤ (Finset.univ.filter fun v =>
            (A₂ (A₁ ω) v).run ((p3ChainModel n wc).answer ω) = topLabelC tag G W ω v).card)
        ≤ 2 ^ m * ((nPosC n Q ^ (14 * n) : ℕ) : ℝ≥0∞) / 2 ^ ((k - X - 1) * (n * wc)) +
          ((nPosC n Q ^ 2 + (2 * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

/-- **The joint event over the chain**: at least `k` tops of every segment `s` (tag `tags s`, data `W s`). -/
def JointEventC {n wc m N : ℕ} (G : TopoDAG n) (tags : Fin N → Bits 256) (W : Fin N → Fin n → Lab n wc)
    (A₁ : P3COmega n wc → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)) (k : ℕ)
    (ω : P3COmega n wc) : Prop :=
  ∀ s : Fin N, k ≤ (Finset.univ.filter fun v =>
    (A₂ (A₁ ω) s v).run ((p3ChainModel n wc).answer ω) = topLabelC (tags s) G (W s) ω v).card

/-- **Target: the concrete-`H` `n10primeMulti`**, the joint event over `N` segments (positions over all `N·n` programs,
`14n` per segment). Its proof must use lock-step joint accounting (`Freshness.JointAccountingDefs`): the per-segment
form `JointClassWeight` is false (`not_jointClassWeight`). The column conditions (C1) and (C2) are over all `N·nPosC`
positions. -/
def P3ChainEPFMulti : Prop :=
  ∀ (N n wc m D Q k X : ℕ) (tags : Fin N → Bits 256) (G : TopoDAG n) (W : Fin N → Fin n → Lab n wc),
    0 < n → 0 < wc → n ≤ 2 ^ 255 → 2 * (N * nPosC n Q) ≤ 2 ^ wc → (2 * (N * nPosC n Q)) ^ 40 ≤ 2 ^ wc → 1 ≤ N →
    X + 1 ≤ k → Function.Injective tags → P3ChainHard G 512 wc D k X →
    ∀ (A₁ : P3COmega n wc → Bits m) (A₂ : Bits m → Fin N → Fin n → Prog (p3ChainModel n wc) (Lab n wc)),
      (∀ σ s v, (A₂ σ s v).Bounded D Q) →
      pr (JointEventC G tags W A₁ A₂ k) ≤
        (N : ℝ≥0∞) * 2 ^ m * (((N * nPosC n Q) ^ (14 * n * N) : ℕ) : ℝ≥0∞) / 2 ^ (N * (k - X - 1) * (n * wc)) +
          (((N * nPosC n Q) ^ 2 + (2 * N * n) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (n * wc)

end Pous.P3Concrete

end


/-! ════ P3Concrete.P3Concrete ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# P3 with a concrete `H`: decoding, the glue into `Meets`, and the witnesses

Proofs for `P3ConcreteModel.lean`.
- **Decoding is exact over the chain** (`decodeC_c2`), so `p3SchemeC` and `p3SchemeNC` are `Correct`.
- **The glue.** `P3ChainEPF` and a certificate `P3ChainHard Gr 512 2384 D 220 1` give `Meets` for one segment
  (14.4 MB) at `k = 106`. `P3ChainEPFMulti` gives it for `N = 971` segments (14.005 GB), also at `k = 106`. At the
  deployment point `D = 10`, `B(220, 12)`, the certificate is the target `P3ChainCert`.
- **`k = 106`, against 117 over the random oracle.** The chain game's `X = 1` beats the random-oracle column game's
  `X = 3` by two labels. The target's bound gives one of them back.
- **Witnesses.**
  - `p3ChainHard_zero`: `P3ChainHard` holds non-trivially (`X + 1 ≤ k`) at `D = 0`.
  - `p3ChainEPF_hyps_64` and `p3ChainEPFMulti_hyps_64`: the side conditions at the deployment point.
  - `tagR_injective`: the joint target's tag condition.
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Invertible Pous.Sponge Pous.P3Meets PousP3Base
open scoped ENNReal

/-! ## Decoding -/

theorem pi2Of_answer {n wc : ℕ} (ω : P3COmega n wc) : pi2Of ((p3ChainModel n wc).answer ω) = ω.2 := rfl

theorem pInvOf_answer {n wc : ℕ} (ω : P3COmega n wc) (T : Tweak n) (z : Lab n wc) :
    pInvOf ((p3ChainModel n wc).answer ω) T z = (ω.1 T).symm z := rfl

theorem map_attach_val {α β : Type} (l : List α) (g : α → β) : (l.attach.map fun u => g u.1) = l.map g := by
  simp

theorem c1c_eq {n wc : ℕ} (tag : Bits 256) (G : TopoDAG n) (ω : P3COmega n wc) (W' : Fin n → Lab n wc) (u : Fin n) :
    c1c tag G ω.2 ω.1 W' u = ω.1 (tag, 0, u)
      (labXor (W' u) (keyP3c ω.2 tag 0 u ((parentsDesc G u).map (c1c tag G ω.2 ω.1 W')))) := by
  rw [c1c, map_attach_val]

theorem c2c_eq {n wc : ℕ} (tag : Bits 256) (G : TopoDAG n) (ω : P3COmega n wc) (W' : Fin n → Lab n wc) (v : Fin n) :
    c2c tag G ω.2 ω.1 W' v = ω.1 (tag, 1, v) (labXor (transpose (c1c tag G ω.2 ω.1 W') v)
      (keyP3c ω.2 tag 1 v ((parentsDesc G v).map (c2c tag G ω.2 ω.1 W')))) := by
  rw [c2c, map_attach_val]

/-- **Decoding over the chain is exact**: from the top labels and oracle access, `decodeC` recovers `W`. -/
theorem decodeC_c2 {n wc : ℕ} (tag : Bits 256) (G : TopoDAG n) (W' : Fin n → Lab n wc) (ω : P3COmega n wc) :
    decodeC tag G (topLabelC tag G W' ω) ((p3ChainModel n wc).answer ω) = W' := by
  have hx2 : (fun v => labXor (pInvOf ((p3ChainModel n wc).answer ω) (tag, 1, v) (c2c tag G ω.2 ω.1 W' v))
      (keyP3c (pi2Of ((p3ChainModel n wc).answer ω)) tag 1 v ((parentsDesc G v).map (c2c tag G ω.2 ω.1 W')))) =
      transpose (c1c tag G ω.2 ω.1 W') := by
    funext v
    rw [pInvOf_answer, pi2Of_answer, c2c_eq, Equiv.symm_apply_apply, labXor_labXor_cancel]
  unfold decodeC topLabelC
  simp only
  rw [hx2, transpose_transpose]
  funext u
  rw [pInvOf_answer, pi2Of_answer, c1c_eq, Equiv.symm_apply_apply, labXor_labXor_cancel]

variable (wc : ℕ) (Gr : TopoDAG 220)

theorem p3SchemeC_correct : (p3SchemeC wc Gr).Correct := by
  intro W ω salt
  show WbitsW wc (decodeC (tagR salt 0) Gr (fun v => (codeEquiv 220 wc).symm
    (codeEquiv 220 wc (topLabelC (tagR salt 0) Gr (WlabW wc W) ω v))) ((p3ChainModel 220 wc).answer ω)) = W
  simp only [Equiv.symm_apply_apply]
  exact (congrArg (WbitsW wc) (decodeC_c2 (tagR salt 0) Gr (WlabW wc W) ω)).trans (WbitsW_WlabW wc W)

theorem p3SchemeC_codeHoldsW : (p3SchemeC wc Gr).CodeHoldsW := le_rfl

theorem p3SchemeC_space (hwc : 1 ≤ wc) : (p3SchemeC wc Gr).SpaceBound Params.expansion := by
  show (((220 * (220 * wc) + 192 : ℕ)) : ℚ) ≤ Params.expansion * ((220 * (220 * wc) : ℕ) : ℚ)
  have h : (1 : ℚ) ≤ wc := by exact_mod_cast hwc
  push_cast
  norm_num [Params.expansion]
  nlinarith

/-! ## One segment: the glue -/

/-- **Per-segment bound over the chain** on `Gr` at width `wc`, loss `L`, additive term `c`. -/
def SegBoundC (D Q L : ℕ) (c : ℝ≥0∞) : Prop :=
  ∀ (m : ℕ) (tag : Bits 256) (W : Fin 220 → Lab 220 wc) (A₁ : P3COmega 220 wc → Bits m)
    (A₂ : Bits m → Fin 220 → Prog (p3ChainModel 220 wc) (Lab 220 wc)), (∀ σ c, (A₂ σ c).Bounded D Q) →
    pr (fun ω : P3COmega 220 wc =>
        220 ≤ (Finset.univ.filter fun v =>
          (A₂ (A₁ ω) v).run ((p3ChainModel 220 wc).answer ω) = topLabelC tag Gr W ω v).card)
      ≤ 2 ^ m * (2⁻¹ : ℝ≥0∞) ^ L + c

theorem nPosC_le : nPosC 220 (2 ^ 20) ≤ 2 ^ 28 := by norm_num [nPosC]

set_option exponentiation.threshold 3000 in
/-- **(C1) at the deployment, one segment**: `2·nPosC 220 2^20 < 2^29 ≤ 2^2384`. -/
theorem c1_64 : 2 * nPosC 220 (2 ^ 20) ≤ 2 ^ 2384 :=
  (show 2 * nPosC 220 (2 ^ 20) ≤ 2 ^ 29 by norm_num [nPosC]).trans
    (Nat.pow_le_pow_right (n := 2) (by norm_num) (show 29 ≤ 2384 by norm_num))

set_option exponentiation.threshold 3000 in
/-- **(C1) at the deployment, over `N ≤ 2^10` segments**: `2·N·nPosC 220 2^20 < 2^39 ≤ 2^2384`. -/
theorem c1_multi_64 {N : ℕ} (hN : N ≤ 2 ^ 10) : 2 * (N * nPosC 220 (2 ^ 20)) ≤ 2 ^ 2384 :=
  calc 2 * (N * nPosC 220 (2 ^ 20)) ≤ 2 * (2 ^ 10 * 2 ^ 28) := Nat.mul_le_mul_left _ (Nat.mul_le_mul hN nPosC_le)
    _ = 2 ^ 39 := by norm_num
    _ ≤ 2 ^ 2384 := Nat.pow_le_pow_right (n := 2) (by norm_num) (show 39 ≤ 2384 by norm_num)

set_option exponentiation.threshold 3000 in
/-- **(C2) at the deployment, one segment**: `(2·nPosC 220 2^20)^40 ≤ (2^29)^40 = 2^1160 ≤ 2^2384`. -/
theorem c2_64 : (2 * nPosC 220 (2 ^ 20)) ^ 40 ≤ 2 ^ 2384 :=
  calc (2 * nPosC 220 (2 ^ 20)) ^ 40 ≤ (2 ^ 29) ^ 40 :=
        Nat.pow_le_pow_left (show 2 * nPosC 220 (2 ^ 20) ≤ 2 ^ 29 by norm_num [nPosC]) _
    _ = 2 ^ (29 * 40) := (pow_mul 2 29 40).symm
    _ ≤ 2 ^ 2384 := Nat.pow_le_pow_right (by norm_num) (by norm_num)

set_option exponentiation.threshold 3000 in
/-- **(C2) at the deployment, over `N ≤ 2^10` segments**: `(2·N·nPosC 220 2^20)^40 ≤ (2^39)^40 = 2^1560 ≤ 2^2384`. -/
theorem c2_64_multi {N : ℕ} (hN : N ≤ 2 ^ 10) : (2 * (N * nPosC 220 (2 ^ 20))) ^ 40 ≤ 2 ^ 2384 :=
  calc (2 * (N * nPosC 220 (2 ^ 20))) ^ 40 ≤ (2 ^ 39) ^ 40 := by
        refine Nat.pow_le_pow_left ?_ _
        calc 2 * (N * nPosC 220 (2 ^ 20)) ≤ 2 * (2 ^ 10 * 2 ^ 28) := Nat.mul_le_mul_left _ (Nat.mul_le_mul hN nPosC_le)
          _ = 2 ^ 39 := by norm_num
    _ = 2 ^ (39 * 40) := (pow_mul 2 39 40).symm
    _ ≤ 2 ^ 2384 := Nat.pow_le_pow_right (by norm_num) (by norm_num)

/-- **From `P3ChainEPF` and a certificate at `X`**: loss `(220 − X − 1)·220·wc − 28·14·220`, plus the two birthdays. -/
theorem segBoundC_of_epf (hE : P3ChainEPF) (hwc : 1 ≤ wc) (hC1 : 2 * nPosC 220 (2 ^ 20) ≤ 2 ^ wc)
    (hC2 : (2 * nPosC 220 (2 ^ 20)) ^ 40 ≤ 2 ^ wc) (D X : ℕ)
    (hX : X + 1 ≤ 220) (hL : 28 * (14 * 220) ≤ (220 - X - 1) * (220 * wc)) (hard : P3ChainHard Gr 512 wc D 220 X) :
    SegBoundC wc Gr D (2 ^ 20) ((220 - X - 1) * (220 * wc) - 28 * (14 * 220))
      (((nPosC 220 (2 ^ 20) ^ 2 + (2 * 220) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (220 * wc)) := by
  intro m tag W A₁ A₂ hA₂
  refine (hE 220 wc m D (2 ^ 20) 220 X tag Gr W (by norm_num) (by omega) (by norm_num) hC1 hC2 hX hard A₁ A₂ hA₂).trans
    (add_le_add ?_ le_rfl)
  have ha : ((nPosC 220 (2 ^ 20) : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 28 := by
    have := (Nat.cast_le (α := ℝ≥0∞)).mpr nPosC_le
    simpa only [Nat.cast_pow, Nat.cast_ofNat] using this
  have hP : ((nPosC 220 (2 ^ 20) ^ (14 * 220) : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ (28 * (14 * 220)) :=
    calc ((nPosC 220 (2 ^ 20) ^ (14 * 220) : ℕ) : ℝ≥0∞) = ((nPosC 220 (2 ^ 20) : ℕ) : ℝ≥0∞) ^ (14 * 220) :=
          Nat.cast_pow _ _
      _ ≤ ((2 : ℝ≥0∞) ^ 28) ^ (14 * 220) := pow_le_pow_left₀ (zero_le) ha _
      _ = (2 : ℝ≥0∞) ^ (28 * (14 * 220)) := (pow_mul _ _ _).symm
  calc (2 : ℝ≥0∞) ^ m * ((nPosC 220 (2 ^ 20) ^ (14 * 220) : ℕ) : ℝ≥0∞) / 2 ^ ((220 - X - 1) * (220 * wc))
      ≤ 2 ^ m * (2 : ℝ≥0∞) ^ (28 * (14 * 220)) / 2 ^ ((220 - X - 1) * (220 * wc)) := by gcongr
    _ = 2 ^ m * ((2 : ℝ≥0∞) ^ (28 * (14 * 220)) * (2⁻¹ : ℝ≥0∞) ^ ((220 - X - 1) * (220 * wc))) := by
        rw [div_eq_mul_inv, ENNReal.inv_pow, mul_assoc]
    _ = 2 ^ m * (2⁻¹ : ℝ≥0∞) ^ ((220 - X - 1) * (220 * wc) - 28 * (14 * 220)) := by
        rw [two_pow_mul_inv_pow _ _ hL]

theorem p3_timedINC_C (D Q L β : ℕ) (c : ℝ≥0∞) (h : SegBoundC wc Gr D Q L c) :
    TimedINC (p3SchemeC wc Gr) D Q β (2 ^ β * (2⁻¹ : ℝ≥0∞) ^ L + c) := by
  classical
  intro W cmp exp hexp
  let Cf : P3COmega 220 wc → Bits 192 → Fin 220 → Bits (220 * wc) :=
    fun ω salt i => codeEquiv 220 wc (topLabelC (tagR salt 0) Gr (WlabW wc W) ω i)
  refine pr_prod_le_snd (fun ω salt => ∀ i, (exp W salt (cmp W salt (Cf ω salt) ω) i).run
    ((p3ChainModel 220 wc).answer ω) = Cf ω salt i) _ fun salt => ?_
  have hb := h β (tagR salt 0) (WlabW wc W) (fun ω => cmp W salt (Cf ω salt) ω)
    (fun σ c => progMap (codeEquiv 220 wc).symm (exp W salt σ c))
    (fun σ c => bounded_progMap _ (hexp _ _ _ _))
  refine le_trans (pr_mono fun ω hω => ?_) hb
  refine le_trans (le_of_eq (by rw [Finset.card_univ, Fintype.card_fin])) (Finset.card_le_card (s := Finset.univ) ?_)
  intro v _
  exact Finset.mem_filter.2 ⟨Finset.mem_univ _, (run_progMap _ _ _).trans
    ((congrArg (codeEquiv 220 wc).symm (hω v)).trans ((codeEquiv 220 wc).symm_apply_apply _))⟩

/-! ## One segment at 64 KB: `k = 106` -/

theorem stateBound_C64 : (p3SchemeC 2384 Gr).stateBound Params.ρ = 109312673 := by
  show ⌊Params.ρ * ((220 * (220 * 2384) : ℕ) : ℚ)⌋₊ = 109312673
  rw [Nat.floor_eq_iff (by norm_num [Params.ρ])]
  norm_num [Params.ρ]

set_option exponentiation.threshold 1000 in
/-- `220^106 ≤ 2^825`. -/
theorem hist_C64 : 220 ^ 106 ≤ 2 ^ 825 := by norm_num

/-- `p₀^106 ≤ 1%` at `β = 114249446`, via `p₀ ≤ 0.95722`. -/
theorem sampling_C64 :
    ENNReal.ofReal (p₀ 114249446 109312673 220 (220 * 2384)) ^ 106 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  have h0 : 0 ≤ p₀ 114249446 109312673 220 (220 * 2384) := by unfold p₀; norm_num
  have hq : p₀ 114249446 109312673 220 (220 * 2384) ≤ 47861 / 50000 := by unfold p₀; norm_num
  rw [← ENNReal.ofReal_pow h0]
  refine ENNReal.ofReal_le_ofReal ((pow_le_pow_left₀ h0 hq 106).trans ?_)
  norm_num [Params.δ]

/-- **P3 with concrete `H` at 64 KB, one segment (14.4 MB), at any timed depth `D`**, from `P3ChainEPF` and a chain
certificate with `X = 1` at `D` rounds: `k = 106`. -/
theorem p3_meets_concrete_64_at (hE : P3ChainEPF) (h1 : Pous.Guarantees.Theorem1iiSeq) (D : ℕ)
    (hard : P3ChainHard Gr 512 2384 D 220 1) :
    Meets (p3SchemeC 2384 Gr) .sequential D (2 ^ 20) 106 ((2⁻¹ : ℝ≥0∞) ^ 128) := by
  refine ⟨le_rfl, p3SchemeC_correct _ _, p3SchemeC_codeHoldsW _ _, p3SchemeC_space _ _ (by norm_num), ?_⟩
  intro W A₁ A₂
  refine (h1 (p3SchemeC 2384 Gr) D (2 ^ 20) 114249446 ((p3SchemeC 2384 Gr).stateBound Params.ρ) 106 _
    (p3_timedINC_C 2384 Gr D (2 ^ 20) _ 114249446 _
      (segBoundC_of_epf 2384 Gr hE (by norm_num) c1_64 c2_64 D 1 (by norm_num) (by norm_num) hard))
    W A₁ A₂).trans ?_
  rw [stateBound_C64, add_comm]
  refine add_le_add sampling_C64 (le_of_eq_of_le ?_ (union_termW (220 * 2384) 106 114249446
    ((220 - 1 - 1) * (220 * 2384) - 28 * (14 * 220)) 1 220 (nPosC 220 (2 ^ 20) ^ 2 + (2 * 220) ^ 2) 0 825 56
    le_rfl hist_C64 (by norm_num) (by norm_num) (by norm_num) (by norm_num [nPosC])))
  rw [Nat.cast_one, one_mul]
  rfl

/-- **Headline, conditional: P3 with concrete `H`, 64 KB, one segment, `D = 10`, `B(220, 12)`, `k = 106`**, from
`P3ChainEPF` and the certificate `P3ChainCert`. `Theorem1iiSeq` is proved (`PousTargetsChain.theorem1_ii_seq`). -/
theorem p3_meets_concrete_64_D10 (hE : P3ChainEPF) (hC : P3ChainCert) :
    Meets (p3SchemeC 2384 (Pous.P3Column.bandGraph 220 12)) .sequential 10 (2 ^ 20) 106 ((2⁻¹ : ℝ≥0∞) ^ 128) :=
  p3_meets_concrete_64_at _ hE @PousTargetsChain.theorem1_ii_seq 10 hC

/-! ## `N` segments -/

variable (N : ℕ) [NeZero N]

theorem p3SchemeNC_correct : (p3SchemeNC wc Gr N).Correct := by
  intro W ω salt
  show codeEquiv N (220 * (220 * wc)) (fun s => WbitsW wc (decodeC (tagR salt s.val) Gr (fun v =>
    (codeEquiv 220 wc).symm (codeEquiv 220 wc (topLabelC
      (tagR salt (finProdFinEquiv.symm (finProdFinEquiv (s, v))).1.val) Gr
      (WlabW wc (WsegW wc N W (finProdFinEquiv.symm (finProdFinEquiv (s, v))).1)) ω
      (finProdFinEquiv.symm (finProdFinEquiv (s, v))).2))) ((p3ChainModel 220 wc).answer ω))) = W
  simp only [Equiv.symm_apply_apply]
  have hfun : (fun s : Fin N => WbitsW wc (decodeC (tagR salt s.val) Gr (fun v => topLabelC (tagR salt s.val) Gr
      (WlabW wc ((codeEquiv N (220 * (220 * wc))).symm W s)) ω v) ((p3ChainModel 220 wc).answer ω))) =
      fun s => (codeEquiv N (220 * (220 * wc))).symm W s :=
    funext fun s => (congrArg (WbitsW wc) (decodeC_c2 _ Gr _ ω)).trans (WbitsW_WlabW wc _)
  exact (congrArg (codeEquiv N (220 * (220 * wc))) hfun).trans (Equiv.apply_symm_apply _ W)

theorem p3SchemeNC_codeHoldsW : (p3SchemeNC wc Gr N).CodeHoldsW := by
  show N * (220 * (220 * wc)) ≤ N * 220 * (220 * wc)
  rw [Nat.mul_assoc]

theorem p3SchemeNC_space (hwc : 1 ≤ wc) : (p3SchemeNC wc Gr N).SpaceBound Params.expansion := by
  show (((N * 220 * (220 * wc) + 192 : ℕ)) : ℚ) ≤ Params.expansion * ((N * (220 * (220 * wc)) : ℕ) : ℚ)
  have hN : (1 : ℚ) ≤ N := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne N)
  have h : (1 : ℚ) ≤ wc := by exact_mod_cast hwc
  push_cast
  norm_num [Params.expansion]
  nlinarith [mul_le_mul hN h zero_le_one (by linarith)]

/-- **Joint bound over the chain** on `Gr`, loss `L` per segment. -/
def JointSegBoundC (D Q L : ℕ) (ε : ℝ≥0∞) : Prop :=
  ∀ (m : ℕ) (tags : Fin N → Bits 256) (W : Fin N → Fin 220 → Lab 220 wc) (A₁ : P3COmega 220 wc → Bits m)
    (A₂ : Bits m → Fin N → Fin 220 → Prog (p3ChainModel 220 wc) (Lab 220 wc)),
    Function.Injective tags → (∀ σ s c, (A₂ σ s c).Bounded D Q) →
    pr (JointEventC Gr tags W A₁ A₂ 220) ≤ (N : ℝ≥0∞) * 2 ^ m * (2⁻¹ : ℝ≥0∞) ^ (N * L) + ε

/-- **From `P3ChainEPFMulti` and a certificate at `X`**, for `N ≤ 2^10`: loss `(220 − X − 1)·220·wc − 38·14·220` per
segment (a position over all `N·220` programs costs 38 bits), plus the two birthdays over all segments. -/
theorem jointSegBoundC_of_epfMulti (hM : P3ChainEPFMulti) (hN : N ≤ 2 ^ 10) (hwc : 1 ≤ wc)
    (hC1 : 2 * (N * nPosC 220 (2 ^ 20)) ≤ 2 ^ wc) (hC2 : (2 * (N * nPosC 220 (2 ^ 20))) ^ 40 ≤ 2 ^ wc) (D X : ℕ)
    (hX : X + 1 ≤ 220) (hL : 38 * (14 * 220) ≤ (220 - X - 1) * (220 * wc)) (hard : P3ChainHard Gr 512 wc D 220 X) :
    JointSegBoundC wc Gr N D (2 ^ 20) ((220 - X - 1) * (220 * wc) - 38 * (14 * 220))
      ((((N * nPosC 220 (2 ^ 20)) ^ 2 + (2 * N * 220) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (220 * wc)) := by
  intro m tags W A₁ A₂ htags hA₂
  have hN0 : 0 < N := Nat.pos_of_ne_zero (NeZero.ne N)
  refine (hM N 220 wc m D (2 ^ 20) 220 X tags Gr W (by norm_num) (by omega) (by norm_num) hC1 hC2 hN0 hX htags hard A₁ A₂
    hA₂).trans
    (add_le_add ?_ le_rfl)
  have hbase : N * nPosC 220 (2 ^ 20) ≤ 2 ^ 38 :=
    calc N * nPosC 220 (2 ^ 20) ≤ 2 ^ 10 * 2 ^ 28 := Nat.mul_le_mul hN nPosC_le
      _ = 2 ^ 38 := by norm_num
  have ha : ((N * nPosC 220 (2 ^ 20) : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ 38 := by
    have := (Nat.cast_le (α := ℝ≥0∞)).mpr hbase
    simpa only [Nat.cast_pow, Nat.cast_ofNat] using this
  have hP : (((N * nPosC 220 (2 ^ 20)) ^ (14 * 220 * N) : ℕ) : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ (38 * (14 * 220 * N)) :=
    calc (((N * nPosC 220 (2 ^ 20)) ^ (14 * 220 * N) : ℕ) : ℝ≥0∞)
          = ((N * nPosC 220 (2 ^ 20) : ℕ) : ℝ≥0∞) ^ (14 * 220 * N) := Nat.cast_pow _ _
      _ ≤ ((2 : ℝ≥0∞) ^ 38) ^ (14 * 220 * N) := pow_le_pow_left₀ (zero_le) ha _
      _ = (2 : ℝ≥0∞) ^ (38 * (14 * 220 * N)) := (pow_mul _ _ _).symm
  have hexp : 38 * (14 * 220 * N) ≤ N * (220 - X - 1) * (220 * wc) :=
    calc 38 * (14 * 220 * N) = N * (38 * (14 * 220)) := by ring
      _ ≤ N * ((220 - X - 1) * (220 * wc)) := Nat.mul_le_mul_left N hL
      _ = N * (220 - X - 1) * (220 * wc) := (Nat.mul_assoc _ _ _).symm
  have hsub : N * (220 - X - 1) * (220 * wc) - 38 * (14 * 220 * N) =
      N * ((220 - X - 1) * (220 * wc) - 38 * (14 * 220)) := by
    have h1 : N * (220 - X - 1) * (220 * wc) = N * ((220 - X - 1) * (220 * wc)) := Nat.mul_assoc _ _ _
    have h2 : 38 * (14 * 220 * N) = N * (38 * (14 * 220)) := by ring
    rw [h1, h2, Nat.mul_sub]
  calc (N : ℝ≥0∞) * 2 ^ m * (((N * nPosC 220 (2 ^ 20)) ^ (14 * 220 * N) : ℕ) : ℝ≥0∞) /
        2 ^ (N * (220 - X - 1) * (220 * wc))
      ≤ (N : ℝ≥0∞) * 2 ^ m * (2 : ℝ≥0∞) ^ (38 * (14 * 220 * N)) / 2 ^ (N * (220 - X - 1) * (220 * wc)) := by
        gcongr
    _ = (N : ℝ≥0∞) * 2 ^ m * ((2 : ℝ≥0∞) ^ (38 * (14 * 220 * N)) *
          (2⁻¹ : ℝ≥0∞) ^ (N * (220 - X - 1) * (220 * wc))) := by
        rw [div_eq_mul_inv, ENNReal.inv_pow, mul_assoc]
    _ = (N : ℝ≥0∞) * 2 ^ m * (2⁻¹ : ℝ≥0∞) ^ (N * ((220 - X - 1) * (220 * wc) - 38 * (14 * 220))) := by
        rw [two_pow_mul_inv_pow _ _ hexp, hsub]

theorem p3_timedINC_multiC (hN : N ≤ 2 ^ 64) (D Q L : ℕ) (ε : ℝ≥0∞) (h : JointSegBoundC wc Gr N D Q L ε) (β : ℕ) :
    TimedINC (p3SchemeNC wc Gr N) D Q β ((N : ℝ≥0∞) * 2 ^ β * (2⁻¹ : ℝ≥0∞) ^ (N * L) + ε) := by
  classical
  intro W cmp exp hexp
  let Cf : P3COmega 220 wc → Bits 192 → Fin (N * 220) → Bits (220 * wc) :=
    fun ω salt i => codeEquiv 220 wc (topLabelC (tagR salt (finProdFinEquiv.symm i).1.val) Gr
      (WlabW wc (WsegW wc N W (finProdFinEquiv.symm i).1)) ω (finProdFinEquiv.symm i).2)
  refine pr_prod_le_snd (fun ω salt => ∀ i, (exp W salt (cmp W salt (Cf ω salt) ω) i).run
    ((p3ChainModel 220 wc).answer ω) = Cf ω salt i) _ fun salt => ?_
  have hb := h β (fun s : Fin N => tagR salt s.val) (fun s => WlabW wc (WsegW wc N W s))
    (fun ω => cmp W salt (Cf ω salt) ω)
    (fun σ s v => progMap (codeEquiv 220 wc).symm (exp W salt σ (finProdFinEquiv (s, v))))
    (tagR_injective N hN salt) (fun σ s c => bounded_progMap _ (hexp _ _ _ _))
  refine le_trans (pr_mono fun ω hω => ?_) hb
  intro s
  refine le_trans (le_of_eq (by rw [Finset.card_univ, Fintype.card_fin])) (Finset.card_le_card (s := Finset.univ) ?_)
  intro v _
  have hi := hω (finProdFinEquiv (s, v))
  refine Finset.mem_filter.2 ⟨Finset.mem_univ _, (run_progMap _ _ _).trans ((congrArg (codeEquiv 220 wc).symm hi).trans ?_)⟩
  show (codeEquiv 220 wc).symm (codeEquiv 220 wc (topLabelC
      (tagR salt (finProdFinEquiv.symm (finProdFinEquiv (s, v))).1.val) Gr
      (WlabW wc (WsegW wc N W (finProdFinEquiv.symm (finProdFinEquiv (s, v))).1)) ω
      (finProdFinEquiv.symm (finProdFinEquiv (s, v))).2)) = _
  simp only [Equiv.symm_apply_apply]

/-! ## 14 GB at 64 KB: `N = 971`, `k = 106` -/

theorem stateBound_C14GB : (p3SchemeNC 2384 Gr 971).stateBound Params.ρ = 106142606147 := by
  show ⌊Params.ρ * ((971 * 220 * (220 * 2384) : ℕ) : ℚ)⌋₊ = 106142606147
  rw [Nat.floor_eq_iff (by norm_num [Params.ρ])]
  norm_num [Params.ρ]

set_option exponentiation.threshold 3000 in
/-- `B^106 ≤ 2^1877` at `B = 971·220`. -/
theorem hist_C14GB : (971 * 220) ^ 106 ≤ 2 ^ 1877 := by norm_num

/-- `p₀^106 ≤ 1%` at `β = 110907229584`, via `p₀ ≤ 0.95748`. -/
theorem sampling_C14GB :
    ENNReal.ofReal (p₀ 110907229584 106142606147 (971 * 220) (220 * 2384)) ^ 106 ≤ ENNReal.ofReal (Params.δ : ℝ) := by
  have h0 : 0 ≤ p₀ 110907229584 106142606147 (971 * 220) (220 * 2384) := by unfold p₀; norm_num
  have hq : p₀ 110907229584 106142606147 (971 * 220) (220 * 2384) ≤ 47874 / 50000 := by unfold p₀; norm_num
  rw [← ENNReal.ofReal_pow h0]
  refine ENNReal.ofReal_le_ofReal ((pow_le_pow_left₀ h0 hq 106).trans ?_)
  norm_num [Params.δ]

/-- **P3 with concrete `H` at 64 KB over 14 GB (`N = 971`), at any timed depth `D`**, from `P3ChainEPFMulti` and a
chain certificate with `X = 1`: `k = 106`. -/
theorem p3_meets_concrete_multi_64_at (hM : P3ChainEPFMulti) (h1 : Pous.Guarantees.Theorem1iiSeq) (D : ℕ)
    (hard : P3ChainHard Gr 512 2384 D 220 1) :
    Meets (p3SchemeNC 2384 Gr 971) .sequential D (2 ^ 20) 106 ((2⁻¹ : ℝ≥0∞) ^ 128) := by
  refine ⟨le_rfl, p3SchemeNC_correct _ _ _, p3SchemeNC_codeHoldsW _ _ _, p3SchemeNC_space _ _ _ (by norm_num), ?_⟩
  intro W A₁ A₂
  have hJ := jointSegBoundC_of_epfMulti 2384 Gr 971 hM (by norm_num) (by norm_num) (c1_multi_64 (by norm_num))
    (c2_64_multi (by norm_num)) D 1 (by norm_num) (by norm_num)
    hard
  have hT := p3_timedINC_multiC 2384 Gr 971 (by norm_num) D (2 ^ 20) _ _ hJ 110907229584
  refine (h1 (p3SchemeNC 2384 Gr 971) D (2 ^ 20) 110907229584 ((p3SchemeNC 2384 Gr 971).stateBound Params.ρ) 106 _
    hT W A₁ A₂).trans ?_
  rw [stateBound_C14GB, add_comm]
  exact add_le_add sampling_C14GB (union_termW (220 * 2384) 106 110907229584 _ 971 (971 * 220) _ 10 1877 76
    (by norm_num) hist_C14GB (by norm_num) (by norm_num) (by norm_num) (by norm_num [nPosC]))

/-- **Headline, conditional: P3 with concrete `H`, 64 KB, 14.005 GB, `D = 10`, `B(220, 12)`, `k = 106`**, from
`P3ChainEPFMulti` and `P3ChainCert`. -/
theorem p3_meets_concrete_multi_64_D10 (hM : P3ChainEPFMulti) (hC : P3ChainCert) :
    Meets (p3SchemeNC 2384 (Pous.P3Column.bandGraph 220 12) 971) .sequential 10 (2 ^ 20) 106 ((2⁻¹ : ℝ≥0∞) ^ 128) :=
