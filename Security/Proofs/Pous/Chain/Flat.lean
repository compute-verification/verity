section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# Public encoder, milestone 1: the proofs

Restates every definition and theorem of `PubEncoderDraft.lean` byte for byte and proves it: encode-after-decode for
the three dense schemes, monotonicity in `k`, the transfer (`pubAuditSecure_exact`, `pubAuditSecure_exact_iff`,
`pubMeets_exact`), the three instances at `k = 111` and the three sanity lemmas. Then the satisfiability witnesses:
every hypothesis these theorems take holds, jointly, at the deployed point, except `ChainExPostFacto`, the chain lane's
open lemma, on which `chain_pub_meets_64` is conditional.
-/

open Pous Pous.Labelling
open scoped ENNReal

/-! ### Targets -/

namespace Pous.Pinned

/-- **Proposed pin.** The random-oracle dense scheme at the 64 KB point (`2^9` blocks of 64 KB) meets the requirement
with a public encoder and the exact check: sequential reveal, `D = 5`, `Q = 2^20`, `k = 111`, `ε = 2^-128`. -/
def DensePubMeets64 : Prop :=
  PubMeets (Pous.Dense.denseScheme (2 ^ 9) 524288) (exactCheck _) .sequential 5 (2 ^ 20) 111 ((2⁻¹ : ℝ≥0∞) ^ 128)

end Pous.Pinned

namespace PousPub

/-- The 14 GB store (`448` segments of `2^9` blocks of 64 KB, random oracle) with a public encoder and the exact check,
at `k = 111`. -/
def SegPubMeets14 : Prop :=
  PubMeets (Pous.DenseReCert.segScheme 448 (2 ^ 9) 524288) (exactCheck _) .sequential 5 (2 ^ 20) 111
    ((2⁻¹ : ℝ≥0∞) ^ 128)

/-- The deployed scheme, the dense chain over the overwrite `Π₂` at the 64 KB point, for every salt, with a public
encoder and the exact check, at `k = 111`. -/
def ChainPubMeets64 : Prop :=
  ∀ salt : Bits 256,
    PubMeets (Pous.Sponge.chainDense (2 ^ 9) 524288 512 (Pous.Sponge.dom salt)) (exactCheck _) .sequential 5 (2 ^ 20)
      111 ((2⁻¹ : ℝ≥0∞) ^ 128)


/-! ### Encode after decode -/

theorem bxor_bxor_cancel {w : ℕ} (a c : Bits w) : bxor a (bxor c a) = c := by
  funext b
  show xor (a b) (xor (c b) (a b)) = c b
  cases a b <;> cases c b <;> rfl

/-- On any DAG, labelling the decoding of `C` gives `C` back: block `i`'s label query sees the parents' labels, which
are `C`'s blocks by induction, so its key is the one decoding removed. -/
theorem label_dec {N w : ℕ} (G : TopoDAG N) (H : LabelQry N w → Bits w) (C : Fin N → Bits w) (i : Fin N) :
    label G (fun i => bxor (C i) (H (i, fun j => if j ∈ G.par i then some (C j) else none))) H i = C i := by
  suffices h : ∀ n, ∀ i : Fin N, i.val = n →
      label G (fun i => bxor (C i) (H (i, fun j => if j ∈ G.par i then some (C j) else none))) H i = C i from
    h _ i rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro i hi
    rw [PousB5Chain.label_eq]
    have hq : PousB5Chain.realQ G
        (fun i => bxor (C i) (H (i, fun j => if j ∈ G.par i then some (C j) else none))) H i =
        (i, fun j => if j ∈ G.par i then some (C j) else none) := by
      unfold PousB5Chain.realQ
      congr 1
      funext j
      split_ifs with hj
      · have hlt := G.par_lt i j hj
        rw [Fin.lt_def] at hlt
        rw [ih j.val (by omega) j rfl]
      · rfl
    rw [hq]
    exact bxor_bxor_cancel _ _

theorem denseScheme_encDec (B ℓ : ℕ) [NeZero B] : (Pous.Dense.denseScheme B ℓ).EncDec := by
  intro pp C H r
  refine Prod.ext (funext fun i => i.elim0) (funext fun i => ?_)
  show label (Pous.Dense.completeDAG B) ((codeEquiv B ℓ).symm (codeEquiv B ℓ _)) H i = C i
  rw [Equiv.symm_apply_apply]
  exact label_dec _ H C i

theorem segScheme_encDec (N B ℓ : ℕ) [NeZero (N * B)] : (Pous.DenseReCert.segScheme N B ℓ).EncDec := by
  intro pp C H r
  refine Prod.ext (funext fun i => i.elim0) (funext fun i => ?_)
  show label (Pous.DenseReCert.segDAG N B) ((codeEquiv (N * B) ℓ).symm (codeEquiv (N * B) ℓ _)) H i = C i
  rw [Equiv.symm_apply_apply]
  exact label_dec _ H C i

/-- Block `i` absorbs only the blocks before it. -/
theorem absorbed_congr {B ℓ : ℕ} {X Y : Fin B → Bits ℓ} (i : Fin B) (h : ∀ j : Fin B, j.val < i.val → X j = Y j) :
    Pous.Sponge.absorbed X i = Pous.Sponge.absorbed Y i := by
  unfold Pous.Sponge.absorbed Pous.Sponge.parentsNF
  congr 1
  congr 1
  funext j
  exact h _ (by show i.val - 1 - j.val < i.val; omega)

/-- Over the overwrite chain, labelling the decoding of `C` gives `C` back. -/
theorem labelOv_dec {B ℓ c : ℕ} (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (C : Fin B → Bits ℓ) (i : Fin B) :
    Pous.Sponge.labelOv f dom (fun i => bxor (C i) (Pous.Sponge.ovKey f (dom i) (Pous.Sponge.absorbed C i))) i =
      C i := by
  suffices h : ∀ n, ∀ i : Fin B, i.val = n →
      Pous.Sponge.labelOv f dom (fun i => bxor (C i) (Pous.Sponge.ovKey f (dom i) (Pous.Sponge.absorbed C i))) i =
        C i from h _ i rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro i hi
    rw [Pous.Sponge.labelOv_eq, absorbed_congr i fun j hj => ih j.val (by omega) j rfl]
    exact bxor_bxor_cancel _ _

theorem chainDense_encDec (B ℓ c : ℕ) [NeZero B] (dom : ℕ → Bits c) : (Pous.Sponge.chainDense B ℓ c dom).EncDec := by
  intro pp C π r
  refine Prod.ext (funext fun i => i.elim0) (funext fun i => ?_)
  show Pous.Sponge.labelOv _ dom ((codeEquiv B ℓ).symm (codeEquiv B ℓ _)) i = C i
  rw [Equiv.symm_apply_apply]
  exact labelOv_dec _ dom C i

/-! ### More challenges never help the adversary -/

/-- The first answers of a sequential audit do not depend on the later indices. -/
theorem seqAnswers_take_append {M : IdealModel} {ℓ S B : ℕ} (f : M.Qry → M.Ans)
    (step : ℕ → Bits S → Fin B → Prog M (Bits ℓ × Bits S)) :
    ∀ (j : ℕ) (l₁ l₂ : List (Fin B)) (σ : Bits S),
      (seqAnswers f step j (l₁ ++ l₂) σ).take l₁.length = seqAnswers f step j l₁ σ
  | _, [], _, _ => by simp [seqAnswers]
  | j, i :: is, l₂, σ => by
      simp only [List.cons_append, seqAnswers, List.length_cons, List.take_succ_cons]
      rw [seqAnswers_take_append f step (j + 1) is l₂]

/-- A uniform `k + j` indices, split into the first `k` and the rest. -/
def splitIdx (k j B : ℕ) : (Fin (k + j) → Fin B) ≃ (Fin k → Fin B) × (Fin j → Fin B) :=
  (Equiv.arrowCongr finSumFinEquiv.symm (Equiv.refl _)).trans (Equiv.sumArrowEquivProdArrow _ _ _)

theorem splitIdx_fst {k j B : ℕ} (I : Fin (k + j) → Fin B) :
    (splitIdx k j B I).1 = fun t => I (Fin.castAdd j t) := by
  funext t
  simp [splitIdx, Equiv.arrowCongr]

/-- An event of the first component of a relabelled sample space. -/
theorem pr_proj {α β γ : Type} [Fintype α] [Fintype β] [Fintype γ] [Nonempty γ] (e : α ≃ β × γ) (P : β → Prop) :
    pr (fun a => P (e a).1) = pr P :=
  (PousThm1Dense.pr_equiv e (fun y : β × γ => P y.1)).trans (PousThm1Dense.pr_fst P)

theorem auditSecure_seq_add {M : IdealModel} (sch : Scheme M) {S D Q k : ℕ} (j : ℕ) {δ ε : ℝ≥0∞}
    (h : AuditSecure sch .sequential S D Q k δ ε) : AuditSecure sch .sequential S D Q (k + j) δ ε := by
  intro W A₁ A₂
  refine le_trans ?_ (h W A₁ A₂)
  have hsub : ∀ x : Outcome sch (k + j), seqAccepts sch (k + j) W A₁ A₂ x →
      seqAccepts sch k W A₁ A₂ (x.1, x.2.1, fun t => x.2.2 (Fin.castAdd j t)) := by
    intro x hx
    simp only [seqAccepts] at hx ⊢
    have h1 := congrArg (List.take k) hx
    simp only [List.ofFn_add] at h1
    rw [List.take_left' List.length_ofFn] at h1
    have h2 := seqAnswers_take_append (M.answer x.1) (A₂.step W (sch.enc W x.1 x.2.1).1) 0
      (List.ofFn fun i : Fin k => x.2.2 (i.castLE (Nat.le_add_right k j)))
      (List.ofFn fun i : Fin j => x.2.2 (i.natAdd k))
      (A₁ W (sch.enc W x.1 x.2.1).1 (sch.enc W x.1 x.2.1).2 x.1)
    rw [List.length_ofFn] at h2
    exact h2.symm.trans h1
  have : Nonempty (Fin j → Fin sch.B) := ⟨fun _ => ⟨0, sch.B_pos⟩⟩
  let e : Outcome sch (k + j) ≃ Outcome sch k × (Fin j → Fin sch.B) :=
    ((Equiv.refl M.Ω).prodCongr ((Equiv.refl sch.Coins).prodCongr (splitIdx k j sch.B))).trans
      (((Equiv.refl M.Ω).prodCongr (Equiv.prodAssoc _ _ _).symm).trans (Equiv.prodAssoc _ _ _).symm)
  have he : ∀ x, (e x).1 = (x.1, x.2.1, fun t => x.2.2 (Fin.castAdd j t)) := by
    intro x
    simp only [e, Equiv.trans_apply, Equiv.prodCongr_apply, Equiv.coe_refl, Prod.map, id,
      Equiv.prodAssoc_symm_apply]
    rw [splitIdx_fst]
  calc pr (seqAccepts sch (k + j) W A₁ A₂)
      ≤ pr (fun x : Outcome sch (k + j) => seqAccepts sch k W A₁ A₂ (x.1, x.2.1, fun t => x.2.2 (Fin.castAdd j t))) :=
        pr_mono hsub
    _ = pr (fun x => seqAccepts sch k W A₁ A₂ (e x).1) := by simp only [he]
    _ = pr (seqAccepts sch k W A₁ A₂) := pr_proj e _

theorem meets_seq_add {M : IdealModel} (sch : Scheme M) {D Q k : ℕ} (j : ℕ) {ε : ℝ≥0∞}
    (h : Meets sch .sequential D Q k ε) : Meets sch .sequential D Q (k + j) ε :=
  ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, auditSecure_seq_add sch j h.2.2.2.2⟩

/-! ### The transfer: the exact check reduces the public game to today's -/

/-- The exact check's outcome is today's outcome with a `Unit` coordinate for the check's coins. -/
def dropUnit {M : IdealModel} (sch : Scheme M) (k : ℕ) : PubOutcome sch Unit k ≃ Outcome sch k :=
  (Equiv.refl M.Ω).prodCongr ((Equiv.refl sch.Coins).prodCongr (Equiv.uniqueProd (Fin k → Fin sch.B) Unit))

/-- The exact check accepts only the honest encoding: `dec pp C = W` and `EncDec` give `enc W = (pp, C)`. -/
theorem enc_eq_of_dec {M : IdealModel} {sch : Scheme M} (hed : sch.EncDec) {W : Bits sch.n} {pp : Bits sch.t}
    {C : sch.Code} {ω : M.Ω} (r : sch.Coins) (h : sch.dec pp C (M.answer ω) = W) : sch.enc W ω r = (pp, C) := by
  rw [← h]
  exact hed pp C ω r

theorem pubAuditSecure_exact {M : IdealModel} (sch : Scheme M) [Subsingleton sch.Coins] (hed : sch.EncDec)
    (reveal : Reveal) {S D Q k : ℕ} {δ ε : ℝ≥0∞} (h : AuditSecure sch reveal S D Q k δ ε) :
    PubAuditSecure sch (exactCheck sch) reveal S D Q k δ ε := by
  obtain ⟨r₀⟩ := (inferInstance : Nonempty sch.Coins)
  cases reveal with
  | simultaneous =>
    intro W E A₁ A₂
    refine le_trans ?_ (h W (fun W pp C ω => A₁ W pp C r₀ () ω) A₂)
    refine le_trans (pr_mono fun x hx => ?_) (le_of_eq (PousThm1Dense.pr_equiv (dropUnit sch k) _))
    obtain ⟨ω, r, ξ, I⟩ := x
    obtain ⟨hdec, hacc⟩ := hx
    have henc := enc_eq_of_dec hed r hdec
    cases ξ
    show simAccepts sch W _ A₂ (ω, r, I)
    simp only [simAccepts, henc]
    rw [Subsingleton.elim r₀ r]
    exact hacc
  | sequential =>
    intro W E A₁ A₂
    refine le_trans ?_ (h W (fun W pp C ω => A₁ W pp C r₀ () ω) A₂)
    refine le_trans (pr_mono fun x hx => ?_) (le_of_eq (PousThm1Dense.pr_equiv (dropUnit sch k) _))
    obtain ⟨ω, r, ξ, I⟩ := x
    obtain ⟨hdec, hacc⟩ := hx
    have henc := enc_eq_of_dec hed r hdec
    cases ξ
    show seqAccepts sch k W _ A₂ (ω, r, I)
    simp only [seqAccepts, henc]
    rw [Subsingleton.elim r₀ r]
    exact hacc

/-- With the exact check the public game is today's game, no weaker and no stronger. -/
theorem pubAuditSecure_exact_iff {M : IdealModel} (sch : Scheme M) [Subsingleton sch.Coins] (hc : sch.Correct)
    (hed : sch.EncDec) (reveal : Reveal) {S D Q k : ℕ} {δ ε : ℝ≥0∞} :
    PubAuditSecure sch (exactCheck sch) reveal S D Q k δ ε ↔ AuditSecure sch reveal S D Q k δ ε := by
  refine ⟨fun hpub => ?_, pubAuditSecure_exact sch hed reveal⟩
  cases reveal with
  | simultaneous =>
    intro W A₁ A₂
    refine le_trans ?_ (hpub W sch.enc (fun W pp C _ _ ω => A₁ W pp C ω) A₂)
    rw [← PousThm1Dense.pr_equiv (dropUnit sch k) (simAccepts sch W A₁ A₂)]
    refine pr_mono fun x hx => ?_
    obtain ⟨ω, r, ξ, I⟩ := x
    exact ⟨hc W ω r, hx⟩
  | sequential =>
    intro W A₁ A₂
    refine le_trans ?_ (hpub W sch.enc (fun W pp C _ _ ω => A₁ W pp C ω) A₂)
    rw [← PousThm1Dense.pr_equiv (dropUnit sch k) (seqAccepts sch k W A₁ A₂)]
    refine pr_mono fun x hx => ?_
    obtain ⟨ω, r, ξ, I⟩ := x
    exact ⟨hc W ω r, hx⟩

theorem pubMeets_exact {M : IdealModel} (sch : Scheme M) [Subsingleton sch.Coins] (hed : sch.EncDec)
    {reveal : Reveal} {D Q k : ℕ} {ε : ℝ≥0∞} (h : Meets sch reveal D Q k ε) :
    PubMeets sch (exactCheck sch) reveal D Q k ε :=
  ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, fun W ω r _ => h.2.1 W ω r, pubAuditSecure_exact sch hed reveal h.2.2.2.2⟩

/-! ### Instances -/

instance instSubsingletonCoinsDenseScheme (B ℓ : ℕ) [NeZero B] : Subsingleton (Pous.Dense.denseScheme B ℓ).Coins := inferInstanceAs (Subsingleton Unit)

instance instSubsingletonCoinsSegScheme (N B ℓ : ℕ) [NeZero (N * B)] : Subsingleton (Pous.DenseReCert.segScheme N B ℓ).Coins :=
  inferInstanceAs (Subsingleton Unit)

instance instSubsingletonCoinsChainDense (B ℓ c : ℕ) [NeZero B] (dom : ℕ → Bits c) : Subsingleton (Pous.Sponge.chainDense B ℓ c dom).Coins :=
  inferInstanceAs (Subsingleton Unit)

/-- The trusted `Pous.Dense.denseScheme` is the dense file's `PousDenseChain.denseScheme`, verbatim. -/
theorem denseScheme_trusted (B ℓ : ℕ) [NeZero B] : PousDenseChain.denseScheme B ℓ = Pous.Dense.denseScheme B ℓ := rfl

theorem dense_pub_meets_64 : Pous.Pinned.DensePubMeets64 := by
  have h := meets_seq_add _ 5 Pous.DenseReCert.dense_meets_64
  rw [denseScheme_trusted] at h
  exact pubMeets_exact _ (denseScheme_encDec _ _) h

theorem seg_pub_meets_14 : SegPubMeets14 :=
  pubMeets_exact _ (segScheme_encDec _ _ _) (meets_seq_add _ 5 Pous.DenseReCert.seg_meets_14)

theorem chain_pub_meets_64 (hepf : Pous.Sponge.ChainExPostFacto) : ChainPubMeets64 := fun salt =>
  pubMeets_exact _ (chainDense_encDec _ _ _ _) (PousSpongeChain.chain_meets_64 hepf salt)

/-! ### The game is not vacuous -/

/-- A check that accepts everything. -/
def acceptAll {M : IdealModel} (sch : Scheme M) : SetupCheck sch where
  Ξ := Unit
  accepts _ _ _ _ _ := True

/-- The honest preprocessor of the public game stores the server's codeword whole. -/
def honestPubPre {M : IdealModel} (sch : Scheme M) (Ξ : Type) : PubPreprocessor sch Ξ (sch.B * sch.ℓ) :=
  fun _ _ C _ _ _ => codeEquiv _ _ C

theorem exactCheck_complete {M : IdealModel} (sch : Scheme M) (h : sch.Correct) : (exactCheck sch).Complete :=
  fun W ω r _ => h W ω r

theorem honest_pub_seq_accepted {M : IdealModel} (sch : Scheme M) (V : SetupCheck sch) (hV : V.Complete) (k : ℕ)
    (W : Bits sch.n) : pr (pubSeqAccepts sch V k W sch.enc (honestPubPre sch V.Ξ) (honestSeq sch)) = 1 :=
  pr_eq_one fun x => by
    refine ⟨hV W x.1 x.2.1 x.2.2.1, ?_⟩
    simp only [honestSeq, honestPubPre]
    rw [seqAnswers_const _ (fun σ i => (codeEquiv _ _).symm σ i), List.map_ofFn]
    congr 1
    funext j
    simp

/-- The all-zero server, stateless zero responder. -/
def zeroSeq {M : IdealModel} (sch : Scheme M) (S D Q : ℕ) : SeqResponder sch S D Q where
  step _ _ _ σ _ := .ret ((fun _ => false), σ)
  bounded _ _ _ _ _ := ret_bounded _ _ _

theorem acceptAll_not_pubAuditSecure {M : IdealModel} (sch : Scheme M) (S D Q k : ℕ) {δ ε : ℝ≥0∞}
    (h : δ + ε < 1) : ¬ PubAuditSecure sch (acceptAll sch) .sequential S D Q k δ ε := by
  intro hsec
  have hone : pr (pubSeqAccepts sch (acceptAll sch) k (fun _ => false)
      (fun _ _ _ => ((fun _ => false), fun _ _ => false)) (fun _ _ _ _ _ _ => fun _ => false) (zeroSeq sch S D Q)) =
      1 :=
    pr_eq_one fun x => by
      refine ⟨trivial, ?_⟩
      simp only [zeroSeq]
      rw [seqAnswers_const _ (fun _ _ => fun _ => false), List.map_ofFn]
      rfl
  have := hsec (fun _ => false) (fun _ _ _ => ((fun _ => false), fun _ _ => false))
    (fun _ _ _ _ _ _ => fun _ => false) (zeroSeq sch S D Q)
  rw [hone] at this
  exact absurd (this.trans_lt h) (lt_irrefl 1)

/-! ### Satisfiability witnesses

Every hypothesis of the theorems above holds, jointly, at the deployed point. `ChainExPostFacto` is the exception: it is
the chain lane's open lemma, and `chain_pub_meets_64` is conditional on it. -/

/-- The hypotheses of `pubAuditSecure_exact`, `pubAuditSecure_exact_iff`, `pubMeets_exact` and `auditSecure_seq_add`
all hold for the trusted dense scheme at the 64 KB point: no encoder coins, bit-exact decoding, encode-after-decode,
and today's audit bound at `k = 106` and hence `k = 111`. -/
theorem transfer_hyps_witness :
    Subsingleton (Pous.Dense.denseScheme (2 ^ 9) 524288).Coins ∧ (Pous.Dense.denseScheme (2 ^ 9) 524288).Correct ∧
      (Pous.Dense.denseScheme (2 ^ 9) 524288).EncDec ∧
      AuditSecure (Pous.Dense.denseScheme (2 ^ 9) 524288) .sequential
        ((Pous.Dense.denseScheme (2 ^ 9) 524288).stateBound Params.ρ) 5 (2 ^ 20) 106 (ENNReal.ofReal Params.δ)
        ((2⁻¹ : ℝ≥0∞) ^ 128) ∧
      Meets (Pous.Dense.denseScheme (2 ^ 9) 524288) .sequential 5 (2 ^ 20) 111 ((2⁻¹ : ℝ≥0∞) ^ 128) := by
  have h106 := Pous.DenseReCert.dense_meets_64
  rw [denseScheme_trusted] at h106
  exact ⟨inferInstance, h106.2.1, denseScheme_encDec _ _, h106.2.2.2.2, meets_seq_add _ 5 h106⟩

/-- The same at 14 GB and for the chain: no encoder coins and encode-after-decode (the chain's audit bound is the
`ChainExPostFacto`-conditional `chain_meets_64`). -/
theorem transfer_hyps_witness_seg_chain (salt : Bits 256) :
    Subsingleton (Pous.DenseReCert.segScheme 448 (2 ^ 9) 524288).Coins ∧
      (Pous.DenseReCert.segScheme 448 (2 ^ 9) 524288).EncDec ∧
      Meets (Pous.DenseReCert.segScheme 448 (2 ^ 9) 524288) .sequential 5 (2 ^ 20) 111 ((2⁻¹ : ℝ≥0∞) ^ 128) ∧
      Subsingleton (Pous.Sponge.chainDense (2 ^ 9) 524288 512 (Pous.Sponge.dom salt)).Coins ∧
      (Pous.Sponge.chainDense (2 ^ 9) 524288 512 (Pous.Sponge.dom salt)).Correct ∧
      (Pous.Sponge.chainDense (2 ^ 9) 524288 512 (Pous.Sponge.dom salt)).EncDec :=
  ⟨inferInstance, segScheme_encDec _ _ _, meets_seq_add _ 5 Pous.DenseReCert.seg_meets_14, inferInstance,
    Pous.Sponge.chainDense_correct _ _ _ _, chainDense_encDec _ _ _ _⟩

/-- The hypothesis of `honest_pub_seq_accepted` holds for the exact check on every correct scheme, in particular on the
deployed dense scheme, and the honest server is then accepted with probability 1. -/
theorem honest_hyps_witness (k : ℕ) (W : Bits ((Pous.Dense.denseScheme (2 ^ 9) 524288).n)) :
    (exactCheck (Pous.Dense.denseScheme (2 ^ 9) 524288)).Complete ∧
      pr (pubSeqAccepts (Pous.Dense.denseScheme (2 ^ 9) 524288) (exactCheck _) k W
        (Pous.Dense.denseScheme (2 ^ 9) 524288).enc (honestPubPre _ Unit) (honestSeq _)) = 1 :=
  ⟨exactCheck_complete _ transfer_hyps_witness.2.1,
    honest_pub_seq_accepted _ _ (exactCheck_complete _ transfer_hyps_witness.2.1) k W⟩

/-- The hypothesis of `acceptAll_not_pubAuditSecure` holds at the problem statement's `δ = 1%`, `ε = 2^-128`: a check
that accepts everything fails the requirement there. -/
theorem acceptAll_hyp_witness : ENNReal.ofReal (Params.δ : ℝ) + (2⁻¹ : ℝ≥0∞) ^ 128 < 1 := by
  have hδ : ENNReal.ofReal (Params.δ : ℝ) < 2⁻¹ := by
    rw [ENNReal.ofReal_lt_iff_lt_toReal (by norm_num [Params.δ]) (by simp)]
    norm_num [Params.δ]
  have hε : (2⁻¹ : ℝ≥0∞) ^ 128 ≤ 2⁻¹ := pow_le_of_le_one (by norm_num) (by norm_num) (by norm_num)
  calc ENNReal.ofReal (Params.δ : ℝ) + (2⁻¹ : ℝ≥0∞) ^ 128 < 2⁻¹ + 2⁻¹ :=
        ENNReal.add_lt_add_of_lt_of_le (by simp) hδ hε
    _ = 1 := ENNReal.inv_two_add_inv_two

/-- So the deployed dense scheme with an accept-all check fails the public-encoder game. -/
theorem acceptAll_fails_dense (k : ℕ) :
    ¬ PubAuditSecure (Pous.Dense.denseScheme (2 ^ 9) 524288) (acceptAll _) .sequential
      ((Pous.Dense.denseScheme (2 ^ 9) 524288).stateBound Params.ρ) 5 (2 ^ 20) k (ENNReal.ofReal Params.δ)
      ((2⁻¹ : ℝ≥0∞) ^ 128) :=
  acceptAll_not_pubAuditSecure _ _ _ _ _ acceptAll_hyp_witness

end PousPub

end


/-! ════ BandEncDec ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# Encode after decode for the overwrite-chain scheme on any DAG

`DISCREPANCIES.md` row B4 (public encoder): `pubMeets_exact` carries `Meets` to the public-encoder game for any scheme
with `Scheme.EncDec`. That was proved for `chainDense` (`chainDense_encDec`, `public-encoder/PubEncoder.lean`), not for
the band codec `chainBand`.

`labelG_dec` is `labelOv_dec` ported to `labelG`, for any `TopoDAG`: labelling the decoding of any codeword `C` gives
`C` back, by strong induction over the nodes. A row absorbs only its parents, which come earlier. Both codecs come from
it:
- `chainScheme_encDec` for every DAG, hence `chainBand_encDec`;
- `chainDense_encDec_generic`, dense's `EncDec` again, through `labelG_complete` (`labelG` on the complete DAG is
  `labelOv`).

No hypothesis beyond the `[NeZero B]` every scheme takes. `band_codec_bijective_512` is the satisfiability witness: at
the deployment point the band codec is `Correct` and `EncDec`, so `dec` and `enc` are inverse bijections.
-/

namespace Pous.BandChain

open Pous Pous.Labelling Pous.Sponge PousSpongeChain
open scoped ENNReal

section EncDec

variable {N ℓ c : ℕ}

/-- A row absorbs only its parents' blocks. -/
theorem absorbedG_congr (G : TopoDAG N) {X Y : Fin N → Bits ℓ} (v : Fin N) (h : ∀ u ∈ G.par v, X u = Y u) :
    absorbedG G X v = absorbedG G Y v := by
  unfold absorbedG
  congr 1
  exact List.map_congr_left fun u hu => h u ((Finset.mem_sort _).1 hu)

/-- **Labelling the decoding of `C` gives `C` back, on any DAG.** The port of `labelOv_dec` to `labelG`. -/
theorem labelG_dec (G : TopoDAG N) (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (C : Fin N → Bits ℓ) (v : Fin N) :
    labelG G f dom (fun u => bxor (C u) (ovKey f (dom u) (absorbedG G C u))) v = C v := by
  induction v using WellFoundedLT.induction with
  | _ v ih =>
    rw [labelG_eq, absorbedG_congr G v fun u hu => ih u (G.par_lt v u hu), bxor_comm _ (bxor (C v) _),
      bxor_self_right]

/-- **Encode after decode for the overwrite-chain scheme on any DAG.** -/
theorem chainScheme_encDec {B : ℕ} [NeZero B] (G : TopoDAG B) (ℓ c : ℕ) (dom : ℕ → Bits c) :
    (chainScheme G ℓ c dom).EncDec := by
  intro pp C π r
  refine Prod.ext (funext fun i => i.elim0) (funext fun i => ?_)
  show labelG G _ dom ((codeEquiv B ℓ).symm (codeEquiv B ℓ _)) i = C i
  rw [Equiv.symm_apply_apply]
  exact labelG_dec G _ dom C i

/-- **`EncDec` for the band codec** (row B4). -/
theorem chainBand_encDec (B d ℓ c : ℕ) [NeZero B] (dom : ℕ → Bits c) : (chainBand B d ℓ c dom).EncDec :=
  chainScheme_encDec (bandDAG B d) ℓ c dom

/-- On the complete DAG, a row absorbs what dense's row absorbs. -/
theorem absorbedG_complete {B ℓ : ℕ} (C : Fin B → Bits ℓ) (v : Fin B) :
    absorbedG (Dense.completeDAG B) C v = absorbed C v := by
  unfold absorbedG absorbed parentsNF
  rw [parentsDesc_complete, List.map_ofFn]
  rfl

/-- `labelOv_dec` recovered from `labelG_dec` on the complete DAG. -/
theorem labelOv_dec_generic {B ℓ c : ℕ} (f : Bits (ℓ + (ℓ + c)) → Bits (ℓ + (ℓ + c))) (dom : ℕ → Bits c)
    (C : Fin B → Bits ℓ) (i : Fin B) :
    labelOv f dom (fun i => bxor (C i) (ovKey f (dom i) (absorbed C i))) i = C i := by
  have h : (fun i => bxor (C i) (ovKey f (dom i) (absorbed C i))) =
      fun i => bxor (C i) (ovKey f (dom i) (absorbedG (Dense.completeDAG B) C i)) := by
    funext i; rw [absorbedG_complete]
  rw [← labelG_complete, h]
  exact labelG_dec (Dense.completeDAG B) f dom C i

/-- **Dense's `EncDec` from the same lemma**: `labelG_dec` on the complete DAG, through `labelG_complete` and
`absorbedG_complete`. -/
theorem chainDense_encDec_generic (B ℓ c : ℕ) [NeZero B] (dom : ℕ → Bits c) : (chainDense B ℓ c dom).EncDec := by
  intro pp C π r
  refine Prod.ext (funext fun i => i.elim0) (funext fun i => ?_)
  show labelOv _ dom ((codeEquiv B ℓ).symm (codeEquiv B ℓ _)) i = C i
  rw [Equiv.symm_apply_apply]
  exact labelOv_dec_generic _ dom C i

end EncDec

/-! ### Satisfiability witness -/

/-- The `[NeZero B]` the lemmas take holds at the deployment point `B = 2^9`. -/
theorem neZero_512 : NeZero (2 ^ 9 : ℕ) := inferInstance

/-- **Witness**: at the deployment point (64 KiB labels, `B = 512`, capacity 512, any salt, `d = 5` or the recommended
`d = 12`) the band codec is both `Correct` (`dec ∘ enc = id`) and `EncDec` (`enc ∘ dec = id`), so decoding is a
bijection with inverse encoding. -/
theorem band_codec_bijective_512 (salt : Bits 256) :
    (chainBand (2 ^ 9) 5 524288 512 (Pous.Sponge.dom salt)).Correct ∧
      (chainBand (2 ^ 9) 5 524288 512 (Pous.Sponge.dom salt)).EncDec ∧
      (chainBand (2 ^ 9) 12 524288 512 (Pous.Sponge.dom salt)).Correct ∧
      (chainBand (2 ^ 9) 12 524288 512 (Pous.Sponge.dom salt)).EncDec :=
  ⟨chainScheme_correct _ _ _ _, chainBand_encDec _ _ _ _ _, chainScheme_correct _ _ _ _, chainBand_encDec _ _ _ _ _⟩

end Pous.BandChain

end


/-! ════ BandPubEncoder ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# The band codec with a public encoder (row B4's consequence)

`pubMeets_exact` (`public-encoder/PubEncoder.lean`) carries `Meets` to the public-encoder game for any scheme with
`EncDec`. With `chainBand_encDec` and `band_meets_64`, the band codec meets it at the 64 KiB point with the exact
check, conditional on `ChainExPostFactoG` exactly as `band_meets_64` is. `ChainBandPubMeets64` is `ChainPubMeets64`
with the band codec in place of `chainDense`.
-/

namespace Pous.BandChain

open Pous Pous.Sponge
open scoped ENNReal

instance instSubsingletonCoinsChainBand (B d ℓ c : ℕ) [NeZero B] (dom : ℕ → Bits c) : Subsingleton (chainBand B d ℓ c dom).Coins :=
  inferInstanceAs (Subsingleton Unit)

/-- The band codec at the 64 KiB point (`2^9` blocks, in-degree `d`, capacity 512), for every salt, with a public
encoder and the exact check: sequential reveal, `D = 5`, `Q = 2^20`, `k = 111`, `ε = 2^-128`. -/
def ChainBandPubMeets64 (d : ℕ) : Prop :=
  ∀ salt : Bits 256,
    PubMeets (chainBand (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)) (exactCheck _) .sequential 5 (2 ^ 20) 111
      ((2⁻¹ : ℝ≥0∞) ^ 128)

/-- **The band codec meets the public-encoder requirement** for every `d ≥ 5`, given `ChainExPostFactoG`. -/
theorem band_pub_meets_64 (hepf : ChainExPostFactoG) (d : ℕ) (hd : 5 ≤ d) : ChainBandPubMeets64 d := fun salt =>
  PousPub.pubMeets_exact _ (chainBand_encDec _ _ _ _ _) (band_meets_64 hepf d hd salt)

/-- Witnesses for `5 ≤ d`: `d = 5`, and the recommended `d = 12`. -/
theorem band_pub_meets_64_d5 (hepf : ChainExPostFactoG) : ChainBandPubMeets64 5 := band_pub_meets_64 hepf 5 le_rfl

theorem band_pub_meets_64_d12 (hepf : ChainExPostFactoG) : ChainBandPubMeets64 12 :=
  band_pub_meets_64 hepf 12 (by norm_num)

end Pous.BandChain

end


/-! ════ PubEncoderBand ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-!
# Public encoder, milestone 1, for the band codec, from the key-rule obligation

Milestone 1 (the exact check, `PubEncoder.lean`) for the band codec at `k = 111`, conditional on the key-rule target
`ChainExPostFactoG'` alone, through `chainExPostFactoG'_iff` (`band-chain/BandChainKeyRuleEquiv.lean`). Once
`ChainExPostFactoG'` is a theorem (the v6 tail, `internal/p3-instantiation/band-v6-design.md`), every statement here is
unconditional by one application.

**The public data changes nothing the obligation must say.** `pubMeets_exact_iff`: for a scheme with no coins and
encode-after-decode, `PubMeets` with the exact check is `Meets`, in both directions. So the public-encoder band
deployments are the band deployments (`band_pub_iff_64`, `band_pub_iff_14`, `band_pub_iff_14_global`), and whatever
proves the latter (`ChainExPostFactoG'`, fixed data, a preprocessor that sees the whole primitive) proves the former.
The server's `C*` is forced to `Enc(W)`, the setup coins are `Unit` and the check has no coins, so the preprocessor
gains nothing it did not already have.
-/

open Pous
open scoped ENNReal

namespace PousPub

/-! ### The public game with the exact check is today's requirement -/

/-- **`PubMeets` with the exact check is `Meets`**, for a scheme with no coins and encode-after-decode. -/
theorem pubMeets_exact_iff {M : IdealModel} (sch : Scheme M) [Subsingleton sch.Coins] (hed : sch.EncDec)
    {reveal : Reveal} {D Q k : ℕ} {ε : ℝ≥0∞} :
    PubMeets sch (exactCheck sch) reveal D Q k ε ↔ Meets sch reveal D Q k ε :=
  ⟨fun h => ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, (pubAuditSecure_exact_iff sch h.2.1 hed reveal).mp h.2.2.2.2.2⟩,
    pubMeets_exact sch hed⟩

/-! ### The band codec at 14 GB -/

instance instSubsingletonCoinsChainBandSeg (N B d ℓ c : ℕ) [NeZero (N * B)] (dom : ℕ → Bits c) :
    Subsingleton (Pous.BandMulti.chainBandSeg N B d ℓ c dom).Coins :=
  inferInstanceAs (Subsingleton Unit)

/-- Encode after decode for the 14 GB band: `chainBandSeg` is `chainScheme` on the band union. -/
theorem chainBandSeg_encDec (N B d ℓ c : ℕ) [NeZero (N * B)] (dom : ℕ → Bits c) :
    (Pous.BandMulti.chainBandSeg N B d ℓ c dom).EncDec :=
  Pous.BandChain.chainScheme_encDec _ ℓ c dom

/-- The 14 GB band under the implementation's per-segment tags, with a public encoder and the exact check, `k = 111`. -/
def ChainBandPubMeets14 (d : ℕ) : Prop :=
  ∀ salt : Bits 192,
    PubMeets (Pous.BandMulti.chainBandSeg 448 (2 ^ 9) d 524288 512 (Pous.BandMulti.segDom salt (2 ^ 9))) (exactCheck _)
      .sequential 5 (2 ^ 20) 111 ((2⁻¹ : ℝ≥0∞) ^ 128)

/-- The same with one global salt and global indices. -/
def ChainBandPubMeets14Global (d : ℕ) : Prop :=
  ∀ salt : Bits 256,
    PubMeets (Pous.BandMulti.chainBandSeg 448 (2 ^ 9) d 524288 512 (Pous.Sponge.dom salt)) (exactCheck _)
      .sequential 5 (2 ^ 20) 111 ((2⁻¹ : ℝ≥0∞) ^ 128)

/-! ### The public data changes nothing: the public band deployments are the band deployments -/

theorem band_pub_iff_64 (d : ℕ) : Pous.BandChain.ChainBandPubMeets64 d ↔ Pous.BandChain.ChainBandMeets64 d :=
  forall_congr' fun _ => pubMeets_exact_iff _ (Pous.BandChain.chainBand_encDec _ _ _ _ _)

theorem band_pub_iff_14 (d : ℕ) : ChainBandPubMeets14 d ↔ Pous.BandMulti.ChainBandMeets14 d :=
  forall_congr' fun _ => pubMeets_exact_iff _ (chainBandSeg_encDec _ _ _ _ _ _)

theorem band_pub_iff_14_global (d : ℕ) : ChainBandPubMeets14Global d ↔ Pous.BandMulti.ChainBandMeets14Global d :=
  forall_congr' fun _ => pubMeets_exact_iff _ (chainBandSeg_encDec _ _ _ _ _ _)

/-! ### Milestone 1 for the band codec from `ChainExPostFactoG'` -/

/-- **64 KiB**: the band codec with a public encoder and the exact check, `k = 111`, every salt and every `d ≥ 5`,
from the key-rule target through `chainExPostFactoG'_iff`. -/
theorem band_pub_meets_64_of_keyRule (h : Pous.BandChain.ChainExPostFactoG') (d : ℕ) (hd : 5 ≤ d) :
    Pous.BandChain.ChainBandPubMeets64 d :=
  (band_pub_iff_64 d).mpr (Pous.BandChain.band_meets_64 (Pous.BandChain.chainExPostFactoG'_iff.mp h) d hd)

/-- **14 GB**, both domain layouts, `k = 111`, every `d ≥ 5`. -/
theorem band_pub_meets_14_of_keyRule (h : Pous.BandChain.ChainExPostFactoG') (d : ℕ) (hd : 5 ≤ d) :
    ChainBandPubMeets14 d ∧ ChainBandPubMeets14Global d :=
  have hm := Pous.BandMulti.band_meets_14 (Pous.BandChain.chainExPostFactoG'_iff.mp h) d hd
  ⟨(band_pub_iff_14 d).mpr hm.1, (band_pub_iff_14_global d).mpr hm.2⟩

/-- At the recommended in-degree `d = 12` (red-team §39): all three public-encoder band deployments. -/
theorem band_pub_meets_d12_of_keyRule (h : Pous.BandChain.ChainExPostFactoG') :
    Pous.BandChain.ChainBandPubMeets64 12 ∧ ChainBandPubMeets14 12 ∧ ChainBandPubMeets14Global 12 :=
  ⟨band_pub_meets_64_of_keyRule h 12 (by norm_num), band_pub_meets_14_of_keyRule h 12 (by norm_num)⟩

/-! ### Satisfiability witnesses

`5 ≤ d` holds at `d = 5` and `d = 12`, and the hypotheses of `pubMeets_exact_iff` (no coins, encode-after-decode) hold
for both band schemes at the deployed points. `ChainExPostFactoG'` has no witness here: it is the band builder's open
obligation, and the theorems above are conditional on it. -/

theorem band_d_witness : 5 ≤ 5 ∧ 5 ≤ 12 := ⟨le_rfl, by norm_num⟩

theorem band_pub_hyps_witness (salt : Bits 256) (salt' : Bits 192) :
    Subsingleton (Pous.BandChain.chainBand (2 ^ 9) 12 524288 512 (Pous.Sponge.dom salt)).Coins ∧
      (Pous.BandChain.chainBand (2 ^ 9) 12 524288 512 (Pous.Sponge.dom salt)).EncDec ∧
      Subsingleton
        (Pous.BandMulti.chainBandSeg 448 (2 ^ 9) 12 524288 512 (Pous.BandMulti.segDom salt' (2 ^ 9))).Coins ∧
      (Pous.BandMulti.chainBandSeg 448 (2 ^ 9) 12 524288 512 (Pous.BandMulti.segDom salt' (2 ^ 9))).EncDec ∧
      (Pous.BandMulti.chainBandSeg 448 (2 ^ 9) 12 524288 512 (Pous.Sponge.dom salt)).EncDec :=
  ⟨inferInstance, Pous.BandChain.chainBand_encDec _ _ _ _ _, inferInstance, chainBandSeg_encDec _ _ _ _ _ _,
    chainBandSeg_encDec _ _ _ _ _ _⟩

end PousPub

end


/-! ════ ChainEPFV6FinalPub ════ -/
section
set_option autoImplicit true
set_option relaxedAutoImplicit true


/-! # Public-encoder band results: unconditional finals

`band_pub_meets_64` with `ChainExPostFactoG` discharged by `chainExPostFactoG_v6`. The iffs
`band_pub_iff_14`/`band_pub_iff_14_global` carry the 14 GB finals to the public encoder. `band_pub_iff_64`
takes no hypothesis; applied to `band_meets_64_final` it gives the same statement as `band_pub_meets_64_final`. -/

namespace PousPub

open PousSpongeChain

/-- **The band at 64 KiB with a public encoder**, unconditional: an untrusted server encoding the data is exactly
as secure as verifier-side encoding (`PubMeets` with the exact check). Deployment conditions (review §48): (1) the check is the exact, full-decode check, and a
sampled or spot check is not covered; (2) the salt is fixed by the verifier or the protocol, not the server; (3) `W`
is fixed before setup, and the primitive is independent of `W` and the salt; (4) the commitment to `W` and the
binding of `C*` are idealized. -/
theorem band_pub_meets_64_final (d : ℕ) (hd : 5 ≤ d) : Pous.BandChain.ChainBandPubMeets64 d :=
  Pous.BandChain.band_pub_meets_64 chainExPostFactoG_v6 d hd

/-- **The band at 14 GiB with a public encoder**, per-segment tags, unconditional. Deployment conditions (review §48): (1) the check is the exact, full-decode check, and a
sampled or spot check is not covered; (2) the salt is fixed by the verifier or the protocol, not the server; (3) `W`
is fixed before setup, and the primitive is independent of `W` and the salt; (4) the commitment to `W` and the
binding of `C*` are idealized. -/
theorem band_pub_meets_14_final (d : ℕ) (hd : 5 ≤ d) : ChainBandPubMeets14 d :=
  (band_pub_iff_14 d).2 (Pous.BandMulti.band_meets_14_final d hd).1

/-- **The band at 14 GiB with a public encoder**, one global salt, unconditional. Deployment conditions (review §48): (1) the check is the exact, full-decode check, and a
sampled or spot check is not covered; (2) the salt is fixed by the verifier or the protocol, not the server; (3) `W`
is fixed before setup, and the primitive is independent of `W` and the salt; (4) the commitment to `W` and the
binding of `C*` are idealized. -/
theorem band_pub_meets_14_global_final (d : ℕ) (hd : 5 ≤ d) : ChainBandPubMeets14Global d :=
  (band_pub_iff_14_global d).2 (Pous.BandMulti.band_meets_14_final d hd).2

end PousPub

end

