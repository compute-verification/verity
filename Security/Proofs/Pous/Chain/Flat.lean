/-!
# `ChainExPostFactoG` from the compression: the final assembly

Work file of `bc-a359729a`. It edits no file of `bc-35b053cc`.

`chainExPostFactoG_of_compression : CompressionHyp → ChainExPostFactoG`, with the right-hand side exactly as stated.
`CompressionHyp` is what the assembly needs from the compression layer (`pr_Ev`):
- **existence**: every set of fresh labels `L'` and fresh chaining values `H'` gives a pattern that holds, named by
  `(showing position, chain position)` pairs, with total width `ℓ|L'| + (ℓ+c)|H'|`;
- **probability**: each named pattern holds jointly with `NoCollU` with probability at most `∏ (2^w − nPos)⁻¹`.

**The assembly.**
- **Split.** `pr[win] ≤ pr[win ∧ NoCollU] + pr[Bad]`, and `pr[Bad] ≤ nPos²/2^(ℓ+c)` (`pr_Bad_le`).
- **Win ⇒ a pattern.** On `win`: with `σ = A₁ π` the fresh holding has size `> s` (`size_freshHolding_gt`), so a
  minimal set of `≤ s + 1` items carries width `≥ ℓs + 1` (`exists_minimal`), and it has a pattern (existence).
- **Union.** Sum over the `2^m` advice strings and the patterns (`sum_patterns_le`), with per-item names at most
  `nPos²·B` (`card_names_le`) and per-item factors at most `2·2^{-w}` (`inv_two_pow_sub_le`, when `2·nPos ≤ 2^ℓ`).
- **Degenerate cases.** `B = 0` (nothing is answered), and `2·nPos > 2^ℓ`, where the right-hand side is at least 1
  (`rhs_ge_one`).
-/

namespace PousSpongeChain

open Pous Pous.Labelling Pous.Sponge Pous.BandChain
open scoped ENNReal

namespace ChainReplay

variable {B ℓ c : ℕ} (R : ChainReplay B ℓ c)

/-- The width of the item a chain position names: `ℓ` for the pad position (a label), `ℓ + c` otherwise (a chaining
value). -/
def nameWidth (q : R.posSet) : ℕ := if q.1.2 = ovCalls R.G q.1.1 then ℓ else ℓ + c

theorem le_nameWidth (q : R.posSet) : ℓ ≤ R.nameWidth q := by
  unfold nameWidth; split_ifs <;> omega

end ChainReplay

/-- **What the assembly needs from the compression.** For each bounded replay (with injective domains): a pattern
predicate on named item lists such that fresh items always yield a holding pattern of the right total width, and a
pattern holds jointly with `NoCollU` with probability at most the product of per-item factors `(2^w − nPos)⁻¹`. -/
def CompressionHyp : Prop :=
  ∀ (B ℓ c : ℕ) (R : ChainReplay B ℓ c), (∀ i, (R.P i).Bounded R.D R.Q) →
    Function.Injective (fun i : Fin B => R.dom i) →
    ∃ Ev : Equiv.Perm (Bits (ℓ + (ℓ + c))) → (j : ℕ) → (Fin j → R.Pos × R.posSet) → Prop,
      (∀ (π : Equiv.Perm (Bits (ℓ + (ℓ + c)))) (L' : Finset (Fin B)) (H' : Finset (Fin B × ℕ)),
        L' ⊆ (R.freshHolding π).labs → H' ⊆ (R.freshHolding π).hs →
        ∃ f : Fin (L'.card + H'.card) → R.Pos × R.posSet, Ev π _ f ∧
          ∑ t, R.nameWidth (f t).2 = ℓ * L'.card + (ℓ + c) * H'.card) ∧
      (∀ (j : ℕ) (f : Fin j → R.Pos × R.posSet),
        pr (fun π => Ev π j f ∧ R.NoCollU π) ≤ ∏ t, (((2 ^ R.nameWidth (f t).2 - nPos B R.Q : ℕ) : ℝ≥0∞))⁻¹)

theorem pr_or_le {α : Type} [Fintype α] (P Q : α → Prop) : pr (fun x => P x ∨ Q x) ≤ pr P + pr Q := by
  have h := PousThm1Dense.pr_exists_le (Finset.univ : Finset Bool) (fun b x => if b then P x else Q x)
  rw [Fintype.sum_bool] at h
  refine le_trans (pr_mono fun x hx => ?_) (le_of_le_of_eq h ?_)
  · rcases hx with hp | hq
    · exact ⟨true, Finset.mem_univ _, by simpa using hp⟩
    · exact ⟨false, Finset.mem_univ _, by simpa using hq⟩
  · simp only [ite_true, Bool.false_eq_true, ite_false]

/-- **`ChainExPostFactoG` from the compression.** -/
theorem chainExPostFactoG_of_compression (hC : CompressionHyp) : ChainExPostFactoG := by
  intro B ℓ c m s D Q k G dom Wb hdom hard A₁ A₂ hA
  classical
  have hk : 0 < k := lt_of_le_of_lt (Nat.zero_le _) (hard ⟨∅, ∅, ∅⟩ (by simp [ChainKnow.size]))
  -- no blocks: nothing is answered
  rcases Nat.eq_zero_or_pos B with hB0 | hB
  · subst hB0
    refine le_trans (pr_mono (Q := fun _ => False) fun π hwin => ?_) (le_of_eq_of_le (by rw [pr_def]; simp) zero_le)
    have := (Finset.card_le_univ (Finset.univ.filter fun i : Fin 0 =>
      (A₂ (A₁ π) i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG G π dom Wb i)).trans_eq (Fintype.card_fin 0)
    omega
  have hn1 : 1 ≤ nPos B Q := by
    unfold nPos
    have : 1 ≤ B * (Q + 1) := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
    omega
  -- the degenerate case: the right-hand side is at least 1
  by_cases hbig : 2 ^ ℓ < 2 * nPos B Q
  · exact (PousThm1Dense.pr_le_one _).trans ((rhs_ge_one hB hn1 hbig).trans le_self_add)
  push Not at hbig
  have hℓ : 1 ≤ ℓ := by
    rcases Nat.eq_zero_or_pos ℓ with h | h
    · rw [h] at hbig; simp at hbig; omega
    · exact h
  -- one replay per advice string
  let R : Bits m → ChainReplay B ℓ c := fun σ => ⟨G, dom, Wb, D, Q, A₂ σ⟩
  have hP : ∀ σ i, ((R σ).P i).Bounded (R σ).D (R σ).Q := fun σ i => hA σ i
  choose Ev hEx hPr using fun σ => hC B ℓ c (R σ) (hP σ) hdom
  let σ₀ : Bits m := fun _ => false
  let win : Equiv.Perm (Bits (ℓ + (ℓ + c))) → Prop := fun π =>
    k ≤ (Finset.univ.filter fun i =>
      (A₂ (A₁ π) i).run ((idealPerm (ℓ + (ℓ + c))).answer π) = labelG G π dom Wb i).card
  -- split off the collision event
  have hsplit : pr win ≤ pr (fun π => win π ∧ (R σ₀).NoCollU π) + pr (fun π => (R σ₀).Bad π) := by
    refine le_trans (pr_mono fun π h => ?_) (pr_or_le _ _)
    by_cases hb : (R σ₀).NoCollU π
    · exact Or.inl ⟨h, hb⟩
    · exact Or.inr hb
  have hcoll : pr (fun π => (R σ₀).Bad π) ≤ (((nPos B Q) ^ 2 : ℕ) : ℝ≥0∞) / 2 ^ (ℓ + c) :=
    (R σ₀).pr_Bad_le hdom
  -- winning without a collision gives a holding pattern of width `≥ ℓs + 1`
  let E : Bits m → (j : ℕ) → (Fin j → (R σ₀).Pos × (R σ₀).posSet) → Equiv.Perm (Bits (ℓ + (ℓ + c))) → Prop :=
    fun σ j f π => ℓ * s + 1 ≤ ∑ t, (R σ₀).nameWidth (f t).2 ∧ Ev σ π j f ∧ (R σ).NoCollU π
  have hwin : ∀ π, win π ∧ (R σ₀).NoCollU π →
      ∃ σ ∈ (Finset.univ : Finset (Bits m)), ∃ j ∈ Finset.range (s + 2),
        ∃ f ∈ (Finset.univ : Finset (Fin j → (R σ₀).Pos × (R σ₀).posSet)), E σ j f π := by
    rintro π ⟨hw, hnc⟩
    refine ⟨A₁ π, Finset.mem_univ _, ?_⟩
    have hsize := (R (A₁ π)).size_freshHolding_gt (hP (A₁ π)) (s := (s : ℚ)) hard hw
    rw [(R (A₁ π)).size_freshHolding] at hsize
    obtain ⟨L', hL', H', hH', hcard, hwidth⟩ := exists_minimal hℓ _ _ hsize
    obtain ⟨f, hEv, hsum⟩ := hEx (A₁ π) π L' H' hL' hH'
    refine ⟨L'.card + H'.card, Finset.mem_range.2 (by omega), f, Finset.mem_univ _, ?_, hEv, hnc⟩
    show ℓ * s + 1 ≤ ∑ t, (R (A₁ π)).nameWidth (f t).2
    rw [hsum]; exact hwidth
  -- the per-pattern bound
  have hpat : ∀ σ j (f : Fin j → (R σ₀).Pos × (R σ₀).posSet),
      pr (E σ j f) ≤ (if ℓ * s + 1 ≤ ∑ t, (R σ₀).nameWidth (f t).2 then
        ∏ t, (2 * (2⁻¹ : ℝ≥0∞) ^ (R σ₀).nameWidth (f t).2) else 0) := by
    intro σ j f
    split_ifs with hw
    · refine le_trans (pr_mono fun π h => h.2) ((hPr σ j f).trans (Finset.prod_le_prod' fun t _ => ?_))
      have h2 : 2 * nPos B Q ≤ 2 ^ (R σ₀).nameWidth (f t).2 :=
        hbig.trans (Nat.pow_le_pow_right (by norm_num) ((R σ₀).le_nameWidth _))
      rw [← ENNReal.inv_pow]
      exact inv_two_pow_sub_le h2
    · exact le_trans (pr_mono (Q := fun _ => False) fun π h => hw h.1) (le_of_eq (by rw [pr_def]; simp))
  have hunion : pr (fun π => win π ∧ (R σ₀).NoCollU π) ≤
      ∑ _σ : Bits m, (((2 * (nPos B Q ^ 2 * B)) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s) := by
    calc pr (fun π => win π ∧ (R σ₀).NoCollU π)
        ≤ pr (fun π => ∃ σ ∈ (Finset.univ : Finset (Bits m)), ∃ j ∈ Finset.range (s + 2),
            ∃ f ∈ (Finset.univ : Finset (Fin j → (R σ₀).Pos × (R σ₀).posSet)), E σ j f π) := pr_mono hwin
      _ ≤ ∑ σ : Bits m, pr (fun π => ∃ j ∈ Finset.range (s + 2),
            ∃ f ∈ (Finset.univ : Finset (Fin j → (R σ₀).Pos × (R σ₀).posSet)), E σ j f π) :=
          PousThm1Dense.pr_exists_le _ _
      _ ≤ ∑ σ : Bits m, ∑ j ∈ Finset.range (s + 2),
            pr (fun π => ∃ f ∈ (Finset.univ : Finset (Fin j → (R σ₀).Pos × (R σ₀).posSet)), E σ j f π) :=
          Finset.sum_le_sum fun σ _ => PousThm1Dense.pr_exists_le _ _
      _ ≤ ∑ σ : Bits m, ∑ j ∈ Finset.range (s + 2), ∑ f : Fin j → (R σ₀).Pos × (R σ₀).posSet, pr (E σ j f) :=
          Finset.sum_le_sum fun σ _ => Finset.sum_le_sum fun j _ => PousThm1Dense.pr_exists_le _ _
      _ ≤ ∑ σ : Bits m, ∑ j ∈ Finset.range (s + 2), ∑ f : Fin j → (R σ₀).Pos × (R σ₀).posSet,
            (if ℓ * s + 1 ≤ ∑ t, (R σ₀).nameWidth (f t).2 then
              ∏ t, (2 * (2⁻¹ : ℝ≥0∞) ^ (R σ₀).nameWidth (f t).2) else 0) :=
          Finset.sum_le_sum fun σ _ => Finset.sum_le_sum fun j _ => Finset.sum_le_sum fun f _ => hpat σ j f
      _ ≤ ∑ _σ : Bits m, (((2 * (nPos B Q ^ 2 * B)) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s) :=
          Finset.sum_le_sum fun σ _ => sum_patterns_le (fun t : (R σ₀).Pos × (R σ₀).posSet => (R σ₀).nameWidth t.2)
            ℓ s (nPos B Q ^ 2 * B) (R σ₀).card_names_le
            (Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by positivity) (by omega)))
  have hfinal : ∑ _σ : Bits m, (((2 * (nPos B Q ^ 2 * B)) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s)
      ≤ 2 ^ m * 2 * ((((nPos B Q) ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * s) := by
    have hL : ∑ _σ : Bits m, (((2 * (nPos B Q ^ 2 * B)) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s)
        = 2 ^ m * ((((nPos B Q) ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s) := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_bool, nsmul_eq_mul,
        show 2 * (nPos B Q ^ 2 * B) = nPos B Q ^ 2 * B * 2 by ring]
      push_cast
      ring
    have hR : 2 ^ m * 2 * ((((nPos B Q) ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) / 2 ^ (ℓ * s)
        = 2 * (2 ^ m * ((((nPos B Q) ^ 2 * B * 2) ^ (s + 1) : ℕ) : ℝ≥0∞) * (2⁻¹ : ℝ≥0∞) ^ (ℓ * s)) := by
      rw [div_eq_mul_inv, ENNReal.inv_pow]
      ring
    rw [hL, hR]
    exact le_mul_of_one_le_left' (by norm_num)
  exact hsplit.trans (add_le_add (hunion.trans hfinal) hcoll)

end PousSpongeChain

