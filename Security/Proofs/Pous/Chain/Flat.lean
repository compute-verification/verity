/-- **Every realized seed's (c′) name reads its charged value.** -/
theorem v6_seed_sound (a : {a // a ∈ R.realizedSeeds s π}) :
    R.SeedSound (R.firstCrossing s π)
      (R.pairStep (R.firstCrossing s π) π (R.pinCell (R.firstCrossing s π) π a.1).pair) π
      (R.v6Code hP s π hcross a) (R.v6Ptr hP s π hcross a) a.1.part := by
  cases hf : R.pairForward (R.firstCrossing s π) π (R.pinCell (R.firstCrossing s π) π a.1).pair
  · cases hpp : R.pinPartner (R.pinCell (R.firstCrossing s π) π a.1) with
    | none => exact R.sound_stop0 hP s π hcross a hf hpp
    | some b => exact R.sound_stop1 hP s π hcross a hf hpp
  · by_cases he : R.pinCell (R.firstCrossing s π) π a.1 = a.1
    · exact R.sound_direct hP s π hcross a hf he
    · exact R.sound_transfer hP s π hcross a hf he

end Classes

