theorem band_seg_d12_margin (c ℓ D : ℕ) (hD : D ≤ 12) :
    ChainHard (bandSegDAG 448 (2 ^ 9) 12) Finset.univ c ℓ ((448 * 2 ^ 9 - 448 * D - 1 : ℕ) : ℚ) D (448 * 2 ^ 9) :=
  band_seg_hard 448 (2 ^ 9) 12 D c ℓ (by norm_num) hD (by omega)

/-- **And its cliff at `D = 13`**: the gap attack costs `448·473 = 211904` labels, below the `223551` allowed. -/
theorem band_seg_cliff_d12 (c ℓ : ℕ) :
    ¬ ChainHard (bandSegDAG 448 (2 ^ 9) 12) Finset.univ c ℓ ((448 * 2 ^ 9 - 448 * 13 - 1 : ℕ) : ℚ) 13
      (448 * 2 ^ 9) :=
  fun h => band_seg_gap_attack 448 (2 ^ 9) 12 13 c ℓ le_rfl (ChainHard.mono h (by norm_num))

/-- **Witnesses for `BandMeets14`'s `5 ≤ d`**: the deployment at `d = 5` and at the recommended `d = 12`. -/
theorem band_meets_14_d5 (hepf : ChainExPostFactoG) : ChainBandMeets14 5 ∧ ChainBandMeets14Global 5 :=
  band_meets_14 hepf 5 le_rfl

theorem band_meets_14_d12 (hepf : ChainExPostFactoG) : ChainBandMeets14 12 ∧ ChainBandMeets14Global 12 :=
  band_meets_14 hepf 12 (by norm_num)

/-- The scheme's `[NeZero (N·B)]` at 14 GB. -/
theorem neZero_14 : NeZero (448 * 2 ^ 9) := inferInstance

/-- No `k > B` vacuity: the audit's `k = 111` is below one segment's `2^9` blocks, and `band_seg_hard` uses
`k = N·B = |univ|`. -/
theorem audit_k_lt_B : (111 : ℕ) < 2 ^ 9 := by norm_num

/-- The counterexample violates exactly `ChainExPostFactoG`'s domain hypothesis: under `sharedDom`, block 0 of
segments 0 and 1 share a domain. -/
