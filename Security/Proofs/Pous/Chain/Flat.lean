/-! ════ Freshness.Decode2 ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousAssembly

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousKnowledge
open scoped ENNReal

variable {n wc : ℕ}

/-- `#E · S ≤ B · |Ω|` gives `pr E ≤ B / S`. -/
theorem pr_le_of_card_mul_le {Ω : Type} [Fintype Ω] (E : Ω → Prop) [DecidablePred E] (B S : ℝ≥0∞)
    (hS0 : S ≠ 0) (hST : S ≠ ⊤)
    (h : ((Finset.univ.filter E).card : ℝ≥0∞) * S ≤ B * Fintype.card Ω) : pr E ≤ B / S := by
  rw [pr_def, ENNReal.le_div_iff_mul_le (Or.inl hS0) (Or.inl hST)]
  have hsplit : ((Finset.univ.filter E).card : ℝ≥0∞) / (Fintype.card Ω : ℝ≥0∞) * S =
      ((Finset.univ.filter E).card : ℝ≥0∞) * S / (Fintype.card Ω : ℝ≥0∞) := by
    rw [div_eq_mul_inv, div_eq_mul_inv, mul_right_comm]
  rw [hsplit]
  exact ENNReal.div_le_of_le_mul h

open Classical in
/-- **Summing the per-advice count.** `#{ω | A₁ ω = σ ∧ E ω} · S ≤ C · |Ω|` for every `σ` gives
`pr E ≤ 2^m · C / S`. -/
theorem pr_le_of_advice {Ω : Type} [Fintype Ω] {m : ℕ} (A₁ : Ω → Bits m) (E : Ω → Prop) (C S : ℕ) (hS : 0 < S)
    (h : ∀ σ, (Finset.univ.filter fun ω => A₁ ω = σ ∧ E ω).card * S ≤ C * Fintype.card Ω) :
    pr E ≤ 2 ^ m * (C : ℝ≥0∞) / (S : ℝ≥0∞) := by
  refine pr_le_of_card_mul_le E _ _ (by exact_mod_cast hS.ne') (ENNReal.natCast_ne_top _) ?_
  have hsum : (Finset.univ.filter E).card * S ≤ 2 ^ m * C * Fintype.card Ω := by
    rw [Finset.card_eq_sum_card_fiberwise (f := A₁) (t := Finset.univ) (fun _ _ => Finset.mem_univ _),
      Finset.sum_mul]
    calc ∑ σ ∈ (Finset.univ : Finset (Bits m)), ((Finset.univ.filter E).filter fun ω => A₁ ω = σ).card * S
        ≤ ∑ _σ ∈ (Finset.univ : Finset (Bits m)), C * Fintype.card Ω := by
          refine Finset.sum_le_sum fun σ _ => le_trans (Nat.mul_le_mul_right _ (Finset.card_le_card ?_)) (h σ)
          intro ω hω
          simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
          exact ⟨hω.2, hω.1⟩
      _ = 2 ^ m * C * Fintype.card Ω := by
          rw [Finset.sum_const, Finset.card_univ, smul_eq_mul]
          simp only [Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
          ring
  exact_mod_cast hsum


end PousAssembly

end


/-! ════ Freshness.LuckyTransfer ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


namespace PousKnowledge

open Pous Pous.Invertible Pous.ColumnAware PousForwardCore PousTweaked PousTimedGame PousRounds

variable {n wc : ℕ} {p : Fin n → OracleProg (p3ModelT n wc) (Lab n wc)}
  {τ : Bits 256} {G : Labelling.TopoDAG n} {W : Fin n → Lab n wc} {D Q : ℕ}


open Classical in
/-- **The slot of an asked query**: the least asker in its first round, and its trace index there. -/
theorem slotOf_spec {ω : (p3ModelT n wc).Ω} {q : (p3ModelT n wc).Qry} (h : ∃ r, Asked p ω q r) :
    ∃ c : Fin n, slotOf p ω q = ((c : ℕ), (progTrace ((p3ModelT n wc).answer ω) (p c)).idxOf q) ∧
      q ∈ upTo ((p3ModelT n wc).answer ω) (p c) (firstRound p ω q) := by
  have hne : (askers p ω q (firstRound p ω q)).Nonempty := by
    obtain ⟨c, hc⟩ := asked_firstRound p ω h
    exact ⟨c, by simp [askers, hc]⟩
  refine ⟨(askers p ω q (firstRound p ω q)).min' hne, ?_, (Finset.mem_filter.1 (Finset.min'_mem _ hne)).2⟩
  unfold slotOf
  rw [dif_pos hne]


end PousKnowledge

end


