theorem band_pub_meets_64 (hepf : ChainExPostFactoG) (d : ℕ) (hd : 5 ≤ d) : ChainBandPubMeets64 d := fun salt =>
  PousPub.pubMeets_exact _ (chainBand_encDec _ _ _ _ _) (band_meets_64 hepf d hd salt)


