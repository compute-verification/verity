/-- **Inverse stops on a known partner** read where the partner's value was shown. -/
theorem sound_stop1 (a : {a // a ∈ R.realizedSeeds s π})
    (hf : R.pairForward (R.firstCrossing s π) π
      (R.pinCell (R.firstCrossing s π) π a.1).pair = false)
    {b : VAtom B} (hpp : R.pinPartner (R.pinCell (R.firstCrossing s π) π a.1) = some b) :
    R.SeedSound (R.firstCrossing s π)
      (R.pairStep (R.firstCrossing s π) π (R.pinCell (R.firstCrossing s π) π a.1).pair) π
      (R.v6Code hP s π hcross a) (R.v6Ptr hP s π hcross a) a.1.part := by
  classical
  have hcut : R.firstCrossing s π ≤ R.programSteps π := R.firstCrossing_le s π hcross
  have hev := R.realizedSeed_cell_valid s π a
  obtain ⟨q, hq, hfr, hcase, hdir⟩ := R.charge_query π hcut (R.atomValid_pair hev)
  have hqF : qFwd q = false := by rw [← hdir]; exact hf
  have hqi : q = ⟨(), .inr (π (R.xin π (R.pinCell (R.firstCrossing s π) π a.1).pair.1
      (R.pinCell (R.firstCrossing s π) π a.1).pair.2))⟩ := by
    rcases hcase with h | h
    · rw [h] at hqF; simp [qFwd] at hqF
    · exact h
  have hpartE : (R.pinCell (R.firstCrossing s π) π a.1).part = a.1.part := R.pinCell_part _ π a.1
  have hstop : R.pinNext (R.firstCrossing s π) π (R.pinCell (R.firstCrossing s π) π a.1) = none := by
    obtain ⟨k, -, h⟩ := R.pinCell_spec (R.firstCrossing s π) π a.1
    exact h
  have hncut := R.inverse_step_lt_cut hcut (R.atomValid_pair hev) hf
  set e := R.pinCell (R.firstCrossing s π) π a.1 with he_def
  set n := R.pairStep (R.firstCrossing s π) π e.pair with hn_def
  have hk : R.pinKnownAt (R.firstCrossing s π) π n b := by
    by_contra hk
    have : R.pinNext (R.firstCrossing s π) π e = some b := by
      unfold pinNext
      simp only [hf, hpp, Bool.false_eq_true, ↓reduceIte]
      exact if_neg hk
    rw [this] at hstop
    simp at hstop
  have hbv : R.atomValid b := R.pinPartner_target_valid hpp
  have hans : ans (fun _ : Unit => π) q = R.xin π e.pair.1 e.pair.2 := by
    rw [hqi]; exact ans_charge_inv π _
  have key : (∃ qe u, e = .r qe ∧ qe ∈ R.posSet ∧ ovBlock R.G qe.1 qe.2 = some u ∧
        b = .r (u, ovCalls R.G u)) ∨
      (∃ qe, e = .h qe ∧ qe ∈ R.posSet ∧ 2 ≤ qe.2 ∧ b = .h (qe.1, qe.2 - 1)) := by
    rcases hec : e with ⟨qe⟩ | ⟨qe⟩
    · rw [hec] at hpp
      obtain ⟨hqe, u, hu, hb⟩ := R.pinPartner_r_some hpp
      exact Or.inl ⟨qe, u, rfl, hqe, hu, hb⟩
    · rw [hec] at hpp
      obtain ⟨hqe, h2, hb⟩ := R.pinPartner_h_some hpp
      exact Or.inr ⟨qe, rfl, hqe, h2, hb⟩
  -- The slot readers `inp`/`out` at a slot that fixed a chain input before `n`.
  have hfixAcc : ∀ {X : Bits (ℓ + (ℓ + c))} {o : Fin B × Fin (R.Q + 1)},
      R.FixSlot (R.firstCrossing s π) π n X o →
      ∃ te : ℕ × (Bits (ℓ + (ℓ + c)) ⊕ Bits (ℓ + (ℓ + c))), te.1 ≤ R.D ∧
        R.roundStart π te.1 ≤ n ∧ R.roundStart π te.1 ≤ R.firstCrossing s π ∧
        ¬ o.2.val = R.Q ∧ R.slotPoint π .inp o = X ∧ R.slotPoint π .out o = π X ∧
        ∀ ins : V6Instr B, ins.src ≠ .run →
          R.SlotAccess π te.1 ((R.stratC (R.firstCrossing s π)).hist (fun _ : Unit => π) n)
            ins (.inl o) := by
    intro X o ⟨te, hkQ, hte, hρ, hD, hmem, hrev⟩
    obtain ⟨-, hsq⟩ := R.slotFwd_of_tr hte
    refine ⟨te, hD, hρ.le, by omega, by omega, ?_, ?_, fun ins hr => ?_⟩
    · simp only [slotPoint, hsq, hrev]
    · simp only [slotPoint, hsq, hrev]
    · simp only [SlotAccess, hkQ, ↓reduceIte]
      exact ⟨hr, te, hte, le_rfl, fun _ => hmem⟩
  by_cases hc : R.ChildO (R.firstCrossing s π) π n b
  · -- a child pair of the partner was fixed before `n`: read its input
    have hptr0 : R.v6Ptr hP s π hcross a = R.fixSlot (R.firstCrossing s π) π n
        (R.xin π (Classical.choose hc).pair.1 (Classical.choose hc).pair.2)
        (.inr ⟨e.pair, R.atomValid_pair hev⟩) := by
      simp only [v6Ptr, ← he_def, ← hn_def, hf, hpp, Bool.false_eq_true, ↓reduceIte, dif_pos hc]
    have hz := (Classical.choose_spec hc).1
    obtain ⟨o, hptr, hfs⟩ := R.fixSlot_spec hP hcut hncut.le (Classical.choose_spec hc).2
      (.inr ⟨e.pair, R.atomValid_pair hev⟩)
    obtain ⟨te, hD, h1, h2, hk', hpin, -, hacc⟩ := hfixAcc hfs
    rw [hptr0, hptr]
    set z := Classical.choose hc with hz_def
    rcases key with ⟨qe, u, hec, hqe, hu, rfl⟩ | ⟨qe, hec, hqe, h2e, rfl⟩
    · have hep : e.part = .r := by rw [hec]; rfl
      have hcode : R.v6Code hP s π hcross a = (.r, rowLast a.1.pair.1) := by
        simp only [v6Code, ← he_def, ← hn_def, hf, hpp, Bool.false_eq_true, ↓reduceIte, hep,
          if_pos hc]
      rw [hcode]
      have hlast : (rowLast a.1.pair.1).val + 1 = B := by
        simp only [rowLast]; have := a.1.pair.1.isLt; omega
      obtain ⟨qz, hzc, hqz, u', hu', hb'⟩ : ∃ qz, z = .r qz ∧ qz ∈ R.posSet ∧ ∃ u',
          ovBlock R.G qz.1 qz.2 = some u' ∧ (VAtom.r (u, ovCalls R.G u) : VAtom B) =
            .r (u', ovCalls R.G u') := by
        rcases hzc : z with ⟨qz⟩ | ⟨qz⟩
        · rw [hzc] at hz
          obtain ⟨hqz, u', hu', hb'⟩ := R.pinPartner_r_some hz
          exact ⟨qz, rfl, hqz, u', hu', hb'⟩
        · rw [hzc] at hz
          obtain ⟨-, -, hb'⟩ := R.pinPartner_h_some hz
          cases hb'
      have huu : u' = u := by
        simp only [VAtom.r.injEq, Prod.mk.injEq] at hb'
        exact hb'.1.symm
      subst huu
      refine R.seedSound_intro hq hfr ⟨.inp, .r, none⟩ ?_ ?_ ?_ te.1 hD h1 h2
        (hacc _ (by simp))
      · simp only [hk', ↓reduceIte, v6Decode, hqF, hlast, Bool.false_eq_true]
      · rw [← hpartE, hep]
      · simp only [PinReads, readR, rowXor, hans, hpin, hzc]
        rw [hec]
        simp only [VAtom.pair]
        rw [R.ovR_xin_block π hqe hu, R.ovR_xin_block π hqz hu']
    · have hep : e.part = .h := by rw [hec]; rfl
      have hB : 2 ≤ B := R.two_le_B_of_calls (q := (qe.1, qe.2 - 1))
        (R.mem_posSet.2 ⟨by omega, by have := (R.mem_posSet.1 hqe).2; simp; omega⟩)
