  rw [hσ] at hwin
  exact hwin

theorem adviceBoundMultiGe_of_zeroAdviceMultiGe (Q₀ : ℕ) (pos : ℕ → ℕ → ℕ) (h : ZeroAdviceMultiGe Q₀ pos) :
    AdviceBoundMultiGe Q₀ pos := by
  classical
  intro N n wc m D Q k X tags G W A₁ A₂ hn hQ hwc hN hXk htags hard hA₂ σ
  refine le_trans (Nat.mul_le_mul_right _ ?_) (h N n wc D Q k X tags G W (A₂ σ) hn hQ hwc hN hXk htags hard (hA₂ σ))
  refine Finset.card_le_card fun ω hω => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
  obtain ⟨hσ, hwin, hcoll⟩ := hω
  refine ⟨?_, hcoll⟩
  unfold WinMulti at hwin
  rw [hσ] at hwin
  exact hwin

