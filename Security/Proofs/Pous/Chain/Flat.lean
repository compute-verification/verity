/-! ════ P3Concrete.P3ChainTight ════ -/
section
set_option autoImplicit false
set_option relaxedAutoImplicit false


/-!
# The certificate is tight in `X`: `X = 0` is false on `B(220, 12)` at `D = 10`

On any DAG in which node 0 has no parents, `tightK` keeps every top but top 0, and the lower column entries `(w, 0)`
for `w ≠ 0`. That is `n(n − 1) + (n − 1) = n² − 1` columns, and it knows all `n` tops after 3 rounds:
- **Round 1.** Rows 0 of both layers are one pad call each, which gives both keys.
- **Round 2.** `P` on the lower key gives `c¹_0`, so column 0 is whole.
- **Round 3.** `P` on the top key and column 0 gives top 0.

So `P3ChainHard G c wc D n 0` is false for every `D ≥ 3` (`not_p3ChainHard_zero`). At the deployment point
(`not_p3ChainHard_X0`) the proved `X = 1` is therefore the exact integer certificate.
-/

namespace Pous.P3Concrete

open Pous Pous.Labelling Pous.Sponge

section Tight

variable {n : ℕ} [NeZero n] (G : TopoDAG n)

/-- The tight holding: every top but top 0, and the lower column entries `(w, 0)`, `w ≠ 0`. -/
def tightK : P3ChainKnow n where
  tops := Finset.univ.erase 0
  cols := (Finset.univ.erase 0).image fun w => (w, (0 : Fin n))
  hs := ∅
  rs := ∅
  kc := ∅
  pc := ∅

variable {G}

theorem ovCalls_zero_of (hG : G.par 0 = ∅) : ovCalls G 0 = 1 := by
  unfold ovCalls parentsDesc
  rw [hG]
  simp

theorem tightK_pad (hG : G.par 0 = ∅) (K : P3ChainKnow n) (L : Fin 2) :
    (L, (0 : Fin n), ovCalls G 0) ∈ (K.round G).rs := by
  have hpos : (L, (0 : Fin n), ovCalls G 0) ∈ P3ChainKnow.pos n := by
    simp only [P3ChainKnow.pos, Finset.mem_product, Finset.mem_univ, Finset.mem_range, true_and,
      ovCalls_zero_of hG]
    omega
  have hcall : K.canCall G L 0 (ovCalls G 0) :=
    ⟨by rw [ovCalls_zero_of hG], le_rfl, fun u hu => absurd (hu.symm.trans (P3ChainKnow.ovBlock_pad G 0)) (by simp),
      Or.inl (ovCalls_zero_of hG)⟩
  exact P3ChainKnow.round_rs_of_step G ((P3ChainKnow.mem_step_rs G K L 0 (ovCalls G 0)).2 (Or.inr ⟨hpos, Or.inl hcall⟩))

theorem tightK_top0 (hG : G.par 0 = ∅) : (0 : Fin n) ∈ (P3ChainKnow.reach G (tightK (n := n)) 3).tops := by
  have hk1 : (P3ChainKnow.reach G (tightK (n := n)) 1).keyKnown G 0 0 := tightK_pad hG _ 0
  have hk2 : (P3ChainKnow.reach G (tightK (n := n)) 2).keyKnown G 1 0 := tightK_pad hG _ 1
  have hcol : (P3ChainKnow.reach G (tightK (n := n)) 2).colKnown 0 := by
    intro w
    by_cases hw : w = 0
    · subst hw
      exact P3ChainKnow.round_cols_of_step G ((P3ChainKnow.mem_step_cols G _ 0 0).2 (Or.inr (Or.inl hk1)))
    · have h0 : (w, (0 : Fin n)) ∈ (tightK (n := n)).cols :=
        Finset.mem_image.2 ⟨w, Finset.mem_erase.2 ⟨hw, Finset.mem_univ _⟩, rfl⟩
      exact ((P3ChainKnow.le_assemble G tightK).trans (P3ChainKnow.le_reach G tightK (show 0 ≤ 2 by norm_num))).2.1 h0
  exact (P3ChainKnow.mem_step_tops G _ 0).2 (Or.inr (Or.inl ⟨hk2, hcol⟩))

theorem tightK_all (hG : G.par 0 = ∅) (D : ℕ) (hD : 3 ≤ D) :
    ((P3ChainKnow.reach G (tightK (n := n)) D).tops).card = n := by
  have hsub : (Finset.univ : Finset (Fin n)) ⊆ (P3ChainKnow.reach G (tightK (n := n)) D).tops := by
    intro u _
    by_cases hu : u = 0
    · subst hu
      exact (P3ChainKnow.le_reach G tightK hD).1 (tightK_top0 hG)
    · have h0 : u ∈ (tightK (n := n)).tops := Finset.mem_erase.2 ⟨hu, Finset.mem_univ _⟩
      exact ((P3ChainKnow.le_assemble G tightK).trans (P3ChainKnow.le_reach G tightK (Nat.zero_le D))).1 h0
  have := Finset.card_le_card hsub
  have h2 := Finset.card_le_univ (P3ChainKnow.reach G (tightK (n := n)) D).tops
  simp only [Finset.card_univ, Fintype.card_fin] at this h2
  omega

theorem tightK_size (c wc : ℕ) : (tightK (n := n)).size c wc = (n : ℚ) * (n - 1) + (n - 1) := by
  unfold P3ChainKnow.size
  have hn : 1 ≤ n := Nat.pos_of_ne_zero (NeZero.ne n)
  have ht : (tightK (n := n)).tops.card = n - 1 := by
    show (Finset.univ.erase (0 : Fin n)).card = n - 1
    rw [Finset.card_erase_of_mem (Finset.mem_univ _)]
    simp
  have hc : (tightK (n := n)).cols.card = n - 1 := by
    show ((Finset.univ.erase (0 : Fin n)).image fun w => (w, (0 : Fin n))).card = n - 1
    rw [Finset.card_image_of_injective _ fun w w' h => (Prod.mk.inj h).1,
      Finset.card_erase_of_mem (Finset.mem_univ _)]
    simp
  have hh : ((tightK (n := n)).hs.filter fun p => p.2.2 ≠ 0).card = 0 := by
    show ((∅ : Finset (Fin 2 × Fin n × ℕ)).filter fun p => p.2.2 ≠ 0).card = 0
    simp
  have hr : (tightK (n := n)).rs.card = 0 := by
    show (∅ : Finset (Fin 2 × Fin n × ℕ)).card = 0
    simp
  have hk : (tightK (n := n)).kc.card = 0 := by
    show (∅ : Finset (Fin n × Fin n)).card = 0
    simp
  have hp : (tightK (n := n)).pc.card = 0 := by
    show (∅ : Finset (Fin n × Fin n)).card = 0
    simp
  rw [ht, hc, hh, hr, hk, hp, Nat.cast_sub hn]
  push_cast
  ring

/-- **`X = 0` is false** on any DAG whose node 0 has no parents, at any `D ≥ 3`: `tightK` knows all `n` tops at
`n² − 1` columns. -/
theorem not_p3ChainHard_zero (hG : G.par 0 = ∅) (c wc D : ℕ) (hD : 3 ≤ D) : ¬ P3ChainHard G c wc D n 0 := by
  intro h
  have := h tightK (by rw [tightK_all hG D hD])
  rw [tightK_size, Nat.sub_zero] at this
  nlinarith

end Tight

theorem par_zero_band : (Pous.P3Column.bandGraph 220 12).par 0 = ∅ :=
  Finset.subset_empty.1 fun u hu => absurd ((Pous.P3Column.bandGraph 220 12).par_lt 0 u hu) (Fin.not_lt_zero u)

/-- **At the deployment point, `X = 0` is false**, so `p3ChainCert`'s `X = 1` is exact. -/
theorem not_p3ChainHard_X0 : ¬ P3ChainHard (Pous.P3Column.bandGraph 220 12) 512 2384 10 220 0 :=
  not_p3ChainHard_zero par_zero_band 512 2384 10 (by norm_num)

end Pous.P3Concrete

end


