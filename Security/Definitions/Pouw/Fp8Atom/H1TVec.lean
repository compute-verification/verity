import Definitions.Pouw.Fp8Atom.H1T

/-!
# H-1T's conformance vectors: what each one asserts (trusted definitions)

The data is generated by `verity/protocols/accounting/work/pouw/lean/scripts/h1t_vectors.py` (`Pouw.Fp8Atom.H1TVectors`), and `Pouw.Fp8Atom.H1TChecks` evaluates
it in the kernel. Codes and words are natural numbers, and lists of them are packed little-endian as in `codes`: code
`i` of a row or column is byte `i`, and raw XOF word `ℓ` of a slice is bits `32ℓ..32ℓ+31`. `F` index `fi` is
`2^(fi − 2)`.

* **`FormVec`**: one real lane, `formReal F x pos = (x1, x2)`. `formKeys` lists every finite code, both signs and
  every `F` in {1/4, 1/2, 1, 2, 4}, in the table's order.
* **`TagVec`**: one tag value `v = tagVal F neg m`. `enc v` and `enc (−v)` are the given codes, and both are exact.
  `tagKeys` lists every `F`, sign and mantissa.
* **`SaltVec`**: 18 raw XOF words and the fields `extract` reads: the real-lane signs as a 29-bit number (bit `ℓ`),
  the tag signs as a 3-bit number, and the tag mantissas as `m0 + 8·m1 + 64·m2`.
* **`RowVec`**: one row and one column, both zero-padded to `29·T` (and 0 past it), with the column index `j`, the
  raw XOF words per slice, the fresh-step words `I_0..I_(2T−1)` and the running words `R_0..R_(2T−1)`. `freshWord`
  writes each `I_p`.
  Every word is finite, `R_0 = I_0`, and each `R_(p+1)` is `rnAdd` of the values of `R_p` and `I_(p+1)`.
-/

namespace Pouw.Fp8Atom.H1T

open Pouw.Fp8Atom

/-- A natural number as a code, modulo 256. -/
def codeOf (c : ℕ) : Code := ⟨c % 256, Nat.mod_lt _ (by norm_num)⟩

/-- `F = 2^(fi − 2)`. -/
def fOf (fi : ℕ) : ℚ := 2 ^ ((fi : ℤ) - 2)

/-- A natural number as a mantissa field, modulo 8. -/
def fin8 (m : ℕ) : Fin 8 := ⟨m % 8, Nat.mod_lt _ (by norm_num)⟩

/-- 18 raw XOF words packed in `r` (word `ℓ` is bits `32ℓ..32ℓ+31`). -/
def rawOf (r : ℕ) : RawSlice := fun ℓ => ⟨(r >>> (32 * ℓ.val)) % 2 ^ 32, Nat.mod_lt _ (by norm_num)⟩

/-- A real-lane vector. -/
structure FormVec where
  x : ℕ
  pos : Bool
  fi : ℕ
  x1 : ℕ
  x2 : ℕ

/-- `formReal (fOf fi) x pos = (x1, x2)`. -/
def FormVec.holds (v : FormVec) : Bool :=
  let r := formReal (fOf v.fi) (codeOf v.x) v.pos
  r.1.val == v.x1 && r.2.val == v.x2

/-- Every finite code, both signs and every `F` index `0..4`. -/
def formKeys : List (ℕ × Bool × ℕ) :=
  ((List.range 256).filter fun c => (codeOf c).isNaN == false).flatMap fun x =>
    [false, true].flatMap fun pos => (List.range 5).map fun fi => (x, pos, fi)

/-- A tag vector. -/
structure TagVec where
  fi : ℕ
  neg : Bool
  m : ℕ
  c1 : ℕ
  c2 : ℕ

/-- `enc v = c1` and `enc (−v) = c2`, both exact. -/
def TagVec.holds (w : TagVec) : Bool :=
  let v := tagVal (fOf w.fi) w.neg (fin8 w.m)
  (enc v).val == w.c1 && (enc (-v)).val == w.c2 && val (codeOf w.c1) == v && val (codeOf w.c2) == -v

/-- Every `F` index `0..4`, sign and mantissa. -/
def tagKeys : List (ℕ × Bool × ℕ) :=
  (List.range 5).flatMap fun fi => [false, true].flatMap fun neg => (List.range 8).map fun m => (fi, neg, m)

/-- A salt vector. -/
structure SaltVec where
  r : ℕ
  pos : ℕ
  neg : ℕ
  man : ℕ

/-- The fields as three numbers: real-lane signs (bit `ℓ`), tag signs (bit `i`), tag mantissas (`8^i · m_i`). -/
def packSalt (σ : SliceSalt) : ℕ × ℕ × ℕ :=
  ((List.finRange 29).foldr (fun l s => (if σ.pos l then 2 ^ l.val else 0) + s) 0,
   (List.finRange 3).foldr (fun i s => (if σ.neg i then 2 ^ i.val else 0) + s) 0,
   (List.finRange 3).foldr (fun i s => (σ.man i).val * 8 ^ i.val + s) 0)

/-- `extract` reads the given fields. -/
def SaltVec.holds (v : SaltVec) : Bool := packSalt (extract (rawOf v.r)) == (v.pos, v.neg, v.man)

/-- A full-row vector. -/
structure RowVec where
  T : ℕ
  j : ℕ
  x : ℕ
  b : ℕ
  r : List ℕ
  I : List ℕ
  R : List ℕ

/-- The row. -/
def RowVec.xs (v : RowVec) : ℕ → Code := fun i => codeOf (v.x >>> (8 * i))

/-- The column's real codes. -/
def RowVec.bs (v : RowVec) : ℕ → Code := fun i => codeOf (v.b >>> (8 * i))

/-- The salt fields per slice. -/
def RowVec.σ (v : RowVec) : ℕ → SliceSalt := fun τ => extract (rawOf (v.r.getD τ 0))

/-- `freshWord` writes every `I_p`, every word is finite, `R_0 = I_0`, and `R_(p+1) = rnAdd R_p I_(p+1)` on values. -/
def RowVec.holds (v : RowVec) : Bool :=
  (List.range (2 * v.T)).all (fun p => freshWord v.T v.xs v.bs v.j v.σ p == v.I.getD p 0 &&
    (wordQ (v.I.getD p 0)).isSome && (wordQ (v.R.getD p 0)).isSome) &&
  v.R.getD 0 0 == v.I.getD 0 0 &&
  (List.range (2 * v.T - 1)).all fun p =>
    wordQ (v.R.getD (p + 1) 0) == (wordQ (v.R.getD p 0)).bind fun r => (wordQ (v.I.getD (p + 1) 0)).map (rnAdd r)

end Pouw.Fp8Atom.H1T
