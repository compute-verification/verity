/-- The `n`-code lines of `b`, in order. -/
def codeLines (n : Nat) (b : ByteArray) : Array (Array Nat) :=
  (Array.range (b.size / n)).map fun t => (Array.range n).map fun p => b[n * t + p]!.toNat

/-- The test pass's fixed operand's noise: seed_B, F_A, F_B and G as the Python derives them (`pearl_c.seed_b`, `_basis`,
`gram`), and F_A's and F_B's columns. It is given, not derived: `TileAcceptMeans` ranges over every noise, the deployed
check's (`fixedNoise` of the pass's salt and B's root, `noiseOf`) is one instance and this test noise another. -/
def testNoise : Words.FixedNoise :=
  let fa := codeLines 32 testFa
  let fb := codeLines 32 testFb
  { seedB := testSeedB, fa, fb, faCols := (Array.range R).map (Words.column fa),
    fbCols := (Array.range R).map (Words.column fb),
    gram := (Array.range R).map fun p => (words32 testGram).extract (R * p) (R * p + R) }

end Properties.Pouw.PearlPlus
