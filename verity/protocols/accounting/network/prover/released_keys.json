{
 "schema": "network-traces/released-keys/v1",
 "lists": [
  {
   "name": "a gate run's certificates",
   "writer": "verity/protocols/run/verifier/live_challenger/auditor.py (a run's public outcome, row_certificate)",
   "files": [
    "gates/*/*/out/certificates.jsonl",
    "gates/*/*/out/cells-certificates.jsonl",
    "gates/*/*/out/rows-certificates.jsonl"
   ],
   "form": "jsonl",
   "keys": {
    "certificate/key_id": "structure",
    "certificate/link": "structure",
    "certificate/direction": "structure",
    "certificate/window": "structure",
    "certificate/digest": "commitment",
    "certificate/signature": "output"
   }
  },
  {
   "name": "a gate run's cells' registrations",
   "writer": "verity/protocols/run/verifier/live_challenger/auditor.py (row_registration, ROW_LINE)",
   "files": [
    "gates/*/*/out/cells-registrations.jsonl"
   ],
   "form": "jsonl",
   "keys": {
    "registration/format": "structure",
    "registration/value": "structure",
    "registration/link": "structure",
    "registration/direction": "structure",
    "registration/window": "structure",
    "registration/parameters": "structure",
    "registration/cell_bytes": "structure",
    "registration/rows": "structure",
    "registration/words": "structure",
    "registration/word_bits": "structure",
    "registration/row_schema": "structure",
    "registration/domain": "structure",
    "registration/root": "commitment",
    "registration/layout/buckets": "structure",
    "registration/layout/slots": "structure",
    "registration/layout/connection_slots": "structure",
    "registration/layout/first_bucket": "structure",
    "registration/certificate/key": "structure",
    "registration/certificate/digest": "commitment",
    "registration/certificate/signature": "output"
   }
  },
  {
   "name": "the chain's certificates step",
   "writer": "benchmarks/network_traces/network_attester_chain.py (checked; chain_record.py certs adds in_the_clear)",
   "files": [
    "certs.json"
   ],
   "form": "json",
   "keys": {
    "warden_run": "structure",
    "link": "structure",
    "session": "structure",
    "windows": "structure",
    "key/params/*": "structure",
    "key/key_id": "structure",
    "key/public": "structure",
    "key/deployed": "output",
    "parameters": "commitment",
    "records_file": "structure",
    "public_file": "structure",
    "clock_certificates": "structure",
    "sync_bits": "structure",
    "warden_check/accepted": "output",
    "warden_check/failed/*": "output",
    "warden_check/windows": "output",
    "warden_check/certified_windows": "output",
    "warden_check/certificates": "output",
    "warden_check/cell_rows/registered": "output",
    "warden_check/cell_rows/of": "output",
    "warden_check/load/values": "output",
    "warden_check/load/registered": "output",
    "warden_check/load/relayed": "output",
    "public_is_the_records": "output",
    "verdict": "output",
    "why": "output",
    "in_the_clear": "structure"
   }
  },
  {
   "name": "the endpoint step's public document",
   "writer": "benchmarks/network_traces/chain_record.py (endpoint_public, served_session.py endpoint's art)",
   "files": [
    "report.json"
   ],
   "form": "json",
   "keys": {
    "format": "structure",
    "verdict": "output",
    "why": "output",
    "warden_run": "structure",
    "at": "structure",
    "in_the_clear": "structure",
    "io/accepted": "output",
    "io/violations": "output",
    "advice/bound": "output",
    "advice/rebuilt": "output",
    "advice_bits/T": "structure"
   }
  }
 ],
 "not_yet": [
  "session/session.json",
  "session/leak-guard.json",
  "leak-guard.json",
  "job.json",
  "custody.json",
  "gates/*/*/request.json",
  "gates/*/*/end.json",
  "gates/*/*/out/deployment.json",
  "gates/*/*/out/groups.json",
  "gates/*/*/out/load-relay.json",
  "tie/**",
  "scan/**",
  "report/**"
 ]
}
