+/// `export-comp --out FILE`: the BLAKE3 compression circuit (`flock_prover`'s `build_block_r1cs(3)`, the compression slot type)
+/// as data for the Lean verifier, `flock-r1cs-rows/v1`: one JSON header line (shape, pin, the circuit digest and the layout
+/// offsets), then A's rows and B's rows, each row `le32 count` then `le32` columns. C is the identity (checked here).
+fn export_comp() {
+    use flock_prover::r1cs_hashes::blake3 as b3;
+    let c = flock_live::chunk::comp();
+    assert!(c.c0_is_identity());
+    let hdr = json!({"format": "flock-r1cs-rows/v1", "circuit": "blake3-compression/flock-b684b12", "m": c.m, "k_log": c.k_log, "k_skip": c.k_skip,
+        "useful_bits": c.useful_bits, "const_pin": c.const_pin, "layout": 0, "rows": c.a_0.num_rows, "cols": c.a_0.num_cols,
+        "digest": hex(&c.statement_digest()), "cv_base": b3::CV_BASE, "out_lo_base": b3::OUT_LO_BASE, "m_base": b3::M_BASE,
+        "t_lo_base": b3::T_LO_BASE, "t_hi_base": b3::T_HI_BASE, "blen_base": b3::BLEN_BASE, "flags_base": b3::FLAGS_BASE,
+        "nnz_a": c.a_0.rows.iter().map(|r| r.len()).sum::<usize>(), "nnz_b": c.b_0.rows.iter().map(|r| r.len()).sum::<usize>()});
+    let mut out = hdr.to_string().into_bytes();
+    out.push(b'\n');
+    for m in [&c.a_0, &c.b_0] {
+        for r in m.rows.iter() {
+            out.extend((r.len() as u32).to_le_bytes());
+            for &x in r {
+                out.extend((x as u32).to_le_bytes());
+            }
+        }
+    }
+    std::fs::write(arg("--out", "comp.rows"), &out).unwrap();
+    println!("EXPORT\t{hdr}");
+}
