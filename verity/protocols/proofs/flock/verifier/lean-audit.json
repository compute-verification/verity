  "Flock.RecLinks.check_sound": {
   "owner": "@proofs",
   "signature": [
    "Flock.RecLinks.check_sound {sh : Flock.RecLinks.Shape} {inRow outRow : Nat → Nat → Array Nat} {rows : Array ByteArray}",
    "  {L : Nat} (h : Eq (Flock.RecLinks.check sh inRow outRow rows) (Except.ok L)) :",
    "  Exists fun ls =>",
    "    And",
    "      (Eq (Flock.RecLinks.decodeAll rows.toList)",
    "        (Except.ok",
    "          (instHAppendOfAppend.hAppend (List.map Option.some ls)",
    "            (List.replicate (instHSub.hSub rows.size L) Option.none))))",
    "      (And (Eq L ls.length)",
    "        (And (instLTNat.lt 0 L)",
    "          (And (Eq rows.size (Flock.RecLinks.grid L))",
    "            (And",
    "              (∀ (l : Flock.RecLinks.LinkEntry), List.instMembership.mem ls l → Flock.RecLinks.Holds sh inRow outRow l)",
    "              (List.map (fun l => { fst := l.reader, snd := l.port }) ls).Nodup))))"
   ],
