+    /// A caller selects the wide config by `log_batch_size` and nothing else: the same `(m, Fast100)` still loads
+    /// its own entry at `initial_k` 6, no other width loads, no other profile has a wide config, and below m = 32
+    /// the lookup is the one it was.
+    #[test]
+    fn ligerito_wide_lookup_is_by_log_batch_size() {
+        for m in 32..=35usize {
+            let (log_n, k) = (m - LOG_PACKING, m - 25);
+            let wide = prover_config_for(log_n, k, LigeritoProfile::Fast100).expect("wide prover config");
+            let wide_v = verifier_config_for(log_n, k, LigeritoProfile::Fast100).expect("wide verifier config");
+            assert_eq!((wide.initial_k, wide.initial_log_msg_cols, wide.recursive_steps), (k, 18, 5));
+            assert_eq!(wide.queries, vec![218, 106, 71, 53, 43, 36]);
+            assert_eq!(wide.log_inv_rates, vec![1, 2, 3, 4, 5, 6]);
+            assert_eq!(wide.recursive_ks, vec![4; 5]);
+            assert_eq!(wide.recursive_log_msg_cols, vec![15, 12, 9, 6, 3]);
+            assert_eq!(
+                (wide_v.initial_k, &wide_v.queries, &wide_v.recursive_ks, &wide_v.log_inv_rates),
+                (k, &wide.queries, &wide.recursive_ks, &wide.log_inv_rates)
+            );
+            let own = prover_config_for(log_n, 6, LigeritoProfile::Fast100).expect("the profile's own config");
+            assert_eq!((own.initial_k, own.initial_log_msg_cols), (6, log_n - 6));
+            assert_eq!(embedded_initial_k(m, LigeritoProfile::Fast100), Some(6));
+            for other in (0..16).filter(|&b| b != 6 && b != k) {
+                assert!(prover_config_for(log_n, other, LigeritoProfile::Fast100).is_err());
+                assert!(verifier_config_for(log_n, other, LigeritoProfile::Fast100).is_err());
+            }
+            for profile in [
+                LigeritoProfile::Fast,
+                LigeritoProfile::Slim,
+                LigeritoProfile::Slim100,
+                LigeritoProfile::Secure,
+            ] {
+                assert!(prover_config_for(log_n, k, profile).is_err());
+                assert!(verifier_config_for(log_n, k, profile).is_err());
+            }
+        }
+        for m in 22..=31usize {
+            let k = embedded_initial_k(m, LigeritoProfile::Fast100).expect("registered");
+            for other in (0..16).filter(|&b| b != k) {
+                assert!(prover_config_for(m - LOG_PACKING, other, LigeritoProfile::Fast100).is_err());
+            }
+            assert!(prover_config_for(m - LOG_PACKING, k, LigeritoProfile::Fast100).is_ok());
+        }
+    }
