+    /// Each wide config validates under Fast100's analysis, is exactly the derivation's output, and is the shape
+    /// its verifier's schedule states: level 0 at rate 1/2 over 2^18 columns (2^19 leaves) and `2^(m − 25)` lanes
+    /// with Fast100's 218 queries, then m = 31's levels and final block, field for field.
+    #[test]
+    fn ligerito_wide_configs_validate_and_match_derivation() {
+        let rest = |toml: &'static str| {
+            let at = toml.match_indices("[[levels]]").nth(1).expect("two levels").0;
+            &toml[at..]
+        };
+        let m31 = embedded_security_config(31, LigeritoProfile::Fast100).expect("m31 fast100");
+        assert_eq!(EMBEDDED_WIDE_CONFIGS.len(), 4);
+        for &(m, toml) in EMBEDDED_WIDE_CONFIGS {
+            let cfg = LigeritoSecurityConfig::from_toml_str(toml)
+                .unwrap_or_else(|e| panic!("wide config m={m} invalid: {e}"));
+            cfg.validate_profile(LigeritoProfile::Fast100)
+                .unwrap_or_else(|e| panic!("wide config m={m}: {e}"));
+            let derived = LigeritoSecurityConfig::derive_wide(m)
+                .and_then(|cfg| cfg.to_toml_string())
+                .unwrap_or_else(|e| panic!("derive wide m={m}: {e}"));
+            assert_eq!(toml, derived, "wide m={m} differs from generator output");
+            assert_eq!(wide_initial_k(m), Some(m - 25));
+            assert_eq!((cfg.m, cfg.log_n, cfg.initial_k), (m, m - 7, m - 25));
+            let l0 = &cfg.levels[0];
+            assert_eq!(
+                (l0.log_inv_rate, l0.log_msg_cols, l0.log_num_interleaved, l0.k_recursive, l0.queries, l0.ood_samples),
+                (1, 18, m - 25, m - 25, 218, 1),
+                "wide m={m} level 0"
+            );
+            assert_eq!(rest(toml), rest(m31), "wide m={m}: the levels after level 0 are m = 31's");
+        }
+        assert!((0..32).chain(36..64).all(|m| wide_initial_k(m).is_none()));
+    }
