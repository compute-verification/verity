+// --- test vectors for the Lean verifier (lane flock-verifier; backends/flock/verifier/tools/vectors.patch) ----------------
+
+fn f128_hex_(v: &F128) -> String {
+    format!("{:016x}{:016x}", v.hi, v.lo)
+}
+
+fn f128_of_hex_(s: &str) -> F128 {
+    F128::new(u64::from_str_radix(&s[16..32], 16).unwrap(), u64::from_str_radix(&s[..16], 16).unwrap())
+}
+
+/// A transport that answers like a verifier but checks nothing: it hands back fixed link points at `Commit` and fresh OS
+/// coins at every round, recording each round as the live server does. Only the vector generator uses it.
+struct Lax {
+    points: Vec<F128>,
+    streams: BTreeMap<String, Vec<RoundRec>>,
+    urandom: std::fs::File,
+}
+
+impl Transport for Lax {
+    fn call(&mut self, req: Req) -> Result<Resp, String> {
+        use std::io::Read;
+        Ok(match req {
+            Req::Hello(_) => Resp::Coins(vec![F128::ZERO; 2]),
+            Req::Commit { .. } => Resp::Coins(self.points.clone()),
+            Req::Link(_) | Req::Open { .. } | Req::Ping(_) | Req::Prime { .. } | Req::Proof { .. } => Resp::Ok,
+            Req::Round { stream, content, n } => {
+                let mut b = vec![0u8; 16 * n as usize];
+                self.urandom.read_exact(&mut b).unwrap();
+                let coins: Vec<F128> = b.chunks(16)
+                    .map(|c| F128::new(u64::from_le_bytes(c[..8].try_into().unwrap()), u64::from_le_bytes(c[8..].try_into().unwrap()))).collect();
+                self.streams.entry(stream).or_default().push(RoundRec { sha: sha256(&content), len: content.len(), n, coins: coins.clone() });
+                Resp::Coins(coins)
+            }
+            Req::Finish => Resp::Verdict(json!({"accepted": false, "why": "lax transport: no verifier"}).to_string()),
+        })
+    }
+}
+
+/// Upstream's offline verdict on a record (`Server::from_record` then `finish`): the agreement oracle.
+fn upstream_offline(st: &Arc<Stmt>, pubi: &Arc<Instances>, rec: &Value, proofs: &[Vec<u8>]) -> Value {
+    let m: BTreeMap<(String, usize), Vec<u8>> = proofs.iter().enumerate().map(|(r, p)| ((TABLE.to_string(), r), p.clone())).collect();
+    let cfg = config(st, sigma(st, pubi));
+    match Server::from_record(cfg, Box::new(NlVerifier { st: st.clone(), inst: pubi.clone() }), rec, m) {
+        Ok(mut s) => {
+            let v = s.finish();
+            json!({"accepted": v["accepted"], "why": v["why"]})
+        }
+        Err(e) => json!({"accepted": false, "why": e}),
+    }
+}
+
+/// One rep verified alone by upstream's statement verifier against a record's stream: no session checks, no root binding.
+fn upstream_rep_alone(st: &Arc<Stmt>, pubi: &Arc<Instances>, streams: &BTreeMap<String, StreamRec>, rep: usize, proof: &[u8], pts: &[Vec<F128>]) -> Value {
+    let root = rep_stream(TABLE, rep);
+    let mut ch = ReplayChallenger::new(Arc::new(streams.clone()), &root, &domain(rep));
+    let ctx = LinkCtx { points: pts, y: &[F128::ZERO, F128::ZERO], publics: &[] };
+    let v = NlVerifier { st: st.clone(), inst: pubi.clone() };
+    match v.verify(TABLE, rep, proof, &mut ch, &ctx).and_then(|cap| ch.finish().map(|_| cap)) {
+        Ok(cap) => json!({"accepted": true, "root_sha256": hex(&sha256(&cap))}),
+        Err(e) => json!({"accepted": false, "why": e}),
+    }
+}
+
+fn rounds_json(rs: &[RoundRec]) -> Value {
+    json!(rs.iter().enumerate().map(|(k, r)| json!({"k": k, "n": r.n, "msg_len": r.len, "msg_sha256": hex(&r.sha),
+        "coins": r.coins.iter().map(f128_hex_).collect::<Vec<_>>()})).collect::<Vec<_>>())
+}
