+//! `hm96-sha512/v1` leaves for the proof's own Merkle trees (verity.commitments.hm96, PROTOCOL.md section 7; verity's patch).
+//!
+//! A leaf hides its column: x = SHA-512(column bytes), y = a 192-byte salt, c = SHA-512(salt_prefix || y),
+//! b = x XOR M(key) y over GF(2) (M the 512 x 1536 Hankel matrix of the key), leaf = SHA-512(leaf_prefix(key) || b || c).
+//! Nodes are SHA-512(left || right). An opening is the column and its salt. The key is the scheme's pinned default key, a
+//! constant of every statement that uses this hash (never chosen by a prover).
+//!
+//! Salts are an explicit input of a proof: [`begin`] installs one proof's salt context (the level-0 salts, which both
+//! repetitions share because they bind one root, and a source for every later tree's), [`tree`] consumes it tree by tree,
+//! and [`opened_salts`] returns the salts of a tree's opened positions.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex, OnceLock};
+
+use rayon::prelude::{IndexedParallelIterator, IntoParallelRefMutIterator, ParallelIterator};
+use sha2::{Digest, Sha512};
+
+use crate::hashing::{Hash, hash_leaves_sha512};
+
+pub const SALT_BYTES: usize = 192;
+pub const KEY_BYTES: usize = 256;
+/// One leaf's salt as the proof carries it (192 bytes; six halves keep serde's array support).
+pub type Salt = [[u8; 32]; 6];
+
+const SALT_TAG: &[u8] = b"verity/hm96-sha512/salt/v1\0";
+const LEAF_TAG: &[u8] = b"verity/hm96-sha512/leaf/v1\0";
+const KEY_LABEL: &[u8] = b"verity/hm96-sha512/key/v1\0";
+
+/// `SHA-512(KEY_LABEL || u32be(i))` for i = 0..3, bit 2047 cleared.
+pub fn default_key() -> [u8; KEY_BYTES] {
+    let mut k = [0u8; KEY_BYTES];
+    for (i, c) in k.chunks_mut(64).enumerate() {
+        let mut h = Sha512::new();
+        h.update(KEY_LABEL);
+        h.update((i as u32).to_be_bytes());
+        c.copy_from_slice(&h.finalize());
+    }
+    k[KEY_BYTES - 1] &= 0x7f;
+    k
+}
+
+pub struct Consts {
+    pub salt_prefix: [u8; 128],
+    pub leaf_prefix: [u8; 128],
+    /// per salt byte position p and value v (index 256 p + v): the XOR of the columns 8p + s over the set bits s of v, as the
+    /// mask's eight little-endian 64-bit limbs
+    pub tables: Vec<[u64; 8]>,
+}
+
+fn key_bit(key: &[u8], t: usize) -> u64 {
+    ((key[t >> 3] >> (t & 7)) & 1) as u64
+}
+
+pub fn consts() -> &'static Consts {
+    static C: OnceLock<Consts> = OnceLock::new();
+    C.get_or_init(|| {
+        let key = default_key();
+        let mut salt_prefix = [0u8; 128];
+        salt_prefix[..SALT_TAG.len()].copy_from_slice(SALT_TAG);
+        let mut leaf_prefix = [0u8; 128];
+        leaf_prefix[..LEAF_TAG.len()].copy_from_slice(LEAF_TAG);
+        leaf_prefix[LEAF_TAG.len()..LEAF_TAG.len() + 64].copy_from_slice(&Sha512::digest(key));
+        let cols: Vec<[u64; 8]> = (0..8 * SALT_BYTES)
+            .map(|j| {
+                let mut c = [0u64; 8];
+                for i in 0..512 {
+                    c[i >> 6] |= key_bit(&key, i + j) << (i & 63);
+                }
+                c
+            })
+            .collect();
+        let mut tables = vec![[0u64; 8]; 256 * SALT_BYTES];
+        for p in 0..SALT_BYTES {
+            for v in 1..256usize {
+                let prev = tables[256 * p + (v & (v - 1))];
+                let col = cols[8 * p + v.trailing_zeros() as usize];
+                let t = &mut tables[256 * p + v];
+                for k in 0..8 {
+                    t[k] = prev[k] ^ col[k];
+                }
+            }
+        }
+        Consts { salt_prefix, leaf_prefix, tables }
+    })
+}
+
+/// `M(key) y` as 64 bytes (bit i is byte i >> 3, bit i & 7).
+pub fn mask(salt: &[u8]) -> [u8; 64] {
+    let t = &consts().tables;
+    let mut acc = [0u64; 8];
+    for (p, &v) in salt[..SALT_BYTES].iter().enumerate() {
+        let e = &t[256 * p + v as usize];
+        for k in 0..8 {
+            acc[k] ^= e[k];
+        }
+    }
+    let mut out = [0u8; 64];
+    for k in 0..8 {
+        out[8 * k..8 * k + 8].copy_from_slice(&acc[k].to_le_bytes());
+    }
+    out
+}
+
+/// The tree leaf of the column digest `x` under `salt`.
+pub fn leaf(x: &Hash, salt: &[u8]) -> Hash {
+    let c = consts();
+    let m = mask(salt);
+    let mut b = [0u8; 64];
+    for (i, (xb, mb)) in x.as_flattened().iter().zip(m).enumerate() {
+        b[i] = xb ^ mb;
+    }
+    let mut hc = Sha512::new();
+    hc.update(c.salt_prefix);
+    hc.update(&salt[..SALT_BYTES]);
+    let cd = hc.finalize();
+    let mut h = Sha512::new();
+    h.update(c.leaf_prefix);
+    h.update(b);
+    h.update(cd);
+    flock_hash::digest_from(&h.finalize())
+}
+
+pub fn salt_of(b: &[u8]) -> Salt {
+    let mut s: Salt = [[0u8; 32]; 6];
+    s.as_flattened_mut().copy_from_slice(&b[..SALT_BYTES]);
+    s
+}
+
+/// One proof's salts (see the module docs).
+pub struct SaltContext {
+    level0: Arc<Vec<u8>>,
+    draw: Box<dyn FnMut(usize) -> Vec<u8> + Send>,
+    trees: usize,
+    by_root: HashMap<Hash, Arc<Vec<u8>>>,
+}
+
+static CTX: Mutex<Option<SaltContext>> = Mutex::new(None);
+
+fn ctx() -> std::sync::MutexGuard<'static, Option<SaltContext>> {
+    CTX.lock().unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+/// Install one proof's salt context: `level0` (192 bytes per level-0 leaf) for its first tree, `draw(n)` (192 n bytes) for each
+/// later tree.
+pub fn begin(level0: Arc<Vec<u8>>, draw: Box<dyn FnMut(usize) -> Vec<u8> + Send>) {
+    let mut g = ctx();
+    assert!(g.is_none(), "hm96-sha512: a salt context is already installed (one proof at a time per process)");
+    *g = Some(SaltContext { level0, draw, trees: 0, by_root: HashMap::new() });
+}
+
+/// Remove the proof's salt context (its salts are dropped).
+pub fn end() {
+    *ctx() = None;
+}
+
+/// The next tree's salts from the context (a device prover's trees take theirs here, in build order).
+pub fn next_tree_salts(n: usize) -> Arc<Vec<u8>> {
+    let mut g = ctx();
+    let c = g.as_mut().expect("hm96-sha512 tree without a salt context (flock_merkle::hm96::begin)");
+    let s = if c.trees == 0 {
+        assert_eq!(c.level0.len(), n * SALT_BYTES, "hm96-sha512: the level-0 salts do not match the first tree's leaves");
+        c.level0.clone()
+    } else {
+        let s = (c.draw)(n);
+        assert_eq!(s.len(), n * SALT_BYTES, "hm96-sha512: a salt draw of the wrong size");
+        Arc::new(s)
+    };
+    c.trees += 1;
+    s
+}
+
+/// The tree over `num_leaves` equal leaves of `data`: salted leaves from the context, SHA-512 nodes; flat layout as
+/// `merkle_tree` (leaves, then each level, root last).
+pub fn tree(data: &[u8], num_leaves: usize) -> Vec<Hash> {
+    let salts = next_tree_salts(num_leaves);
+    tree_with_salts(data, num_leaves, salts)
+}
+
+/// [`tree`] with its salts given (a test's, or a verifier's reference).
+pub fn tree_with_salts(data: &[u8], num_leaves: usize, salts: Arc<Vec<u8>>) -> Vec<Hash> {
+    let leaf_size = data.len() / num_leaves;
+    let mut t: Vec<Hash> = vec![Hash::default(); 2 * num_leaves - 1];
+    hash_leaves_sha512(data, leaf_size, &mut t[..num_leaves]);
+    t[..num_leaves].par_iter_mut().enumerate().for_each(|(i, x)| *x = leaf(x, &salts[i * SALT_BYTES..(i + 1) * SALT_BYTES]));
+    let t = crate::hashing::merkle_tree_from_prehashed_level(t, num_leaves, flock_hash::HashKind::Sha512, 0);
+    if let Some(c) = ctx().as_mut() {
+        c.by_root.insert(*t.last().unwrap(), salts);
+    }
+    t
+}
+
+/// The salts of `tree`'s leaves at `queries`, in order (empty when the tree was not built salted in this context).
+pub fn opened_salts(tree: &[Hash], queries: &[usize]) -> Vec<Salt> {
+    let g = ctx();
+    let Some(s) = g.as_ref().and_then(|c| c.by_root.get(tree.last().unwrap())) else { return Vec::new() };
+    queries.iter().map(|&q| salt_of(&s[q * SALT_BYTES..])).collect()
+}
