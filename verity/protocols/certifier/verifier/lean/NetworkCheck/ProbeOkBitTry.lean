/-- Registration `b` held by the comparison alone to the constants of registration `a`. -/
def crossed (name a b : String) (T : Nat) : IO Unit := do
  let .ok ra := Json.parse a | IO.println s!"TRY {name}: not JSON"
  let .ok rb := Json.parse b | IO.println s!"TRY {name}: not JSON"
  match okCached ra T NetworkCheck.Period.entriesPortName with
  | .error e => IO.println s!"TRY {name}: REFUSE {e}"
  | .ok cs => IO.println s!"TRY {name} T={T} carried, the comparison: \
      {verdict (okCarried cs rb T NetworkCheck.Period.entriesPortName)}"

