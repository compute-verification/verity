/-
V*'s opening unit (`verity_flock.rec_outer.lowering`, `rec_open.unit_circuit`), generated by the verifier. A circuit file
whose unit is named `rec-open/l<LANES>-h<H>` is refused unless its unit is this builder's net at `LANES` and `H`, laid out
as `ir_lower.layout` lays M0's unit out (one 16-bit port per word), as `HmNets.check` refuses `sha512x3` and `hm96`
sections that are not the verifier's, and unless every copy of the unit reads the statement's `row`, `aux`, `acc`, `coef`
and `dirs` rows word by word, in that order. The builder is `rec_open._steps` over `rec_open._Forms`, operation for operation:
the consistency term is `rec_residuals.residual_forms` at `cons_structure(LANES)`, the climb SHA-512 of the row from the
IV, then of each level's ordered pair. What its rows force is proved in the soundness package (`FlockVBridge`).
-/
import Flock.HmNets

namespace Flock
namespace RecOpen

open HmNets hiding and

/-! ## SHA-512 of a message of forms -/

/-- Bit `t` of a byte string: bit `t % 8` of byte `t / 8`. -/
def byteBit (l : List UInt8) (t : Nat) : Bool := (l.getD (t / 8) 0).toNat.testBit (t % 8)

/-- The 16 bytes of a message length `len` (in bytes): SHA-512's 128-bit big-endian bit count. -/
def lenBE (len : Nat) : List UInt8 := (List.range' 0 16).map fun a => ((len * 8) >>> (8 * (15 - a)) % 256).toUInt8

/-- The number of zero bytes SHA-512's padding puts after `msg ‖ 0x80`. -/
def padZeros (len : Nat) : Nat := (240 - (len + 1) % 128) % 128

/-- A byte string's bits, bit `t % 8` of byte `t / 8` (`rec_open._bits`). -/
def bitsOf (l : List UInt8) : List Bool := (List.range (8 * l.length)).map (byteBit l)

/-- SHA-512's padding after a message of `total` bytes: `0x80`, the zero bytes, the bit count as 16 bytes big-endian. -/
def padTail (total : Nat) : List UInt8 := [128] ++ List.replicate (padZeros total) 0 ++ lenBE total

/-- The message's forms after a prefix of `pre` bytes: its bits, then its padding's as constants. -/
def shaMsg (bits : List Lin) (pre : Nat) : List Lin := bits ++ (bitsOf (padTail (pre + bits.length / 8))).map Lin.const

/-- The block of `msg` at bit `off`, in word order: its bit `wordBit t` is `msg`'s bit `off + t`. -/
def blockAt (msg : List Lin) (off : Nat) : List Lin := (List.range 1024).map fun p => msg.getD (off + wordBit p) Lin.zero

/-- One compression of the chaining value `st` (512 forms, word order) and the block `blk` (1024), its words
concatenated. -/
def shaBlock (st blk : List Lin) : M (List Lin) := do
  let out ← compress (words st 8) (words blk 16)
  pure out.flatten

/-- `n` compressions over the blocks of `msg` from block `k`. -/
def shaBlocks (msg : List Lin) : Nat → Nat → List Lin → M (List Lin)
  | 0, _, st => pure st
  | n + 1, k, st => do
    let st ← shaBlock st (blockAt msg (1024 * k))
    shaBlocks msg n (k + 1) st

/-- `rec_open._sha`: SHA-512 of a message whose first `pre` bytes left the chaining value `cv` and whose rest has the bits
`bits` (byte-string order); the digest's 512 bits, byte-string order. -/
def shaFrom (cv : List (BitVec 64)) (bits : List Lin) (pre : Nat) : M (List Lin) := do
  let st ← shaBlocks (shaMsg bits pre) ((shaMsg bits pre).length / 1024) 0 (cv.map constW).flatten
  pure ((List.range 512).map fun t => st.getD (wordBit t) Lin.zero)

/-- SHA-512's initial chaining value, as words. -/
def ivW : List (BitVec 64) := Sha512.iv.toList.map (·.toBitVec)

/-! ## The climb -/

/-- `_Forms.swap`: `t = d ∧ (a ⊕ s)` bit by bit, then `(a ⊕ t, s ⊕ t)`. -/
def swap (d : Lin) (a s : List Lin) : M (List Lin × List Lin) := do
  let t ← (a.zip s).mapM fun x => HmNets.and d (x.1 ^^^ x.2)
  pure (List.zipWith (· ^^^ ·) a t, List.zipWith (· ^^^ ·) s t)

/-- `_climb`'s loop from level `h`: the digest `cur` climbs through the siblings `sibs`, the direction at level `h + j`
being `d[h + j]`, each node SHA-512 of the pair from the IV. -/
def climbFrom (d : List Lin) : Nat → List Lin → List (List Lin) → M (List Lin)
  | _, cur, [] => pure cur
  | h, cur, s :: rest => do
    let lr ← swap (d.getD h Lin.zero) cur s
    let cur ← shaFrom ivW (lr.1 ++ lr.2) 0
    climbFrom d (h + 1) cur rest

/-- `aux`'s `H` siblings, 512 bits each from bit `512 h`. -/
def sibForms (aux : List Lin) (H : Nat) : List (List Lin) := (List.range H).map fun h => (aux.drop (512 * h)).take 512

/-- `_climb`: SHA-512 of `row` from the IV climbs `H` levels through `aux`'s siblings at the directions `d`; the node
reached, then 512 zero bits. -/
def climbRow (H : Nat) (row aux d : List Lin) : M (List Lin) := do
  let leaf ← shaFrom ivW row 0
  let top ← climbFrom d 0 leaf (sibForms aux H)
  pure (top ++ List.replicate 512 Lin.zero)

/-! ## GF(2^128) residuals (`rec_residuals.residual_forms`) -/

/-- Coefficient-wise XOR of two lists of forms, the shorter padded with zero. -/
def addL : List Lin → List Lin → List Lin
  | [], g => g
  | f :: fs, [] => f :: fs
  | f :: fs, g :: gs => (f ^^^ g) :: addL fs gs

/-- Multiplication by `X^k`. -/
def shiftL (k : Nat) (f : List Lin) : List Lin := List.replicate k Lin.zero ++ f

/-- Multiplication by `S = X^7 + X^2 + X + 1`. -/
def mulS (g : List Lin) : List Lin := addL (addL (addL g (shiftL 1 g)) (shiftL 2 g)) (shiftL 7 g)

/-- One fold modulo `G = X^128 + S`: `lo + X^128·hi` becomes `lo + S·hi`. -/
def foldG (f : List Lin) : List Lin := addL (f.take 128) (mulS (f.drop 128))

/-- The reduction of a product of two elements: two folds. -/
def reduceG (f : List Lin) : List Lin := foldG (foldG f)

/-- A term of `GfResiduals`' S: `["w", i]` or `["v", i]`, element `i` of a port, or `["wt", i, u]`, the element whose bit
`j` is bit `u` of `w[i + j]`. -/
inductive Term where
  | w (i : Nat)
  | v (i : Nat)
  | wt (i u : Nat)

/-- A residual of S: the sum of `ops[a]·ops[b]` over its products and of its added terms. -/
structure Res where
  mul : List (Nat × Nat)
  add : List Term

/-- `GfResiduals`' S: the operands (each a list of terms, their sum) and the residuals. -/
structure GfS where
  ops : List (List Term)
  res : List Res

/-- `residual_forms.term`: a term's 128 forms, zero past a port's end. -/
def termForms (W V : List Lin) : Term → List Lin
  | .w i => (List.range 128).map fun j => W.getD (128 * i + j) Lin.zero
  | .v i => (List.range 128).map fun j => V.getD (128 * i + j) Lin.zero
  | .wt i u => (List.range 128).map fun j => W.getD (128 * (i + j) + u) Lin.zero

/-- Two lists of forms XORed position by position, to the shorter's length. -/
def xorL (a b : List Lin) : List Lin := List.zipWith (· ^^^ ·) a b

/-- `residual_forms.xor`: from 128 zero forms, each list XORed in. -/
def xorAll (xs : List (List Lin)) : List Lin := xs.foldl xorL (List.replicate 128 Lin.zero)

/-- `residual_forms.op`: operand `k`, the XOR of its terms' forms; no terms past the end of `ops`. -/
def opForms (S : GfS) (W V : List Lin) (k : Nat) : List Lin := xorAll ((S.ops.getD k []).map (termForms W V))

/-- `_leaves`: the operands of `gf2k.karatsuba`'s ANDs on `a` and `b` of `2^n` forms each, in its order. -/
def leaves : Nat → List Lin → List Lin → List (Lin × Lin)
  | 0, a, b => [(a.headD Lin.zero, b.headD Lin.zero)]
  | n + 1, a, b =>
    leaves n (a.take (2 ^ n)) (b.take (2 ^ n)) ++ leaves n (a.drop (2 ^ n)) (b.drop (2 ^ n)) ++
      leaves n (addL (a.take (2 ^ n)) (a.drop (2 ^ n))) (addL (b.take (2 ^ n)) (b.drop (2 ^ n)))

/-- `gf2k.karatsuba`'s XORs over its ANDs' results `l` (`3^n` of them, in `leaves`' order). -/
def recomb : Nat → List Lin → List Lin
  | 0, l => [l.headD Lin.zero]
  | n + 1, l =>
    let p0 := recomb n (l.take (3 ^ n))
    let p2 := recomb n ((l.drop (3 ^ n)).take (3 ^ n))
    let p1 := recomb n (l.drop (2 * 3 ^ n))
    addL (addL p0 (shiftL (2 ^ n) (addL (addL p1 p0) p2))) (shiftL (2 ^ n * 2) p2)

/-- The leaf sums: for each product in order and each of its leaves in order, one AND of the leaf's operands, XORed into
that leaf's sum. -/
def leafSums : List (List Lin × List Lin) → List Lin → M (List Lin)
  | [], sums => pure sums
  | p :: ps, sums => do
    let zs ← (leaves 7 p.1 p.2).mapM fun xy => HmNets.and xy.1 xy.2
    leafSums ps (xorL sums zs)

/-- One residual: its added terms' XOR; if it has products, their leaf sums from `3^7` zero forms, committed, recombined
and reduced, XORed in. -/
def residual (S : GfS) (W V : List Lin) (r : Res) : M (List Lin) := do
  let acc := xorAll (r.add.map (termForms W V))
  if r.mul.isEmpty then pure acc
  else do
    let sums ← leafSums (r.mul.map fun ab => (opForms S W V ab.1, opForms S W V ab.2)) (List.replicate (3 ^ 7) Lin.zero)
    let leaf ← commitW sums
    pure (xorL acc (reduceG (recomb 7 leaf)))

/-- The residuals in order, each one's forms after the one before's. -/
def residualsGo (S : GfS) (W V : List Lin) : List Res → M (List Lin)
  | [] => pure []
  | r :: rs => do
    let acc ← residual S W V r
    let bits ← residualsGo S W V rs
    pure (acc ++ bits)

/-- `residual_forms`: `GfResiduals{S}`'s residuals over forms, 128 each, in order, from `w`'s and `v`'s element bits. -/
def residualForms (S : GfS) (W V : List Lin) : M (List Lin) := residualsGo S W V S.res

/-! ## The opening -/

/-- `rec_open.cons_structure`: the operands are `w`'s first `LANES` elements, then `v`'s `2 · LANES`, and residual `r` is
`Σ_l ops[LANES + r · LANES + l] · ops[l]` plus `w[LANES + r]`. -/
def consStructure (LANES : Nat) : GfS where
  ops := (List.range LANES).map (fun l => [Term.w l]) ++ (List.range (2 * LANES)).map fun i => [Term.v i]
  res := (List.range 2).map fun r =>
    { mul := (List.range LANES).map fun l => (LANES + r * LANES + l, l), add := [Term.w (LANES + r)] }

/-- `rec_open._steps` (`RecOpen_v3`'s and `RecOpen_v4`'s): the residuals `t` over `row + acc[:256]` and `coef` first, then
`_climb` at `dirs[:32]`, `dirs`' words 0 and 1; the result is `(out, t + acc[256:])`. -/
def recOpen (LANES H : Nat) (row aux acc coef dirs : List Lin) : M (List Lin × List Lin) := do
  let t ← residualForms (consStructure LANES) (row ++ acc.take 256) coef
  let out ← climbRow H row aux (dirs.take 32)
  pure (out, t ++ acc.drop 256)

/-- The widths of the opening's five input ports, in bits. -/
structure Ports where
  row : Nat
  aux : Nat
  acc : Nat
  coef : Nat
  dirs : Nat

def Ports.bits (p : Ports) : Array Nat := #[p.row, p.aux, p.acc, p.coef, p.dirs]

/-- The ports `row, aux, acc, coef, dirs` as the input bits `0, 1, …` in that order, then `recOpen`. -/
def recOpenNet (LANES H : Nat) (p : Ports) : M (List Lin × List Lin) := do
  let row ← input p.row
  let aux ← input p.aux
  let acc ← input p.acc
  let coef ← input p.coef
  let dirs ← input p.dirs
  recOpen LANES H row aux acc coef dirs

/-- `recOpenNet`'s outputs from the empty state: `out ‖ acc_out`. -/
def recOpenOuts (LANES H : Nat) (p : Ports) : List Lin :=
  ((recOpenNet LANES H p).run St.empty).1.1 ++ ((recOpenNet LANES H p).run St.empty).1.2

/-! ## M0's unit -/

/-- `RecOpen_v4{LANES, H}`'s ports (`rec_open.port_words`, 16 bits a word): `row` 8 LANES words, `aux`
`64 max(1, ⌈H / 2⌉)` (at `H = 0` one row the unit does not read), `acc` 64, `coef` 16 LANES, `dirs` 64. -/
def ports (LANES H : Nat) : Ports := ⟨128 * LANES, 1024 * max 1 ((H + 1) / 2), 1024, 256 * LANES, 1024⟩

/-- One 16-bit port per word of `bits` bits (`rec_outer.lowering`'s `in{j}` and `out{j}`). -/
def wordPorts (bits : Nat) : Array Nat := Array.replicate (bits / 16) 16

/-- M0's unit at `LANES` and `H`, laid out as `ir_lower.layout` lays it out: its inputs and its 128 outputs (`out`'s 64
words, then `acc_out`'s) one 16-bit port per word. -/
def unitLaid (LANES H : Nat) : Laid :=
  let p := ports LANES H
  layout ((recOpenNet LANES H p).run St.empty).2 (wordPorts (p.bits.foldl (· + ·) 0)) (wordPorts 2048)
    (recOpenOuts LANES H p).toArray

/-- The unit's name in the circuit file (`rec_outer.lowering`). -/
def unitName (LANES H : Nat) : String := s!"rec-open/l{LANES}-h{H}"

/-- `LANES` and `H` of a unit named `rec-open/l<LANES>-h<H>`, in that exact form. -/
def params (name : String) : Option (Nat × Nat) :=
  match name.splitOn "/l" with
  | [_, rest] => match rest.splitOn "-h" with
    | [l, h] => match l.toNat?, h.toNat? with
      | some L, some H => if unitName L H = name then some (L, H) else none
      | _, _ => none
    | _ => none
  | _ => none

/-- `rec_open._check`: `LANES` a positive multiple of 8, `H ≤ 32`. -/
def valid (LANES H : Nat) : Bool := 8 ≤ LANES && LANES % 8 == 0 && H ≤ 32

/-- The verifier's unit net at `LANES` and `H`. -/
def unitNet (LANES H : Nat) : V Net := netOf (unitName LANES H) (unitLaid LANES H)

/-- A net's input bits, over its input groups' ports. -/
def inBits (n : Net) : Nat := n.inGroups.foldl (fun a g => a + g.bits.foldl (· + ·) 0) 0

/-- A net's output bits, over its output groups' ports. -/
def outBits (n : Net) : Nat := n.outGroups.foldl (fun a g => a + g.bits.foldl (· + ·) 0) 0

/-- The unit's input rows at `LANES` and `H`, each with its bits: `row`, `aux`, `acc`, `coef` and `dirs`, in that order
(`rec_outer.subcircuit`'s inputs, `rec_open.port_words`). -/
def rows (LANES H : Nat) : Array (String × Nat) :=
  let p := ports LANES H
  #[("row", p.row), ("aux", p.aux), ("acc", p.acc), ("coef", p.coef), ("dirs", p.dirs)]

/-- The circuit's first five rows (its inputs; `out` and `acc_out` follow) are `rows LANES H`: each one's name, and its
bits as both `16 · words` and its row length. -/
def rowsOk (c : Circuit) (LANES H : Nat) : Bool :=
  decide ((c.ports.extract 0 5).map (fun q => (q.name, 16 * q.words, q.bits)) =
    (rows LANES H).map fun x => (x.1, x.2, x.2))

/-- Every copy's input word `i` reads the rows' word `i` (`rec_outer.lowering`'s `("leaf", p)` at input `p`), so each copy
reads its opening's `row`, `aux`, `acc`, `coef` and `dirs`, in that order. -/
def leavesOk (c : Circuit) (LANES H : Nat) : Bool :=
  c.leavesIn.all fun l => decide (l = (Array.range ((ports LANES H).bits.foldl (· + ·) 0 / 16)).map Int.ofNat)

/-- A unit named `rec-open/…` is the verifier's at the `LANES` and `H` its name gives, equal in every field, and the
statement's rows are its inputs, every copy reading them in order (`rowsOk`, `leavesOk`); any other unit passes. Its
input and output bits, rows and leaves are compared first, so the net is built only at a `LANES` the file's own rows
bound (a parsed net's input bits are below its constant row). Irreducible, so that no unification against it builds the
net. -/
@[irreducible] def check (c : Circuit) : V Unit :=
  match params c.unit.name with
  | some (L, H) =>
    if !valid L H then throw s!"circuit {c.name}: rec-open's LANES is a positive multiple of 8 and H is 0 to 32"
    else if inBits c.unit != (ports L H).bits.foldl (· + ·) 0 || outBits c.unit != 2048 then
      throw (s!"circuit {c.name}: unit {c.unit.name} has {inBits c.unit} input and {outBits c.unit} output bits, " ++
        s!"not rec-open's {(ports L H).bits.foldl (· + ·) 0} and 2048")
    else if !rowsOk c L H then
      throw s!"circuit {c.name}: {c.unit.name}'s first five rows are not row, aux, acc, coef and dirs at its widths"
    else if !leavesOk c L H then
      throw s!"circuit {c.name}: a copy of {c.unit.name} does not read its rows' words in order"
    else match unitNet L H with
      | .error e => throw e
      | .ok g =>
        if c.unit = g then pure ()
        else throw s!"circuit {c.name}: not the verifier's {c.unit.name} ({firstDiff c.unit g})"
  | none =>
    if c.unit.name.startsWith "rec-open/" then
      throw s!"circuit {c.name}: unit {c.unit.name} is not rec-open/l<LANES>-h<H>"
    else pure ()

/-- `check` reads a circuit's name, unit, rows and input leaves only. -/
theorem check_congr {c c' : Circuit} (hn : c.name = c'.name) (hu : c.unit = c'.unit) (hp : c.ports = c'.ports)
    (hl : c.leavesIn = c'.leavesIn) : check c = check c' := by
  have hr : rowsOk c = rowsOk c' := by
    funext L H
    unfold rowsOk
    rw [hp]
  have hv : leavesOk c = leavesOk c' := by
    funext L H
    unfold leavesOk
    rw [hl]
  unfold check
  rw [hn, hu, hr, hv]

/-- **What `check` accepted**: a unit named `rec-open/l<L>-h<H>` has a valid `L` and `H`, and it is the net the verifier
builds at them. -/
theorem check_ok {c : Circuit} (h : check c = .ok ()) {L H : Nat} (hp : params c.unit.name = some (L, H)) :
    valid L H = true ∧ netOf (unitName L H) (unitLaid L H) = .ok c.unit := by
  unfold check at h
  rw [hp] at h
  dsimp only at h
  split at h
  · cases h
  · rename_i hv
    split at h
    · cases h
    · split at h
      · cases h
      · split at h
        · cases h
        · split at h
          · cases h
          · rename_i g hg
            split at h
            · rename_i hcg
              exact ⟨by simpa using hv, by rw [hcg]; exact hg⟩
            · cases h

theorem foldl_add_replicate (n a b : Nat) : (List.replicate n a).foldl (· + ·) b = b + n * a := by
  induction n generalizing b with
  | zero => simp
  | succ n ih => rw [List.replicate_succ, List.foldl_cons, ih, Nat.succ_mul]; omega

theorem foldl_wordPorts (bits : Nat) : (wordPorts bits).foldl (· + ·) 0 = bits / 16 * 16 := by
  rw [wordPorts, ← Array.foldl_toList, Array.toList_replicate, foldl_add_replicate, Nat.zero_add]

theorem foldl_ports (LANES H : Nat) :
    (ports LANES H).bits.foldl (· + ·) 0 = 128 * LANES + 1024 * max 1 ((H + 1) / 2) + 1024 + 256 * LANES + 1024 := by
  simp [ports, Ports.bits] <;> omega

/-- The cap refuses no unit the comparison would accept: the verifier's own net has `ports`' input bits and 2048 output
bits. -/
theorem unitNet_bits {LANES H : Nat} {g : Net} (h : unitNet LANES H = .ok g) :
    inBits g = (ports LANES H).bits.foldl (· + ·) 0 ∧ outBits g = 2048 := by
  unfold unitNet netOf at h
  obtain ⟨-, -, -, -, -, hi, ho, -⟩ := Net.ofRows_ok h
  have hin : (unitLaid LANES H).inGroups =
      #[⟨0, groupWords ((wordPorts ((ports LANES H).bits.foldl (· + ·) 0)).foldl (· + ·) 0),
        wordPorts ((ports LANES H).bits.foldl (· + ·) 0)⟩] := rfl
  obtain ⟨col, w, hout⟩ : ∃ col w, (unitLaid LANES H).outGroups = #[⟨col, w, wordPorts 2048⟩] := ⟨_, _, rfl⟩
  refine ⟨?_, ?_⟩
  · rw [inBits, hi, hin]
    simp [foldl_wordPorts, foldl_ports] <;> omega
  · rw [outBits, ho, hout]
    simp [foldl_wordPorts]

end RecOpen
end Flock
