/-
The registered opening's units (`verity_flock.rec_residuals.stage_opening`, `InnerRepCheck{S}` at an opening-only shape),
generated by the verifier. A circuit file whose unit is named `rec-opening/m<m>-c<claims>-p<j>` is refused unless its unit
is the net the verifier builds for part `j` of the opening's algebra at `m` and `claims`, laid out as `ir_lower.layout`
lays M0's unit out, as `RecResiduals.check` refuses a `rec-residuals/…` unit that is not the verifier's.

The opening's algebra is `rec_algebra.structure` at `Shape(m, 6, claims, opening_only=True)`: no zerocheck or lincheck,
the claims' ring switches from their own points, then Ligerito and T. w is the ring switches' and Ligerito's rounds, the
running sums `acc0`, `acc1`, then each claim's value (`claim k`, row k of `rec-claim`), which residual k adds as a term of
w: no coefficient slot and no product. v has no comb. The verifier computes that S itself (`structureOf`), from
`RecAlgebra`'s ring switching and Ligerito unchanged, and cuts it into parts with `RecResiduals`' grouping and
renumbering.
-/
import Flock.RecResiduals

namespace Flock
namespace RecOpening

open HmNets hiding and
open RecAlgebra (GfS Res Term Key Messages AClaim BSt VName CM liftB kapAdd constTerm slotsOf sortBy)
open RecAlgebra.Val (zero add)

/-! ## The unit's name and shape -/

/-- The unit's name in the circuit file (`rec_residuals.stage_opening`). -/
def unitName (m c j : Nat) : String := s!"rec-opening/m{m}-c{c}-p{j}"

/-- `m`, `claims` and `j` of a unit named `rec-opening/m<m>-c<claims>-p<j>`, in that exact form. -/
def params (name : String) : Option (Nat × Nat × Nat) :=
  match name.splitOn "/m" with
  | [_, r] => match r.splitOn "-c" with
    | [m, r] => match r.splitOn "-p" with
      | [c, j] => match m.toNat?, c.toNat?, j.toNat? with
        | some m, some c, some j => if unitName m c j = name then some (m, c, j) else none
        | _, _, _ => none
      | _ => none
    | _ => none
  | _ => none

/-- `Shape(m, 6, claims, opening_only=True)`: a `fast100` schedule and at least one claim; `k_log` is unread. -/
def shape? (m c : Nat) : Option Shape := do
  let s ← fast100 m
  if c < 1 then none
  some { m, kLog := 6, claims := c, sched := s }

/-! ## The rounds and w -/

/-- The opening's message elements by the round that absorbs them (`rec_algebra.rounds` when `opening_only`): the
claims' ring switches, then Ligerito's. -/
def rounds (sh : Shape) : Array (Array Key) :=
  (Array.range sh.claims).map (fun k => (Array.range 128).map (.rs k)) ++ RecAlgebra.ligRounds sh.sched

/-- w's message and running-sum elements; the claims follow (`_w_names` when `opening_only`). -/
def wNames (sh : Shape) : Array Key := (rounds sh).flatten ++ RecAlgebra.accNames

/-- Claim `k`'s slot in w (`("claim", k)`, after the running sums). -/
def claimW (sh : Shape) (k : Nat) : Nat := (wNames sh).size + k

/-- w's size: the elements, then the claims. -/
def nw (sh : Shape) : Nat := (wNames sh).size + sh.claims

/-- An element's slot in w. -/
def wi (sh : Shape) (k : Key) : Option Nat := (wNames sh).idxOf? k

/-- The order of `_build`'s terms (`_order`): w's names, then the ring switches' transposes. -/
def order (sh : Shape) (k : Key) : Option Nat :=
  match k with
  | .rsT k u => some (nw sh + 128 * k + u)
  | .comb l => some (nw sh + 128 * sh.claims + l)
  | k => wi sh k

/-- `InnerRepCheck`'s row ports' elements (`rec_residuals.spec`): one per round, the running sums' two, each claim's one. -/
def portSizes (sh : Shape) : Array Nat :=
  (rounds sh).map (·.size) ++ #[2, 2] ++ Array.replicate sh.claims 1

/-! ## `run` from the claims on -/

variable {α : Type} [RecAlgebra.Val α]

/-- `rec_algebra._opening` on the claims: their ring switches, Ligerito's two final residuals, and the absorbed T minus
the batched sum. A claim's value is added in its residual as a term of w (`build`), so here it is `zero`. -/
def run (sh : Shape) (M : Messages α) (claims : Array (AClaim α)) : CM (Array α) := do
  let (rsr, rs) ← RecAlgebra.ringSwitch M claims
  let tIn := M.tAtom.getD rs.T
  let (lgr, _) ← RecAlgebra.ligerito sh.sched M tIn rs.sws
  return rsr ++ lgr ++ #[add tIn rs.T]

/-- The claims at points all zero (`_extras_like`, whose are random): the structure does not read them. -/
def claimsLike (sh : Shape) : Array (AClaim α) :=
  Array.replicate sh.claims ⟨zero, Array.replicate 64 0, Array.replicate (sh.m - 6) 0⟩

/-! ## `_build` at the opening's w -/

/-- `var_op`'s term (`RecAlgebra.atomTerm` over the opening's w): no comb, no consistency sum. -/
def atomTerm (sh : Shape) : Key → Except String Term
  | .rsT k u => match wi sh (.rs k 0) with
    | some i => .ok (.wt i u)
    | none => .error "build: no such ring switch"
  | .comb _ => .error "build: an opening has no comb"
  | .cons _ _ => .error "build: a consistency sum as an operand"
  | k => match wi sh k with
    | some i => .ok (.w i)
    | none => .error "build: an element w does not hold"

/-- `var_op` (`RecAlgebra.varOp`). -/
def varOp (sh : Shape) (k : Key) : StateT BSt (Except String) Nat := do
  let st ← get
  match st.opOf.lookup k with
  | some i => return i
  | none =>
    let term ← liftB (atomTerm sh k)
    set { st with opOf := st.opOf ++ [(k, st.ops.size)], ops := st.ops.push #[term] }
    return st.ops.size

def orderOf (sh : Shape) (k : Key) : Except String Nat :=
  match order sh k with
  | some o => .ok o
  | none => .error "build: an element outside the order"

/-- A residual's coefficient slots and their products (`RecAlgebra.coefOps`). -/
def coefOps (sh : Shape) (ri : Nat) : List (Key × F128) → StateT BSt (Except String) (Array (Nat × Nat))
  | [] => return #[]
  | (k, x) :: rest => do
    let st ← get
    set { st with vNames := st.vNames.push (.coef ri k), vVals := st.vVals.push x,
                  ops := st.ops.push #[.v st.vNames.size] }
    let o ← varOp sh k
    return #[(st.ops.size, o)] ++ (← coefOps sh ri rest)

/-- A residual's products of two messages (`RecAlgebra.prodOps`). -/
def prodOps (sh : Shape) (ri : Nat) : List ((Key × Key) × F128) → StateT BSt (Except String) (Array (Nat × Nat))
  | [] => return #[]
  | ((a, b), x) :: rest => do
    if x ≠ 1 then throw s!"residual {ri}: a product of messages with a coefficient other than 1"
    let oa ← varOp sh a
    let ob ← varOp sh b
    return #[(oa, ob)] ++ (← prodOps sh ri rest)

/-- A residual's running sums (`RecAlgebra.accTerms`), Ligerito's final check being residuals `claims` and `claims + 1`. -/
def accTerms (sh : Shape) (ri : Nat) (cons : List (Key × F128)) : StateT BSt (Except String) (Array Term) :=
  let fin := sh.claims
  if cons.isEmpty then pure #[]
  else if ri ≠ fin ∧ ri ≠ fin + 1 then throw s!"residual {ri}: a consistency sum outside Ligerito's final check"
  else do
    kapAdd (ri - fin) cons
    match wi sh (.acc1 (ri - fin)), wi sh (.acc0 (ri - fin)) with
    | some i1, some i0 => pure #[Term.w i1, .w i0]
    | _, _ => throw "build: no running sums"

/-- `_build`'s pass over residual `ri`: its running sums, claim `ri`'s value if it is a claim's ring switch, then its
constant. -/
def buildRes (sh : Shape) (ri : Nat) (f : RecAlgebra.Lin) : StateT BSt (Except String) Res := do
  let acc ← accTerms sh ri (f.t.filter (·.1.isCons))
  let cl := if ri < sh.claims then #[Term.w (claimW sh ri)] else #[]
  let cm ← coefOps sh ri (← liftB (sortBy (fun kx => orderOf sh kx.1) (f.t.filter (!·.1.isCons))))
  let pm ← prodOps sh ri
    (← liftB (sortBy (fun abx => do return (← orderOf sh abx.1.1) * 2 ^ 32 + (← orderOf sh abx.1.2)) f.q))
  let c ← constTerm ri f.c
  return ⟨cm ++ pm, acc ++ cl ++ c⟩

def buildAll (sh : Shape) : List RecAlgebra.Lin → Nat → StateT BSt (Except String) (Array Res)
  | [], _ => return #[]
  | f :: rest, ri => do
    let r ← buildRes sh ri f
    let rs ← buildAll sh rest (ri + 1)
    return #[r] ++ rs

/-- `_build` when `opening_only`: S, with v the coefficient slots alone. -/
def build (sh : Shape) (lins : Array RecAlgebra.Lin) : Except String GfS := do
  let kappa := sh.sched.levels.map fun lv => Array.replicate 2 (Array.replicate (2 ^ lv.lanes) (0 : F128))
  let comb0 := (lins.toList.map slotsOf).sum
  let (res, st) ← (buildAll sh lins.toList 0).run { kappa }
  if st.vNames.size ≠ comb0 ∨ st.vVals.size ≠ comb0 then throw "build: the coefficient slots miscounted"
  return ⟨nw sh, st.vNames.size, st.ops, res⟩

/-- `GfResiduals_v1{S}`'s S of the opening, a function of the shape alone (`rec_algebra.structure`). -/
def structureOf (sh : Shape) : Except String GfS := do
  let lins ← ((run sh (RecAlgebra.symbolic sh) (claimsLike sh)).run' 0).run RecAlgebra.Coins.zeros
  build sh lins

/-! ## The unit -/

/-- Part `j` of the opening's algebra: its S, its row ports' elements and its v elements' number (`RecResiduals.part`). -/
def part (sh : Shape) (j : Nat) : Except String (RecOpen.GfS × List Nat × Nat) := do
  let S ← structureOf sh
  let sizes := portSizes sh
  if sizes.foldl (· + ·) 0 != S.nw then throw s!"row ports of {sizes.foldl (· + ·) 0} elements for a w of {S.nw}"
  let gs ← RecResiduals.groups S sizes
  let some (R, P, V) := gs[j]? | throw s!"part {j} of {gs.size}"
  pure (← RecResiduals.partS S sizes R P V, P.toList.map (sizes[·]!), V.size)

/-- Part `j`'s w: the opening's w slots of its row ports' elements, in order (`RecResiduals.partS`' `wIdx`). -/
def partW (sh : Shape) (j : Nat) : Except String (Array Nat) := do
  let sizes := portSizes sh
  let gs ← RecResiduals.groups (← structureOf sh) sizes
  let some (_, P, _) := gs[j]? | throw s!"part {j} of {gs.size}"
  let st := RecResiduals.starts sizes
  pure (P.flatMap fun p => (Array.range sizes[p]!).map (st[p]! + ·))

/-- The first element of a part's w (`W`, its slots in the opening's w) that is a claim's ring switch's (`.rs k u`) or
a running sum's of Ligerito's final check (`.acc0 r`, `.acc1 r`) and not read in all 128 bits, with how many are. -/
def rsUnread (sh : Shape) (W : Array Nat) (rd : Array Bool) (ns : List Nat) : Option (Nat × Nat) :=
  ((List.range W.size).filterMap fun q => match ((wNames sh)[W[q]!]? : Option Key) with
    | some (.rs _ _) | some (.acc0 _) | some (.acc1 _) =>
      let n := RecResiduals.readBits rd ns q; if n != 128 then some (q, n) else none
    | _ => none).head?

/-- A unit named `rec-opening/…` is the verifier's part at the `m`, claims and part its name gives, equal in every
field, at one unit per VU (each part is one copy of its unit), and its computed rows read each element of a claim's ring
switch or of a running sum it holds in all 128 bits (`rsUnread`) and each other element it holds in all 128 bits or none
(`RecResiduals.partlyRead`); any other unit passes. The claims are bounded by the file's unit before the structure is
computed, and the part's input and output bits are compared before its net is built. Irreducible, so that no
unification against it builds the net. -/
@[irreducible] def check (c : Circuit) : V Unit :=
  match params c.unit.name with
  | some (m, cl, j) =>
    match shape? m cl with
    | none => throw s!"circuit {c.name}: rec-opening's m has a fast100 schedule, claims at least 1"
    | some sh =>
      if c.upv != 1 then
        throw s!"circuit {c.name}: unit {c.unit.name} has {c.upv} units per VU, not 1"
      else if cl > RecOpen.inBits c.unit then
        throw s!"circuit {c.name}: unit {c.unit.name}'s claims exceed its {RecOpen.inBits c.unit} input bits"
      else match part sh j with
        | .error e => throw s!"circuit {c.name}: unit {c.unit.name}: {e}"
        | .ok (S, ns, nv) =>
          let bits := 16 * (RecResiduals.portWords ns nv).foldl (· + ·) 0
          if RecOpen.inBits c.unit != bits || RecOpen.outBits c.unit != 16 * RecResiduals.RES_OUT_WORDS then
            throw (s!"circuit {c.name}: unit {c.unit.name} has {RecOpen.inBits c.unit} input and " ++
              s!"{RecOpen.outBits c.unit} output bits, not its part's {bits} and {16 * RecResiduals.RES_OUT_WORDS}")
          else match netOf (unitName m cl j) (RecResiduals.unitLaid S ns nv) with
            | .error e => throw e
            | .ok g =>
              if c.unit = g then
                match partW sh j with
                | .error e => throw s!"circuit {c.name}: unit {c.unit.name}: {e}"
                | .ok W => match rsUnread sh W (RecResiduals.readIns g) ns with
                  | none => match RecResiduals.partlyRead (RecResiduals.readIns g) ns with
                    | none => pure ()
                    | some (q, n) =>
                      throw s!"circuit {c.name}: unit {c.unit.name} reads {n} of row-port element {q}'s 128 bits"
                  | some (q, n) =>
                    throw (s!"circuit {c.name}: unit {c.unit.name} reads {n} of ring-switch or running-sum element " ++
                      s!"{q}'s 128 bits")
              else throw s!"circuit {c.name}: not the verifier's {c.unit.name} ({firstDiff c.unit g})"
  | none =>
    if c.unit.name.startsWith "rec-opening/" then
      throw s!"circuit {c.name}: unit {c.unit.name} is not rec-opening/m<m>-c<claims>-p<j>"
    else pure ()

/-- `check` reads a circuit's name, unit and units per VU only. -/
theorem check_congr {c c' : Circuit} (hn : c.name = c'.name) (hu : c.unit = c'.unit) (hv : c.upv = c'.upv := by rfl) :
    check c = check c' := by
  unfold check
  rw [hn, hu, hv]

end RecOpening
end Flock
