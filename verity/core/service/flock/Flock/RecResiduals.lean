/-
V*'s algebra units (`verity_flock.rec_residuals.lowering`, `InnerRepCheck{S}`), generated by the verifier. A circuit file
whose unit is named `rec-residuals/m<m>-k<k_log>-c<claims>-p<j>` is refused unless its unit is the net the verifier builds
for part `j` of the rep's algebra at that shape, laid out as `ir_lower.layout` lays M0's unit out (one 16-bit port per
word), as `RecOpen.check` refuses a `rec-open/…` unit that is not the verifier's.

The verifier computes `GfResiduals`' S itself (`RecAlgebra.structureOf`), groups its residuals as
`rec_residuals.parts` does, and builds each part's S by renumbering the whole S's terms into the part's ports: every
lookup is checked (`pos`), so a term the part does not read is refused, never sent to element 0. Soundness reads only
the renumbering's checks and the comparison with the file's unit; the grouping decides which residuals a part holds and
is checked to cover every residual once, in order.

A holo shape (`Shape.holo`, hidden unit circuits) has `h`'s round as a row port after `z_partial`'s, which the comb's
operands read (`RecAlgebra.atomOp`). A part's name does not say whether its shape is holo; the statement does, in META
(`HOLO_KEY`, absent meaning plain), and `check` builds the one net it selects.
-/
import Flock.RecOpen
import Flock.RecAlgebra

namespace Flock
namespace RecResiduals

open HmNets hiding and

def MAX_REGIONS : Nat := 64
def MAX_SLOTS : Nat := 160
/-- `rec_residuals.MAX_LONE_SLOTS`: the slots of a residual that fits no part alone under `MAX_SLOTS` and stands alone. -/
def MAX_LONE_SLOTS : Nat := 223
def RES_OUT_WORDS : Nat := 128
def PER_SLOT : Nat := 3

/-- `rec_residuals.port_words`: a port of `n` elements, in whole 64-word rows. -/
def portWordsOf (n : Nat) : Nat := (8 * n + 63) / 64 * 64

/-- `Port.comps` of a `sha512/row/v1` row of `words` words. -/
def comps (words : Nat) : Nat := (2 * words + 17 + 127) / 128 - 1

/-- `rec_residuals.regions`: a digest region per row port, `v`'s and `out`'s. -/
def regions (ports : Nat) : Nat := ports + 2

/-- `rec_residuals.slots`: the sha512x3 slots of the row ports', `v`'s and `out`'s compressions, three a slot. -/
def slots (sizes : List Nat) (nv : Nat) : Nat :=
  let words := sizes.map portWordsOf ++ [portWordsOf nv, RES_OUT_WORDS]
  (words.foldl (fun a w => a + comps w) 0 + PER_SLOT - 1) / PER_SLOT

/-! ## The unit's name and shape -/

/-- The unit's name in the circuit file (`rec_vstage.stage`). -/
def unitName (m k c j : Nat) : String := s!"rec-residuals/m{m}-k{k}-c{c}-p{j}"

/-- `m`, `k_log`, `claims` and `j` of a unit named `rec-residuals/m<m>-k<k_log>-c<claims>-p<j>`, in that exact form. -/
def params (name : String) : Option (Nat × Nat × Nat × Nat) :=
  match name.splitOn "/m" with
  | [_, r] => match r.splitOn "-k" with
    | [m, r] => match r.splitOn "-c" with
      | [k, r] => match r.splitOn "-p" with
        | [c, j] => match m.toNat?, k.toNat?, c.toNat?, j.toNat? with
          | some m, some k, some c, some j => if unitName m k c j = name then some (m, k, c, j) else none
          | _, _, _, _ => none
        | _ => none
      | _ => none
    | _ => none
  | _ => none

/-- The shape `rec_algebra.run` accepts: a `fast100` schedule, `k_log` at least 6, at least two claims. -/
def shape? (m k c : Nat) : Option Shape := do
  let s ← fast100 m
  if k < 6 || c < 2 then none
  some { m, kLog := k, claims := c, sched := s }

/-- `rec_residuals.spec`'s row ports' elements: one per round that absorbs elements, then the running sums' two. -/
def portSizes (sh : Shape) : Array Nat := (RecAlgebra.rounds sh).map (·.size) ++ #[2, 2]

/-! ## The parts (`rec_residuals.parts`) -/

open RecAlgebra (GfS Res Term)

/-- The union of two ascending arrays without repeats (`VStar.Algebra.union`). -/
def union (a b : Array Nat) : Array Nat := Id.run do
  let mut out := Array.mkEmpty (a.size + b.size)
  let mut i := 0
  let mut j := 0
  for _ in [0:a.size + b.size] do
    if i < a.size then
      if j < b.size then
        if a[i]! < b[j]! then
          out := out.push a[i]!
          i := i + 1
        else if b[j]! < a[i]! then
          out := out.push b[j]!
          j := j + 1
        else
          out := out.push a[i]!
          i := i + 1
          j := j + 1
      else
        out := out.push a[i]!
        i := i + 1
    else if j < b.size then
      out := out.push b[j]!
      j := j + 1
  return out

def sortDedup (a : Array Nat) : Array Nat :=
  (a.qsort (· < ·)).foldl (fun acc x => if acc.back? == some x then acc else acc.push x) #[]

/-- The first element of each row port in w, then w's size. -/
def starts (sizes : Array Nat) : Array Nat := sizes.foldl (fun s n => s.push (s.back! + n)) #[0]

/-- A residual's row ports and v elements, each ascending (`parts`' `touched`). -/
def touched (S : GfS) (st : Array Nat) (r : Res) : Array Nat × Array Nat := Id.run do
  let portOf (i : Nat) : Nat := (st.findIdx? (· > i)).getD st.size - 1
  let mut P : Array Nat := #[]
  let mut V : Array Nat := #[]
  let terms := r.add ++ r.mul.flatMap fun (a, b) => S.ops.getD a #[] ++ S.ops.getD b #[]
  for t in terms do
    match t with
    | .w i => P := P.push (portOf i)
    | .wt i _ => for j in [0:128] do P := P.push (portOf (i + j))
    | .v i => V := V.push i
  return (sortDedup P, sortDedup V)

/-- `parts`' grouping: each residual, in S's order, into the first part it fits, as its residuals, row ports and v
elements, or alone within `MAX_LONE_SLOTS`; refused when a residual alone fits no part, or when the parts do not hold
every residual once, in order. -/
def groups (S : GfS) (sizes : Array Nat) : Except String (Array (Array Nat × Array Nat × Array Nat)) := do
  let st := starts sizes
  let fitN (n : Nat) (g : Array Nat × Array Nat × Array Nat) (P V : Array Nat) : Bool :=
    let ps := union g.2.1 P
    regions ps.size ≤ MAX_REGIONS && slots (ps.toList.map (sizes[·]!)) (union g.2.2 V).size ≤ n
      && 8 * (g.1.size + 1) ≤ RES_OUT_WORDS
  let fit := fitN MAX_SLOTS
  let mut gs : Array (Array Nat × Array Nat × Array Nat) := #[]
  for i in [0:S.res.size] do
    let (P, V) := touched S st S.res[i]!
    match gs.findIdx? (fit · P V) with
    | some gi =>
      let (R, P0, V0) := gs[gi]!
      gs := gs.set! gi (R.push i, union P0 P, union V0 V)
    | none =>
      unless fitN MAX_LONE_SLOTS (#[], #[], #[]) P V do
        throw s!"residual {i} alone reads more than {MAX_REGIONS} regions or {MAX_LONE_SLOTS} sha512x3 slots"
      gs := gs.push (#[i], P, V)
  let all := gs.foldl (fun a g => a ++ g.1) #[]
  if (all.qsort (· < ·)).toList != List.range S.res.size then
    throw s!"the parts do not hold each of the {S.res.size} residuals once"
  pure gs

/-! ## A part's S -/

/-- Each element's position in `xs` (the last, if repeated), over `0 … n - 1`. -/
def positions (n : Nat) (xs : Array Nat) : Array (Option Nat) :=
  (xs.zipIdx).foldl (fun a (x, p) => a.set! x (some p)) (Array.replicate n none)

/-- `k`'s position in `xs` through `ps`, only if `xs` holds `k` there. -/
def pos (xs : Array Nat) (ps : Array (Option Nat)) (k : Nat) : Option Nat :=
  match ps[k]? with
  | some (some p) => if xs[p]? = some k then some p else none
  | _ => none

/-- The part's S: the whole S's operands `used` (the residuals' products' operands, ascending) and residuals `R`, each
term renumbered into the part's w (the row ports `P`' elements, in order) and v (the elements `V`). -/
def partS (S : GfS) (sizes : Array Nat) (R P V : Array Nat) : Except String RecOpen.GfS := do
  let st := starts sizes
  let wIdx := P.flatMap fun p => (Array.range sizes[p]!).map (st[p]! + ·)
  let wps := positions S.nw wIdx
  let vps := positions S.nv V
  let term (t : Term) : Except String RecOpen.Term := match t with
    | .w i => match pos wIdx wps i with
      | some i' => pure (.w i')
      | none => throw s!"[\"w\", {i}]: an element of a row port the part does not read"
    | .v j => match pos V vps j with
      | some j' => pure (.v j')
      | none => throw s!"[\"v\", {j}]: a v element the part does not read"
    | .wt i u => match pos wIdx wps i with
      | some i' =>
        if u < 128 && (List.range 128).all fun j => wIdx[i' + j]? == some (i + j) then pure (.wt i' u)
        else throw s!"[\"wt\", {i}, {u}]: a transposed block over row ports the part does not read in a run"
      | none => throw s!"[\"wt\", {i}, {u}]: an element of a row port the part does not read"
  let mut used : Array Nat := #[]
  for r in R do
    for (a, b) in (S.res[r]!).mul do used := union used (union #[a] #[b])
  let ops ← used.toList.mapM fun k =>
    if h : k < S.ops.size then S.ops[k].toList.mapM term else throw s!"product operand {k} of {S.ops.size} operands"
  let ups := positions S.ops.size used
  let res ← R.toList.mapM fun r => do
    let some rr := S.res[r]? | throw s!"residual {r} of {S.res.size}"
    let mul ← rr.mul.toList.mapM fun (a, b) => match pos used ups a, pos used ups b with
      | some a', some b' => pure (a', b')
      | _, _ => throw s!"product [{a}, {b}]: an operand the part does not hold"
    pure ({ mul, add := ← rr.add.toList.mapM term } : RecOpen.Res)
  pure { ops, res }

/-! ## The unit -/

/-- Consecutive slices of `bits` of `16 w` forms for each `w` of `ws`. -/
def slices (bits : List Lin) : List Nat → List (List Lin)
  | [] => []
  | w :: ws => bits.take (16 * w) :: slices (bits.drop (16 * w)) ws

/-- `RecOpen.termForms` over arrays. -/
def termFormsA (W V : Array Lin) : RecOpen.Term → List Lin
  | .w i => (List.range 128).map fun j => W.getD (128 * i + j) Lin.zero
  | .v i => (List.range 128).map fun j => V.getD (128 * i + j) Lin.zero
  | .wt i u => (List.range 128).map fun j => W.getD (128 * (i + j) + u) Lin.zero

/-- One residual (`RecOpen.residual`), the operands' forms `ops` computed once. -/
def residualA (ops : Array (List Lin)) (W V : Array Lin) (r : RecOpen.Res) : M (List Lin) := do
  let acc := RecOpen.xorAll (r.add.map (termFormsA W V))
  if r.mul.isEmpty then pure acc
  else do
    let sums ← RecOpen.leafSums (r.mul.map fun ab => (ops.getD ab.1 (RecOpen.xorAll []), ops.getD ab.2 (RecOpen.xorAll [])))
      (List.replicate (3 ^ 7) Lin.zero)
    let leaf ← commitW sums
    pure (RecOpen.xorL acc (RecOpen.reduceG (RecOpen.recomb 7 leaf)))

def residualsGoA (ops : Array (List Lin)) (W V : Array Lin) : List RecOpen.Res → M (List Lin)
  | [] => pure []
  | r :: rs => do
    let acc ← residualA ops W V r
    let bits ← residualsGoA ops W V rs
    pure (acc ++ bits)

/-- `RecOpen.residualForms` over arrays (`residualForms_eq`): the list lookups of a large w are quadratic. -/
def residualFormsA (S : RecOpen.GfS) (W V : Array Lin) : M (List Lin) :=
  residualsGoA (S.ops.toArray.map fun o => RecOpen.xorAll (o.map (termFormsA W V))) W V S.res

theorem termFormsA_eq (W V : List Lin) (t : RecOpen.Term) :
    termFormsA W.toArray V.toArray t = RecOpen.termForms W V t := by
  cases t <;> simp [termFormsA, RecOpen.termForms, Array.getD_eq_getD_getElem?, List.getD_eq_getElem?_getD]

theorem residualsGoA_eq (S : RecOpen.GfS) (W V : List Lin) (rs : List RecOpen.Res) :
    residualsGoA (S.ops.toArray.map fun o => RecOpen.xorAll (o.map (termFormsA W.toArray V.toArray))) W.toArray
      V.toArray rs = RecOpen.residualsGo S W V rs := by
  have ht : termFormsA W.toArray V.toArray = RecOpen.termForms W V := funext (termFormsA_eq W V)
  have hop : ∀ k, (S.ops.toArray.map fun o => RecOpen.xorAll (o.map (termFormsA W.toArray V.toArray))).getD k
      (RecOpen.xorAll []) = RecOpen.opForms S W V k := by
    intro k
    rw [ht, RecOpen.opForms, Array.getD_eq_getD_getElem?, List.getD_eq_getElem?_getD]
    simp only [Array.getElem?_map, List.getElem?_toArray]
    cases S.ops[k]? <;> rfl
  induction rs with
  | nil => rfl
  | cons r rs ih =>
    simp only [ht] at hop ih ⊢
    simp only [residualsGoA, RecOpen.residualsGo, residualA, RecOpen.residual, ih, hop, ht]

theorem residualForms_eq (S : RecOpen.GfS) (W V : List Lin) :
    residualFormsA S W.toArray V.toArray = RecOpen.residualForms S W V :=
  residualsGoA_eq S W V S.res

/-- `InnerRepCheck{S}`'s ports' words: each row port of `n` elements, then `v` of `nv`. -/
def portWords (ns : List Nat) (nv : Nat) : List Nat := ns.map portWordsOf ++ [portWordsOf nv]

/-- `rec_residuals.unit_circuit`: `residual_forms` on the row ports' first elements and `v`'s first `nv`, its residuals'
forms, then zero forms up to `RES_OUT_WORDS` words. -/
def unitNet' (S : RecOpen.GfS) (ns : List Nat) (nv : Nat) : M (List Lin) := do
  let pw := portWords ns nv
  let flat ← input (16 * pw.foldl (· + ·) 0)
  let parts := slices flat pw
  let w := (ns.zip parts).flatMap fun (n, bits) => bits.take (128 * n)
  let v := ((parts.drop ns.length).headD []).take (128 * nv)
  let bits ← residualFormsA S w.toArray v.toArray
  pure (bits ++ List.replicate (16 * RES_OUT_WORDS - bits.length) Lin.zero)

/-- The unit laid out as `ir_lower.layout` lays it out: one 16-bit port per word, in and out. -/
def unitLaid (S : RecOpen.GfS) (ns : List Nat) (nv : Nat) : Laid :=
  let r := (unitNet' S ns nv).run St.empty
  layout r.2 (Array.replicate ((portWords ns nv).foldl (· + ·) 0) 16) (Array.replicate RES_OUT_WORDS 16) r.1.toArray

/-- Part `j` of the shape's algebra: its S, its row ports' elements and its v elements' number. -/
def part (sh : Shape) (j : Nat) : Except String (RecOpen.GfS × List Nat × Nat) := do
  let S ← RecAlgebra.structureOf sh
  let sizes := portSizes sh
  if sizes.foldl (· + ·) 0 != S.nw then throw s!"row ports of {sizes.foldl (· + ·) 0} elements for a w of {S.nw}"
  let gs ← groups S sizes
  let some (R, P, V) := gs[j]? | throw s!"part {j} of {gs.size}"
  pure (← partS S sizes R P V, P.toList.map (sizes[·]!), V.size)

/-- META's key that says the statement is over a holo shape's parts (`rec_residuals.HOLO_KEY`); absent means plain. -/
def HOLO_KEY : String := "holo"

/-- Whether the statement is over a holo shape's parts: META's `HOLO_KEY`, a boolean, or false when absent. -/
def holoOf (c : Circuit) : V Bool :=
  match c.metaJ.getObjVal? HOLO_KEY with
  | .error _ => pure false
  | .ok (.bool b) => pure b
  | .ok _ => throw s!"circuit {c.name}: META {HOLO_KEY} is not a boolean"

/-- A unit named `rec-residuals/…` is the verifier's part at the shape and part its name gives, holo when the statement
says so (`holoOf`), equal in every field; any other unit passes. The shape is bounded by the file's unit before the
structure is computed, and the part's input and output bits are compared before its net is built. Irreducible, so that no
unification against it builds the net. -/
@[irreducible] def check (c : Circuit) : V Unit :=
  match params c.unit.name with
  | some (m, k, cl, j) =>
    match shape? m k cl with
    | none => throw s!"circuit {c.name}: rec-residuals' m has a fast100 schedule, k_log is at least 6, claims at least 2"
    | some sh0 =>
      if k > RecOpen.inBits c.unit || cl > RecOpen.inBits c.unit then
        throw s!"circuit {c.name}: unit {c.unit.name}'s k_log or claims exceed its {RecOpen.inBits c.unit} input bits"
      else match holoOf c with
      | .error e => throw e
      | .ok holo =>
        let sh := { sh0 with holo }
        let kind := if holo then "holo" else "plain"
        match part sh j with
        | .error e => throw s!"circuit {c.name}: unit {c.unit.name}: {e}"
        | .ok (S, ns, nv) =>
          let bits := 16 * (portWords ns nv).foldl (· + ·) 0
          if RecOpen.inBits c.unit != bits || RecOpen.outBits c.unit != 16 * RES_OUT_WORDS then
            throw (s!"circuit {c.name}: unit {c.unit.name} has {RecOpen.inBits c.unit} input and " ++
              s!"{RecOpen.outBits c.unit} output bits, not its {kind} part's {bits} and {16 * RES_OUT_WORDS} " ++
              s!"(META {HOLO_KEY}: {holo})")
          else match netOf (unitName m k cl j) (unitLaid S ns nv) with
            | .error e => throw e
            | .ok g =>
              if c.unit = g then pure ()
              else throw s!"circuit {c.name}: not the verifier's {kind} {c.unit.name} ({firstDiff c.unit g})"
  | none =>
    if c.unit.name.startsWith "rec-residuals/" then
      throw s!"circuit {c.name}: unit {c.unit.name} is not rec-residuals/m<m>-k<k_log>-c<claims>-p<j>"
    else pure ()

/-- `check` reads a circuit's name, unit and META only (`hm` by `rfl` where the two share META). -/
theorem check_congr {c c' : Circuit} (hn : c.name = c'.name) (hu : c.unit = c'.unit) (hm : c.metaJ = c'.metaJ := by rfl) :
    check c = check c' := by
  unfold check holoOf
  rw [hn, hu, hm]

end RecResiduals
end Flock
