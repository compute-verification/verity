/-- `pub` with its header's `registered` removed: what a prover writes to have its registered rows taken as committed. -/
def stripped : Public :=
  { pub with header := Json.mkObj [("units", Json.mkObj [("indices", Lean.toJson [0, 1])])] }

/-- `flock-verify verify`'s registered reads in its setup's order: `Registered.checkProgram` on the verifier's own program,
then `Registered.check` on the statement (its units derived). -/
def run (program : Option ByteArray) (f : Option Json) (p : Public) : Except String Unit := do
  let own ← f.mapM Registered.ofJson
  Registered.checkProgram program own.isSome
  Registered.check lane p own true

def why (program : Option ByteArray) (f : Option Json) (p : Public) : String :=
  match run program f p with
  | .error e => e
  | .ok () => ""

def refusal : String :=
  "registered reads: the verifier's program reads a registered value (RegisteredInput16_v1), and the verifier holds no registered roots (--registered): its rows would be committed afresh, whatever the statement's public file names"

-- the program's registered inputs, found from the descriptor alone
#guard (TemplateQuery.Desc.parse reg).toOption.map (Registered.programInputs ·) ==
  some #["RegisteredInput16_v1", "RegisteredInput32_v1"]
#guard (TemplateQuery.Desc.parse plain).toOption.map (Registered.programInputs ·) == some #[]

-- a program that reads a registered value, verified without --registered: refused, with the header and without it
#guard why (some reg) none pub == refusal
#guard why (some reg) none stripped == refusal

-- with --registered, the verifier's ports are opened; a stripped header is refused by `Registered.check`
#guard (run (some reg) (some file) pub).toBool
#guard why (some reg) (some file) stripped ==
  "registered reads: the statement names no registered rows: a registered value's rows committed afresh open no registered root"

-- a program with no registered input needs no --registered: its statement's header names none
#guard (run (some plain) none stripped).toBool
#guard (Registered.checkProgram (some plain) false).toBool
-- without the verifier's program, `checkProgram` has nothing to read; `Registered.check` refuses a header that names
-- registered rows it holds no roots for
#guard (Registered.checkProgram none false).toBool
#guard !(run none none pub).toBool
-- a descriptor that does not decode is refused, not taken as reading nothing
#guard !(Registered.checkProgram (some "{}".toUTF8) false).toBool

end Flock.Test.RegProgram
