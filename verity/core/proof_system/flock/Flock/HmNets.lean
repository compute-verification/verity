/-
PROTOCOL.md §16.10: the `sha512x3` and `hm96` slot circuits, generated by the verifier. The circuit file comes from the
prover, so the verifier builds both nets itself, as `verity_flock.sha512_circuit` builds them (over
`verity.ml.boolean.forms`) and `ir_lower.layout` lays them out, and refuses a file whose sections differ (`check`).

The builder works over GF(2) linear forms of committed bits: XOR and NOT are free, and every AND of two forms that are
neither constant nor of one support commits a new bit, the row `out = a · b`. What the rows force is proved in the
soundness package (`FlockSoundness.Discharge.Hm`).
-/
import Flock.Circuit
import Flock.Hm96

namespace Flock
namespace HmNets

/-- A committed bit's index. -/
abbrev Var := Nat

/-- The symmetric difference of two ascending lists, ascending: the support of a sum of two forms (`forms.L`'s
frozensets), so that equal sums have equal supports. -/
def symm : List Var → List Var → List Var
  | [], ys => ys
  | x :: xs, [] => x :: xs
  | x :: xs, y :: ys =>
    if x < y then x :: symm xs (y :: ys)
    else if y < x then y :: symm (x :: xs) ys
    else symm xs ys

/-- XOR over a list's values is XOR over `symm`'s: the merge drops equal pairs only. -/
theorem foldr_symm (z : Var → Bool) : ∀ (a b : List Var) (c : Bool),
    (symm a b).foldr (fun v acc => z v ^^ acc) c =
      (a.foldr (fun v acc => z v ^^ acc) c ^^ b.foldr (fun v acc => z v ^^ acc) false)
  | [], ys, c => by
    simp only [symm, List.foldr_nil]
    induction ys with
    | nil => simp
    | cons y ys ih => simp only [List.foldr_cons, ih, Bool.xor_left_comm]
  | x :: xs, [], c => by simp [symm]
  | x :: xs, y :: ys, c => by
    unfold symm
    split
    · simp only [List.foldr_cons, foldr_symm z xs (y :: ys) c, Bool.xor_assoc]
    · split
      · simp only [List.foldr_cons, foldr_symm z (x :: xs) ys c, Bool.xor_left_comm]
      · rename_i h₁ h₂
        obtain rfl : x = y := Nat.le_antisymm (Nat.not_lt.mp h₂) (Nat.not_lt.mp h₁)
        simp only [List.foldr_cons, foldr_symm z xs ys c]
        generalize List.foldr (fun v acc => z v ^^ acc) c xs = p
        generalize List.foldr (fun v acc => z v ^^ acc) false ys = q
        cases z x <;> cases p <;> cases q <;> rfl

/-- A GF(2) linear form: the XOR of the committed bits `s` (ascending, distinct) and the constant `c` (`forms.L`). -/
structure Lin where
  s : List Var
  c : Bool
  deriving DecidableEq, Inhabited

namespace Lin

def zero : Lin := ⟨[], false⟩
def one : Lin := ⟨[], true⟩
def var (v : Var) : Lin := ⟨[v], false⟩
def const (b : Bool) : Lin := ⟨[], b⟩

/-- XOR of two forms. -/
def xor (f g : Lin) : Lin := ⟨symm f.s g.s, f.c ^^ g.c⟩

instance instHXor : HXor Lin Lin Lin := ⟨xor⟩

def isConst (f : Lin) : Bool := f.s.isEmpty

end Lin

theorem symm_nil_right (a : List Var) : symm a [] = a := by
  cases a <;> simp [symm]

theorem symm_single_above : ∀ (a : List Var) (v : Var), (∀ x ∈ a, x < v) → symm a [v] = a ++ [v]
  | [], _, _ => by simp [symm]
  | x :: xs, v, h => by
    have hx : x < v := h x List.mem_cons_self
    simp only [symm, hx, ↓reduceIte, List.cons_append]
    rw [symm_single_above xs v fun y hy => h y (List.mem_cons_of_mem x hy)]

/-- One more than the largest of `l`, `0` when empty. -/
def bound (l : List Var) : Nat := l.foldr (fun v m => max (v + 1) m) 0

theorem lt_bound : ∀ (l : List Var), ∀ v ∈ l, v < bound l
  | [], _, h => by cases h
  | x :: xs, v, h => by
    have e : bound (x :: xs) = max (x + 1) (bound xs) := rfl
    rw [e]
    rcases List.mem_cons.1 h with rfl | h
    · exact Nat.lt_of_lt_of_le (Nat.lt_succ_self v) (Nat.le_max_left _ _)
    · exact Nat.lt_of_lt_of_le (lt_bound xs v h) (Nat.le_max_right _ _)

theorem lt_cons_bound {r : List Var} {b v : Nat} (hb : ∀ x ∈ r, x < b) (h : b ≤ v) : ∀ x ∈ v :: r, x < v + 1 := by
  intro x hx
  rcases List.mem_cons.1 hx with rfl | hx
  · exact Nat.lt_succ_self x
  · exact Nat.lt_succ_of_lt (Nat.lt_of_lt_of_le (hb x hx) h)

/-- A sum of forms being built, `get` its form: the support is held descending, under the bound `b`, so that a variable
above all of it joins in one step. `^^^` merges supports, and a sum that gains a fresh variable at each step would be
walked whole each time. -/
structure Acc where
  r : List Var
  c : Bool
  b : Nat
  hb : ∀ v ∈ r, v < b

namespace Acc

def get (a : Acc) : Lin := ⟨a.r.reverse, a.c⟩

def of (f : Lin) : Acc := ⟨f.s.reverse, f.c, bound f.s, fun v h => lt_bound f.s v (List.mem_reverse.1 h)⟩

/-- `a.get ^^^ g` (`add_get`): in one step when `g` is a constant or a variable above `a`'s support. -/
def add (a : Acc) (g : Lin) : Acc :=
  match _hs : g.s with
  | [] => ⟨a.r, a.c ^^ g.c, a.b, a.hb⟩
  | [v] =>
    if h : a.b ≤ v then ⟨v :: a.r, a.c ^^ g.c, v + 1, lt_cons_bound a.hb h⟩
    else of (a.get ^^^ g)
  | _ :: _ :: _ => of (a.get ^^^ g)

theorem of_get (f : Lin) : (of f).get = f := by
  cases f
  simp [of, get]

theorem add_get (a : Acc) (g : Lin) : (a.add g).get = a.get ^^^ g := by
  obtain ⟨s, c⟩ := g
  unfold add
  split
  · rename_i hs
    simp only at hs
    subst hs
    show (⟨a.r.reverse, a.c ^^ c⟩ : Lin) = ⟨symm a.r.reverse [], a.c ^^ c⟩
    rw [symm_nil_right]
  · rename_i v hs
    simp only at hs
    subst hs
    split
    · rename_i h
      show (⟨(v :: a.r).reverse, a.c ^^ c⟩ : Lin) = ⟨symm a.r.reverse [v], a.c ^^ c⟩
      rw [symm_single_above _ _ fun x hx => Nat.lt_of_lt_of_le (a.hb x (List.mem_reverse.1 hx)) h, List.reverse_cons]
    · exact of_get _
  · exact of_get _

theorem zipWith_add_get : ∀ (sums : List Acc) (zs : List Lin),
    (List.zipWith add sums zs).map get = List.zipWith (· ^^^ ·) (sums.map get) zs
  | [], _ => rfl
  | _ :: _, [] => rfl
  | a :: sums, z :: zs => by
    simp only [List.zipWith_cons_cons, List.map_cons]
    rw [add_get, zipWith_add_get sums zs]

end Acc

/-- A committed row: bit `out` is the product of the forms `a` and `b`. -/
structure Row where
  out : Var
  a : Lin
  b : Lin

/-- The builder's state: the next committed bit and the rows so far (newest first). -/
structure St where
  next : Nat
  rows : List Row

/-- The circuit builder (`forms.Circuit`). -/
abbrev M := StateM St

/-- A new committed bit, the product of `a` and `b`. -/
def fresh (a b : Lin) : M Lin := fun s => (Lin.var s.next, ⟨s.next + 1, ⟨s.next, a, b⟩ :: s.rows⟩)

/-- `n` committed input bits (no rows). -/
def input (n : Nat) : M (List Lin) := fun s => ((List.range n).map fun i => Lin.var (s.next + i), ⟨s.next + n, s.rows⟩)

/-- `forms.Circuit.AND` (no common-subexpression table): constants and equal supports simplify, else a new bit. -/
def and (a b : Lin) : M Lin :=
  if a.isConst then pure (if a.c then b else Lin.zero)
  else if b.isConst then pure (if b.c then a else Lin.zero)
  else if a.s = b.s then pure (if a.c = b.c then a else Lin.zero)
  else fresh a b

/-- `forms.maj`: the majority with one AND, `z ⊕ (x ⊕ z)(y ⊕ z)`; two or more constants simplify. -/
def maj (x y z : Lin) : M Lin :=
  let consts := [x, y, z].filter (·.isConst)
  if 2 ≤ consts.length then
    let vars := [x, y, z].filter (fun w => !w.isConst)
    let s := (consts.map fun w => w.c.toNat).sum
    if s = 0 then pure Lin.zero
    else if s = 2 then pure Lin.one
    else pure (match vars with
      | v :: _ => v
      | [] => Lin.const (decide (2 ≤ ([x, y, z].map fun w => w.c.toNat).sum)))
  else do
    let r ← and (x ^^^ z) (y ^^^ z)
    pure (z ^^^ r)

/-- `sha512_circuit.commit` on one bit: a committed bit or a constant stays; any other form becomes a new bit,
the product of the form and 1. -/
def commit (f : Lin) : M Lin :=
  if (f.s.length = 1 ∧ f.c = false) ∨ f.isConst then pure f else fresh f Lin.one

/-! ## Words -/

/-- A 64-bit word of the circuit: its bits' forms, least significant first (`sha512_circuit`'s words). -/
abbrev Word := List Lin

/-- `sha512_circuit._rot`: `x[n:] + x[:n]`, the word rotated right by `n`. -/
def rot (w : Word) (n : Nat) : Word := w.drop n ++ w.take n

/-- `sha512_circuit._shr`: `x[n:] + [0] * n`, the word shifted right by `n`. -/
def shr (w : Word) (n : Nat) : Word := w.drop n ++ List.replicate n Lin.zero

/-- XOR of two words, bit by bit. -/
def xorW (a b : Word) : Word := List.zipWith (· ^^^ ·) a b

/-- `sha512_circuit._xor3`: `p ^ q ^ r` bit by bit. -/
def xor3 (a b c : Word) : Word := xorW (xorW a b) c

/-- `forms.const_bits value 64`. -/
def constW (k : BitVec 64) : Word := (List.range 64).map fun i => Lin.const (k.getLsbD i)

/-- `compress_gadget`'s `ch`: `g ⊕ AND(e, f ⊕ g)` bit by bit. -/
def chW (e f g : Word) : M Word :=
  (List.zip e (List.zip f g)).mapM fun x => do
    let r ← and x.1 (x.2.1 ^^^ x.2.2)
    pure (x.2.2 ^^^ r)

/-- `forms.maj` bit by bit. -/
def majW (a b c : Word) : M Word := (List.zip a (List.zip b c)).mapM fun x => maj x.1 x.2.1 x.2.2

/-- `sha512_circuit.commit`. -/
def commitW (w : Word) : M Word := w.mapM commit

/-! ## The ripple-carry adder -/

/-- `sha512_circuit.CARRY_EVERY`. -/
def CARRY_EVERY : Nat := 5

/-- The carry out of bit `i`, committed at every bit `i ≡ 4 (mod 5)`. -/
def carryCommit (i : Nat) (c : Lin) : M Lin :=
  if i % CARRY_EVERY = CARRY_EVERY - 1 then commit c else pure c

/-- `sha512_circuit._add2`'s loop from bit `i` with carry `c`: the sum bit `x ⊕ y ⊕ c`, then, before the last bit, the
carry `maj(x, y, c)`, committed at every bit `i ≡ 4 (mod 5)`. -/
def add2Go : Word → Word → Lin → Nat → M Word
  | x :: a, y :: b, c, i =>
    if a.isEmpty then pure [x ^^^ y ^^^ c]
    else do
      let c₁ ← maj x y c
      let c₂ ← carryCommit i c₁
      let r ← add2Go a b c₂ (i + 1)
      pure ((x ^^^ y ^^^ c) :: r)
  | _, _, _, _ => pure []

/-- `sha512_circuit._add2`: the sum of two words mod `2^64`, carry in 0. -/
def add2 (a b : Word) : M Word := add2Go a b Lin.zero 0

/-- `sha512_circuit._add`: `acc + x₁ + … + xₖ`, added left to right. -/
def addN : Word → List Word → M Word
  | acc, [] => pure acc
  | acc, x :: xs => do
    let acc ← add2 acc x
    addN acc xs

/-! ## The compression -/

/-- `Σ₀`, `Σ₁`, `σ₀`, `σ₁` as XOR forms (no rows). -/
def bsig0W (a : Word) : Word := xor3 (rot a 28) (rot a 34) (rot a 39)
def bsig1W (e : Word) : Word := xor3 (rot e 14) (rot e 18) (rot e 41)
def ssig0W (w : Word) : Word := xor3 (rot w 1) (rot w 8) (shr w 7)
def ssig1W (w : Word) : Word := xor3 (rot w 19) (rot w 61) (shr w 6)

/-- SHA-512's eight working variables. -/
structure Regs (α : Type) where
  a : α
  b : α
  c : α
  d : α
  e : α
  f : α
  g : α
  h : α

namespace Regs

def ofList {α : Type} [Inhabited α] (l : List α) : Regs α :=
  ⟨l[0]!, l[1]!, l[2]!, l[3]!, l[4]!, l[5]!, l[6]!, l[7]!⟩

def toList {α : Type} (r : Regs α) : List α := [r.a, r.b, r.c, r.d, r.e, r.f, r.g, r.h]

def map {α β : Type} (f : α → β) (r : Regs α) : Regs β := ⟨f r.a, f r.b, f r.c, f r.d, f r.e, f r.f, f r.g, f r.h⟩

end Regs

/-- Schedule word `w.length` from the words before it, committed: `commit(_add(w[t-16], σ₀ w[t-15], w[t-7], σ₁ w[t-2]))`. -/
def schedStep (w : List Word) : M (List Word) := do
  let t := w.length
  let x ← addN (w.getD (t - 16) []) [ssig0W (w.getD (t - 15) []), w.getD (t - 7) [], ssig1W (w.getD (t - 2) [])]
  let x ← commitW x
  pure (w ++ [x])

/-- `n` more schedule words. -/
def schedule : Nat → List Word → M (List Word)
  | 0, w => pure w
  | n + 1, w => do
    let w ← schedStep w
    schedule n w

/-- One round with constant `k` and schedule word `wt`; the new `e` and `a` are committed, `e` first. -/
def roundW (k : BitVec 64) (wt : Word) (r : Regs Word) : M (Regs Word) := do
  let ch ← chW r.e r.f r.g
  let t1 ← addN r.h [bsig1W r.e, ch, constW k, wt]
  let mj ← majW r.a r.b r.c
  let t2 ← add2 (bsig0W r.a) mj
  let e ← add2 r.d t1
  let e ← commitW e
  let a ← add2 t1 t2
  let a ← commitW a
  pure ⟨a, r.a, r.b, r.c, e, r.e, r.f, r.g⟩

/-- Round constant `t` (`Flock.Sha512.k`). -/
def kAt (t : Nat) : BitVec 64 := (Flock.Sha512.k[t]!).toBitVec

/-- Rounds `t, t+1, …, t+n-1` over the schedule `w`. -/
def rounds (w : List Word) : Nat → Nat → Regs Word → M (Regs Word)
  | 0, _, r => pure r
  | n + 1, t, r => do
    let r ← roundW (kAt t) (w.getD t []) r
    rounds w n (t + 1) r

/-- `sha512_circuit.compress_gadget`: the schedule, 80 rounds, the feed-forward. -/
def compress (cv msg : List Word) : M (List Word) := do
  let w ← schedule 64 msg
  let r ← rounds w 80 0 (Regs.ofList cv)
  (cv.zip r.toList).mapM fun x => add2 x.1 x.2

/-- `sha512_circuit._words`: `n` words of 64 bits. -/
def words (bits : List Lin) (n : Nat) : List Word := (List.range n).map fun i => (bits.drop (64 * i)).take 64

/-- `sha512_circuit.compression n`: the inputs `cv{i}` (512 bits) and `msg{i}` (1024 bits) for each `i`, then each
compression's output, its words concatenated. -/
def compression (n : Nat) : M (List (List Lin × List Lin) × List (List Lin)) := do
  let ins ← (List.range n).mapM fun _ => do
    let cv ← input 512
    let msg ← input 1024
    pure (cv, msg)
  let outs ← ins.mapM fun x => do
    let out ← compress (words x.1 8) (words x.2 16)
    pure out.flatten
  pure (ins, outs)

/-- The sha512x3 slot's circuit. -/
def compression3 : M (List (List Lin × List Lin) × List (List Lin)) := compression 3

/-! ## The hm96 slot -/

/-- `sha512_circuit.word_bit`: the word-order position of byte-string bit `t` (bit `t % 8` of byte `t / 8`; words
big-endian). -/
def wordBit (t : Nat) : Nat := 64 * (t / 64) + 56 - 8 * (t / 8 % 8) + t % 8

/-- The salt's 24 message words: word `i`'s bit `j` is the byte-string bit of `y` that `wordBit` sends to `64 i + j`. -/
def saltWords (y : List Lin) : List Word :=
  (List.range 24).map fun i => (List.range 64).map fun j => y.getD (64 * i + 8 * (7 - j / 8) + j % 8) Lin.zero

/-- Bit `i` of `b = x ⊕ M·y` from `x`'s bit: `M[i][j]` is key bit `i + j` (`Hm96.mask`), `j < 1536`. The salt's bits are
added last first, so each joins the front of the sum's support (`maskBit_hom`: the sum in order). -/
def maskBit (key : ByteArray) (y : List Lin) (i : Nat) (x : Lin) : Lin :=
  let ya := y.toArray
  (List.range 1536).foldr (fun j acc => if Flock.Hm96.bit key (i + j) then ya.getD j Lin.zero ^^^ acc else acc) x

theorem foldl_xor_shift (u : Nat → Bool) : ∀ (l : List Nat) (c : Bool),
    l.foldl (fun acc j => acc ^^ u j) c = (c ^^ l.foldl (fun acc j => acc ^^ u j) false)
  | [], c => by simp
  | j :: l, c => by
    simp only [List.foldl_cons, Bool.false_xor]
    rw [foldl_xor_shift u l (c ^^ u j), foldl_xor_shift u l (u j), Bool.xor_assoc]

/-- Under any map `ev` that sends XOR to XOR, `maskBit` is `x`'s value plus key bit `i + j` times salt bit `j`, summed over
`j < 1536` in order. -/
theorem maskBit_hom (ev : Lin → Bool) (hxor : ∀ a b, ev (a ^^^ b) = (ev a ^^ ev b)) (key : ByteArray) (y : List Lin)
    (i : Nat) (x : Lin) :
    ev (maskBit key y i x) =
      (ev x ^^ (List.range 1536).foldl (fun acc j => acc ^^ (Flock.Hm96.bit key (i + j) && ev (y.getD j Lin.zero))) false) := by
  have hget : ∀ j, y.toArray.getD j Lin.zero = y.getD j Lin.zero := fun j => by
    rw [List.getD_eq_getElem?_getD]
    by_cases hj : j < y.length
    · simp [Array.getD, hj]
    · simp [Array.getD, hj]
  suffices ∀ l : List Nat, ev (l.foldr (fun j acc => if Flock.Hm96.bit key (i + j) then y.toArray.getD j Lin.zero ^^^ acc
      else acc) x) = (ev x ^^ l.foldl (fun acc j => acc ^^ (Flock.Hm96.bit key (i + j) && ev (y.getD j Lin.zero))) false) from
    this _
  intro l
  induction l with
  | nil => simp
  | cons j l ih =>
    simp only [List.foldr_cons, List.foldl_cons, Bool.false_xor]
    rw [foldl_xor_shift _ l]
    split
    · rename_i hb
      rw [hxor, ih, hget, hb, Bool.true_and]
      generalize ev (y.getD j Lin.zero) = p
      generalize List.foldl _ false l = q
      cases p <;> cases q <;> cases ev x <;> rfl
    · rename_i hb
      rw [ih]
      simp [hb]

/-- The chaining value after `hm96-sha512/v1`'s salt prefix (one block). -/
def saltMid : List (BitVec 64) :=
  (List.range 8).map fun i => (Flock.Sha512.compress Flock.Sha512.iv Flock.Hm96.Default512.saltPrefix 0)[i]!.toBitVec

/-- The salt digest's second block after the salt's last 64 bytes: SHA-512's padding of a 320-byte message. -/
def saltTail : List (BitVec 64) := [0x8000000000000000#64, 0#64, 0#64, 0#64, 0#64, 0#64, 0#64, 2560#64]

/-- `sha512_circuit.hm96_row`: inputs `cv` (512 bits), `pad` (1024) and the salt `y` (1536, byte-string order); output
`b ‖ c` (1024 bits, byte-string order), `x = F(cv, pad)`, `c = SHA-512(salt_prefix ‖ y)` from the prefix's midstate,
`b = x ⊕ M(key)·y`. -/
def hm96Row (key : ByteArray) : M (List Lin × List Lin × List Lin × List Lin) := do
  let cv ← input 512
  let pad ← input 1024
  let y ← input 1536
  let x ← compress (words cv 8) (words pad 16)
  let yw := saltWords y
  let st ← compress (saltMid.map constW) (yw.take 16)
  let st ← compress st (yw.drop 16 ++ saltTail.map constW)
  let b := (List.range 512).map fun i => maskBit key y i (x.flatten.getD (wordBit i) Lin.zero)
  let c := (List.range 512).map fun t => st.flatten.getD (wordBit t) Lin.zero
  pure (cv, pad, y, b ++ c)

/-! ## The layout (`ir_lower.layout`) -/

/-- A port group's words: `ceil_pow2(max(1, ⌈bits / 128⌉))`. -/
def groupWords (bits : Nat) : Nat := nextPow2 (max 1 ((bits + WORD - 1) / WORD))

/-- A built circuit laid out as one slot type: the input ports in one group from column 0 (their rows self rows, the
group's padding empty), then every AND's row in creation order, then the outputs in one group aligned to its words (each a
copy row `form · 1`), the constant last. A form's row is its bits' columns, ascending, and the constant's if its constant is
set. Every AND is live in both circuits here (each feeds an output), so none is dropped. -/
structure Laid where
  useful : Nat
  constPos : Nat
  inGroups : Array Group
  outGroups : Array Group
  ra : Array (Array Nat)
  rb : Array (Array Nat)
  deriving Inhabited

/-- Committed bit `v`'s column: an input bit (`v < nIn`) its own row, the AND committed `k`-th the `k`-th row after the
input group. -/
def col (nIn inRows v : Var) : Nat := if v < nIn then v else inRows + (v - nIn)

/-- A form's row: its bits' columns, then the constant's when its constant is set. -/
def cols (nIn inRows constPos : Nat) (l : Lin) : Array Nat :=
  (l.s.map (col nIn inRows)).toArray ++ (if l.c then #[constPos] else #[])

/-- The layout of a circuit with input ports `inBits` (bits `0, 1, …` of the builder) and output ports `outBits` (the forms
`outs`) after building it to `st`. -/
def layout (st : St) (inBits outBits : Array Nat) (outs : Array Lin) : Laid :=
  let rows := st.rows.reverse.toArray
  let nIn := inBits.foldl (· + ·) 0
  let inW := groupWords nIn
  let inRows := inW * WORD
  let outW := groupWords (outBits.foldl (· + ·) 0)
  let span := outW * WORD
  let start := (inRows + rows.size + span - 1) / span * span
  let constPos := start + span
  let cs := cols nIn inRows constPos
  let empty := fun (n : Nat) => (Array.replicate n (#[] : Array Nat))
  let ins := (Array.range nIn).map fun i => #[i]
  let gap := empty (inRows - nIn)
  let gap2 := empty (start - inRows - rows.size)
  let gap3 := empty (span - outs.size)
  { useful := constPos + 1, constPos,
    inGroups := #[⟨0, inW, inBits⟩], outGroups := #[⟨start / WORD, outW, outBits⟩],
    ra := ins ++ gap ++ rows.map (cs ·.a) ++ gap2 ++ outs.map cs ++ gap3 ++ #[#[constPos]],
    rb := ins ++ gap ++ rows.map (cs ·.b) ++ gap2 ++ outs.map (fun _ => #[constPos]) ++ gap3 ++ #[#[constPos]] }

/-- The builder's initial state. -/
def St.empty : St := ⟨0, []⟩

def SHA_IN : Array Nat := #[512, 1024, 512, 1024, 512, 1024]
def SHA_OUT : Array Nat := #[512, 512, 512]
def HM_IN : Array Nat := #[512, 1024, 1536]
def HM_OUT : Array Nat := #[1024]

/- The two layouts are functions of `Unit`, built when a statement needs them: a closed term would be evaluated at every
start of the program. They are irreducible so that no proof's unfolding builds them. -/
set_option compiler.extract_closed false in
/-- `sha512x3`: `compression(3)` with inputs `cv0, msg0, cv1, msg1, cv2, msg2` and outputs `out0, out1, out2`. -/
@[irreducible] def shaLaid (_ : Unit) : Laid :=
  let p := compression3.run St.empty
  layout p.2 SHA_IN SHA_OUT p.1.2.flatten.toArray

set_option compiler.extract_closed false in
/-- `hm96`: `hm96_row` under the default key, inputs `cv, pad, y`, output `bc`. -/
@[irreducible] def hmLaid (_ : Unit) : Laid :=
  let p := (hm96Row Hm96.Default512.key).run St.empty
  layout p.2 HM_IN HM_OUT p.1.2.2.2.toArray

def netOf (name : String) (l : Laid) : V Net := Net.ofRows name l.useful l.constPos l.inGroups l.outGroups l.ra l.rb

/- Each net is built once per run, when a statement first needs it (setup reads the circuit once per table). -/
set_option compiler.extract_closed false in
/-- The verifier's `sha512x3` net. -/
def sha512x3Net : Thunk (V Net) := Thunk.mk fun _ => netOf "sha512x3" (shaLaid ())

set_option compiler.extract_closed false in
/-- The verifier's `hm96` net. -/
def hm96Net : Thunk (V Net) := Thunk.mk fun _ => netOf "hm96" (hmLaid ())

theorem thunk_get {α : Type} (f : Unit → α) : (Thunk.mk f).get = f () := rfl

/- These two are not `rfl`: the kernel would build the nets to check it. -/
theorem sha512x3Net_get : sha512x3Net.get = netOf "sha512x3" (shaLaid ()) := by
  unfold sha512x3Net
  exact thunk_get _

theorem hm96Net_get : hm96Net.get = netOf "hm96" (hmLaid ()) := by
  unfold hm96Net
  exact thunk_get _

deriving instance DecidableEq for Group
deriving instance DecidableEq for Sparse
deriving instance DecidableEq for LookupTable
deriving instance DecidableEq for Net

/-- Where a file's net first differs from the generated one, for the refusal. -/
def firstDiff (p g : Net) : String :=
  if p.name != g.name then s!"its name is {p.name}"
  else if p.useful != g.useful || p.constPos != g.constPos then
    s!"it has {p.useful} rows and the constant at {p.constPos}, not {g.useful} and {g.constPos}"
  else if !decide (p.inGroups = g.inGroups) || !decide (p.outGroups = g.outGroups) then "its port groups differ"
  else match (List.range g.useful).find? (fun i => p.a.row i != g.a.row i || p.b.row i != g.b.row i) with
    | some i => s!"row {i} differs"
    | none => "its matrices differ"

/-- Net `n` of `nets` is the verifier's `gen`, equal in every field. -/
def checkNet (nets : Array (String × Net)) (n : Nat) (name what : String) (gen : Thunk (V Net)) : V Unit :=
  match gen.get with
  | .error e => throw e
  | .ok g =>
    if (nets.getD n default).2 = g then pure ()
    else throw s!"circuit {name}: not the verifier's {what} ({firstDiff (nets.getD n default).2 g})"

def checkNets (nets : Array (String × Net)) (sha hm : Nat) : V Unit := do
  checkNet nets sha "sha512x3" "three SHA-512 compressions" sha512x3Net
  checkNet nets hm "hm96" "hm96-sha512/row/v1 commit" hm96Net

/-- The file's `sha512x3` and `hm96` nets are the verifier's. Irreducible, so that no unification against it builds the
nets. -/
@[irreducible] def check (c : Circuit) : V Unit := checkNets c.nets c.shaNet c.hmNet

theorem checkNet_ok {nets : Array (String × Net)} {n : Nat} {name what : String} {gen : Thunk (V Net)}
    (h : checkNet nets n name what gen = .ok ()) : ∃ g, gen.get = .ok g ∧ (nets.getD n default).2 = g := by
  unfold checkNet at h
  split at h
  · cases h
  · rename_i g hg
    split at h
    · exact ⟨g, hg, by assumption⟩
    · cases h

/-- `check` reads a circuit's nets and the two nets' indices only. -/
theorem check_congr {c c' : Circuit} (hn : c.nets = c'.nets) (hs : c.shaNet = c'.shaNet) (hh : c.hmNet = c'.hmNet) :
    check c = check c' := by
  unfold check
  rw [hn, hs, hh]

theorem bind_ok {ε α β : Type} {x : Except ε α} {f : α → Except ε β} {b : β} (h : x >>= f = .ok b) :
    ∃ a, x = .ok a ∧ f a = .ok b := by
  cases x with
  | error e => cases h
  | ok a => exact ⟨a, rfl, h⟩

/-- **What `check` accepted**: the file's `sha512x3` and `hm96` nets are the ones the verifier builds. -/
theorem check_ok {c : Circuit} (h : check c = .ok ()) :
    (∃ g, sha512x3Net.get = .ok g ∧ (c.nets.getD c.shaNet default).2 = g) ∧
      ∃ g, hm96Net.get = .ok g ∧ (c.nets.getD c.hmNet default).2 = g := by
  unfold check checkNets at h
  obtain ⟨_, h₁, h₂⟩ := bind_ok h
  exact ⟨checkNet_ok h₁, checkNet_ok h₂⟩

end HmNets
end Flock

