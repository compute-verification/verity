/-
V*'s sparse-phase unit (`verity_flock.rec_sparse.lowering`, `RecSparse_v1{NU, ELL, S_LOG, T_LOG}`), generated by the
verifier. A circuit file whose unit is named `rec-sparse/n<NU>-e<ELL>-s<S_LOG>-t<T_LOG>` is refused unless its unit is the
net this builder makes at that shape, laid out as `ir_lower.layout` lays M0's unit out (one 16-bit port per word), as
`RecResiduals.check` refuses a `rec-residuals/…` unit that is not the verifier's.

The builder is `rec_sparse._steps` over `rec_sparse._Forms`, operation for operation: the products of a message by a
verifier value are one `GfResiduals` S (`products_structure`), leaf-summed per residual (`RecResiduals.residualFormsA`);
every other product (H2's and H3's claim chains, Φ's product tree, H4's type-selected sum) commits its operands first
(`sha512.commit`) and is Karatsuba's ANDs, recombined and reduced; the type selects are a demultiplexer of `eq(r_s, σ)` by
τ_σ's bits.
-/
import Flock.RecResiduals

namespace Flock
namespace RecSparse

open HmNets hiding and

def F_WORDS : Nat := 8
def ROW_BLOCK : Nat := 64
/-- H2's rounds: the univariate skip's 6 low row bits. -/
def PRE_ROUNDS : Nat := 6
def SKIP : Nat := 64

/-! ## The shape and the ports -/

/-- `rec_sparse.Shape`: the entries' bits NU, the template's row and column bits ELL, the slots' bits S_LOG and the
stacked types' bits T_LOG. -/
structure Shape where
  nu : Nat
  ell : Nat
  sLog : Nat
  tLog : Nat

namespace Shape

/-- `Shape.__post_init__`: NU ≥ 1, ELL ≥ 6, T_LOG ≤ 16 (a type is one word). -/
def valid (sh : Shape) : Bool := 1 ≤ sh.nu && PRE_ROUNDS ≤ sh.ell && sh.tLog ≤ 16

def d (sh : Shape) : Nat := 2 * sh.ell + 1
def P (sh : Shape) : Nat := 2 * sh.ell + 2
/-- `(P - 1).bit_length()`. -/
def pLog (sh : Shape) : Nat := Nat.log2 (sh.P - 1) + 1
def PP (sh : Shape) : Nat := 2 ^ sh.pLog
def S (sh : Shape) : Nat := 2 ^ sh.sLog
def T (sh : Shape) : Nat := 2 ^ sh.tLog
def stacked (sh : Shape) : Bool := sh.tLog > 0

/-- H3's round degrees: d over the entry bits, d + 1 over the slot bits. -/
def degrees (sh : Shape) : List Nat := List.replicate sh.nu sh.d ++ List.replicate sh.sLog (sh.d + 1)

end Shape

/-- `port_words`: a port of `n` elements, in whole 64-word rows. -/
def portWords (n : Nat) : Nat := (F_WORDS * n + ROW_BLOCK - 1) / ROW_BLOCK * ROW_BLOCK

/-- `message_ports`: the F-element ports in order, each with its elements: the messages, then `claim`. -/
def messagePorts (sh : Shape) : List (String × Nat) :=
  [("h", SKIP)] ++ (List.range PRE_ROUNDS).map (fun j => (s!"pre{j}", 2)) ++ [("v2", 1)] ++
    (sh.degrees.zipIdx.map fun (deg, j) => (s!"sc{j}", deg)) ++ [("u", sh.PP)] ++
    (if sh.stacked then [("vt", sh.T)] else []) ++ [("claim", 1)]

def tauWords (sh : Shape) : Nat := (sh.S + ROW_BLOCK - 1) / ROW_BLOCK * ROW_BLOCK

/-- `v_layout`'s parts in order, each with its elements. -/
def vParts (sh : Shape) : List (String × Nat) :=
  [("eqc", SKIP), ("pre", 2 * PRE_ROUNDS), ("what", 1), ("sc", sh.degrees.foldl (· + ·) 0), ("alpha", 1),
    ("ax", sh.ell), ("ay", sh.ell), ("ur", 1), ("eqp", sh.PP)] ++
    (if sh.stacked then [("eqs", sh.S), ("eqt", sh.T)] else [])

/-- The first element of part `nm` of `parts` (its elements summed before it); past the end, the elements' total. -/
def offset (parts : List (String × Nat)) (nm : String) : Nat :=
  match parts with
  | [] => 0
  | (n, k) :: rest => if n = nm then 0 else k + offset rest nm

def nv (sh : Shape) : Nat := (vParts sh).foldl (fun a p => a + p.2) 0

def residualNames (sh : Shape) : List String := ["h2", "h3"] ++ (if sh.stacked then ["h4"] else []) ++ ["claim"]

/-- `out_words`: the residuals' 8 words each, then with T > 1 a word a slot, in whole 64-word rows. -/
def outWords (sh : Shape) : Nat :=
  (F_WORDS * (residualNames sh).length + (if sh.stacked then sh.S else 0) + ROW_BLOCK - 1) / ROW_BLOCK * ROW_BLOCK

/-- `ports`: every port in order with its words. -/
def ports (sh : Shape) : List (String × Nat) :=
  (messagePorts sh).map (fun (nm, n) => (nm, portWords n)) ++ (if sh.stacked then [("tau", tauWords sh)] else []) ++
    [("v", portWords (nv sh))]

def inWords (sh : Shape) : Nat := (ports sh).foldl (fun a p => a + p.2) 0

/-! ## The products of a message by a verifier value (`products_structure`) -/

/-- A term's key: `(0, i)` is `["w", i]`, `(1, i)` is `["v", i]`. -/
abbrev Key := Nat × Nat

def term (k : Key) : RecOpen.Term := if k.1 = 0 then .w k.2 else .v k.2

/-- `products_structure.op`: an operand's index, a new one appended in order of first use. -/
def op (k : Key) : StateM (Array Key) Nat := do
  let ops ← get
  match ops.findIdx? (· == k) with
  | some i => pure i
  | none => set (ops.push k); pure ops.size

/-- `products_structure.put`'s residual: each product's operands indexed in order, `a` before `b`. -/
def put (mul : List (Key × Key)) (add : List Key) : StateM (Array Key) RecOpen.Res := do
  let m ← mul.mapM fun (a, b) => do
    let i ← op a
    let j ← op b
    pure (i, j)
  pure { mul := m, add := add.map term }

/-- The residuals in order, by name (`products_structure`'s `names`). -/
def resList (sh : Shape) : StateM (Array Key) (List (String × RecOpen.Res)) := do
  let mp := messagePorts sh
  let vp := vParts sh
  let W := fun (nm : String) (i : Nat) => ((0 : Nat), offset mp nm + i)
  let Vt := fun (nm : String) (i : Nat) => ((1 : Nat), offset vp nm + i)
  let degs := sh.degrees
  let h1 ← put ((List.range SKIP).map fun s => (Vt "eqc" s, W "h" s)) []
  let pre ← (List.range PRE_ROUNDS).mapM fun j => do
    pure (s!"pre{j}", ← put [(W s!"pre{j}" 1, Vt "pre" (2 * j + 1))] [W s!"pre{j}" 0])
  let wv ← put [(Vt "what" 0, W "v2" 0)] []
  let sc ← (List.range degs.length).mapM fun j => do
    let a := (degs.take j).foldl (· + ·) 0
    let deg := degs.getD j 0
    pure (s!"sc{j}", ← put ((List.range' 2 (deg - 1)).map fun i => (W s!"sc{j}" (i - 1), Vt "sc" (a + i - 1)))
      [W s!"sc{j}" 0])
  let f0 ← put [(Vt "alpha" 0, W "u" (2 * sh.ell))] [W "u" (2 * sh.ell + 1)]
  let fs ← (List.range sh.ell).mapM fun j => do
    let fx ← put [] [Vt "ax" j, W "u" j]
    let fy ← put [] [Vt "ay" j, W "u" (sh.ell + j)]
    pure [(s!"fx{j}", fx), (s!"fy{j}", fy)]
  let bp ← put ((List.range sh.PP).map fun p => (Vt "eqp" p, W "u" p)) (if sh.stacked then [] else [W "claim" 0])
  let cl ← if sh.stacked then do
      pure [("claim", ← put ((List.range sh.T).map fun t => (Vt "eqt" t, W "vt" t)) [W "claim" 0])]
    else pure []
  pure ([("h1", h1)] ++ pre ++ [("wv", wv)] ++ sc ++ [("f0", f0)] ++ fs.flatten ++ [("bp", bp)] ++ cl)

/-- `products_structure`: S over w = the message ports' elements in order and v = the verifier row, and its residuals'
names in order. -/
def structureOf (sh : Shape) : RecOpen.GfS × List String :=
  let (rs, ops) := (resList sh).run #[]
  ({ ops := ops.toList.map fun k => [term k], res := rs.map (·.2) }, rs.map (·.1))

/-! ## The unit (`_steps` over `_Forms`) -/

/-- `_Forms.muls` on one pair: each operand committed (`sha512.commit`), then `gf2k.mul_forms`: Karatsuba's ANDs,
recombined and reduced. -/
def mulF (a b : List Lin) : M (List Lin) := do
  let a ← commitW a
  let b ← commitW b
  let zs ← (RecOpen.leaves 7 a b).mapM fun xy => HmNets.and xy.1 xy.2
  pure (RecOpen.reduceG (RecOpen.recomb 7 zs))

/-- One level of Φ's product tree: consecutive pairs multiplied in order, an odd last factor carried. -/
def pairsMul : List (List Lin) → M (List (List Lin))
  | a :: b :: rest => do
    let p ← mulF a b
    let ps ← pairsMul rest
    pure (p :: ps)
  | xs => pure xs

/-- Φ's product tree, level by level, `fuel` levels at most. -/
def tree : Nat → List (List Lin) → M (List Lin)
  | 0, fac => pure (fac.headD [])
  | n + 1, fac => match fac with
    | [] => pure []
    | [f] => pure f
    | fac => do tree n (← pairsMul fac)

/-- The 128 forms of element `i` of `bits`. -/
def elem (bits : Array Lin) (i : Nat) : List Lin := (bits.extract (128 * i) (128 * i + 128)).toList

/-- One demultiplexer level at τ's bit `j`: each slot's vectors `x` split into `x ⊕ τ_σ[j]·x` and `τ_σ[j]·x`, the ANDs
in slot order, vector by vector. -/
def demuxLevel (tau : Array Lin) (j : Nat) (lists : List (List (List Lin))) : M (List (List (List Lin))) :=
  lists.zipIdx.mapM fun (xs, s) => do
    let out ← xs.mapM fun x => do
      let hi ← x.mapM fun b => HmNets.and (tau.getD (16 * s + j) Lin.zero) b
      pure [RecOpen.xorL x hi, hi]
    pure out.flatten

def demux (tau : Array Lin) : List Nat → List (List (List Lin)) → M (List (List (List Lin)))
  | [], lists => pure lists
  | j :: js, lists => do demux tau js (← demuxLevel tau j lists)

def xorAllL : List (List Lin) → List Lin
  | [] => []
  | x :: xs => xs.foldl RecOpen.xorL x

/-- `rec_sparse._steps`: the output bits from the ports' bits by name. -/
def steps (sh : Shape) (P : String → List Lin) : M (List Lin) := do
  let (S, names) := structureOf sh
  let mp := messagePorts sh
  let vp := vParts sh
  let w := mp.flatMap fun (nm, n) => (P nm).take (128 * n)
  let v := ((P "v").take (128 * nv sh)).toArray
  let Rb := (← RecResiduals.residualFormsA S w.toArray v).toArray
  let R := fun (nm : String) => elem Rb (names.idxOf nm)
  let E := fun (nm : String) (i : Nat) => elem (P nm).toArray i
  let V := fun (nm : String) (i : Nat) => elem v (offset vp nm + i)
  let degs := sh.degrees
  let mut claim := R "h1"
  for j in [0:PRE_ROUNDS] do
    let p ← mulF claim (V "pre" (2 * j))
    claim := RecOpen.xorL (R s!"pre{j}") p
  let h2 := RecOpen.xorL claim (R "wv")
  claim := E "v2" 0
  for j in [0:degs.length] do
    let p ← mulF claim (V "sc" ((degs.take j).foldl (· + ·) 0))
    claim := RecOpen.xorL (R s!"sc{j}") p
  let fac := [R "f0"] ++ (List.range sh.ell).flatMap (fun j => [R s!"fx{j}", R s!"fy{j}"]) ++ [V "ur" 0]
  let phi ← tree fac.length fac
  let h3 := RecOpen.xorL claim phi
  let (out, tail) ← if sh.stacked then do
      let tau := (P "tau").toArray
      let lists ← demux tau (List.range sh.tLog).reverse ((List.range sh.S).map fun s => [V "eqs" s])
      let wt := (List.range sh.T).map fun t => xorAllL (lists.map (·.getD t []))
      let sel ← (wt.zip ((List.range sh.T).map (E "vt"))).mapM fun (a, b) => mulF a b
      let h4 := xorAllL (R "bp" :: sel)
      let tail := (List.range sh.S).flatMap fun s =>
        List.replicate sh.tLog Lin.zero ++ (tau.extract (16 * s + sh.tLog) (16 * s + 16)).toList
      pure ([h2, h3, h4, R "claim"], tail)
    else pure ([h2, h3, R "bp"], [])
  let bits := out.flatten ++ tail
  pure (bits ++ List.replicate (16 * outWords sh - bits.length) Lin.zero)

/-- `unit_circuit`: the input bits, each port's words in `ports`' order, 16 bits a word; then `steps`. -/
def unitNet' (sh : Shape) : M (List Lin) := do
  let ps := ports sh
  let flat ← input (16 * inWords sh)
  let parts := RecResiduals.slices flat (ps.map (·.2))
  let byName := ps.zip parts
  steps sh fun nm => ((byName.find? (·.1.1 = nm)).map (·.2)).getD []

/-- The unit laid out as `ir_lower.layout` lays it out: one 16-bit port per word, in and out. -/
def unitLaid (sh : Shape) : Laid :=
  let r := (unitNet' sh).run St.empty
  layout r.2 (Array.replicate (inWords sh) 16) (Array.replicate (outWords sh) 16) r.1.toArray

/-! ## The unit's name and the check -/

/-- The unit's name in the circuit file (`rec_sparse.unit_name`). -/
def unitName (sh : Shape) : String := s!"rec-sparse/n{sh.nu}-e{sh.ell}-s{sh.sLog}-t{sh.tLog}"

/-- The shape of a unit named `rec-sparse/n<NU>-e<ELL>-s<S_LOG>-t<T_LOG>`, in that exact form. -/
def params (name : String) : Option Shape :=
  match name.splitOn "/n" with
  | [_, r] => match r.splitOn "-e" with
    | [n, r] => match r.splitOn "-s" with
      | [e, r] => match r.splitOn "-t" with
        | [s, t] => match n.toNat?, e.toNat?, s.toNat?, t.toNat? with
          | some n, some e, some s, some t =>
            let sh : Shape := ⟨n, e, s, t⟩
            if unitName sh = name then some sh else none
          | _, _, _, _ => none
        | _ => none
      | _ => none
    | _ => none
  | _ => none

/-- The verifier's unit net at a shape. -/
def unitNet (sh : Shape) : V Net := netOf (unitName sh) (unitLaid sh)

/-- The circuit's first rows are `ports sh` (`rec_sparse.subcircuit`'s inputs, `h` first; `out` follows): each one's
name, and its bits as both `16 · words` and its row length. -/
def rowsOk (c : Circuit) (sh : Shape) : Bool :=
  decide ((c.ports.extract 0 (ports sh).length).map (fun q => (q.name, 16 * q.words, q.bits)) =
    (ports sh).toArray.map fun x => (x.1, 16 * x.2, 16 * x.2))

/-- Every copy's input word `i` reads the rows' word `i` (`rec_sparse.lowering`'s `("leaf", p)` at input `p`), so each
copy reads its rows in `ports`' order. -/
def leavesOk (c : Circuit) (sh : Shape) : Bool :=
  (List.range c.upv).all fun j => decide (c.leavesIn.getD j #[] = (Array.range (inWords sh)).map Int.ofNat)

/-- A unit named `rec-sparse/…` is the verifier's at the shape its name gives, equal in every field, and the statement's
rows are its inputs, every copy reading them in order (`rowsOk`, `leavesOk`); any other unit passes. The shape is bounded
by the file's unit before any power of two is taken (every H3 round is a port of at least 64 words, `u` holds `2 ELL + 2`
elements, and with T > 1 `tau` a word a slot), and the input and output bits, rows and leaves are compared before the net
is built. Irreducible, so that no unification against it builds the net. -/
@[irreducible] def check (c : Circuit) : V Unit :=
  match params c.unit.name with
  | some sh =>
    let ib := RecOpen.inBits c.unit
    if !sh.valid then throw s!"circuit {c.name}: rec-sparse's NU is at least 1, ELL at least 6 and T_LOG at most 16"
    else if sh.nu + sh.sLog > ib || sh.ell > ib || (sh.stacked && sh.sLog > Nat.log2 ib) then
      throw s!"circuit {c.name}: unit {c.unit.name}'s shape exceeds its {ib} input bits"
    else if ib != 16 * inWords sh || RecOpen.outBits c.unit != 16 * outWords sh then
      throw (s!"circuit {c.name}: unit {c.unit.name} has {ib} input and {RecOpen.outBits c.unit} output bits, " ++
        s!"not rec-sparse's {16 * inWords sh} and {16 * outWords sh}")
    else if !rowsOk c sh then
      throw s!"circuit {c.name}: {c.unit.name}'s first rows are not rec-sparse's ports at their widths"
    else if !leavesOk c sh then
      throw s!"circuit {c.name}: a copy of {c.unit.name} does not read its rows' words in order"
    else match unitNet sh with
      | .error e => throw e
      | .ok g =>
        if c.unit = g then pure ()
        else throw s!"circuit {c.name}: not the verifier's {c.unit.name} ({firstDiff c.unit g})"
  | none =>
    if c.unit.name.startsWith "rec-sparse/" then
      throw s!"circuit {c.name}: unit {c.unit.name} is not rec-sparse/n<NU>-e<ELL>-s<S_LOG>-t<T_LOG>"
    else pure ()

/-- A layout as `ir_lower.netlist` writes it without `LEAVES` or `CUT` (`circuit._expanded`): the header, then one line a
row. -/
def netlist (name : String) (l : Laid) : String :=
  let line := fun (xs : List Nat) => " ".intercalate (xs.map toString)
  let side := fun (gs : Array Group) =>
    gs.size :: gs.toList.flatMap fun g => [g.col, g.words, g.bits.size] ++ g.bits.toList
  let head := " ".intercalate (["flock-ir-unit/v2", name] ++ ([l.useful, l.constPos] ++ side l.inGroups ++
    side l.outGroups).map toString)
  let rows := (List.range l.useful).map fun i =>
    let a := l.ra.getD i #[]
    let b := l.rb.getD i #[]
    line ((a.size :: a.toList) ++ (b.size :: b.toList))
  "\n".intercalate (head :: rows) ++ "\n"

/-- `check` reads a circuit's name, unit, rows, input leaves and copies only. -/
theorem check_congr {c c' : Circuit} (hn : c.name = c'.name) (hu : c.unit = c'.unit)
    (hp : c.ports = c'.ports := by rfl) (hl : c.leavesIn = c'.leavesIn := by rfl) (hv : c.upv = c'.upv := by rfl) :
    check c = check c' := by
  have hr : rowsOk c = rowsOk c' := by
    funext sh
    unfold rowsOk
    rw [hp]
  have hlv : leavesOk c = leavesOk c' := by
    funext sh
    unfold leavesOk
    rw [hl, hv]
  unfold check
  rw [hn, hu, hr, hlv]

end RecSparse
end Flock
