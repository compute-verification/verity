+    /// [`pad_codeword`] at `queries` alone, in O(|queries| · k · 2^k) for `2^k ≥ t_pad` rather than two transforms of the
+    /// whole codeword. The message is nonzero only on `[0, t_pad)` and `[L, L + t_pad)`, so the forward transform's layers
+    /// above its last `k` copy each entry, except layer `log_inv_rate - 1` (half `L`), which combines the two parts entry by
+    /// entry; only the last `k` layers mix within one `2^k`-aligned block. Each query replays those butterflies on its block
+    /// with the transform's own twiddles, so the values are the full codeword's.
+    pub fn pad_codeword_at(ybar: &[F256], queries: &[usize], log_msg: usize, log_inv_rate: usize) -> Vec<F256> {
+        let log_d = log_msg + log_inv_rate;
+        let k = ybar.len().next_power_of_two().trailing_zeros() as usize;
+        assert!(k <= log_msg && log_inv_rate >= 1, "t_pad exceeds the lane's message length");
+        let ntt = AdditiveNttF128::standard(log_d);
+        let p: Vec<[F128; 2]> = ybar.iter().map(|y| y.coordinates()).collect();
+        queries.par_iter().map(|&q| {
+            let tw = ntt.twiddle(log_inv_rate - 1, q >> (log_msg + 1));
+            let hi = (q >> log_msg) & 1 == 1;
+            let mut s = vec![[F128::ZERO; 2]; 1 << k];
+            for (si, pi) in s.iter_mut().zip(&p) {
+                *si = pi.map(|x| {
+                    let u = PAD_C * x + x * tw;
+                    if hi { x + u } else { u }
+                });
+            }
+            let base = q & !((1usize << k) - 1);
+            for layer in log_d - k..log_d {
+                let half = 1usize << (log_d - layer - 1);
+                for start in (0..1usize << k).step_by(2 * half) {
+                    let tw = ntt.twiddle(layer, (base + start) >> (log_d - layer));
+                    for i0 in start..start + half {
+                        for c in 0..2 {
+                            let v = s[i0 + half][c];
+                            let u = s[i0][c] + v * tw;
+                            s[i0][c] = u;
+                            s[i0 + half][c] = v + u;
+                        }
+                    }
+                }
+            }
+            let [x, y] = s[q & ((1usize << k) - 1)];
+            F256::new(x, y)
+        }).collect()
+    }
+
