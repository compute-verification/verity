+/// A ring-switched claim given by its value, its 64 skip weights and its `m − 6` remaining coordinates (verity
+/// flock-gpu-link: link and public-value claims on a block R1CS witness).
+pub struct ExtraClaim {
+    pub value: F128,
+    pub skip_weights: Vec<F128>,
+    pub x_full: Vec<F128>,
+}
+
+/// [`verify_ligerito`] with `extra` claims opened in the same batch, after the ab and c claims (the order
+/// `prove_fast_ligerito_from_witness_extra` opens them in).
+pub fn verify_ligerito_extra<Ch: Challenger>(
+    r1cs: &BlockR1cs,
+    commitment: &Commitment,
+    proof: &R1csProofLigerito,
+    lincheck_circuit: &dyn LincheckCircuit,
+    pcs_params: &PcsParams,
+    extra: &[ExtraClaim],
+    challenger: &mut Ch,
+) -> Result<R1csClaim, FlockVerifyError> {
+    let (ab, c) = verify_core_with_grinding(
+        r1cs,
+        &proof.zerocheck,
+        &proof.lincheck,
+        commitment,
+        lincheck_circuit,
+        pcs_params.zerocheck_grinding(),
+        pcs_params.lincheck_grinding(),
+        challenger,
+    )?;
+    let full = |z: &ZClaim| [z.point.x_inner_rest.as_slice(), z.point.x_outer.as_slice()].concat();
+    let mut values = vec![ab.value, c.value];
+    let mut skips = vec![ab.point.z_skip.weights(LOG_PACKING - 1), c.point.z_skip.weights(LOG_PACKING - 1)];
+    let mut xs = vec![full(&ab), full(&c)];
+    for e in extra {
+        if e.skip_weights.len() != 1 << (LOG_PACKING - 1) || e.x_full.len() != xs[1].len() {
+            return Err(FlockVerifyError::PcsAb(PcsError::Ligerito));
+        }
+        values.push(e.value);
+        skips.push(e.skip_weights.clone());
+        xs.push(e.x_full.clone());
+    }
+    verifier_pool()
+        .install(|| {
+            if !commitment_params_match_expected(commitment, pcs_params) {
+                return Err(PcsError::Ligerito);
+            }
+            let skip_refs: Vec<&[F128]> = skips.iter().map(|v| v.as_slice()).collect();
+            let x_refs: Vec<&[F128]> = xs.iter().map(|v| v.as_slice()).collect();
+            let cfg = pcs_params.ligerito_verifier_config().expect("Ligerito default verifier config");
+            verify_opening_batch_ligerito_mixed_with_grinding(
+                commitment,
+                &values,
+                &skip_refs,
+                &x_refs,
+                &[],
+                &proof.pcs_open,
+                &cfg,
+                pcs_params.opening_grinding(),
+                challenger,
+            )
+        })
+        .map_err(FlockVerifyError::PcsAb)?;
+    Ok(R1csClaim { ab, c })
+}
