+/// verity flock-gpu-link: [`prove_fast_ligerito_from_witness`] with extra ring-switched z-claims opened in the same
+/// batch, after ab and c. `hook` runs after the commitment and before the statement binding, so before any coin, and
+/// returns each extra claim's `m − 6` coordinates past the skip block (the verifier derives the skip weights).
+#[allow(clippy::too_many_arguments)]
+pub fn prove_fast_ligerito_from_witness_extra<Ch: Challenger>(
+    r1cs: &BlockR1cs,
+    pcs_params: &PcsParams,
+    z_packed: Vec<F128>,
+    a_packed_f128: Vec<F128>,
+    b_packed_f128: Vec<F128>,
+    z_packed_lincheck: Vec<u8>,
+    lincheck_circuit: &dyn LincheckCircuit,
+    hook: &mut dyn FnMut(&Commitment) -> Vec<Vec<F128>>,
+    challenger: &mut Ch,
+) -> (R1csProofLigerito, Commitment) {
+    let lig_config = pcs_params
+        .ligerito_prover_config()
+        .expect("Ligerito default config; bump m for tiny instances");
+    let mut extra: Vec<Vec<F128>> = Vec::new();
+    let ProveCore {
+        zc_proof,
+        lc_proof,
+        ab,
+        c,
+        commitment,
+        prover_data,
+        z_packed,
+        s_hat_v_ab,
+        s_hat_v_c,
+    } = prove_fast_core_hooked(
+        r1cs,
+        pcs_params,
+        z_packed,
+        a_packed_f128,
+        b_packed_f128,
+        z_packed_lincheck,
+        lincheck_circuit,
+        None,
+        &mut |cm| extra = hook(cm),
+        challenger,
+    );
+    let padding = r1cs.padding_spec();
+    let mut x_fulls = vec![quirky_x_outer_full(&ab.point), quirky_x_outer_full(&c.point)];
+    x_fulls.extend(extra);
+    let x_refs: Vec<&[F128]> = x_fulls.iter().map(|v| v.as_slice()).collect();
+    let mut pre: Vec<Option<&[F128]>> = vec![s_hat_v_ab.as_deref(), Some(s_hat_v_c.as_slice())];
+    pre.resize(x_refs.len(), None);
+    let pcs_open = open_batch_mixed_ligerito_with_precomputed_s_hat_v_and_grinding(
+        z_packed,
+        &prover_data,
+        &commitment,
+        &x_refs,
+        &pre,
+        &[],
+        &padding,
+        &lig_config,
+        pcs_params.opening_grinding(),
+        challenger,
+    );
+    (
+        R1csProofLigerito {
+            zerocheck: zc_proof,
+            lincheck: lc_proof,
+            pcs_open,
+        },
+        commitment,
+    )
+}
