+/// [`verify_ligerito_union`] with verity's glue between the tables (flock-glue),
+/// the mirror of `flock_prover::prover::prove_fast_ligerito_union_glued`: after
+/// the class PIOPs, `glue` replays the glue sumcheck on the challenger and
+/// returns the claims the merged opening must also open.
+pub fn verify_ligerito_union_glued<Ch: Challenger>(
+    union: &UnionInstance<'_>,
+    circuits: &[&dyn LincheckCircuit],
+    commitment: &Commitment,
+    proof: &R1csProofMergedLigerito,
+    pcs_params: &PcsParams,
+    glue: &mut dyn FnMut(&Commitment, &mut Ch) -> Result<Vec<LinkClaim>, String>,
+    challenger: &mut Ch,
+) -> Result<R1csClaim, FlockVerifyError> {
+    assert!(!union.has_element(), "this entry is boolean-only");
+    let boolean = BooleanPiopProof { zerocheck: proof.zerocheck.clone(), lincheck: proof.lincheck.clone() };
+    let (claims, packed_direct_points, matrix, _el, _sigma) = verify_union_piops(
+        union,
+        UnionVerifyBinding::Mixed,
+        circuits,
+        commitment,
+        Some(BooleanPiopRef::Rs(&boolean)),
+        None,
+        None,
+        false,
+        pcs_params,
+        challenger,
+    )?;
+    if let Some(a) = matrix {
+        a.check(union, circuits).map_err(FlockVerifyError::Lincheck)?;
+    }
+    let glued = glue(commitment, challenger).map_err(|_| FlockVerifyError::Glue)?;
+    let claims = verify_merged_opening(union, commitment, &claims, &packed_direct_points, &proof.pcs_open, pcs_params, challenger, None, &glued)?;
+    Ok(claims.boolean.expect("asserted boolean-only above"))
+}
