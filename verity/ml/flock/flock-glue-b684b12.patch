 pub type LinkHook<'a> = &'a mut dyn FnMut(&Commitment) -> Vec<LinkClaim>;
 
+/// Called once per proof after the class PIOPs and before the merged opening,
+/// with the padded witness and the challenger (verity flock-glue: the glue
+/// sumcheck between tables): returns claims opened in the same opening, their
+/// values already observed.
+pub type GlueHook<'a, Ch> = &'a mut dyn FnMut(&Commitment, &[F128], &mut Ch) -> Vec<LinkClaim>;
+
+/// [`prove_fast_ligerito_union`] with verity's glue between the tables
+/// ([`GlueHook`]). Verify with
+/// [`flock_core::verifier::verify_ligerito_union_glued`].
+pub fn prove_fast_ligerito_union_glued<Ch: Challenger>(
+    union: &UnionInstance<'_>,
+    pcs_params: &PcsParams,
+    slots: Vec<UnionSlotProverInput<'_>>,
+    glue: GlueHook<'_, Ch>,
+    challenger: &mut Ch,
+) -> (R1csProofMergedLigerito, Commitment, R1csClaim) {
+    assert!(!union.has_element(), "this entry is boolean-only");
+    let (out, commitment) = prove_union_with_binding_zerocheck_link(
+        union,
+        UnionProveBinding::Mixed,
+        BooleanZcKind::Rs,
+        pcs_params,
+        slots,
+        Vec::new(),
+        None,
+        Some(glue),
+        challenger,
+    );
+    let (piop, claim) = out.boolean.expect("asserted boolean-only above");
+    let piop = piop.expect_rs();
+    (
+        R1csProofMergedLigerito {
+            zerocheck: piop.zerocheck,
+            lincheck: piop.lincheck,
+            pcs_open: out.pcs_open,
+        },
+        commitment,
+        claim,
+    )
+}
