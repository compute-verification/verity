+/// Verity M1: the level-0 commitment with Ligerito's level-0 hiding ([`super::ligerito::zk`]): every witness lane's
+/// codeword plus its padding polynomial's, then the two padded uniform lanes; `num_ntts + 2` lanes per leaf, one tree over
+/// the same positions (and so the same hm96 level-0 salts).
+pub fn commit_zk(z_packed: &[F128], params: &PcsParams, zk: &super::ligerito::zk::Level0Zk) -> (Commitment, ProverData) {
+    use rayon::prelude::*;
+    use super::ligerito::zk::{EXTRA_LANES, lane_codeword};
+    params.validate();
+    let (w, n) = (params.num_ntts(), params.n_positions());
+    let lanes = w + EXTRA_LANES;
+    let log_msg = params.k_code() - params.log_inv_rate;
+    assert_eq!(zk.pads.len(), lanes);
+    assert!(zk.extra.iter().all(|x| x.len() == 1 << log_msg));
+    let base = commit_encode(z_packed, params);
+    let pads: Vec<Vec<F128>> = (0..lanes).into_par_iter()
+        .map(|l| lane_codeword(&zk.pads[l], (l >= w).then(|| zk.extra[l - w].as_slice()), log_msg, params.log_inv_rate))
+        .collect();
+    let mut codeword = crate::scratch::take_f128(n * lanes);
+    codeword.par_chunks_mut(lanes).enumerate().for_each(|(pos, row)| {
+        for (l, x) in row.iter_mut().enumerate() {
+            *x = pads[l][pos] + if l < w { base[pos * w + l] } else { F128::ZERO };
+        }
+    });
+    give_f128(base);
+    let bytes: &[u8] = unsafe { from_raw_parts(codeword.as_ptr() as *const u8, codeword.len() * size_of::<F128>()) };
+    let merkle_tree = merkle_tree(bytes, params.n_leaves(), params.merkle_hash);
+    let cfg = super::ligerito::zk::prover_config(params.ligerito_prover_config().expect("Ligerito config"), zk.queries0);
+    let cap = cap_layer(&merkle_tree, params.n_leaves(), cfg.level_zero_cap_depth()).to_vec();
+    (Commitment { cap, params: params.clone() }, ProverData { codeword, merkle_tree })
+}
