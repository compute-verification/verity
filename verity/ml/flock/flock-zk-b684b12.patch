+
+    pub const LABEL_OPEN: &[u8] = b"verity-flock-zk-l0-open-v0";
+    pub const LABEL_CLOSE: &[u8] = b"verity-flock-zk-l0-close-v0";
+    /// Extra lanes in the level-0 codeword: [`REP_LANES`] per repetition, for two repetitions.
+    pub const EXTRA_LANES: usize = 4;
+    pub const REP_LANES: usize = 2;
+
+    /// Rep `rep`'s pair among the extra lanes.
+    pub fn rep_lanes(rep: usize) -> [usize; REP_LANES] {
+        [REP_LANES * rep, REP_LANES * rep + 1]
+    }
+
+    /// The padding polynomial's constant `c` (the element `x`, outside GF(2)).
+    pub const PAD_C: F128 = F128::new(2, 0);
+
+    /// The padded level-0 code `RS[2L, L + t_pad]` has rate above the profile's, so level 0 takes the caller's query count
+    /// `queries0` (the level-0 tree's cap depth follows it): both sides' configs with it, restratified.
+    pub fn prover_config(mut cfg: ProverConfig, queries0: usize) -> ProverConfig {
+        cfg.queries[0] = queries0;
+        cfg.with_default_stratified()
+    }
+
+    pub fn verifier_config(mut cfg: VerifierConfig, queries0: usize) -> VerifierConfig {
+        cfg.queries[0] = queries0;
+        cfg.with_default_stratified()
+    }
+
+    /// The prover's level-0 randomness, drawn once per session: `pads[l]` (`t_pad` words) for every lane `l` (the witness's,
+    /// then the extra ones), and the extra lanes' messages; and the repetition this opening is for.
+    #[derive(Clone)]
+    pub struct Level0Zk {
+        /// level 0's query count ([`prover_config`])
+        pub queries0: usize,
+        pub t_pad: usize,
+        /// this opening's repetition: it folds, sums and pads only its own pair ([`rep_lanes`])
+        pub rep: usize,
+        pub extra: [Vec<F128>; EXTRA_LANES],
+        pub pads: Vec<Vec<F128>>,
+        /// a dishonest prover (the negatives): 1 folds another first extra lane than the committed one, 2 sends another
+        /// `T'`, 3 another `ybar`, 4 another `e_0` (with the honest `T'`)
+        pub tamper: u8,
+    }
+
+    /// Sent after the lane rounds (see the module docs).
+    #[derive(Clone, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+    pub struct Level0ZkProof {
+        pub e: [F256; REP_LANES],
+        pub t_prime: F256,
+        pub ybar: Vec<F256>,
+    }
+
+    /// The lane phase as either side saw it (never serialized): what a caller needs to rebuild its checks as constraints.
+    #[derive(Clone, Debug, Default, PartialEq, Eq)]
+    pub struct Level0ZkRecord {
+        pub target: F128,
+        /// `(β, y)` per level-0 OOD sample (`y` as sent)
+        pub ood: Vec<(F128, F128)>,
+        pub challenges: Vec<F256>,
+        pub rho: [F256; REP_LANES],
+        /// level 0's and level 1's query positions
+        pub queries0: Vec<usize>,
+        pub queries1: Vec<usize>,
+    }
+
+    /// The verifier's level-0 parameters: the padding per lane, and the repetition whose pair the rows are checked against.
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct Level0Params {
+        pub t_pad: usize,
+        pub rep: usize,
+    }
+
+    /// Whether `ρ_0 R_0 + ρ_1 R_1` is uniform on F256 for uniform F128 lanes: `ρ_0, ρ_1` independent over F128.
+    pub fn rho_independent(rho: [F256; REP_LANES]) -> bool {
+        rho[0].c0 * rho[1].c1 + rho[0].c1 * rho[1].c0 != F128::ZERO
+    }
+
+    /// One lane's padding codeword: the RS encoding of `base + (c·pad ‖ 0) ‖ pad ‖ 0` minus that of `base ‖ 0` for a
+    /// witness lane (`base = None`), or of the whole padded extra lane.
+    pub fn lane_codeword(pad: &[F128], base: Option<&[F128]>, log_msg: usize, log_inv_rate: usize) -> Vec<F128> {
+        let (l, n) = (1usize << log_msg, 1usize << (log_msg + log_inv_rate));
+        assert!(pad.len() <= l, "t_pad exceeds the lane's message length");
+        let mut v = vec![F128::ZERO; n];
+        if let Some(b) = base {
+            v[..l].copy_from_slice(b);
+        }
+        for (i, &p) in pad.iter().enumerate() {
+            v[i] += PAD_C * p;
+            v[l + i] = p;
+        }
+        AdditiveNttF128::standard(log_msg + log_inv_rate).forward_transform(&mut v);
+        v
+    }
+
+    /// `Enc(c·ybar ‖ ybar)` at every position (by coordinates): the padding's part of the folded level-0 row.
+    pub fn pad_codeword(ybar: &[F256], log_msg: usize, log_inv_rate: usize) -> Vec<F256> {
+        let [a, b] = [0, 1].map(|k| lane_codeword(&ybar.iter().map(|y| y.coordinates()[k]).collect::<Vec<_>>(), None, log_msg, log_inv_rate));
+        a.into_par_iter().zip(b).map(|(x, y)| F256::new(x, y)).collect()
+    }
+
+    /// Rep `z.rep`'s padding combination `ybar = Σ_l w_l pad_l + ρ_0 pad_{R_{2r}} + ρ_1 pad_{R_{2r+1}}` over the witness's
+    /// `lanes` lanes, `w = eq(r̄)` the lane rounds' weights.
+    pub fn ybar(z: &Level0Zk, lanes: usize, w: &[F256], rho: [F256; REP_LANES]) -> Vec<F256> {
+        let p = rep_lanes(z.rep).map(|i| &z.pads[lanes + i]);
+        (0..z.t_pad).into_par_iter().map(|i| (0..lanes).fold(rho[0] * p[0][i] + rho[1] * p[1][i], |acc, l| acc + w[l] * z.pads[l][i])).collect()
+    }
+
+    /// The level-0 enforced sum's extra terms for rep `rep`: `Σ_q w_q (ρ_0 row_q[L + 2r] + ρ_1 row_q[L + 2r + 1] +
+    /// Enc(c·ybar ‖ ybar)(q))` for row weights `w = eq(α)`, `L` the witness's lane count.
+    pub fn enforced_extra(rows: &[Vec<F128>], queries: &[usize], row_weights: &[F128], lanes: usize, rep: usize, rho: [F256; REP_LANES],
+                          padcw: &[F256]) -> F256 {
+        let p = rep_lanes(rep);
+        rows.iter().zip(queries).zip(row_weights).map(|((row, &q), &w)| {
+            (rho[0] * row[lanes + p[0]] + rho[1] * row[lanes + p[1]] + padcw[q]) * w
+        }).fold(F256::ZERO, |a, b| a + b)
+    }
