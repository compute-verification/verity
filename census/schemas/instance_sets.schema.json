{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "census/schemas/instance_sets.schema.json",
  "title": "Census frozen instance sets, one per target",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "subcircuit",
      "target",
      "dataset",
      "tier",
      "size",
      "manifest_sha256",
      "seed",
      "sources",
      "provenance"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "the dataset, slugged"
      },
      "subcircuit": {
        "type": "string",
        "pattern": "^[a-z0-9]+(_[a-z0-9]+)*/.+$",
        "description": "the bound subcircuit its instances are of (census/subcircuits.json)"
      },
      "target": {
        "type": "string",
        "minLength": 1,
        "description": "legacy: the verity.proofs.target name"
      },
      "dataset": {
        "type": "string",
        "minLength": 1
      },
      "tier": {
        "type": "string",
        "minLength": 1
      },
      "size": {
        "type": "integer",
        "minimum": 1
      },
      "manifest_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "seed": {
        "type": [
          "integer",
          "null"
        ]
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "provenance": {
        "enum": [
          "captured",
          "synthetic"
        ],
        "description": "captured: instances drawn from real model runs (with adversarial corners); synthetic: generated from a seeded recipe"
      }
    }
  }
}
