{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "census/schemas/subcircuits.schema.json",
  "title": "Census subcircuit templates (typed parameters) with the subcircuits (fully bound templates) under each; never units",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "description",
      "parameters",
      "accumulate",
      "reference_batch",
      "sources",
      "subcircuits"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "parameters": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "required": [
            "type",
            "description"
          ],
          "properties": {
            "type": {
              "enum": [
                "integer",
                "string"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "accumulate": {
        "type": "string",
        "enum": [
          "fp32"
        ]
      },
      "reference_batch": {
        "type": "integer",
        "minimum": 1
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "subcircuits": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "display",
            "parameters",
            "fidelity_notes"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/k[0-9]+/[a-z0-9]+(-[a-z0-9]+)*$",
              "description": "<template>/k<K>/<semantics: the instruction's arch, op and types, without its shape>"
            },
            "display": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object",
              "minProperties": 1
            },
            "legacy_target": {
              "type": "string",
              "minLength": 1,
              "description": "the verity.proofs.target name it was known by"
            },
            "stood_for_by": {
              "type": "object",
              "description": "another subcircuit whose results and input set stand for this one (a recorded equivalence, not duplicated cells)",
              "additionalProperties": false,
              "required": ["subcircuit", "covers", "why", "ruling", "sources"],
              "properties": {
                "subcircuit": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/k[0-9]+/[a-z0-9]+(-[a-z0-9]+)*$"},
                "covers": {"type": "string", "minLength": 1},
                "why": {"type": "string", "minLength": 1},
                "ruling": {"type": "string", "minLength": 1},
                "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["label"],
                            "properties": {"label": {"type": "string", "minLength": 1}, "href": {"type": "string", "format": "uri"}}}}
              }
            },
            "fidelity_notes": {
              "type": "array",
              "description": "known gaps between the subcircuit and what production runs",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "note",
                  "sources"
                ],
                "properties": {
                  "note": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label"
                      ],
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "href": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
