# vy-nebius-2's scheduler agent (`cluster agent --mode live`) as a service, from the tree `research deploy` installs at
# /workspace/verity-guest/cluster-agent (deploy.toml, beside this unit): a fixed path that the src evictor, which only
# deletes /workspace/research/src/<commit>/, never touches. Install or update both from a pushed commit:
#   research deploy install vy-nebius-2 /workspace/verity-guest/cluster-agent /etc/systemd/system/vy-cluster-agent.service \
#     --ref REF --by LANE --apply
# which reloads systemd and restarts the agent if it runs (do it outside a timed window); the new agent continues the
# ledger's chain in a new segment under live/. A stopped or failed one starts with
# `sudo systemctl reset-failed vy-cluster-agent; sudo systemctl start vy-cluster-agent`.
# Stop, and stay stopped: `touch /workspace/pouw/infra/cluster/live/STOP`. The agent exits 0, which is never restarted, and
# the unit won't start while STOP exists. Any exit frees agent.lock, so gpu-lease and fill_runner fall back to their own rules.
# Exit 2 (a plan that would break a rule) is the agent's own safety stop and is not restarted either; 1 (a crash) is.
[Unit]
Description=vy-nebius-2 scheduler agent (cluster agent --mode live)
ConditionPathExists=!/workspace/pouw/infra/cluster/live/STOP
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
User=research
Group=research
WorkingDirectory=/workspace/verity-guest/cluster-agent
Environment=PYTHONPATH=/workspace/verity-guest/cluster-agent/src PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m cluster agent descriptions/nebius.toml --mode live --roll --out /workspace/pouw/infra/cluster/live --stop-file /workspace/pouw/infra/cluster/live/STOP
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=2
TimeoutStopSec=20
MemoryMax=1G

[Install]
WantedBy=multi-user.target
