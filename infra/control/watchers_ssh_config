# ssh's config for the watchers' loops on the control pod (bin/ssh): the node aliases agent VMs have, so a loop written for an
# agent VM (`ssh n2 ...`) runs unchanged. `research deploy install vy-control-verity` writes it to /data/watchers/ssh_config
# from the register of machines (machines.d), which gives each HostName. Options given on a command line win.
Host n2 vy-nebius-2 vy-n2
  HostName {{vy-nebius-2:host}}
Host cpu1 vy-nebius-cpu-1
  HostName {{vy-nebius-cpu-1:host}}
Host cpu2 vy-nebius-cpu-2
  HostName {{vy-nebius-cpu-2:host}}
Host cpu3 vy-nebius-cpu-3
  HostName {{vy-nebius-cpu-3:host}}
Host *
  User research
  IdentityFile /root/.runpod/ssh/runpodctl-ssh-key
  IdentitiesOnly yes
  BatchMode yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile /data/watchers/known_hosts
  ServerAliveInterval 30
  LogLevel ERROR
