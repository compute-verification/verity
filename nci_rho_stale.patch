From 5ce6135f903f38c863d03f3f49fe46188039c968 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 13 Nov 2026 07:15:08 +0000
Subject: [PATCH] AGENTS.md, tests/import_order.toml, tests/test_boundaries.py:
 nci/ and rho/ are no longer under verity/protocols/inference_only/

After the move the two are benchmarks, not distributions of their own under verity/:

- AGENTS.md's list of the code a move brought from benchmarks/ no longer names them.
- tests/import_order.toml loses their two [[distribution]] entries, and its generated tables are what
  tools/verity/check/import_order.py writes on the moved tree: seven loaded_by lines of rho's files go, since a file
  under benchmarks/ is no loader the listing names.
- tests/test_boundaries.py's NO_DATE_OR_REASON loses nci's entry.

Co-authored-by: danielreuter <danielreuter@users.noreply.github.com>
---
 AGENTS.md                |  3 +--
 tests/import_order.toml  | 18 ------------------
 tests/test_boundaries.py |  6 +++---
 3 files changed, 4 insertions(+), 23 deletions(-)

diff --git a/AGENTS.md b/AGENTS.md
index badafeeddd8..c87c7d8f04f 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -28,4 +28,3 @@ it; a line marked "Target, not yet" says what the layout of record has and the t
     keeps apart from `verity`'s places (a distribution of its own each, `poub/verifier/remote_session/` a place of its
-    own): `pouw/clear/`, `pouw/receipts/`, `poub/device/live_verifier/`, `poub/verifier/remote_session/`,
-    `benchmarks/nci/` and `benchmarks/rho/`.
+    own): `pouw/clear/`, `pouw/receipts/`, `poub/device/live_verifier/` and `poub/verifier/remote_session/`.
   - `verity/circuits/`: the circuit language (format in `circuits/PROTOCOL.md`). Three base Lean packages, which Flock's
diff --git a/tests/import_order.toml b/tests/import_order.toml
index 7769ae3e388..d67504ddfda 100644
--- a/tests/import_order.toml
+++ b/tests/import_order.toml
@@ -69,11 +69,2 @@ owner = "ci"
 
-[[distribution]]
-directory = "benchmarks/rho"
-owner = "training"
-date = "2026-11-16"
-
-[[distribution]]
-directory = "benchmarks/nci"
-owner = "compute-accounting"
-
 [[distribution]]
@@ -665,7 +656,2 @@ paths = [
 trusted = true
-loaded_by = [
-    "benchmarks/rho/rho/params.py",
-    "benchmarks/rho/tests/test_operating.py",
-    "benchmarks/rho/tests/test_params.py",
-]
 
@@ -768,6 +754,2 @@ loaded_by = [
     "verity/protocols/flock/prover/tests/test_audit_profile.py",
-    "benchmarks/rho/rho/params.py",
-    "benchmarks/rho/tests/test_envelopes.py",
-    "benchmarks/rho/tests/test_held_to_core.py",
-    "benchmarks/rho/tests/test_params.py",
     "verity/protocols/pouw/prover/circuit/plan.py",
diff --git a/tests/test_boundaries.py b/tests/test_boundaries.py
index 5e20a10ec58..fd1319e186e 100644
--- a/tests/test_boundaries.py
+++ b/tests/test_boundaries.py
@@ -83,5 +83,5 @@ NUMPY_USERS = ("verity/circuits/evaluation", "verity/circuits/boolean/forms.py")
 #: own: each owner owes one of the two.  It only shrinks.
-NO_DATE_OR_REASON = ("verity/configuration/config", "benchmarks/nci",
-                     "verity/composite/device/live_challenger", "verity/protocols/poub/device/live_verifier",
-                     "verity/protocols/pouw/clear", "verity/protocols/pouw/receipts")
+NO_DATE_OR_REASON = ("verity/configuration/config", "verity/composite/device/live_challenger",
+                     "verity/protocols/poub/device/live_verifier", "verity/protocols/pouw/clear",
+                     "verity/protocols/pouw/receipts")
 #: Inside the listing's distributions, the directories whose Python is still held as ``verity``'s own by the rules on a
