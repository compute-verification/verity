{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {"command": "sh tools/agent-guard/hook.sh shell_hook.py", "timeout": 10, "failClosed": true}
    ],
    "preToolUse": [
      {"command": "sh tools/agent-guard/hook.sh task_hook.py", "matcher": "Task", "timeout": 10},
      {"command": "sh tools/agent-guard/hook.sh task_hook.py", "matcher": "CallDynamicTool", "timeout": 10}
    ]
  }
}
